(component
  ;; The clocks probe (the rung after T85.9's first landing): the two
  ;; wasi:clocks@0.3.0 doors the language's time doors lower onto —
  ;; system-clock's now (sync, returning the instant record) and
  ;; monotonic-clock's now (sync, returning the mark alias riding the
  ;; inline u64 primval). The probe pins their sync lowering shapes:
  ;; the record is two flat results, past the canonical ABI's one-flat
  ;; result limit, so it rides a retptr the lowered function writes
  ;; through the guest's memory (the memory option, no realloc — the
  ;; host allocates nothing); the mark is one flat result, a bare
  ;; lower. The guest dumps the record's bytes through the stdout
  ;; protocol and exits 40 + code: +1 the wall answered sane (the
  ;; seconds inside 1e9..5e9, the nanoseconds under 1e9), +2 the mono
  ;; answered nonzero — 43 is both green, 41/42/40 name the leg that
  ;; failed.
  (type $ty-sys (instance
    (type (;0;) (record (field "seconds" s64) (field "nanoseconds" u32)))
    (export (;1;) "instant" (type (eq 0)))
    (type (;2;) (func (result 1)))
    (export (;0;) "now" (func (type 2)))
  ))
  (import "wasi:clocks/system-clock@0.3.0" (instance $sys (type $ty-sys)))
  (type $ty-mono (instance
    (type (;0;) (func (result u64)))
    (export (;0;) "now" (func (type 0)))
  ))
  (import "wasi:clocks/monotonic-clock@0.3.0" (instance $mono (type $ty-mono)))
  (type $ty-types (instance
    (type (;0;) (enum "io" "illegal-byte-sequence" "pipe"))
    (export (;1;) "error-code" (type (eq 0)))
  ))
  (import "wasi:cli/types@0.3.0" (instance $types (type $ty-types)))
  (alias export $types "error-code" (type $error-code))
  (type $res-t (result (error $error-code)))
  (type $s8t (stream u8))
  (type $frest (future $res-t))
  (type $ty-stdout (instance
    (alias outer 1 $error-code (type (;0;)))
    (export (;1;) "error-code" (type (eq 0)))
    (type (;2;) (stream u8))
    (type (;3;) (result (error 1)))
    (type (;4;) (future 3))
    (type (;5;) (func (param "data" 2) (result 4)))
    (export (;0;) "write-via-stream" (func (type 5)))
  ))
  (import "wasi:cli/stdout@0.3.0" (instance $stdout (type $ty-stdout)))
  (type $ty-exit (instance
    (type (;0;) (result))
    (type (;1;) (func (param "status" 0)))
    (type (;2;) (func (param "status-code" u8)))
    (export (;0;) "exit" (func (type 1)))
    (export "exit-with-code" (func (type 2)))
  ))
  (import "wasi:cli/exit@0.3.0" (instance $exit (type $ty-exit)))

  (core module $prov (memory (export "memory") 2))
  (core instance $prov-i (instantiate $prov))
  (alias core export $prov-i "memory" (core memory $mem))

  (alias export $sys "now" (func $sys-imp))
  (alias export $mono "now" (func $mono-imp))
  (alias export $stdout "write-via-stream" (func $wvs-imp))
  (alias export $exit "exit-with-code" (func $ewc-imp))
  (core func $lower-sys (canon lower (func $sys-imp) (memory $mem)))
  (core func $lower-mono (canon lower (func $mono-imp)))
  (core func $lower-ewc (canon lower (func $ewc-imp) (memory $mem)))
  (core func $lower-wvs (canon lower (func $wvs-imp) (memory $mem)))
  (core func $s-new (canon stream.new (type $s8t)))
  (core func $s-write (canon stream.write (type $s8t) (memory $mem)))
  (core func $s-dr (canon stream.drop-readable (type $s8t)))
  (core func $s-dw (canon stream.drop-writable (type $s8t)))
  (core func $f-read (canon future.read (type $frest) (memory $mem)))
  (core func $f-dr (canon future.drop-readable (type $frest)))

  (core instance $host
    (export "sys-now" (func $lower-sys))
    (export "mono-now" (func $lower-mono))
    (export "write-via-stream" (func $lower-wvs))
    (export "exit-with-code" (func $lower-ewc))
    (export "new" (func $s-new))
    (export "write" (func $s-write))
    (export "drop-readable" (func $s-dr))
    (export "drop-writable" (func $s-dw))
    (export "future-read" (func $f-read))
    (export "future-drop-readable" (func $f-dr))
  )

  (core module $m
    (type $tw (func (param i32) (result i32)))
    (type $tnew (func (result i64)))
    (type $twr (func (param i32 i32 i32) (result i32)))
    (type $tdr (func (param i32)))
    (type $tfr (func (param i32 i32) (result i32)))
    (type $tsn (func (param i32)))
    (type $tmn (func (result i64)))
    (import "wasi:cli/stdout@0.3.0" "write-via-stream" (func $wvs (type $tw)))
    (import "stream" "new" (func $new (type $tnew)))
    (import "stream" "write" (func $wr (type $twr)))
    (import "stream" "drop-readable" (func $dr (type $tdr)))
    (import "stream" "drop-writable" (func $dw (type $tdr)))
    (import "stream" "future-read" (func $fread (type $tfr)))
    (import "stream" "future-drop-readable" (func $fdr (type $tdr)))
    (import "wasi:cli/exit@0.3.0" "exit-with-code" (func $ec (type $tdr)))
    (import "clocks" "sys-now" (func $sn (type $tsn)))
    (import "clocks" "mono-now" (func $mn (type $tmn)))
    (import "prov" "memory" (memory 1))
    (func (export "run") (result i32)
      (local $w i32) (local $r i32) (local $h i64) (local $f i32)
      (local $s i64) (local $ns i32) (local $m i64) (local $code i32)
      (call $new)
      (local.set $h)
      (local.get $h)
      (i32.wrap_i64)
      (local.set $r)
      (local.get $h)
      (i64.const 32)
      (i64.shr_u)
      (i32.wrap_i64)
      (local.set $w)
      (local.get $r)
      (call $wvs)
      (local.set $f)
      ;; the instant record lands at 512, its bytes ride stdout
      (i32.const 512)
      (call $sn)
      (local.get $w)
      (i32.const 512)
      (i32.const 12)
      (call $wr)
      (drop)
      (local.get $w)
      (call $dw)
      (local.get $f)
      (call $fdr)
      ;; the reads: seconds at +0, nanoseconds at +8, the mark flat
      (i32.const 512)
      (i64.load)
      (local.set $s)
      (i32.const 520)
      (i32.load)
      (local.set $ns)
      (call $mn)
      (local.set $m)
      (i32.const 0)
      (local.set $code)
      ;; the wall's sanity: 1e9 < seconds < 5e9 (2001..2128), the
      ;; nanoseconds under 1e9 (the +8 offset's bound)
      (block
        (local.get $s)
        (i64.const 1000000000)
        (i64.le_u)
        (br_if 0)
        (local.get $s)
        (i64.const 5000000000)
        (i64.ge_u)
        (br_if 0)
        (local.get $ns)
        (i32.const 1000000000)
        (i32.ge_u)
        (br_if 0)
        (local.get $code)
        (i32.const 1)
        (i32.add)
        (local.set $code))
      ;; the mono's sanity: nonzero
      (block
        (local.get $m)
        (i64.eqz)
        (br_if 0)
        (local.get $code)
        (i32.const 2)
        (i32.add)
        (local.set $code))
      ;; 43 both green; 41 wall only; 42 mono only; 40 neither
      (local.get $code)
      (i32.const 40)
      (i32.add)
      (call $ec)
      (i32.const 0)
    )
  )
  (core instance $main (instantiate $m
    (with "wasi:cli/stdout@0.3.0" (instance $host))
    (with "wasi:cli/exit@0.3.0" (instance $host))
    (with "stream" (instance $host))
    (with "clocks" (instance $host))
    (with "prov" (instance $prov-i))))
  (alias core export $main "run" (core func $run-core))
  (type $bare-res (result))
  (type $run-t (func async (result $bare-res)))
  (func $run-lifted (type $run-t) (canon lift (core func $run-core)))
  (instance $run-i (export "run" (func $run-lifted)))
  (export "wasi:cli/run@0.3.0" (instance $run-i))
)
