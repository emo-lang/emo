// The store (T21.6).
//
// Linear memory on a mutable `Bytes` buffer (page-granular grow,
// little-endian access, bounds checked before every touch), tables as
// arrays of values (grow / size / get / set / fill / copy / init), and
// mutable globals. Traps are values — `(ok, result, message)` — never
// raises. `Bytes` is the one mutable cell in the language, so memory
// contents change in place; tables thread as new arrays, and every
// operation that changes one returns the new record.
//
// The records are plain tuples so they cross module edges:
//
//   memory  (Bytes, max_pages Int64, has_max Bool)
//   table   (Array[(kind, bits)], max Int64, has_max Bool)
//   global  (mutable Bool, (kind, bits))

const page_bytes = 65536
const max_pages = 65536

def mask32(x Int64) Int64 {
  return x & 4294967295
}

// ---- little-endian words ----

def le_load(data Bytes, at Int64, width Int64) Int64 {
  return le_load_loop(data, at, width, 0, 0)
}

def le_load_loop(data Bytes, at Int64, width Int64, i Int64, acc Int64) Int64 {
  if i == width {
    return acc
  }
  const b = data.get(at + i)
  const shifted = b << (8 * i)
  return le_load_loop(data, at, width, i + 1, acc | shifted)
}

def le_store(data Bytes, at Int64, width Int64, bits Int64) Int64 {
  return le_store_loop(data, at, width, bits, 0)
}

def le_store_loop(data Bytes, at Int64, width Int64, bits Int64, i Int64) Int64 {
  if i == width {
    return 0
  }
  const byte = (bits >> (8 * i)) & 255
  data.set(at + i, byte)
  return le_store_loop(data, at, width, bits, i + 1)
}

// Sign- or zero-extend a `width`-byte word to 64 bits.
def extend_word(raw Int64, width Int64, signed Bool) Int64 {
  if !signed || width == 8 {
    return raw
  }
  const bits = width * 8
  const signbit = 1 << (bits - 1)
  if (raw & signbit) != 0 {
    return raw - (1 << bits)
  }
  return raw
}

// ---- memory ----

def mem_new(min Int64, max Int64, has_max Bool) (Bytes, Int64, Bool) {
  return (Bytes.new(min * page_bytes), max, has_max)
}

def mem_bytes(mem (Bytes, Int64, Bool)) Bytes {
  return mem[0]
}

def mem_size(mem (Bytes, Int64, Bool)) Int64 {
  return mem[0].length() / page_bytes
}

// Grow by `delta` pages. (ok, previous_size, new_memory); on failure the
// memory is returned unchanged and the size is -1.
def mem_grow(mem (Bytes, Int64, Bool), delta Int64) (Bool, Int64, (Bytes, Int64, Bool)) {
  const cur = mem_size(mem)
  const next = cur + delta
  if delta < 0 || next > max_pages {
    return (false, -1, mem)
  }
  if mem[2] && next > mem[1] {
    return (false, -1, mem)
  }
  const grown = Bytes.new(next * page_bytes)
  copy_bytes(grown, mem[0], 0, mem[0].length())
  return (true, cur, (grown, mem[1], mem[2]))
}

def copy_bytes(dst Bytes, src Bytes, at Int64, n Int64) Int64 {
  return copy_bytes_loop(dst, src, at, 0, n)
}

def copy_bytes_loop(dst Bytes, src Bytes, at Int64, i Int64, n Int64) Int64 {
  if i == n {
    return 0
  }
  dst.set(at + i, src.get(i))
  return copy_bytes_loop(dst, src, at, i + 1, n)
}

// Load `width` bytes at `addr + offset` (addr is an i32). Sign or zero
// extend; a trap is a value.
def mem_load(mem (Bytes, Int64, Bool), addr Int64, offset Int64, width Int64, signed Bool) (Bool, Int64, String) {
  const a = mask32(addr) + offset
  if a + width > mem[0].length() {
    return (false, 0, "out of bounds memory access")
  }
  return (true, extend_word(le_load(mem[0], a, width), width, signed), "")
}

def mem_store(mem (Bytes, Int64, Bool), addr Int64, offset Int64, width Int64, bits Int64) (Bool, String) {
  const a = mask32(addr) + offset
  if a + width > mem[0].length() {
    return (false, "out of bounds memory access")
  }
  le_store(mem[0], a, width, bits)
  return (true, "")
}

// ---- tables ----

def tbl_new(min Int64, max Int64, has_max Bool, init (Int64, Int64)) (Array[(Int64, Int64)], Int64, Bool) {
  return (tbl_repeat(init, min, []), max, has_max)
}

def tbl_repeat(v (Int64, Int64), n Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if n == 0 {
    return acc
  }
  return tbl_repeat(v, n - 1, acc.append(v))
}

def tbl_size(tbl (Array[(Int64, Int64)], Int64, Bool)) Int64 {
  return tbl[0].length()
}

def tbl_get(tbl (Array[(Int64, Int64)], Int64, Bool), i Int64) (Bool, (Int64, Int64), String) {
  if i < 0 || i >= tbl[0].length() {
    return (false, (112, -1), "out of bounds table access")
  }
  return (true, tbl[0][i], "")
}

def tbl_set(tbl (Array[(Int64, Int64)], Int64, Bool), i Int64, v (Int64, Int64)) (Bool, (Array[(Int64, Int64)], Int64, Bool), String) {
  if i < 0 || i >= tbl[0].length() {
    return (false, tbl, "out of bounds table access")
  }
  return (true, (arr_set(tbl[0], i, v), tbl[1], tbl[2]), "")
}

// Replace element `i` with a fresh array (arrays are immutable).
def arr_set(a Array[(Int64, Int64)], i Int64, v (Int64, Int64)) Array[(Int64, Int64)] {
  return arr_set_loop(a, i, v, 0, [])
}

def arr_set_loop(a Array[(Int64, Int64)], i Int64, v (Int64, Int64), j Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if j == a.length() {
    return acc
  }
  if j == i {
    return arr_set_loop(a, i, v, j + 1, acc.append(v))
  }
  return arr_set_loop(a, i, v, j + 1, acc.append(a[j]))
}

def tbl_grow(tbl (Array[(Int64, Int64)], Int64, Bool), delta Int64, init (Int64, Int64)) (Bool, Int64, (Array[(Int64, Int64)], Int64, Bool)) {
  const cur = tbl[0].length()
  const next = cur + delta
  if delta < 0 || next > 4294967295 {
    return (false, -1, tbl)
  }
  if tbl[2] && next > tbl[1] {
    return (false, -1, tbl)
  }
  const grown = tbl_repeat(init, delta, tbl[0])
  return (true, cur, (grown, tbl[1], tbl[2]))
}

// Fill n slots from i with v.
def tbl_fill(tbl (Array[(Int64, Int64)], Int64, Bool), i Int64, n Int64, v (Int64, Int64)) (Bool, (Array[(Int64, Int64)], Int64, Bool), String) {
  if i < 0 || n < 0 || i + n > tbl[0].length() {
    return (false, tbl, "out of bounds table access")
  }
  return (true, (arr_fill(tbl[0], i, i + n, v), tbl[1], tbl[2]), "")
}

def arr_fill(a Array[(Int64, Int64)], i Int64, end Int64, v (Int64, Int64)) Array[(Int64, Int64)] {
  return arr_fill_loop(a, i, end, v, [], 0)
}

def arr_fill_loop(a Array[(Int64, Int64)], i Int64, end Int64, v (Int64, Int64), acc Array[(Int64, Int64)], j Int64) Array[(Int64, Int64)] {
  if j == a.length() {
    return acc
  }
  if j >= i && j < end {
    return arr_fill_loop(a, i, end, v, acc.append(v), j + 1)
  }
  return arr_fill_loop(a, i, end, v, acc.append(a[j]), j + 1)
}

// Copy n slots from src[src_i] into dst[dst_i]. The source table is
// already read, so an overlap copies the original bytes.
def tbl_copy(dst (Array[(Int64, Int64)], Int64, Bool), dst_i Int64, src (Array[(Int64, Int64)], Int64, Bool), src_i Int64, n Int64) (Bool, (Array[(Int64, Int64)], Int64, Bool), String) {
  if dst_i < 0 || src_i < 0 || n < 0 || dst_i + n > dst[0].length() || src_i + n > src[0].length() {
    return (false, dst, "out of bounds table access")
  }
  return (true, (arr_copy(dst[0], dst_i, src[0], src_i, n, 0), dst[1], dst[2]), "")
}

def arr_copy(dst_arr Array[(Int64, Int64)], dst_i Int64, src_arr Array[(Int64, Int64)], src_i Int64, n Int64, k Int64) Array[(Int64, Int64)] {
  if k == n {
    return dst_arr
  }
  const next = arr_set(dst_arr, dst_i + k, src_arr[src_i + k])
  return arr_copy(next, dst_i, src_arr, src_i, n, k + 1)
}

// Initialize dst[dst_i..] from an element vector.
def tbl_init(dst (Array[(Int64, Int64)], Int64, Bool), dst_i Int64, elems Array[(Int64, Int64)], src_i Int64, n Int64) (Bool, (Array[(Int64, Int64)], Int64, Bool), String) {
  if dst_i < 0 || src_i < 0 || n < 0 || dst_i + n > dst[0].length() || src_i + n > elems.length() {
    return (false, dst, "out of bounds table access")
  }
  return (true, (arr_copy(dst[0], dst_i, elems, src_i, n, 0), dst[1], dst[2]), "")
}

// ---- globals ----

def global_new(v (Int64, Int64), mutable Bool) (Bool, (Int64, Int64)) {
  return (mutable, v)
}

def global_get(g (Bool, (Int64, Int64))) (Int64, Int64) {
  return g[1]
}

def global_set(g (Bool, (Int64, Int64)), v (Int64, Int64)) (Bool, (Int64, Int64)) {
  if !g[0] {
    return (false, g[1])
  }
  return (true, v)
}
