// The store (T21.6, shared cells T21.11).
//
// Linear memory, tables, and globals each live behind a `Box` — the
// language's one mutable cell — so an imported memory/table/global is
// *shared*: an edit through the import is visible to the exporter. The
// records are plain tuples so they cross module edges:
//
//   memory  (Box[Bytes], max_pages Int64, has_max Bool)
//   table   (Box[Array[(kind, bits)]], max Int64, has_max Bool)
//   global  (Box[(kind, bits)], mutable Bool)
//
// Little-endian access is bounds-checked before every touch, and traps
// are values — `(ok, result, message)` — never raises.

const page_bytes = 65536
const max_pages = 65536

def mask32(x Int64) Int64 {
  return x & 4294967295
}

// ---- little-endian words ----

def le_load(data Bytes, at Int64, width Int64) Int64 {
  return le_load_loop(data, at, width, 0, 0)
}

def le_load_loop(data Bytes, at Int64, width Int64, i Int64, acc Int64) Int64 {
  if i == width {
    return acc
  }
  const b = data.get(at + i)
  const shifted = b << (8 * i)
  return le_load_loop(data, at, width, i + 1, acc | shifted)
}

def le_store(data Bytes, at Int64, width Int64, bits Int64) Int64 {
  return le_store_loop(data, at, width, bits, 0)
}

def le_store_loop(data Bytes, at Int64, width Int64, bits Int64, i Int64) Int64 {
  if i == width {
    return 0
  }
  const byte = (bits >> (8 * i)) & 255
  data.set(at + i, byte)
  return le_store_loop(data, at, width, bits, i + 1)
}

// Sign- or zero-extend a `width`-byte word to 64 bits.
def extend_word(raw Int64, width Int64, signed Bool) Int64 {
  if !signed || width == 8 {
    return raw
  }
  const bits = width * 8
  const signbit = 1 << (bits - 1)
  if (raw & signbit) != 0 {
    return raw - (1 << bits)
  }
  return raw
}

// ---- memory ----

def mem_new(min Int64, max Int64, has_max Bool) (Box[Bytes], Int64, Bool) {
  return (Box.new(Bytes.new(min * page_bytes)), max, has_max)
}

def mem_bytes(mem (Box[Bytes], Int64, Bool)) Bytes {
  return mem[0].read()
}

def mem_size(mem (Box[Bytes], Int64, Bool)) Int64 {
  return mem[0].read().length() / page_bytes
}

// Grow by `delta` pages, in place. (ok, previous_size, memory).
def mem_grow(mem (Box[Bytes], Int64, Bool), delta Int64) (Bool, Int64, (Box[Bytes], Int64, Bool)) {
  const cur = mem_size(mem)
  const next = cur + delta
  if delta < 0 || next > max_pages {
    return (false, -1, mem)
  }
  if mem[2] && next > mem[1] {
    return (false, -1, mem)
  }
  // Grow with the language's native string concatenation: a zero-filled
  // buffer plus the old bytes, not a per-byte recursion (which the
  // evaluator's stack cannot carry past a few million).
  const old = mem[0].read()
  const zeros = Bytes.new(next * page_bytes - old.length()).to_string()
  const grown = (old.to_string() + zeros).to_bytes()
  mem[0].replace(grown)
  return (true, cur, mem)
}

def copy_bytes(dst Bytes, src Bytes, at Int64, n Int64) Int64 {
  return copy_bytes_loop(dst, src, at, 0, n)
}

def copy_bytes_loop(dst Bytes, src Bytes, at Int64, i Int64, n Int64) Int64 {
  if i == n {
    return 0
  }
  dst.set(at + i, src.get(i))
  return copy_bytes_loop(dst, src, at, i + 1, n)
}

def mem_load(mem (Box[Bytes], Int64, Bool), addr Int64, offset Int64, width Int64, signed Bool) (Bool, Int64, String) {
  const b = mem[0].read()
  const a = mask32(addr) + offset
  if a + width > b.length() {
    return (false, 0, "out of bounds memory access")
  }
  return (true, extend_word(le_load(b, a, width), width, signed), "")
}

def mem_store(mem (Box[Bytes], Int64, Bool), addr Int64, offset Int64, width Int64, bits Int64) (Bool, String) {
  const b = mem[0].read()
  const a = mask32(addr) + offset
  if a + width > b.length() {
    return (false, "out of bounds memory access")
  }
  le_store(b, a, width, bits)
  return (true, "")
}

// ---- tables ----

def tbl_new(min Int64, max Int64, has_max Bool, reftype Int64, init (Int64, Int64)) (Box[Array[(Int64, Int64)]], Int64, Bool, Int64) {
  return (Box.new(tbl_repeat(init, min, [])), max, has_max, reftype)
}

def tbl_repeat(v (Int64, Int64), n Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if n == 0 {
    return acc
  }
  return tbl_repeat(v, n - 1, acc.append(v))
}

def tbl_size(tbl (Box[Array[(Int64, Int64)]], Int64, Bool, Int64)) Int64 {
  return tbl[0].read().length()
}

def tbl_get(tbl (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), i Int64) (Bool, (Int64, Int64), String) {
  const a = tbl[0].read()
  if i < 0 || i >= a.length() {
    return (false, (112, -1), "out of bounds table access")
  }
  return (true, a[i], "")
}

def tbl_set(tbl (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), i Int64, v (Int64, Int64)) (Bool, (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), String) {
  const a = tbl[0].read()
  if i < 0 || i >= a.length() {
    return (false, tbl, "out of bounds table access")
  }
  tbl[0].replace(arr_set(a, i, v))
  return (true, tbl, "")
}

def arr_set(a Array[(Int64, Int64)], i Int64, v (Int64, Int64)) Array[(Int64, Int64)] {
  return arr_set_loop(a, i, v, 0, [])
}

def arr_set_loop(a Array[(Int64, Int64)], i Int64, v (Int64, Int64), j Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if j == a.length() {
    return acc
  }
  if j == i {
    return arr_set_loop(a, i, v, j + 1, acc.append(v))
  }
  return arr_set_loop(a, i, v, j + 1, acc.append(a[j]))
}

def tbl_grow(tbl (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), delta Int64, init (Int64, Int64)) (Bool, Int64, (Box[Array[(Int64, Int64)]], Int64, Bool, Int64)) {
  const cur = tbl[0].read().length()
  const next = cur + delta
  if delta < 0 || next > 4294967295 {
    return (false, -1, tbl)
  }
  if tbl[2] && next > tbl[1] {
    return (false, -1, tbl)
  }
  tbl[0].replace(tbl_repeat(init, delta, tbl[0].read()))
  return (true, cur, tbl)
}

def tbl_fill(tbl (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), i Int64, n Int64, v (Int64, Int64)) (Bool, (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), String) {
  const a = tbl[0].read()
  if i < 0 || n < 0 || i + n > a.length() {
    return (false, tbl, "out of bounds table access")
  }
  tbl[0].replace(arr_fill(a, i, i + n, v))
  return (true, tbl, "")
}

def arr_fill(a Array[(Int64, Int64)], i Int64, end Int64, v (Int64, Int64)) Array[(Int64, Int64)] {
  return arr_fill_loop(a, i, end, v, [], 0)
}

def arr_fill_loop(a Array[(Int64, Int64)], i Int64, end Int64, v (Int64, Int64), acc Array[(Int64, Int64)], j Int64) Array[(Int64, Int64)] {
  if j == a.length() {
    return acc
  }
  if j >= i && j < end {
    return arr_fill_loop(a, i, end, v, acc.append(v), j + 1)
  }
  return arr_fill_loop(a, i, end, v, acc.append(a[j]), j + 1)
}

def tbl_copy(dst (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), dst_i Int64, src (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), src_i Int64, n Int64) (Bool, (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), String) {
  const da = dst[0].read()
  const sa = src[0].read()
  if dst_i < 0 || src_i < 0 || n < 0 || dst_i + n > da.length() || src_i + n > sa.length() {
    return (false, dst, "out of bounds table access")
  }
  dst[0].replace(arr_copy(da, dst_i, sa, src_i, n, 0))
  return (true, dst, "")
}

def arr_copy(dst_arr Array[(Int64, Int64)], dst_i Int64, src_arr Array[(Int64, Int64)], src_i Int64, n Int64, k Int64) Array[(Int64, Int64)] {
  if k == n {
    return dst_arr
  }
  const next = arr_set(dst_arr, dst_i + k, src_arr[src_i + k])
  return arr_copy(next, dst_i, src_arr, src_i, n, k + 1)
}

def tbl_init(dst (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), dst_i Int64, elems Array[(Int64, Int64)], src_i Int64, n Int64) (Bool, (Box[Array[(Int64, Int64)]], Int64, Bool, Int64), String) {
  const da = dst[0].read()
  if dst_i < 0 || src_i < 0 || n < 0 || dst_i + n > da.length() || src_i + n > elems.length() {
    return (false, dst, "out of bounds table access")
  }
  dst[0].replace(arr_copy(da, dst_i, elems, src_i, n, 0))
  return (true, dst, "")
}

// ---- globals ----

def global_new(v (Int64, Int64), mutable Bool) (Box[(Int64, Int64)], Bool) {
  return (Box.new(v), mutable)
}

def global_get(g (Box[(Int64, Int64)], Bool)) (Int64, Int64) {
  return g[0].read()
}

def global_set(g (Box[(Int64, Int64)], Bool), v (Int64, Int64)) (Bool, (Box[(Int64, Int64)], Bool)) {
  if !g[1] {
    return (false, g)
  }
  g[0].replace(v)
  return (true, g)
}
