// The float families (T21.5), part one: the bridge and the moves.
//
// f64 arithmetic rides the host `Float64`; f32 arithmetic promotes to
// `Float64`, operates, and demotes with round-to-nearest-even bit
// surgery. f64 -> f32 has more than enough headroom that a single f32
// operation computed in f64 and rounded once is correctly rounded, so
// the bridge is exact for add/sub/mul/div. Moves (`reinterpret`,
// `abs`, `neg`, `copysign`) are bit operations and preserve payloads;
// min/max and comparisons are NaN-aware by bits, never by `=`.
//
// The language has no float math primitives (sqrt/floor/ceil/trunc/
// nearest) and no float <-> int conversion; those are recorded as gate
// pressure and land with their own task, not here.

// ---- constants ----

def sign64() Int64 {
  return -9223372036854775807 - 1
}

def inf64() Int64 {
  return 9218868437227405312
}

def canon64() Int64 {
  return 9221120237041090560
}

def inf32() Int64 {
  return 2139095040
}

def canon32() Int64 {
  return 2143289344
}

def mask32(x Int64) Int64 {
  return x & 4294967295
}

// ---- NaN / zero tests by bits ----

def f64_is_nan(bits Int64) Bool {
  const exp = (bits >> 52) & 2047
  const mant = bits & 4503599627370495
  return exp == 2047 && mant != 0
}

def f64_is_zero(bits Int64) Bool {
  return (bits & 9223372036854775807) == 0
}

def f32_is_nan(bits Int64) Bool {
  const b = mask32(bits)
  const exp = (b >> 23) & 255
  const mant = b & 8388607
  return exp == 255 && mant != 0
}

def f32_is_zero(bits Int64) Bool {
  return (mask32(bits) & 2147483647) == 0
}

// ---- promote / demote ----

// f32 bits -> f64 bits, exact.
def promote_f32(bits Int64) Int64 {
  const b = mask32(bits)
  const sign = (b >> 31) & 1
  const exp = (b >> 23) & 255
  const mant = b & 8388607
  const sbit = sign << 63
  if exp == 255 {
    if mant == 0 {
      return sbit | (2047 << 52)
    }
    const qm = (mant << 29) | 2251799813685248
    return sbit | (2047 << 52) | qm
  }
  if exp == 0 {
    if mant == 0 {
      return sbit
    }
    const p = high_bit(mant, 22)
    const e = p - 149
    const fm = (mant << (23 - p)) & 8388607
    const fexp = (e + 1023) << 52
    return sbit | fexp | (fm << 29)
  }
  const fexp = (exp + 896) << 52
  return sbit | fexp | (mant << 29)
}

// The index of the highest set bit of x (x > 0).
def high_bit(x Int64, i Int64) Int64 {
  const bit = (x >> i) & 1
  if bit != 0 {
    return i
  }
  return high_bit(x, i - 1)
}

// f64 bits -> f32 bits, round-to-nearest-even.
def demote_f64(bits Int64) Int64 {
  const sign = (bits >> 63) & 1
  const sbit = sign << 31
  const exp = (bits >> 52) & 2047
  const mant = bits & 4503599627370495
  if exp == 2047 {
    if mant == 0 {
      return sbit | inf32()
    }
    const fm = (mant >> 29) & 8388607 | 4194304
    return sbit | inf32() | fm
  }
  if exp == 0 {
    return sbit
  }
  const e = exp - 1023
  if e > 127 {
    return sbit | inf32()
  }
  if e >= -126 {
    return sbit | round_normal(e, mant)
  }
  return sbit | round_subnormal(e, mant)
}

// A normal f32 from a normal f64: drop 29 mantissa bits with ties to even.
def round_normal(e Int64, mant Int64) Int64 {
  var m = mant >> 29
  const rem = mant & 536870911
  const half = 268435456
  var e2 = e
  if rem > half || (rem == half && (m & 1) == 1) {
    m = m + 1
    if m == 8388608 {
      m = 0
      e2 = e2 + 1
      if e2 > 127 {
        return inf32()
      }
    }
  }
  const fb = (e2 + 127) << 23
  return fb | (m & 8388607)
}

// A subnormal (or zero) f32 from a value below 2^-126.
def round_subnormal(e Int64, mant Int64) Int64 {
  const sig = 4503599627370496 + mant
  const rshift = -97 - e
  if rshift > 53 {
    return 0
  }
  var m = sig >> rshift
  const lowmask = (1 << rshift) - 1
  const rem = sig & lowmask
  const half = 1 << (rshift - 1)
  if rem > half || (rem == half && (m & 1) == 1) {
    m = m + 1
  }
  if m >= 8388608 {
    return 8388608
  }
  return m
}

// ---- the bridge ----

def as_f64(kind Int64, bits Int64) Float64 {
  if kind == 125 {
    return Float64.from_bits(promote_f32(bits))
  }
  return Float64.from_bits(bits)
}

def of_f64(kind Int64, x Float64) Int64 {
  if kind == 125 {
    return demote_f64(x.to_bits())
  }
  return x.to_bits()
}

// Float division where the host would raise on a zero divisor.
def fdiv(x Float64, y Float64) Float64 {
  if y.to_bits() == 0 || y.to_bits() == (-9223372036854775807 - 1) {
    if f64_is_nan(x.to_bits()) || x.to_bits() == 0 || x.to_bits() == (-9223372036854775807 - 1) {
      return Float64.from_bits(canon64())
    }
    const s = (x.to_bits() ^ y.to_bits()) & (-9223372036854775807 - 1)
    return Float64.from_bits(s | inf64())
  }
  return x / y
}

// ---- arithmetic ----

def add(kind Int64, a Int64, b Int64) Int64 {
  return of_f64(kind, as_f64(kind, a) + as_f64(kind, b))
}

def sub(kind Int64, a Int64, b Int64) Int64 {
  return of_f64(kind, as_f64(kind, a) - as_f64(kind, b))
}

def mul(kind Int64, a Int64, b Int64) Int64 {
  return of_f64(kind, as_f64(kind, a) * as_f64(kind, b))
}

def div(kind Int64, a Int64, b Int64) Int64 {
  return of_f64(kind, fdiv(as_f64(kind, a), as_f64(kind, b)))
}

// ---- moves ----

def abs(kind Int64, a Int64) Int64 {
  if kind == 125 {
    return mask32(a) & 2147483647
  }
  return a & 9223372036854775807
}

def neg(kind Int64, a Int64) Int64 {
  if kind == 125 {
    return mask32(a) ^ 2147483648
  }
  return a ^ (-9223372036854775807 - 1)
}

def copysign(kind Int64, a Int64, b Int64) Int64 {
  if kind == 125 {
    return (mask32(a) & 2147483647) | (mask32(b) & 2147483648)
  }
  return (a & 9223372036854775807) | (b & (-9223372036854775807 - 1))
}

// ---- min / max (NaN-aware, -0 honored) ----

def min(kind Int64, a Int64, b Int64) Int64 {
  if kind == 125 {
    return demote_f64(f64_min(promote_f32(a), promote_f32(b)))
  }
  return f64_min(a, b)
}

def max(kind Int64, a Int64, b Int64) Int64 {
  if kind == 125 {
    return demote_f64(f64_max(promote_f32(a), promote_f32(b)))
  }
  return f64_max(a, b)
}

def f64_min(a Int64, b Int64) Int64 {
  if f64_is_nan(a) || f64_is_nan(b) {
    return canon64()
  }
  if f64_is_zero(a) && f64_is_zero(b) {
    return a | b
  }
  if Float64.from_bits(a) < Float64.from_bits(b) {
    return a
  }
  return b
}

def f64_max(a Int64, b Int64) Int64 {
  if f64_is_nan(a) || f64_is_nan(b) {
    return canon64()
  }
  if f64_is_zero(a) && f64_is_zero(b) {
    return a & b
  }
  if Float64.from_bits(a) > Float64.from_bits(b) {
    return a
  }
  return b
}

// ---- comparisons (i32 0/1; every ordered comparison is false on NaN) ----

// op is a float comparison opcode: 91..96 (f32) and 97..102 (f64),
// six in a row, so the relation is (op - 91) % 6: eq, ne, lt, gt, le,
// ge. Equality is spelled `x <= y && y <= x` so a NaN is never equal.
def cmp(op Int64, kind Int64, a Int64, b Int64) Int64 {
  const x = as_f64(kind, a)
  const y = as_f64(kind, b)
  const rel = (op - 91) % 6
  if rel == 0 {
    return bool_bit(x <= y && y <= x)
  }
  if rel == 1 {
    return bool_bit(!(x <= y) || !(y <= x))
  }
  if rel == 2 {
    return bool_bit(x < y)
  }
  if rel == 3 {
    return bool_bit(y < x)
  }
  if rel == 4 {
    return bool_bit(x <= y)
  }
  return bool_bit(y <= x)
}

def bool_bit(b Bool) Int64 {
  if b {
    return 1
  }
  return 0
}

// ---- rounding ----

def sqrt(kind Int64, a Int64) Int64 {
  return of_f64(kind, as_f64(kind, a).sqrt())
}

def floor(kind Int64, a Int64) Int64 {
  return of_f64(kind, as_f64(kind, a).floor())
}

def ceil(kind Int64, a Int64) Int64 {
  return of_f64(kind, as_f64(kind, a).ceil())
}

def trunc(kind Int64, a Int64) Int64 {
  return of_f64(kind, as_f64(kind, a).trunc())
}

// Round half to even, the spec's `nearest`. A NaN input yields an
// arithmetic (quiet) NaN, and a result of zero keeps the input's sign.
def nearest(kind Int64, a Int64) Int64 {
  if is_nan(kind, a) {
    return quiet_nan(kind, a)
  }
  const x = as_f64(kind, a)
  const f = x.floor()
  const d = x - f
  var r = f
  if d > 0.5 {
    r = f + 1.0
  }
  if d == 0.5 {
    const half = f * 0.5
    const hf = half.floor()
    if !(half <= hf && hf <= half) {
      r = f + 1.0
    }
  }
  if r == 0.0 {
    return zero_with_sign(kind, a)
  }
  return of_f64(kind, r)
}

// Set the mantissa's top bit, turning any NaN into an arithmetic one.
def quiet_nan(kind Int64, a Int64) Int64 {
  if kind == 125 {
    return mask32(a) | 4194304
  }
  return a | 2251799813685248
}

def zero_with_sign(kind Int64, a Int64) Int64 {
  if kind == 125 {
    if (mask32(a) & 2147483648) != 0 {
      return 2147483648
    }
    return 0
  }
  if a < 0 {
    return -9223372036854775807 - 1
  }
  return 0
}

def is_nan(kind Int64, a Int64) Bool {
  if kind == 125 {
    return f32_is_nan(a)
  }
  return f64_is_nan(a)
}

// A pattern move: the bits are the value.
def reinterpret(a Int64) Int64 {
  return a
}

// The f64 bit pattern of a value of either float width (f32 promotes).
def to_f64_bits(kind Int64, a Int64) Int64 {
  if kind == 125 {
    return promote_f32(a)
  }
  return a
}

def sign32(x Int64) Int64 {
  const b = mask32(x)
  if b >= 2147483648 {
    return b - 4294967296
  }
  return b
}

def logical_shr(x Int64, n Int64) Int64 {
  if n == 0 {
    return x
  }
  const lowmask = (1 << (64 - n)) - 1
  return (x >> n) & lowmask
}

def clz64(x Int64) Int64 {
  return clz64_loop(x, 0)
}

def clz64_loop(x Int64, i Int64) Int64 {
  if i == 64 {
    return 64
  }
  const bit = (x >> (63 - i)) & 1
  if bit != 0 {
    return i
  }
  return clz64_loop(x, i + 1)
}

// ---- int -> float ----

def f64_of_i32_s(bits Int64) Int64 {
  return sign32(bits).to_float64().to_bits()
}

def f64_of_i32_u(bits Int64) Int64 {
  return mask32(bits).to_float64().to_bits()
}

def f64_of_i64_s(bits Int64) Int64 {
  return bits.to_float64().to_bits()
}

// u64 -> f64 without a u64 type: high and low halves are each exact, and
// the one f64 addition rounds exactly once.
def f64_of_i64_u(bits Int64) Int64 {
  if bits >= 0 {
    return bits.to_float64().to_bits()
  }
  const hi = logical_shr(bits, 32)
  const lo = bits & 4294967295
  const x = hi.to_float64() * 4294967296.0
  return (x + lo.to_float64()).to_bits()
}

// Round an unsigned 64-bit magnitude to the nearest f32, ties to even.
def int_to_f32(sign Int64, m Int64) Int64 {
  const sbit = sign << 31
  if m == 0 {
    return sbit
  }
  const k = 63 - clz64(m)
  if k <= 23 {
    const fsmall = (k + 127) << 23
    const mant0 = (m << (23 - k)) & 8388607
    return sbit | fsmall | mant0
  }
  const shift = k - 23
  var top = logical_shr(m, shift)
  const lowmask = (1 << shift) - 1
  const rem = m & lowmask
  const half = 1 << (shift - 1)
  var e = k
  if rem > half || (rem == half && (top & 1) == 1) {
    top = top + 1
    if top == 16777216 {
      top = 8388608
      e = e + 1
    }
  }
  const fexp = (e + 127) << 23
  return sbit | fexp | (top & 8388607)
}

def f32_of_i32_s(bits Int64) Int64 {
  const v = sign32(bits)
  if v >= 0 {
    return int_to_f32(0, v)
  }
  return int_to_f32(1, 0 - v)
}

def f32_of_i32_u(bits Int64) Int64 {
  return int_to_f32(0, mask32(bits))
}

def f32_of_i64_s(bits Int64) Int64 {
  if bits >= 0 {
    return int_to_f32(0, bits)
  }
  return int_to_f32(1, 0 - bits)
}

def f32_of_i64_u(bits Int64) Int64 {
  return int_to_f32(0, bits)
}

// ---- float -> int (truncating toward zero, with the spec's traps) ----
//
// `bits` is an f64 pattern; f32 callers promote first (exact).

def trunc_i64_s(bits Int64) (Bool, Int64, String) {
  if f64_is_nan(bits) {
    return (false, 0, "invalid conversion to integer")
  }
  const t = Float64.from_bits(bits).trunc()
  if t < -9223372036854775808.0 || t >= 9223372036854775808.0 {
    return (false, 0, "integer overflow")
  }
  return (true, t.to_int64(), "")
}

def trunc_i64_u(bits Int64) (Bool, Int64, String) {
  if f64_is_nan(bits) {
    return (false, 0, "invalid conversion to integer")
  }
  const t = Float64.from_bits(bits).trunc()
  if t < 0.0 || t >= 18446744073709551616.0 {
    return (false, 0, "integer overflow")
  }
  if t < 9223372036854775808.0 {
    return (true, t.to_int64(), "")
  }
  const low = (t - 9223372036854775808.0).to_int64()
  return (true, low | (-9223372036854775807 - 1), "")
}

def trunc_i32_s(bits Int64) (Bool, Int64, String) {
  if f64_is_nan(bits) {
    return (false, 0, "invalid conversion to integer")
  }
  const t = Float64.from_bits(bits).trunc()
  if t < -2147483648.0 || t > 2147483647.0 {
    return (false, 0, "integer overflow")
  }
  return (true, mask32(t.to_int64()), "")
}

def trunc_i32_u(bits Int64) (Bool, Int64, String) {
  if f64_is_nan(bits) {
    return (false, 0, "invalid conversion to integer")
  }
  const t = Float64.from_bits(bits).trunc()
  if t < 0.0 || t > 4294967295.0 {
    return (false, 0, "integer overflow")
  }
  return (true, mask32(t.to_int64()), "")
}

// Saturating variants: no trap, clamp (NaN to zero).

def trunc_sat_i64_s(bits Int64) Int64 {
  if f64_is_nan(bits) {
    return 0
  }
  const t = Float64.from_bits(bits).trunc()
  if t < -9223372036854775808.0 {
    return -9223372036854775807 - 1
  }
  if t >= 9223372036854775808.0 {
    return 9223372036854775807
  }
  return t.to_int64()
}

def trunc_sat_i64_u(bits Int64) Int64 {
  if f64_is_nan(bits) {
    return 0
  }
  const t = Float64.from_bits(bits).trunc()
  if t <= 0.0 {
    return 0
  }
  if t >= 18446744073709551616.0 {
    return -1
  }
  if t < 9223372036854775808.0 {
    return t.to_int64()
  }
  const low = (t - 9223372036854775808.0).to_int64()
  return low | (-9223372036854775807 - 1)
}

def trunc_sat_i32_s(bits Int64) Int64 {
  if f64_is_nan(bits) {
    return 0
  }
  const t = Float64.from_bits(bits).trunc()
  if t <= -2147483648.0 {
    return 2147483648
  }
  if t >= 2147483648.0 {
    return 2147483647
  }
  return mask32(t.to_int64())
}

def trunc_sat_i32_u(bits Int64) Int64 {
  if f64_is_nan(bits) {
    return 0
  }
  const t = Float64.from_bits(bits).trunc()
  if t <= 0.0 {
    return 0
  }
  if t >= 4294967296.0 {
    return 4294967295
  }
  return mask32(t.to_int64())
}
