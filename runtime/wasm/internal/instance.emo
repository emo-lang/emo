// The instance model (T21.2).
//
// The decoder and validator (steps 20) prove a module sound; this
// materializes what they proved into frozen records the interpreter can
// walk without re-parsing: function types, imports, function bodies as
// byte ranges, the table / memory / global declarations, the element
// and data segments, exports, and the start function.
//
// The walk is section-scoped: `find_section` locates a section's
// content once, and each parser owns its bytes. Classes stay inside
// this module — a qualified type annotation (`model.FuncType`) does not
// parse, and a field is assignable only inside `init` — so nothing here
// crosses a module edge except the verdict tuple and plain handles.
//
// `load` validates first (`internal.decode.module_from`), so a caller
// never sees an unvalidated module; the loaded modules live in a
// registry and the surface hands back an index.

class FuncType {
  def init(params Array[Int64], results Array[Int64]) {
    self.params = params
    self.results = results
  }
}

class Import {
  def init(module String, field String, kind Int64, type_idx Int64, reftype Int64, min Int64, max Int64, has_max Bool, mut Bool) {
    self.module = module
    self.field = field
    self.kind = kind
    self.type_idx = type_idx
    self.reftype = reftype
    self.min = min
    self.max = max
    self.has_max = has_max
    self.mut = mut
  }
}

// A function body: its type index, and the byte ranges of its locals
// vector and its instruction stream (up to, not including, the
// terminating `end`).
class FuncDef {
  def init(type_idx Int64, locals_start Int64, locals_end Int64, body_start Int64, body_end Int64) {
    self.type_idx = type_idx
    self.locals_start = locals_start
    self.locals_end = locals_end
    self.body_start = body_start
    self.body_end = body_end
  }
}

class TableDef {
  def init(reftype Int64, min Int64, max Int64, has_max Bool) {
    self.reftype = reftype
    self.min = min
    self.max = max
    self.has_max = has_max
  }
}

class MemDef {
  def init(min Int64, max Int64, has_max Bool) {
    self.min = min
    self.max = max
    self.has_max = has_max
  }
}

class GlobalDef {
  def init(code Int64, mut Bool, init_start Int64, init_end Int64) {
    self.code = code
    self.mut = mut
    self.init_start = init_start
    self.init_end = init_end
  }
}

class ExportDef {
  def init(name String, kind Int64, idx Int64) {
    self.name = name
    self.kind = kind
    self.idx = idx
  }
}

class ElemDef {
  def init(flag Int64, table_idx Int64, offset_start Int64, offset_end Int64, reftype Int64, items Array[Int64]) {
    self.flag = flag
    self.table_idx = table_idx
    self.offset_start = offset_start
    self.offset_end = offset_end
    self.reftype = reftype
    self.items = items
  }
}

class DataDef {
  def init(flag Int64, mem_idx Int64, offset_start Int64, offset_end Int64, bytes Bytes) {
    self.flag = flag
    self.mem_idx = mem_idx
    self.offset_start = offset_start
    self.offset_end = offset_end
    self.bytes = bytes
  }
}

class Module {
  def init(types Array[FuncType], imports Array[Import], funcs Array[FuncDef], tables Array[TableDef], mems Array[MemDef], globals Array[GlobalDef], exports Array[ExportDef], start Int64, elems Array[ElemDef], datas Array[DataDef], func_typeidxs Array[Int64], n_imp_funcs Int64, n_imp_globals Int64, data Bytes, dc Int64) {
    self.types = types
    self.imports = imports
    self.funcs = funcs
    self.tables = tables
    self.mems = mems
    self.globals = globals
    self.exports = exports
    self.start = start
    self.elems = elems
    self.datas = datas
    self.func_typeidxs = func_typeidxs
    self.n_imp_funcs = n_imp_funcs
    self.n_imp_globals = n_imp_globals
    self.data = data
    self.dc = dc
  }
}

// Every module `load` has accepted, indexed by its handle. The registry
// is the one piece of module state; the interpreter reads it by handle.
var loaded = []

// ---- byte helpers ----

// A cross-module field read off a tuple element — `p[0].pos` where `p`
// came from `internal.reader.u32` — does not type eagerly, so `+` over
// it silently defaults wrong; routing the read through an Int64
// parameter forces the type. (Language pressure recorded by step 21.)
def as_int(x Int64) Int64 {
  return x
}

// A name: u32 length then that many bytes, returned as a String.
def name_at(data Bytes, pos Int64, limit Int64) (Bool, String, Int64) {
  const p = internal.reader.u32(internal.reader.new(data, pos, limit))
  if p[0].failed {
    return (false, "", pos)
  }
  if p[1] > internal.reader.remaining(p[0]) {
    return (false, "", p[0].pos)
  }
  const b = internal.reader.take(p[0], p[1])
  return (true, b[1].to_string(), b[0].pos)
}

// Find a non-custom section's content range: (found, start, end).
def find_section(data Bytes, wanted Int64) (Bool, Int64, Int64) {
  return scan_sections(data, 8, wanted)
}

def scan_sections(data Bytes, pos Int64, wanted Int64) (Bool, Int64, Int64) {
  if pos >= data.length() {
    return (false, 0, 0)
  }
  const p = internal.reader.u8(internal.reader.new(data, pos, data.length()))
  if p[0].failed {
    return (false, 0, 0)
  }
  const id = p[1]
  const ps = internal.reader.u32(p[0])
  if ps[0].failed {
    return (false, 0, 0)
  }
  const size = ps[1]
  if size > internal.reader.remaining(ps[0]) {
    return (false, 0, 0)
  }
  const start = as_int(ps[0].pos)
  const stop = start + size
  if id == wanted {
    return (true, start, stop)
  }
  return scan_sections(data, stop, wanted)
}

// A valtype vector of known length, in order.
def valtype_vec(data Bytes, pos Int64, limit Int64, n Int64) (Array[Int64], Int64) {
  return valtype_acc(data, pos, limit, n, [])
}

def valtype_acc(data Bytes, pos Int64, limit Int64, n Int64, acc Array[Int64]) (Array[Int64], Int64) {
  if n == 0 {
    return (acc, pos)
  }
  const v = internal.reader.valtype_at(data, pos, limit)
  if !v[0] {
    return (acc, pos)
  }
  return valtype_acc(data, v[2], limit, n - 1, acc.append(v[1]))
}

// A functype: tag 0x60, param vector, result vector.
def functype_at(data Bytes, pos Int64, limit Int64) (Bool, FuncType, Int64) {
  if pos >= limit || data.get(pos) != 96 {
    return (false, FuncType.new([], []), pos)
  }
  const pn = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
  if pn[0].failed {
    return (false, FuncType.new([], []), pos)
  }
  const pv = valtype_vec(data, pn[0].pos, limit, pn[1])
  const rn = internal.reader.u32(internal.reader.new(data, pv[1], limit))
  if rn[0].failed {
    return (false, FuncType.new([], []), pos)
  }
  const rv = valtype_vec(data, rn[0].pos, limit, rn[1])
  return (true, FuncType.new(pv[0], rv[0]), rv[1])
}

// A u32 vector of known length, in order.
def u32_vec(data Bytes, pos Int64, limit Int64, n Int64) (Array[Int64], Int64) {
  return u32_acc(data, pos, limit, n, [])
}

def u32_acc(data Bytes, pos Int64, limit Int64, n Int64, acc Array[Int64]) (Array[Int64], Int64) {
  if n == 0 {
    return (acc, pos)
  }
  const p = internal.reader.u32(internal.reader.new(data, pos, limit))
  if p[0].failed {
    return (acc, pos)
  }
  return u32_acc(data, p[0].pos, limit, n - 1, acc.append(p[1]))
}

// A constant-expression range: from `pos` through the terminating 0x0b.
// The interpreter evaluates it later; the model keeps the range.
def const_range(data Bytes, pos Int64, limit Int64) (Int64, Int64) {
  const e = internal.reader.const_expr(internal.reader.new(data, pos, limit))
  if e[0].failed {
    return (pos, pos)
  }
  return (pos, e[0].pos)
}

// ---- section parsers ----

def parse_types(data Bytes) Array[FuncType] {
  const s = find_section(data, 1)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return types_rest(data, cn[0].pos, s[2], cn[1], [])
}

def types_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[FuncType]) Array[FuncType] {
  if n == 0 {
    return acc
  }
  const ft = functype_at(data, pos, limit)
  if !ft[0] {
    return acc
  }
  return types_rest(data, ft[2], limit, n - 1, acc.append(ft[1]))
}

def parse_func_typeidxs(data Bytes) Array[Int64] {
  const s = find_section(data, 3)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return u32_vec(data, cn[0].pos, s[2], cn[1])[0]
}

def parse_tables(data Bytes) Array[TableDef] {
  const s = find_section(data, 4)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return tables_rest(data, cn[0].pos, s[2], cn[1], [])
}

def tables_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[TableDef]) Array[TableDef] {
  if n == 0 {
    return acc
  }
  const rt = internal.model.reftype(data, pos, limit)
  if !rt[0] {
    return acc
  }
  const l = internal.model.limits(data, rt[2], limit)
  if !l[0] {
    return acc
  }
  return tables_rest(data, l[4], limit, n - 1, acc.append(TableDef.new(rt[1], l[1], l[2], l[3])))
}

def parse_mems(data Bytes) Array[MemDef] {
  const s = find_section(data, 5)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return mems_rest(data, cn[0].pos, s[2], cn[1], [])
}

def mems_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[MemDef]) Array[MemDef] {
  if n == 0 {
    return acc
  }
  const l = internal.model.limits(data, pos, limit)
  if !l[0] {
    return acc
  }
  return mems_rest(data, l[4], limit, n - 1, acc.append(MemDef.new(l[1], l[2], l[3])))
}

def parse_globals(data Bytes) Array[GlobalDef] {
  const s = find_section(data, 6)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return globals_rest(data, cn[0].pos, s[2], cn[1], [])
}

def globals_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[GlobalDef]) Array[GlobalDef] {
  if n == 0 {
    return acc
  }
  const gt = internal.model.globaltype(data, pos, limit)
  if !gt[0] {
    return acc
  }
  const r = const_range(data, gt[3], limit)
  return globals_rest(data, r[1], limit, n - 1, acc.append(GlobalDef.new(gt[1], gt[2], r[0], r[1])))
}

def parse_exports(data Bytes) Array[ExportDef] {
  const s = find_section(data, 7)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return exports_rest(data, cn[0].pos, s[2], cn[1], [])
}

def exports_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[ExportDef]) Array[ExportDef] {
  if n == 0 {
    return acc
  }
  const nm = name_at(data, pos, limit)
  if !nm[0] {
    return acc
  }
  if nm[2] >= limit {
    return acc
  }
  const kind = data.get(nm[2])
  const x = internal.reader.u32(internal.reader.new(data, nm[2] + 1, limit))
  if x[0].failed {
    return acc
  }
  return exports_rest(data, x[0].pos, limit, n - 1, acc.append(ExportDef.new(nm[1], kind, x[1])))
}

def parse_start(data Bytes) Int64 {
  const s = find_section(data, 8)
  if !s[0] {
    return -1
  }
  const x = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if x[0].failed {
    return -1
  }
  return x[1]
}

// Imports: (module, field, kind, type). The import desc is a function
// type index, a tabletype, a memtype, or a globaltype.
def parse_imports(data Bytes) Array[Import] {
  const s = find_section(data, 2)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return imports_rest(data, cn[0].pos, s[2], cn[1], [])
}

def imports_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[Import]) Array[Import] {
  if n == 0 {
    return acc
  }
  const m = name_at(data, pos, limit)
  if !m[0] {
    return acc
  }
  const f = name_at(data, m[2], limit)
  if !f[0] {
    return acc
  }
  const d = import_at(data, f[2], limit)
  if !d[0] {
    return acc
  }
  const imp = Import.new(m[1], f[1], d[1], d[2], d[3], d[4], d[5], d[6], d[7])
  return imports_rest(data, d[8], limit, n - 1, acc.append(imp))
}

// (ok, kind, type_idx, reftype, min, max, has_max, mut, end)
def import_at(data Bytes, pos Int64, limit Int64) (Bool, Int64, Int64, Int64, Int64, Int64, Bool, Bool, Int64) {
  if pos >= limit {
    return (false, 0, 0, 0, 0, 0, false, false, pos)
  }
  const kind = data.get(pos)
  if kind == 0 {
    const x = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
    if x[0].failed {
      return (false, 0, 0, 0, 0, 0, false, false, pos)
    }
    return (true, 0, x[1], 0, 0, 0, false, false, x[0].pos)
  }
  if kind == 1 {
    const rt = internal.model.reftype(data, pos + 1, limit)
    if !rt[0] {
      return (false, 0, 0, 0, 0, 0, false, false, pos)
    }
    const l = internal.model.limits(data, rt[2], limit)
    return (true, 1, 0, rt[1], l[1], l[2], l[3], false, l[4])
  }
  if kind == 2 {
    const l = internal.model.limits(data, pos + 1, limit)
    return (true, 2, 0, 0, l[1], l[2], l[3], false, l[4])
  }
  if kind == 3 {
    const gt = internal.model.globaltype(data, pos + 1, limit)
    return (true, 3, 0, gt[1], 0, 0, false, gt[2], gt[3])
  }
  return (false, 0, 0, 0, 0, 0, false, false, pos)
}

// Element segments: flag, table index, offset range, reftype, items.
def parse_elems(data Bytes) Array[ElemDef] {
  const s = find_section(data, 9)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return elems_rest(data, cn[0].pos, s[2], cn[1], [])
}

def elems_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[ElemDef]) Array[ElemDef] {
  if n == 0 {
    return acc
  }
  const pf = internal.reader.u32(internal.reader.new(data, pos, limit))
  if pf[0].failed {
    return acc
  }
  const flag = pf[1]
  var r = pf[0].pos
  var table_idx = 0
  var offset_start = -1
  var offset_end = -1
  var reftype = 112
  if flag == 0 || flag == 4 || flag == 2 || flag == 6 {
    if flag == 2 || flag == 6 {
      const t = internal.reader.u32(internal.reader.new(data, r, limit))
      table_idx = t[1]
      r = t[0].pos
    }
    const o = internal.reader.const_expr(internal.reader.new(data, r, limit))
    offset_start = r
    offset_end = o[0].pos
    r = o[0].pos
  }
  if flag == 5 || flag == 6 || flag == 7 {
    const rt = internal.model.elem_reftype(data, r, limit)
    reftype = rt[1]
    r = rt[2]
  }
  if flag == 1 || flag == 2 || flag == 3 {
    const k = internal.model.elemkind(data, r, limit)
    r = k[1]
  }
  const is_expr = flag >= 4
  const items = elem_items(data, r, limit, is_expr)
  return elems_rest(data, items[1], limit, n - 1, acc.append(ElemDef.new(flag, table_idx, offset_start, offset_end, reftype, items[0])))
}

// The item vector: funcidx (flags 0-3) or expression (4-7). An
// expression is `ref.func x` or `ref.null t`, each followed by `end`.
def elem_items(data Bytes, pos Int64, limit Int64, is_expr Bool) (Array[Int64], Int64) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return ([], pos)
  }
  return elem_items_rest(data, cn[0].pos, limit, cn[1], is_expr, [])
}

def elem_items_rest(data Bytes, pos Int64, limit Int64, n Int64, is_expr Bool, acc Array[Int64]) (Array[Int64], Int64) {
  if n == 0 {
    return (acc, pos)
  }
  if pos >= limit {
    return (acc, pos)
  }
  if is_expr {
    const b = data.get(pos)
    if b == 210 {
      const x = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
      const end = internal.reader.u8(x[0])
      return elem_items_rest(data, end[0].pos, limit, n - 1, is_expr, acc.append(x[1]))
    }
    const t = internal.reader.u8(internal.reader.new(data, pos + 1, limit))
    const end = internal.reader.u8(t[0])
    return elem_items_rest(data, end[0].pos, limit, n - 1, is_expr, acc.append(-1))
  }
  const x = internal.reader.u32(internal.reader.new(data, pos, limit))
  if x[0].failed {
    return (acc, pos)
  }
  return elem_items_rest(data, x[0].pos, limit, n - 1, is_expr, acc.append(x[1]))
}

// Data segments: flag, memory index, offset range, bytes.
def parse_datas(data Bytes) Array[DataDef] {
  const s = find_section(data, 11)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return datas_rest(data, cn[0].pos, s[2], cn[1], [])
}

def datas_rest(data Bytes, pos Int64, limit Int64, n Int64, acc Array[DataDef]) Array[DataDef] {
  if n == 0 {
    return acc
  }
  const pf = internal.reader.u32(internal.reader.new(data, pos, limit))
  if pf[0].failed {
    return acc
  }
  const flag = pf[1]
  var r = pf[0].pos
  var mem_idx = 0
  var offset_start = -1
  var offset_end = -1
  if flag == 0 || flag == 2 {
    if flag == 2 {
      const t = internal.reader.u32(internal.reader.new(data, r, limit))
      mem_idx = t[1]
      r = t[0].pos
    }
    const o = internal.reader.const_expr(internal.reader.new(data, r, limit))
    offset_start = r
    offset_end = o[0].pos
    r = o[0].pos
  }
  const b = internal.reader.u32(internal.reader.new(data, r, limit))
  if b[0].failed {
    return acc
  }
  const taken = internal.reader.take(b[0], b[1])
  return datas_rest(data, taken[0].pos, limit, n - 1, acc.append(DataDef.new(flag, mem_idx, offset_start, offset_end, taken[1])))
}

// The data-count section's value (-1 when absent).
def parse_datacount(data Bytes) Int64 {
  const s = find_section(data, 12)
  if !s[0] {
    return -1
  }
  const x = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if x[0].failed {
    return -1
  }
  return x[1]
}

def typeidx_at(typeidxs Array[Int64], i Int64) Int64 {
  if i < typeidxs.length() {
    return typeidxs[i]
  }
  return -1
}

// Function bodies: the code section's entries paired with the function
// section's type indices.
def parse_funcs(data Bytes, typeidxs Array[Int64]) Array[FuncDef] {
  const s = find_section(data, 10)
  if !s[0] {
    return []
  }
  const cn = internal.reader.u32(internal.reader.new(data, s[1], s[2]))
  if cn[0].failed {
    return []
  }
  return funcs_rest(data, cn[0].pos, s[2], cn[1], typeidxs, 0, [])
}

def funcs_rest(data Bytes, pos Int64, limit Int64, n Int64, typeidxs Array[Int64], i Int64, acc Array[FuncDef]) Array[FuncDef] {
  if n == 0 {
    return acc
  }
  const sz = internal.reader.u32(internal.reader.new(data, pos, limit))
  if sz[0].failed {
    return acc
  }
  const entry_start = as_int(sz[0].pos)
  const entry_end = entry_start + sz[1]
  const lv = internal.reader.locals_walk(data, entry_start, entry_end)
  const d = FuncDef.new(typeidx_at(typeidxs, i), entry_start, lv[1], lv[1], entry_end)
  return funcs_rest(data, entry_end, limit, n - 1, typeidxs, i + 1, acc.append(d))
}

// ---- assembly ----

// Materialize a validated module. The caller has run `module_from`
// first; a module that fails to parse yields empty records.
def parse(data Bytes) Module {
  const types = parse_types(data)
  const imports = parse_imports(data)
  const fn_typeidxs = parse_func_typeidxs(data)
  const funcs = parse_funcs(data, fn_typeidxs)
  const tables = parse_tables(data)
  const mems = parse_mems(data)
  const globals = parse_globals(data)
  const exports = parse_exports(data)
  const start = parse_start(data)
  const elems = parse_elems(data)
  const datas = parse_datas(data)
  const imp_funcs = count_imports(imports, 0)
  const imp_globals = count_imports(imports, 3)
  const dc = parse_datacount(data)
  return Module.new(types, imports, funcs, tables, mems, globals, exports, start, elems, datas, fn_typeidxs, imp_funcs, imp_globals, data, dc)
}

def count_imports(imports Array[Import], kind Int64) Int64 {
  return count_imports_rest(imports, kind, 0, 0)
}

def count_imports_rest(imports Array[Import], kind Int64, i Int64, acc Int64) Int64 {
  if i == imports.length() {
    return acc
  }
  var next = acc
  if imports[i].kind == kind {
    next = acc + 1
  }
  return count_imports_rest(imports, kind, i + 1, next)
}

// ---- the entry points ----

// Validate then materialize. Returns the step-20 verdict; on success the
// module is appended to the registry and `handle` is its index.
def load(data Bytes) (Bool, String, Int64, String, Int64) {
  const v = internal.decode.module_from(data)
  if !v[0] {
    return (v[0], v[1], v[2], v[3], -1)
  }
  const m = parse(data)
  loaded = loaded.append(m)
  return (true, "", -1, "", loaded.length() - 1)
}

// A one-line summary of a loaded module: counts and the first body's
// range. The fixture reads this; the interpreter walks the records.
def describe(handle Int64) String {
  if handle < 0 || handle >= loaded.length() {
    return "no module"
  }
  const m = loaded[handle]
  var bodies = "none"
  if m.funcs.length() > 0 {
    bodies = m.funcs[0].body_start.to_string() + "-" + m.funcs[0].body_end.to_string()
  }
  return "types=" + m.types.length().to_string()
    + " imports=" + m.imports.length().to_string()
    + " funcs=" + m.funcs.length().to_string()
    + " tables=" + m.tables.length().to_string()
    + " mems=" + m.mems.length().to_string()
    + " globals=" + m.globals.length().to_string()
    + " exports=" + m.exports.length().to_string()
    + " elems=" + m.elems.length().to_string()
    + " datas=" + m.datas.length().to_string()
    + " start=" + m.start.to_string()
    + " imp_funcs=" + m.n_imp_funcs.to_string()
    + " body0=" + bodies
}

// ============================================================================
// The frame machine (T21.7)
// ============================================================================
//
// The operand stack and locals live in one shared byte arena of 16-byte
// slots (bits at +0, kind at +8, little-endian). `sp` is the operand
// top; each call claims a frame [base, ...) where the parameters and
// declared locals sit below the operand stack. Execution threads the
// instruction position and reports a signal — normal end, branch
// (with the label depth), return, trap, or an `if`'s arm boundary —
// which the enclosing structured handler either consumes or re-raises.
//
// The store (memory/tables/globals) is module state, like the arena, so
// the walker stays spelled with primitives.

var arena = Bytes.new(0)
var sp = 0
var frame_base = 0
var cur_inst = -1
var mems = []
var tables = []
var globals_store = []
var datalist = []
var elemlist = []
var instances = []
var reg_names = []
var reg_handles = []

// The `spectest` host module state (T21.9): one table and one memory,
// allocated once and shared by every importer.
var spectest_table = internal.store.tbl_new(10, 20, true, (112, -1))
var spectest_memory = internal.store.mem_new(1, 2, true)

def reset_machine() Int64 {
  if arena.length() == 0 {
    arena = Bytes.new(4194304)
  }
  sp = 0
  mems = []
  tables = []
  globals_store = []
  datalist = []
  elemlist = []
  return 0
}

def slot_bits_at(i Int64) Int64 {
  return internal.store.le_load(arena, i * 16, 8)
}

def slot_kind_at(i Int64) Int64 {
  return internal.store.le_load(arena, i * 16 + 8, 8)
}

def get_slot(i Int64) (Int64, Int64) {
  return (slot_kind_at(i), slot_bits_at(i))
}

def set_slot(i Int64, v (Int64, Int64)) Int64 {
  internal.store.le_store(arena, i * 16, 8, v[1])
  internal.store.le_store(arena, i * 16 + 8, 8, v[0])
  return 0
}

def push(v (Int64, Int64)) Int64 {
  set_slot(sp, v)
  sp = sp + 1
  return 0
}

def mkv(k Int64, b Int64) (Int64, Int64) {
  return (k, b)
}

def pop() (Int64, Int64) {
  sp = sp - 1
  return get_slot(sp)
}

// Move the top `k` values down to `base` and set `sp = base + k`.
def adjust(base Int64, k Int64) Int64 {
  const tmp = copy_top(k, [])
  write_tmp(base, tmp, 0, k)
  sp = base + k
  return 0
}

def copy_top(k Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if k == 0 {
    return acc
  }
  return copy_top(k - 1, acc.append(get_slot(sp - k)))
}

def write_tmp(base Int64, tmp Array[(Int64, Int64)], i Int64, k Int64) Int64 {
  if i == k {
    return 0
  }
  set_slot(base + i, tmp[i])
  return write_tmp(base, tmp, i + 1, k)
}

// Push each declared local as a zero of its own kind (the locals vector
// is a run-length list of valtype bytes).
def local_types(data Bytes, pos Int64, limit Int64) (Array[Int64], Int64) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return ([], pos)
  }
  return local_runs(data, cn[0].pos, limit, cn[1], [])
}

def local_runs(data Bytes, pos Int64, limit Int64, n Int64, acc Array[Int64]) (Array[Int64], Int64) {
  if n == 0 {
    return (acc, pos)
  }
  const c = internal.reader.u32(internal.reader.new(data, pos, limit))
  const v = internal.reader.valtype_at(data, c[0].pos, limit)
  const acc2 = expand_zeros(acc, v[1], c[1])
  return local_runs(data, v[2], limit, n - 1, acc2)
}

def expand_zeros(acc Array[Int64], kind Int64, n Int64) Array[Int64] {
  if n == 0 {
    return acc
  }
  return expand_zeros(acc.append(kind), kind, n - 1)
}

def init_locals(types Array[Int64], i Int64, n Int64) Int64 {
  if i >= n {
    return 0
  }
  push(mkv(types[i], 0))
  return init_locals(types, i + 1, n)
}

// ---- block types ----

// (nparams, nresults, position after the block type).
def block_arity(m Module, pos Int64, limit Int64) (Int64, Int64, Int64) {
  if pos >= limit {
    return (0, 0, pos)
  }
  const b = m.data.get(pos)
  if b == 64 {
    return (0, 0, pos + 1)
  }
  if b == 127 || b == 126 || b == 125 || b == 124 || b == 112 || b == 111 {
    return (0, 1, pos + 1)
  }
  const x = internal.reader.s33(internal.reader.new(m.data, pos, limit))
  if x[0].failed {
    return (0, 0, pos)
  }
  const ti = x[1]
  if ti < 0 || ti >= m.types.length() {
    return (0, 0, x[0].pos)
  }
  const ft = m.types[ti]
  return (ft.params.length(), ft.results.length(), x[0].pos)
}

// The position after the matching `end` of a body starting at `pos`.
def end_of(m Module, pos Int64, limit Int64) Int64 {
  return internal.reader.instrs(internal.reader.new(m.data, pos, limit), m.dc).pos
}

// ---- frames ----

def call_func(m Module, fidx Int64) (Bool, String) {
  if fidx < m.n_imp_funcs {
    const t = instances[cur_inst].targets[fidx]
    if t[0] == 1 {
      return call_host(m, fidx, t[1])
    }
    return call_other(t[1], t[2])
  }
  const li = fidx - m.n_imp_funcs
  if li < 0 || li >= m.funcs.length() {
    return (false, "unknown function")
  }
  const local = m.funcs[li]
  const ft = m.types[local.type_idx]
  const nparams = ft.params.length()
  const nresults = ft.results.length()
  const base = sp - nparams
  const lt = local_types(m.data, local.locals_start, local.locals_end)
  init_locals(lt[0], 0, lt[0].length())
  const saved_base = frame_base
  frame_base = base
  const r = exec_seq(m, local.body_start, local.body_end)
  frame_base = saved_base
  if r[0] == 3 {
    return (false, r[3])
  }
  adjust(base, nresults)
  return (true, "")
}

// ---- the walker ----
//
// signal: 0 = reached the matching end, 1 = branch (arg = label depth),
// 2 = return, 3 = trap, 4 = an `if`'s else boundary.

def exec_seq(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  if pos >= limit {
    return (0, 0, pos, "")
  }
  const op = m.data.get(pos)
  if op == 11 {
    return (0, 0, pos + 1, "")
  }
  if op == 5 {
    return (4, 0, pos + 1, "")
  }
  if op == 1 {
    return exec_seq(m, pos + 1, limit)
  }
  if op == 26 {
    sp = sp - 1
    return exec_seq(m, pos + 1, limit)
  }
  if op == 0 {
    return (3, 0, pos + 1, "unreachable")
  }
  if op == 2 {
    const r = run_block(m, pos + 1, limit, false)
    if r[0] == 0 {
      return exec_seq(m, r[2], limit)
    }
    return r
  }
  if op == 3 {
    const r = run_loop(m, pos + 1, limit)
    if r[0] == 0 {
      return exec_seq(m, r[2], limit)
    }
    return r
  }
  if op == 4 {
    const r = run_if(m, pos + 1, limit)
    if r[0] == 0 {
      return exec_seq(m, r[2], limit)
    }
    return r
  }
  if op == 12 || op == 13 || op == 14 || op == 15 {
    return run_control(m, op, pos, limit)
  }
  if op == 16 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    if x[0].failed {
      return (3, 0, pos + 1, "malformed call")
    }
    const r = call_func(m, x[1])
    if !r[0] {
      return (3, 0, x[0].pos, r[1])
    }
    return exec_seq(m, x[0].pos, limit)
  }
  if op == 17 {
    return run_call_indirect(m, pos + 1, limit)
  }
  if op == 27 {
    return run_select(m, pos + 1, limit)
  }
  if op == 28 {
    const after = internal.reader.valtype_bytes(internal.reader.new(m.data, pos + 1, limit)).pos
    return run_select(m, after, limit)
  }
  if op >= 32 && op <= 36 {
    return run_var(m, op, pos + 1, limit)
  }
  if op == 37 || op == 38 {
    return run_table_getset(m, op, pos + 1, limit)
  }
  if op >= 40 && op <= 62 {
    return run_mem(m, op, pos + 1, limit)
  }
  if op == 63 || op == 64 {
    return run_mem_size_grow(m, op, pos + 2, limit)
  }
  if op == 65 {
    const x = internal.reader.s32(internal.reader.new(m.data, pos + 1, limit))
    push(mkv(127, internal.value.mask32(x[1])))
    return exec_seq(m, x[0].pos, limit)
  }
  if op == 66 {
    const x = internal.reader.s64(internal.reader.new(m.data, pos + 1, limit))
    push(mkv(126, x[1]))
    return exec_seq(m, x[0].pos, limit)
  }
  if op == 67 {
    const x = internal.reader.take(internal.reader.new(m.data, pos + 1, limit), 4)
    push(mkv(125, internal.store.le_load(x[1], 0, 4)))
    return exec_seq(m, x[0].pos, limit)
  }
  if op == 68 {
    const x = internal.reader.take(internal.reader.new(m.data, pos + 1, limit), 8)
    push(mkv(124, internal.store.le_load(x[1], 0, 8)))
    return exec_seq(m, x[0].pos, limit)
  }
  if op >= 69 && op <= 196 {
    const r = num_step(m, op)
    if !r[0] {
      return (3, 0, pos + 1, r[1])
    }
    return exec_seq(m, pos + 1, limit)
  }
  if op == 208 {
    const t = m.data.get(pos + 1)
    push(mkv(t, -1))
    return exec_seq(m, pos + 2, limit)
  }
  if op == 209 {
    const v = pop()
    push(mkv(127, bool_bit(v[1] < 0)))
    return exec_seq(m, pos + 1, limit)
  }
  if op == 210 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    push(mkv(112, pack_func(cur_inst, x[1])))
    return exec_seq(m, x[0].pos, limit)
  }
  if op == 252 {
    return run_bulk(m, pos + 1, limit)
  }
  return (3, 0, pos + 1, "illegal opcode")
}

def bool_bit(b Bool) Int64 {
  if b {
    return 1
  }
  return 0
}

// ---- structured control ----

def finish_block(r (Int64, Int64, Int64, String), base Int64, nresults Int64, end_after Int64) (Int64, Int64, Int64, String) {
  if r[0] == 2 || r[0] == 3 {
    return r
  }
  if r[0] == 0 || r[0] == 4 {
    adjust(base, nresults)
    return (0, 0, end_after, "")
  }
  if r[1] == 0 {
    adjust(base, nresults)
    return (0, 0, end_after, "")
  }
  return (1, r[1] - 1, r[2], "")
}

def run_block(m Module, pos Int64, limit Int64, is_loop Bool) (Int64, Int64, Int64, String) {
  const ar = block_arity(m, pos, limit)
  const base = sp - ar[0]
  const end_after = end_of(m, ar[2], limit)
  const r = exec_seq(m, ar[2], limit)
  return finish_block(r, base, ar[1], end_after)
}

def run_loop(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const ar = block_arity(m, pos, limit)
  const base = sp - ar[0]
  const end_after = end_of(m, ar[2], limit)
  return loop_iter(m, ar[2], limit, base, ar[0], ar[1], end_after)
}

def loop_iter(m Module, body Int64, limit Int64, base Int64, nparams Int64, nresults Int64, end_after Int64) (Int64, Int64, Int64, String) {
  const r = exec_seq(m, body, limit)
  if r[0] == 2 || r[0] == 3 {
    return r
  }
  if r[0] == 0 {
    adjust(base, nresults)
    return (0, 0, end_after, "")
  }
  if r[1] == 0 {
    adjust(base, nparams)
    return loop_iter(m, body, limit, base, nparams, nresults, end_after)
  }
  return (1, r[1] - 1, r[2], "")
}

def run_if(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const cond = pop()
  const ar = block_arity(m, pos, limit)
  const base = sp - ar[0]
  const body = ar[2]
  const arm = internal.reader.instrs2(internal.reader.new(m.data, body, limit), m.dc, true)
  const has_else = m.data.get(arm.pos - 1) == 5
  const else_start = arm.pos
  const end_after = if_expr(has_else, m, else_start, arm.pos, limit)
  if cond[1] != 0 {
    const r = exec_seq(m, body, limit)
    return finish_block(r, base, ar[1], end_after)
  }
  if has_else {
    const r = exec_seq(m, else_start, limit)
    return finish_block(r, base, ar[1], end_after)
  }
  return (0, 0, end_after, "")
}

def if_expr(has_else Bool, m Module, else_start Int64, arm_pos Int64, limit Int64) Int64 {
  if has_else {
    return end_of(m, else_start, limit)
  }
  return arm_pos
}

def run_control(m Module, op Int64, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  if op == 15 {
    return (2, 0, pos + 1, "")
  }
  if op == 12 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    return (1, x[1], x[0].pos, "")
  }
  if op == 13 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    const c = pop()
    if c[1] != 0 {
      return (1, x[1], x[0].pos, "")
    }
    return exec_seq(m, x[0].pos, limit)
  }
  // br_table: a vector of labels then the default.
  const cn = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
  const labels = internal.reader.u32_vec_end(cn[0], cn[1])
  if labels.failed {
    return (3, 0, pos + 1, "malformed br_table")
  }
  const dflt = internal.reader.u32(labels)
  const idx = internal.value.mask32(pop()[1])
  if idx >= cn[1] {
    return (1, dflt[1], dflt[0].pos, "")
  }
  const arr = read_labels(m.data, cn[0].pos, cn[1], [])
  return (1, arr[idx], dflt[0].pos, "")
}

def read_labels(data Bytes, pos Int64, n Int64, acc Array[Int64]) Array[Int64] {
  if n == 0 {
    return acc
  }
  const x = internal.reader.u32(internal.reader.new(data, pos, data.length()))
  return read_labels(data, x[0].pos, n - 1, acc.append(x[1]))
}

def run_select(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const c = pop()
  const b = pop()
  const a = pop()
  if c[1] != 0 {
    push(a)
  } else {
    push(b)
  }
  return exec_seq(m, pos, limit)
}

def run_var(m Module, op Int64, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const x = internal.reader.u32(internal.reader.new(m.data, pos, limit))
  const i = x[1]
  if op == 32 {
    push(get_slot(frame_base + i))
  }
  if op == 33 {
    set_slot(frame_base + i, pop())
  }
  if op == 34 {
    const v = pop()
    set_slot(frame_base + i, v)
    push(v)
  }
  if op == 35 {
    push(internal.store.global_get(globals_store[i]))
  }
  if op == 36 {
    const v = pop()
    const r = internal.store.global_set(globals_store[i], v)
    if r[0] {
      globals_store = global_replace(globals_store, i, r[1])
    }
  }
  return exec_seq(m, x[0].pos, limit)
}

def global_replace(gs Array[(Bool, (Int64, Int64))], i Int64, v (Int64, Int64)) Array[(Bool, (Int64, Int64))] {
  return global_replace_loop(gs, i, v, 0, [])
}

def global_replace_loop(gs Array[(Bool, (Int64, Int64))], i Int64, v (Int64, Int64), j Int64, acc Array[(Bool, (Int64, Int64))]) Array[(Bool, (Int64, Int64))] {
  if j == gs.length() {
    return acc
  }
  if j == i {
    const nv = (gs[j][0], v)
    return global_replace_loop(gs, i, v, j + 1, acc.append(nv))
  }
  return global_replace_loop(gs, i, v, j + 1, acc.append(gs[j]))
}

// ---- numeric dispatch ----

def int_bin(op Int64, kind Int64, a Int64, b Int64) (Bool, Int64, String) {
  const base = if_eq(kind, 127, 106, 124)
  const sub = op - base
  if sub == 0 {
    return (true, internal.ints.add(kind, a, b), "")
  }
  if sub == 1 {
    return (true, internal.ints.sub(kind, a, b), "")
  }
  if sub == 2 {
    return (true, internal.ints.mul(kind, a, b), "")
  }
  if sub == 3 {
    return internal.ints.div_s(kind, a, b)
  }
  if sub == 4 {
    return internal.ints.div_u(kind, a, b)
  }
  if sub == 5 {
    return internal.ints.rem_s(kind, a, b)
  }
  if sub == 6 {
    return internal.ints.rem_u(kind, a, b)
  }
  if sub == 7 {
    return (true, internal.ints.band(kind, a, b), "")
  }
  if sub == 8 {
    return (true, internal.ints.bor(kind, a, b), "")
  }
  if sub == 9 {
    return (true, internal.ints.bxor(kind, a, b), "")
  }
  if sub == 10 {
    return (true, internal.ints.shl(kind, a, b), "")
  }
  if sub == 11 {
    return (true, internal.ints.shr_s(kind, a, b), "")
  }
  if sub == 12 {
    return (true, internal.ints.shr_u(kind, a, b), "")
  }
  if sub == 13 {
    return (true, internal.ints.rotl(kind, a, b), "")
  }
  return (true, internal.ints.rotr(kind, a, b), "")
}

def if_eq(a Int64, b Int64, x Int64, y Int64) Int64 {
  if a == b {
    return x
  }
  return y
}

def float_un(op Int64, kind Int64, a Int64) Int64 {
  const base = if_eq(kind, 125, 139, 153)
  const sub = op - base
  if sub == 0 {
    return internal.floats.abs(kind, a)
  }
  if sub == 1 {
    return internal.floats.neg(kind, a)
  }
  if sub == 2 {
    return internal.floats.ceil(kind, a)
  }
  if sub == 3 {
    return internal.floats.floor(kind, a)
  }
  if sub == 4 {
    return internal.floats.trunc(kind, a)
  }
  if sub == 5 {
    return internal.floats.nearest(kind, a)
  }
  return internal.floats.sqrt(kind, a)
}

def float_bin(op Int64, kind Int64, a Int64, b Int64) Int64 {
  const base = if_eq(kind, 125, 146, 160)
  const sub = op - base
  if sub == 0 {
    return internal.floats.add(kind, a, b)
  }
  if sub == 1 {
    return internal.floats.sub(kind, a, b)
  }
  if sub == 2 {
    return internal.floats.mul(kind, a, b)
  }
  if sub == 3 {
    return internal.floats.div(kind, a, b)
  }
  if sub == 4 {
    return internal.floats.min(kind, a, b)
  }
  if sub == 5 {
    return internal.floats.max(kind, a, b)
  }
  return internal.floats.copysign(kind, a, b)
}

def num_step(m Module, op Int64) (Bool, String) {
  if op == 69 || op == 80 {
    const a = pop()
    push(mkv(127, bool_bit(a[1] == 0)))
    return (true, "")
  }
  if op >= 70 && op <= 79 {
    const b = pop()
    const a = pop()
    push(mkv(127, internal.ints.cmp(op, 127, a[1], b[1])))
    return (true, "")
  }
  if op >= 81 && op <= 90 {
    const b = pop()
    const a = pop()
    push(mkv(127, internal.ints.cmp(op, 126, a[1], b[1])))
    return (true, "")
  }
  if op >= 91 && op <= 96 {
    const b = pop()
    const a = pop()
    push(mkv(127, internal.floats.cmp(op, 125, a[1], b[1])))
    return (true, "")
  }
  if op >= 97 && op <= 102 {
    const b = pop()
    const a = pop()
    push(mkv(127, internal.floats.cmp(op, 124, a[1], b[1])))
    return (true, "")
  }
  if op >= 103 && op <= 105 {
    const a = pop()
    if op == 103 {
      push(mkv(127, internal.ints.clz(127, a[1])))
    }
    if op == 104 {
      push(mkv(127, internal.ints.ctz(127, a[1])))
    }
    if op == 105 {
      push(mkv(127, internal.ints.popcnt(127, a[1])))
    }
    return (true, "")
  }
  if op >= 106 && op <= 120 {
    const b = pop()
    const a = pop()
    const r = int_bin(op, 127, a[1], b[1])
    if !r[0] {
      return (false, r[2])
    }
    push(mkv(127, r[1]))
    return (true, "")
  }
  if op >= 121 && op <= 123 {
    const a = pop()
    if op == 121 {
      push(mkv(126, internal.ints.clz(126, a[1])))
    }
    if op == 122 {
      push(mkv(126, internal.ints.ctz(126, a[1])))
    }
    if op == 123 {
      push(mkv(126, internal.ints.popcnt(126, a[1])))
    }
    return (true, "")
  }
  if op >= 124 && op <= 138 {
    const b = pop()
    const a = pop()
    const r = int_bin(op, 126, a[1], b[1])
    if !r[0] {
      return (false, r[2])
    }
    push(mkv(126, r[1]))
    return (true, "")
  }
  if op >= 139 && op <= 145 {
    const a = pop()
    push(mkv(125, float_un(op, 125, a[1])))
    return (true, "")
  }
  if op >= 146 && op <= 152 {
    const b = pop()
    const a = pop()
    push(mkv(125, float_bin(op, 125, a[1], b[1])))
    return (true, "")
  }
  if op >= 153 && op <= 159 {
    const a = pop()
    push(mkv(124, float_un(op, 124, a[1])))
    return (true, "")
  }
  if op >= 160 && op <= 166 {
    const b = pop()
    const a = pop()
    push(mkv(124, float_bin(op, 124, a[1], b[1])))
    return (true, "")
  }
  return conv_step(op)
}

def conv_step(op Int64) (Bool, String) {
  if op == 167 {
    const a = pop()
    push(mkv(127, internal.value.mask32(a[1])))
    return (true, "")
  }
  if op >= 168 && op <= 171 {
    const src = if_eq(op, 168, 125, if_eq(op, 169, 125, 124))
    const a = pop()
    return conv_push_i32(op, a[1], src)
  }
  return conv_step2(op)
}

def conv_push_i32(op Int64, bits Int64, src Int64) (Bool, String) {
  const w = internal.floats.to_f64_bits(src, bits)
  if op == 168 || op == 170 {
    const r = internal.floats.trunc_i32_s(w)
    if !r[0] {
      return (false, r[2])
    }
    push(mkv(127, r[1]))
    return (true, "")
  }
  const r = internal.floats.trunc_i32_u(w)
  if !r[0] {
    return (false, r[2])
  }
  push(mkv(127, r[1]))
  return (true, "")
}

def conv_step2(op Int64) (Bool, String) {
  if op == 172 || op == 173 {
    const a = pop()
    if op == 172 {
      push(mkv(126, internal.ints.extend_i32_s(a[1])))
    } else {
      push(mkv(126, internal.ints.extend_i32_u(a[1])))
    }
    return (true, "")
  }
  if op >= 174 && op <= 177 {
    const src = if_eq(op, 174, 125, if_eq(op, 175, 125, 124))
    const a = pop()
    const w = internal.floats.to_f64_bits(src, a[1])
    if op == 174 || op == 176 {
      const r = internal.floats.trunc_i64_s(w)
      if !r[0] {
        return (false, r[2])
      }
      push(mkv(126, r[1]))
      return (true, "")
    }
    const r = internal.floats.trunc_i64_u(w)
    if !r[0] {
      return (false, r[2])
    }
    push(mkv(126, r[1]))
    return (true, "")
  }
  if op >= 178 && op <= 181 {
    const a = pop()
    if op == 178 {
      push(mkv(125, internal.floats.f32_of_i32_s(a[1])))
    }
    if op == 179 {
      push(mkv(125, internal.floats.f32_of_i32_u(a[1])))
    }
    if op == 180 {
      push(mkv(125, internal.floats.f32_of_i64_s(a[1])))
    }
    if op == 181 {
      push(mkv(125, internal.floats.f32_of_i64_u(a[1])))
    }
    return (true, "")
  }
  if op == 182 {
    const a = pop()
    push(mkv(125, internal.floats.demote_f64(a[1])))
    return (true, "")
  }
  if op >= 183 && op <= 186 {
    const a = pop()
    if op == 183 {
      push(mkv(124, internal.floats.f64_of_i32_s(a[1])))
    }
    if op == 184 {
      push(mkv(124, internal.floats.f64_of_i32_u(a[1])))
    }
    if op == 185 {
      push(mkv(124, internal.floats.f64_of_i64_s(a[1])))
    }
    if op == 186 {
      push(mkv(124, internal.floats.f64_of_i64_u(a[1])))
    }
    return (true, "")
  }
  if op == 187 {
    const a = pop()
    push(mkv(124, internal.floats.promote_f32(a[1])))
    return (true, "")
  }
  if op == 188 {
    const a = pop()
    push(mkv(127, internal.value.mask32(a[1])))
    return (true, "")
  }
  if op == 190 {
    const a = pop()
    push(mkv(125, internal.value.mask32(a[1])))
    return (true, "")
  }
  if op == 189 || op == 191 {
    const a = pop()
    push(mkv(if_eq(op, 189, 126, 124), a[1]))
    return (true, "")
  }
  if op == 192 || op == 193 {
    const a = pop()
    if op == 192 {
      push(mkv(127, internal.ints.extend8_s(127, a[1])))
    } else {
      push(mkv(127, internal.ints.extend16_s(127, a[1])))
    }
    return (true, "")
  }
  if op >= 194 && op <= 196 {
    const a = pop()
    if op == 194 {
      push(mkv(126, internal.ints.extend8_s(126, a[1])))
    }
    if op == 195 {
      push(mkv(126, internal.ints.extend16_s(126, a[1])))
    }
    if op == 196 {
      push(mkv(126, internal.ints.extend32_s(a[1])))
    }
    return (true, "")
  }
  return (false, "illegal numeric opcode")
}

// ---- call_indirect, table access, memory ----

def types_eq(a Array[Int64], b Array[Int64], i Int64) Bool {
  if i == a.length() || i == b.length() {
    return a.length() == b.length()
  }
  if a[i] != b[i] {
    return false
  }
  return types_eq(a, b, i + 1)
}

def func_type_idx(m Module, fidx Int64) Int64 {
  if fidx < m.n_imp_funcs {
    return nth_func_import_typeidx(m.imports, 0, fidx, 0)
  }
  return m.funcs[fidx - m.n_imp_funcs].type_idx
}

def nth_func_import_typeidx(imports Array[Import], i Int64, want Int64, seen Int64) Int64 {
  if i >= imports.length() {
    return -1
  }
  if imports[i].kind == 0 {
    if seen == want {
      return imports[i].type_idx
    }
    return nth_func_import_typeidx(imports, i + 1, want, seen + 1)
  }
  return nth_func_import_typeidx(imports, i + 1, want, seen)
}

def types_match(m Module, fidx Int64, ti Int64) Bool {
  const a = func_type_idx(m, fidx)
  if a < 0 {
    return false
  }
  const fa = m.types[a]
  const fb = m.types[ti]
  return types_eq(fa.params, fb.params, 0) && types_eq(fa.results, fb.results, 0)
}

def run_call_indirect(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const t = internal.reader.u32(internal.reader.new(m.data, pos, limit))
  const tb = internal.reader.u32(t[0])
  const after = tb[0].pos
  const elem = internal.value.mask32(pop()[1])
  if tb[1] >= tables.length() {
    return (3, 0, after, "undefined element")
  }
  const e = internal.store.tbl_get(tables[tb[1]], elem)
  if !e[0] {
    return (3, 0, after, e[2])
  }
  if e[1][1] < 0 {
    return (3, 0, after, "uninitialized element")
  }
  const bits = e[1][1]
  const h2 = pack_handle(bits)
  const fidx = pack_index(bits)
  if h2 < 0 || h2 >= instances.length() {
    return (3, 0, after, "uninitialized element")
  }
  if !types_match(instances[h2].module, fidx, t[1]) {
    return (3, 0, after, "indirect call type mismatch")
  }
  const r = call_other(h2, fidx)
  if !r[0] {
    return (3, 0, after, r[1])
  }
  return exec_seq(m, after, limit)
}

def table_replace(ts Array[(Array[(Int64, Int64)], Int64, Bool)], i Int64, t (Array[(Int64, Int64)], Int64, Bool)) Array[(Array[(Int64, Int64)], Int64, Bool)] {
  return table_replace_loop(ts, i, t, 0, [])
}

def table_replace_loop(ts Array[(Array[(Int64, Int64)], Int64, Bool)], i Int64, t (Array[(Int64, Int64)], Int64, Bool), j Int64, acc Array[(Array[(Int64, Int64)], Int64, Bool)]) Array[(Array[(Int64, Int64)], Int64, Bool)] {
  if j == ts.length() {
    return acc
  }
  if j == i {
    return table_replace_loop(ts, i, t, j + 1, acc.append(t))
  }
  return table_replace_loop(ts, i, t, j + 1, acc.append(ts[j]))
}

def run_table_getset(m Module, op Int64, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const x = internal.reader.u32(internal.reader.new(m.data, pos, limit))
  const i = internal.value.mask32(pop()[1])
  if op == 37 {
    if x[1] >= tables.length() {
      return (3, 0, x[0].pos, "undefined element")
    }
    const e = internal.store.tbl_get(tables[x[1]], i)
    if !e[0] {
      return (3, 0, x[0].pos, e[2])
    }
    push(e[1])
    return exec_seq(m, x[0].pos, limit)
  }
  const v = pop()
  if x[1] >= tables.length() {
    return (3, 0, x[0].pos, "undefined element")
  }
  const r = internal.store.tbl_set(tables[x[1]], i, v)
  if !r[0] {
    return (3, 0, x[0].pos, r[2])
  }
  tables = table_replace(tables, x[1], r[1])
  return exec_seq(m, x[0].pos, limit)
}

def load_width(op Int64) Int64 {
  if op == 40 || op == 42 || op == 52 || op == 53 {
    return 4
  }
  if op == 41 || op == 43 {
    return 8
  }
  if op == 44 || op == 45 || op == 48 || op == 49 {
    return 1
  }
  return 2
}

def load_kind(op Int64) Int64 {
  if op == 42 {
    return 125
  }
  if op == 43 {
    return 124
  }
  if op == 41 || (op >= 48 && op <= 53) {
    return 126
  }
  return 127
}

def run_mem(m Module, op Int64, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const a = internal.reader.u32(internal.reader.new(m.data, pos, limit))
  const o = internal.reader.u32(a[0])
  const after = o[0].pos
  if mems.length() == 0 {
    return (3, 0, after, "out of bounds memory access")
  }
  if op <= 53 {
    const width = load_width(op)
    const signed = op == 44 || op == 46 || op == 48 || op == 50 || op == 52
    const addr = pop()[1]
    const r = internal.store.mem_load(mems[0], addr, o[1], width, signed)
    if !r[0] {
      return (3, 0, after, r[2])
    }
    const kind = load_kind(op)
    if kind == 127 || kind == 125 {
      push(mkv(kind, internal.value.mask32(r[1])))
    } else {
      push(mkv(kind, r[1]))
    }
    return exec_seq(m, after, limit)
  }
  const width = store_width(op)
  const v = pop()
  const addr = pop()[1]
  const r = internal.store.mem_store(mems[0], addr, o[1], width, v[1])
  if !r[0] {
    return (3, 0, after, r[1])
  }
  return exec_seq(m, after, limit)
}

def store_width(op Int64) Int64 {
  if op == 54 || op == 56 || op == 62 {
    return 4
  }
  if op == 55 || op == 57 {
    return 8
  }
  if op == 58 || op == 60 {
    return 1
  }
  return 2
}

def run_mem_size_grow(m Module, op Int64, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  if mems.length() == 0 {
    return (3, 0, pos, "out of bounds memory access")
  }
  if op == 63 {
    push(mkv(127, internal.store.mem_size(mems[0])))
    return exec_seq(m, pos, limit)
  }
  const delta = internal.value.mask32(pop()[1])
  const r = internal.store.mem_grow(mems[0], delta)
  if r[0] {
    mems = mem_replace(mems, 0, r[2])
    push(mkv(127, r[1]))
  } else {
    push(mkv(127, 4294967295))
  }
  return exec_seq(m, pos, limit)
}

def mem_replace(ms Array[(Bytes, Int64, Bool)], i Int64, mm (Bytes, Int64, Bool)) Array[(Bytes, Int64, Bool)] {
  return mem_replace_loop(ms, i, mm, 0, [])
}

def mem_replace_loop(ms Array[(Bytes, Int64, Bool)], i Int64, mm (Bytes, Int64, Bool), j Int64, acc Array[(Bytes, Int64, Bool)]) Array[(Bytes, Int64, Bool)] {
  if j == ms.length() {
    return acc
  }
  if j == i {
    return mem_replace_loop(ms, i, mm, j + 1, acc.append(mm))
  }
  return mem_replace_loop(ms, i, mm, j + 1, acc.append(ms[j]))
}

// ---- the 0xfc prefix (bulk memory and tables) ----

def run_bulk(m Module, pos Int64, limit Int64) (Int64, Int64, Int64, String) {
  const x = internal.reader.u32(internal.reader.new(m.data, pos, limit))
  const s = x[1]
  if s <= 7 {
    return run_trunc_sat(m, s, x[0].pos, limit)
  }
  if s == 8 {
    const di = internal.reader.u32(x[0])
    const mi = internal.reader.u32(di[0])
    const n = internal.value.mask32(pop()[1])
    const src = internal.value.mask32(pop()[1])
    const dst = internal.value.mask32(pop()[1])
    if di[1] >= datalist.length() {
      return (3, 0, mi[0].pos, "out of bounds memory access")
    }
    const r = mem_init(mems[0], dst, datalist[di[1]], src, n)
    if !r[0] {
      return (3, 0, mi[0].pos, r[1])
    }
    return exec_seq(m, mi[0].pos, limit)
  }
  if s == 12 {
    const ei = internal.reader.u32(x[0])
    const ti = internal.reader.u32(ei[0])
    const n = internal.value.mask32(pop()[1])
    const src = internal.value.mask32(pop()[1])
    const dst = internal.value.mask32(pop()[1])
    if ei[1] >= elemlist.length() {
      return (3, 0, ti[0].pos, "out of bounds table access")
    }
    const r = internal.store.tbl_init(tables[ti[1]], dst, elemlist[ei[1]], src, n)
    if !r[0] {
      return (3, 0, ti[0].pos, r[2])
    }
    tables = table_replace(tables, ti[1], r[1])
    return exec_seq(m, ti[0].pos, limit)
  }
  if s == 9 {
    const di = internal.reader.u32(x[0])
    if di[1] < datalist.length() {
      datalist = replace_bytes(datalist, di[1], Bytes.new(0))
    }
    return exec_seq(m, di[0].pos, limit)
  }
  if s == 13 {
    const ei = internal.reader.u32(x[0])
    if ei[1] < elemlist.length() {
      elemlist = replace_elems(elemlist, ei[1], [])
    }
    return exec_seq(m, ei[0].pos, limit)
  }
  if s == 10 {
    const d = internal.reader.u32(x[0])
    const e = internal.reader.u32(d[0])
    const n = internal.value.mask32(pop()[1])
    const src = internal.value.mask32(pop()[1])
    const dst = internal.value.mask32(pop()[1])
    const r = mem_copy(mems[0], dst, src, n)
    if !r[0] {
      return (3, 0, e[0].pos, r[1])
    }
    return exec_seq(m, e[0].pos, limit)
  }
  if s == 11 {
    const d = internal.reader.u32(x[0])
    const n = internal.value.mask32(pop()[1])
    const val = internal.value.mask32(pop()[1])
    const dst = internal.value.mask32(pop()[1])
    const r = mem_fill(mems[0], dst, val, n)
    if !r[0] {
      return (3, 0, d[0].pos, r[1])
    }
    return exec_seq(m, d[0].pos, limit)
  }
  if s == 15 {
    const ti = internal.reader.u32(x[0])
    const n = internal.value.mask32(pop()[1])
    const init = pop()
    const r = internal.store.tbl_grow(tables[ti[1]], n, init)
    if r[0] {
      tables = table_replace(tables, ti[1], r[2])
      push(mkv(127, r[1]))
    } else {
      push(mkv(127, 4294967295))
    }
    return exec_seq(m, ti[0].pos, limit)
  }
  if s == 16 {
    const ti = internal.reader.u32(x[0])
    push(mkv(127, internal.store.tbl_size(tables[ti[1]])))
    return exec_seq(m, ti[0].pos, limit)
  }
  if s == 17 {
    const ti = internal.reader.u32(x[0])
    const n = internal.value.mask32(pop()[1])
    const v = pop()
    const i = internal.value.mask32(pop()[1])
    const r = internal.store.tbl_fill(tables[ti[1]], i, n, v)
    if !r[0] {
      return (3, 0, ti[0].pos, r[2])
    }
    tables = table_replace(tables, ti[1], r[1])
    return exec_seq(m, ti[0].pos, limit)
  }
  if s == 14 {
    const d = internal.reader.u32(x[0])
    const e = internal.reader.u32(d[0])
    const n = internal.value.mask32(pop()[1])
    const src = internal.value.mask32(pop()[1])
    const dst = internal.value.mask32(pop()[1])
    const r = internal.store.tbl_copy(tables[d[1]], dst, tables[e[1]], src, n)
    if !r[0] {
      return (3, 0, e[0].pos, r[2])
    }
    tables = table_replace(tables, d[1], r[1])
    return exec_seq(m, e[0].pos, limit)
  }
  return (3, 0, x[0].pos, "uninitialized element")
}

// The 0xfc trunc_sat sub-opcodes 0..7: (width, source kind, signedness).
def run_trunc_sat(m Module, s Int64, after Int64, limit Int64) (Int64, Int64, Int64, String) {
  const a = pop()
  const src_kind = if_eq(s % 4, 0, 125, if_eq(s % 4, 1, 125, 124))
  const w = internal.floats.to_f64_bits(src_kind, a[1])
  if s < 4 {
    if s % 2 == 0 {
      push(mkv(127, internal.floats.trunc_sat_i32_s(w)))
    } else {
      push(mkv(127, internal.floats.trunc_sat_i32_u(w)))
    }
  } else {
    if s % 2 == 0 {
      push(mkv(126, internal.floats.trunc_sat_i64_s(w)))
    } else {
      push(mkv(126, internal.floats.trunc_sat_i64_u(w)))
    }
  }
  return exec_seq(m, after, limit)
}

def replace_bytes(xs Array[Bytes], i Int64, v Bytes) Array[Bytes] {
  return replace_bytes_loop(xs, i, v, 0, [])
}

def replace_bytes_loop(xs Array[Bytes], i Int64, v Bytes, j Int64, acc Array[Bytes]) Array[Bytes] {
  if j == xs.length() {
    return acc
  }
  if j == i {
    return replace_bytes_loop(xs, i, v, j + 1, acc.append(v))
  }
  return replace_bytes_loop(xs, i, v, j + 1, acc.append(xs[j]))
}

def replace_elems(xs Array[Array[(Int64, Int64)]], i Int64, v Array[(Int64, Int64)]) Array[Array[(Int64, Int64)]] {
  return replace_elems_loop(xs, i, v, 0, [])
}

def replace_elems_loop(xs Array[Array[(Int64, Int64)]], i Int64, v Array[(Int64, Int64)], j Int64, acc Array[Array[(Int64, Int64)]]) Array[Array[(Int64, Int64)]] {
  if j == xs.length() {
    return acc
  }
  if j == i {
    return replace_elems_loop(xs, i, v, j + 1, acc.append(v))
  }
  return replace_elems_loop(xs, i, v, j + 1, acc.append(xs[j]))
}

def mem_init(mem (Bytes, Int64, Bool), dst Int64, src Bytes, src_i Int64, n Int64) (Bool, String) {
  if dst + n > mem[0].length() || src_i + n > src.length() {
    return (false, "out of bounds memory access")
  }
  copy_n(mem[0], src, src_i, dst, n)
  return (true, "")
}

def mem_copy(mem (Bytes, Int64, Bool), dst Int64, src Int64, n Int64) (Bool, String) {
  if dst + n > mem[0].length() || src + n > mem[0].length() {
    return (false, "out of bounds memory access")
  }
  const tmp = Bytes.new(n)
  copy_n(tmp, mem[0], src, 0, n)
  write_n(mem[0], dst, tmp, 0, n)
  return (true, "")
}

def mem_fill(mem (Bytes, Int64, Bool), dst Int64, val Int64, n Int64) (Bool, String) {
  if dst + n > mem[0].length() {
    return (false, "out of bounds memory access")
  }
  fill_n(mem[0], dst, val, 0, n)
  return (true, "")
}

def copy_n(dst Bytes, src Bytes, src_at Int64, dst_at Int64, n Int64) Int64 {
  if n == 0 {
    return 0
  }
  dst.set(dst_at, src.get(src_at))
  return copy_n(dst, src, src_at + 1, dst_at + 1, n - 1)
}

def write_n(dst Bytes, dst_at Int64, src Bytes, src_at Int64, n Int64) Int64 {
  return copy_n(dst, src, src_at, dst_at, n)
}

def fill_n(data Bytes, at Int64, val Int64, i Int64, n Int64) Int64 {
  if i == n {
    return 0
  }
  data.set(at + i, val & 255)
  return fill_n(data, at, val, i + 1, n)
}

// ---- the package entry: call an export ----

def find_export(m Module, name String, i Int64) Int64 {
  if i == m.exports.length() {
    return -1
  }
  if m.exports[i].name == name {
    return i
  }
  return find_export(m, name, i + 1)
}

def collect_results(from Int64, n Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if n == 0 {
    return acc
  }
  return collect_results(from + 1, n - 1, acc.append(get_slot(from)))
}

def get_global(handle Int64, name String) (Bool, (Int64, Int64), String) {
  if handle < 0 || handle >= instances.length() {
    return (false, mkv(127, 0), "no instance")
  }
  const inst = instances[handle]
  const ei = find_export(inst.module, name, 0)
  if ei < 0 {
    return (false, mkv(127, 0), "unknown export")
  }
  if inst.module.exports[ei].kind != 3 {
    return (false, mkv(127, 0), "not a global")
  }
  return (true, internal.store.global_get(inst.globals[inst.module.exports[ei].idx]), "")
}

def call(handle Int64, name String, args Array[(Int64, Int64)]) (Bool, Array[(Int64, Int64)], String) {
  if handle < 0 || handle >= instances.length() {
    return (false, [], "no instance")
  }
  const inst = instances[handle]
  const m = inst.module
  const ei = find_export(m, name, 0)
  if ei < 0 {
    return (false, [], "unknown export")
  }
  if m.exports[ei].kind != 0 {
    return (false, [], "not a function")
  }
  const fidx = m.exports[ei].idx
  const ft = m.types[func_type_idx(m, fidx)]
  reset_machine()
  cur_inst = handle
  mems = inst.mems
  tables = inst.tables
  globals_store = inst.globals
  datalist = inst.datalist
  elemlist = inst.elemlist
  push_args(args, 0, args.length())
  const r = call_func(m, fidx)
  instances = inst_replace(instances, handle, Instance.new(inst.module, mems, tables, globals_store, inst.targets, inst.start, datalist, elemlist))
  if !r[0] {
    return (false, [], r[1])
  }
  const out = collect_results(sp - ft.results.length(), ft.results.length(), [])
  return (true, out, "")
}

def push_args(args Array[(Int64, Int64)], i Int64, n Int64) Int64 {
  if i == n {
    return 0
  }
  push(args[i])
  return push_args(args, i + 1, n)
}

// ============================================================================
// Instantiation and linking (T21.8)
// ============================================================================

// A live module: its code plus the store (memories, tables, globals)
// and the resolved targets of its imported functions. `targets[i]` is
// (kind, handle, index): kind 0 = a function of instance `handle`,
// kind 1 = a host function (T21.9).
class Instance {
  def init(module Module, mems Array[(Bytes, Int64, Bool)], tables Array[(Array[(Int64, Int64)], Int64, Bool)], globals Array[(Bool, (Int64, Int64))], targets Array[(Int64, Int64, Int64)], start Int64, datalist Array[Bytes], elemlist Array[Array[(Int64, Int64)]]) {
    self.module = module
    self.mems = mems
    self.tables = tables
    self.globals = globals
    self.targets = targets
    self.start = start
    self.datalist = datalist
    self.elemlist = elemlist
  }
}


// Forget every loaded module, instance, and registration (a fresh run).
def reset_all() Int64 {
  loaded = []
  instances = []
  reg_names = []
  reg_handles = []
  return 0
}

def inst_replace(is Array[Instance], i Int64, v Instance) Array[Instance] {
  return inst_replace_loop(is, i, v, 0, [])
}

def inst_replace_loop(is Array[Instance], i Int64, v Instance, j Int64, acc Array[Instance]) Array[Instance] {
  if j == is.length() {
    return acc
  }
  if j == i {
    return inst_replace_loop(is, i, v, j + 1, acc.append(v))
  }
  return inst_replace_loop(is, i, v, j + 1, acc.append(is[j]))
}

def find_reg(name String, i Int64) Int64 {
  if i >= reg_names.length() {
    return -1
  }
  if reg_names[i] == name {
    return reg_handles[i]
  }
  return find_reg(name, i + 1)
}

def register_instance(h Int64, name String) Int64 {
  reg_names = reg_names.append(name)
  reg_handles = reg_handles.append(h)
  return 0
}

def tgt(k Int64, h Int64, idx Int64) (Int64, Int64, Int64) {
  return (k, h, idx)
}

// A funcref packs the owning instance and the function index.
def pack_func(h Int64, idx Int64) Int64 {
  return h * 4294967296 + idx
}

def pack_handle(bits Int64) Int64 {
  return bits / 4294967296
}

def pack_index(bits Int64) Int64 {
  return bits % 4294967296
}

// ---- constant expressions ----

// (ok, value, position after the `end`, message).
def eval_const(m Module, h Int64, pos Int64, limit Int64, globals Array[(Bool, (Int64, Int64))]) (Bool, (Int64, Int64), Int64, String) {
  if pos >= limit {
    return (false, (127, 0), pos, "constant expression required")
  }
  const op = m.data.get(pos)
  if op == 65 {
    const x = internal.reader.s32(internal.reader.new(m.data, pos + 1, limit))
    return (true, (127, internal.value.mask32(x[1])), x[0].pos, "")
  }
  if op == 66 {
    const x = internal.reader.s64(internal.reader.new(m.data, pos + 1, limit))
    return (true, (126, x[1]), x[0].pos, "")
  }
  if op == 67 {
    const x = internal.reader.take(internal.reader.new(m.data, pos + 1, limit), 4)
    return (true, (125, internal.store.le_load(x[1], 0, 4)), x[0].pos, "")
  }
  if op == 68 {
    const x = internal.reader.take(internal.reader.new(m.data, pos + 1, limit), 8)
    return (true, (124, internal.store.le_load(x[1], 0, 8)), x[0].pos, "")
  }
  if op == 208 {
    const t = m.data.get(pos + 1)
    return (true, (t, -1), pos + 2, "")
  }
  if op == 210 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    return (true, (112, pack_func(h, x[1])), x[0].pos, "")
  }
  if op == 35 {
    const x = internal.reader.u32(internal.reader.new(m.data, pos + 1, limit))
    if x[1] >= globals.length() {
      return (false, (127, 0), pos, "unknown global")
    }
    return (true, internal.store.global_get(globals[x[1]]), x[0].pos, "")
  }
  return (false, (127, 0), pos, "constant expression required")
}

// ---- imports ----

def resolve_imports(m Module, i Int64, imems Array[(Bytes, Int64, Bool)], itables Array[(Array[(Int64, Int64)], Int64, Bool)], iglobals Array[(Bool, (Int64, Int64))], targets Array[(Int64, Int64, Int64)]) (Bool, String, Array[(Bytes, Int64, Bool)], Array[(Array[(Int64, Int64)], Int64, Bool)], Array[(Bool, (Int64, Int64))], Array[(Int64, Int64, Int64)]) {
  if i >= m.imports.length() {
    return (true, "", imems, itables, iglobals, targets)
  }
  const imp = m.imports[i]
  if imp.module == "spectest" {
    return resolve_host(m, i, imems, itables, iglobals, targets)
  }
  const h = find_reg(imp.module, 0)
  if h < 0 {
    return (false, "unknown import `" + imp.module + "`", imems, itables, iglobals, targets)
  }
  const src = instances[h]
  const e = find_export(src.module, imp.field, 0)
  if e < 0 {
    return (false, "unknown import `" + imp.field + "`", imems, itables, iglobals, targets)
  }
  const ex = src.module.exports[e]
  if ex.kind != imp.kind {
    return (false, "incompatible import type", imems, itables, iglobals, targets)
  }
  if imp.kind == 0 {
    if !func_types_match(src.module, ex.idx, m, imp.type_idx) {
      return (false, "incompatible import type", imems, itables, iglobals, targets)
    }
    return resolve_imports(m, i + 1, imems, itables, iglobals, targets.append(tgt(0, h, ex.idx)))
  }
  if imp.kind == 1 {
    const tt = src.tables[ex.idx]
    if !limits_ok(imp.min, imp.max, imp.has_max, tt[0].length(), tt[1], tt[2]) {
      return (false, "incompatible import type", imems, itables, iglobals, targets)
    }
    return resolve_imports(m, i + 1, imems, itables.append(tt), iglobals, targets)
  }
  if imp.kind == 2 {
    const mm = src.mems[ex.idx]
    if !limits_ok(imp.min, imp.max, imp.has_max, mm[0].length() / 65536, mm[1], mm[2]) {
      return (false, "incompatible import type", imems, itables, iglobals, targets)
    }
    return resolve_imports(m, i + 1, imems.append(mm), itables, iglobals, targets)
  }
  const gg = src.globals[ex.idx]
  const gv = gg[1]
  if gg[0] != imp.mut || gv[0] != imp.reftype {
    return (false, "incompatible import type", imems, itables, iglobals, targets)
  }
  return resolve_imports(m, i + 1, imems, itables, iglobals.append(gg), targets)
}

// The actual limits must sit inside the import's declared limits.
def limits_ok(imp_min Int64, imp_max Int64, imp_has_max Bool, act_min Int64, act_max Int64, act_has_max Bool) Bool {
  if imp_min > act_min {
    return false
  }
  if !imp_has_max {
    return true
  }
  return act_has_max && act_max <= imp_max
}

def func_types_match(ma Module, fa_idx Int64, mb Module, ti Int64) Bool {
  const a = func_type_idx(ma, fa_idx)
  if a < 0 {
    return false
  }
  const fa = ma.types[a]
  const fb = mb.types[ti]
  return types_eq(fa.params, fb.params, 0) && types_eq(fa.results, fb.results, 0)
}

def init_globals(m Module, h Int64, i Int64, acc Array[(Bool, (Int64, Int64))]) (Bool, String, Array[(Bool, (Int64, Int64))]) {
  if i >= m.globals.length() {
    return (true, "", acc)
  }
  const gd = m.globals[i]
  const v = eval_const(m, h, gd.init_start, gd.init_end, acc)
  if !v[0] {
    return (false, v[3], acc)
  }
  const g = (gd.mut, v[1])
  return init_globals(m, h, i + 1, acc.append(g))
}

def init_mems(m Module, i Int64, acc Array[(Bytes, Int64, Bool)]) Array[(Bytes, Int64, Bool)] {
  if i >= m.mems.length() {
    return acc
  }
  const md = m.mems[i]
  return init_mems(m, i + 1, acc.append(internal.store.mem_new(md.min, md.max, md.has_max)))
}

def init_tables(m Module, i Int64, acc Array[(Array[(Int64, Int64)], Int64, Bool)]) Array[(Array[(Int64, Int64)], Int64, Bool)] {
  if i >= m.tables.length() {
    return acc
  }
  const td = m.tables[i]
  return init_tables(m, i + 1, acc.append(internal.store.tbl_new(td.min, td.max, td.has_max, (112, -1))))
}

// ---- segments ----

def elem_values(h Int64, items Array[Int64], i Int64, acc Array[(Int64, Int64)]) Array[(Int64, Int64)] {
  if i >= items.length() {
    return acc
  }
  if items[i] < 0 {
    return elem_values(h, items, i + 1, acc.append(mkv(112, -1)))
  }
  return elem_values(h, items, i + 1, acc.append(mkv(112, pack_func(h, items[i]))))
}

def layout_elems(m Module, h Int64, i Int64, tables Array[(Array[(Int64, Int64)], Int64, Bool)], globals Array[(Bool, (Int64, Int64))], elemlist Array[Array[(Int64, Int64)]]) (Bool, String, Array[(Array[(Int64, Int64)], Int64, Bool)], Array[Array[(Int64, Int64)]]) {
  if i >= m.elems.length() {
    return (true, "", tables, elemlist)
  }
  const ed = m.elems[i]
  const vals = elem_values(h, ed.items, 0, [])
  if ed.flag == 3 || ed.flag == 7 {
    return layout_elems(m, h, i + 1, tables, globals, elemlist.append([]))
  }
  if ed.flag == 1 || ed.flag == 5 {
    return layout_elems(m, h, i + 1, tables, globals, elemlist.append(vals))
  }
  const off = eval_const(m, h, ed.offset_start, ed.offset_end, globals)
  if !off[0] {
    return (false, off[3], tables, elemlist)
  }
  const at = internal.value.mask32(off[1][1])
  const r = internal.store.tbl_init(tables[ed.table_idx], at, vals, 0, vals.length())
  if !r[0] {
    return (false, r[2], tables, elemlist)
  }
  return layout_elems(m, h, i + 1, table_replace(tables, ed.table_idx, r[1]), globals, elemlist.append([]))
}

def layout_datas(m Module, h Int64, i Int64, mems Array[(Bytes, Int64, Bool)], globals Array[(Bool, (Int64, Int64))], datalist Array[Bytes]) (Bool, String, Array[(Bytes, Int64, Bool)], Array[Bytes]) {
  if i >= m.datas.length() {
    return (true, "", mems, datalist)
  }
  const dd = m.datas[i]
  if dd.flag == 1 {
    return layout_datas(m, h, i + 1, mems, globals, datalist.append(dd.bytes))
  }
  const off = eval_const(m, h, dd.offset_start, dd.offset_end, globals)
  if !off[0] {
    return (false, off[3], mems, datalist)
  }
  const at = internal.value.mask32(off[1][1])
  const ok = mem_write(mems[dd.mem_idx], at, dd.bytes)
  if !ok {
    return (false, "out of bounds memory access", mems, datalist)
  }
  return layout_datas(m, h, i + 1, mems, globals, datalist.append(Bytes.new(0)))
}

def mem_write(mem (Bytes, Int64, Bool), at Int64, bytes Bytes) Bool {
  if at + bytes.length() > mem[0].length() {
    return false
  }
  copy_n(mem[0], bytes, 0, at, bytes.length())
  return true
}

// ---- instantiate ----

// The instance's store, switched in around a cross-instance call.
def call_other(h Int64, fidx Int64) (Bool, String) {
  const save_mems = mems
  const save_tables = tables
  const save_globals = globals_store
  const save_inst = cur_inst
  const save_data = datalist
  const save_elem = elemlist
  const st = instances[h]
  mems = st.mems
  tables = st.tables
  globals_store = st.globals
  datalist = st.datalist
  elemlist = st.elemlist
  cur_inst = h
  const r = call_func(st.module, fidx)
  instances = inst_replace(instances, h, Instance.new(st.module, mems, tables, globals_store, st.targets, st.start, datalist, elemlist))
  mems = save_mems
  tables = save_tables
  globals_store = save_globals
  datalist = save_data
  elemlist = save_elem
  cur_inst = save_inst
  return r
}

def instantiate(handle Int64) (Bool, String, Int64) {
  if handle < 0 || handle >= loaded.length() {
    return (false, "no module", -1)
  }
  const m = loaded[handle]
  const h = instances.length()
  const r = resolve_imports(m, 0, [], [], [], [])
  if !r[0] {
    return (false, r[1], -1)
  }
  const g = init_globals(m, h, 0, r[4])
  if !g[0] {
    return (false, g[1], -1)
  }
  const mems0 = init_mems(m, 0, r[2])
  const tables0 = init_tables(m, 0, r[3])
  const inst = Instance.new(m, mems0, tables0, g[2], r[5], m.start, [], [])
  instances = instances.append(inst)
  const e = layout_elems(m, h, 0, tables0, g[2], [])
  if !e[0] {
    return (false, e[1], -1)
  }
  const d = layout_datas(m, h, 0, mems0, g[2], [])
  if !d[0] {
    return (false, d[1], -1)
  }
  instances = inst_replace(instances, h, Instance.new(m, mems0, e[2], g[2], r[5], m.start, d[3], e[3]))
  datalist = d[3]
  elemlist = e[3]
  // the start function
  if m.start >= 0 {
    reset_machine()
    cur_inst = h
    mems = mems0
    tables = e[2]
    globals_store = g[2]
    const sr = call_func(m, m.start)
    if !sr[0] {
      return (false, sr[1], -1)
    }
    instances = inst_replace(instances, h, Instance.new(m, mems, tables, globals_store, r[5], m.start, d[3], e[3]))
  }
  return (true, "", h)
}

// ---- the spectest host module (T21.9) ----

def host_func_id(name String) Int64 {
  if name == "print" {
    return 0
  }
  if name == "print_i32" {
    return 1
  }
  if name == "print_i64" {
    return 2
  }
  if name == "print_f32" {
    return 3
  }
  if name == "print_f64" {
    return 4
  }
  if name == "print_i32_f32" {
    return 5
  }
  if name == "print_f64_f64" {
    return 6
  }
  return -1
}

def host_global(name String) (Bool, (Int64, Int64)) {
  if name == "global_i32" {
    return (true, mkv(127, 666))
  }
  if name == "global_i64" {
    return (true, mkv(126, 666))
  }
  if name == "global_f32" {
    return (true, mkv(125, 1143383654))
  }
  if name == "global_f64" {
    return (true, mkv(124, 4649074691427585229))
  }
  return (false, mkv(127, 0))
}

def resolve_host(m Module, i Int64, imems Array[(Bytes, Int64, Bool)], itables Array[(Array[(Int64, Int64)], Int64, Bool)], iglobals Array[(Bool, (Int64, Int64))], targets Array[(Int64, Int64, Int64)]) (Bool, String, Array[(Bytes, Int64, Bool)], Array[(Array[(Int64, Int64)], Int64, Bool)], Array[(Bool, (Int64, Int64))], Array[(Int64, Int64, Int64)]) {
  const imp = m.imports[i]
  if imp.kind == 0 {
    const id = host_func_id(imp.field)
    if id < 0 {
      return (false, "unknown import `" + imp.field + "`", imems, itables, iglobals, targets)
    }
    return resolve_imports(m, i + 1, imems, itables, iglobals, targets.append(tgt(1, id, 0)))
  }
  if imp.kind == 1 {
    return resolve_imports(m, i + 1, imems, itables.append(spectest_table), iglobals, targets)
  }
  if imp.kind == 2 {
    return resolve_imports(m, i + 1, imems.append(spectest_memory), itables, iglobals, targets)
  }
  const hg = host_global(imp.field)
  if !hg[0] {
    return (false, "unknown import `" + imp.field + "`", imems, itables, iglobals, targets)
  }
  const gv = (false, hg[1])
  return resolve_imports(m, i + 1, imems, itables, iglobals.append(gv), targets)
}

// Pop the arguments, print them the way the reference host does
// (`value : type`, one per line), and leave no results.
def call_host(m Module, fidx Int64, id Int64) (Bool, String) {
  const ft = m.types[func_type_idx(m, fidx)]
  const nparams = ft.params.length()
  const args = collect_results(sp - nparams, nparams, [])
  sp = sp - nparams
  host_print(id, args, 0)
  return (true, "")
}

def host_print(id Int64, args Array[(Int64, Int64)], i Int64) Int64 {
  if i >= args.length() {
    return 0
  }
  println(host_value(args[i]))
  return host_print(id, args, i + 1)
}

def host_value(v (Int64, Int64)) String {
  if v[0] == 127 {
    return internal.floats.sign32(v[1]).to_string() + " : i32"
  }
  if v[0] == 126 {
    return v[1].to_string() + " : i64"
  }
  if v[0] == 125 {
    return Float64.from_bits(internal.floats.promote_f32(v[1])).to_string() + " : f32"
  }
  return Float64.from_bits(v[1]).to_string() + " : f64"
}
