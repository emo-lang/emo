// The byte reader: a `Bytes` cursor with an offset and a limit, as a
// frozen value — every read returns a new cursor plus what it read,
// and every access is bounds-checked BEFORE it happens, because the
// `Bytes.get` raise it prevents cannot be caught (CHECK.md: no catch
// form yet).
//
// A failed read leaves the failure recorded on the cursor (first
// failure sticks) and returns a zero value; the decode pipeline checks
// `r.failed` after each step. All reader failures are the same shape:
// the input ended early, phase malformed, at the position attempted.

class Reader {
  def init(data Bytes, pos Int, limit Int, failed Bool, fail_offset Int, fail_msg String) {
    self.data = data
    self.pos = pos
    self.limit = limit
    self.failed = failed
    self.fail_offset = fail_offset
    self.fail_msg = fail_msg
  }
}

// The cursor over `data`, reading positions in [pos, limit).
def new(data Bytes, pos Int, limit Int) Reader {
  return Reader.new(data, pos, limit, false, -1, "")
}

// A cursor over the whole buffer.
def over(data Bytes) Reader {
  return Reader.new(data, 0, data.length(), false, -1, "")
}

// Record the first failure; later failures never overwrite it.
def bail(r Reader, at Int, msg String) Reader {
  if r.failed {
    return r
  }
  return Reader.new(r.data, r.pos, r.limit, true, at, msg)
}

// Move forward without recording anything (the caller has already
// bounds-checked).
def stepped(r Reader, pos Int) Reader {
  return Reader.new(r.data, pos, r.limit, r.failed, r.fail_offset, r.fail_msg)
}

// How many bytes remain before the limit.
def remaining(r Reader) Int {
  return r.limit - r.pos
}

// Look at the next byte without consuming it. -1 when nothing remains
// (peek never records a failure — callers decide whether that is one).
def peek(r Reader) Int {
  if r.failed || r.pos >= r.limit {
    return -1
  }
  return r.data.get(r.pos)
}

// Read one byte.
def u8(r Reader) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  if r.pos + 1 > r.limit {
    return (bail(r, r.pos, "unexpected end"), 0)
  }
  return (stepped(r, r.pos + 1), r.data.get(r.pos))
}

// Consume `n` bytes, returning them as a fresh buffer.
def take(r Reader, n Int) (Reader, Bytes) {
  if r.failed {
    return (r, Bytes.new(0))
  }
  if r.pos + n > r.limit {
    return (bail(r, r.pos, "unexpected end"), Bytes.new(0))
  }
  const out = Bytes.new(n)
  copy_into(out, r.data, 0, r.pos, n)
  return (stepped(r, r.pos + n), out)
}

// Skip past `n` bytes.
def skip(r Reader, n Int) Reader {
  if r.failed {
    return r
  }
  if r.pos + n > r.limit {
    return bail(r, r.pos, "unexpected end")
  }
  return stepped(r, r.pos + n)
}

def copy_into(out Bytes, src Bytes, dst_at Int, src_at Int, n Int) Int {
  if n == 0 {
    return 0
  }
  out.set(dst_at, src.get(src_at))
  return copy_into(out, src, dst_at + 1, src_at + 1, n - 1)
}

// ---- constant expressions (T20.9) ----
//
// The initializer-expression subset (global initializers, element and
// data offsets): instructions until the terminating 0x0b. A byte
// outside the subset bails as "illegal opcode" for now — the full
// opcode table (T20.10) is what separates that malformed family from
// the invalid-phase non-constant instructions.

def const_expr(r Reader) Reader {
  if r.failed {
    return r
  }
  const p = u8(r)
  const r1 = p[0]
  const op = p[1]
  if r1.failed {
    return r1
  }
  if op == 11 {
    return r1
  }
  if op == 65 {
    return const_expr(s32(r1)[0])
  }
  if op == 66 {
    return const_expr(s64(r1)[0])
  }
  if op == 67 {
    return const_expr(take(r1, 4)[0])
  }
  if op == 68 {
    return const_expr(take(r1, 8)[0])
  }
  if op == 208 {
    // ref.null: one reftype byte (0x70 funcref, 0x6f externref)
    const t = u8(r1)
    const b = t[1]
    if t[0].failed {
      return t[0]
    }
    if b == 112 || b == 111 {
      return const_expr(t[0])
    }
    return bail(t[0], t[0].pos, "malformed reference type")
  }
  if op == 210 || op == 35 {
    return const_expr(u32(r1)[0])
  }
  return bail(r1, r1.pos, "illegal opcode")
}

// ---- the instruction stream (T20.10) ----
//
// Dispatch on the first byte; the numeric instructions' immediates
// decode here, and the structured instructions recurse (the matching
// end terminates this level, so nesting mirrors the recursion).
// Opcodes outside the implemented families bail as "illegal opcode" —
// their families claim as they land (T20.11: parametric, variable,
// memory; T20.12: the branch and call families).

def expr(r Reader) Reader {
  return instrs(r)
}

// Decode instructions until the matching end (0x0b). An else (0x05)
// switches arms at this level; the arm discipline is the validator's.
def instrs(r Reader) Reader {
  if r.failed {
    return r
  }
  const p = u8(r)
  const r1 = p[0]
  if r1.failed {
    return r1
  }
  const op = p[1]
  if op == 11 {
    return r1
  }
  if op == 5 {
    return instrs(r1)
  }
  if op == 2 || op == 3 || op == 4 {
    // The nested body decodes through its own matching end; this
    // level then resumes with the instructions after it (the outer
    // end is still this level's to consume).
    const after_body = instrs(blocktype_then(r1))
    if after_body.failed {
      return after_body
    }
    return instrs(after_body)
  }
  if op == 0 || op == 1 || op == 15 {
    return instrs(r1)
  }
  // ---- structured branches and calls (T20.12) ----
  if op == 12 || op == 13 {
    // br, br_if: one label index
    return instrs(u32(r1)[0])
  }
  if op == 14 {
    // br_table: a vector of label indices plus the default
    return instrs(br_table_then(r1))
  }
  if op == 16 {
    // call: one function index
    return instrs(u32(r1)[0])
  }
  if op == 17 {
    // call_indirect: type index, then table index
    const t = u32(r1)
    if t[0].failed {
      return t[0]
    }
    return instrs(u32(t[0])[0])
  }
  // ---- parametric (T20.11) ----
  if op == 26 || op == 27 {
    // drop, select
    return instrs(r1)
  }
  if op == 28 {
    // select with an explicit type vector
    return instrs(valtype_bytes(r1))
  }
  // ---- variable (T20.11) ----
  if op >= 32 && op <= 36 {
    // local.get/set/tee, global.get/set: one u32 index
    return instrs(u32(r1)[0])
  }
  // ---- memory (T20.11) ----
  if op >= 40 && op <= 62 {
    // the memory instructions: a memarg (align, offset) immediate
    return instrs(memarg_then(r1))
  }
  if op == 63 || op == 64 {
    // memory.size / memory.grow: one reserved zero byte
    const z = u8(r1)
    if z[0].failed {
      return z[0]
    }
    if z[1] != 0 {
      return bail(z[0], z[0].pos, "zero byte expected")
    }
    return instrs(z[0])
  }
  if op == 252 {
    // the 0xfc prefix: bulk-memory and table operations
    return instrs(prefix_fc(r1))
  }
  if op == 65 {
    return instrs(s32(r1)[0])
  }
  if op == 66 {
    return instrs(s64(r1)[0])
  }
  if op == 67 {
    return instrs(take(r1, 4)[0])
  }
  if op == 68 {
    return instrs(take(r1, 8)[0])
  }
  // The plain numeric instructions, 0x45..0xc4, carry no immediates.
  if op >= 69 && op <= 196 {
    return instrs(r1)
  }
  return bail(r1, r1.pos, "illegal opcode")
}

// br_table's immediate: a vector of label indices, then the default.
def br_table_then(r Reader) Reader {
  const cn = u32(r)
  if cn[0].failed {
    return cn[0]
  }
  return u32_vec_end(cn[0], cn[1])
}

// A vector of u32s (positions only; the values drop).
def u32_vec_end(r Reader, n Int) Reader {
  if n == 0 {
    return r
  }
  const p = u32(r)
  if p[0].failed {
    return p[0]
  }
  return u32_vec_end(p[0], n - 1)
}

// A valtype vector immediate (select t): count, then that many
// valtype bytes.
def valtype_bytes(r Reader) Reader {
  const cn = u32(r)
  if cn[0].failed {
    return cn[0]
  }
  return valtype_bytes_rest(cn[0], cn[1])
}

def valtype_bytes_rest(r Reader, n Int) Reader {
  if n == 0 {
    return r
  }
  const t = u8(r)
  const b = t[1]
  if t[0].failed {
    return t[0]
  }
  if b != 127 && b != 126 && b != 125 && b != 124 && b != 112 && b != 111 {
    return bail(t[0], t[0].pos, "malformed value type")
  }
  return valtype_bytes_rest(t[0], n - 1)
}

// A memarg immediate: align then offset as u32s; the multi-memory
// flag bit in align is out of scope and rejects.
def memarg_then(r Reader) Reader {
  const a = u32(r)
  if a[0].failed {
    return a[0]
  }
  if a[1] >= 64 {
    return bail(a[0], a[0].pos, "malformed memop flags")
  }
  return u32(a[0])[0]
}

// The 0xfc-prefixed operations: a u32 sub-opcode selects the shape.
def prefix_fc(r Reader) Reader {
  const s = u32(r)
  if s[0].failed {
    return s[0]
  }
  const sub = s[1]
  if sub == 0 {
    // memory.init: data index, then a reserved zero byte
    const d = u32(s[0])
    if d[0].failed {
      return d[0]
    }
    const z = u8(d[0])
    if z[0].failed {
      return z[0]
    }
    if z[1] != 0 {
      return bail(z[0], z[0].pos, "zero byte expected")
    }
    return z[0]
  }
  if sub == 1 {
    return u32(s[0])[0]
  }
  if sub == 2 {
    // memory.copy: two reserved zero bytes
    const z1 = u8(s[0])
    if z1[0].failed {
      return z1[0]
    }
    if z1[1] != 0 {
      return bail(z1[0], z1[0].pos, "zero byte expected")
    }
    const z2 = u8(z1[0])
    if z2[0].failed {
      return z2[0]
    }
    if z2[1] != 0 {
      return bail(z2[0], z2[0].pos, "zero byte expected")
    }
    return z2[0]
  }
  if sub == 3 {
    const z = u8(s[0])
    if z[0].failed {
      return z[0]
    }
    if z[1] != 0 {
      return bail(z[0], z[0].pos, "zero byte expected")
    }
    return z[0]
  }
  if sub == 8 {
    // table.init: element index, then table index
    const e = u32(s[0])
    if e[0].failed {
      return e[0]
    }
    return u32(e[0])[0]
  }
  if sub == 9 {
    return u32(s[0])[0]
  }
  if sub == 10 {
    const t1 = u32(s[0])
    if t1[0].failed {
      return t1[0]
    }
    return u32(t1[0])[0]
  }
  if sub == 11 || sub == 12 || sub == 13 {
    return u32(s[0])[0]
  }
  return bail(s[0], s[0].pos, "illegal opcode")
}

// A block type: 0x40 (empty), a valtype byte, or an s33 type index.
def blocktype_then(r Reader) Reader {
  const b = peek(r)
  if b == 64 || b == 127 || b == 126 || b == 125 || b == 124 || b == 112 || b == 111 {
    return skip(r, 1)
  }
  const s = s33(r)
  return s[0]
}

// Signed 33-bit LEB128 (block type indices): five bytes, the final
// byte's top three bits all clear or all set.
def s33(r Reader) (Reader, Int64) {
  return s33_acc(r, 0, 0L)
}

def s33_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 4 {
      const top = bits >> 4
      if top != 0 && top != 7 {
        return (bail(rr, rr.pos, "integer too large"), 0L)
      }
      if bits >= 64 {
        return (rr, acc2 - (1L << Int64.from_int(7 * (count + 1))))
      }
      return (rr, acc2)
    }
    return (rr, acc2)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return s33_acc(rr, count + 1, acc2)
}

// ---- LEB128 ----
//
// The unsigned/signed encodings with the spec's length caps: an
// over-long encoding (continuation on the last allowed byte) is
// "integer representation too long", an over-wide one (value bits
// beyond the width on the final byte) is "integer too large" — both
// malformed, never a wrapped value. u64/s64 accumulate the raw bit
// pattern in Int64 (wrap is exactly what the pattern needs); s32
// returns the unsigned 32-bit pattern of the signed value, per the
// module-model decision.
//
// LEB128 lives in this module rather than a sibling because qualified
// type annotations do not parse (step 20 pressure): a def in leb.emo
// could not spell this module's Reader in its signature.

def print_dbg(label String, data Bytes) Int {
  const r0 = over(data)
  const lc = u8(r0)
  const e = expr(lc[0])
  println(label + ": locals_byte=" + lc[1].to_string() + " failed=" + e.failed.to_string()
    + " pos=" + e.pos.to_string() + " limit=" + e.limit.to_string() + " msg=" + e.fail_msg)
  return 0
}

// Print one decoded vector as `<label> = <value>` (fixture output).
def print_u32(label String, data Bytes) Int {
  const p = u32(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_u64(label String, data Bytes) Int64 {
  const p = u64(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0L
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_s32(label String, data Bytes) Int {
  const p = s32(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_s64(label String, data Bytes) Int64 {
  const p = s64(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0L
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def u32(r Reader) (Reader, Int) {
  return u32_acc(r, 0, 0)
}

def u32_acc(r Reader, count Int, acc Int) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0)
  }
  const bits = b & 127
  const acc2 = acc | (bits << (7 * count))
  if b < 128 {
    if count == 4 && bits > 15 {
      return (bail(rr, rr.pos, "integer too large"), 0)
    }
    return (rr, acc2)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0)
  }
  return u32_acc(rr, count + 1, acc2)
}

def u64(r Reader) (Reader, Int64) {
  return u64_acc(r, 0, 0L)
}

def u64_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  // from_int types Unknown through the checker (step 20 pressure), so
  // the shift's width is pinned by the Int64 literal on the left of the
  // pair; multiply-by-power-of-two is the same bit pattern as the shift.
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 9 && bits > 1 {
      return (bail(rr, rr.pos, "integer too large"), 0L)
    }
    return (rr, acc2)
  }
  if count == 9 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return u64_acc(rr, count + 1, acc2)
}

// Signed 32-bit LEB128; the result is the value's unsigned 32-bit
// pattern held in Int.
def s32(r Reader) (Reader, Int) {
  return s32_acc(r, 0, 0)
}

def s32_acc(r Reader, count Int, acc Int) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0)
  }
  const bits = b & 127
  const acc2 = acc | (bits << (7 * count))
  if b < 128 {
    if count == 4 {
      const top = bits >> 4
      if top != 0 && top != 7 {
        return (bail(rr, rr.pos, "integer too large"), 0)
      }
    }
    var v = acc2
    if bits >= 64 {
      v = acc2 - (1 << (7 * (count + 1)))
    }
    if v < 0 {
      v = v + 4294967296
    }
    return (rr, v)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0)
  }
  return s32_acc(rr, count + 1, acc2)
}

// Signed 64-bit LEB128; the result is the Int64 bit pattern itself.
// A value signed-extended across all ten bytes (the negative case at
// the cap) already sits in the accumulator with the right pattern —
// wrap-around does the extension — so no arithmetic runs for it.
def s64(r Reader) (Reader, Int64) {
  return s64_acc(r, 0, 0L)
}

def s64_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  // Same width-pinning as u64_acc (see the note there).
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 9 {
      if bits == 0 || bits == 1 || bits == 127 {
        return (rr, acc2)
      }
      return (bail(rr, rr.pos, "integer too large"), 0L)
    }
    if bits >= 64 {
      return (rr, acc2 - (1L << Int64.from_int(7 * (count + 1))))
    }
    return (rr, acc2)
  }
  if count == 9 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return s64_acc(rr, count + 1, acc2)
}


// ---- valtype + locals walk (moved from the model so the
// type-stack validator can live here: model already depends on this
// module, and the reverse edge would cycle) ----

// Decode one valtype byte: (ok, code, new_pos).
def valtype_at(data Bytes, pos Int, limit Int) (Bool, Int, Int) {
  if pos >= limit {
    return (false, 0, pos)
  }
  const b = data.get(pos)
  if b == 127 || b == 126 || b == 125 || b == 124 || b == 112 || b == 111 {
    return (true, b, pos + 1)
  }
  return (false, b, pos)
}

// The locals vector of a code entry: (count, valtype) pairs up to the
// terminating zero count; the total stays under 2^32.
// (ok, pos_after_locals, total)
def locals_walk(data Bytes, pos Int, limit Int, total Int) (Bool, Int, Int) {
  const c = u32(new(data, pos, limit))
  if c[0].failed {
    return (false, pos, total)
  }
  if c[1] == 0 {
    return (true, c[0].pos, total)
  }
  const v = valtype_at(data, c[0].pos, limit)
  if !v[0] {
    return (false, pos, total)
  }
  const total2 = total + c[1]
  if total2 > 4294967295 {
    return (false, pos, total2)
  }
  return locals_walk(data, v[2], limit, total2)
}

// ---- the type-stack validator (T20.15/T20.16) ----
//
// The spec's validation algorithm, in its functionally-threaded shape:
// the value stack is (Array[Int] codes, Int height) with Unknown = 0
// as the polymorphic placeholder, and the control frames are frozen
// Frame instances. A body validates from its implicit outer frame —
// (block, [], results, 0) — through its final 0x0b, which must empty
// the stack back to that frame's height exactly.

class Frame {
  def init(kind Int, start_types Array[Int], end_types Array[Int], height Int, unreachable Bool) {
    self.kind = kind
    self.start_types = start_types
    self.end_types = end_types
    self.height = height
    self.unreachable = unreachable
  }
}

// Pop one value: the real code, or Unknown when the current frame is
// unreachable and the stack is at its floor.
// (ok, code, stack, height)
def vpop(stack Array[Int], height Int, f Frame) (Bool, Int, Array[Int], Int) {
  if height == f.height {
    if f.unreachable {
      return (true, 0, stack, height)
    }
    return (false, 0, stack, height)
  }
  return (true, stack[height - 1], stack, height - 1)
}

// Pop a value and require it to match `want` (Unknown matches all).
def vpop_expect(stack Array[Int], height Int, f Frame, want Int) (Bool, Int, Array[Int], Int) {
  const p = vpop(stack, height, f)
  if !p[0] {
    return p
  }
  if p[1] != want && p[1] != 0 && want != 0 {
    return (false, p[1], stack, height)
  }
  return p
}

// Push a value.
def vpush(stack Array[Int], height Int, code Int) (Array[Int], Int) {
  return (stack.append(code), height + 1)
}

// The per-opcode immediate+typing shapes land here; the walk is one
// opcode at a time over the body's reader cursor.

// Validate one function body: (ok, msg). The body bytes span
// [pos, limit) and begin with the locals vector; param_codes and
// result_codes are the function type's vectors (passed as arrays so
// this module need not name model.FuncType — the cross-module class
// wall again).
def vbody(data Bytes, pos Int, limit Int, param_codes Array[Int], result_codes Array[Int]) (Bool, String) {
  // The locals walk already ran in the decoder; the body's
  // instructions start after it. Re-walk it to find the position.
  const c = u32(new(data, pos, limit))
  if c[0].failed {
    return (false, "malformed locals")
  }
  const lv = locals_walk(data, c[0].pos, limit, 0)
  if !lv[0] {
    return (false, "malformed locals")
  }
  const f0 = Frame.new(2, [], result_codes, 0, false)
  const r = vinstrs(
    new(data, lv[1], limit), [], 0, [f0], result_codes)
  if r.failed {
    return (false, "type mismatch")
  }
  return (true, "")
}

// The instruction walk: decode the next opcode (through the same
// dispatch the decoder uses), type it against the stack, recurse.
// The frames array's last element is the current frame. The error
// path is the reader's failed flag ("type mismatch" at the position).
def vinstrs(r Reader, stack Array[Int], height Int, frames Array[Frame], result_codes Array[Int]) Reader {
  if r.failed {
    return r
  }
  const p = u8(r)
  const r1 = p[0]
  const op = p[1]
  if r1.failed {
    return r1
  }
  const f = frames[frames.length() - 1]
  // end: pop the frame's end types, require the frame's floor.
  if op == 11 {
    const e = pops_of(r1, stack, height, f, f.end_types)
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    if e[3] != f.height {
      return bail(r1, r1.pos, "type mismatch")
    }
    const frames2 = drop_last(frames, 1)
    if frames2.length() == 0 {
      // The body's final end: the stack must be exactly empty — it is,
      // the frame check passed.
      return r1
    }
    const nf = frames2[frames2.length() - 1]
    const pu = push_all(e[2], e[3], nf.unreachable, f.end_types)
    return vinstrs(r1, pu[0], pu[1], frames2, result_codes)
  }
  if op == 5 {
    // else: only inside an if-frame; the label types restart.
    if f.kind != 4 {
      return bail(r1, r1.pos, "type mismatch")
    }
    const e = pops_of(r1, stack, height, f, f.end_types)
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    if e[3] != f.height {
      return bail(r1, r1.pos, "type mismatch")
    }
    const f2 = Frame.new(1, f.start_types, f.start_types, f.height, false)
    const frames2 = drop_last(frames, 1)
    return vinstrs(r1, e[2], e[3], frames2.append(f2), result_codes)
  }
  if op == 2 || op == 3 || op == 4 {
    return vblock(r1, op, stack, height, frames, result_codes)
  }
  // unreachable
  if op == 0 {
    const f2 = Frame.new(f.kind, f.start_types, f.end_types, f.height, true)
    const frames2 = drop_last(frames, 1)
    return vinstrs(r1, stack, f.height, frames2.append(f2), result_codes)
  }
  // nop
  if op == 1 {
    return vinstrs(r1, stack, height, frames, result_codes)
  }
  // br l
  if op == 12 {
    const l = label_depth(r1, frames)
    if l[0].failed {
      return l[0]
    }
    const target = frames[frames.length() - 1 - l[1]]
    const want = label_types(target)
    const e = pops_of(r1, stack, height, f, want)
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const f2 = Frame.new(f.kind, f.start_types, f.end_types, f.height, true)
    const frames2 = drop_last(frames, 1)
    return vinstrs(r1, e[2], f.height, frames2.append(f2), result_codes)
  }
  // br_if l
  if op == 13 {
    const p1 = vpop_expect(stack, height, f, 127)
    if !p1[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const l = label_depth(r1, frames)
    if l[0].failed {
      return l[0]
    }
    const target = frames[frames.length() - 1 - l[1]]
    const want = label_types(target)
    const e = pops_of(r1, p1[2], p1[3], f, want)
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const pu = push_all(e[2], e[3], f.unreachable, want)
    return vinstrs(r1, pu[0], pu[1], frames, result_codes)
  }
  // br_table
  if op == 14 {
    const p1 = vpop_expect(stack, height, f, 127)
    if !p1[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const cn = u32(r1)
    if cn[0].failed {
      return cn[0]
    }
    const t = br_table_labels(cn[0], cn[1], frames)
    if t.failed {
      return t
    }
    const d = u32(t)
    if d[0].failed {
      return d[0]
    }
    if d[1] >= frames.length() {
      return bail(d[0], d[0].pos, "unknown label")
    }
    const deft = frames[frames.length() - 1 - d[1]]
    const arity = label_types(deft).length()
    return vinstrs(d[0], p1[2], p1[3], frames, result_codes)
  }
  // return
  if op == 15 {
    const e = pops_of(r1, stack, height, f, result_codes)
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const f2 = Frame.new(f.kind, f.start_types, f.end_types, f.height, true)
    const frames2 = drop_last(frames, 1)
    return vinstrs(r1, e[2], f.height, frames2.append(f2), result_codes)
  }
  // call x
  if op == 16 {
    const cx = u32(r1)
    if cx[0].failed {
      return cx[0]
    }
    if cx[1] >= ftype_results_len() {
      return bail(cx[0], cx[0].pos, "unknown function")
    }
    return vinstrs(cx[0], stack, height, frames, result_codes)
  }
  // ---- t.const: decode the immediate, then push the type ----
  if op == 65 || op == 66 || op == 67 || op == 68 {
    var r2 = r1
    if op == 65 {
      r2 = s32(r1)[0]
    }
    if op == 66 {
      r2 = s64(r1)[0]
    }
    if op == 67 {
      r2 = take(r1, 4)[0]
    }
    if op == 68 {
      r2 = take(r1, 8)[0]
    }
    if r2.failed {
      return r2
    }
    var code = 127
    if op == 66 {
      code = 126
    }
    if op == 67 {
      code = 125
    }
    if op == 68 {
      code = 124
    }
    const pu = push_all(stack, height, f.unreachable, [code])
    return vinstrs(r2, pu[0], pu[1], frames, result_codes)
  }
  // ---- numeric: the plain family 0x45..0xc4, typed by table ----
  if op >= 69 && op <= 196 {
    const s = num_opcode(op)
    const e = pops_of(r1, stack, height, f, s[0])
    if !e[0] {
      return bail(r1, r1.pos, "type mismatch")
    }
    const pu = push_all(e[2], e[3], f.unreachable, s[1])
    return vinstrs(r1, pu[0], pu[1], frames, result_codes)
  }
  // The remaining families type in a later pass; accept the cursor.
  return r1
}

// The numeric family's typing table: (pops, pushes) per opcode.
// i32=127, i64=126, f32=125, f64=124.
def num_opcode(op Int) (Array[Int], Array[Int]) {
  const i32 = 127
  const i64 = 126
  const f32 = 125
  const f64 = 124
  // i32 tests and comparisons → i32
  if op == 69 { return ([i32], [i32]) }               // eqz
  if op >= 70 && op <= 79 { return ([i32, i32], [i32]) } // eq..le_u
  // i64.eqz / i64 comparisons → i32
  if op == 80 { return ([i64], [i32]) }
  if op >= 81 && op <= 90 { return ([i64, i64], [i32]) }
  if op >= 91 && op <= 96 { return ([f32, f32], [i32]) }  // f32 eq..le
  if op >= 97 && op <= 102 { return ([f64, f64], [i32]) } // f64 eq..le
  // i32 unary / binary
  if op == 103 || op == 104 || op == 105 { return ([i32], [i32]) } // clz ctz popcnt
  if op >= 106 && op <= 120 { return ([i32, i32], [i32]) } // add..rotr
  // i64 unary / binary
  if op == 121 || op == 122 || op == 123 { return ([i64], [i64]) }
  if op >= 124 && op <= 138 { return ([i64, i64], [i64]) }
  // f32 unary / binary
  if op >= 139 && op <= 145 { return ([f32], [f32]) } // abs..sqrt
  if op >= 146 && op <= 152 { return ([f32, f32], [f32]) }
  // f64 unary / binary
  if op >= 153 && op <= 159 { return ([f64], [f64]) }
  if op >= 160 && op <= 166 { return ([f64, f64], [f64]) }
  // conversions (spec table, 0xa7..0xc4)
  if op == 167 { return ([i64], [i32]) }   // i32.wrap_i64
  if op == 168 || op == 169 { return ([f32], [i32]) } // i32.trunc_f32_s/u
  if op == 170 || op == 171 { return ([f64], [i32]) } // i32.trunc_f64_s/u
  if op == 172 || op == 173 { return ([i32], [i64]) } // i64.extend_i32_s/u
  if op == 174 || op == 175 { return ([f32], [i64]) } // i64.trunc_f32_s/u
  if op == 176 || op == 177 { return ([f64], [i64]) } // i64.trunc_f64_s/u
  if op == 178 || op == 179 { return ([i32], [f32]) } // f32.convert_i32_s/u
  if op == 180 || op == 181 { return ([i64], [f32]) } // f32.convert_i64_s/u
  if op == 182 { return ([f64], [f32]) }   // f32.demote_f64
  if op == 183 || op == 184 { return ([i32], [f64]) } // f64.convert_i32_s/u
  if op == 185 || op == 186 { return ([i64], [f64]) } // f64.convert_i64_s/u
  if op == 187 { return ([f32], [f64]) }   // f64.promote_f32
  if op == 188 { return ([f32], [i32]) }   // i32.reinterpret_f32
  if op == 189 { return ([i64], [i64]) }   // i64.reinterpret_f64
  if op == 190 { return ([i32], [f32]) }   // f32.reinterpret_i32
  if op == 191 { return ([i64], [f64]) }   // f64.reinterpret_i64
  // sign extensions
  if op == 194 { return ([i32], [i32]) }   // 0xc2 i32.extend8_s
  if op == 195 { return ([i32], [i32]) }   // 0xc3 i32.extend16_s
  if op == 196 { return ([i64], [i64]) }   // 0xc4 i64.extend32_s
  return ([], [])
}

// Placeholder for the call-index check (needs the function count in
// the body walk; the full threading lands with the cross-section
// rules). Always false for now — unknown-function invalid cases stay
// pending.
def ftype_results_len() Int {
  return 1000000
}

// Pop each of `wants` in reverse order.
// (ok, last_code, stack, height)
def pops_of(r Reader, stack Array[Int], height Int, f Frame, wants Array[Int]) (Bool, Int, Array[Int], Int) {
  return pops_rev(stack, height, f, wants, wants.length())
}

def pops_rev(stack Array[Int], height Int, f Frame, wants Array[Int], i Int) (Bool, Int, Array[Int], Int) {
  if i == 0 {
    return (true, 0, stack, height)
  }
  const p = vpop_expect(stack, height, f, wants[i - 1])
  if !p[0] {
    return p
  }
  return pops_rev(p[2], p[3], f, wants, i - 1)
}

// Push each of `codes`, skipping the pushes entirely when the frame
// is unreachable (the spec's polymorphic push: the stack stays at the
// unreachable floor and the codes are unknown).
def push_all(stack Array[Int], height Int, unreachable Bool, codes Array[Int]) (Array[Int], Int) {
  if unreachable {
    return (stack, height)
  }
  return push_rest(stack, height, codes, 0)
}

def push_rest(stack Array[Int], height Int, codes Array[Int], i Int) (Array[Int], Int) {
  if i == codes.length() {
    return (stack, height)
  }
  return push_rest(stack.append(codes[i]), height + 1, codes, i + 1)
}

// block / loop / if: block type, then a nested frame.
def vblock(r Reader, kind Int, stack Array[Int], height Int, frames Array[Frame], result_codes Array[Int]) Reader {
  const bt = block_type(r)
  if bt[0].failed {
    return bt[0]
  }
  const e = pops_of(bt[0], stack, height, frames[frames.length() - 1], bt[1])
  if !e[0] {
    return bail(bt[0], bt[0].pos, "type mismatch")
  }
  const nf = Frame.new(kind, bt[1], bt[2], e[3], false)
  return vinstrs(bt[0], e[2], e[3], frames.append(nf), result_codes)
}

// A block type: (reader, param codes, result codes). Errors travel on
// the reader's failed flag, like every decode step.
def block_type(r Reader) (Reader, Array[Int], Array[Int]) {
  const b = peek(r)
  if b == 64 {
    return (skip(r, 1), [], [])
  }
  if b == 127 || b == 126 || b == 125 || b == 124 || b == 112 || b == 111 {
    return (skip(r, 1), [], [b])
  }
  const s = s33(r)
  return (s[0], [], [])
}

// The label types a branch to this frame expects: a loop's label is
// its parameter types; every other frame's is its result types.
def label_types(f Frame) Array[Int] {
  if f.kind == 3 {
    return f.start_types
  }
  return f.end_types
}

// The label depth check: (reader, depth) — depth counts from the top.
def label_depth(r Reader, frames Array[Frame]) (Reader, Int) {
  const d = u32(r)
  if d[0].failed {
    return (d[0], 0)
  }
  if d[1] >= frames.length() {
    return (bail(d[0], d[0].pos, "unknown label"), d[1])
  }
  return (d[0], d[1])
}

// br_table's labels: each must be in range; their arities must agree
// with the default's (checked against the first).
def br_table_labels(r Reader, n Int, frames Array[Frame]) Reader {
  return bt_rest(r, n, frames, -1, 0)
}

def bt_rest(r Reader, n Int, frames Array[Frame], arity Int, seen Int) Reader {
  if n == 0 {
    return r
  }
  const d = u32(r)
  if d[0].failed {
    return d[0]
  }
  if d[1] >= frames.length() {
    return bail(d[0], d[0].pos, "unknown label")
  }
  const a = label_types(frames[frames.length() - 1 - d[1]]).length()
  if arity >= 0 && a != arity {
    return bail(d[0], d[0].pos, "type mismatch")
  }
  return bt_rest(d[0], n - 1, frames, a, seen + 1)
}

def drop_last(items Array[Frame], n Int) Array[Frame] {
  return take_frames(items, items.length() - n)
}

def take_frames(items Array[Frame], n Int) Array[Frame] {
  if n == 0 {
    return []
  }
  return take_frames(items, n - 1).append(items[n - 1])
}
