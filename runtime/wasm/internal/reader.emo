// The byte reader: a `Bytes` cursor with an offset and a limit, as a
// frozen value — every read returns a new cursor plus what it read,
// and every access is bounds-checked BEFORE it happens, because the
// `Bytes.get` raise it prevents cannot be caught (CHECK.md: no catch
// form yet).
//
// A failed read leaves the failure recorded on the cursor (first
// failure sticks) and returns a zero value; the decode pipeline checks
// `r.failed` after each step. All reader failures are the same shape:
// the input ended early, phase malformed, at the position attempted.

class Reader {
  def init(data Bytes, pos Int, limit Int, failed Bool, fail_offset Int, fail_msg String) {
    self.data = data
    self.pos = pos
    self.limit = limit
    self.failed = failed
    self.fail_offset = fail_offset
    self.fail_msg = fail_msg
  }
}

// The cursor over `data`, reading positions in [pos, limit).
def new(data Bytes, pos Int, limit Int) Reader {
  return Reader.new(data, pos, limit, false, -1, "")
}

// A cursor over the whole buffer.
def over(data Bytes) Reader {
  return Reader.new(data, 0, data.length(), false, -1, "")
}

// Record the first failure; later failures never overwrite it.
def bail(r Reader, at Int, msg String) Reader {
  if r.failed {
    return r
  }
  return Reader.new(r.data, r.pos, r.limit, true, at, msg)
}

// Move forward without recording anything (the caller has already
// bounds-checked).
def stepped(r Reader, pos Int) Reader {
  return Reader.new(r.data, pos, r.limit, r.failed, r.fail_offset, r.fail_msg)
}

// How many bytes remain before the limit.
def remaining(r Reader) Int {
  return r.limit - r.pos
}

// Look at the next byte without consuming it. -1 when nothing remains
// (peek never records a failure — callers decide whether that is one).
def peek(r Reader) Int {
  if r.failed || r.pos >= r.limit {
    return -1
  }
  return r.data.get(r.pos)
}

// Read one byte.
def u8(r Reader) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  if r.pos + 1 > r.limit {
    return (bail(r, r.pos, "unexpected end"), 0)
  }
  return (stepped(r, r.pos + 1), r.data.get(r.pos))
}

// Consume `n` bytes, returning them as a fresh buffer.
def take(r Reader, n Int) (Reader, Bytes) {
  if r.failed {
    return (r, Bytes.new(0))
  }
  if r.pos + n > r.limit {
    return (bail(r, r.pos, "unexpected end"), Bytes.new(0))
  }
  const out = Bytes.new(n)
  copy_into(out, r.data, 0, r.pos, n)
  return (stepped(r, r.pos + n), out)
}

// Skip past `n` bytes.
def skip(r Reader, n Int) Reader {
  if r.failed {
    return r
  }
  if r.pos + n > r.limit {
    return bail(r, r.pos, "unexpected end")
  }
  return stepped(r, r.pos + n)
}

def copy_into(out Bytes, src Bytes, dst_at Int, src_at Int, n Int) Int {
  if n == 0 {
    return 0
  }
  out.set(dst_at, src.get(src_at))
  return copy_into(out, src, dst_at + 1, src_at + 1, n - 1)
}

// ---- constant expressions (T20.9) ----
//
// The initializer-expression subset (global initializers, element and
// data offsets): instructions until the terminating 0x0b. A byte
// outside the subset bails as "illegal opcode" for now — the full
// opcode table (T20.10) is what separates that malformed family from
// the invalid-phase non-constant instructions.

def const_expr(r Reader) Reader {
  if r.failed {
    return r
  }
  const p = u8(r)
  const r1 = p[0]
  const op = p[1]
  if r1.failed {
    return r1
  }
  if op == 11 {
    return r1
  }
  if op == 65 {
    return const_expr(s32(r1)[0])
  }
  if op == 66 {
    return const_expr(s64(r1)[0])
  }
  if op == 67 {
    return const_expr(take(r1, 4)[0])
  }
  if op == 68 {
    return const_expr(take(r1, 8)[0])
  }
  if op == 208 {
    // ref.null: one reftype byte (0x70 funcref, 0x6f externref)
    const t = u8(r1)
    const b = t[1]
    if t[0].failed {
      return t[0]
    }
    if b == 112 || b == 111 {
      return const_expr(t[0])
    }
    return bail(t[0], t[0].pos, "malformed reference type")
  }
  if op == 210 || op == 35 {
    return const_expr(u32(r1)[0])
  }
  return bail(r1, r1.pos, "illegal opcode")
}

// ---- the instruction stream (T20.10) ----
//
// Dispatch on the first byte; the numeric instructions' immediates
// decode here, and the structured instructions recurse (the matching
// end terminates this level, so nesting mirrors the recursion).
// Opcodes outside the implemented families bail as "illegal opcode" —
// their families claim as they land (T20.11: parametric, variable,
// memory; T20.12: the branch and call families).

def expr(r Reader) Reader {
  return instrs(r)
}

// Decode instructions until the matching end (0x0b). An else (0x05)
// switches arms at this level; the arm discipline is the validator's.
def instrs(r Reader) Reader {
  if r.failed {
    return r
  }
  const p = u8(r)
  const r1 = p[0]
  if r1.failed {
    return r1
  }
  const op = p[1]
  if op == 11 {
    return r1
  }
  if op == 5 {
    return instrs(r1)
  }
  if op == 2 || op == 3 || op == 4 {
    return instrs(blocktype_then(r1))
  }
  if op == 0 || op == 1 || op == 15 {
    return instrs(r1)
  }
  if op == 65 {
    return instrs(s32(r1)[0])
  }
  if op == 66 {
    return instrs(s64(r1)[0])
  }
  if op == 67 {
    return instrs(take(r1, 4)[0])
  }
  if op == 68 {
    return instrs(take(r1, 8)[0])
  }
  // The plain numeric instructions, 0x45..0xc4, carry no immediates.
  if op >= 69 && op <= 196 {
    return instrs(r1)
  }
  return bail(r1, r1.pos, "illegal opcode")
}

// A block type: 0x40 (empty), a valtype byte, or an s33 type index.
def blocktype_then(r Reader) Reader {
  const b = peek(r)
  if b == 64 || b == 127 || b == 126 || b == 125 || b == 124 || b == 112 || b == 111 {
    return skip(r, 1)
  }
  const s = s33(r)
  return s[0]
}

// Signed 33-bit LEB128 (block type indices): five bytes, the final
// byte's top three bits all clear or all set.
def s33(r Reader) (Reader, Int64) {
  return s33_acc(r, 0, 0L)
}

def s33_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 4 {
      const top = bits >> 4
      if top != 0 && top != 7 {
        return (bail(rr, rr.pos, "integer too large"), 0L)
      }
      if bits >= 64 {
        return (rr, acc2 - (1L << Int64.from_int(7 * (count + 1))))
      }
      return (rr, acc2)
    }
    return (rr, acc2)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return s33_acc(rr, count + 1, acc2)
}

// ---- LEB128 ----
//
// The unsigned/signed encodings with the spec's length caps: an
// over-long encoding (continuation on the last allowed byte) is
// "integer representation too long", an over-wide one (value bits
// beyond the width on the final byte) is "integer too large" — both
// malformed, never a wrapped value. u64/s64 accumulate the raw bit
// pattern in Int64 (wrap is exactly what the pattern needs); s32
// returns the unsigned 32-bit pattern of the signed value, per the
// module-model decision.
//
// LEB128 lives in this module rather than a sibling because qualified
// type annotations do not parse (step 20 pressure): a def in leb.emo
// could not spell this module's Reader in its signature.

// Print one decoded vector as `<label> = <value>` (fixture output).
def print_u32(label String, data Bytes) Int {
  const p = u32(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_u64(label String, data Bytes) Int64 {
  const p = u64(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0L
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_s32(label String, data Bytes) Int {
  const p = s32(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def print_s64(label String, data Bytes) Int64 {
  const p = s64(over(data))
  if p[0].failed {
    println(label + " = " + p[0].fail_msg)
    return 0L
  }
  println(label + " = " + p[1].to_string())
  return p[1]
}

def u32(r Reader) (Reader, Int) {
  return u32_acc(r, 0, 0)
}

def u32_acc(r Reader, count Int, acc Int) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0)
  }
  const bits = b & 127
  const acc2 = acc | (bits << (7 * count))
  if b < 128 {
    if count == 4 && bits > 15 {
      return (bail(rr, rr.pos, "integer too large"), 0)
    }
    return (rr, acc2)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0)
  }
  return u32_acc(rr, count + 1, acc2)
}

def u64(r Reader) (Reader, Int64) {
  return u64_acc(r, 0, 0L)
}

def u64_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  // from_int types Unknown through the checker (step 20 pressure), so
  // the shift's width is pinned by the Int64 literal on the left of the
  // pair; multiply-by-power-of-two is the same bit pattern as the shift.
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 9 && bits > 1 {
      return (bail(rr, rr.pos, "integer too large"), 0L)
    }
    return (rr, acc2)
  }
  if count == 9 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return u64_acc(rr, count + 1, acc2)
}

// Signed 32-bit LEB128; the result is the value's unsigned 32-bit
// pattern held in Int.
def s32(r Reader) (Reader, Int) {
  return s32_acc(r, 0, 0)
}

def s32_acc(r Reader, count Int, acc Int) (Reader, Int) {
  if r.failed {
    return (r, 0)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0)
  }
  const bits = b & 127
  const acc2 = acc | (bits << (7 * count))
  if b < 128 {
    if count == 4 {
      const top = bits >> 4
      if top != 0 && top != 7 {
        return (bail(rr, rr.pos, "integer too large"), 0)
      }
    }
    var v = acc2
    if bits >= 64 {
      v = acc2 - (1 << (7 * (count + 1)))
    }
    if v < 0 {
      v = v + 4294967296
    }
    return (rr, v)
  }
  if count == 4 {
    return (bail(rr, rr.pos, "integer representation too long"), 0)
  }
  return s32_acc(rr, count + 1, acc2)
}

// Signed 64-bit LEB128; the result is the Int64 bit pattern itself.
// A value signed-extended across all ten bytes (the negative case at
// the cap) already sits in the accumulator with the right pattern —
// wrap-around does the extension — so no arithmetic runs for it.
def s64(r Reader) (Reader, Int64) {
  return s64_acc(r, 0, 0L)
}

def s64_acc(r Reader, count Int, acc Int64) (Reader, Int64) {
  if r.failed {
    return (r, 0L)
  }
  const p = u8(r)
  const rr = p[0]
  const b = p[1]
  if rr.failed {
    return (rr, 0L)
  }
  const bits = b & 127
  // Same width-pinning as u64_acc (see the note there).
  const acc2 = acc | (Int64.from_int(bits) * (1L << Int64.from_int(7 * count)))
  if b < 128 {
    if count == 9 {
      if bits == 0 || bits == 1 || bits == 127 {
        return (rr, acc2)
      }
      return (bail(rr, rr.pos, "integer too large"), 0L)
    }
    if bits >= 64 {
      return (rr, acc2 - (1L << Int64.from_int(7 * (count + 1))))
    }
    return (rr, acc2)
  }
  if count == 9 {
    return (bail(rr, rr.pos, "integer representation too long"), 0L)
  }
  return s64_acc(rr, count + 1, acc2)
}
