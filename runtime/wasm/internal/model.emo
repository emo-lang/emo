// The module model, as far as it exists (T20.7: the type section).
//
// Representation, settled here with the type-fixture: sequences are
// Array[T] and values are the spec's own byte codes (a valtype is
// 0x7f..0x6f — no enum naming layer sits between decoder and
// validator). The plan's earlier cons-list sketch is superseded: a
// recursive tuple type has no name and qualified class names do not
// parse, so a cons cell could never cross a def signature; Array[T]
// can. The cost is .append's copy — fine at corpus sizes, recorded as
// the no-growable-buffer pressure.

class FuncType {
  def init(params Array[Int], results Array[Int]) {
    self.params = params
    self.results = results
  }
}

// Decode one valtype byte: (ok, code, new_pos). v128 (0x7b) is out of
// scope for step 20 and rejects here.

// Decode a valtype vector of known length: (ok, codes, new_pos).
def valtype_vec(data Bytes, pos Int, limit Int, n Int) (Bool, Array[Int], Int) {
  return valtype_rest(data, pos, limit, n, [])
}

def valtype_rest(data Bytes, pos Int, limit Int, n Int, acc Array[Int]) (Bool, Array[Int], Int) {
  if n == 0 {
    return (true, acc, pos)
  }
  const v = internal.reader.valtype_at(data, pos, limit)
  if !v[0] {
    return (false, acc, pos)
  }
  return valtype_rest(data, v[2], limit, n - 1, acc.append(v[1]))
}

// Decode one function type (tag 0x60, then param and result vectors):
// (ok, func_type, new_pos). On failure the func type is an empty
// sentinel; the reader state of the caller decides nothing — the ok
// flag is the contract.
def func_type(data Bytes, pos Int, limit Int) (Bool, FuncType, Int) {
  if pos >= limit {
    return (false, FuncType.new([], []), pos)
  }
  if data.get(pos) != 96 {
    return (false, FuncType.new([], []), pos)
  }
  const pn = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
  if pn[0].failed {
    return (false, FuncType.new([], []), pos)
  }
  const pv = valtype_vec(data, pn[0].pos, limit, pn[1])
  if !pv[0] {
    return (false, FuncType.new([], []), pos)
  }
  const rn = internal.reader.u32(internal.reader.new(data, pv[2], limit))
  if rn[0].failed {
    return (false, FuncType.new([], []), pos)
  }
  const rv = valtype_vec(data, rn[0].pos, limit, rn[1])
  if !rv[0] {
    return (false, FuncType.new([], []), pos)
  }
  return (true, FuncType.new(pv[1], rv[1]), rv[2])
}

// The type section's content: a vector of function types.
// (ok, types, new_pos) — ok is false on any malformed byte.
def type_section(data Bytes, pos Int, limit Int) (Bool, Array[FuncType], Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, [], pos)
  }
  return type_rest(data, cn[0].pos, limit, cn[1], [])
}

def type_rest(data Bytes, pos Int, limit Int, n Int, acc Array[FuncType]) (Bool, Array[FuncType], Int) {
  if n == 0 {
    return (true, acc, pos)
  }
  const ft = func_type(data, pos, limit)
  if !ft[0] {
    return (false, acc, pos)
  }
  return type_rest(data, ft[2], limit, n - 1, acc.append(ft[1]))
}

// ---- declaration sections (T20.8) ----
//
// The content decoders check byte-level shape (kinds, limits, mut,
// name bounds) and exact consumption; the decoded values are dropped
// until the module threading lands (T20.13). Global sections decode
// with their initializer expressions in T20.9.

// Limits: a flags byte (0 = min, 1 = min+max), then u32s.
// (ok, min, max, has_max, new_pos)
def limits(data Bytes, pos Int, limit Int) (Bool, Int, Int, Bool, Int) {
  if pos >= limit {
    return (false, 0, 0, false, pos)
  }
  const flags = data.get(pos)
  if flags == 0 {
    const p = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
    if p[0].failed {
      return (false, 0, 0, false, p[0].fail_offset)
    }
    return (true, p[1], 0, false, p[0].pos)
  }
  if flags == 1 {
    const p = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
    if p[0].failed {
      return (false, 0, 0, false, p[0].fail_offset)
    }
    const q = internal.reader.u32(p[0])
    if q[0].failed {
      return (false, 0, 0, false, q[0].fail_offset)
    }
    return (true, p[1], q[1], true, q[0].pos)
  }
  return (false, 0, 0, false, pos)
}

// A reference type byte for tables: funcref (0x70) or externref (0x6f).
def reftype(data Bytes, pos Int, limit Int) (Bool, Int, Int) {
  if pos >= limit {
    return (false, 0, pos)
  }
  const b = data.get(pos)
  if b == 112 || b == 111 {
    return (true, b, pos + 1)
  }
  return (false, b, pos)
}

// tabletype = reftype limits: (ok, reftype, min, max, has_max, new_pos)
def tabletype(data Bytes, pos Int, limit Int) (Bool, Int, Int, Int, Bool, Int) {
  const rt = reftype(data, pos, limit)
  if !rt[0] {
    return (false, 0, 0, 0, false, pos)
  }
  const l = limits(data, rt[2], limit)
  if !l[0] {
    return (false, 0, 0, 0, false, pos)
  }
  return (true, rt[1], l[1], l[2], l[3], l[4])
}

// memtype = limits.
def memtype(data Bytes, pos Int, limit Int) (Bool, Int, Int, Bool, Int) {
  return limits(data, pos, limit)
}

// globaltype = valtype + mutability byte (0 or 1).
def globaltype(data Bytes, pos Int, limit Int) (Bool, Int, Bool, Int) {
  const v = internal.reader.valtype_at(data, pos, limit)
  if !v[0] {
    return (false, 0, false, pos)
  }
  if v[2] >= limit {
    return (false, 0, false, v[2])
  }
  const code = v[1]
  const at = pos + 1
  const m = data.get(at)
  if m != 0 && m != 1 {
    return (false, 0, false, v[2])
  }
  return (true, v[1], m == 1, v[2] + 1)
}

// A name: u32 length, then that many bytes (the bytes are skipped —
// UTF-8 validation is a later task).
def name(data Bytes, pos Int, limit Int) (Bool, Int, Int) {
  const p = internal.reader.u32(internal.reader.new(data, pos, limit))
  if p[0].failed {
    return (false, 0, p[0].fail_offset)
  }
  if p[1] > internal.reader.remaining(p[0]) {
    return (false, 0, p[0].pos)
  }
  const r = internal.reader.skip(p[0], p[1])
  return (true, p[1], r.pos)
}

// Section content decoders return (ok, msg, fail_offset, end_pos):
// on success msg is empty, fail_offset -1, and end_pos the position
// the content ended at (the caller compares it with the section end —
// a difference is a "section size mismatch").

// The import section: vec of (module name, name, importdesc).
def import_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed import section", cn[0].fail_offset, -1)
  }
  return import_rest(data, cn[0].pos, limit, cn[1])
}

def import_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const m = name(data, pos, limit)
  if !m[0] {
    return (false, "malformed import section", m[2], -1)
  }
  const nm = name(data, m[2], limit)
  if !nm[0] {
    return (false, "malformed import section", nm[2], -1)
  }
  const d = import_desc(data, nm[2], limit)
  if !d[0] {
    return (false, "malformed import section", d[2], -1)
  }
  return import_rest(data, d[2], limit, n - 1)
}

// importdesc: one kind byte (0 func / 1 table / 2 memory / 3 global)
// followed by the type.
def import_desc(data Bytes, pos Int, limit Int) (Bool, Int, Int) {
  if pos >= limit {
    return (false, 0, pos)
  }
  const kind = data.get(pos)
  if kind == 0 {
    const t = internal.reader.u32(internal.reader.new(data, pos + 1, limit))
    if t[0].failed {
      return (false, 0, t[0].fail_offset)
    }
    return (true, kind, t[0].pos)
  }
  if kind == 1 {
    const t = tabletype(data, pos + 1, limit)
    return (t[0], kind, t[5])
  }
  if kind == 2 {
    const t = memtype(data, pos + 1, limit)
    return (t[0], kind, t[4])
  }
  if kind == 3 {
    const t = globaltype(data, pos + 1, limit)
    return (t[0], kind, t[3])
  }
  return (false, 0, pos)
}

// The function section: vec of type indices.
def func_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed function section", cn[0].fail_offset, -1)
  }
  return u32_vec_rest(data, cn[0].pos, limit, cn[1])
}

// The table section: vec of tabletypes.
def table_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed table section", cn[0].fail_offset, -1)
  }
  return table_rest(data, cn[0].pos, limit, cn[1])
}

def table_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const t = tabletype(data, pos, limit)
  if !t[0] {
    return (false, "malformed table section", pos, -1)
  }
  return table_rest(data, t[5], limit, n - 1)
}

// The memory section: vec of memtypes.
def memory_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed memory section", cn[0].fail_offset, -1)
  }
  return memory_rest(data, cn[0].pos, limit, cn[1])
}

def memory_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const t = memtype(data, pos, limit)
  if !t[0] {
    return (false, "malformed memory section", pos, -1)
  }
  return memory_rest(data, t[4], limit, n - 1)
}

// The export section: vec of (name, kind byte, index).
def export_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed export section", cn[0].fail_offset, -1)
  }
  return export_rest(data, cn[0].pos, limit, cn[1])
}

def export_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const nm = name(data, pos, limit)
  if !nm[0] {
    return (false, "malformed export section", nm[2], -1)
  }
  if nm[2] >= limit {
    return (false, "malformed export section", nm[2], -1)
  }
  const kind = data.get(nm[2])
  if kind > 3 {
    return (false, "malformed export section", nm[2], -1)
  }
  const t = internal.reader.u32(internal.reader.new(data, nm[2] + 1, limit))
  if t[0].failed {
    return (false, "malformed export section", t[0].fail_offset, -1)
  }
  return export_rest(data, t[0].pos, limit, n - 1)
}

// A shared vec-of-u32 walker (the function section's shape).
def u32_vec_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const p = internal.reader.u32(internal.reader.new(data, pos, limit))
  if p[0].failed {
    return (false, "malformed function section", p[0].fail_offset, -1)
  }
  return u32_vec_rest(data, p[0].pos, limit, n - 1)
}

// ---- the validator (T20.14 onward) ----
//
// A second pass over the module: the decode pass proved the byte
// shape; this pass checks the semantics that make a module valid.
// The context threads as one tuple:
//
//   (types, func_typeidxs, n_tables, n_mems, global_codes, export_names)
//
// types: Array[FuncType]; func_typeidxs: every function's type index
// in function-index order (imports first); global_codes: valtype
// codes; export_names: for the pairwise-uniqueness rule.

// The context tuple's type, spelled once per signature — the price of
// structural tuples (no named record types to alias it with).
// The code section: vec of sized code entries; each body's locals and
// expression must consume the entry exactly.
def code_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed code section", cn[0].fail_offset, -1)
  }
  return code_rest(data, cn[0].pos, limit, cn[1])
}

def code_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const sz = internal.reader.u32(internal.reader.new(data, pos, limit))
  if sz[0].failed {
    return (false, "malformed code section", sz[0].fail_offset, -1)
  }
  const size = sz[1]
  if size > internal.reader.remaining(sz[0]) {
    return (false, "malformed code section", sz[0].pos, -1)
  }
  const lv = internal.reader.locals_walk(data, sz[0].pos, sz[0].pos + size, 0)
  if !lv[0] {
    return (false, "malformed code section", sz[0].pos, -1)
  }
  const e = internal.reader.expr(
    internal.reader.new(data, lv[1], sz[0].pos + size))
  if e.failed {
    return (false, "malformed code section", e.fail_offset, -1)
  }
  if e.pos != sz[0].pos + size {
    return (false, "malformed code section", e.pos, -1)
  }
  const r3 = internal.reader.skip(sz[0], size)
  return code_rest(data, r3.pos, limit, n - 1)
}

def validate(data Bytes) (Bool, String, Int, String) {
  return vwalk(data, 8, 0, [], 0, [], 0, 0, [], [])
}

def vwalk(data Bytes, pos Int, last_rank Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, String) {
  if pos >= data.length() {
    return (true, "", -1, "")
  }
  const p = internal.reader.u8(internal.reader.new(data, pos, data.length()))
  const r1 = p[0]
  const id = p[1]
  if r1.failed {
    return (true, "", -1, "")
  }
  const ps = internal.reader.u32(r1)
  const r2 = ps[0]
  if r2.failed {
    return (true, "", -1, "")
  }
  const size = ps[1]
  if size > internal.reader.remaining(r2) {
    return (true, "", -1, "")
  }
  const r3 = internal.reader.skip(r2, size)
  if id == 1 {
    const t = type_section(data, r2.pos, r3.pos)
    if !t[0] {
      return (true, "", -1, "")
    }
    return vwalk(data, r3.pos, last_rank, t[1], n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
  }
  if id == 2 {
    const s = vimports(data, r2.pos, r3.pos, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, s[3], func_typeidxs, n_tables, n_mems, global_codes, export_names)
  }
  if id == 3 {
    const s = vfuncs(data, r2.pos, r3.pos, 3, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return s
  }
  if id == 4 {
    const s = vtables(data, r2.pos, r3.pos)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables + 1, n_mems, global_codes, export_names)
  }
  if id == 5 {
    const s = vmems(data, r2.pos, r3.pos)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems + 1, global_codes, export_names)
  }
  if id == 6 {
    const s = vglobals(data, r2.pos, r3.pos, global_codes)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, s[3], export_names)
  }
  if id == 7 {
    const total_funcs = n_imp_funcs + func_typeidxs.length()
    const s = vexports(data, r2.pos, r3.pos, types, total_funcs, n_tables, n_mems, global_codes.length(), export_names)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, s[3])
  }
  if id == 10 {
    // The code section, typed: each body runs the type-stack
    // validator (T20.15/T20.16) against its declared function type.
    const s = vcodes(data, r2.pos, r3.pos, types, func_typeidxs)
    if !s[0] {
      return (false, s[1], s[2], "invalid")
    }
    return vwalk(data, r3.pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
  }
  return vskip(data, r3.pos, id, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
}

// The code section, semantically: body i's function type is
// types[func_typeidxs[declared count + i]].
def vcodes(data Bytes, pos Int, limit Int, types Array[FuncType], func_typeidxs Array[Int]) (Bool, String, Int, String) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, "")
  }
  if cn[1] != func_typeidxs.length() {
    return (false, "function and code section have inconsistent lengths", pos, "invalid")
  }
  return vcodes_rest(data, cn[0].pos, limit, cn[1], types, func_typeidxs, 0)
}

def vcodes_rest(data Bytes, pos Int, limit Int, n Int, types Array[FuncType], func_typeidxs Array[Int], i Int) (Bool, String, Int, String) {
  if n == 0 {
    return (true, "", -1, "")
  }
  const sz = internal.reader.u32(internal.reader.new(data, pos, limit))
  if sz[0].failed {
    return (true, "", -1, "")
  }
  const size = sz[1]
  if size > internal.reader.remaining(sz[0]) {
    return (true, "", -1, "")
  }
  const tidx = func_typeidxs[i]
  if tidx >= types.length() {
    return (true, "", -1, "")
  }
  const ft = types[tidx]
  const r2 = sz[0]
  const bpos = r2.pos
  const bend = bpos + size
  const b = internal.reader.vbody(data, bpos, bend, ft.params, ft.results)
  if !b[0] {
    return (false, "type mismatch", bpos, "invalid")
  }
  const r3 = internal.reader.skip(r2, size)
  return vcodes_rest(data, r3.pos, limit, n - 1, types, func_typeidxs, i + 1)
}

// The import section, semantically: each descriptor's indices must
// resolve, limits must be well ordered and inside the page caps.
def vimports(data Bytes, pos Int, limit Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, n_imp_funcs)
  }
  return vimports_rest(data, cn[0].pos, limit, cn[1], types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
}

def vimports_rest(data Bytes, pos Int, limit Int, n Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, n_imp_funcs)
  }
  const m = name(data, pos, limit)
  if !m[0] {
    return (true, "", -1, n_imp_funcs)
  }
  const nm = name(data, m[2], limit)
  if !nm[0] {
    return (true, "", -1, n_imp_funcs)
  }
  if nm[2] >= limit {
    return (true, "", -1, n_imp_funcs)
  }
  const kind = data.get(nm[2])
  if kind == 0 {
    const t = internal.reader.u32(internal.reader.new(data, nm[2] + 1, limit))
    if t[0].failed {
      return (true, "", -1, n_imp_funcs)
    }
    if t[1] >= types.length() {
      return (false, "unknown type", nm[2], n_imp_funcs)
    }
    return vimports_rest(data, t[0].pos, limit, n - 1, types, n_imp_funcs + 1, func_typeidxs, n_tables, n_mems, global_codes, export_names)
  }
  if kind == 1 {
    const t = tabletype(data, nm[2] + 1, limit)
    if !t[0] {
      return (true, "", -1, n_imp_funcs)
    }
    if t[4] && t[2] > t[3] {
      return (false, "size minimum must not be greater than maximum", nm[2], n_imp_funcs)
    }
    return vimports_rest(data, t[5], limit, n - 1, types, n_imp_funcs, func_typeidxs, n_tables + 1, n_mems, global_codes, export_names)
  }
  if kind == 2 {
    const t = memtype(data, nm[2] + 1, limit)
    if !t[0] {
      return (true, "", -1, n_imp_funcs)
    }
    if t[3] && t[1] > t[2] {
      return (false, "size minimum must not be greater than maximum", nm[2], n_imp_funcs)
    }
    if t[1] > 65536 || t[2] > 65536 {
      return (false, "memory size must be at most 65536 pages", nm[2], n_imp_funcs)
    }
    return vimports_rest(data, t[4], limit, n - 1, types, n_imp_funcs, func_typeidxs, n_tables, n_mems + 1, global_codes, export_names)
  }
  if kind == 3 {
    const t = globaltype(data, nm[2] + 1, limit)
    if !t[0] {
      return (true, "", -1, n_imp_funcs)
    }
    return vimports_rest(data, t[3], limit, n - 1, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes.append(t[1]), export_names)
  }
  return (true, "", -1, n_imp_funcs)
}

// The function section: every type index must resolve.
def vfuncs(data Bytes, pos Int, limit Int, last_rank Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, String) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, "")
  }
  return vfuncs_rest(data, cn[0].pos, limit, last_rank, cn[1], types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
}

def vfuncs_rest(data Bytes, pos Int, limit Int, last_rank Int, n Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, String) {
  if n == 0 {
    return vwalk(data, pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
  }
  const t = internal.reader.u32(internal.reader.new(data, pos, limit))
  if t[0].failed {
    return (true, "", -1, "")
  }
  if t[1] >= types.length() {
    return (false, "unknown type", pos, "invalid")
  }
  return vfuncs_rest(data, t[0].pos, limit, last_rank, n - 1, types, n_imp_funcs, func_typeidxs.append(t[1]), n_tables, n_mems, global_codes, export_names)
}

// Table and memory sections: limits well ordered and in range.
def vtables(data Bytes, pos Int, limit Int) (Bool, String, Int, String) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, "")
  }
  return vtables_rest(data, cn[0].pos, limit, cn[1])
}

def vtables_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, String) {
  if n == 0 {
    return (true, "", -1, "")
  }
  const t = tabletype(data, pos, limit)
  if !t[0] {
    return (true, "", -1, "")
  }
  if t[4] && t[2] > t[3] {
    return (false, "size minimum must not be greater than maximum", pos, "invalid")
  }
  return vtables_rest(data, t[5], limit, n - 1)
}

def vmems(data Bytes, pos Int, limit Int) (Bool, String, Int, String) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, "")
  }
  return vmems_rest(data, cn[0].pos, limit, cn[1])
}

def vmems_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, String) {
  if n == 0 {
    return (true, "", -1, "")
  }
  const t = memtype(data, pos, limit)
  if !t[0] {
    return (true, "", -1, "")
  }
  if t[3] && t[1] > t[2] {
    return (false, "size minimum must not be greater than maximum", pos, "invalid")
  }
  if t[1] > 65536 || t[2] > 65536 {
    return (false, "memory size must be at most 65536 pages", pos, "invalid")
  }
  return vmems_rest(data, t[4], limit, n - 1)
}

// The global section: shapes decode; the initializer typing is
// T20.17's. The valtype codes collect for the index space.
def vglobals(data Bytes, pos Int, limit Int, global_codes Array[Int]) (Bool, String, Int, Array[Int]) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, global_codes)
  }
  return vglobals_rest(data, cn[0].pos, limit, cn[1], global_codes)
}

def vglobals_rest(data Bytes, pos Int, limit Int, n Int, global_codes Array[Int]) (Bool, String, Int, Array[Int]) {
  if n == 0 {
    return (true, "", -1, global_codes)
  }
  const gt = globaltype(data, pos, limit)
  if !gt[0] {
    return (true, "", -1, global_codes)
  }
  const e = internal.reader.const_expr(internal.reader.new(data, gt[3], limit))
  if e.failed {
    return (true, "", -1, global_codes)
  }
  return vglobals_rest(data, e.pos, limit, n - 1, global_codes.append(gt[1]))
}

// The export section: indices must resolve in their spaces; names must
// be pairwise unique.
def vexports(data Bytes, pos Int, limit Int, types Array[FuncType], total_funcs Int, n_tables Int, n_mems Int, n_globals Int, export_names Array[String]) (Bool, String, Int, Array[String]) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (true, "", -1, export_names)
  }
  return vexports_rest(data, cn[0].pos, limit, cn[1], types, total_funcs, n_tables, n_mems, n_globals, export_names)
}

def vexports_rest(data Bytes, pos Int, limit Int, n Int, types Array[FuncType], total_funcs Int, n_tables Int, n_mems Int, n_globals Int, export_names Array[String]) (Bool, String, Int, Array[String]) {
  if n == 0 {
    return (true, "", -1, export_names)
  }
  const nm = name(data, pos, limit)
  if !nm[0] {
    return (true, "", -1, export_names)
  }
  if nm[2] >= limit {
    return (true, "", -1, export_names)
  }
  const kind = data.get(nm[2])
  if kind > 3 {
    return (true, "", -1, export_names)
  }
  const t = internal.reader.u32(internal.reader.new(data, nm[2] + 1, limit))
  if t[0].failed {
    return (true, "", -1, export_names)
  }
  // Index-space checks.
  if kind == 0 && t[1] >= total_funcs {
    return (false, "unknown function", nm[2], export_names)
  }
  if kind == 1 && t[1] >= n_tables {
    return (false, "unknown table", nm[2], export_names)
  }
  if kind == 2 && t[1] >= n_mems {
    return (false, "unknown memory", nm[2], export_names)
  }
  if kind == 3 && t[1] >= n_globals {
    return (false, "unknown global", nm[2], export_names)
  }
  // Name uniqueness: pairwise against the names collected so far.
  const nb = internal.reader.take(internal.reader.new(data, pos, nm[2]), nm[1])
  const dup = name_known(export_names, nb[1], 0)
  if dup {
    return (false, "duplicate export name", nm[2], export_names)
  }
  return vexports_rest(data, t[0].pos, limit, n - 1, types, total_funcs, n_tables, n_mems, n_globals, export_names.append(nb[1].to_string()))
}

def name_known(names Array[String], candidate Bytes, i Int) Bool {
  if i == names.length() {
    return false
  }
  if names[i] == candidate.to_string() {
    return true
  }
  return name_known(names, candidate, i + 1)
}

// Sections whose semantic passes land in T20.15-T20.17.
def vskip(data Bytes, pos Int, id Int, last_rank Int, types Array[FuncType], n_imp_funcs Int, func_typeidxs Array[Int], n_tables Int, n_mems Int, global_codes Array[Int], export_names Array[String]) (Bool, String, Int, String) {
  return vwalk(data, pos, last_rank, types, n_imp_funcs, func_typeidxs, n_tables, n_mems, global_codes, export_names)
}


// The global section: vec of (globaltype, init expression).
def global_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed global section", cn[0].fail_offset, -1)
  }
  return global_rest(data, cn[0].pos, limit, cn[1])
}

def global_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  const gt = globaltype(data, pos, limit)
  if !gt[0] {
    return (false, "malformed global section", pos, -1)
  }
  const e = internal.reader.const_expr(
    internal.reader.new(data, gt[3], limit))
  if e.failed {
    return (false, "malformed global section", e.fail_offset, -1)
  }
  return global_rest(data, e.pos, limit, n - 1)
}

// An element kind byte must be exactly 0x00 (a funcref element kind).
def elemkind(data Bytes, pos Int, limit Int) (Bool, Int) {
  if pos >= limit {
    return (false, pos)
  }
  if data.get(pos) != 0 {
    return (false, pos)
  }
  return (true, pos + 1)
}

// A reference type byte for element segments (0x70 / 0x6f).
def elem_reftype(data Bytes, pos Int, limit Int) (Bool, Int) {
  if pos >= limit {
    return (false, pos)
  }
  const b = data.get(pos)
  if b == 112 || b == 111 {
    return (true, pos + 1)
  }
  return (false, pos)
}

// A vector of function indices.
def funcidx_vec(data Bytes, pos Int, limit Int) (Bool, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, cn[0].fail_offset)
  }
  return u32_vec_end(data, cn[0].pos, limit, cn[1])
}

def u32_vec_end(data Bytes, pos Int, limit Int, n Int) (Bool, Int) {
  if n == 0 {
    return (true, pos)
  }
  const p = internal.reader.u32(internal.reader.new(data, pos, limit))
  if p[0].failed {
    return (false, p[0].fail_offset)
  }
  return u32_vec_end(data, p[0].pos, limit, n - 1)
}

// One constant expression (active segment offsets, global initializers).
def one_expr(data Bytes, pos Int, limit Int) (Bool, Int) {
  const e = internal.reader.const_expr(internal.reader.new(data, pos, limit))
  if e.failed {
    return (false, e.fail_offset)
  }
  return (true, e.pos)
}

// A vector of constant expressions.
def expr_vec(data Bytes, pos Int, limit Int) (Bool, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, cn[0].fail_offset)
  }
  return expr_vec_rest(data, cn[0].pos, limit, cn[1])
}

def expr_vec_rest(data Bytes, pos Int, limit Int, n Int) (Bool, Int) {
  if n == 0 {
    return (true, pos)
  }
  const e = internal.reader.const_expr(internal.reader.new(data, pos, limit))
  if e.failed {
    return (false, e.fail_offset)
  }
  return expr_vec_rest(data, e.pos, limit, n - 1)
}

// A vector of raw bytes (a data payload).
def byte_vec(data Bytes, pos Int, limit Int) (Bool, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, cn[0].fail_offset)
  }
  if cn[1] > internal.reader.remaining(cn[0]) {
    return (false, cn[0].pos)
  }
  const r = internal.reader.skip(cn[0], cn[1])
  return (true, r.pos)
}

// The element section: one flag byte per segment selects the shape
// (active/passive/declarative, funcidx or expression vectors).
def elem_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed element section", cn[0].fail_offset, -1)
  }
  return elem_rest(data, cn[0].pos, limit, cn[1])
}

def elem_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  if pos >= limit {
    return (false, "malformed element section", pos, -1)
  }
  const pf = internal.reader.u32(internal.reader.new(data, pos, limit))
  if pf[0].failed {
    return (false, "malformed element section", pf[0].fail_offset, -1)
  }
  const flag = pf[1]
  var r = pf[0].pos
  if flag == 0 {
    const o = one_expr(data, r, limit)
    if !o[0] { return (false, "malformed element section", o[1], -1) }
    const f = funcidx_vec(data, o[1], limit)
    if !f[0] { return (false, "malformed element section", f[1], -1) }
    r = f[1]
  }
  if flag == 1 {
    const k = elemkind(data, r, limit)
    if !k[0] { return (false, "malformed element section", k[1], -1) }
    const f = funcidx_vec(data, k[1], limit)
    if !f[0] { return (false, "malformed element section", f[1], -1) }
    r = f[1]
  }
  if flag == 2 {
    const t = internal.reader.u32(internal.reader.new(data, r, limit))
    if t[0].failed { return (false, "malformed element section", t[0].fail_offset, -1) }
    const o = one_expr(data, t[0].pos, limit)
    if !o[0] { return (false, "malformed element section", o[1], -1) }
    const k = elemkind(data, o[1], limit)
    if !k[0] { return (false, "malformed element section", k[1], -1) }
    const f = funcidx_vec(data, k[1], limit)
    if !f[0] { return (false, "malformed element section", f[1], -1) }
    r = f[1]
  }
  if flag == 3 {
    const k = elemkind(data, r, limit)
    if !k[0] { return (false, "malformed element section", k[1], -1) }
    const f = funcidx_vec(data, k[1], limit)
    if !f[0] { return (false, "malformed element section", f[1], -1) }
    r = f[1]
  }
  if flag == 4 {
    const o = expr_vec(data, r, limit)
    if !o[0] { return (false, "malformed element section", o[1], -1) }
    const ev = expr_vec(data, o[1], limit)
    if !ev[0] { return (false, "malformed element section", ev[1], -1) }
    r = ev[1]
  }
  if flag == 5 {
    const rt = elem_reftype(data, r, limit)
    if !rt[0] { return (false, "malformed element section", rt[1], -1) }
    const ev = expr_vec(data, rt[1], limit)
    if !ev[0] { return (false, "malformed element section", ev[1], -1) }
    r = ev[1]
  }
  if flag == 6 {
    const t = internal.reader.u32(internal.reader.new(data, r, limit))
    if t[0].failed { return (false, "malformed element section", t[0].fail_offset, -1) }
    const o = one_expr(data, t[0].pos, limit)
    if !o[0] { return (false, "malformed element section", o[1], -1) }
    const rt = elem_reftype(data, o[1], limit)
    if !rt[0] { return (false, "malformed element section", rt[1], -1) }
    const ev = expr_vec(data, rt[1], limit)
    if !ev[0] { return (false, "malformed element section", ev[1], -1) }
    r = ev[1]
  }
  if flag == 7 {
    const rt = elem_reftype(data, r, limit)
    if !rt[0] { return (false, "malformed element section", rt[1], -1) }
    const ev = expr_vec(data, rt[1], limit)
    if !ev[0] { return (false, "malformed element section", ev[1], -1) }
    r = ev[1]
  }
  if flag > 7 {
    return (false, "malformed element section", pos, -1)
  }
  return elem_rest(data, r, limit, n - 1)
}

// The data section: one flag byte per segment (0 active memory 0,
// 1 passive, 2 active with explicit memory index).
def data_section(data Bytes, pos Int, limit Int) (Bool, String, Int, Int) {
  const cn = internal.reader.u32(internal.reader.new(data, pos, limit))
  if cn[0].failed {
    return (false, "malformed data section", cn[0].fail_offset, -1)
  }
  return data_rest(data, cn[0].pos, limit, cn[1])
}

def data_rest(data Bytes, pos Int, limit Int, n Int) (Bool, String, Int, Int) {
  if n == 0 {
    return (true, "", -1, pos)
  }
  if pos >= limit {
    return (false, "malformed data section", pos, -1)
  }
  const pf = internal.reader.u32(internal.reader.new(data, pos, limit))
  if pf[0].failed {
    return (false, "malformed data section", pf[0].fail_offset, -1)
  }
  const flag = pf[1]
  var r = pf[0].pos
  if flag == 0 {
    const o = one_expr(data, r, limit)
    if !o[0] { return (false, "malformed data section", o[1], -1) }
    const b = byte_vec(data, o[1], limit)
    if !b[0] { return (false, "malformed data section", b[1], -1) }
    r = b[1]
  }
  if flag == 1 {
    const b = byte_vec(data, r, limit)
    if !b[0] { return (false, "malformed data section", b[1], -1) }
    r = b[1]
  }
  if flag == 2 {
    const t = internal.reader.u32(internal.reader.new(data, r, limit))
    if t[0].failed { return (false, "malformed data section", t[0].fail_offset, -1) }
    const o = one_expr(data, t[0].pos, limit)
    if !o[0] { return (false, "malformed data section", o[1], -1) }
    const b = byte_vec(data, o[1], limit)
    if !b[0] { return (false, "malformed data section", b[1], -1) }
    r = b[1]
  }
  if flag > 2 {
    return (false, "malformed data section", pos, -1)
  }
  return data_rest(data, r, limit, n - 1)
}
