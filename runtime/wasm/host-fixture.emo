// The spectest host fixture (T21.9): a module imports the host's print
// functions, typed globals, table, and memory.

const hex = ""

def run() Int64 {
  var failed = 0
  const r = wasm.load(internal.corpus.decode_hex(hex))
  const ir = internal.instance.instantiate(r[4])
  println("inst " + ir[0].to_string() + " " + ir[1])
  const u = internal.instance.call(ir[2], "use", [])
  println("use " + u[1][0][1].to_string())
  const ms = internal.instance.call(ir[2], "mem_size", [])
  println("mem " + ms[1][0][1].to_string())
  const ts = internal.instance.call(ir[2], "tab_size", [])
  println("tab " + ts[1][0][1].to_string())
  println("failed " + failed.to_string())
  return failed
}

run()
