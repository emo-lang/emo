; The smoke rule makes the wasm package non-inert: `dune test` runs
; `emo run main.emo` and diffs its stdout against expected.txt, so a
; red line here means the runtime's own golden broke. The second pair
; runs the full list under the wasm_spec alias (step 21's acceptance
; gate).

(rule
 (alias runtest)
 (deps
  (:emo %{workspace_root}/_build/default/src/emo_cli/emo.exe)
  main.emo
  wasm.emo
  cli.emo
  (source_tree .)
  testdata/cases.smoke.txt
  package.emo)
 (action
  (with-stdout-to
   smoke.actual
   (run %{emo} run main.emo))))

(rule
 (alias runtest)
 (deps smoke.actual expected.txt)
 (action
  (diff expected.txt smoke.actual)))

(rule
 (alias runtest)
 (deps
  (:emo %{workspace_root}/_build/default/src/emo_cli/emo.exe)
  leb-fixture.emo
  wasm.emo
  cli.emo
  (source_tree .)
  package.emo)
 (action
  (with-stdout-to
   leb-fixture.actual
   (run %{emo} run leb-fixture.emo))))

(rule
 (alias runtest)
 (deps leb-fixture.actual leb-fixture.expected.txt)
 (action
  (diff leb-fixture.expected.txt leb-fixture.actual)))

(rule
 (alias runtest)
 (deps
  (:emo %{workspace_root}/_build/default/src/emo_cli/emo.exe)
  type-fixture.emo
  wasm.emo
  cli.emo
  (source_tree .)
  package.emo)
