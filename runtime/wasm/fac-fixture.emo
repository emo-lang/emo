// The frame-machine fixture (T21.7): a recursive `fac` proves the
// tail-call chain, and a `loop` sum proves structured control, locals,
// branches, and the numeric walk.

const hex = "0061736d0100000001060160017e017e03030200000710020366616300000673756d5f746f00010a3d0217002000420253047e4201052000200042017d10007e0b0b2301027e0240034020012000550d01200220017c2102200142017c21010c000b0b20020b"

def run() Int64 {
  var failed = 0
  const r = wasm.load(internal.corpus.decode_hex(hex))
  println("load " + r[0].to_string() + " " + r[1])
  if !r[0] {
    return 1
  }
  const c5 = internal.instance.call(r[4], "fac", [internal.value.i64(5)])
  println("fac5 " + c5[1][0][1].to_string())
  const c25 = internal.instance.call(r[4], "fac", [internal.value.i64(25)])
  println("fac25 " + c25[1][0][1].to_string())
  const s5 = internal.instance.call(r[4], "sum_to", [internal.value.i64(5)])
  println("sum5 " + s5[1][0][1].to_string())
  const s100 = internal.instance.call(r[4], "sum_to", [internal.value.i64(100)])
  println("sum100 " + s100[1][0][1].to_string())
  println("failed " + failed.to_string())
  return failed
}

run()
