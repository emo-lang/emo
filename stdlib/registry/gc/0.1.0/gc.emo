// The gc package: the machine heap's allocator and collector
// (docs/gc-heap.md).
//
// The arena is the host's — one range of words `heap_new` makes — and
// everything on top of it is the language's own. The free geometry
// lives here, in two maps the allocator reads and writes: a range is
// (start, size), `by_start` keys it by its first word, `by_end` by the
// word past its last, and a release merges with whichever neighbor the
// two maps name. Allocation is first fit over the ranges, the take
// splits what it chooses, and an arena that cannot answer is the loud
// end — a real heap is finite and the allocator says so.
//
// The word discipline, visible in every accessor here:
//   an even word is a scalar, stored shifted left one bit; an odd
//   word is a reference — the handle a block answers at carve; 0 is
//   null. The tag makes every slot self-describing, so a collector
//   can walk a heap it did not type.
// The block layout: slot 0 is the header word (magic, kind,
//   generation, the mark bit, the logical size), the data sits in
//   slots 1..n. The accessors below shift so caller field indices
//   start at 0, and slot 0 stays the collector's.
// The mutator discipline: a handle a collection must respect lives
//   in a root (`ref_new`); a collection allocates nothing — the
//   worklist below is host memory (an ArrayBuilder), never a heap
//   block; and a handle to released words dies loudly at the door,
//   the generation having moved on.

// ---- the word tags ----

// Whether a word is a reference: the odd bit. A slot's kind is the
// word's kind — that is the whole typing discipline of the heap.
def is_ref(w Int64) Bool {
  return (w & 1) == 1
}

// The handle's header offset: the address the allocator works in.
def addr_of(h Int64) Int64 {
  return (h >> 1) & 2199023255551
}

// ---- the allocator's state: the free geometry ----

var by_start = Map.new()
var by_end = Map.new()
var arena_words = 0

// The arena, once per run: `heap_new` makes the words, the free list
// starts as one range covering all of them.
def arena(words Int64) Void {
  heap_new(words)
  arena_words = words
  by_start.set(0, words)
  by_end.set(words, 0)
}

// How many free ranges the geometry holds — one after a compaction,
// many when the sweeps have punched holes.
def free_ranges() Int64 {
  return by_start.length()
}

// The words the free list holds — the arena's not-yet-carved space.
def free_words() Int64 {
  var sum = 0
  const starts = by_start.keys()
  for var i = 0; i < starts.length(); i = i + 1 {
    sum = sum + by_start.get(starts[i])
  }
  return sum
}

// First fit over the free ranges, the take splitting what it chooses.
// No range fits: the arena is finite and this is the loud end.
def take(n Int64, kind Int64) Int64 {
  const needed = n + 1
  const starts = by_start.keys()
  for var i = 0; i < starts.length(); i = i + 1 {
    const start = starts[i]
    const size = by_start.get(start)
    if size >= needed {
      const h = heap_carve(start, n, kind)
      by_start.remove(start)
      by_end.remove(start + size)
      if size > needed {
        by_start.set(start + needed, size - needed)
        by_end.set(start + size, start + needed)
      }
      return h
    }
  }
  raise Exception.new(message: "gc: the arena has no free range for the request")
}

// Returns a released range to the geometry, merging with the range
// that ends where it begins and the range that begins where it ends —
// the two maps answer both questions without a scan.
def ranges_free(addr Int64, sz Int64) Void {
  var start = addr
  var size = sz
  if by_end.has(addr) {
    const prev = by_end.get(addr)
    size = by_start.get(prev) + size
    by_start.remove(prev)
    by_end.remove(addr)
    start = prev
  }
  if by_start.has(start + size) {
    const next_size = by_start.get(start + size)
    by_start.remove(start + size)
    by_end.remove(start + size + next_size)
    size = size + next_size
  }
  by_start.set(start, size)
  by_end.set(start + size, start)
}

// ---- struct accessors (field indices start at 0; slot 0 is the header) ----

def s_new(fields Int64) Int64 {
  return take(fields, 1)
}

def s_set(b Int64, i Int64, v Int64) Void {
  struct_set(b, i + 1, v << 1)
}

def s_get(b Int64, i Int64) Int64 {
  return struct_get(b, i + 1) >> 1
}

// Null rides the same slots: 0 is a legal reference word (no
// reference), so the ref accessors refuse only an even nonzero word —
// a scalar parked where a reference belongs.
def s_set_ref(b Int64, i Int64, h Int64) Void {
  if h != 0 && (h & 1) == 0 {
    raise Exception.new(message: "gc: s_set_ref expects a handle word (odd) or null, got an even word")
  }
  struct_set(b, i + 1, h)
}

def s_get_ref(b Int64, i Int64) Int64 {
  const w = struct_get(b, i + 1)
  if w != 0 && (w & 1) == 0 {
    raise Exception.new(message: "gc: s_get_ref reads a scalar slot as a reference")
  }
  return w
}

// ---- payload accessors: bytes ride the scalar lane, floats get
// their own arrays ----

// A byte rides as its 0..255 value; reading checks the range the
// type promises, the loud end past it.
def s_set_byte(b Int64, i Int64, v Byte) Void {
  struct_set(b, i + 1, v.to_int64() << 1)
}

def s_get_byte(b Int64, i Int64) Byte {
  return Byte.from_int64(struct_get(b, i + 1) >> 1)
}

def a_set_byte(a Int64, i Int64, v Byte) Void {
  array_set(a, i + 1, v.to_int64() << 1)
}

def a_get_byte(a Int64, i Int64) Byte {
  return Byte.from_int64(array_get(a, i + 1) >> 1)
}

// ---- float arrays: kind 3, every slot raw Float64 bits ----

// A float's 64 bits cannot ride the parity lane (the shift round-trip
// only preserves words whose top bit repeats), so floats get their own
// block kind: no parity on the slots, no references inside, and the
// collector traces the block without walking its words.
def fa_new(n Int64) Int64 {
  return take(n, 3)
}

def fa_set(a Int64, i Int64, v Float64) Void {
  float_array_set(a, i + 1, heap_float_bits(v))
}

def fa_get(a Int64, i Int64) Float64 {
  return heap_bits_float(float_array_get(a, i + 1))
}

// ---- array accessors ----

def a_new(n Int64) Int64 {
  return take(n, 2)
}

def a_len(a Int64) Int64 {
  return array_len(a)
}

def a_set(a Int64, i Int64, v Int64) Void {
  array_set(a, i + 1, v << 1)
}

def a_get(a Int64, i Int64) Int64 {
  return array_get(a, i + 1) >> 1
}

def a_set_ref(a Int64, i Int64, h Int64) Void {
  if h != 0 && (h & 1) == 0 {
    raise Exception.new(message: "gc: a_set_ref expects a handle word (odd) or null, got an even word")
  }
  array_set(a, i + 1, h)
}

def a_get_ref(a Int64, i Int64) Int64 {
  const w = array_get(a, i + 1)
  if w != 0 && (w & 1) == 0 {
    raise Exception.new(message: "gc: a_get_ref reads a scalar slot as a reference")
  }
  return w
}

// ---- the collector: mark-sweep over the doors ----

// The mark bit rides the header word (bit 23), beside the magic, the
// kind, the generation, and the size. The bit flips through a read-
// xor-store, the only writer being this collector at a quiescent
// point.
const header_mark = 8388608

def set_mark(h Int64, on Int64) Void {
  const a = addr_of(h)
  const header = heap_load(a)
  if on == 1 {
    if (header & header_mark) == 0 {
      heap_store(a, header ^ header_mark)
    }
  } else {
    if (header & header_mark) != 0 {
      heap_store(a, header ^ header_mark)
    }
  }
}

def is_marked(h Int64) Bool {
  return (heap_load(addr_of(h)) & header_mark) != 0
}

// Marks one block. An already-marked block stops here — that is the
// cut a cycle needs — and a fresh one takes the mark bit, then every
// reference word in its data slots joins the worklist.
def mark_block(h Int64, work ArrayBuilder[Int64]) Void {
  if !is_marked(h) {
    set_mark(h, 1)
    const size = block_size(h)
    const kind = block_kind(h)
    if kind != 3 {
      for var i = 1; i <= size; i = i + 1 {
        var w = 0
        if kind == 1 {
          w = struct_get(h, i)
        } else {
          w = array_get(h, i)
        }
        if (w & 1) == 1 {
          work.push(w)
        }
      }
    }
  }
}

// One full collection. Walks the root set the interpreter answers,
// marks everything reachable (cycles included), sweeps the rest back
// into the free geometry, and answers the number of words the sweep
// reclaimed.
def collect() Int64 {
  const before = heap_words()
  const work = ArrayBuilder.new()
  const roots = ref_roots()
  for var i = 0; i < roots.length(); i = i + 1 {
    const w = ref_read(roots[i])
    if (w & 1) == 1 {
      mark_block(w, work)
    }
  }
  var cursor = 0
  while cursor < work.length() {
    mark_block(work.get(cursor), work)
    cursor = cursor + 1
  }
  const blocks = heap_blocks()
  for var i = 0; i < blocks.length(); i = i + 1 {
    const h = blocks[i]
    if is_marked(h) {
      set_mark(h, 0)
    } else {
      give_back(h)
    }
  }
  return before - heap_words()
}

// ---- compaction: the sliding collector ----

// Mark exactly as collect, then slide: the live blocks — address
// order, destinations from zero — move through `heap_slide`, every
// reference (fields and roots) rewrites through the forwarding map,
// and the geometry resets to the one range behind the slide. Answers
// the words the slide gave back.
def compact() Int64 {
  const work = ArrayBuilder.new()
  const roots = ref_roots()
  for var i = 0; i < roots.length(); i = i + 1 {
    const w = ref_read(roots[i])
    if (w & 1) == 1 {
      mark_block(w, work)
    }
  }
  var cursor = 0
  while cursor < work.length() {
    mark_block(work.get(cursor), work)
    cursor = cursor + 1
  }
  const pairs = ArrayBuilder.new()
  const blocks = heap_blocks()
  var next = 0
  for var i = 0; i < blocks.length(); i = i + 1 {
    const h = blocks[i]
    if is_marked(h) {
      pairs.push(h)
      pairs.push(next)
      next = next + block_size(h) + 1
    }
  }
  const moved = heap_slide(pairs.to_array())
  const fwd = Map.new()
  for var i = 0; i < moved.length(); i = i + 1 {
    fwd.set(pairs.get(2 * i), moved[i])
  }
  for var i = 0; i < moved.length(); i = i + 1 {
    const h = moved[i]
    const kind = block_kind(h)
    if kind != 3 {
      const size = block_size(h)
      for var j = 1; j <= size; j = j + 1 {
        var w = 0
        if kind == 1 {
          w = struct_get(h, j)
        } else {
          w = array_get(h, j)
        }
        if (w & 1) == 1 && fwd.has(w) {
          const nw = fwd.get(w)
          if kind == 1 {
            struct_set(h, j, nw)
          } else {
            array_set(h, j, nw)
          }
        }
      }
    }
  }
  for var i = 0; i < roots.length(); i = i + 1 {
    const r = roots[i]
    const w = ref_read(r)
    if (w & 1) == 1 && fwd.has(w) {
      ref_write(r, fwd.get(w))
    }
  }
  const tail = arena_words - next
  by_start = Map.new()
  by_end = Map.new()
  if tail > 0 {
    by_start.set(next, tail)
    by_end.set(arena_words, next)
  }
  return tail
}

// The sweep's way out: the words leave the binding and rejoin the
// free geometry, merged with whatever neighbor they touch.
def give_back(h Int64) Void {
  const size = block_size(h)
  const addr = addr_of(h)
  heap_release(h)
  ranges_free(addr, size + 1)
}
