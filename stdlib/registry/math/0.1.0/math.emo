// The elementary math package: the float functions and constants the
// rest of the standard library builds on, with no package dependencies.
//
// Every function is pure Emo over the scalar operations all five hosted
// targets share, so each answers byte-for-byte. The transcendental
// functions use fixed-order series and range reduction built on the
// bit-level pair `Float64.to_bits` / `Float64.from_bits`: the same
// operations in the same order on every target produce the same bits,
// which is what the SVG goldens rely on. A native fast path (calling
// the host libm through `foreign def`) is deliberately not here: it
// would refuse the wasm/typescript/beam targets and pin output to a
// platform.
//
// The functions have domains, and an out-of-domain argument is a
// contract violation, not a value: `log` of a non-positive number and
// `exp`'s overflow raise `Exception`. The beam target's Erlang floats
// cannot represent NaN or infinity at all, so returning one is not an
// option; the caller filters its data.

// ---- constants ----

const e = 2.718281828459045
const pi = 3.141592653589793

// ---- scalars ----

def abs(x Float64) Float64 {
  if x < 0.0 {
    return 0.0 - x
  }
  return x
}

def min(a Float64, b Float64) Float64 {
  if a < b {
    return a
  }
  return b
}

def max(a Float64, b Float64) Float64 {
  if a > b {
    return a
  }
  return b
}

def clamp(x Float64, lo Float64, hi Float64) Float64 {
  if x < lo {
    return lo
  }
  if x > hi {
    return hi
  }
  return x
}

def sqrt(x Float64) Float64 {
  return x.sqrt()
}

// ---- powers of two ----

// 2^n, written straight into the exponent field so the scaling in `exp`
// is exact and free of a multiply loop. The reachable range here is
// [-1074, 1023] (a wider exponent is not representable).
def pow2(n Int64) Float64 {
  if n > 1023 {
    raise Exception.new(message: "math: 2^${n} overflows Float64")
  }
  if n < 0 - 1074 {
    return 0.0
  }
  if n >= 0 - 1022 {
    return Float64.from_bits((n + 1023) << 52)
  }
  // A subnormal power of two — far below any plotting range.
  return Float64.from_bits(1 << (n + 1074))
}

// ---- exp ----

// exp(x) = 2^k * exp(r), with k = round(x / ln2) and |r| <= ln2 / 2, so
// a short Taylor series converges to full precision.
def exp(x Float64) Float64 {
  if x > 709.782712893384 {
    raise Exception.new(message: "math: exp overflow")
  }
  if x < 0.0 - 709.782712893384 {
    return 0.0
  }
  const shifted = x * 1.4426950408889634 + 0.5
  const k = shifted.floor()
  const r = x - k * 0.6931471805599453
  var term = 1.0
  var sum = 1.0
  for var i = 1; i <= 14; i = i + 1 {
    term = term * r / i.to_float64()
    sum = sum + term
  }
  return sum * pow2(k.to_int64())
}

// ---- log ----

// log(x) = e*ln2 + log(m), with x = m * 2^e and m in [1, 2). The
// atanh series log(m) = 2 * (z + z^3/3 + z^5/5 + ...), z = (m-1)/(m+1),
// has |z| <= 1/6 after the [sqrt(1/2), sqrt(2)) adjustment, so it
// converges quickly.
def log(x Float64) Float64 {
  if x <= 0.0 {
    raise Exception.new(message: "math: log of a non-positive value")
  }
  if x < Float64.from_bits(4503599627370496) {
    // Below the smallest normal (2^-1022): scale into the normal range,
    // then subtract the scaling's own logarithm (60 * ln2).
    return log(x * 1152921504606846976.0) - 41.58883083359672
  }
  const bits = x.to_bits()
  // the mantissa, then the [1, 2) exponent bias (0x3FF)
  const mant = Float64.from_bits((bits & 4503599627370495) | 4607182418800017408)
  const raw_ex = ((bits >> 52) & 2047) - 1023
  // The [sqrt(1/2), sqrt(2)) adjustment written as expressions: a `var`
  // assignment inside an `if` does not thread its binding out on every
  // backend, so the conditional expression is the portable spelling.
  const adjust = mant > 1.4142135623730951
  const m = if adjust { mant / 2.0 } else { mant }
  const ex = if adjust { raw_ex + 1 } else { raw_ex }
  const z = (m - 1.0) / (m + 1.0)
  const z2 = z * z
  var term = z
  var sum = z
  for var i = 3; i <= 21; i = i + 2 {
    term = term * z2
    sum = sum + term / i.to_float64()
  }
  return ex.to_float64() * 0.6931471805599453 + 2.0 * sum
}

def log10(x Float64) Float64 {
  return log(x) * 0.4342944819032518
}

// ---- pow ----

// b^e through exp/log for a positive base. A zero base answers its
// limit; a negative base is out of this package's domain (Emo has no
// complex result).
def pow(base Float64, exponent Float64) Float64 {
  if base == 0.0 {
    if exponent > 0.0 {
      return 0.0
    }
    if exponent == 0.0 {
      return 1.0
    }
    raise Exception.new(message: "math: pow of zero to a negative exponent")
  }
  if base < 0.0 {
    raise Exception.new(message: "math: pow of a negative base")
  }
  return exp(exponent * log(base))
}
