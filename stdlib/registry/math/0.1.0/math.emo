// The elementary math package: the float functions and constants the
// rest of the standard library builds on, with no package dependencies.
//
// The plain functions are pure Emo over the scalar operations all five
// hosted targets share, so each answers byte-for-byte. The
// transcendental functions use fixed-order series and range reduction
// built on the bit-level pair `Float64.to_bits` /
// `Float64.from_bits`: the same operations in the same order on every
// target produce the same bits, which is what the SVG goldens rely on.
// The trigonometric functions in `internal/trig.emo` put a split-π/2
// range reduction in front of their series, exact up to |x| ≤ 2^20;
// beyond the bound the call raises. The inverse pair folds its
// argument instead — the reciprocal identity above |x| = 1, the
// tan(π/12) fold below — into the range of a fixed-order odd series.
// The exact powers of two and the rescaled hypot live in
// `internal/real.emo`, shared with the complex arithmetic in
// `internal/complex.emo`.
//
// The opt-in native fast path lives under distinct `*_native` names and
// is pinned to `c` and `ocaml`, the two targets that bind a host
// symbol. On the other targets the definitions are inert: `require
// "math"` still works, and only a call is refused — by the interpreter
// (E3009) and by the emitters (a lower error). Its output follows the
// host libm, so it is not byte-identical across platforms.
//
// The functions have domains, and an out-of-domain argument is a
// contract violation, not a value: `log` of a non-positive number, and
// the overflow of `exp`, `exp2`, `sinh`, `cosh`, and `hypot` raise
// `Exception`. The beam target's Erlang floats
// cannot represent NaN or infinity at all, so returning one is not an
// option; the caller filters its data.

// ---- constants ----

const e = 2.718281828459045
const pi = 3.141592653589793

const trig = internal.trig
const real = internal.real
const complex = internal.complex

// ---- scalars ----

def abs(x Float64) Float64 {
  if x < 0.0 {
    return 0.0 - x
  }
  return x
}

def min(a Float64, b Float64) Float64 {
  if a < b {
    return a
  }
  return b
}

def max(a Float64, b Float64) Float64 {
  if a > b {
    return a
  }
  return b
}

def clamp(x Float64, lo Float64, hi Float64) Float64 {
  if x < lo {
    return lo
  }
  if x > hi {
    return hi
  }
  return x
}

def sqrt(x Float64) Float64 {
  return x.sqrt()
}

// hypot rescales both magnitudes by the larger's exponent before any
// squaring, so neither overflow nor underflow can disturb the answer —
// the body lives in internal/real.emo beside the powers of two it
// scales with.
def hypot(a Float64, b Float64) Float64 {
  return real.hypot(a, b)
}

// ---- powers of two ----

// 2^n, written straight into the exponent field so the scaling in `exp`
// is exact and free of a multiply loop. The reachable range here is
// [-1074, 1023] (a wider exponent is not representable). The body lives
// in internal/real.emo, where the other modules share it.
def pow2(n Int64) Float64 {
  return real.pow2(n)
}

// ---- exp ----

// exp(x) = 2^k * exp(r), with k = round(x / ln2) and |r| <= ln2 / 2, so
// a short Taylor series converges to full precision.
def exp(x Float64) Float64 {
  if x > 709.782712893384 {
    raise Exception.new(message: "math: exp overflow")
  }
  if x < 0.0 - 709.782712893384 {
    return 0.0
  }
  const shifted = x * 1.4426950408889634 + 0.5
  const k = shifted.floor()
  const r = x - k * 0.6931471805599453
  var term = 1.0
  var sum = 1.0
  for var i = 1; i <= 14; i = i + 1 {
    term = term * r / i.to_float64()
    sum = sum + term
  }
  return sum * pow2(k.to_int64())
}

// exp2 splits its argument at the floor: pow2 carries the integer part
// exactly, exp's series carries the fraction. Past 1024 the answer
// leaves the exponent range and raises; below −1075 it underflows to
// zero, the exp rule at the bottom of the range.
def exp2(x Float64) Float64 {
  if ((x.to_bits() >> 52) & 2047) == 2047 {
    raise Exception.new(message: "math: exp2 of a non-finite value")
  }
  if x >= 1024.0 {
    raise Exception.new(message: "math: exp2 overflows Float64")
  }
  if x < 0.0 - 1075.0 {
    return 0.0
  }
  const k = x.floor()
  const r = x - k
  return pow2(k.to_int64()) * exp(r * 0.6931471805599453)
}

// ---- log ----

// log(x) = e*ln2 + log(m), with x = m * 2^e and m in [1, 2). The
// atanh series log(m) = 2 * (z + z^3/3 + z^5/5 + ...), z = (m-1)/(m+1),
// has |z| <= 1/6 after the [sqrt(1/2), sqrt(2)) adjustment, so it
// converges quickly.
def log(x Float64) Float64 {
  if x <= 0.0 {
    raise Exception.new(message: "math: log of a non-positive value")
  }
  if x < Float64.from_bits(4503599627370496) {
    // Below the smallest normal (2^-1022): scale into the normal range,
    // then subtract the scaling's own logarithm (60 * ln2).
    return log(x * 1152921504606846976.0) - 41.58883083359672
  }
  const bits = x.to_bits()
  // the mantissa, then the [1, 2) exponent bias (0x3FF)
  var m = Float64.from_bits((bits & 4503599627370495) | 4607182418800017408)
  var ex = ((bits >> 52) & 2047) - 1023
  if m > 1.4142135623730951 {
    m = m / 2.0
    ex = ex + 1
  }
  const z = (m - 1.0) / (m + 1.0)
  const z2 = z * z
  var term = z
  var sum = z
  for var i = 3; i <= 21; i = i + 2 {
    term = term * z2
    sum = sum + term / i.to_float64()
  }
  return ex.to_float64() * 0.6931471805599453 + 2.0 * sum
}

def log10(x Float64) Float64 {
  return log(x) * 0.4342944819032518
}

// log2 reuses log's decomposition, its exponent and mantissa, instead
// of dividing log(x) by ln 2: the exponent part answers alone, so every
// power of two — down through the subnormals — answers exactly.
def log2(x Float64) Float64 {
  if x <= 0.0 {
    raise Exception.new(message: "math: log2 of a non-positive value")
  }
  if x < Float64.from_bits(4503599627370496) {
    return log2(x * 1152921504606846976.0) - 60.0
  }
  const bits = x.to_bits()
  const m = Float64.from_bits((bits & 4503599627370495) | 4607182418800017408)
  const ex = ((bits >> 52) & 2047) - 1023
  if m > 1.4142135623730951 {
    return (ex + 1).to_float64() + log(m / 2.0) * 1.4426950408889634
  }
  return ex.to_float64() + log(m) * 1.4426950408889634
}

// ---- pow ----

// b^e through exp/log for a positive base. A zero base answers its
// limit; a negative base is out of this package's domain (Emo has no
// complex result).
def pow(base Float64, exponent Float64) Float64 {
  if base == 0.0 {
    if exponent > 0.0 {
      return 0.0
    }
    if exponent == 0.0 {
      return 1.0
    }
    raise Exception.new(message: "math: pow of zero to a negative exponent")
  }
  if base < 0.0 {
    raise Exception.new(message: "math: pow of a negative base")
  }
  return exp(exponent * log(base))
}

// ---- sin, cos, and tan ----

// The trigonometric functions, computed in internal/trig.emo: a
// split-π/2 range reduction exact up to |x| ≤ 2^20 — beyond it, and
// for a non-finite argument, the call raises — then fixed-order Taylor
// series over the reduced pair, byte-identical on every target. `tan`
// is the quotient of the two reduced series with the quadrant's sign
// and reciprocal switch; its poles are unreachable in binary floating
// point, so it has no domain raise.
def sin(x Float64) Float64 {
  return trig.sin(x)
}

def cos(x Float64) Float64 {
  return trig.cos(x)
}

def tan(x Float64) Float64 {
  return trig.tan(x)
}

// ---- atan and atan2 ----

// The inverse pair, computed in internal/trig.emo: the reciprocal
// identity above |x| = 1 and the tan(π/12) fold feed a fixed-order odd
// series, byte-identical on every target. `atan2` assembles the
// quadrant around `atan`; its axes are the signed zeros — each keeps
// its sign — and the origin, both arguments zero, raises: the one
// point where no angle exists.
def atan(x Float64) Float64 {
  return trig.atan(x)
}

def atan2(y Float64, x Float64) Float64 {
  return trig.atan2(y, x)
}

// ---- asin and acos ----

// The inverse pair on the unit circle, computed in internal/trig.emo
// through the same atan core: `asin(x)` is `atan(x / sqrt(1 − x²))`,
// switching to the complementary quotient as |x| nears one so the root
// is built from the exact factors (1 − x) and (1 + x) and does not
// cancel; `acos` shares that core. |x| > 1 raises, the package's
// domain rule.
def asin(x Float64) Float64 {
  return trig.asin(x)
}

def acos(x Float64) Float64 {
  return trig.acos(x)
}

// ---- complex ----

// The complex arithmetic, computed in internal/complex.emo: a value is
// a `(re, im)` pair of `Float64`, division goes by Smith's algorithm so
// the quotient cannot overflow, the magnitude takes the rescaled
// hypot, and the polar construction rides the package's own sin and
// cos — byte-identical on every target. A zero divisor raises.
def complex_add(z (Float64, Float64), w (Float64, Float64)) (Float64, Float64) {
  return complex.add(z, w)
}

def complex_sub(z (Float64, Float64), w (Float64, Float64)) (Float64, Float64) {
  return complex.sub(z, w)
}

def complex_mul(z (Float64, Float64), w (Float64, Float64)) (Float64, Float64) {
  return complex.mul(z, w)
}

def complex_div(z (Float64, Float64), w (Float64, Float64)) (Float64, Float64) {
  return complex.div(z, w)
}

def complex_abs(z (Float64, Float64)) Float64 {
  return complex.abs(z)
}

def complex_conj(z (Float64, Float64)) (Float64, Float64) {
  return complex.conj(z)
}

def complex_scale(z (Float64, Float64), f Float64) (Float64, Float64) {
  return complex.scale(z, f)
}

def complex_from_polar(r Float64, theta Float64) (Float64, Float64) {
  return complex.from_polar(r, theta)
}

// ---- sinh, cosh, and tanh ----

// The hyperbolic three are compositions over `exp`, so away from zero
// their accuracy is `exp`'s, whose range reduction rounds `k·ln 2`
// against a single-double constant and grows less exact as the
// argument grows; the T53.13 battery records that inheritance. `sinh`
// takes a short odd series below one half, where the difference
// `(e^x − e^−x)/2` would cancel; `cosh` only ever adds its two terms,
// so it needs no series. Overflow follows the `exp` rule: `sinh` and
// `cosh` raise once `e^x` leaves the exponent range, since beam's
// floats cannot hold infinity. `tanh` saturates to ±1 at |x| = 20 —
// the formula's distance from one is already below half an ulp there —
// so no argument reaches `exp`'s overflow on its way into the
// quotient.
def sinh(x Float64) Float64 {
  if (x.to_bits() & 9223372036854775807) == 0 {
    return x
  }
  if ((x.to_bits() >> 52) & 2047) == 2047 {
    raise Exception.new(message: "math: sinh of a non-finite value")
  }
  var a = x
  if a < 0.0 {
    a = 0.0 - a
  }
  var v = 0.0
  if a < 0.5 {
    const t = a * a
    var term = a
    var sum = a
    for var i = 3; i <= 15; i = i + 2 {
      term = term * t / (i - 1).to_float64() / i.to_float64()
      sum = sum + term
    }
    v = sum
  } else {
    v = (exp(a) - exp(0.0 - a)) / 2.0
  }
  if x < 0.0 {
    return 0.0 - v
  }
  return v
}

def cosh(x Float64) Float64 {
  if ((x.to_bits() >> 52) & 2047) == 2047 {
    raise Exception.new(message: "math: cosh of a non-finite value")
  }
  return (exp(x) + exp(0.0 - x)) / 2.0
}

def tanh(x Float64) Float64 {
  if (x.to_bits() & 9223372036854775807) == 0 {
    return x
  }
  if ((x.to_bits() >> 52) & 2047) == 2047 {
    raise Exception.new(message: "math: tanh of a non-finite value")
  }
  var a = x
  if a < 0.0 {
    a = 0.0 - a
  }
  if a >= 20.0 {
    if x > 0.0 {
      return 1.0
    }
    return 0.0 - 1.0
  }
  const v = sinh(a) / cosh(a)
  if x < 0.0 {
    return 0.0 - v
  }
  return v
}

// ---- native fast path (pinned to `c` and `ocaml`) ----

// The host libm, called directly. The names are separate from the pure
// functions above so a call site shows which one it means; these are
// not available on wasm, typescript, beam, or riscv64.
foreign def exp_native(x Float64) Float64 = "exp"
foreign def log_native(x Float64) Float64 = "log"
foreign def log10_native(x Float64) Float64 = "log10"
foreign def pow_native(base Float64, exponent Float64) Float64 = "pow"
