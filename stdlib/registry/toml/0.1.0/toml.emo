  def as_int() Int64 {
    return self.value
  }

  def as_float() Float64 {
    raise Exception.new(message: "toml: expected a number, got an integer")
  }

  def as_string() String {
    raise Exception.new(message: "toml: expected a string, got an integer")
  }

  def as_datetime() TomlDateTime {
    raise Exception.new(message: "toml: expected a date-time, got an integer")
  }

  def items() Array[Toml] {
    raise Exception.new(message: "toml: expected an array, got an integer")
  }

  def entries() Array[(String, Toml)] {
    raise Exception.new(message: "toml: expected a table, got an integer")
  }

  def get(key String) Toml {
    raise Exception.new(message: "toml: expected a table, got an integer")
  }
}

class TomlFloat {
  def init(value Float64) {
    self.value = value
  }

  def kind() TomlKind {
    return TomlKind.tfloat
  }

  def encode() String {
    return float.to_text(self.value)
  }

  def as_bool() Bool {
    raise Exception.new(message: "toml: expected true or false, got a number")
  }

  def as_int() Int64 {
    raise Exception.new(message: "toml: expected an integer, got a number")
  }

  def as_float() Float64 {
    return self.value
  }

  def as_string() String {
    raise Exception.new(message: "toml: expected a string, got a number")
  }

  def as_datetime() TomlDateTime {
    raise Exception.new(message: "toml: expected a date-time, got a number")
  }

