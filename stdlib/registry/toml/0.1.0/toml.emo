require "float"

// The toml package: decode and encode TOML 1.1.0 into a Toml value
// tree that mirrors the json and yaml packages' design — one
// interface, one class per kind, scalar accessors raising on a kind
// mismatch, containers read through `is()` into the concrete class.
// Pure Emo over the shared runtimes; the float package carries the
// exact-decimal conversion.
//
// Supported: the full 1.1 surface — bare, quoted, and dotted keys;
// all four string forms, the `\e` and `\xHH` escapes included;
// decimal, hex, octal, and binary integers with underscores; floats;
// all four date-time forms (seconds omittable, lowercase `t` and
// `z` allowed as RFC 3339 permits, leap second 60); arrays with
// trailing commas; inline tables across lines with trailing commas;
// tables and arrays of tables, with the strict redefinition rules
// between them (a dotted key's table never reopens under a header,
// an inline table never grows, `[[x]]` appends only to arrays).
//
// Not supported (each answers `(R.error, reason)` from `decode`):
// the `inf` and `nan` float spellings — no target that lacks
// non-finite values can carry one — and integers outside Int64.
// Fraction seconds keep nine digits (nanoseconds); the spec requires
// further digits be truncated, and they are. The document decodes
// into one root table whose entries ride in document order. Encode
// gives the document form — each table's scalar lines first, then its
// `[a.b]` and `[[a.b]]` sections, the one order a table's own text
// cannot express being a scalar after its sub-table's section.

enum TomlKind { tbool, tint, tfloat, tstring, tdatetime, tarray, ttable }

enum TomlDateTimeKind { toffset, tlocal_datetime, tlocal_date, tlocal_time }

// The accessors live on the interface, so a payload is one call away
// without asking what it is: the scalar `as_*` accessors answer with
// the payload or raise on a kind mismatch, and `get` reads a table's
// value (every kind answers — the non-tables raise). Container
// traversal beyond `get` — `items`, `entries` — stays on the concrete
// classes behind `is()` narrowing.
interface Toml {
  def kind() TomlKind
  def as_bool() Bool
  def as_int() Int64
  def as_float() Float64
  def as_string() String
  def as_datetime() TomlDateTime
  def encode() String
  def get(key String) Toml
}

// One TOML date-time: the four forms share the fields, and
// `datetime_kind` says which ones mean anything — `tlocal_date`
// leaves the clock at zero, `tlocal_time` leaves the date at zero,
// and `offset_minutes` rides only on `toffset` (0 for `Z`, east
// positive, west negative).
class TomlDateTime {
  def init(kind TomlDateTimeKind, year Int64, month Int64, day Int64, hour Int64, minute Int64, second Int64, nanosecond Int64, offset_minutes Int64) {
    self.tkind = kind
    self.tyear = year
    self.tmonth = month
    self.tday = day
    self.thour = hour
    self.tminute = minute
    self.tsecond = second
    self.tnanosecond = nanosecond
    self.toffset = offset_minutes
  }

  def datetime_kind() TomlDateTimeKind {
    return self.tkind
  }

  def year() Int64 {
    return self.tyear
  }

  def month() Int64 {
    return self.tmonth
  }

  def day() Int64 {
    return self.tday
  }

  def hour() Int64 {
    return self.thour
  }

  def minute() Int64 {
    return self.tminute
  }

  def second() Int64 {
    return self.tsecond
  }

  def nanosecond() Int64 {
    return self.tnanosecond
  }

  def offset_minutes() Int64 {
    return self.toffset
  }

  // The tree's own surface: a date-time is one Toml kind, so the
  // interface's scalar accessors all raise here, `as_datetime` hands
  // the payload back, and `encode` is the canonical text.
  def kind() TomlKind {
    return TomlKind.tdatetime
  }

  def encode() String {
    return self.to_text()
  }

  def as_bool() Bool {
    raise Exception.new(message: "toml: expected true or false, got a date-time")
  }

  def as_int() Int64 {
    raise Exception.new(message: "toml: expected an integer, got a date-time")
  }

  def as_float() Float64 {
    raise Exception.new(message: "toml: expected a number, got a date-time")
  }

  def as_string() String {
    raise Exception.new(message: "toml: expected a string, got a date-time")
  }

  def as_datetime() TomlDateTime {
    return self
  }

  def items() Array[Toml] {
    raise Exception.new(message: "toml: expected an array, got a date-time")
  }

  def entries() Array[(String, Toml)] {
    raise Exception.new(message: "toml: expected a table, got a date-time")
  }

  def get(key String) Toml {
    raise Exception.new(message: "toml: expected a table, got a date-time")
  }

  // The canonical text: full seconds, the `T` delimiter for the
  // date-time forms, `Z` or `±hh:mm`, and a fraction only when the
  // nanoseconds are nonzero — three, six, or nine digits, the
  // trailing zeros trimmed, so `decode` reads it back to the same
  // fields.
  def to_text() String {
    const head = four_digits(self.tyear) + "-" + two_digits(self.tmonth) + "-" + two_digits(self.tday)
    if self.tkind == TomlDateTimeKind.tlocal_date {
      return head
    }
    const clock = two_digits(self.thour) + ":" + two_digits(self.tminute) + ":" + two_digits(self.tsecond)
    const frac = ns_text(self.tnanosecond)
    if self.tkind == TomlDateTimeKind.tlocal_time {
      return clock + frac
    }
    if self.tkind == TomlDateTimeKind.tlocal_datetime {
      return head + "T" + clock + frac
    }
    return head + "T" + clock + frac + offset_text(self.toffset)
  }
}

class TomlBool {
  def init(value Bool) {
    self.value = value
  }

  def kind() TomlKind {
    return TomlKind.tbool
  }

  def encode() String {
    if self.value {
      return "true"
    }
    return "false"
  }

  def as_bool() Bool {
    return self.value
  }

  def as_int() Int64 {
    raise Exception.new(message: "toml: expected an integer, got true or false")
  }

  def as_float() Float64 {
    raise Exception.new(message: "toml: expected a number, got true or false")
  }

  def as_string() String {
    raise Exception.new(message: "toml: expected a string, got true or false")
  }

  def as_datetime() TomlDateTime {
    raise Exception.new(message: "toml: expected a date-time, got true or false")
  }

  def items() Array[Toml] {
    raise Exception.new(message: "toml: expected an array, got true or false")
  }

  def entries() Array[(String, Toml)] {
    raise Exception.new(message: "toml: expected a table, got true or false")
  }

  def get(key String) Toml {
    raise Exception.new(message: "toml: expected a table, got true or false")
  }
}

