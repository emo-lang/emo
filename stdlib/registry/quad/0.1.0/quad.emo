// The QUADPACK integrator: globally adaptive quadrature with
// extrapolation, vendored from netlib (f2c-translated, in `native/`)
// behind the one shape today's FFI admits — a scalar callback. The
// integrand is a single-method interface, so a class with an `at`
// method integrates directly, no wrapper: the callback contract carries
// it across the C ABI, the C shim owns the workspace (a fixed limit of
// 500 subintervals) and QUADPACK's stateless function pointer, and the
// raw (result, abserr, neval, ier) tuple comes back across the FFI.
//
// A convergence failure is a value, not a violation: `ier = 0` is
// `(R.ok, (value, abserr))` — the estimate and its error bound — and
// QUADPACK's failure codes answer `(R.error, reason)` in netlib's own
// wording, each reason saying what failed and what to try. A broken
// tolerance on a hard integral is an expected outcome of integration;
// the caller matches on the split and decides.
//
// The package is c-target only: the vendored Fortran translation and
// the shim are native code the build compiles and links, and the
// interpreter refuses foreign code (E3009), so `emo run` cannot execute
// a program that touches this package — build it with
// `emo build --target c`.
//
// The solver's own arithmetic is exact IEEE-754 per operation (the
// build compiles with `-ffp-contract=off`, the vendored code uses no
// transcendental function), so the subdivision walk lands on the same
// intervals on every host; the bits of an answer are the integrand's
// own arithmetic plus that walk. An integrand calling libm makes the
// answer host's — the same rule `fastmath` states.

// The integrand: the shape the callback contract carries across the
// C ABI. One method, one double in, one double out — a plain function,
// or a class instance carrying the parameters an `at` needs.
interface Integrand {
  def at(x Float64) Float64
}

// Integrates `f` over [a, b] to `max(epsabs, epsrel·|i|)` accuracy,
// QUADPACK's adaptive 21-point Gauss–Kronrod rule with the
// ε-algorithm extrapolating the error. The limit is the package's own
// fixed 500 subintervals; a harder integral answers its failure as a
// value instead of growing the workspace.
def integrate(f Integrand, a Float64, b Float64, epsabs Float64,
  epsrel Float64) (R, (Float64, Float64)) {
  const (result, abserr, neval, ier) = internal.ffi.integrate(a, b, epsabs,
    epsrel, f)
  if ier == 0 {
    return (R.ok, (result, abserr))
  }
  if ier == 1 {
    return (R.error, "quad: the maximum number of subdivisions (500) has been reached — split the interval at the difficulty and integrate the subranges")
  }
  if ier == 2 {
    return (R.error, "quad: roundoff error prevented the requested tolerance from being reached; the error may be underestimated")
  }
  if ier == 3 {
    return (R.error, "quad: extremely bad integrand behaviour at interior points of the integration interval")
  }
  if ier == 4 {
    return (R.error, "quad: the algorithm does not converge — roundoff error was detected in the extrapolation table, and the returned result is the best obtainable")
  }
  if ier == 5 {
    return (R.error, "quad: the integral is probably divergent, or slowly convergent")
  }
  if ier == 7 {
    return (R.error, "quad: an integrand called integrate again — nested integration is not supported")
  }
  return (R.error, "quad: the input is invalid — epsabs <= 0 and epsrel < max(50·machine epsilon, 0.5e-28)")
}
