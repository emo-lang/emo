// The host's math functions, bound directly to the platform `libm`.
//
// This is the performance tier of the numerical surface: the same
// signatures as `math`'s scalars, answered by the host library instead
// of the package's own series. A call is a plain per-call `libm` call
// — no reassociation, no relaxation — so it is fast, but the bits
// follow the host: they are not byte-identical across platforms.
// Programs that need reproducible bits require `math`; programs that
// need the speed require this package.
//
// There are no domain guards here. `math` raises on overflow because
// five-target byte-identity cannot produce infinity; this package
// returns whatever the host returns — infinity, NaN, a subnormal — and
// the caller filters its data.
//
// The package is pinned to `c` and `ocaml`, the two targets that bind
// a host symbol: a `require` on any other target fails at load (E5007),
// and under the interpreter a call raises E3009, which has no foreign
// implementation to bind.

// ---- constants ----

const e = 2.718281828459045
const pi = 3.141592653589793

// ---- the host libm ----

foreign def exp(x Float64) Float64 = "exp"
foreign def log(x Float64) Float64 = "log"
foreign def log10(x Float64) Float64 = "log10"
foreign def pow(base Float64, exponent Float64) Float64 = "pow"

// The trigonometric trio and its inverses, in `math`'s order. The
// domains are the host's: `asin` and `acos` of |x| > 1 return the
// host's NaN rather than raising.
foreign def sin(x Float64) Float64 = "sin"
foreign def cos(x Float64) Float64 = "cos"
foreign def tan(x Float64) Float64 = "tan"
foreign def asin(x Float64) Float64 = "asin"
foreign def acos(x Float64) Float64 = "acos"
foreign def atan(x Float64) Float64 = "atan"
foreign def atan2(y Float64, x Float64) Float64 = "atan2"

// The hyperbolic trio; the overflow of `sinh` and `cosh` returns the
// host's infinity rather than raising.
foreign def sinh(x Float64) Float64 = "sinh"
foreign def cosh(x Float64) Float64 = "cosh"
foreign def tanh(x Float64) Float64 = "tanh"

// The base-two pair and the overflow-safe hypotenuse; powers of two
// answer exactly.
foreign def exp2(x Float64) Float64 = "exp2"
foreign def log2(x Float64) Float64 = "log2"
foreign def hypot(a Float64, b Float64) Float64 = "hypot"

// The error function and its complement, each their own host symbol so
// the tail does not cancel.
foreign def erf(x Float64) Float64 = "erf"
foreign def erfc(x Float64) Float64 = "erfc"

// The gamma pair; the non-positive integers return the host's
// infinity and NaN rather than raising.
foreign def tgamma(x Float64) Float64 = "tgamma"
foreign def lgamma(x Float64) Float64 = "lgamma"
