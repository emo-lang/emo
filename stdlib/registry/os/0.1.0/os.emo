// The os module: the process-level surface a systems program needs —
// process ids, fork, exec, wait, pipes, descriptor plumbing, the
// environment, the signals, the working directory, directory listing,
// and raw (unbuffered, fd-based) file IO. Data-driven failures
// are values: the call returns `(R.ok, value)` or `(R.error, reason)`,
// the reason a string stating exactly which system call failed and why
// (`os: open /x: no such file...`) — no error codes, no nil.
//
// The module is POSIX: it runs on the ocaml and c targets, the targets
// with a Unix-shaped host. On the wasm target the fd, directory, and
// working-directory half runs — every call crosses to the host's own
// file system through the module's syscalls — while the process half
// (fork, exec, wait, pipe, the process ids, the descriptor plumbing,
// the environment, the signals, isatty, argv) raises when called: a
// WasmGC module has no process to fork. The browser and bytecode
// targets stay undeclared: declaring this package for them is a package
// error before any code runs.
//
// waitpid returns the kernel's raw 16-bit status word, decoded by the
// wait_* helpers below — the same encoding every Unix kernel uses, so
// the numbers survive unchanged across the ocaml and c targets. The
// wait_* decoders themselves are pure bit arithmetic and run everywhere
// the package resolves.

// The signal numbers a shell and its children live by. The classic
// Unix set, stable across the mac and the Linux kernels — the same
// numbers the wait_* decoders answer and signal_ignore / signal_default
// take.
const sig_hup = 1
const sig_int = 2
const sig_quit = 3
const sig_kill = 9
const sig_pipe = 13
const sig_term = 15

def getpid() Int64 {
  return os_getpid()
}

def getppid() Int64 {
  return os_getppid()
}

// The process environment, read-only: the one name asked for, or
// `(R.error, reason)` when the environment does not carry it — a
// missing name is expected data, not a failure to dress up.
def getenv(name String) (R, String) {
  return os_getenv(name)
}

// The pause: the milliseconds a caller waits, nanoseconds off the
// host's clock.
def sleep_ms(ms Int64) (R, Int64) {
  return os_sleep_ms(ms)
}

def fork() (R, Int64) {
  return os_fork()
}

def waitpid(pid Int64) (Int64, Int64) {
  return os_waitpid(pid)
}

// The child process half of waitpid: true when the child exited through
// exit or a return from main, false when it was signaled or stopped.
def wait_exited(status Int64) Bool {
  return (status & 127) == 0
}

// The exit status, valid only when wait_exited(status) is true.
def wait_exit_code(status Int64) Int64 {
  return (status >> 8) & 255
}

def wait_signaled(status Int64) Bool {
  return (status & 127) != 0
}

// The terminating signal number, valid only when wait_signaled(status) is true.
def wait_signal(status Int64) Int64 {
  return status & 127
}

def wait_stopped(status Int64) Bool {
  return (status & 127) == 127
}

// The stopping signal number, valid only when wait_stopped(status) is true.
def wait_stop_signal(status Int64) Int64 {
  return (status >> 8) & 255
}

// Sends sig to pid — a process id, or its negative for the whole process
// group with that id, the discipline a supervisor lives by: one call
// ends a group. The sig_* constants above are the numbers. An
// out-of-range signal refuses ahead of the call, the same fixed reason
// on every target.
def kill(pid Int64, sig Int64) (R, Int64) {
  return os_kill(pid, sig)
}

// Moves pid into the process group pgid (pgid 0 means pid's own). The
// fork child's first call — its own new group, made before the exec —
// is the discipline a shell lives by: the parent can then end the
// whole group with one kill of the negative pid.
def setpgid(pid Int64, pgid Int64) (R, Int64) {
  return os_setpgid(pid, pgid)
}

def pipe() (R, (Int64, Int64)) {
  return os_pipe()
}

// Replaces the calling process. argv[0] is conventionally the program
// name again; the list must end where the arguments end. On success this
// call never returns — the process is gone — and on failure it returns,
// the fork child's cue to `_exit` (a raise here would run the parent's
// cleanup a second time).
def execv(path String, argv Array[String]) Void {
  os_execv(path, argv)
}

// Replaces the calling process with `file`, searched through the PATH
// environment variable the way the shell's own lookup is (a file name
// with a slash in it is used as-is). argv[0] is conventionally the
// program name again; the list must end where the arguments end. On
// success this call never returns — the process is gone — and on
// failure it returns, the fork child's cue to `_exit` (a raise here
// would run the parent's cleanup a second time).
def execvp(file String, argv Array[String]) Void {
  os_execvp(file, argv)
}

// Copies old_fd onto new_fd, closing new_fd first if it was open — the
// plumbing a shell uses to point a child's stdin or stdout at a pipe
// end or a file before the exec.
def dup2(old_fd Int64, new_fd Int64) (R, Int64) {
  return os_dup2(old_fd, new_fd)
}

// Whether fd is attached to a terminal.
def isatty(fd Int64) Bool {
  return os_isatty(fd)
}

// The process's own argument vector, argv[0] the name the process was
// started with.
def argv() Array[String] {
  return os_argv()
}

// The environment: unset is a value like every other data-driven
// failure — (R.error, `os: getenv NAME: is not set`).
def getenv(name String) (R, String) {
  return os_getenv(name)
}

// Sets or replaces name in this process's environment; the fork child
// inherits it across the exec.
def setenv(name String, value String) (R, Int64) {
  return os_setenv(name, value)
}

def unsetenv(name String) (R, Int64) {
  return os_unsetenv(name)
}

// The discipline a shell lives by: ignore a signal in the shell's own
// process, restore the default in the fork child before the exec. A
// disposition of ignored survives the exec — that is why the child
// undoes it — a handler's does not.
def signal_ignore(sig Int64) (R, Int64) {
  return os_signal_ignore(sig)
}

def signal_default(sig Int64) (R, Int64) {
  return os_signal_default(sig)
}

// Exits immediately without unwinding — the fork child's way out. Ordinary
// cleanup such as flush handlers does not run, which is exactly what makes
// a forked child safe: it cannot run its parent's cleanup a second time.
def _exit(status Int64) Void {
  os__exit(status)
}

def open_read(path String) (R, Int64) {
  return os_open_read(path)
}

def open_write(path String) (R, Int64) {
  return os_open_write(path)
}

def open_append(path String) (R, Int64) {
  return os_open_append(path)
}

// Reads up to n bytes; the empty string means end of file.
def read(fd Int64, n Int64) (R, String) {
  return os_read(fd, n)
}

def write(fd Int64, data String) (R, Int64) {
  return os_write(fd, data)
}

def close(fd Int64) (R, Int64) {
  return os_close(fd)
}

// The entry names of a directory, byte-order sorted, excluding "." and "..".
def list_dir(path String) (R, Array[String]) {
  return os_list_dir(path)
}

def mkdir(path String) (R, Int64) {
  return os_mkdir(path)
}

def rmdir(path String) (R, Int64) {
  return os_rmdir(path)
}

def unlink(path String) (R, Int64) {
  return os_unlink(path)
}

def rename(old_path String, new_path String) (R, Int64) {
  return os_rename(old_path, new_path)
}

def getcwd() String {
  return os_getcwd()
}

def chdir(path String) (R, Int64) {
  return os_chdir(path)
}
