require "time"

// The wasi fixture (T77.4): hand-built modules riding the preview1
// host — the iovec walk byte-exact, proc_exit's code on the trap
// channel, the argv encoding, the clock answering (realtime inside
// the host's own wall bracket, the monotonic pair never going back),
// the honest refusals (EBADF, an unknown clock id), the mistyped
// import binding to nothing, and the unimplemented function failing
// the link with its name.

const hello_hex = "0061736d01000000010c0260047f7f7f7f017f60000002230116776173695f736e617073686f745f70726576696577310866645f7772697465000003020101050301000107060102676f00010a11010f00410141c000410141c80010001a0b0b1c020041100b08686920776173690a0041c0000b081000000008000000"
const exit3_hex = "0061736d0100000001080260017f0060000002240116776173695f736e617073686f745f70726576696577310970726f635f65786974000003020101050301000107060102676f00010a08010600410310000b"
const args_hex = "0061736d01000000010a0260027f7f017f600000024b0216776173695f736e617073686f745f70726576696577310e617267735f73697a65735f676574000016776173695f736e617073686f745f707265766965773108617267735f676574000003020101050301000107060102676f00020a1601140041c00041c80010001a41d00041e00010011a0b"
const ebadf_hex = "0061736d01000000010d0260047f7f7f7f017f6000017f02230116776173695f736e617073686f745f70726576696577310866645f7772697465000003020101050301000107060102676f00010a10010e00410541c000410041c80010000b"
const clock_hex = "0061736d01000000010c0260037f7e7f017f6000017f02290116776173695f736e617073686f745f70726576696577310e636c6f636b5f74696d655f676574000003020101050301000107060102676f00010a0d010b004100420041c00010000b"
const mono_hex = "0061736d01000000010c0260037f7e7f017f6000017f02290116776173695f736e617073686f745f70726576696577310e636c6f636b5f74696d655f676574000003020101050301000107060102676f00010a170115004101420041c00010001a4101420041c80010000b"
const badid_hex = "0061736d01000000010c0260037f7e7f017f6000017f02290116776173695f736e617073686f745f70726576696577310e636c6f636b5f74696d655f676574000003020101050301000107060102676f00010a0d010b004102420041c00010000b"
const badptr_hex = "0061736d01000000010c0260037f7e7f017f6000017f02290116776173695f736e617073686f745f70726576696577310e636c6f636b5f74696d655f676574000003020101050301000107060102676f00010a0e010c00410042004180800410000b"
const prestat_hex = ""
const openread_hex = ""
const writefile_hex = ""
const escape_hex = "0061736d0100000001120260097f7f7f7f7f7e7e7f7f017f6000017f02240116776173695f736e617073686f745f707265766965773109706174685f6f70656e000003020101050301000107060102676f00010a1a0118004103410041c000410a410042024200410041c00110000b0b11010041c0000b0a2e2e2f6f757473696465"
const seekpipe_hex = "0061736d01000000010d0260047f7e7f7f017f6000017f02220116776173695f736e617073686f745f70726576696577310766645f7365656b000003020101050301000107060102676f00010a0f010d0041014200410041c00010000b"
const pathopen_hex = "0061736d01000000010d0260057f7f7f7f7f017f60000002250116776173695f736e617073686f745f70726576696577310a66645f72656164646972000003020101050301000107060102676f00010a040102000b"
const random_hex = "0061736d01000000010b0260027f7f017f6000017f02250116776173695f736e617073686f745f70726576696577310a72616e646f6d5f676574000003020101050301000107060102676f00010a0b01090041c000411010000b"
const fdstat_hex = "0061736d01000000010b0260027f7f017f6000017f02280116776173695f736e617073686f745f70726576696577310d66645f6664737461745f676574000003020101050301000107060102676f00010a0b010900410141c00010000b"
const mistyped_hex = "0061736d0100000001080260017f0060000002230116776173695f736e617073686f745f70726576696577310866645f7772697465000003020101050301000107060102676f00010a040102000b"

def load_hex(hex String) Int64 {
  case wasm.load(internal.corpus.decode_hex(hex)) {
    (R.error, why) then {
      println("load " + why)
      return -1
    }
    (R.ok, module) then {
      return module
    }
  }
}

def call_go(module Int64) (R, Array[(Int64, Int64)]) {
  case wasm.instantiate(module, []) {
    (R.error, why) then {
      return (R.error, [])
    }
    (R.ok, inst) then {
      return wasm.call(inst, "go", [])
    }
  }
}

def errno_of(r (R, Array[(Int64, Int64)])) Int64 {
  case r {
    (R.error, why) then {
      println(why)
      return 0 - 1
    }
    (R.ok, results) then {
      case wasm.as_i32(results[0]) {
        (R.error, why) then {
          println(why)
          return 0 - 1
        }
        (R.ok, v) then {
          return v
        }
      }
    }
  }
}

def errno_value(results Array[(Int64, Int64)]) Int64 {
  case wasm.as_i32(results[0]) {
    (R.error, why) then {
      println(why)
      return 0 - 1
    }
    (R.ok, v) then {
      return v
    }
  }
}

def yesno(b Bool) String {
  if b {
    return "yes"
  }
  return "no"
}

// The sandbox's directory: an existing one is the normal second-run
// shape, so the mkdir verdict goes either way.
def ensure_dir(path String) Int64 {
  case os_mkdir(path) {
    (R.error, _) then {
      return 0
    }
    (R.ok, _) then {
      return 0
    }
  }
}

def run() Int64 {
  var failed = 0

  // The iovec walk: the guest's bytes ride the output channel raw,
  // and nwritten lands at 72.
  const hello = load_hex(hello_hex)
  case wasm.instantiate(hello, []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, _) then {
          case wasm.read_memory(inst, 72, 4) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, data) then {
              println("written " + data.get_u32_le(0).to_string())
            }
          }
        }
      }
    }
  }

  // proc_exit rides the trap channel with its code.
  case call_go(load_hex(exit3_hex)) {
    (R.error, why) then {
      println("exit " + why)
    }
    (R.ok, _) then {
      println("exit returned")
      failed = failed + 1
    }
  }

  // The argv channel: sizes, then the encoding (pointers, then the
  // nul-terminated buffer), read back through the package's own
  // memory door.
  wasm.set_wasi_args(["prog", "-x"])
  const args = load_hex(args_hex)
  case wasm.instantiate(args, []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, _) then {
          case wasm.read_memory(inst, 64, 4) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, counts) then {
              println("argc " + counts.get_u32_le(0).to_string())
            }
          }
          case wasm.read_memory(inst, 72, 4) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, counts) then {
              println("buf " + counts.get_u32_le(0).to_string())
            }
          }
          case wasm.read_memory(inst, 80, 8) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, ptrs) then {
              const p0 = ptrs.get_u32_le(0)
              case wasm.read_memory(inst, p0, 5) {
                (R.error, why) then {
                  println("read " + why)
                  failed = failed + 1
                }
                (R.ok, arg0) then {
                  println("arg0 " + arg0.to_string())
                }
              }
            }
          }
        }
      }
    }
  }
  wasm.set_wasi_args([])

  // The honest refusal: a closed fd's EBADF.
  println("ebadf " + errno_of(call_go(load_hex(ebadf_hex))).to_string())

  // The file half (step 87). Before any grant, the open answers EBADF
  // — no grant, no file system.
  println("noopen " + errno_of(call_go(load_hex(escape_hex))).to_string())

  // The sandbox the fixture grants: one directory, two files, built
  // through the os doors themselves.
  ensure_dir(".emo-deps-cache")
  const root = ".emo-deps-cache/wasi-files"
  ensure_dir(root)
  case os_open_write(root + "/note.txt") {
    (R.error, why) then {
      println("mknote " + why)
      failed = failed + 1
    }
    (R.ok, fd) then {
      case os_write(fd, "hello wasi") {
        (R.error, why) then {
          println("wrnote " + why)
          failed = failed + 1
        }
        (R.ok, _) then {}
      }
      case os_close(fd) {
        (R.error, why) then {
          println("clnote " + why)
          failed = failed + 1
        }
        (R.ok, _) then {}
      }
    }
  }
  wasm.set_wasi_preopens([("/", root)])

  // Discovery: the preopen's shape answer and its guest name.
  case wasm.instantiate(load_hex(prestat_hex), []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          const errno = errno_value(results)
          if errno != 0 {
            failed = failed + 1
          }
          case wasm.read_memory(inst, 68, 4) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, nl) then {
              const n = nl.get_u32_le(0)
              println("prestat " + errno.to_string() + " namelen " + n.to_string())
              case wasm.read_memory(inst, 96, n) {
                (R.error, why) then {
                  println("read " + why)
                  failed = failed + 1
                }
                (R.ok, name) then {
                  println("prename " + name.to_string())
                }
              }
            }
          }
        }
      }
    }
  }

  // Open, read, seek, close: the module's exports share its one table
  // slot, the guest's bytes pinned at every step.
  case wasm.instantiate(load_hex(openread_hex), []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("open " + errno_value(results).to_string())
        }
      }
      case wasm.read_memory(inst, 192, 4) {
        (R.error, why) then {
          println("read " + why)
          failed = failed + 1
        }
        (R.ok, slot) then {
          println("guestfd " + slot.get_u32_le(0).to_string())
        }
      }
      case wasm.call(inst, "read", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("read " + errno_value(results).to_string())
        }
      }
      case wasm.read_memory(inst, 200, 4) {
        (R.error, why) then {
          println("read " + why)
          failed = failed + 1
        }
        (R.ok, nr) then {
          println("nread " + nr.get_u32_le(0).to_string())
        }
      }
      case wasm.read_memory(inst, 128, 10) {
        (R.error, why) then {
          println("read " + why)
          failed = failed + 1
        }
        (R.ok, data) then {
          println("data " + data.to_string())
        }
      }
      case wasm.call(inst, "seek", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("seek " + errno_value(results).to_string())
        }
      }
      case wasm.read_memory(inst, 208, 8) {
        (R.error, why) then {
          println("read " + why)
          failed = failed + 1
        }
        (R.ok, pos) then {
          const at = pos.get_u32_le(4) * 4294967296 + pos.get_u32_le(0)
          println("pos " + at.to_string())
        }
      }
      case wasm.call(inst, "close", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("close " + errno_value(results).to_string())
        }
      }
    }
  }

  // Create-write: CREAT|TRUNC through the write door, then the bytes
  // read back through the fixture's own doors.
  case wasm.instantiate(load_hex(writefile_hex), []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("write " + errno_value(results).to_string())
        }
      }
      case wasm.call(inst, "put", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("put " + errno_value(results).to_string())
        }
      }
      case wasm.call(inst, "off", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          println("wclose " + errno_value(results).to_string())
        }
      }
    }
  }
  case os_open_read(root + "/hello.txt") {
    (R.error, why) then {
      println("reread " + why)
      failed = failed + 1
    }
    (R.ok, fd) then {
      case os_read(fd, 8) {
        (R.error, why) then {
          println("reread " + why)
          failed = failed + 1
        }
        (R.ok, text) then {
          println("content " + text)
        }
      }
      case os_close(fd) {
        (R.error, why) then {
          println("recl " + why)
          failed = failed + 1
        }
        (R.ok, _) then {}
      }
    }
  }

  // The corrected fd_seek import shape links, and the tty answers the
  // wasip1.h ESPIPE — 70, not the drifted 69.
  println("seekpipe " + errno_of(call_go(load_hex(seekpipe_hex))).to_string())

  // The escape: ".." past the root is ENOTCAPABLE.
  println("escape " + errno_of(call_go(load_hex(escape_hex))).to_string())

  wasm.set_wasi_preopens([])

  // The sandbox goes away with the probe.
  os_unlink(root + "/note.txt")
  os_unlink(root + "/hello.txt")
  os_rmdir(root)

  // The clock answers. Realtime must sit inside the host's own wall
  // bracket — a time.now() reading taken before the call and one taken
  // after — and the monotonic pair must never go back, the first
  // reading positive. Both shapes ride the fixture's own doors; the
  // timestamps themselves are not pinned, the way the entropy is not.
  const before = time.now().unix_ms()
  case wasm.instantiate(load_hex(clock_hex), []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          const after = time.now().unix_ms()
          case wasm.read_memory(inst, 64, 8) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, data) then {
              const nanos = data.get_u32_le(4) * 4294967296 + data.get_u32_le(0)
              const ok = nanos >= before * 1000000 && nanos <= after * 1000000
              println("clock-realtime " + errno_value(results).to_string() + " bracket " + yesno(ok))
              if !ok {
                failed = failed + 1
              }
            }
          }
        }
      }
    }
  }

  case wasm.instantiate(load_hex(mono_hex), []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, results) then {
          case wasm.read_memory(inst, 64, 16) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, data) then {
              const first = data.get_u32_le(4) * 4294967296 + data.get_u32_le(0)
              const second = data.get_u32_le(12) * 4294967296 + data.get_u32_le(8)
              const ok = first > 0 && second >= first
              println("clock-mono " + errno_value(results).to_string() + " nondecreasing " + yesno(ok))
              if !ok {
                failed = failed + 1
              }
            }
          }
        }
      }
    }
  }

  println("clock-badid " + errno_of(call_go(load_hex(badid_hex))).to_string())
  println("clock-badptr " + errno_of(call_go(load_hex(badptr_hex))).to_string())

  // random_get answers success; the entropy itself is not pinned.
  println("random " + errno_of(call_go(load_hex(random_hex))).to_string())

  // fd 1 is a character device with full rights.
  const fdstat_module = load_hex(fdstat_hex)
  case wasm.instantiate(fdstat_module, []) {
    (R.error, why) then {
      println("inst " + why)
      failed = failed + 1
    }
    (R.ok, inst) then {
      case wasm.call(inst, "go", []) {
        (R.error, why) then {
          println("go " + why)
          failed = failed + 1
        }
        (R.ok, _) then {
          case wasm.read_memory(inst, 64, 24) {
            (R.error, why) then {
              println("read " + why)
              failed = failed + 1
            }
            (R.ok, st) then {
              println("filetype " + st.get(0).to_string())
            }
          }
        }
      }
    }
  }

  // The unimplemented function fails the link with its name.
  case wasm.instantiate(load_hex(pathopen_hex), []) {
    (R.error, why) then {
      println("path " + why)
    }
    (R.ok, _) then {
      println("path instantiated")
      failed = failed + 1
    }
  }

  // The mistyped import binds to nothing.
  case wasm.instantiate(load_hex(mistyped_hex), []) {
    (R.error, why) then {
      println("type " + why)
    }
    (R.ok, _) then {
      println("type instantiated")
      failed = failed + 1
    }
  }

  println("failed " + failed.to_string())
  return failed
}

run()
