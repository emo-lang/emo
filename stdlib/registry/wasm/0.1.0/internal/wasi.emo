require "rand"
require "time"

// The wasi_snapshot_preview1 host (step 77): the preview1 functions a
// real toolchain's module touches to start, print, seed its hashes,
// read the clock, and — since step 87 — open, read, write, seek, and
// close files inside a granted directory. Everything else in the
// namespace link-refuses with the function's name — no silent stubs,
// no fakes. The errno values are the preview1 numbering (wasip1.h);
// the fixture pins them.
//
// `dispatch` runs inside execution, where the caller instance's
// linear memory is live: it takes memory 0 and the instance's argv as
// parameters (the machine state belongs to `internal.instance`, which
// owns the walk), answers (errno, signal), and mutates the guest
// memory in place. The signal carries proc_exit's verdict to the trap
// channel; "" is the normal answer. A guest pointer that runs out of
// bounds is the guest's mistake and answers EINVAL, not a raise.
//
// The file half (step 87) is the os package's own POSIX semantics
// projected onto preview1: the preopen table is the grant (no default
// — the wasmtime posture, no grant means no file system), path_open
// resolves lexically inside a preopen's root (a climb past the root is
// ENOTCAPABLE), and every open rides one os door — open_read,
// open_write (create + truncate, the stdio "w" shape), or open_append.
// The doors' only failure channel is the reason text, so the errnos a
// real module acts on (no entry, is-a-directory, illegal seek) match
// their shared normalized phrases and the rest answers EIO.

const e_success = 0
const e_io = 29
const e_badf = 8
const e_inval = 28
const e_exist = 20
const e_isdir = 31
const e_nametoolong = 37
const e_noent = 44
const e_nosys = 52
const e_notdir = 54
const e_notempty = 55
const e_perm = 63
const e_spipe = 70
const e_xdev = 75
const e_notcapable = 76

const f_args_sizes_get = 0
const f_args_get = 1
const f_environ_sizes_get = 2
const f_environ_get = 3
const f_proc_exit = 4
const f_fd_write = 5
const f_fd_close = 6
const f_fd_seek = 7
const f_fd_fdstat_get = 8
const f_random_get = 9
const f_clock_time_get = 10
const f_sched_yield = 11
const f_prestat_get = 12
const f_prestat_dir_name = 13
const f_path_open = 14
const f_fd_read = 15
const f_fd_readdir = 16
const f_fd_filestat_get = 17
const f_path_filestat_get = 18
const f_path_create_directory = 19
const f_path_remove_directory = 20
const f_path_unlink_file = 21
const f_path_rename = 22

const max_random = 1048576

// The preopen table: (guest name, host path) pairs granted through
// `set_preopens` before instantiate. Empty by default — the operator's
// grant is the whole file system, the wasmtime posture.
var preopens = []

// The fd table: slot = guest fd - 3. fds 0/1/2 are stdio and never sit
// here; the grants land first (in order), then the opens. An entry is
// (kind, host_fd, guest name, host path, confinement root, fdflags):
// kind 1 a preopen directory (no host fd — the grant is a name
// mapping; host and root are the same path), kind 2 an opened file,
// kind 3 an opened directory (host its path, root the grant it came
// from); kind -1 the hole a close left.
var fds = []

// The grants: replaces the table and drops every fd the previous
// grants produced — a new grant is a new file system. Each grant
// materializes as the preopen directory's own fd, the discovery
// walk's subject.
def set_preopens(entries Array[(String, String)]) Int64 {
  preopens = entries
  fds = grant_entries(entries, 0, [])
  return 0
}

def grant_entries(entries Array[(String, String)], i Int64, acc Array[(Int64, Int64, String, String, String, Int64)]) Array[(Int64, Int64, String, String, String, Int64)] {
  if i >= entries.length() {
    return acc
  }
  return grant_entries(entries, i + 1, acc.append((1, 0 - 1, entries[i][0], entries[i][1], entries[i][1], 0)))
}

// The fresh-run reset: `internal.instance.reset_all` calls this beside
// its own state clears.
def clear_wasi_files() Int64 {
  preopens = []
  fds = []
  return 0
}

// The namespace's id table: -1 for a name this rung does not serve,
// which the link turns into a refusal naming the function.
def func_id(name String) Int64 {
  if name == "args_sizes_get" {
    return f_args_sizes_get
  }
  if name == "args_get" {
    return f_args_get
  }
  if name == "environ_sizes_get" {
    return f_environ_sizes_get
  }
  if name == "environ_get" {
    return f_environ_get
  }
  if name == "proc_exit" {
    return f_proc_exit
  }
  if name == "fd_write" {
    return f_fd_write
  }
  if name == "fd_close" {
    return f_fd_close
  }
  if name == "fd_seek" {
    return f_fd_seek
  }
  if name == "fd_fdstat_get" {
    return f_fd_fdstat_get
  }
  if name == "random_get" {
    return f_random_get
  }
  if name == "clock_time_get" {
    return f_clock_time_get
  }
  if name == "sched_yield" {
    return f_sched_yield
  }
  if name == "fd_prestat_get" {
    return f_prestat_get
  }
  if name == "fd_prestat_dir_name" {
    return f_prestat_dir_name
  }
  if name == "path_open" {
    return f_path_open
  }
  if name == "fd_read" {
    return f_fd_read
  }
  if name == "fd_readdir" {
    return f_fd_readdir
  }
  if name == "fd_filestat_get" {
    return f_fd_filestat_get
  }
  if name == "path_filestat_get" {
    return f_path_filestat_get
  }
  if name == "path_create_directory" {
    return f_path_create_directory
  }
  if name == "path_remove_directory" {
    return f_path_remove_directory
  }
  if name == "path_unlink_file" {
    return f_path_unlink_file
  }
  if name == "path_rename" {
    return f_path_rename
  }
  return 0 - 1
}

// Every preview1 parameter is an i32 save the i64 widths: the clock's
// precision, fd_seek's offset, and path_open's two rights masks. The
// import check compares these against the import's declared type, so a
// mistyped import binds to nothing.
def params_ok(id Int64, kinds Array[Int64], i Int64) Bool {
  if i >= kinds.length() {
    return true
  }
  var want = 127
  if id == f_clock_time_get && i == 1 {
    want = 126
  }
  if id == f_fd_seek && i == 1 {
    want = 126
  }
  if id == f_path_open && (i == 5 || i == 6) {
    want = 126
  }
  if id == f_fd_readdir && i == 3 {
    want = 126
  }
  if kinds[i] != want {
    return false
  }
  return params_ok(id, kinds, i + 1)
}

def param_count(id Int64) Int64 {
  if id == f_args_sizes_get {
    return 2
  }
  if id == f_args_get {
    return 2
  }
  if id == f_environ_sizes_get {
    return 2
  }
  if id == f_environ_get {
    return 2
  }
  if id == f_proc_exit {
    return 1
  }
  if id == f_fd_write {
    return 4
  }
  if id == f_fd_close {
    return 1
  }
  if id == f_fd_seek {
    return 4
  }
  if id == f_fd_fdstat_get {
    return 2
  }
  if id == f_random_get {
    return 2
  }
  if id == f_clock_time_get {
    return 3
  }
  if id == f_prestat_get {
    return 2
  }
  if id == f_prestat_dir_name {
    return 3
  }
  if id == f_path_open {
    return 9
  }
  if id == f_fd_read {
    return 4
  }
  if id == f_fd_readdir {
    return 5
  }
  if id == f_fd_filestat_get {
    return 2
  }
  if id == f_path_filestat_get {
    return 5
  }
  if id == f_path_create_directory {
    return 3
  }
  if id == f_path_remove_directory {
    return 3
  }
  if id == f_path_unlink_file {
    return 3
  }
  if id == f_path_rename {
    return 6
  }
  return 0
}

def result_count(id Int64) Int64 {
  if id == f_proc_exit {
    return 0
  }
  return 1
}

// ---- the dispatch ----

def dispatch(id Int64, args Array[(Int64, Int64)], mem (Box[Bytes], Int64, Bool), argv Array[String]) (Int64, String) {
  if id == f_proc_exit {
    return (e_success, "emo-wasm: proc_exit(" + internal.value.sign32(args[0][1]).to_string() + ")")
  }
  if id == f_sched_yield {
    return (e_success, "")
  }
  if id == f_args_sizes_get {
    return (args_sizes(mem, argv, args), "")
  }
  if id == f_args_get {
    return (args_get(mem, argv, args), "")
  }
  if id == f_environ_sizes_get {
    if store_u32(mem, args[0][1], 0)[0] && store_u32(mem, args[1][1], 0)[0] {
      return (e_success, "")
    }
    return (e_inval, "")
  }
  if id == f_environ_get {
    return (e_success, "")
  }
  if id == f_fd_write {
    return (fd_write(mem, args), "")
  }
  if id == f_fd_close {
    return (fd_close(mem, args), "")
  }
  if id == f_fd_seek {
    return (fd_seek(mem, args), "")
  }
  if id == f_fd_fdstat_get {
    return (fdstat(mem, args), "")
  }
  if id == f_random_get {
    return (random_get(mem, args), "")
  }
  if id == f_clock_time_get {
    return (clock_time_get(mem, args), "")
  }
  if id == f_prestat_get {
    return (prestat_get(mem, args), "")
  }
  if id == f_prestat_dir_name {
    return (prestat_dir_name(mem, args), "")
  }
  if id == f_path_open {
    return (path_open(mem, args), "")
  }
  if id == f_fd_read {
    return (fd_read(mem, args), "")
  }
  if id == f_fd_readdir {
    return (fd_readdir(mem, args), "")
  }
  if id == f_fd_filestat_get {
    return (fd_filestat_get(mem, args), "")
  }
  if id == f_path_filestat_get {
    return (path_filestat_get(mem, args), "")
  }
  if id == f_path_create_directory {
    return (path_create_directory(mem, args), "")
  }
  if id == f_path_remove_directory {
    return (path_remove_directory(mem, args), "")
  }
  if id == f_path_unlink_file {
    return (path_unlink_file(mem, args), "")
  }
  if id == f_path_rename {
    return (path_rename(mem, args), "")
  }
  return (e_nosys, "")
}

// ---- the memory io ----

def store_u32(mem (Box[Bytes], Int64, Bool), addr Int64, bits Int64) (Bool, String) {
  return internal.store.mem_store(mem, addr, 0, 4, bits)
}

def store_u64(mem (Box[Bytes], Int64, Bool), addr Int64, bits Int64) (Bool, String) {
  return internal.store.mem_store(mem, addr, 0, 8, bits)
}

def load_u32(mem (Box[Bytes], Int64, Bool), addr Int64) (Bool, Int64) {
  const r = internal.store.mem_load(mem, addr, 0, 4, false)
  return (r[0], r[1])
}

// A guest-reachable range check for one copy of `n` bytes at `addr`.
def range_ok(mem (Box[Bytes], Int64, Bool), addr Int64, n Int64) Bool {
  const b = internal.store.mem_bytes(mem)
  const a = internal.value.mask32(addr)
  if n < 0 || a > b.length() || n > b.length() - a {
    return false
  }
  return true
}

def write_bytes(mem (Box[Bytes], Int64, Bool), addr Int64, data Bytes) Bool {
  const n = data.length()
  if !range_ok(mem, addr, n) {
    return false
  }
  internal.store.copy_bytes(internal.store.mem_bytes(mem), data, internal.value.mask32(addr), n)
  return true
}

def copy_out(b Bytes, at Int64, n Int64) Bytes {
  const out = Bytes.new(n)
  var i = 0
  while i < n {
    out.set(i, b.get(at + i))
    i = i + 1
  }
  return out
}

// The argv sizes answer: argc, then the buffer's byte count — one nul
// past every argument's own bytes.
def argv_buf_size(argv Array[String], i Int64, acc Int64) Int64 {
  if i >= argv.length() {
    return acc
  }
  return argv_buf_size(argv, i + 1, acc + argv[i].to_bytes().length() + 1)
}

def args_sizes(mem (Box[Bytes], Int64, Bool), argv Array[String], args Array[(Int64, Int64)]) Int64 {
  if !store_u32(mem, args[0][1], argv.length())[0] {
    return e_inval
  }
  if !store_u32(mem, args[1][1], argv_buf_size(argv, 0, 0))[0] {
    return e_inval
  }
  return e_success
}

def args_get(mem (Box[Bytes], Int64, Bool), argv Array[String], args Array[(Int64, Int64)]) Int64 {
  const nul = Bytes.new(1)
  var cursor = args[1][1]
  var i = 0
  while i < argv.length() {
    const data = argv[i].to_bytes()
    if !store_u32(mem, args[0][1] + i * 4, cursor)[0] {
      return e_inval
    }
    if !write_bytes(mem, cursor, data) {
      return e_inval
    }
    if !write_bytes(mem, cursor + data.length(), nul) {
      return e_inval
    }
    cursor = cursor + data.length() + 1
    i = i + 1
  }
  return e_success
}

// ---- the fd table ----

// The fd's entry: (ok, entry). fds 0/1/2 answer stdio without a table
// slot; the slot is fd - 3. A closed hole or a slot past the table is
// not-ok, and every caller answers EBADF on it.
def fd_entry(fd Int64) (Bool, (Int64, Int64, String, String, String, Int64)) {
  if fd == 0 || fd == 1 || fd == 2 {
    return (true, (0, fd, "", "", "", 0))
  }
  const slot = fd - 3
  if slot < 0 || slot >= fds.length() {
    return (false, (0 - 1, 0 - 1, "", "", "", 0))
  }
  const e = fds[slot]
  if e[0] < 0 {
    return (false, e)
  }
  return (true, e)
}

// The lowest free slot: a close's hole first, else the table grows.
def fd_alloc() Int64 {
  var i = 0
  while i < fds.length() {
    if fds[i][0] < 0 {
      return i + 3
    }
    i = i + 1
  }
  fds = fds.append((0 - 1, 0 - 1, "", "", "", 0))
  return i + 3
}

def fd_put(slot Int64, e (Int64, Int64, String, String, String, Int64)) Int64 {
  fds[slot] = e
  return 0
}

// ---- the iovec walk ----

// The iovecs' total buffer length: (ok, bytes). A negative length is
// the guest's mistake.
def iov_sizes(mem (Box[Bytes], Int64, Bool), iovs Int64, count Int64) (Bool, Int64) {
  var total = 0
  var i = 0
  while i < count {
    const l = load_u32(mem, iovs + i * 8 + 4)
    if !l[0] {
      return (false, 0)
    }
    const len = internal.value.sign32(l[1])
    if len < 0 {
      return (false, 0)
    }
    total = total + len
    i = i + 1
  }
  return (true, total)
}

// The iovec walk writing through the process output channel: fds 1
// and 2, the fixture-pinned shape from step 77 — the guest's bytes
// raw, no newline translation.
def fd_write_tty(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const iovs = args[1][1]
  const count = internal.value.sign32(args[2][1])
  if count < 0 {
    return e_inval
  }
  var total = 0
  var out = ""
  var i = 0
  while i < count {
    const base = iovs + i * 8
    const p = load_u32(mem, base)
    if !p[0] {
      return e_inval
    }
    const l = load_u32(mem, base + 4)
    if !l[0] {
      return e_inval
    }
    const len = internal.value.sign32(l[1])
    if len < 0 || !range_ok(mem, p[1], len) {
      return e_inval
    }
    const b = internal.store.mem_bytes(mem)
    const chunk = copy_out(b, internal.value.mask32(p[1]), len)
    out = out + chunk.to_string()
    total = total + len
    i = i + 1
  }
  if !store_u32(mem, args[3][1], total)[0] {
    return e_inval
  }
  if total > 0 {
    printf("%s", [out])
  }
  return e_success
}

// The iovec walk at its `{buf_ptr u32, buf_len u32}` pairs, gathered
// in order. fds 1 and 2 stay the raw output channel; a preopen
// directory answers EISDIR; an opened file writes through the os
// door, one iovec per call, the counts summed into `nwritten`.
def fd_write(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  if fd == 1 || fd == 2 {
    return fd_write_tty(mem, args)
  }
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] == 1 {
    return e_isdir
  }
  if e[1][0] == 0 {
    return e_badf
  }
  const iovs = args[1][1]
  const count = internal.value.sign32(args[2][1])
  if count < 0 {
    return e_inval
  }
  var total = 0
  var i = 0
  while i < count {
    const base = iovs + i * 8
    const p = load_u32(mem, base)
    if !p[0] {
      return e_inval
    }
    const l = load_u32(mem, base + 4)
    if !l[0] {
      return e_inval
    }
    const len = internal.value.sign32(l[1])
    if len < 0 || !range_ok(mem, p[1], len) {
      return e_inval
    }
    if len > 0 {
      const b = internal.store.mem_bytes(mem)
      const chunk = copy_out(b, internal.value.mask32(p[1]), len)
      case os_write(e[1][1], chunk.to_string()) {
        (R.error, _) then {
          return e_io
        }
        (R.ok, _) then {
          total = total + len
        }
      }
    }
    i = i + 1
  }
  if !store_u32(mem, args[3][1], total)[0] {
    return e_inval
  }
  return e_success
}

// The read: one os door call at the iovecs' total length, the bytes
// scattered back in order. An empty vector answers nread 0 without
// the call; a preopen directory answers EISDIR; fds 1 and 2 are write
// ends and answer EBADF; fd 0 reads the process's stdin.
def fd_read(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] == 1 {
    return e_isdir
  }
  if fd == 1 || fd == 2 {
    return e_badf
  }
  const iovs = args[1][1]
  const count = internal.value.sign32(args[2][1])
  if count < 0 {
    return e_inval
  }
  const sizes = iov_sizes(mem, iovs, count)
  if !sizes[0] {
    return e_inval
  }
  if sizes[1] == 0 {
    if !store_u32(mem, args[3][1], 0)[0] {
      return e_inval
    }
    return e_success
  }
  case os_read(e[1][1], sizes[1]) {
    (R.error, why) then {
      return read_errno(why)
    }
    (R.ok, text) then {
      const data = text.to_bytes()
      if !scatter(mem, iovs, count, data) {
        return e_inval
      }
      if !store_u32(mem, args[3][1], data.length())[0] {
        return e_inval
      }
      return e_success
    }
  }
}

// The scatter: the read lands across the iovecs in order, each
// clipping at its own length.
def scatter(mem (Box[Bytes], Int64, Bool), iovs Int64, count Int64, data Bytes) Bool {
  var at = 0
  var i = 0
  while i < count {
    if at >= data.length() {
      return true
    }
    const base = iovs + i * 8
    const p = load_u32(mem, base)
    if !p[0] {
      return false
    }
    const l = load_u32(mem, base + 4)
    if !l[0] {
      return false
    }
    const len = internal.value.sign32(l[1])
    var take = data.length() - at
    if take > len {
      take = len
    }
    if !write_bytes(mem, p[1], sub_bytes(data, at, take)) {
      return false
    }
    at = at + take
    i = i + 1
  }
  return true
}

def sub_bytes(data Bytes, at Int64, n Int64) Bytes {
  const out = Bytes.new(n)
  var i = 0
  while i < n {
    out.set(i, data.get(at + i))
    i = i + 1
  }
  return out
}

// The close: stdio answers success; a preopen's slot holes out (the
// grant is a name mapping, there is no host fd to release); an opened
// file rides the os door, its verdict going the way of the slot — the
// fd is gone from the guest's view either way.
def fd_close(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  if fd == 0 || fd == 1 || fd == 2 {
    return e_success
  }
  const slot = fd - 3
  if slot < 0 || slot >= fds.length() {
    return e_badf
  }
  const e = fds[slot]
  if e[0] < 0 {
    return e_badf
  }
  if e[0] == 2 {
    os_close(e[1])
  }
  fd_put(slot, (0 - 1, 0 - 1, "", "", "", 0))
  return e_success
}

// The seek: whence 0/1/2, the os door on an opened file; stdio and
// the preopens answer ESPIPE (70 — the wasip1.h number; the table's
// two drifted values were corrected at this ring).
def fd_seek(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  const whence = internal.value.sign32(args[2][1])
  if whence < 0 || whence > 2 {
    return e_inval
  }
  if e[1][0] != 2 {
    return e_spipe
  }
  case os_lseek(e[1][1], args[1][1], whence) {
    (R.error, why) then {
      return read_errno(why)
    }
    (R.ok, at) then {
      if !store_u64(mem, args[3][1], at)[0] {
        return e_inval
      }
      return e_success
    }
  }
}

// The fdstat answer: the filetype byte plus the fdflags' append bit at
// +0/+2, the two full rights words at +8/+16 — full rights the trust
// posture the grant already took. fds 0/1/2 are character devices,
// preopens directories, opens regular files.
def fdstat(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  var ftype = 2
  var flags = 0
  if e[1][0] == 1 {
    ftype = 3
  }
  if e[1][0] == 2 {
    ftype = 4
    flags = e[1][5] & 1
  }
  if !store_u32(mem, args[1][1], ftype + flags * 65536)[0] {
    return e_inval
  }
  if !store_u64(mem, args[1][1] + 8, 0 - 1)[0] {
    return e_inval
  }
  if !store_u64(mem, args[1][1] + 16, 0 - 1)[0] {
    return e_inval
  }
  return e_success
}

// OS entropy through the rand package: what Rust's RandomState asks
// for at initialization even in a hello world. A length past 1 MiB is
// this rung's documented cap, answered EINVAL.
def random_get(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const len = internal.value.sign32(args[1][1])
  if len < 0 || len > max_random {
    return e_inval
  }
  case rand.bytes(len) {
    (R.error, _) then {
      return e_io
    }
    (R.ok, data) then {
      if !write_bytes(mem, args[0][1], data) {
        return e_inval
      }
      return e_success
    }
  }
}

// The clock: realtime is the wall door's epoch milliseconds scaled to
// nanoseconds — the door's own resolution, the last six digits zero,
// which the precision parameter exists to name — and monotonic is the
// nanosecond reading as it stands. An unknown clock id (the cpu clocks
// among them — the doors carry no process time) is the guest's
// mistake and answers EINVAL, like a result pointer out of bounds.
def clock_time_get(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const clock = internal.value.sign32(args[0][1])
  if clock != 0 && clock != 1 {
    return e_inval
  }
  var nanos = 0
  if clock == 0 {
    nanos = time.now().unix_ms() * 1000000
  }
  if clock == 1 {
    nanos = time.mono()
  }
  if !store_u64(mem, args[2][1], nanos)[0] {
    return e_inval
  }
  return e_success
}

// ---- the preopen discovery ----

// prestat_get: the preopen table's shape answer — `{pr_type u8 = 0,
// pr_name_len u32}` at the guest's pointer. A valid fd that is not a
// preopen answers ENOTDIR, the walk-stopper wasi-libc reads.
def prestat_get(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] != 1 {
    return e_notdir
  }
  const n = e[1][2].to_bytes().length()
  if !store_u32(mem, args[1][1], 0)[0] {
    return e_inval
  }
  if !store_u32(mem, args[1][1] + 4, n)[0] {
    return e_inval
  }
  return e_success
}

// prestat_dir_name: the preopen's guest name, whole or ENAMETOOLONG.
def prestat_dir_name(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] != 1 {
    return e_notdir
  }
  const name = e[1][2].to_bytes()
  const len = internal.value.sign32(args[2][1])
  if len < name.length() {
    return e_nametoolong
  }
  if !write_bytes(mem, args[1][1], name) {
    return e_inval
  }
  return e_success
}

// ---- the open ----

// The open: the guest's path inside a directory fd's tree. dirfd must
// be directory-class — a preopen or an opened directory (std io and
// opened files answer ENOTDIR); the path may name the preopen's guest
// prefix ("/data/x" under "data") or ride as the tail relative to it
// ("x") — the root preopen ("/") takes both. The walk is lexical, "."
// and "" skip, ".." pops, and a pop past the grant's root is the
// escape: ENOTCAPABLE. An absolute path under no preopen is the same
// refusal. The doors serve one direction per open — read-only, write
// (create + truncate, the stdio "w" shape: the CREAT and TRUNC oflags
// land on it), or append (the APPEND fdflag) — so a two-direction
// open, the EXCL oflag, a truncating read, an append without write,
// and any fdflags bit past APPEND all refuse EINVAL. The DIRECTORY
// oflag opens the directory itself — a stat before the open answers
// ENOTDIR for a file — read-only, and such fds list through
// fd_readdir.
def path_open(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const dirfd = internal.value.sign32(args[0][1])
  const e = fd_entry(dirfd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] != 1 {
    return e_notdir
  }
  const plen = internal.value.sign32(args[3][1])
  if plen < 0 || !range_ok(mem, args[2][1], plen) {
    return e_inval
  }
  const b = internal.store.mem_bytes(mem)
  const path = copy_out(b, internal.value.mask32(args[2][1]), plen).to_string()
  const oflags = internal.value.sign32(args[4][1])
  const rights = args[5][1]
  const fdflags = internal.value.sign32(args[7][1])
  if (oflags & (0 - 16)) != 0 {
    return e_inval
  }
  if (fdflags & (0 - 2)) != 0 {
    return e_inval
  }
  if (oflags & 4) != 0 {
    return e_inval
  }
  const want_read = (rights & 2) != 0
  const want_write = (rights & 64) != 0
  if want_read && want_write {
    return e_inval
  }
  if !want_read && !want_write {
    return e_inval
  }
  if want_read && (oflags & 9) != 0 {
    return e_inval
  }
  const append = (fdflags & 1) != 0
  if append && !want_write {
    return e_inval
  }
  const dir_open = (oflags & 2) != 0
  if dir_open {
    if !want_read || append || (oflags & 9) != 0 {
      return e_inval
    }
  }
  const r = resolve_under(e, path)
  if r[0] != 0 {
    return r[0]
  }
  const host = r[1]
  if dir_open {
    case os_stat(host) {
      (R.error, why) then {
        return open_errno(why)
      }
      (R.ok, st) then {
        if st[0] != 1 {
          return e_notdir
        }
      }
    }
  }
  var hfd = 0 - 1
  if append {
    case os_open_append(host) {
      (R.error, why) then {
        return open_errno(why)
      }
      (R.ok, v) then {
        hfd = v
      }
    }
  } else {
    if want_write {
      case os_open_write(host) {
        (R.error, why) then {
          return open_errno(why)
        }
        (R.ok, v) then {
          hfd = v
        }
      }
    } else {
      case os_open_read(host) {
        (R.error, why) then {
          return open_errno(why)
        }
        (R.ok, v) then {
          hfd = v
        }
      }
    }
  }
  const gfd = fd_alloc()
  var kind = 2
  if dir_open {
    kind = 3
  }
  fd_put(gfd - 3, (kind, hfd, "", host, e[1][4], fdflags))
  if !store_u32(mem, args[8][1], gfd)[0] {
    return e_inval
  }
  return e_success
}

// The lexical walk: "." and empty components skip, ".." pops — a pop
// at or below the floor is the escape — anything else pushes. The
// seed is the base path's own components; the floor is the grant
// root's depth. (escaped, stack)
def walk_comps(comps Array[String], i Int64, floor Int64, stack Array[String]) (Bool, Array[String]) {
  if i >= comps.length() {
    return (false, stack)
  }
  const c = comps[i]
  if c == "" || c == "." {
    return walk_comps(comps, i + 1, floor, stack)
  }
  if c == ".." {
    if stack.length() <= floor {
      return (true, stack)
    }
    return walk_comps(comps, i + 1, floor, drop_last(stack, 0, []))
  }
  return walk_comps(comps, i + 1, floor, stack.append(c))
}

def drop_last(xs Array[String], i Int64, acc Array[String]) Array[String] {
  if i >= xs.length() - 1 {
    return acc
  }
  return drop_last(xs, i + 1, acc.append(xs[i]))
}

// The path components a path string carries, "" skipped — the seed a
// walk starts from and the measure a floor counts.
def comps_of(parts Array[String], i Int64, acc Array[String]) Array[String] {
  if i >= parts.length() {
    return acc
  }
  if parts[i] == "" {
    return comps_of(parts, i + 1, acc)
  }
  return comps_of(parts, i + 1, acc.append(parts[i]))
}

// The resolution every directory-class fd shares: the guest's path
// against the fd's own base, confined by the grant root the fd
// carries. Preopens keep the guest-prefix strip ("/data/x" and "x"
// both land); an opened directory takes the tail only, an absolute
// path under it being the escape. The root itself resolves to the
// fd's base. (errno, host path — errno 0 is ok)
def resolve_under(e (Bool, (Int64, Int64, String, String, String, Int64)), path String) (Int64, String) {
  if !e[0] {
    return (e_badf, "")
  }
  if e[1][0] != 1 && e[1][0] != 3 {
    return (e_notdir, "")
  }
  const base = e[1][3]
  const floor = comps_of(e[1][4].split("/"), 0, []).length()
  var rel = path
  if e[1][0] == 1 {
    if rel.starts_with("/") {
      if e[1][2] == "/" {
        rel = rel.substring(1, rel.length() - 1)
      } else {
        if rel == e[1][2] {
          rel = ""
        } else {
          const gpre = e[1][2] + "/"
          if rel.starts_with(gpre) {
            rel = rel.substring(gpre.length(), rel.length() - gpre.length())
          } else {
            return (e_notcapable, "")
          }
        }
      }
    }
  } else {
    if rel.starts_with("/") {
      return (e_notcapable, "")
    }
  }
  if rel == "" {
    return (e_inval, "")
  }
  const w = walk_comps(rel.split("/"), 0, floor, comps_of(base.split("/"), 0, []))
  if w[0] {
    return (e_notcapable, "")
  }
  if w[1].length() == 0 {
    return (0, base)
  }
  var host = ""
  var j = 0
  while j < w[1].length() {
    if j > 0 {
      host = host + "/"
    }
    host = host + w[1][j]
    j = j + 1
  }
  return (0, host)
}

// The guest's path out of linear memory: (errno, text) — EINVAL when
// the length is negative or the range runs out.
def guest_path(mem (Box[Bytes], Int64, Bool), ptr Int64, len Int64) (Int64, String) {
  if len < 0 || !range_ok(mem, ptr, len) {
    return (e_inval, "")
  }
  const b = internal.store.mem_bytes(mem)
  return (0, copy_out(b, internal.value.mask32(ptr), len).to_string())
}

// ---- the listing and the stats (step 88) ----

// The read of a directory: the fd's entries, sorted, as 24-byte
// dirents (d_next, d_ino 0, d_namlen, d_type UNKNOWN) with the name
// riding after, whole entries only — what fits the buffer lands, and
// the caller's cookie (the d_next it saw last, 0 to start) says where
// this call resumes. Stateless: the sorted list is walked fresh every
// call. A file fd answers ENOTDIR.
def fd_readdir(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] != 1 && e[1][0] != 3 {
    return e_notdir
  }
  const buf = args[1][1]
  const cap = internal.value.sign32(args[2][1])
  if cap < 0 || !range_ok(mem, buf, cap) {
    return e_inval
  }
  const cookie = args[3][1]
  case os_list_dir(e[1][3]) {
    (R.error, why) then {
      return read_errno(why)
    }
    (R.ok, names) then {
      if cookie < 0 || cookie >= names.length() {
        if !store_u32(mem, args[4][1], 0)[0] {
          return e_inval
        }
        return e_success
      }
      var pos = 0
      var idx = cookie
      while idx < names.length() {
        const nb = names[idx].to_bytes()
        const need = 24 + nb.length()
        if pos + need > cap {
          break
        }
        const head = Bytes.new(24)
        var k = 0
        while k < 24 {
          head.set(k, 0)
          k = k + 1
        }
        var v = idx + 1
        k = 0
        while k < 8 {
          head.set(k, v & 255)
          v = v >> 8
          k = k + 1
        }
        v = nb.length()
        k = 16
        while k < 20 {
          head.set(k, v & 255)
          v = v >> 8
          k = k + 1
        }
        if !write_bytes(mem, buf + pos, head) {
          return e_inval
        }
        if !write_bytes(mem, buf + pos + 24, nb) {
          return e_inval
        }
        pos = pos + need
        idx = idx + 1
      }
      if !store_u32(mem, args[4][1], pos)[0] {
        return e_inval
      }
      return e_success
    }
  }
}

// The 64-byte filestat: filetype u8 and the fdflags' append bit at
// +0/+2, the size at +8, and the three times (the wall door's
// millisecond resolution scaled to nanoseconds) at +16/+24/+32.
def write_filestat(mem (Box[Bytes], Int64, Bool), at Int64, ftype Int64, flags Int64, size Int64, atime Int64, mtime Int64, ctime Int64) Int64 {
  if !store_u32(mem, at, ftype + flags * 65536)[0] {
    return e_inval
  }
  if !store_u64(mem, at + 8, size)[0] {
    return e_inval
  }
  if !store_u64(mem, at + 16, atime * 1000000)[0] {
    return e_inval
  }
  if !store_u64(mem, at + 24, mtime * 1000000)[0] {
    return e_inval
  }
  if !store_u64(mem, at + 32, ctime * 1000000)[0] {
    return e_inval
  }
  return e_success
}

// The fd's stat: stdio answers character device with no size and no
// times; everything else stats the host path the fd carries — an
// fd whose file was unlinked after the open answers the miss.
def fd_filestat_get(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const fd = internal.value.sign32(args[0][1])
  const e = fd_entry(fd)
  if !e[0] {
    return e_badf
  }
  if e[1][0] == 0 {
    return write_filestat(mem, args[1][1], 2, 0, 0, 0, 0, 0)
  }
  case os_stat(e[1][3]) {
    (R.error, why) then {
      return open_errno(why)
    }
    (R.ok, st) then {
      var ftype = 4
      if st[0] == 1 {
        ftype = 3
      }
      return write_filestat(mem, args[1][1], ftype, e[1][5] & 1, st[1], st[2], st[3], st[4])
    }
  }
}

// The stat by path, resolved under the dirfd like every path call.
// The lookupflags' symlink-follow bit is required — the doors carry
// no lstat, so a no-follow lookup refuses EINVAL rather than follow
// silently.
def path_filestat_get(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const e = fd_entry(internal.value.sign32(args[0][1]))
  const flags = internal.value.sign32(args[1][1])
  if (flags & 1) == 0 {
    return e_inval
  }
  const p = guest_path(mem, args[2][1], internal.value.sign32(args[3][1]))
  if p[0] != 0 {
    return p[0]
  }
  const r = resolve_under(e, p[1])
  if r[0] != 0 {
    return r[0]
  }
  case os_stat(r[1]) {
    (R.error, why) then {
      return open_errno(why)
    }
    (R.ok, st) then {
      var ftype = 4
      if st[0] == 1 {
        ftype = 3
      }
      return write_filestat(mem, args[4][1], ftype, 0, st[1], st[2], st[3], st[4])
    }
  }
}

// ---- the mutations (step 88) ----

// Create the directory: the os door at the resolved path.
def path_create_directory(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const e = fd_entry(internal.value.sign32(args[0][1]))
  const p = guest_path(mem, args[1][1], internal.value.sign32(args[2][1]))
  if p[0] != 0 {
    return p[0]
  }
  const r = resolve_under(e, p[1])
  if r[0] != 0 {
    return r[0]
  }
  case os_mkdir(r[1]) {
    (R.error, why) then {
      return mut_errno(why)
    }
    (R.ok, _) then {
      return e_success
    }
  }
}

// Remove the directory: empty only, the door's own verdict.
def path_remove_directory(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const e = fd_entry(internal.value.sign32(args[0][1]))
  const p = guest_path(mem, args[1][1], internal.value.sign32(args[2][1]))
  if p[0] != 0 {
    return p[0]
  }
  const r = resolve_under(e, p[1])
  if r[0] != 0 {
    return r[0]
  }
  case os_rmdir(r[1]) {
    (R.error, why) then {
      return mut_errno(why)
    }
    (R.ok, _) then {
      return e_success
    }
  }
}

// Unlink the file: the os door; a directory answers the errno the
// host's unlink names (EISDIR or EPERM, per platform — both in the
// map).
def path_unlink_file(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const e = fd_entry(internal.value.sign32(args[0][1]))
  const p = guest_path(mem, args[1][1], internal.value.sign32(args[2][1]))
  if p[0] != 0 {
    return p[0]
  }
  const r = resolve_under(e, p[1])
  if r[0] != 0 {
    return r[0]
  }
  case os_unlink(r[1]) {
    (R.error, why) then {
      return mut_errno(why)
    }
    (R.ok, _) then {
      return e_success
    }
  }
}

// The rename: both sides resolve under their own dirfds, one os door
// between them — same file system is the door's own contract, a
// crossing answering EXDEV.
def path_rename(mem (Box[Bytes], Int64, Bool), args Array[(Int64, Int64)]) Int64 {
  const oe = fd_entry(internal.value.sign32(args[0][1]))
  const p1 = guest_path(mem, args[1][1], internal.value.sign32(args[2][1]))
  if p1[0] != 0 {
    return p1[0]
  }
  const r1 = resolve_under(oe, p1[1])
  if r1[0] != 0 {
    return r1[0]
  }
  const ne = fd_entry(internal.value.sign32(args[3][1]))
  const p2 = guest_path(mem, args[4][1], internal.value.sign32(args[5][1]))
  if p2[0] != 0 {
    return p2[0]
  }
  const r2 = resolve_under(ne, p2[1])
  if r2[0] != 0 {
    return r2[0]
  }
  case os_rename(r1[1], r2[1]) {
    (R.error, why) then {
      return mut_errno(why)
    }
    (R.ok, _) then {
      return e_success
    }
  }
}

// ---- the os doors' failure channel ----

// The doors answer `(R.error, reason)` and the reason's only machine
// content is the shared normalized text both runtimes print ("os:
// open <path>: <strerror>"). The branches a real module acts on match
// their phrases; everything else answers EIO.
def open_errno(why String) Int64 {
  if why.index_of("No such file or directory") >= 0 {
    return e_noent
  }
  if why.index_of("Is a directory") >= 0 {
    return e_isdir
  }
  return e_io
}

def read_errno(why String) Int64 {
  if why.index_of("Is a directory") >= 0 {
    return e_isdir
  }
  if why.index_of("Not a directory") >= 0 {
    return e_notdir
  }
  if why.index_of("Illegal seek") >= 0 {
    return e_spipe
  }
  return e_io
}

// The mutations' map: the phrases a create/remove/unlink/rename miss
// carries, the branches a real module acts on.
def mut_errno(why String) Int64 {
  if why.index_of("File exists") >= 0 {
    return e_exist
  }
  if why.index_of("No such file or directory") >= 0 {
    return e_noent
  }
  if why.index_of("Directory not empty") >= 0 {
    return e_notempty
  }
  if why.index_of("Not a directory") >= 0 {
    return e_notdir
  }
  if why.index_of("Is a directory") >= 0 {
    return e_isdir
  }
  if why.index_of("Cross-device link") >= 0 {
    return e_xdev
  }
  if why.index_of("Operation not permitted") >= 0 {
    return e_perm
  }
  return e_io
}
