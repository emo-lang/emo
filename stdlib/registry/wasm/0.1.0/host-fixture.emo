// The spectest host fixture (T22.9), riding the step-72 public
// surface: a module imports the host's print functions, typed globals,
// table, and memory; the built-in host serves them behind the same
// import path the explicit table takes second.

const hex = ""

def show_i32(label String, r (R, Array[(Int64, Int64)])) Int64 {
  case r {
    (R.error, why) then {
      println(label + " " + why)
      return 1
    }
    (R.ok, results) then {
      case wasm.as_i32(results[0]) {
        (R.error, why) then {
          println(label + " " + why)
          return 1
        }
        (R.ok, v) then {
          println(label + " " + v.to_string())
          return 0
        }
      }
    }
  }
}

def run() Int64 {
  var failed = 0
  case wasm.load(internal.corpus.decode_hex(hex)) {
    (R.error, why) then {
      println("load " + why)
      failed = failed + 1
    }
    (R.ok, module) then {
      case wasm.instantiate(module, []) {
        (R.error, why) then {
          println("inst " + why)
          failed = failed + 1
        }
        (R.ok, inst) then {
          println("inst true ")
          failed = failed + show_i32("use", wasm.call(inst, "use", []))
          failed = failed + show_i32("mem", wasm.call(inst, "mem_size", []))
          failed = failed + show_i32("tab", wasm.call(inst, "tab_size", []))
        }
      }
    }
  }
  println("failed " + failed.to_string())
  return failed
}

run()
