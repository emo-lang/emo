// The core networking library: TCP, UDP, Unix-domain sockets, DNS, and
// TLS, running directly on the scheduler. Every blocking operation is a
// suspension point, and every data-driven failure — a refused
// connection, an unresolvable name, an exceeded deadline, a closed
// socket — is the value (R.error, reason) stating exactly what failed;
// only the caller's own mistakes raise. No error codes, no nil.

def resolve(host String) (R, Array[String]) {
  return net_resolve(host)
}

def connect(host String, port Int64, timeout Float64) (R, TcpConn) {
  return net_connect(host, port, timeout)
}

def listen(host String, port Int64) (R, TcpListener) {
  return net_listen(host, port)
}

def connect_unix(path String, timeout Float64) (R, TcpConn) {
  return net_connect_unix(path, timeout)
}

def listen_unix(path String) (R, TcpListener) {
  return net_listen_unix(path)
}

def tls_connect(host String, port Int64, timeout Float64) (R, TcpConn) {
  return net_tls_connect(host, port, timeout)
}

def tls_connect_insecure(host String, port Int64, timeout Float64) (R, TcpConn) {
  return net_tls_connect_insecure(host, port, timeout)
}

def listen_tls(host String, port Int64, cert_path String, key_path String) (R, TcpListener) {
  return net_listen_tls(host, port, cert_path, key_path)
}

def udp_bind(host String, port Int64) (R, UdpSocket) {
  return net_udp_bind(host, port)
}
