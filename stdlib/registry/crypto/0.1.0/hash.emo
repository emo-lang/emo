// The hash surface: the structural interface every hasher answers —
// `crypto.sha2`'s `Digest` and `Wide` satisfy it by shape, so a
// caller can hold any of them here — and HMAC (RFC 2104) over the
// SHA-2 family. Tags are raw bytes as String; compare them through
// `crypto.constant_time_compare`, never `==`.

interface Hash {
  def write(data String) Void
  def sum() String
  def reset() Void
  def size() Int64
  def block_size() Int64
}

// The HMAC-SHA-256 tag of data under key.
def hmac_sha256(key String, data String) String {
  return internal.hmac.hmac(1, 64, key, data)
}

// The HMAC-SHA-224 tag of data under key.
def hmac_sha224(key String, data String) String {
  return internal.hmac.hmac(2, 64, key, data)
}

// The HMAC-SHA-512 tag of data under key.
def hmac_sha512(key String, data String) String {
  return internal.hmac.hmac(3, 128, key, data)
}

// The HMAC-SHA-384 tag of data under key.
def hmac_sha384(key String, data String) String {
  return internal.hmac.hmac(4, 128, key, data)
}

// The HMAC-SHA-512/224 tag of data under key.
def hmac_sha512_224(key String, data String) String {
  return internal.hmac.hmac(5, 128, key, data)
}

// The HMAC-SHA-512/256 tag of data under key.
def hmac_sha512_256(key String, data String) String {
  return internal.hmac.hmac(6, 128, key, data)
}

// The HMAC-SHA-256 tag over bytes, as bytes — the door raw-byte
// callers ride (the deterministic stream in rand, and anyone whose
// key or message is not text), because a String cannot carry them on
// every target. Compare tags through crypto.constant_time_compare.
def hmac_sha256_bytes(key Bytes, data Bytes) Bytes {
  return internal.hmac.hmac_sha256_bytes(key, data)
}
