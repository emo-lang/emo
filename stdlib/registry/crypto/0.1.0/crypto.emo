// The crypto package: hashes, MACs, key derivation, AEAD ciphers, and
// signatures — the portable primitives layer beneath every protocol.
// Pure Emo over Int64 and Bytes, so every target answers with the
// same bytes; the RFC and NIST vectors pinned in the examples are the
// acceptance, with values generated by Go's own packages frozen
// alongside them.
//
// Bytes ride as String at this surface, the standard library's
// convention (os.read, bufio, base64), so keys, digests, and
// ciphertexts compose with file.read; the implementations work over
// Bytes internally.
//
// The error split is the standard library's: a caller's mistake — a
// wrong key length, a wrong nonce length, a zero iteration count —
// raises; a data reason — an authentication tag that does not verify
// — is the value `(R.error, reason)`, the reason beginning `crypto:`.
//
// The constant-time discipline is source-level: no branch and no
// table index depends on secret bytes. What each backend's emitted
// code adds to that guarantee is documented in docs/stdlib/crypto.md,
// per target, rather than overstated here.

// The constant-time byte-string equality the MACs verify through:
// the answer is the XOR-accumulated difference over every byte pair,
// so the comparison's shape does not depend on where the first
// difference sits. The lengths enter the same accumulator — length is
// not a secret here, and unequal lengths answer false.
def constant_time_compare(a String, b String) Bool {
  const left = a.to_bytes()
  const right = b.to_bytes()
  const ln = left.length()
  const rn = right.length()
  var diff = ln ^ rn
  var i = 0
  while i < ln && i < rn {
    diff = diff | (left.get(i) ^ right.get(i))
    i = i + 1
  }
  return diff == 0
}

// The lowercase hex rendering of bytes — two characters each, the
// form every digest is read and compared in.
def hex_encode(data String) String {
  const src = data.to_bytes()
  const n = src.length()
  const digits = "0123456789abcdef".to_bytes()
  const out = Bytes.new(n * 2)
  var i = 0
  while i < n {
    const b = src.get(i)
    out.set(i * 2, digits.get((b >> 4) & 0xF))
    out.set(i * 2 + 1, digits.get(b & 0xF))
    i = i + 1
  }
  return out.to_string()
}

// The strict inverse: an even number of characters, both cases of
// every hex digit accepted, and every other byte an
// `(R.error, reason)` naming its offset — the decoder accepts exactly
// what hex_encode produces and their case-insensitive kin, nothing
// else.
def hex_decode(text String) (R, String) {
  const src = text.to_bytes()
  const n = src.length()
  if n % 2 == 1 {
    return (R.error, "crypto: hex_decode odd length " + n.to_string())
  }
  const out = Bytes.new(n / 2)
  var i = 0
  while i < n {
    const hi = hex_nibble(src.get(i))
    if hi < 0 {
      return (R.error, "crypto: hex_decode expects a hex digit at byte " + i.to_string())
    }
    const lo = hex_nibble(src.get(i + 1))
    if lo < 0 {
      return (R.error, "crypto: hex_decode expects a hex digit at byte " + (i + 1).to_string())
    }
    out.set(i / 2, hi * 16 + lo)
    i = i + 2
  }
  return (R.ok, out.to_string())
}

// The digit's value 0–15, or −1 when the byte is not a hex digit at
// all.
def hex_nibble(b Int64) Int64 {
  if b >= 48 && b <= 57 {
    return b - 48
  }
  if b >= 97 && b <= 102 {
    return b - 87
  }
  if b >= 65 && b <= 70 {
    return b - 55
  }
  return 0 - 1
}
