// The KDF engine: HKDF's expand step (RFC 5869 §2.3) and PBKDF2's
// iterated block (RFC 8018 §5.2), both riding internal.hmac's
// one-shots — the dependency stays one-way (kdf → hmac → sha2; module
// cycles are refused). The variant rides a code the caller names
// (1 sha256 … 6 sha512_256) beside its hash length and HMAC block
// width.

// n zero bytes, the shape HKDF's absent salt takes.
def zeros(n Int64) String {
  return Bytes.new(n).to_string()
}

// The one-byte string, HKDF's expansion counter.
def one_byte(v Int64) String {
  const b = Bytes.new(1)
  b.set(0, v)
  return b.to_string()
}

// The block index as four big-endian bytes, PBKDF2's INT (i).
def int32_be(v Int64) String {
  const b = Bytes.new(4)
  internal.word.store_u32_be(b, 0, v)
  return b.to_string()
}

// The bytewise XOR of two equal-length strings, PBKDF2's accumulator
// step.
def xor_into(a String, b String) String {
  const left = a.to_bytes()
  const right = b.to_bytes()
  const out = Bytes.new(left.length())
  var i = 0
  while i < left.length() {
    out.set(i, left.get(i) ^ right.get(i))
    i = i + 1
  }
  return out.to_string()
}

// HKDF-Expand: the first length bytes of T(1) || T(2) || …, where
// T(i) = HMAC(prk, T(i-1) || info || byte(i)) from the empty T(0).
// The cap is the construction's own — past 255 hash lengths there is
// no answer, and asking for one raises; a negative length raises
// too.
def expand(code Int64, hash_len Int64, block Int64, prk String, info String, length Int64) String {
  if length < 0 {
    raise Exception.new(message: "crypto: hkdf length must not be negative")
  }
  if length > 255 * hash_len {
    raise Exception.new(message: "crypto: hkdf length past 255 times the hash length")
  }
  const out = Bytes.new(length)
  var t = ""
  var at = 0
  var counter = 1
  while at < length {
    t = internal.hmac.hmac(code, block, prk, t + info + one_byte(counter))
    const piece = t.to_bytes()
    var j = 0
    while j < piece.length() && at < length {
      out.set(at, piece.get(j))
      j = j + 1
      at = at + 1
    }
    counter = counter + 1
  }
  return out.to_string()
}

// PBKDF2: T(i) is the XOR of the iterations' U values, U(1) =
// HMAC(password, salt || INT(i)) and U(j) = HMAC(password, U(j-1));
// the digest of the final block is cut to fit. The iteration count is
// the caller's number — the package carries no work-factor policy —
// and one that is not at least one raises.
def pbkdf2(code Int64, hash_len Int64, block Int64, password String, salt String, iterations Int64, length Int64) String {
  if iterations < 1 {
    raise Exception.new(message: "crypto: pbkdf2 iterations must be at least one")
  }
  if length < 0 {
    raise Exception.new(message: "crypto: pbkdf2 length must not be negative")
  }
  const out = Bytes.new(length)
  var at = 0
  var index = 1
  while at < length {
    var u = internal.hmac.hmac(code, block, password, salt + int32_be(index))
    var acc = u
    var j = 1
    while j < iterations {
      u = internal.hmac.hmac(code, block, password, u)
      acc = xor_into(acc, u)
      j = j + 1
    }
    const piece = acc.to_bytes()
    var k = 0
    while k < piece.length() && at < length {
      out.set(at, piece.get(k))
      k = k + 1
      at = at + 1
    }
    index = index + 1
  }
  return out.to_string()
}
