// MD5 (RFC 1321, RFC 6151): the whole-message one-shot the legacy
// surface asks for. Thirty-two-bit words in Int64, little-endian
// through and through — the block words, the length, and the output
// all read low byte first, MD5's signature inversion of the SHA
// shape. The algorithm is broken — colliding by construction since
// 2004 — and lives only to verify the world's existing data.

// The addition mod 2^32, as the 32-bit engine's.
def add32(x Int64, y Int64) Int64 {
  return (x + y) & 0xFFFFFFFF
}

// The 64 round constants: floor(|sin(i + 1)| * 2^32) for i = 0..63,
// the sine table the RFC spells out (verified against it, not
// hand-copied).
const k = [
  0xd76aa478, 0xe8c7b756, 0x242070db, 0xc1bdceee,
  0xf57c0faf, 0x4787c62a, 0xa8304613, 0xfd469501,
  0x698098d8, 0x8b44f7af, 0xffff5bb1, 0x895cd7be,
  0x6b901122, 0xfd987193, 0xa679438e, 0x49b40821,
  0xf61e2562, 0xc040b340, 0x265e5a51, 0xe9b6c7aa,
  0xd62f105d, 0x02441453, 0xd8a1e681, 0xe7d3fbc8,
  0x21e1cde6, 0xc33707d6, 0xf4d50d87, 0x455a14ed,
  0xa9e3e905, 0xfcefa3f8, 0x676f02d9, 0x8d2a4c8a,
  0xfffa3942, 0x8771f681, 0x6d9d6122, 0xfde5380c,
  0xa4beea44, 0x4bdecfa9, 0xf6bb4b60, 0xbebfbc70,
  0x289b7ec6, 0xeaa127fa, 0xd4ef3085, 0x04881d05,
  0xd9d4d039, 0xe6db99e5, 0x1fa27cf8, 0xc4ac5665,
  0xf4292244, 0x432aff97, 0xab9423a7, 0xfc93a039,
  0x655b59c3, 0x8f0ccc92, 0xffeff47d, 0x85845dd1,
  0x6fa87e4f, 0xfe2ce6e0, 0xa3014314, 0x4e0811a1,
  0xf7537e82, 0xbd3af235, 0x2ad7d2bb, 0xeb86d391
]

// The per-round rotation amounts, four groups of four.
const shifts = [
  7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22, 7, 12, 17, 22,
  5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20, 5, 9, 14, 20,
  4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23, 4, 11, 16, 23,
  6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21, 6, 10, 15, 21
]

// One compression step over the 64-byte block at off: the four
// round functions (F, G, H, I), the per-group word orders, and the
// a ← b + rotl(a + f + k + m, s) step sixty-four times.
def compress(state Bytes, block Bytes, off Int64) Void {
  var a = state.get_u32_le(0)
  var b = state.get_u32_le(4)
  var c = state.get_u32_le(8)
  var d = state.get_u32_le(12)
  var t = 0
  while t < 64 {
    var fx = 0
    var g = 0
    if t < 16 {
      fx = (b & c) | (~b & d)
      g = t
    }
    if t >= 16 && t < 32 {
      fx = (d & b) | (~d & c)
      g = (5 * t + 1) & 15
    }
    if t >= 32 && t < 48 {
      fx = b ^ c ^ d
      g = (3 * t + 5) & 15
    }
    if t >= 48 {
      fx = c ^ (b | ~d)
      g = (7 * t) & 15
    }
    const m = block.get_u32_le(off + g * 4)
    const rotated = internal.word.rotl32(add32(add32(add32(a, fx), k[t]), m), shifts[t])
    a = d
    d = c
    c = b
    b = add32(b, rotated)
    t = t + 1
  }
  state.set_u32_le(0, add32(state.get_u32_le(0), a))
  state.set_u32_le(4, add32(state.get_u32_le(4), b))
  state.set_u32_le(8, add32(state.get_u32_le(8), c))
  state.set_u32_le(12, add32(state.get_u32_le(12), d))
}

// The 16-byte digest of data, message in one pass: the padding block
// discipline (0x80, the zero run, the bit length little-endian —
// MD5's inversion), every block compressed, the state bytes
// answering.
def digest(data Bytes) Bytes {
  const msg = data
  const n = msg.length()
  const blocks = (n + 9 + 63) / 64
  const pad = Bytes.new(blocks * 64)
  var i = 0
  while i < blocks * 64 {
    pad.set(i, 0)
    i = i + 1
  }
  i = 0
  while i < n {
    pad.set(i, msg.get(i))
    i = i + 1
  }
  pad.set(n, 0x80)
  pad.set_u64_le(blocks * 64 - 8, n << 3)
  const st = Bytes.new(16)
  st.set_u32_le(0, 0x67452301)
  st.set_u32_le(4, 0xefcdab89)
  st.set_u32_le(8, 0x98badcfe)
  st.set_u32_le(12, 0x10325476)
  var bi = 0
  while bi < blocks {
    compress(st, pad, bi * 64)
    bi = bi + 1
  }
  return st
}
