// The Keccak-f[1600] sponge (FIPS 202), after the Keccak team's
// compact reference: the lanes are 64-bit little-endian at
// `(5y + x) * 8` in one 200-byte state, rho-pi walks the 24 lanes
// carrying the rotated value in place (no offset table), and the
// round constants come from the 0x71 LFSR one bit at a time (no
// constant table) — both derived, nothing hand-copied. The shape is
// proven against the reference digests, and the digest goldens pin
// it on every target.
//
// Emo's constructors answer the gradual type — only parameters carry
// a static type, and a static receiver checks its arguments strictly
// while a gradual one dispatches — so every byte access below goes
// through the six parameterized doors at the top, the same shape
// base64's fill_encode uses.

// The little-endian doors, static on both sides.
def get_u64(b Bytes, i Int64) Int64 {
  return b.get_u64_le(i)
}

def set_u64(b Bytes, i Int64, v Int64) Void {
  b.set_u64_le(i, v)
}

// The byte doors, static on both sides.
def get_byte(b Bytes, i Int64) Int64 {
  return b.get(i)
}

def set_byte(b Bytes, i Int64, v Int64) Void {
  b.set(i, v)
}

// One permutation over the 200-byte state.
def keccak_f(a Bytes) Void {
  var r = 1
  var round = 0
  while round < 24 {
    // theta: the column parities, then the differential
    const c = Bytes.new(40)
    var x = 0
    while x < 5 {
      set_u64(c, x * 8, get_u64(a, x * 8) ^ get_u64(a, (5 + x) * 8) ^ get_u64(a, (10 + x) * 8) ^ get_u64(a, (15 + x) * 8) ^ get_u64(a, (20 + x) * 8))
      x = x + 1
    }
    const d = Bytes.new(40)
    x = 0
    while x < 5 {
      set_u64(d, x * 8, get_u64(c, ((x + 4) % 5) * 8) ^ internal.word.rotl64(get_u64(c, ((x + 1) % 5) * 8), 1))
      x = x + 1
    }
    var i = 0
    while i < 25 {
      set_u64(a, i * 8, get_u64(a, i * 8) ^ get_u64(d, (i % 5) * 8))
      i = i + 1
    }
    // rho and pi: walk the 24 lanes, each stored rotated by its step
    var px = 1
    var py = 0
    var current = get_u64(a, (py * 5 + px) * 8)
    var t = 0
    while t < 24 {
      const nx = py
      const ny = (2 * px + 3 * py) % 5
      const temp = get_u64(a, (ny * 5 + nx) * 8)
      set_u64(a, (ny * 5 + nx) * 8, internal.word.rotl64(current, (((t + 1) * (t + 2)) / 2) % 64))
      current = temp
      px = nx
      py = ny
      t = t + 1
    }
    // chi: the row-wise nonlinear step, the neighbour read along x
    const b = Bytes.new(200)
    var yy = 0
    while yy < 5 {
      var xx = 0
      while xx < 5 {
        set_u64(b, (yy * 5 + xx) * 8, get_u64(a, (yy * 5 + xx) * 8) ^ (~get_u64(a, (yy * 5 + ((xx + 1) % 5)) * 8) & get_u64(a, (yy * 5 + ((xx + 2) % 5)) * 8)))
        xx = xx + 1
      }
      yy = yy + 1
    }
    i = 0
    while i < 25 {
      set_u64(a, i * 8, get_u64(b, i * 8))
      i = i + 1
    }
    // iota: the round constant, one LFSR bit per tap
    var j = 0
    while j < 7 {
      r = ((r << 1) ^ ((r >> 7) * 0x71)) & 0xFF
      if (r & 2) != 0 {
        set_u64(a, 0, get_u64(a, 0) ^ (1 << ((1 << j) - 1)))
      }
      j = j + 1
    }
    round = round + 1
  }
}

// The padded message: the data, the domain byte (0x06 or 0x1f), the
// zero run, the closing 0x80 — one byte when the domain is the whole
// pad.
def fill_padded(padded Bytes, msg Bytes, n Int64, q Int64, domain Int64) Void {
  var i = 0
  while i < n + q {
    set_byte(padded, i, 0)
    i = i + 1
  }
  i = 0
  while i < n {
    set_byte(padded, i, get_byte(msg, i))
    i = i + 1
  }
  if q == 1 {
    set_byte(padded, n, domain | 0x80)
  } else {
    set_byte(padded, n, domain)
    set_byte(padded, n + q - 1, 0x80)
  }
}

// The absorb-and-squeeze over buffers the caller holds: XOR each
// rate-byte block into the state's head, permute, then pour lanes
// into the output, permuting between fills, until it is full.
def run_sponge(state Bytes, out Bytes, rate Int64, domain Int64, outlen Int64, data String) Void {
  const msg = data.to_bytes()
  const n = msg.length()
  const q = rate - n % rate
  const padded = Bytes.new(n + q)
  fill_padded(padded, msg, n, q, domain)
  var off = 0
  while off < n + q {
    var lane = 0
    while lane * 8 < rate {
      set_u64(state, lane * 8, get_u64(state, lane * 8) ^ get_u64(padded, off + lane * 8))
      lane = lane + 1
    }
    keccak_f(state)
    off = off + rate
  }
  var made = 0
  while made < outlen {
    var lane = 0
    while lane * 8 < rate && made < outlen {
      var k = 0
      while k < 8 && made < outlen {
        set_byte(out, made, get_byte(state, lane * 8 + k))
        k = k + 1
        made = made + 1
      }
      lane = lane + 1
    }
    if made < outlen {
      keccak_f(state)
    }
  }
}

// The sponge: the buffers are constructed here and handed to the
// statically typed run.
def sponge(rate Int64, domain Int64, outlen Int64, data String) String {
  const state = Bytes.new(200)
  const out = Bytes.new(outlen)
  run_sponge(state, out, rate, domain, outlen, data)
  return out.to_string()
}
