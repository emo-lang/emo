// The SHA-2 engine at the 64-bit width (FIPS 180-4): one compression
// function behind SHA-512, SHA-384, SHA-512/224 and SHA-512/256,
// which differ only in their initial words and their digest lengths.
// The lanes are Int64 outright — addition wraps mod 2^64 natively, so
// the engine needs no masking, only the logical right shift and the
// rotations from internal.word. The constants below were derived from
// the spec's definitions (the fractional parts of roots of primes;
// the /224 and /256 initial words through the generation function)
// and checked against the reference digests, not hand-copied. The
// public surface lives in crypto.sha2; sibling internals go through
// the full qualified path.

// The 80 round constants: the fractional parts of the cube roots of
// the first 80 primes (FIPS 180-4 §4.2.3), most significant word
// first.
const k512 = [
  0x428a2f98d728ae22, 0x7137449123ef65cd,
  0xb5c0fbcfec4d3b2f, 0xe9b5dba58189dbbc,
  0x3956c25bf348b538, 0x59f111f1b605d019,
  0x923f82a4af194f9b, 0xab1c5ed5da6d8118,
  0xd807aa98a3030242, 0x12835b0145706fbe,
  0x243185be4ee4b28c, 0x550c7dc3d5ffb4e2,
  0x72be5d74f27b896f, 0x80deb1fe3b1696b1,
  0x9bdc06a725c71235, 0xc19bf174cf692694,
  0xe49b69c19ef14ad2, 0xefbe4786384f25e3,
  0x0fc19dc68b8cd5b5, 0x240ca1cc77ac9c65,
  0x2de92c6f592b0275, 0x4a7484aa6ea6e483,
  0x5cb0a9dcbd41fbd4, 0x76f988da831153b5,
  0x983e5152ee66dfab, 0xa831c66d2db43210,
  0xb00327c898fb213f, 0xbf597fc7beef0ee4,
  0xc6e00bf33da88fc2, 0xd5a79147930aa725,
  0x06ca6351e003826f, 0x142929670a0e6e70,
  0x27b70a8546d22ffc, 0x2e1b21385c26c926,
  0x4d2c6dfc5ac42aed, 0x53380d139d95b3df,
  0x650a73548baf63de, 0x766a0abb3c77b2a8,
  0x81c2c92e47edaee6, 0x92722c851482353b,
  0xa2bfe8a14cf10364, 0xa81a664bbc423001,
  0xc24b8b70d0f89791, 0xc76c51a30654be30,
  0xd192e819d6ef5218, 0xd69906245565a910,
  0xf40e35855771202a, 0x106aa07032bbd1b8,
  0x19a4c116b8d2d0c8, 0x1e376c085141ab53,
  0x2748774cdf8eeb99, 0x34b0bcb5e19b48a8,
  0x391c0cb3c5c95a63, 0x4ed8aa4ae3418acb,
  0x5b9cca4f7763e373, 0x682e6ff3d6b2b8a3,
  0x748f82ee5defb2fc, 0x78a5636f43172f60,
  0x84c87814a1f0ab72, 0x8cc702081a6439ec,
  0x90befffa23631e28, 0xa4506cebde82bde9,
  0xbef9a3f7b2c67915, 0xc67178f2e372532b,
  0xca273eceea26619c, 0xd186b8c721c0c207,
  0xeada7dd6cde0eb1e, 0xf57d4f7fee6ed178,
  0x06f067aa72176fba, 0x0a637dc5a2c898a6,
  0x113f9804bef90dae, 0x1b710b35131c471b,
  0x28db77f523047d84, 0x32caab7b40c72493,
  0x3c9ebe0a15c9bebc, 0x431d67c49c100d4c,
  0x4cc5d4becb3e42b6, 0x597f299cfc657e2a,
  0x5fcb6fab3ad6faec, 0x6c44198c4a475817
]

// The initial words: SHA-512's are the fractional parts of the square
// roots of the first eight primes (§5.3.5); SHA-384's continue with
// the next eight (§5.3.6); the /224 and /256 words come from the
// generation function — SHA-512's initial words, each folded with
// 0xa5, hashing the variant's own name (§5.3.6).
def iv512(state Bytes) Void {
  internal.word.store_u64_be(state, 0, 0x6a09e667f3bcc908)
  internal.word.store_u64_be(state, 8, 0xbb67ae8584caa73b)
  internal.word.store_u64_be(state, 16, 0x3c6ef372fe94f82b)
  internal.word.store_u64_be(state, 24, 0xa54ff53a5f1d36f1)
  internal.word.store_u64_be(state, 32, 0x510e527fade682d1)
  internal.word.store_u64_be(state, 40, 0x9b05688c2b3e6c1f)
  internal.word.store_u64_be(state, 48, 0x1f83d9abfb41bd6b)
  internal.word.store_u64_be(state, 56, 0x5be0cd19137e2179)
}

def iv384(state Bytes) Void {
  internal.word.store_u64_be(state, 0, 0xcbbb9d5dc1059ed8)
  internal.word.store_u64_be(state, 8, 0x629a292a367cd507)
  internal.word.store_u64_be(state, 16, 0x9159015a3070dd17)
  internal.word.store_u64_be(state, 24, 0x152fecd8f70e5939)
  internal.word.store_u64_be(state, 32, 0x67332667ffc00b31)
  internal.word.store_u64_be(state, 40, 0x8eb44a8768581511)
  internal.word.store_u64_be(state, 48, 0xdb0c2e0d64f98fa7)
  internal.word.store_u64_be(state, 56, 0x47b5481dbefa4fa4)
}

def iv512_224(state Bytes) Void {
  internal.word.store_u64_be(state, 0, 0x8c3d37c819544da2)
  internal.word.store_u64_be(state, 8, 0x73e1996689dcd4d6)
  internal.word.store_u64_be(state, 16, 0x1dfab7ae32ff9c82)
  internal.word.store_u64_be(state, 24, 0x679dd514582f9fcf)
  internal.word.store_u64_be(state, 32, 0x0f6d2b697bd44da8)
  internal.word.store_u64_be(state, 40, 0x77e36f7304c48942)
  internal.word.store_u64_be(state, 48, 0x3f9d85a86a1d36c8)
  internal.word.store_u64_be(state, 56, 0x1112e6ad91d692a1)
}

def iv512_256(state Bytes) Void {
  internal.word.store_u64_be(state, 0, 0x22312194fc2bf72c)
  internal.word.store_u64_be(state, 8, 0x9f555fa3c84c64c2)
  internal.word.store_u64_be(state, 16, 0x2393b86b6f53b151)
  internal.word.store_u64_be(state, 24, 0x963877195940eabd)
  internal.word.store_u64_be(state, 32, 0x96283ee2a88effe3)
  internal.word.store_u64_be(state, 40, 0xbe5e1e2553863992)
  internal.word.store_u64_be(state, 48, 0x2b0199fc2c85b8aa)
  internal.word.store_u64_be(state, 56, 0x0eb72ddc81c52ca2)
}

// One compression step over the 128-byte block at off: the message
// schedule through a 16-lane rolling window and the 80 rounds, the
// working variables folded back into state at the end. The block
// bytes are read, never written.
def compress(state Bytes, block Bytes, off Int64) Void {
  var a = internal.word.load_u64_be(state, 0)
  var b = internal.word.load_u64_be(state, 8)
  var c = internal.word.load_u64_be(state, 16)
  var d = internal.word.load_u64_be(state, 24)
  var e = internal.word.load_u64_be(state, 32)
  var f = internal.word.load_u64_be(state, 40)
  var g = internal.word.load_u64_be(state, 48)
  var h = internal.word.load_u64_be(state, 56)
  const w = Bytes.new(128)
  var t = 0
  while t < 16 {
    internal.word.store_u64_be(w, t * 8, internal.word.load_u64_be(block, off + t * 8))
    t = t + 1
  }
  t = 0
  while t < 80 {
    if t >= 16 {
      const wi = (t & 15) * 8
      const w15 = internal.word.load_u64_be(w, ((t + 1) & 15) * 8)
      const w2 = internal.word.load_u64_be(w, ((t + 14) & 15) * 8)
      const w7 = internal.word.load_u64_be(w, ((t + 9) & 15) * 8)
      const w16 = internal.word.load_u64_be(w, wi)
      const ws0 = (internal.word.rotr64(w15, 1) ^ internal.word.rotr64(w15, 8)) ^ internal.word.lshr(w15, 7)
      const ws1 = (internal.word.rotr64(w2, 19) ^ internal.word.rotr64(w2, 61)) ^ internal.word.lshr(w2, 6)
      internal.word.store_u64_be(w, wi, ((w16 + ws0) + w7) + ws1)
    }
    const bs1 = (internal.word.rotr64(e, 14) ^ internal.word.rotr64(e, 18)) ^ internal.word.rotr64(e, 41)
    const ch = (e & f) ^ (~e & g)
    const temp1 = (((h + bs1) + ch) + k512[t]) + internal.word.load_u64_be(w, (t & 15) * 8)
    const bs0 = (internal.word.rotr64(a, 28) ^ internal.word.rotr64(a, 34)) ^ internal.word.rotr64(a, 39)
    const maj = ((a & b) ^ (a & c)) ^ (b & c)
    const temp2 = bs0 + maj
    h = g
    g = f
    f = e
    e = d + temp1
    d = c
    c = b
    b = a
    a = temp1 + temp2
    t = t + 1
  }
  internal.word.store_u64_be(state, 0, internal.word.load_u64_be(state, 0) + a)
  internal.word.store_u64_be(state, 8, internal.word.load_u64_be(state, 8) + b)
  internal.word.store_u64_be(state, 16, internal.word.load_u64_be(state, 16) + c)
  internal.word.store_u64_be(state, 24, internal.word.load_u64_be(state, 24) + d)
  internal.word.store_u64_be(state, 32, internal.word.load_u64_be(state, 32) + e)
  internal.word.store_u64_be(state, 40, internal.word.load_u64_be(state, 40) + f)
  internal.word.store_u64_be(state, 48, internal.word.load_u64_be(state, 48) + g)
  internal.word.store_u64_be(state, 56, internal.word.load_u64_be(state, 56) + h)
}

// The digest without disturbing the inputs: a copy of the state, the
// buffered bytes behind buf_off, the 0x80 terminator, the zero run,
// and the 128-bit length (high word zero, low word the bit count —
// total * 8 wrapping mod 2^64 exactly as the spec reads it) — one
// padding block when the message ends in the first 111 bytes of a
// block, two when it does not. The first outlen bytes of the final
// state are the digest.
def finish(state Bytes, buf Bytes, buf_off Int64, buflen Int64, total Int64, outlen Int64) String {
  const st = Bytes.new(64)
  var i = 0
  while i < 64 {
    st.set(i, state.get(i))
    i = i + 1
  }
  const pad = Bytes.new(256)
  i = 0
  while i < 256 {
    pad.set(i, 0)
    i = i + 1
  }
  i = 0
  while i < buflen {
    pad.set(i, buf.get(buf_off + i))
    i = i + 1
  }
  pad.set(buflen, 0x80)
  if buflen < 112 {
    internal.word.store_u64_be(pad, 112, 0)
    internal.word.store_u64_be(pad, 120, total << 3)
    compress(st, pad, 0)
  } else {
    internal.word.store_u64_be(pad, 240, 0)
    internal.word.store_u64_be(pad, 248, total << 3)
    compress(st, pad, 0)
    compress(st, pad, 128)
  }
  const out = Bytes.new(outlen)
  i = 0
  while i < outlen {
    out.set(i, st.get(i))
    i = i + 1
  }
  return out.to_string()
}
