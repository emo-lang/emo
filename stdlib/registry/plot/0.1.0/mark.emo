// A mark is a value that knows how to draw itself into an axes and what
// its data spans. The span is named on both axes — a continuous x and y
// range through `x_min`/`x_max`/`y_min`/`y_max`, a categorical x through
// `bands` and `x_labels` — so the axes can scale to every mark at once.
// `bar`, `line`, `scatter`, and `area` are the implementations so far.

interface Mark {
  def draw(ctx internal.ctx.DrawContext) Void
  def x_min() Float64
  def x_max() Float64
  def y_min() Float64
  def y_max() Float64
  def bands() Int64
  def x_labels() Array[String]
}

class BarStyle {
  def init(color (Int64, Int64, Int64), width Float64, opacity Float64, label String) {
    self.color = color
    self.width = width
    self.opacity = opacity
    self.label = label
  }

  def with_color(c (Int64, Int64, Int64)) BarStyle {
    return BarStyle.new(color: c, width: self.width, opacity: self.opacity, label: self.label)
  }

  def with_width(w Float64) BarStyle {
    return BarStyle.new(color: self.color, width: w, opacity: self.opacity, label: self.label)
  }

  def with_label(s String) BarStyle {
    return BarStyle.new(color: self.color, width: self.width, opacity: self.opacity, label: s)
  }
}

def bar_style() BarStyle {
  return BarStyle.new(color: (47, 111, 179), width: 0.8, opacity: 1.0, label: "")
}

class Bar {
  def init(labels Array[String], values Array[Float64], style BarStyle) {
    self.labels = labels
    self.values = values
    self.style = style
  }

  def draw(ctx internal.ctx.DrawContext) Void {
    const n = self.values.length()
    const band = ctx.plot_w / n.to_float64()
    const base = ctx.py(0.0)
    for var i = 0; i < n; i = i + 1 {
      const cx = ctx.px(i.to_float64() + 0.5)
      const half = band * self.style.width / 2.0
      const top = ctx.py(self.values[i])
      var y = top
      var h = base - top
      if h < 0.0 {
        y = base
        h = 0.0 - h
      }
      ctx.renderer.rect(cx - half, y, half * 2.0, h, self.style.color)
    }
  }

  def x_min() Float64 {
    return 0.0
  }

  def x_max() Float64 {
    return self.values.length().to_float64()
  }

  def y_min() Float64 {
    var lo = 0.0
    for var i = 0; i < self.values.length(); i = i + 1 {
      if self.values[i] < lo {
        lo = self.values[i]
      }
    }
    return lo
  }

  def y_max() Float64 {
    var hi = 0.0
    for var i = 0; i < self.values.length(); i = i + 1 {
      if self.values[i] > hi {
        hi = self.values[i]
      }
    }
    return hi
  }

  def bands() Int64 {
    return self.values.length()
  }

  def x_labels() Array[String] {
    return self.labels
  }

  def with_style(s BarStyle) Bar {
    return Bar.new(labels: self.labels, values: self.values, style: s)
  }
}

def bar(labels Array[String], values Array[Float64]) Bar {
  return Bar.new(labels: labels, values: values, style: bar_style())
}

// The stroke vocabulary of a line: the dash pattern and the point
// marker stamped at every data point.
enum Dash { solid, dashed, dotted, dash_dot }
enum Marker { none, circle, square, triangle, diamond, cross, plus }

// The dash gap lengths a Dash name stands for, handed to the renderer's
// line primitive verbatim; a solid stroke carries the empty pattern.
def dash_array(d Dash) String {
  var out = ""
  if d == Dash.dashed {
    out = "7 4"
  }
  if d == Dash.dotted {
    out = "1.5 3.5"
  }
  if d == Dash.dash_dot {
    out = "7 3 1.5 3"
  }
  return out
}

// One marker stamp in pixel space, shared by the marks that place a
// shape at every point. A cross or plus strokes its arms at a quarter
// of the marker size; `Marker.none` stamps nothing.
def stamp_marker(r internal.svg.SvgRenderer, cx Float64, cy Float64, m Marker, size Float64, color (Int64, Int64, Int64)) Void {
  const half = size / 2.0
  const stroke = size / 4.0
  if m == Marker.circle {
    r.circle(cx, cy, half, color)
  }
  if m == Marker.square {
    r.rect(cx - half, cy - half, size, size, color)
  }
  if m == Marker.triangle {
    r.polygon([cx, cx - half, cx + half], [cy - half, cy + half, cy + half], color)
  }
  if m == Marker.diamond {
    r.polygon([cx, cx + half, cx, cx - half], [cy - half, cy, cy + half, cy], color)
  }
  if m == Marker.cross {
    r.line(cx - half, cy - half, cx + half, cy + half, color, stroke, "")
    r.line(cx + half, cy - half, cx - half, cy + half, color, stroke, "")
  }
  if m == Marker.plus {
    r.line(cx - half, cy, cx + half, cy, color, stroke, "")
    r.line(cx, cy - half, cx, cy + half, color, stroke, "")
  }
}

class LineStyle {
  def init(color (Int64, Int64, Int64), width Float64, dash Dash, marker Marker, marker_size Float64, opacity Float64, label String) {
    self.color = color
    self.width = width
    self.dash = dash
    self.marker = marker
    self.marker_size = marker_size
    self.opacity = opacity
    self.label = label
  }

  def with_color(c (Int64, Int64, Int64)) LineStyle {
    return LineStyle.new(color: c, width: self.width, dash: self.dash, marker: self.marker, marker_size: self.marker_size, opacity: self.opacity, label: self.label)
  }

  def with_width(w Float64) LineStyle {
    return LineStyle.new(color: self.color, width: w, dash: self.dash, marker: self.marker, marker_size: self.marker_size, opacity: self.opacity, label: self.label)
  }

  def with_dash(d Dash) LineStyle {
    return LineStyle.new(color: self.color, width: self.width, dash: d, marker: self.marker, marker_size: self.marker_size, opacity: self.opacity, label: self.label)
  }

  def with_marker(m Marker) LineStyle {
    return LineStyle.new(color: self.color, width: self.width, dash: self.dash, marker: m, marker_size: self.marker_size, opacity: self.opacity, label: self.label)
  }

  def with_marker_size(s Float64) LineStyle {
    return LineStyle.new(color: self.color, width: self.width, dash: self.dash, marker: self.marker, marker_size: s, opacity: self.opacity, label: self.label)
  }

  def with_opacity(o Float64) LineStyle {
    return LineStyle.new(color: self.color, width: self.width, dash: self.dash, marker: self.marker, marker_size: self.marker_size, opacity: o, label: self.label)
  }

  def with_label(s String) LineStyle {
    return LineStyle.new(color: self.color, width: self.width, dash: self.dash, marker: self.marker, marker_size: self.marker_size, opacity: self.opacity, label: s)
  }
}

def line_style() LineStyle {
  return LineStyle.new(color: (192, 57, 43), width: 1.5, dash: Dash.solid, marker: Marker.none, marker_size: 6.0, opacity: 1.0, label: "")
}

class Line {
  def init(x Array[Float64], y Array[Float64], style LineStyle) {
    self.x = x
    self.y = y
    self.style = style
  }

  def draw(ctx internal.ctx.DrawContext) Void {
    const n = self.y.length()
    const pattern = dash_array(self.style.dash)
    for var i = 0; i < n - 1; i = i + 1 {
      ctx.renderer.line(ctx.px(self.x[i]), ctx.py(self.y[i]), ctx.px(self.x[i + 1]), ctx.py(self.y[i + 1]), self.style.color, self.style.width, pattern)
    }
    for var i = 0; i < n; i = i + 1 {
      stamp_marker(ctx.renderer, ctx.px(self.x[i]), ctx.py(self.y[i]), self.style.marker, self.style.marker_size, self.style.color)
    }
  }

  def x_min() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var lo = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] < lo {
        lo = self.x[i]
      }
    }
    return lo
  }

  def x_max() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var hi = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] > hi {
        hi = self.x[i]
      }
    }
    return hi
  }

  def y_min() Float64 {
    if self.y.length() == 0 {
      return 0.0
    }
    var lo = self.y[0]
    for var i = 1; i < self.y.length(); i = i + 1 {
      if self.y[i] < lo {
        lo = self.y[i]
      }
    }
    return lo
  }

  def y_max() Float64 {
    if self.y.length() == 0 {
      return 0.0
    }
    var hi = self.y[0]
    for var i = 1; i < self.y.length(); i = i + 1 {
      if self.y[i] > hi {
        hi = self.y[i]
      }
    }
    return hi
  }

  def bands() Int64 {
    return 0
  }

  def x_labels() Array[String] {
    return []
  }

  def with_style(s LineStyle) Line {
    return Line.new(x: self.x, y: self.y, style: s)
  }
}

def line(x Array[Float64], y Array[Float64]) Line {
  return Line.new(x: x, y: y, style: line_style())
}

class ScatterStyle {
  def init(color (Int64, Int64, Int64), size Float64, marker Marker, opacity Float64, label String) {
    self.color = color
    self.size = size
    self.marker = marker
    self.opacity = opacity
    self.label = label
  }

  def with_color(c (Int64, Int64, Int64)) ScatterStyle {
    return ScatterStyle.new(color: c, size: self.size, marker: self.marker, opacity: self.opacity, label: self.label)
  }

  def with_size(s Float64) ScatterStyle {
    return ScatterStyle.new(color: self.color, size: s, marker: self.marker, opacity: self.opacity, label: self.label)
  }

  def with_marker(m Marker) ScatterStyle {
    return ScatterStyle.new(color: self.color, size: self.size, marker: m, opacity: self.opacity, label: self.label)
  }

  def with_opacity(o Float64) ScatterStyle {
    return ScatterStyle.new(color: self.color, size: self.size, marker: self.marker, opacity: o, label: self.label)
  }

  def with_label(s String) ScatterStyle {
    return ScatterStyle.new(color: self.color, size: self.size, marker: self.marker, opacity: self.opacity, label: s)
  }
}

def scatter_style() ScatterStyle {
  return ScatterStyle.new(color: (85, 168, 104), size: 6.0, marker: Marker.circle, opacity: 1.0, label: "")
}

class Scatter {
  def init(x Array[Float64], y Array[Float64], style ScatterStyle) {
    self.x = x
    self.y = y
    self.style = style
  }

  def draw(ctx internal.ctx.DrawContext) Void {
    for var i = 0; i < self.y.length(); i = i + 1 {
      stamp_marker(ctx.renderer, ctx.px(self.x[i]), ctx.py(self.y[i]), self.style.marker, self.style.size, self.style.color)
    }
  }

  def x_min() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var lo = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] < lo {
        lo = self.x[i]
      }
    }
    return lo
  }

  def x_max() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var hi = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] > hi {
        hi = self.x[i]
      }
    }
    return hi
  }

  def y_min() Float64 {
    if self.y.length() == 0 {
      return 0.0
    }
    var lo = self.y[0]
    for var i = 1; i < self.y.length(); i = i + 1 {
      if self.y[i] < lo {
        lo = self.y[i]
      }
    }
    return lo
  }

  def y_max() Float64 {
    if self.y.length() == 0 {
      return 0.0
    }
    var hi = self.y[0]
    for var i = 1; i < self.y.length(); i = i + 1 {
      if self.y[i] > hi {
        hi = self.y[i]
      }
    }
    return hi
  }

  def bands() Int64 {
    return 0
  }

  def x_labels() Array[String] {
    return []
  }

  def with_style(s ScatterStyle) Scatter {
    return Scatter.new(x: self.x, y: self.y, style: s)
  }
}

def scatter(x Array[Float64], y Array[Float64]) Scatter {
  return Scatter.new(x: x, y: y, style: scatter_style())
}

class AreaStyle {
  def init(color (Int64, Int64, Int64), edge_color (Int64, Int64, Int64), edge_width Float64, opacity Float64, label String) {
    self.color = color
    self.edge_color = edge_color
    self.edge_width = edge_width
    self.opacity = opacity
    self.label = label
  }

  def with_color(c (Int64, Int64, Int64)) AreaStyle {
    return AreaStyle.new(color: c, edge_color: self.edge_color, edge_width: self.edge_width, opacity: self.opacity, label: self.label)
  }

  def with_edge_color(c (Int64, Int64, Int64)) AreaStyle {
    return AreaStyle.new(color: self.color, edge_color: c, edge_width: self.edge_width, opacity: self.opacity, label: self.label)
  }

  def with_edge_width(w Float64) AreaStyle {
    return AreaStyle.new(color: self.color, edge_color: self.edge_color, edge_width: w, opacity: self.opacity, label: self.label)
  }

  def with_opacity(o Float64) AreaStyle {
    return AreaStyle.new(color: self.color, edge_color: self.edge_color, edge_width: self.edge_width, opacity: o, label: self.label)
  }

  def with_label(s String) AreaStyle {
    return AreaStyle.new(color: self.color, edge_color: self.edge_color, edge_width: self.edge_width, opacity: self.opacity, label: s)
  }
}

def area_style() AreaStyle {
  return AreaStyle.new(color: (148, 103, 189), edge_color: (74, 51, 95), edge_width: 0.0, opacity: 1.0, label: "")
}

class Area {
  def init(x Array[Float64], y Array[Float64], style AreaStyle) {
    self.x = x
    self.y = y
    self.style = style
  }

  def draw(ctx internal.ctx.DrawContext) Void {
    const n = self.y.length()
    if n > 0 {
      var pxs = [ctx.px(self.x[0])]
      var pys = [ctx.py(self.y[0])]
      for var i = 1; i < n; i = i + 1 {
        pxs = pxs.append(ctx.px(self.x[i]))
        pys = pys.append(ctx.py(self.y[i]))
      }
      pxs = pxs.append(ctx.px(self.x[n - 1]))
      pys = pys.append(ctx.py(0.0))
      pxs = pxs.append(ctx.px(self.x[0]))
      pys = pys.append(ctx.py(0.0))
      ctx.renderer.polygon(pxs, pys, self.style.color)
      if self.style.edge_width > 0.0 {
        for var i = 0; i < n - 1; i = i + 1 {
          ctx.renderer.line(ctx.px(self.x[i]), ctx.py(self.y[i]), ctx.px(self.x[i + 1]), ctx.py(self.y[i + 1]), self.style.edge_color, self.style.edge_width, "")
        }
      }
    }
  }

  def x_min() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var lo = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] < lo {
        lo = self.x[i]
      }
    }
    return lo
  }

  def x_max() Float64 {
    if self.x.length() == 0 {
      return 0.0
    }
    var hi = self.x[0]
    for var i = 1; i < self.x.length(); i = i + 1 {
      if self.x[i] > hi {
        hi = self.x[i]
      }
    }
    return hi
  }

  def y_min() Float64 {
    var lo = 0.0
    for var i = 0; i < self.y.length(); i = i + 1 {
      if self.y[i] < lo {
        lo = self.y[i]
      }
    }
    return lo
  }

  def y_max() Float64 {
    var hi = 0.0
    for var i = 0; i < self.y.length(); i = i + 1 {
      if self.y[i] > hi {
        hi = self.y[i]
      }
    }
    return hi
  }

  def bands() Int64 {
    return 0
  }

  def x_labels() Array[String] {
    return []
  }

  def with_style(s AreaStyle) Area {
    return Area.new(x: self.x, y: self.y, style: s)
  }
}

def area(x Array[Float64], y Array[Float64]) Area {
  return Area.new(x: x, y: y, style: area_style())
}
