// The declarative figure surface and the SVG entry point. A chart is a
// value — `figure`/`axes`/marks — rendered in one call.

const scale = internal.scale

enum Scale { linear, log }
enum Domain { auto, fixed }
enum Share { all, none }

class Figure {
  def init(width Float64, height Float64, title String, axes Array[Axes], grid (Int64, Int64), share Share) {
    self.width = width
    self.height = height
    self.title = title
    self.axes = axes
    self.grid = grid
    self.share = share
  }

  def with_title(t String) Figure {
    return Figure.new(width: self.width, height: self.height, title: t, axes: self.axes, grid: self.grid, share: self.share)
  }

  def with_size(w Float64, h Float64) Figure {
    return Figure.new(width: w, height: h, title: self.title, axes: self.axes, grid: self.grid, share: self.share)
  }

  def with_axes(a Array[Axes]) Figure {
    return Figure.new(width: self.width, height: self.height, title: self.title, axes: a, grid: self.grid, share: self.share)
  }

  def with_share(s Share) Figure {
    return Figure.new(width: self.width, height: self.height, title: self.title, axes: self.axes, grid: self.grid, share: s)
  }
}

class Axes {
  def init(x_label String, y_label String, x_scale Scale, y_scale Scale, legend Bool, marks Array[mark.Mark]) {
    self.x_label = x_label
    self.y_label = y_label
    self.x_scale = x_scale
    self.y_scale = y_scale
    self.legend = legend
    self.marks = marks
  }

  def with_x_label(s String) Axes {
    return Axes.new(x_label: s, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, legend: self.legend, marks: self.marks)
  }

  def with_y_label(s String) Axes {
    return Axes.new(x_label: self.x_label, y_label: s, x_scale: self.x_scale, y_scale: self.y_scale, legend: self.legend, marks: self.marks)
  }

  def with_marks(m Array[mark.Mark]) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, legend: self.legend, marks: m)
  }

  def with_legend(on Bool) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, legend: on, marks: self.marks)
  }
}

def figure() Figure {
  return Figure.new(width: 640.0, height: 480.0, title: "", axes: [axes()], grid: (1, 1), share: Share.all)
}

def axes() Axes {
  return Axes.new(x_label: "", y_label: "", x_scale: Scale.linear, y_scale: Scale.linear, legend: true, marks: [])
}

// A tick label: an integral value loses its trailing ".0".
def tick_text(x Float64) String {
  if x == x.floor() {
    return x.to_int64().to_string()
  }
  return x.to_string()
}

def draw_axes(r internal.svg.SvgRenderer, fig Figure, ax Axes) Void {
  const ml = 64.0
  const mr = 24.0
  const mt = 64.0
  const mb = 72.0
  const pw = fig.width - ml - mr
  const ph = fig.height - mt - mb
  const marks = ax.marks
  var xlo = 0.0
  var xhi = 1.0
  var ylo = 0.0
  var ymax = 0.0
  if marks.length() > 0 {
    xlo = marks[0].x_min()
    xhi = marks[0].x_max()
    ylo = marks[0].y_min()
    ymax = marks[0].y_max()
  }
  for var k = 0; k < marks.length(); k = k + 1 {
    if marks[k].x_min() < xlo {
      xlo = marks[k].x_min()
    }
    if marks[k].x_max() > xhi {
      xhi = marks[k].x_max()
    }
    if marks[k].y_min() < ylo {
      ylo = marks[k].y_min()
    }
    if marks[k].y_max() > ymax {
      ymax = marks[k].y_max()
    }
  }
  const top = scale.nice_ceil(ymax)
  const ctx = internal.ctx.DrawContext.new(renderer: r, x0: ml, y0: mt, plot_w: pw, plot_h: ph, x_min: xlo, x_max: xhi, y_min: ylo, y_max: top)
  if fig.title != "" {
    r.text(ml, 30.0, fig.title, 18.0, internal.svg.Anchor.start, internal.svg.Weight.bold, (34, 34, 34))
  }
  if ax.y_label != "" {
    r.text(ml, 52.0, ax.y_label, 13.0, internal.svg.Anchor.start, internal.svg.Weight.regular, (85, 85, 85))
  }
  const ts = scale.ticks(ylo, top, 5)
  for var t = 0; t < ts.length(); t = t + 1 {
    const y = ctx.py(ts[t])
    r.line(ml, y, ml + pw, y, (230, 230, 230), 1.0, "")
    r.text(ml - 8.0, y + 4.0, tick_text(ts[t]), 12.0, internal.svg.Anchor.end, internal.svg.Weight.regular, (85, 85, 85))
  }
  for var k = 0; k < marks.length(); k = k + 1 {
    marks[k].draw(ctx)
  }
  r.line(ml, mt + ph, ml + pw, mt + ph, (136, 136, 136), 1.0, "")
  // The first mark carrying categorical labels owns the x annotation;
  // without one, the continuous domain ticks numerically.
  var li = -1
  for var k = 0; k < marks.length(); k = k + 1 {
    if li < 0 {
      if marks[k].x_labels().length() > 0 {
        li = k
      }
    }
  }
  if li >= 0 {
    const labels = marks[li].x_labels()
    for var b = 0; b < labels.length(); b = b + 1 {
      const cx = ctx.px(b.to_float64() + 0.5)
      r.text(cx, mt + ph + 18.0, labels[b], 12.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
    }
  } else {
    const xs = scale.ticks(xlo, xhi, 5)
    for var t = 0; t < xs.length(); t = t + 1 {
      const cx = ctx.px(xs[t])
      r.text(cx, mt + ph + 18.0, tick_text(xs[t]), 12.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
    }
  }
  if ax.x_label != "" {
    r.text(ml + pw / 2.0, mt + ph + 44.0, ax.x_label, 13.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
  }
}

def svg(fig Figure) String {
  const r = internal.svg.SvgRenderer.new(fig.width, fig.height)
  r.rect(0.0, 0.0, fig.width, fig.height, (255, 255, 255))
  for var i = 0; i < fig.axes.length(); i = i + 1 {
    draw_axes(r, fig, fig.axes[i])
  }
  return r.finish()
}
