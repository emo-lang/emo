// The declarative figure surface and the SVG entry point. A chart is a
// value — `figure`/`axes`/marks — rendered in one call.

const scale = internal.scale

enum Scale { linear, log }
enum Domain { auto, fixed }
enum Share { all, none }

class Figure {
  def init(width Float64, height Float64, title String, axes Array[Axes], grid (Int64, Int64), share Share) {
    self.width = width
    self.height = height
    self.title = title
    self.axes = axes
    self.grid = grid
    self.share = share
  }

  def with_title(t String) Figure {
    return Figure.new(width: self.width, height: self.height, title: t, axes: self.axes, grid: self.grid, share: self.share)
  }

  def with_size(w Float64, h Float64) Figure {
    return Figure.new(width: w, height: h, title: self.title, axes: self.axes, grid: self.grid, share: self.share)
  }

  def with_axes(a Array[Axes]) Figure {
    return Figure.new(width: self.width, height: self.height, title: self.title, axes: a, grid: self.grid, share: self.share)
  }

  def with_share(s Share) Figure {
    return Figure.new(width: self.width, height: self.height, title: self.title, axes: self.axes, grid: self.grid, share: s)
  }
}

// The style of an axes's gridlines: the tick-aligned lines behind the
// marks, horizontal for y ticks and vertical for x ticks. `visible`
// false draws no grid at all.
class GridStyle {
  def init(color (Int64, Int64, Int64), width Float64, dash mark.Dash, visible Bool) {
    self.color = color
    self.width = width
    self.dash = dash
    self.visible = visible
  }

  def with_color(c (Int64, Int64, Int64)) GridStyle {
    return GridStyle.new(color: c, width: self.width, dash: self.dash, visible: self.visible)
  }

  def with_width(w Float64) GridStyle {
    return GridStyle.new(color: self.color, width: w, dash: self.dash, visible: self.visible)
  }

  def with_dash(d mark.Dash) GridStyle {
    return GridStyle.new(color: self.color, width: self.width, dash: d, visible: self.visible)
  }

  def with_visible(v Bool) GridStyle {
    return GridStyle.new(color: self.color, width: self.width, dash: self.dash, visible: v)
  }
}

def grid_style() GridStyle {
  return GridStyle.new(color: (230, 230, 230), width: 1.0, dash: mark.Dash.solid, visible: true)
}

class Axes {
  def init(x_label String, y_label String, x_scale Scale, y_scale Scale,
           x_domain (Domain, Float64, Float64), y_domain (Domain, Float64, Float64),
           legend Bool, grid GridStyle, marks Array[mark.Mark]) {
    self.x_label = x_label
    self.y_label = y_label
    self.x_scale = x_scale
    self.y_scale = y_scale
    self.x_domain = x_domain
    self.y_domain = y_domain
    self.legend = legend
    self.grid = grid
    self.marks = marks
  }

  def with_grid_style(s GridStyle) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: s, marks: self.marks)
  }

  def with_x_label(s String) Axes {
    return Axes.new(x_label: s, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_y_label(s String) Axes {
    return Axes.new(x_label: self.x_label, y_label: s, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_x_scale(s Scale) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: s, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_y_scale(s Scale) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: s, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_x_domain(a Float64, b Float64) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: (Domain.fixed, a, b), y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_y_domain(a Float64, b Float64) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: (Domain.fixed, a, b), legend: self.legend, grid: self.grid, marks: self.marks)
  }

  def with_marks(m Array[mark.Mark]) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: self.legend, grid: self.grid, marks: m)
  }

  def with_legend(on Bool) Axes {
    return Axes.new(x_label: self.x_label, y_label: self.y_label, x_scale: self.x_scale, y_scale: self.y_scale, x_domain: self.x_domain, y_domain: self.y_domain, legend: on, grid: self.grid, marks: self.marks)
  }
}

def figure() Figure {
  return Figure.new(width: 640.0, height: 480.0, title: "", axes: [axes()], grid: (1, 1), share: Share.all)
}

def axes() Axes {
  return Axes.new(x_label: "", y_label: "", x_scale: Scale.linear, y_scale: Scale.linear, x_domain: (Domain.auto, 0.0, 0.0), y_domain: (Domain.auto, 0.0, 0.0), legend: true, grid: grid_style(), marks: [])
}

// A tick label: an integral value loses its trailing ".0".
def tick_text(x Float64) String {
  if x == x.floor() {
    return x.to_int64().to_string()
  }
  return x.to_string()
}

def draw_axes(r internal.svg.SvgRenderer, fig Figure, ax Axes) Void {
  const ml = 64.0
  const mr = 24.0
  const mt = 64.0
  const mb = 72.0
  const pw = fig.width - ml - mr
  const ph = fig.height - mt - mb
  const marks = ax.marks
  var xlo = 0.0
  var xhi = 1.0
  var ylo = 0.0
  var ymax = 0.0
  var top = 1.0
  if marks.length() > 0 {
    xlo = marks[0].x_min()
    xhi = marks[0].x_max()
    ylo = marks[0].y_min()
    ymax = marks[0].y_max()
  }
  for var k = 0; k < marks.length(); k = k + 1 {
    if marks[k].x_min() < xlo {
      xlo = marks[k].x_min()
    }
    if marks[k].x_max() > xhi {
      xhi = marks[k].x_max()
    }
    if marks[k].y_min() < ylo {
      ylo = marks[k].y_min()
    }
    if marks[k].y_max() > ymax {
      ymax = marks[k].y_max()
    }
  }
  // The domain: fixed carries the caller's ends verbatim; auto infers
  // from every mark — decade bounds under a log scale, the nice-ceiling
  // top on a linear one. Either way a log axis maps positive values
  // only.
  const y_log = ax.y_scale == Scale.log
  const x_log = ax.x_scale == Scale.log
  if ax.y_domain[0] == Domain.fixed {
    ylo = ax.y_domain[1]
    top = ax.y_domain[2]
    if ylo >= top {
      raise Exception.new(message: "plot: the fixed y domain needs lo < hi, got ${ylo} to ${top}")
    }
  } else {
    if y_log {
      if ylo <= 0.0 {
        raise Exception.new(message: "plot: the log y axis needs positive values, got ${ylo}")
      }
      ylo = scale.pow10(scale.magnitude(ylo))
      var e = scale.magnitude(ymax)
      if ymax > scale.pow10(e) {
        e = e + 1
      }
      top = scale.pow10(e)
    } else {
      top = scale.nice_ceil(ymax)
    }
  }
  if y_log && ylo <= 0.0 {
    raise Exception.new(message: "plot: the log y axis needs positive values, got ${ylo}")
  }
  if ax.x_domain[0] == Domain.fixed {
    xlo = ax.x_domain[1]
    xhi = ax.x_domain[2]
    if xlo >= xhi {
      raise Exception.new(message: "plot: the fixed x domain needs lo < hi, got ${xlo} to ${xhi}")
    }
  } else {
    if x_log {
      if xlo <= 0.0 {
        raise Exception.new(message: "plot: the log x axis needs positive values, got ${xlo}")
      }
      xlo = scale.pow10(scale.magnitude(xlo))
      var xe = scale.magnitude(xhi)
      if xhi > scale.pow10(xe) {
        xe = xe + 1
      }
      xhi = scale.pow10(xe)
    }
  }
  if x_log && xlo <= 0.0 {
    raise Exception.new(message: "plot: the log x axis needs positive values, got ${xlo}")
  }
  const ctx = internal.ctx.DrawContext.new(renderer: r, x0: ml, y0: mt, plot_w: pw, plot_h: ph, x_min: xlo, x_max: xhi, y_min: ylo, y_max: top, x_log: x_log, y_log: y_log)
  if fig.title != "" {
    r.text(ml, 30.0, fig.title, 18.0, internal.svg.Anchor.start, internal.svg.Weight.bold, (34, 34, 34))
  }
  if ax.y_label != "" {
    r.text(ml, 52.0, ax.y_label, 13.0, internal.svg.Anchor.start, internal.svg.Weight.regular, (85, 85, 85))
  }
  // Tick positions for both axes, then the grid behind everything:
  // horizontal lines at the y ticks, vertical lines at the x ticks.
  var yt = scale.ticks(ylo, top, 5)
  if y_log {
    yt = scale.log_ticks(ylo, top)
  }
  var li = -1
  if !x_log {
    for var k = 0; k < marks.length(); k = k + 1 {
      if li < 0 {
        if marks[k].x_labels().length() > 0 {
          li = k
        }
      }
    }
  }
  // A log x axis always ticks numerically; otherwise the first mark
  // carrying categorical labels owns the x annotation at its band
  // centers, and without one the continuous domain ticks numerically.
  var categorical = false
  var xt = scale.ticks(xlo, xhi, 5)
  if x_log {
    xt = scale.log_ticks(xlo, xhi)
  } else {
    if li >= 0 && marks[li].bands() > 0 {
      categorical = true
      xt = [0.5]
      for var b = 1; b < marks[li].bands(); b = b + 1 {
        xt = xt.append(b.to_float64() + 0.5)
      }
    }
  }
  const gs = ax.grid
  if gs.visible {
    const pattern = mark.dash_array(gs.dash)
    for var t = 0; t < yt.length(); t = t + 1 {
      const y = ctx.py(yt[t])
      r.line(ml, y, ml + pw, y, gs.color, gs.width, pattern)
    }
    for var t = 0; t < xt.length(); t = t + 1 {
      const cx = ctx.px(xt[t])
      r.line(cx, mt, cx, mt + ph, gs.color, gs.width, pattern)
    }
  }
  for var k = 0; k < marks.length(); k = k + 1 {
    marks[k].draw(ctx)
  }
  r.line(ml, mt + ph, ml + pw, mt + ph, (136, 136, 136), 1.0, "")
  for var t = 0; t < yt.length(); t = t + 1 {
    const y = ctx.py(yt[t])
    r.text(ml - 8.0, y + 4.0, tick_text(yt[t]), 12.0, internal.svg.Anchor.end, internal.svg.Weight.regular, (85, 85, 85))
  }
  if categorical {
    const labels = marks[li].x_labels()
    for var b = 0; b < labels.length(); b = b + 1 {
      const cx = ctx.px(b.to_float64() + 0.5)
      r.text(cx, mt + ph + 18.0, labels[b], 12.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
    }
  } else {
    for var t = 0; t < xt.length(); t = t + 1 {
      const cx = ctx.px(xt[t])
      r.text(cx, mt + ph + 18.0, tick_text(xt[t]), 12.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
    }
  }
  if ax.x_label != "" {
    r.text(ml + pw / 2.0, mt + ph + 44.0, ax.x_label, 13.0, internal.svg.Anchor.middle, internal.svg.Weight.regular, (85, 85, 85))
  }
  // The legend: marks array order, drawn last, one white panel in the
  // plot's top-right corner. Only labeled marks join; entry offsets use
  // an approximate per-character advance, since the package carries no
  // font metrics.
  if ax.legend {
    var count = 0
    var wide = 0.0
    for var k = 0; k < marks.length(); k = k + 1 {
      const lbl = marks[k].legend_label()
      if lbl != "" {
        count = count + 1
        const w = 26.0 + lbl.length().to_float64() * 7.0
        if w > wide {
          wide = w
        }
      }
    }
    if count > 0 {
      const row = 20.0
      const bw = wide + 16.0
      const bh = count.to_float64() * row
      const bx = ml + pw - bw - 8.0
      const by = mt + 8.0
      r.rect(bx, by, bw, bh, (255, 255, 255))
      var at = by + row / 2.0
      for var k = 0; k < marks.length(); k = k + 1 {
        const lbl = marks[k].legend_label()
        if lbl != "" {
          marks[k].legend_sample(r, bx + 8.0, at)
          r.text(bx + 8.0 + 26.0, at + 4.0, lbl, 12.0, internal.svg.Anchor.start, internal.svg.Weight.regular, (85, 85, 85))
          at = at + row
        }
      }
    }
  }
}

def svg(fig Figure) String {
  const r = internal.svg.SvgRenderer.new(fig.width, fig.height)
  r.rect(0.0, 0.0, fig.width, fig.height, (255, 255, 255))
  for var i = 0; i < fig.axes.length(); i = i + 1 {
    draw_axes(r, fig, fig.axes[i])
  }
  return r.finish()
}
