// Linear scales and the "nice numbers" tick locator (Heckbert's
// nicenum): the reason an axis reads 0/5/10 rather than 0/3.7/7.4.

// floor(log10(x)) by counting powers of ten — no log primitive needed.
def magnitude(x Float64) Int64 {
  var m = 0
  var v = x
  while v >= 10.0 {
    v = v / 10.0
    m = m + 1
  }
  while v < 1.0 {
    v = v * 10.0
    m = m - 1
  }
  return m
}

def pow10(n Int64) Float64 {
  var v = 1.0
  if n >= 0 {
    for var i = 0; i < n; i = i + 1 {
      v = v * 10.0
    }
  } else {
    for var i = 0; i < 0 - n; i = i + 1 {
      v = v / 10.0
    }
  }
  return v
}

def nice_num(x Float64, round_it Bool) Float64 {
  const e = magnitude(x)
  const f = x / pow10(e)
  var nf = 10.0
  if round_it {
    if f < 1.5 {
      nf = 1.0
    } else {
      if f < 3.0 {
        nf = 2.0
      } else {
        if f < 7.0 {
          nf = 5.0
        }
      }
    }
  } else {
    if f <= 1.0 {
      nf = 1.0
    } else {
      if f <= 2.0 {
        nf = 2.0
      } else {
        if f <= 5.0 {
          nf = 5.0
        }
      }
    }
  }
  return nf * pow10(e)
}

// The smallest nice number at or above x (the top of a y domain).
def nice_ceil(x Float64) Float64 {
  if x <= 0.0 {
    return 1.0
  }
  const step = pow10(magnitude(x))
  const f = x / step
  var nf = 10.0
  if f <= 1.0 {
    nf = 1.0
  } else {
    if f <= 2.0 {
      nf = 2.0
    } else {
      if f <= 5.0 {
        nf = 5.0
      }
    }
  }
  return nf * step
}

// Tick values across [lo, hi], stepping by a nice number.
def ticks(lo Float64, hi Float64, want Int64) Array[Float64] {
  const span = hi - lo
  const step = nice_num(span / (want - 1).to_float64(), true)
  var out = [lo]
  var v = lo + step
  while v <= hi + step / 2.0 {
    out = out.append(v)
    v = v + step
  }
  return out
}

// log10 of a positive value: the decade from magnitude(), the fraction
// folded in by square-and-compare over halving roots of ten. Every step
// is an IEEE multiply, sqrt, or compare, so all targets land on the
// same double. A nonpositive value answers 0.0; a log axis refuses
// nonpositive domains before mapping reaches here.
def log10(v Float64) Float64 {
  if v <= 0.0 {
    return 0.0
  }
  const m = magnitude(v)
  var rest = v / pow10(m)
  var f = 0.0
  var acc = 1.0
  var root = 10.0.sqrt()
  var half = 0.5
  while half > 0.000000000001 {
    if acc * root <= rest {
      acc = acc * root
      f = f + half
    }
    root = root.sqrt()
    half = half / 2.0
  }
  return m.to_float64() + f
}

// The next tick after v on a log axis: 1-2-5 through each decade when
// minors are wanted, decade steps alone otherwise. v sits on a tick.
def next_log_tick(v Float64, minors Bool) Float64 {
  const k = magnitude(v)
  const m = v / pow10(k)
  if minors {
    if m == 1.0 {
      return 2.0 * pow10(k)
    }
    if m == 2.0 {
      return 5.0 * pow10(k)
    }
  }
  return 10.0 * pow10(k)
}

// Tick values across [lo, hi] on a log axis: the 1-2-5 steps inside
// the span, one per decade plus the 2 and 5 multiples while the span is
// short enough to crowd. A domain whose ends sit off the steps — only
// possible when fixed — ticks its ends alone if no step fits inside.
def log_ticks(lo Float64, hi Float64) Array[Float64] {
  const minors = log10(hi) - log10(lo) <= 2.0
  var first = pow10(magnitude(lo))
  if first < lo {
    first = pow10(magnitude(lo) + 1)
  }
  if first > hi {
    return [lo, hi]
  }
  var out = [first]
  var v = first
  while v < hi {
    v = next_log_tick(v, minors)
    if v <= hi {
      out = out.append(v)
    }
  }
  return out
}
