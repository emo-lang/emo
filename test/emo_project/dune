(executable
 (name emo_project_test)
 (libraries
  alcotest
  unix
  emo_test_support
  emo_pkg
  emo_project
  emo_support
  emo_eval
  emo_ir))

(rule
 (alias runtest)
 (deps
  (source_tree ../../examples)
  (source_tree ../../projects)
  (source_tree ../../stdlib)
  (source_tree ../../test/emo_sched/fixtures)
  ../../src/emo_cli/emo.exe
  emo_project_test.exe)
 (action
  (setenv
   EMO_EXAMPLES_DIR
   %{workspace_root}/examples
   (setenv
    EMO_EXE
    %{workspace_root}/_build/default/src/emo_cli/emo.exe
    (run %{exe:emo_project_test.exe})))))

; The example bootstrap builds compile and run every example, so they
; live behind their own alias instead of @runtest: `dune build @bootstrap`.
(rule
 (alias bootstrap)
 (deps
  (source_tree ../../examples)
  (source_tree ../../projects)
  (source_tree ../../stdlib)
  (source_tree ../../test/emo_sched/fixtures)
  ../../src/emo_cli/emo.exe
  emo_project_test.exe)
 (action
  (setenv
   EMO_BOOTSTRAP
   1
   (setenv
    EMO_EXAMPLES_DIR
    %{workspace_root}/examples
    (setenv
     EMO_EXE
     %{workspace_root}/_build/default/src/emo_cli/emo.exe
     (run %{exe:emo_project_test.exe}))))))
