(executable
 (name emo_cli_test)
 (libraries
  alcotest
  unix
  threads
  emo_cli
  emo_support
  emo_eval
  emo_lexer
  emo_parser))

(rule
 (alias runtest)
 (deps
  (source_tree ../../examples)
  (source_tree ../../stdlib)
  (file ../../VERSION)
  emo_cli_test.exe)
 (action
  (setenv
   EMO_REGISTRY
   ../../stdlib/registry
   (run %{exe:emo_cli_test.exe}))))

; The bundled registry lives beside the compiler in an install; tests
; resolve it from the sandbox's stdlib copy instead.
