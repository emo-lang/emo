(library
 (name emo_cli)
 (libraries
  cmdliner
  unix
  emo_support
  emo_tool
  emo_lexer
  emo_parser
  emo_ast
  emo_eval
  emo_check
  emo_ir
  emo_codegen
  emo_runtime
  emo_project)
 (modules emo_cli version emo_linenoise)
 ; The vendored linenoise editor (`linenoise.c`, upstream
 ; antirez/linenoise at a473823d74b93eab2ba83480df16ed37617493f2, the
 ; marked emo: patches) and the stubs mapping its verdicts onto
 ; `emo_linenoise`'s variants — the first C the OCaml CLI links.
 (foreign_stubs
  (language c)
  (names linenoise emo_linenoise_stubs)))

; The version string is the repository's VERSION file, read at build
; time so the binary carries it wherever it runs.

(rule
 (target version.ml)
 (deps
  (:version_file ../../VERSION))
 (action
  (with-stdout-to
   version.ml
   (bash "printf 'let version = \"%s\"\\n' \"$(cat %{version_file})\""))))

(executable
 (name emo)
 (public_name emo)
 (libraries emo_cli)
 (modules emo))
