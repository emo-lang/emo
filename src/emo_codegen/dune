(library
 (name emo_codegen)
 (libraries emo_support emo_ast emo_check emo_ir emo_runtime))

(data_only_dirs ts c)

; The target runtimes ride the compiler as generated data — the C
; sources are written next to the emitted main.c, the TypeScript
; prelude is prepended to the emitted program — so every backend works
; from the build tree and from an installation alike, with no
; beside-the-binary file lookups (step 26's runtime-independence
; principle: the host contributes only the emitters).

(rule
 (target emo_ts_runtime_data.ml)
 (deps ts/ts_runtime.ts)
 (action
  (with-stdout-to
   emo_ts_runtime_data.ml
   (bash
    "printf '(* Generated from src/emo_codegen/ts — edit there, not here. *)\\n\\nlet ts_prelude = {ts|' && cat ts/ts_runtime.ts && printf '|ts}\\n'"))))

(rule
 (target emo_c_runtime_data.ml)
 (deps c/emo_c_runtime.c c/emo_c_runtime.h)
 (action
  (with-stdout-to
   emo_c_runtime_data.ml
   (bash
    "printf '(* Generated from src/emo_codegen/c — edit there, not here. *)\\n\\nlet runtime_c = {img|\\n' && cat c/emo_c_runtime.c && printf '\\n|img}\\n\\nlet runtime_h = {img|\\n' && cat c/emo_c_runtime.h && printf '\\n|img}\\n'"))))
