// The debug backend's golden (T48.3): one screen through the portable
// core and out as stable text, byte-identical on every hosted target
// that can run it — and, below the screen, the retained diff in the
// same form, so the matching is pinned the way the rendering is.
//
// The screen is a consumer of the core, not a module of it — it declares
// `emo/ui` as a dependency exactly as an application would — which
// is what makes the comparison meaningful: these are the bytes an
// application sees, out of real `require`-d code, not out of the
// package's own tree.
//
// Every primitive is here at least once, both `w=`/`h=` branches (a
// number and `auto`), all four `Align` values, an empty string prop, and
// nested containers, because the form is what is under test: a node that
// renders differently on two targets is the failure this file exists to
// catch. The event tags are registered before the tree is built (see
// `screen`), because registration order is what `Registry.on` makes
// observable.
//
//   emo run main.emo                       -> the golden, from the interpreter
//   emo build main.emo --target <t> -o …   -> the same bytes, from the target

enum Msg { save, cancel, retry }

def field(label String, value String) ui.Node {
  return ui.row([
    ui.text(label, ui.style().with_width(64.0)),
    ui.text_input(value, ui.style().with_grow(true))
  ], ui.style().with_gap(8.0).with_align(ui.Align.center))
}

def screen(reg ui.Registry, name String) ui.Node {
  // The tags are taken first, in statements of their own: `on` is a side
  // effect, and the statements make the registration order visible at the
  // call site (`docs/intro/syntax.md`, operands evaluate left to right).
  // The tags are the message's index in the table.
  const save = reg.on(Msg.save)
  const cancel = reg.on(Msg.cancel)
  const retry = reg.on(Msg.retry)

  return ui.column([
    ui.row([
      ui.image("avatar.png", ui.style().with_width(32.0).with_height(32.0)),
      ui.column([
        ui.text(name, ui.style()),
        ui.text("3 unread", ui.style())
      ], ui.style().with_gap(2.0))
    ], ui.style().with_gap(12.0).with_align(ui.Align.center)),
    field("name", "Ada Lovelace"),
    field("email", ""),
    ui.scroll([
      ui.text("older messages", ui.style()),
      ui.spacer(ui.style().with_grow(true))
    ], ui.style().with_height(120.0).with_align(ui.Align.stretch)),
    ui.row([
      ui.button("Save", save, ui.style().with_padding(6.0)),
      ui.button("Cancel", cancel, ui.style()),
      ui.button("Retry", retry, ui.style().with_width(9.0))
    ], ui.style().with_gap(8.0).with_align(ui.Align.end))
  ], ui.style().with_padding(16.0).with_gap(12.0).with_grow(true))
}

// ---- The retained diff, as text ----
//
// The matching every kept backend runs, pinned the way the screen is:
// the same bytes from every target. One line per slot — `=` a node the
// old tree's continues, `+` a new one, `-` an old one no new node
// continues — and each pair of trees below is one rule of it.

def t(body String) ui.Node {
  return ui.text(body, ui.style())
}

def k(key String, n ui.Node) ui.Node {
  return ui.keyed(key, n)
}

def col(kids Array[ui.Node]) ui.Node {
  return ui.column(kids, ui.style())
}

def b(label String) ui.Node {
  return ui.button(label, 3, ui.style())
}

def change(old ui.Node, next ui.Node) {
  println(ui.debug.diff_text(ui.diff(old, next)))
}

def main() {
  println(ui.debug.render(screen(ui.Registry.new(), "Ada Lovelace")))

  // A changed prop keeps the node.
  change(col([t("a"), t("b")]), col([t("a"), t("c")]))
  // Without a key a child is its position: one inserted at the front
  // takes the first slot, and the last is new.
  change(col([t("a"), t("b")]), col([t("x"), t("a"), t("b")]))
  // A key is identity wherever the child moves.
  change(col([k("a", t("1")), k("b", t("2"))]),
    col([k("b", t("2")), k("a", t("1"))]))
  // A keyed sibling arriving leaves the unkeyed positions alone.
  change(col([t("u0"), t("u1")]), col([k("h", t("h")), t("u0"), t("u1")]))
  // The child no new one names is dropped.
  change(col([k("h", t("h")), t("u0"), t("u1")]), col([t("u0"), t("u1")]))
  // A position whose class changed is replaced, not continued.
  change(col([t("a"), b("b")]), col([t("a"), t("b")]))
  // So is a key whose class changed.
  change(col([k("k", t("old"))]), col([k("k", b("new"))]))
  // A replaced root is whole: nothing below it continues.
  change(col([t("a")]), ui.row([t("a")], ui.style()))
  // A replaced container is whole too, and its sibling is not.
  change(col([col([t("x"), t("y")]), t("a")]),
    col([ui.row([t("z")], ui.style()), t("a")]))
}

main()
