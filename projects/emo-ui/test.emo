// The core's own test: the tag round-trip, the retained patch (T48.2),
// and the retained diff. It is a module of the package, not a package of
// its own, so `emo check ui.emo` checks it and `./check.sh` runs it.
//
//   emo run test.emo
//
// A failed assertion raises rather than printing a wrong report that
// could be mistaken for the expected output, so the golden is the list
// of checks and their `ok` lines.

def check(ok Bool, what String) {
  if ok {
    println("ok   ${what}")
  } else {
    raise Exception.new(message: "assertion failed: ${what}")
  }
}

def assert_same(want String, what String, got String) {
  if want != got {
    raise Exception.new(message: "expected [${want}], got [${got}]: ${what}")
  }
  check(true, what)
}

// ---- The application the loop drives -------------------------------
//
// A counter, written the way docs/emo-ui.md's Layer 5 example is: the
// model is a value, `update` is pure and returns the next one, `view` is
// pure and returns the tree. Nothing here names a platform, and nothing
// here names the loop beyond `ui.on`.

enum Msg { inc, dec }

class Model {
  def init(count Int64) {
    self.count = count
  }

  def count() Int64 {
    return self.count
  }

  def with_count(c Int64) Model {
    return Model.new(count: c)
  }
}

def update(msg Msg, m Model) Model {
  case msg {
    Msg.inc then { return m.with_count(m.count() + 1) }
    Msg.dec then { return m.with_count(m.count() - 1) }
  }
}

def view(reg ui.Registry, m Model) ui.Node {
  // The tags are taken in statements of their own, before the tree is
  // built: `on` is a side effect, and a statement of its own makes the
  // registration order visible at the call site (`docs/intro/syntax.md`,
  // operands evaluate left to right).
  const inc = reg.on(Msg.inc)
  const dec = reg.on(Msg.dec)

  return ui.column([
    ui.text("count ${m.count()}", ui.style()),
    ui.button("+", inc, ui.style()),
    ui.button("-", dec, ui.style())
  ], ui.style())
}

// ---- Reading a tree ------------------------------------------------
//
// These two walks read *structure* off a tree — a label, a tag — by
// narrowing with `is()`, which is a backend's dispatch in miniature. The
// tree as *text* is `debug`'s job, and `golden/` is where that form is
// pinned byte for byte; a walk here would say the same thing twice.

def label(node ui.Node) String {
  if node.is(ui.Text) {
    return node.body()
  }
  return label_from(node.children(), 0)
}

def label_from(kids Array[ui.Node], i Int64) String {
  if i >= kids.length() {
    return ""
  }
  const found = label(kids[i])
  if found != "" {
    return found
  }
  return label_from(kids, i + 1)
}

def tag_of(node ui.Node, which String) Int64 {
  if node.is(ui.Button) {
    if node.label() == which {
      return node.event()
    }
    return -1
  }
  return tag_of_from(node.children(), which, 0)
}

def tag_of_from(kids Array[ui.Node], which String, i Int64) Int64 {
  if i >= kids.length() {
    return -1
  }
  const found = tag_of(kids[i], which)
  if found >= 0 {
    return found
  }
  return tag_of_from(kids, which, i + 1)
}

// ---- The two backends the retained/full-rebuild comparison needs -----
//
// Both are handed the same calls. `Recorder` is the retained one: it
// takes `patch`'s `old` and keeps the chain, which is what a toolkit that
// must not lose focus, selection, or scroll position diffs against.
// `Rebuild` throws `old` away and repaints from `new`, which is all a
// terminal or a one-shot HTML render ever needs. The test asserts both
// show the same thing, because one loop has to serve both.
//
// The script says "click the button labelled so", and each tag is read
// off the tree the backend currently holds — never out of the registry.
// The round trip under test is `view` -> node -> backend -> `dispatch`
// -> `update`, and reading the tag here is what puts the first half of it
// in the path.

def script() Array[String] {
  return ["+", "+", "-"]
}

def click_all(e ui.Events, tree Box, labels Array[String], i Int64) {
  if i < labels.length() {
    e.deliver(tag_of(tree.read(), labels[i]))
    click_all(e, tree, labels, i + 1)
  }
}

class Recorder {
  def init() {
    self.mounts = Box.new(0)
    self.patches = Box.new([])
    self.events = Box.new(debug.unmounted())
    self.tree = Box.new(ui.text("", ui.style()))
  }

  def mount(root ui.Node, events ui.Events) {
    self.mounts.replace(self.mounts.read() + 1)
    self.events.replace(events)
    self.tree.replace(root)
  }

  def patch(old ui.Node, next ui.Node) {
    self.patches.replace(self.patches.read().append((old, next)))
    self.tree.replace(next)
  }

  def run() {
    click_all(self.events.read(), self.tree, script(), 0)
  }
}

class Rebuild {
  def init() {
    self.mounts = Box.new(0)
    self.painted = Box.new([])
    self.events = Box.new(debug.unmounted())
    self.tree = Box.new(ui.text("", ui.style()))
  }

  def mount(root ui.Node, events ui.Events) {
    self.mounts.replace(self.mounts.read() + 1)
    self.events.replace(events)
    self.tree.replace(root)
    self.painted.replace(self.painted.read().append(label(root)))
  }

  def patch(old ui.Node, next ui.Node) {
    self.tree.replace(next)
    self.painted.replace(self.painted.read().append(label(next)))
  }

  def run() {
    click_all(self.events.read(), self.tree, script(), 0)
  }
}

// ---- The tag round-trip ---------------------------------------------
//
// Every piece of state here is a local, never a module-level binding: a
// module-level `const` re-runs its initializer on each read on the
// compiled targets (`CHECK.md`, module-level bindings), which would hand
// each of these its own table, its own backend, and its own tags.

def tag_checks() {
  const reg = ui.Registry.new()
  const inc = reg.on(Msg.inc)
  const dec = reg.on(Msg.dec)

  check(inc != dec, "two messages get two tags")
  check(reg.on(Msg.inc) == inc, "a message keeps the tag it was first given")
  check(reg.dispatch(inc) == Msg.inc, "dispatch resolves a tag to its message")
  check(reg.dispatch(dec) == Msg.dec,
    "and the other tag to the other message")

  const tree = view(reg, Model.new(7))
  check(tag_of(tree, "+") == inc,
    "the tree carries the tag `on` gave the message")
  assert_same("count 7", "the tree renders the model it was built from",
    label(tree))
}

// ---- The loop: one mount, one patch per event, a retained chain -----

def retained_checks() {
  const retained = Recorder.new()
  ui.run(view, update, Model.new(0), retained)

  check(retained.mounts.read() == 1, "the loop mounts once")
  const ps = retained.patches.read()
  check(ps.length() == 3, "one delivered tag is one patch")

  const olds = [label(ps[0][0]), label(ps[1][0]), label(ps[2][0])]
  const news = [label(ps[0][1]), label(ps[1][1]), label(ps[2][1])]

  check(olds == ["count 0", "count 1", "count 2"],
    "each patch's old tree is the tree the backend last saw")
  check(news == ["count 1", "count 2", "count 1"],
    "and each new tree is the model after that event")
  check(ps[0][1] == ps[1][0], "patch retains the tree itself, not a copy")
  check(ps[1][1] == ps[2][0], "and the chain holds for every event")
}

// ---- The same loop, a backend that rebuilds -------------------------

def rebuild_checks() {
  const rebuilt = Rebuild.new()
  ui.run(view, update, Model.new(0), rebuilt)

  check(rebuilt.mounts.read() == 1, "a rebuilding backend mounts once too")
  check(rebuilt.painted.read() == ["count 0", "count 1", "count 2", "count 1"],
    "both backends show the same trees, so `old` is an offer, not a duty")
}

// ---- The headless backend -------------------------------------------
//
// `debug.Debug` is the backend this package ships and `golden/` runs: it
// renders every tree the loop hands it into a log instead of printing,
// and it has no input source of its own — `run` drives nothing — so an
// event is delivered by hand through `deliver`, on the sink `mount` was
// given. Two runs of the same script must render the same text, or the
// golden could not be a file.

def debug_checks() {
  const first = debug.Debug.new()
  const second = debug.Debug.new()
  ui.run(view, update, Model.new(0), first)
  ui.run(view, update, Model.new(0), second)
  first.deliver(0)
  second.deliver(0)

  check(first.log() == second.log(),
    "two runs of the same script render the same text")
  check(first.log().length() == 2,
    "a mount and one delivered tag are one rendered tree each")

  const step = debug.Debug.new()
  ui.run(view, update, Model.new(0), step)
  step.deliver(0)
  step.deliver(1)

  check(step.log()[2] == step.log()[0],
    "an event that undoes the one before it renders the tree it started from")
}

// ---- The retained diff ----------------------------------------------
//
// `ui.diff` is the matching every kept backend runs, and its text form
// is `golden/`'s to pin byte for byte on every target. What is asserted
// here is what the text cannot show: the old child a kept slot names, the
// one a replaced slot displaces, and the children a container dropped.

def t(body String) ui.Node {
  return ui.text(body, ui.style())
}

def col(kids Array[ui.Node]) ui.Node {
  return ui.column(kids, ui.style())
}

// Whether a slot names a node of the old tree — one it keeps, or one it
// replaces. A new slot names none.
def names_old(p ui.Patch) Bool {
  case p.old() {
    (R.ok, _) then { return true }
    (R.error, _) then { return false }
  }
}

// A node class the core does not know, the way a platform's own node is
// one: it satisfies `ui.Node`, and no diff continues it.
class Odd {
  def init() {
  }

  def style() ui.Style {
    return ui.style()
  }

  def children() Array[ui.Node] {
    return []
  }
}

def diff_checks() {
  const root = ui.diff(col([t("a")]), col([t("b")]))
  check(root.kept() && names_old(root), "a root of the same class is kept")
  check(root.was() == -1 && root.path() == "" && root.from() == "",
    "the root sits at the empty path, in both trees")
  check(label(root.node()) == "b" && label(root.kids()[0].node()) == "b",
    "a kept slot carries the new tree's node")
  check(root.kids()[0].kept() && root.kids()[0].was() == 0,
    "a child keeps its position when nothing moved")
  check(root.kids()[0].path() == "/0" && root.kids()[0].from() == "/0",
    "and a child's path is its index under its parent's")

  const nested = ui.diff(col([col([t("x"), t("y")])]), col([col([t("x"), t("z")])]))
  check(nested.kids()[0].kids()[1].path() == "/0/1",
    "a path runs from the root down")

  // A key is identity wherever the child moves.
  const moved = ui.diff(
    col([ui.keyed("a", t("1")), ui.keyed("b", t("2"))]),
    col([ui.keyed("b", t("2")), ui.keyed("a", t("1"))]))
  check(moved.kids()[0].kept() && moved.kids()[0].was() == 1,
    "a keyed child continues the old child with its key, wherever it moved")
  check(moved.kids()[0].path() == "/0" && moved.kids()[0].from() == "/1",
    "and its two paths name both positions")
  check(moved.kids()[1].kept() && moved.kids()[1].was() == 0,
    "and the other keyed child follows it")
  check(ui.gone(moved) == [], "a reorder drops nothing")

  // A keyed sibling arriving leaves the unkeyed positions alone.
  const arrived = ui.diff(col([t("u0"), t("u1")]),
    col([ui.keyed("h", t("h")), t("u0"), t("u1")]))
  check(!arrived.kids()[0].kept() && !names_old(arrived.kids()[0])
    && arrived.kids()[0].was() == -1,
    "a child with no old one is new, and names none")
  check(arrived.kids()[1].kept() && arrived.kids()[1].was() == 0
    && arrived.kids()[2].kept() && arrived.kids()[2].was() == 1,
    "an unkeyed child is its position among the unkeyed")

  // The child no new one names is dropped.
  const shrunk = ui.diff(col([ui.keyed("h", t("h")), t("u0")]), col([t("u0")]))
  check(ui.gone(shrunk) == [0] && shrunk.kids()[0].kept()
    && shrunk.kids()[0].was() == 1,
    "a dropped child is the old index no new child names")

  // A position whose class changed is replaced, not continued.
  const swapped = ui.diff(col([t("a"), ui.button("b", 3, ui.style())]),
    col([t("a"), t("b")]))
  const slot = swapped.kids()[1]
  check(!slot.kept() && names_old(slot) && slot.was() == 1,
    "a slot whose class changed names the child it displaces")
  check(ui.gone(swapped) == [],
    "and a replaced child is not dropped a second time")

  // A key whose class changed is replaced the same way.
  const retyped = ui.diff(col([ui.keyed("k", t("old"))]),
    col([ui.keyed("k", ui.button("new", 3, ui.style()))]))
  check(!retyped.kids()[0].kept() && names_old(retyped.kids()[0])
    && retyped.kids()[0].was() == 0,
    "a key continues a child only when the class is the same")

  // A replaced slot is whole: nothing below it continues.
  const replaced = ui.diff(col([col([t("x")]), t("a")]),
    col([ui.row([t("x")], ui.style()), t("a")]))
  check(!replaced.kids()[0].kept() && !names_old(replaced.kids()[0].kids()[0]),
    "a node below a replaced one is new")
  check(replaced.kids()[1].kept() && replaced.kids()[1].was() == 1,
    "and its sibling is not")
  check(ui.gone(replaced) == [], "a replaced container drops its sibling never")

  // The key is the node's own, set through `keyed` alone.
  const keyed = ui.keyed("row-7", t("a"))
  check(ui.key_of(keyed) == "row-7" && ui.key_of(t("a")) == "",
    "`keyed` sets the key, and a node otherwise has none")
  check(label(keyed) == "a" && ui.same_kind(keyed, t("b")),
    "and the keyed node is the node it was, prop for prop")
  check(ui.key_of(ui.keyed("c", col([t("a")]))) == "c"
    && ui.key_of(ui.keyed("c", col([t("a")])).children()[0]) == "",
    "keying a container keys the container, not its children")

  // A node class the core does not know is rebuilt every frame.
  const odd = ui.diff(col([Odd.new()]), col([Odd.new()]))
  check(odd.kept() && !odd.kids()[0].kept() && names_old(odd.kids()[0])
    && odd.kids()[0].was() == 0,
    "a node the core does not know is never continued")
  check(!ui.same_kind(Odd.new(), Odd.new()) && ui.key_of(Odd.new()) == "",
    "it is of no kind the diff knows, and carries no key")
}

tag_checks()
retained_checks()
rebuild_checks()
debug_checks()
diff_checks()
