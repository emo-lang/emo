require "emo/ui"

// The DOM backend (T48.11): the portable tree rendered into the page,
// over the browser runtime's `emo.dom_*` family.
//
// There is no shim here and no C ABI. The runtime's browser host already
// owns the `document`, and a DOM node crosses into Emo as an Int64
// handle into its node table, so the whole backend is one Emo class: the
// layout is the browser's, the style mapping is `css.emo`'s, and an
// event is the tag a listener carries back to the loop's sink.
//
// `run()` returns. A page owns the event loop, so `mount` installs the
// listeners and hands control back; the loop runs again when the
// browser calls one of them, not because the backend blocks.
//
// `patch` keeps what `ui.diff` keeps. A continued node's element stays
// in the page — its focus, its selection and its scroll position with
// it — and takes the new node's props and styles where it stands; a new
// or replaced node gets the element its node builds. Only a root that is
// not continued is rebuilt whole, as every frame once was.

// The tag rides the button's `name`/`value` pair — the same markup
// contract `ui_ssr` emits — so the page, and a test driving it, can see
// which event an element carries without reaching into the runtime. An
// editable field's tag rides the `name` `emo-<tag>` under the same
// contract, and its `input` events deliver the element's own value.

def apply_styles(handle Int64, kind String, s ui.Style) {
  const ds = css.declarations(kind, s)
  for var i = 0; i < ds.length(); i = i + 1 {
    const pair = ds[i]
    emo.dom_set_style(handle, pair[0], pair[1])
  }
}

// Whether a list of declarations carries a property.
def has(ds Array[(String, String)], name String) Bool {
  for var i = 0; i < ds.length(); i = i + 1 {
    if ds[i][0] == name {
      return true
    }
  }
  return false
}

// Whether a node's children are elements under its own: the three
// containers. A leaf's element holds its text and nothing below it.
def carries(n ui.Node) Bool {
  return n.is(ui.Column) || n.is(ui.Row) || n.is(ui.Scroll)
}

// The sink before `mount`. A backend is built before the loop hands it
// the application, and a `Box` is typed by what it is born holding, so
// the cell starts as an `Events` that delivers to no one — never as a
// number that could not later become one. The root's cell is a number
// for good: a DOM node is an `Int64` handle.
class Unmounted {
  def deliver(tag Int64, text String, key Int64) Void {
  }
}

def unmounted() ui.Events {
  return Unmounted.new()
}

class Dom {
  def init(title String) {
    self.title = title
    self.sink = Box.new(unmounted())
    self.root = Box.new(0)
    self.top = Box.new(0)
  }

  def mount(root ui.Node, events ui.Events) {
    self.sink.replace(events)
    const point = emo.dom_root()
    self.root.replace(point)
    emo.dom_title(self.title)
    const rs = css.root_declarations()
    for var i = 0; i < rs.length(); i = i + 1 {
      const pair = rs[i]
      emo.dom_set_style(point, pair[0], pair[1])
    }
    emo.dom_sink() -> (tag Int64, text String, key Int64) {
      self.sink.read().deliver(tag, text, key)
    }
    const top = self.build(root)
    emo.dom_append(point, top)
    self.top.replace(top)
  }

  // A frame keeps what the diff keeps. `top` is the root's element, the
  // one `mount` attached, for as long as the root is continued.
  def patch(old ui.Node, next ui.Node) {
    const p = ui.diff(old, next)
    if p.kept() {
      self.update(self.top.read(), p)
    } else {
      const point = self.root.read()
      emo.dom_clear(point)
      const top = self.build(next)
      emo.dom_append(point, top)
      self.top.replace(top)
    }
  }

  // One continued slot: the element stays and shows the new node, and a
  // container's children are then placed under it.
  def update(el Int64, p ui.Patch) {
    const n = p.node()
    self.paint(el, n)
    const before = p.old()
    case before {
      (R.error, _) then { }
      (R.ok, was_node) then { self.unstyle(el, was_node, n) }
    }
    if carries(n) {
      self.place(el, p)
    }
  }

  // The children of a continued container. Each continued child keeps the
  // element it had, and a new or replaced one gets the element its node
  // builds. The elements that leave go first, from the highest old index
  // down so each index still names the element it did; then every child
  // stands where the new tree has it.
  def place(el Int64, p ui.Patch) {
    const kids = p.kids()

    // Read before anything moves: each continued child's element, by the
    // index the child had.
    const els = ArrayBuilder.new()
    for var j = 0; j < kids.length(); j = j + 1 {
      if self.continues(kids[j]) {
        els.push(emo.dom_child(el, kids[j].was()))
      } else {
        els.push(0 - 1)
      }
    }
    const kept = els.to_array()

    // The old indexes that leave: the children no new node names, and the
    // ones a new node replaces.
    const out = ArrayBuilder.new()
    const gone = ui.gone(p)
    for var i = 0; i < gone.length(); i = i + 1 {
      out.push(gone[i])
    }
    for var j = 0; j < kids.length(); j = j + 1 {
      if !self.continues(kids[j]) {
        if self.names_old(kids[j]) {
          out.push(kids[j].was())
        }
      }
    }
    const leaving = out.to_array().sort()
    for var i = leaving.length() - 1; i >= 0; i = i - 1 {
      emo.dom_remove(el, emo.dom_child(el, leaving[i]))
    }

    // Left to right. The slots before a child are final by its turn, so
    // the element at its index is either its own or the one it goes
    // ahead of — and 0, when it is the last, is the end.
    for var j = 0; j < kids.length(); j = j + 1 {
      const here = emo.dom_child(el, j)
      if kept[j] >= 0 {
        if here != kept[j] {
          emo.dom_insert_before(el, kept[j], here)
        }
        self.update(kept[j], kids[j])
      } else {
        emo.dom_insert_before(el, self.build(kids[j].node()), here)
      }
    }
  }

  // Whether a slot's element goes on. It was kept, and a button is the
  // same button only while it raises the same event: the listener an
  // element carries is the one it was given. A field is the same field
  // by the same rule — its listener is the one its event was given to.
  def continues(p ui.Patch) Bool {
    if !p.kept() {
      return false
    }
    const n = p.node()
    if n.is(ui.Button) {
      const before = p.old()
      case before {
        (R.error, _) then { }
        (R.ok, was_node) then {
          if was_node.is(ui.Button) {
            if was_node.event() != n.event() {
              return false
            }
          }
        }
      }
    }
    if n.is(ui.TextInput) {
      const before = p.old()
      case before {
        (R.error, _) then { }
        (R.ok, was_node) then {
          if was_node.is(ui.TextInput) {
            if was_node.event() != n.event() {
              return false
            }
          }
        }
      }
    }
    return true
  }

  // Whether a slot names a node of the old tree — one it keeps, or one it
  // replaces. A new slot names none.
  def names_old(p ui.Patch) Bool {
    case p.old() {
      (R.ok, _) then { return true }
      (R.error, _) then { return false }
    }
  }

  // The declarations a continued node no longer has — a width or a height
  // the old style set and the new one leaves to the page — come off its
  // element: a style set inline stays until something clears it.
  def unstyle(el Int64, was_node ui.Node, n ui.Node) {
    const olds = css.declarations(self.kind_of(was_node), was_node.style())
    const news = css.declarations(self.kind_of(n), n.style())
    for var i = 0; i < olds.length(); i = i + 1 {
      const name = olds[i][0]
      if !has(news, name) {
        emo.dom_set_style(el, name, "")
      }
    }
  }

  // The stylesheet's word for a node: its kind.
  def kind_of(n ui.Node) String {
    if n.is(ui.Text) {
      return "text"
    }
    if n.is(ui.Button) {
      return "button"
    }
    if n.is(ui.TextInput) {
      return "input"
    }
    if n.is(ui.Image) {
      return "image"
    }
    if n.is(ui.Spacer) {
      return "spacer"
    }
    if n.is(ui.Column) {
      return "column"
    }
    if n.is(ui.Row) {
      return "row"
    }
    if n.is(ui.Scroll) {
      return "scroll"
    }
    // An unknown node class is a broken contract, not data: a renderer
    // that does not know a node cannot guess an element for it.
    raise Exception.new(message:
      "ui_browser: this renderer does not know the node class")
  }

  // An element showing a node's own props and styles, and nothing of its
  // children: what a new element is given, and what a continued one is
  // given again.
  def paint(h Int64, n ui.Node) {
    if n.is(ui.Text) {
      emo.dom_set_text(h, n.body())
    }
    if n.is(ui.Button) {
      emo.dom_set_text(h, n.label())
      emo.dom_set_prop(h, "type", "button")
      emo.dom_set_prop(h, "name", "event")
      emo.dom_set_prop(h, "value", n.event().to_string())
    }
    if n.is(ui.TextInput) {
      // The core's text input shows the model's value, and a field with
      // an event is editable: its tag rides the `name` `emo-<tag>` (the
      // same markup contract `ui_ssr` emits) and its `input` events
      // deliver what was typed. A kept field's text is written back
      // only where it differs from the model's — the keystrokes typed
      // since the last frame stay, and a model that answers the
      // delivery with a different value still wins.
      emo.dom_set_prop(h, "type", "text")
      if n.event() >= 0 {
        emo.dom_set_prop(h, "name", "emo-" + n.event().to_string())
        // The page's own Tab traversal needs the field in the order.
        emo.dom_set_prop(h, "tabindex", "0")
      } else {
        emo.dom_set_prop(h, "readOnly", true)
      }
      if emo.dom_value(h) != n.value() {
        emo.dom_set_prop(h, "value", n.value())
      }
    }
    if n.is(ui.Image) {
      emo.dom_set_prop(h, "src", n.src())
      emo.dom_set_prop(h, "alt", "")
    }
    apply_styles(h, self.kind_of(n), n.style())
  }

  // A node's element with everything below it: a first render's whole
  // work, and what a new or replaced slot still costs.
  def build(n ui.Node) Int64 {
    const h = self.make(n)
    self.paint(h, n)
    if n.is(ui.Button) {
      emo.dom_connect(h, "click", n.event())
    }
    if n.is(ui.TextInput) {
      if n.event() >= 0 {
        emo.dom_connect(h, "input", n.event())
        emo.dom_connect(h, "keydown", n.event())
      }
    }
    if carries(n) {
      const kids = n.children()
      for var i = 0; i < kids.length(); i = i + 1 {
        emo.dom_append(h, self.build(kids[i]))
      }
    }
    return h
  }

  // The element a node is: a span for a text, the control itself for a
  // button, an input and an image, a div for the rest.
  def make(n ui.Node) Int64 {
    if n.is(ui.Text) {
      return emo.dom_element("span")
    }
    if n.is(ui.Button) {
      return emo.dom_element("button")
    }
    if n.is(ui.TextInput) {
      return emo.dom_element("input")
    }
    if n.is(ui.Image) {
      return emo.dom_element("img")
    }
    if n.is(ui.Spacer) || carries(n) {
      return emo.dom_element("div")
    }
    raise Exception.new(message:
      "ui_browser: this renderer does not know the node class")
  }

  def run() {
  }
}

def backend(title String) ui.Backend {
  return Dom.new(title: title)
}
