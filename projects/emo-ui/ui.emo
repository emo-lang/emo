// The portable ui core: the node spine, the eight portable primitives,
// the typed Style with its layout vocabulary, the Elm loop with its event
// tags, and the Backend interface. Pure Emo — no platform, no FFI, no
// target-specific code — so one tree type is what every component returns
// and every backend consumes (docs/emo-ui.md, Layers 0, 3, 4, 5 and 6).
//
// Children are an explicit `Array[Node]` (docs/emo-ui.md, decision 3): a
// tree is nested calls, and a list that is not known until it is walked
// is built with the language's `ArrayBuilder` and handed over as
// `to_array()`. A trailing block is for callbacks and iteration, never
// for collecting children.

enum Align { start, center, end, stretch }

// Style is a typed value with a factory and `with_*` copies, because Emo
// has no default parameters (E4009): `text("a")` for a two-parameter def
// is refused, so the unstyled call is spelled `text("a", ui.style())`.
// `(R, Float64)` carries "unset or a value" — `(R.ok, 12.0)` is a width,
// `(R.error, 0.0)` is auto — and the slot is never read on the error
// branch. Every property is a layout property: the portable set is the
// intersection the four platforms can honor, and each maps it to its own
// native layout (docs/emo-ui.md, Layer 3).
class Style {
  def init(padding Float64, gap Float64, align Align, grow Bool,
           width (R, Float64), height (R, Float64)) {
    self.padding = padding
    self.gap = gap
    self.align = align
    self.grow = grow
    self.width = width
    self.height = height
  }

  def padding() Float64 {
    return self.padding
  }

  def gap() Float64 {
    return self.gap
  }

  def align() Align {
    return self.align
  }

  def grow() Bool {
    return self.grow
  }

  def width() (R, Float64) {
    return self.width
  }

  def height() (R, Float64) {
    return self.height
  }

  def with_padding(p Float64) Style {
    return Style.new(padding: p, gap: self.gap, align: self.align,
      grow: self.grow, width: self.width, height: self.height)
  }

  def with_gap(g Float64) Style {
    return Style.new(padding: self.padding, gap: g, align: self.align,
      grow: self.grow, width: self.width, height: self.height)
  }

  def with_align(a Align) Style {
    return Style.new(padding: self.padding, gap: self.gap, align: a,
      grow: self.grow, width: self.width, height: self.height)
  }

  def with_grow(g Bool) Style {
    return Style.new(padding: self.padding, gap: self.gap,
      align: self.align, grow: g, width: self.width, height: self.height)
  }

  def with_width(w Float64) Style {
    return Style.new(padding: self.padding, gap: self.gap,
      align: self.align, grow: self.grow, width: (R.ok, w),
      height: self.height)
  }

  def with_height(h Float64) Style {
    return Style.new(padding: self.padding, gap: self.gap,
      align: self.align, grow: self.grow, width: self.width,
      height: (R.ok, h))
  }
}

def style() Style {
  return Style.new(padding: 0.0, gap: 0.0, align: Align.start, grow: false,
    width: (R.error, 0.0), height: (R.error, 0.0))
}

// The spine: an interface plus concrete classes with typed props, so
// `Array[Node]` holds anything and each prop is checked at construction.
// It names itself in `children()`, which the checker accepts. A backend
// narrows with `is()` — it knows the core classes and its own platform's,
// and that union is its dispatch table.
interface Node {
  def style() Style
  def children() Array[Node]
}

class Column {
  def init(style Style, children Array[Node], key String) {
    self.style = style
    self.children = children
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return self.children
  }

  def key() String {
    return self.key
  }
}

class Row {
  def init(style Style, children Array[Node], key String) {
    self.style = style
    self.children = children
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return self.children
  }

  def key() String {
    return self.key
  }
}

class Scroll {
  def init(style Style, children Array[Node], key String) {
    self.style = style
    self.children = children
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return self.children
  }

  def key() String {
    return self.key
  }
}

class Text {
  def init(body String, style Style, mark Int64, key String) {
    self.body = body
    self.style = style
    self.mark = mark
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return []
  }

  def key() String {
    return self.key
  }

  def body() String {
    return self.body
  }

  // The mark (emo-desktop M35): the byte span a backend that carries
  // the vocabulary paints behind the body — the framebuffer's
  // selection highlight. -1 is no mark; the pack is the start above,
  // the length below. Every other backend paints the body plain: the
  // mark is the one property a backend may ignore, because a selection
  // is the painter's concern and no layout depends on it.
  def mark() Int64 {
    return self.mark
  }
}

// A button carries an event tag, never a closure: closures cannot cross
// the FFI (E4200), so `update` stays typed Emo-side while the backend
// only ever sees the `Int64` the tag registry handed out
// (docs/emo-ui.md, Layer 5).
class Button {
  def init(label String, event Int64, style Style, key String) {
    self.label = label
    self.event = event
    self.style = style
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return []
  }

  def key() String {
    return self.key
  }

  def label() String {
    return self.label
  }

  def event() Int64 {
    return self.event
  }
}

// A text input carries the tag typed text delivers under, the tag
// `on_text` registered for it. The field's text is the model's value;
// while the person is typing, a backend that owns the widget keeps the
// keystrokes in the widget and delivers them through this tag, and the
// next render's value — now the model's answer — is written back only
// where it differs. -1 is a display-only field, the mark's convention.
class TextInput {
  def init(value String, event Int64, style Style, key String) {
    self.value = value
    self.event = event
    self.style = style
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return []
  }

  def key() String {
    return self.key
  }

  def value() String {
    return self.value
  }

  def event() Int64 {
    return self.event
  }
}

class Image {
  def init(src String, style Style, key String) {
    self.src = src
    self.style = style
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return []
  }

  def key() String {
    return self.key
  }

  def src() String {
    return self.src
  }
}

class Spacer {
  def init(style Style, key String) {
    self.style = style
    self.key = key
  }

  def style() Style {
    return self.style
  }

  def children() Array[Node] {
    return []
  }

  def key() String {
    return self.key
  }
}

// The primitives are lowercase defs and take their children positionally;
// `.new` never appears in a tree. Names are convergent across the
// platform packages, so a component built from these compiles on all of
// them (docs/emo-ui.md, C3–C4).
def column(children Array[Node], style Style) Node {
  return Column.new(style: style, children: children, key: "")
}

def row(children Array[Node], style Style) Node {
  return Row.new(style: style, children: children, key: "")
}

def scroll(children Array[Node], style Style) Node {
  return Scroll.new(style: style, children: children, key: "")
}

def text(body String, style Style) Node {
  return Text.new(body: body, style: style, mark: 0 - 1, key: "")
}

// A text whose byte span `[start, start + len)` a backend may paint
// behind the body — the selection's highlight (emo-desktop M35). The
// indices are the body's own bytes; a backend that does not carry the
// vocabulary paints the body plain, which is every backend but the
// framebuffer's.
def marked_text(body String, start Int64, len Int64, style Style) Node {
  return Text.new(body: body, style: style,
    mark: (start << 32) | (len & 4294967295), key: "")
}

def button(label String, event Int64, style Style) Node {
  return Button.new(label: label, event: event, style: style, key: "")
}

def text_input(value String, event Int64, style Style) Node {
  return TextInput.new(value: value, event: event, style: style, key: "")
}

def image(src String, style Style) Node {
  return Image.new(src: src, style: style, key: "")
}

def spacer(style Style) Node {
  return Spacer.new(style: style, key: "")
}

// ---- Keys and the retained diff ----
//
// A tree is rebuilt on every event, so a backend that keeps its widgets
// — AppKit, GTK, the DOM — has to know which old node each new node
// continues; that is what lets a control keep its focus, and a list its
// scroll position, across a render. `diff` answers that once, for every
// backend: a `Patch` for each slot of the new tree, beside the node that
// fills it.
//
// Identity is position and kind. A child without a key continues the
// unkeyed child that held its position among its unkeyed siblings — the
// n-th unkeyed child of the old list — when the two are of the same
// class; a key overrides position, continuing the old child with the
// same key wherever it moved. The key is the node's own, set with
// `keyed`: identity is not a style, and a platform's own nodes carry no
// key and are never the same kind as anything, so they are rebuilt every
// frame — as every node was before the diff existed.

// The node it is given, carrying a key. The core's classes are the ones
// it knows, each by its own fields; the children are the same array the
// node held.
def keyed(key String, n Node) Node {
  if n.is(Text) {
    return Text.new(body: n.body(), style: n.style(), mark: n.mark(), key: key)
  }
  if n.is(Button) {
    return Button.new(label: n.label(), event: n.event(), style: n.style(),
      key: key)
  }
  if n.is(TextInput) {
    return TextInput.new(value: n.value(), event: n.event(), style: n.style(),
      key: key)
  }
  if n.is(Image) {
    return Image.new(src: n.src(), style: n.style(), key: key)
  }
  if n.is(Spacer) {
    return Spacer.new(style: n.style(), key: key)
  }
  if n.is(Column) {
    return Column.new(style: n.style(), children: n.children(), key: key)
  }
  if n.is(Row) {
    return Row.new(style: n.style(), children: n.children(), key: key)
  }
  if n.is(Scroll) {
    return Scroll.new(style: n.style(), children: n.children(), key: key)
  }
  // A node class this walk does not know cannot be copied, and handing
  // it back unkeyed would be a silent fallback: the key would not exist.
  raise Exception.new(message: "ui.keyed: this node class is not one of the core's")
}

// The same core class, which is what a kept widget can show again.
def same_kind(a Node, b Node) Bool {
  if a.is(Text) {
    return b.is(Text)
  }
  if a.is(Button) {
    return b.is(Button)
  }
  if a.is(TextInput) {
    return b.is(TextInput)
  }
  if a.is(Image) {
    return b.is(Image)
  }
  if a.is(Spacer) {
    return b.is(Spacer)
  }
  if a.is(Column) {
    return b.is(Column)
  }
  if a.is(Row) {
    return b.is(Row)
  }
  if a.is(Scroll) {
    return b.is(Scroll)
  }
  return false
}

// A node's key; "" when it has none or is not one of the core's.
def key_of(n Node) String {
  if n.is(Text) {
    return n.key()
  }
  if n.is(Button) {
    return n.key()
  }
  if n.is(TextInput) {
    return n.key()
  }
  if n.is(Image) {
    return n.key()
  }
  if n.is(Spacer) {
    return n.key()
  }
  if n.is(Column) {
    return n.key()
  }
  if n.is(Row) {
    return n.key()
  }
  if n.is(Scroll) {
    return n.key()
  }
  return ""
}

// One slot of a retained diff: a node of the new tree and where it came
// from. `kept` says the widget a backend holds for `old` continues as
// this node's — the same class at the same identity. A slot that is not
// kept is new, when `old` is an error, or replaced, when `old` is the
// node it displaces. `was` is the old child's index among the old
// children (-1 for a new one). `path` and `from` are the slot's address
// in the new tree and in the old one — the root is "", a child appends
// its index — so a backend that holds its widgets in a flat table has a
// name to keep them under. `kids` is the new children, in order.
class Patch {
  def init(node Node, old (R, Node), kept Bool, was Int64, path String,
           from String, kids Array[Patch]) {
    self.node = node
    self.old = old
    self.kept = kept
    self.was = was
    self.path = path
    self.from = from
    self.kids = kids
  }

  def node() Node {
    return self.node
  }

  def old() (R, Node) {
    return self.old
  }

  def kept() Bool {
    return self.kept
  }

  def was() Int64 {
    return self.was
  }

  def path() String {
    return self.path
  }

  def from() String {
    return self.from
  }

  def kids() Array[Patch] {
    return self.kids
  }
}

// The old children a diff's node no longer names, ascending by their old
// index — the children of a kept container that no new child keeps or
// replaces. A backend removes them in the reverse order, so each index
// still names the child it did.
def gone(p Patch) Array[Int64] {
  const before = p.old()
  case before {
    (R.error, _) then { return [] }
    (R.ok, was_node) then {
      const olds = was_node.children()
      const out = ArrayBuilder.new()
      for var i = 0; i < olds.length(); i = i + 1 {
        if !named_at(p.kids(), i) {
          out.push(i)
        }
      }
      return out.to_array()
    }
  }
}

// Whether one of a diff's children names the old child at `i`: the child
// it keeps, or the one it replaces and so drops there itself.
def named_at(kids Array[Patch], i Int64) Bool {
  for var j = 0; j < kids.length(); j = j + 1 {
    if kids[j].was() == i {
      return true
    }
  }
  return false
}

// The old tree against the new one: a `Patch` for the root, its children
// below it.
def diff(old Node, next Node) Patch {
  return diff_at((R.ok, old), next, -1, "", "")
}

// A tree as its own diff, every slot new: what a first render is laid
// out against, which is nothing.
def fresh(next Node) Patch {
  return diff_at((R.error, next), next, -1, "", "")
}

// One slot. A kept container plans its children against the old ones; a
// slot that is not kept is whole — every node below it is new, whatever
// stood there.
def diff_at(old (R, Node), next Node, was Int64, path String,
            from String) Patch {
  const kids = next.children()
  case old {
    (R.ok, was_node) then {
      if same_kind(was_node, next) {
        const olds = was_node.children()
        const plan = plan_kids(olds, kids)
        return Patch.new(node: next, old: old, kept: true, was: was,
          path: path, from: from, kids: diff_kids(olds, kids, plan, path,
            from))
      }
      return Patch.new(node: next, old: old, kept: false, was: was,
        path: path, from: "", kids: diff_kids([], kids, plan_kids([], kids),
          path, ""))
    }
    (R.error, _) then { }
  }
  return Patch.new(node: next, old: old, kept: false, was: -1, path: path,
    from: "", kids: diff_kids([], kids, plan_kids([], kids), path, ""))
}

def diff_kids(olds Array[Node], kids Array[Node], plan Array[Int64],
              path String, from String) Array[Patch] {
  const out = ArrayBuilder.new()
  for var j = 0; j < kids.length(); j = j + 1 {
    const i = plan[j]
    const at = path + "/" + j.to_string()
    if i >= 0 {
      out.push(diff_at((R.ok, olds[i]), kids[j], i, at,
        from + "/" + i.to_string()))
    } else {
      out.push(diff_at((R.error, kids[j]), kids[j], -1, at, ""))
    }
  }
  return out.to_array()
}

// Which old child each new child names, by identity: one entry per new
// child, the old child's index or -1 for a child that is new. The keyed
// children claim theirs first, by key; the unkeyed then take their
// position among the unkeyed, which a keyed sibling's arrival or
// departure leaves alone. Whether the child named continues — the same
// class — is `diff_at`'s to say: a position whose class changed names
// the child it displaces.
def plan_kids(olds Array[Node], kids Array[Node]) Array[Int64] {
  const out = ArrayBuilder.new()
  const taken = ArrayBuilder.new()
  for var j = 0; j < kids.length(); j = j + 1 {
    const k = key_of(kids[j])
    if k == "" {
      out.push(-1)
    } else {
      // Two children under one key would name one widget twice.
      if has_key_before(kids, j, k, 0) {
        raise Exception.new(message:
          "ui.diff: two children of one node share the key \"${k}\"")
      }
      const i = keyed_at(olds, k, taken.to_array(), 0)
      out.push(i)
      if i >= 0 {
        taken.push(i)
      }
    }
  }
  const plan = out.to_array()
  var u = 0
  for var j = 0; j < kids.length(); j = j + 1 {
    if key_of(kids[j]) == "" {
      plan[j] = unkeyed_at(olds, u, 0, 0)
      u = u + 1
    }
  }
  return plan
}

// Whether a key appears among the children before `j`.
def has_key_before(kids Array[Node], j Int64, k String, i Int64) Bool {
  if i >= j {
    return false
  }
  if key_of(kids[i]) == k {
    return true
  }
  return has_key_before(kids, j, k, i + 1)
}

// The old child that carries the key, the first one not yet named; -1
// when there is none.
def keyed_at(olds Array[Node], k String, taken Array[Int64],
             i Int64) Int64 {
  if i >= olds.length() {
    return -1
  }
  if key_of(olds[i]) == k {
    if !has(taken, i, 0) {
      return i
    }
  }
  return keyed_at(olds, k, taken, i + 1)
}

// The index of the `u`-th unkeyed old child; -1 when there is none.
def unkeyed_at(olds Array[Node], u Int64, seen Int64, i Int64) Int64 {
  if i >= olds.length() {
    return -1
  }
  if key_of(olds[i]) == "" {
    if seen == u {
      return i
    }
    return unkeyed_at(olds, u, seen + 1, i + 1)
  }
  return unkeyed_at(olds, u, seen, i + 1)
}

def has(xs Array[Int64], x Int64, i Int64) Bool {
  if i >= xs.length() {
    return false
  }
  if xs[i] == x {
    return true
  }
  return has(xs, x, i + 1)
}

// ---- The raw loop's key vocabulary ----
//
// One event per key, shared by the backends that translate a device's
// reports and the applications that read them. A printable key is its
// own byte, and the ASCII control codes a Ctrl chord produces are the
// chords' bytes (`Ctrl+Q` is 17, `Ctrl+S` is 19); every key that has no
// byte — the arrows, Home and End — is a number above 255, so no
// serial byte and no printable key can ever be mistaken for one. The
// vocabulary is the core's because it is a contract, not a layout: the
// keys' placement and the shift level are the backend's (the desktop's
// seat speaks the US layout), the meanings are these.
def key_backspace() Int64 {
  return 8
}

def key_tab() Int64 {
  return 9
}

def key_enter() Int64 {
  return 10
}

def key_quit() Int64 {
  return 17
}

def key_delete() Int64 {
  return 127
}

def key_left() Int64 {
  return 1001
}

def key_right() Int64 {
  return 1002
}

def key_up() Int64 {
  return 1003
}

def key_down() Int64 {
  return 1004
}

def key_home() Int64 {
  return 1005
}

def key_end() Int64 {
  return 1006
}

// The selection's extension keys (emo-desktop M35): Shift with a
// movement. A seat that tracks the modifier answers these in place of
// the movement's own number, so an application tells an extending move
// from a collapsing one without seeing the modifier itself.
def key_shift_left() Int64 {
  return 1011
}

def key_shift_right() Int64 {
  return 1012
}

def key_shift_up() Int64 {
  return 1013
}

def key_shift_down() Int64 {
  return 1014
}

def key_shift_home() Int64 {
  return 1015
}

def key_shift_end() Int64 {
  return 1016
}

// ---- The Elm loop (docs/emo-ui.md, Layer 5) ----
//
// A model, a pure `update`, a pure `view`, and a backend that delivers
// event tags. This is the only place the core holds mutable state — the
// model, the tree it last rendered, and the tag table — and all three
// live in `Box`es, because `init` is a class's only window for assigning
// a field (docs/intro/syntax.md), so anything that changes afterwards is
// a `Box`.
//
// `view`, `update` and the initial model arrive as `Block`, the
// language's spelling for the unknown tier, because an application's
// types cannot be named here. Typing resumes at the application's own
// signatures; the entry module's wiring is the unchecked callback
// boundary docs/emo-ui.md records under "A worked shape".

// The event sink. A backend delivers an event by calling
// `deliver(tag, text)`, which is the whole of what it knows about the
// application — one integer per event, plus the text when the event is
// a field's: a click's text is "", a typed text rides with its tag. One
// method is deliberate — the C→Emo callback contract names a
// single-method interface as the callback type (CHECK.md), so a native
// shim reaches the sink through its trampoline exactly as it reaches any
// other callback, and the payload crosses as the method's own marshaled
// parameter.
interface Events {
  def deliver(tag Int64, text String) Void
}

// The tag table: a tag is the index of the message it stands for, and
// `on` hands back the tag a message already has. Stability is the point
// of the dedup — a tree is rebuilt on every event, and a backend that saw
// a new integer for the same button each render would see a new widget
// each render. The table is `Block`-valued because the core cannot name
// an application's message type: this is the loop's one untyped slot, and
// it is the FFI seam decision 6 puts the boundary at.
//
// A message that carries a value cannot be `on`'d — it is a distinct
// message per value, so a message built from a changing string (a text
// field's own contents) would allocate a tag per render. `on_text` is
// the answer: the application registers a *factory*, a `Block` that
// builds the message from the typed text, under a name of its choosing,
// and the name is what the tag dedups on — the tag is stable across
// renders, and delivery calls the factory with what was typed. The
// registry cannot compare two `Block`s for equality, so a name that is
// already registered answers its tag and the factory stored first is the
// one every delivery goes through; the view passes the same factory each
// render, and the name is the contract. An empty name is refused — there
// is no field it names.
//
// The table is an object the loop owns and hands to `view`, not a
// module-level binding — a module-level `const` lowers to a thunk that
// re-runs its initializer on every read, so a table declared there would
// be a fresh, empty one per read on every compiled target (`CHECK.md`,
// module-level bindings). Owning it in the loop is also the shape that
// matches the thing itself: the table belongs to one running loop, so two
// loops in one process keep two tables instead of sharing one.
class Registry {
  def init() {
    self.table = Box.new([])
    // One mark per tag: whether the tag's delivery carries text (a
    // factory slot, from `on_text`), and the name it dedups on. Three
    // arrays grow in step; the tag indexes all three.
    self.carries = Box.new([])
    self.names = Box.new([])
  }

  def index_of(msg Block, i Int64) Int64 {
    const reg = self.table.read()
    if i >= reg.length() {
      return -1
    }
    if reg[i] == msg {
      return i
    }
    return self.index_of(msg, i + 1)
  }

  def named_at(name String, i Int64) Int64 {
    const marks = self.names.read()
    if i >= marks.length() {
      return -1
    }
    if marks[i] == name {
      return i
    }
    return self.named_at(name, i + 1)
  }

  def on(msg Block) Int64 {
    const known = self.index_of(msg, 0)
    if known >= 0 {
      return known
    }
    const reg = self.table.read()
    self.table.replace(reg.append(msg))
    self.carries.replace(self.carries.read().append(false))
    self.names.replace(self.names.read().append(""))
    return reg.length()
  }

  def on_text(name String, make Block) Int64 {
    if name == "" {
      raise Exception.new(message: "ui.on_text: the name is empty")
    }
    const known = self.named_at(name, 0)
    if known >= 0 {
      return known
    }
    const reg = self.table.read()
    self.table.replace(reg.append(make))
    self.carries.replace(self.carries.read().append(true))
    self.names.replace(self.names.read().append(name))
    return reg.length()
  }

  // The message a delivery becomes. A click tag dispatches its message;
  // a text tag calls its factory with what was typed. Text on a click
  // tag is a backend bug, refused here where it is made.
  def message_for(tag Int64, text String) Block {
    if self.carries.read()[tag] {
      const make = self.table.read()[tag]
      return make(text)
    }
    if text != "" {
      raise Exception.new(message:
        "ui: the event at tag ${tag} carries text, and no field registered it")
    }
    return self.table.read()[tag]
  }

  // An unregistered tag is a backend bug, not data: indexing the table
  // raises, which is the language's answer for a broken contract.
  def dispatch(tag Int64) Block {
    return self.table.read()[tag]
  }
}

class App {
  def init(view Block, update Block, model Block, backend Backend) {
    self.view_fn = Box.new(view)
    self.update_fn = Box.new(update)
    self.model = Box.new(model)
    self.backend = backend
    self.registry = Registry.new()
    self.current = Box.new(view(self.registry, model))
  }

  // One event, start to finish: the delivery becomes its message — a
  // click tag dispatches the message it was registered with, a field's
  // tag builds one through its factory — the message becomes the next
  // model, the model becomes the next tree, and the backend gets both
  // trees. `patch` is handed the tree the backend last saw — what a
  // retained backend diffs against, and what a full-rebuild one (a
  // terminal repaint, a one-shot HTML render) ignores.
  //
  // The view and the update sit in `Box`es rather than in plain fields
  // because `self.view(...)` reads as a method call wherever a class has
  // no method of that name, and Emo cannot call a `Block` out of a field.
  def deliver(tag Int64, text String) Void {
    const next = self.update_fn.read()(self.registry.message_for(tag, text),
      self.model.read())
    self.model.replace(next)
    const tree = self.view_fn.read()(self.registry, next)
    self.backend.patch(self.current.read(), tree)
    self.current.replace(tree)
  }

  def root() Node {
    return self.current.read()
  }
}

// The entry module's whole body (docs/emo-ui.md, "A worked shape"): the
// application's three functions, its initial model, and the backend.
// `view` takes the loop's `Registry` and then the model.
def run(view Block, update Block, model Block, backend Backend) Void {
  const app = App.new(view: view, update: update, model: model,
    backend: backend)
  backend.mount(app.root(), app)
  backend.run()
}

// The raw loop: the same application shape, the event handed to
// `update` as itself. A tag table exists to turn a backend's small,
// stable integer into a message value; an application whose messages
// are themselves integers — a text editor's keys, one per byte and one
// per editing op — has nothing to turn. Registering a hundred messages
// and deduplicating them linearly on every render would allocate more
// than the frame paints on the metal; here there is no table, no
// lookup, and the event is the message. The view still receives a
// registry (born empty, and an application ready for buttons fills it
// as `run`'s does), so both loops share one application shape.
class RawApp {
  def init(view Block, update Block, model Block, backend Backend) {
    self.view_fn = Box.new(view)
    self.update_fn = Box.new(update)
    self.model = Box.new(model)
    self.backend = backend
    self.registry = Registry.new()
    self.current = Box.new(view(self.registry, model))
  }

  def deliver(tag Int64, text String) Void {
    // The raw loop's message is the tag itself: an event with a payload
    // has no integer to be, so text here is a wiring mistake, refused
    // where it is made. A field's typed text belongs to the tagged loop.
    if text != "" {
      raise Exception.new(message:
        "ui.run_raw: the event at tag ${tag} carries text, and the raw loop's messages are the tags themselves")
    }
    const next = self.update_fn.read()(tag, self.model.read())
    self.model.replace(next)
    const tree = self.view_fn.read()(self.registry, next)
    self.backend.patch(self.current.read(), tree)
    self.current.replace(tree)
  }

  def root() Node {
    return self.current.read()
  }
}

// The raw entry point, `run`'s sibling.
def run_raw(view Block, update Block, model Block, backend Backend) Void {
  const app = RawApp.new(view: view, update: update, model: model,
    backend: backend)
  backend.mount(app.root(), app)
  backend.run()
}

// The backend seam is an Emo interface, not a C ABI: the nine-verb
// `ui_*` contract the native spikes proved is an implementation detail
// behind it (docs/emo-ui.md, Layer 6). `mount` hands the backend the
// first tree and the sink it delivers events into; `patch` is the growth
// edge — a full rebuild is right for the terminal and SSR backends, a
// retained patch for the native and DOM ones.
interface Backend {
  def mount(root Node, events Events) Void
  def patch(old Node, new Node) Void
  def run() Void
}
