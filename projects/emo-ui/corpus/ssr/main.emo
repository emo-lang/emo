require "emo/ui"
require "emo/ui_ssr"
require "emo/ui_corpus"

// The server-rendered entry of the convergence corpus (T48.12): the
// shared application, rendered by `ui_ssr`. `mount` prints the page and
// `patch` prints a fragment per event; the script — inc, inc, dec,
// submit, the tags `view` registers — is the same one every backend
// entry steps. The interpreter's output is `expected.txt`, and every
// hosted target has to produce those bytes exactly.

def main() {
  const backend = ui_ssr.backend("Emo counter")
  ui.run(ui_corpus.view, ui_corpus.update, ui_corpus.initial(), backend)
  backend.deliver(0)
  backend.deliver(0)
  backend.deliver(1)
  backend.deliver(2)
}

main()
