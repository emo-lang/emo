// The convergence corpus application (T48.12): one portable module that
// every backend runs, unchanged. It carries the four things a UI is made
// of — state (the counter), a form (the field that takes typed text and
// the button that submits it), a list (the scrolled items) and events
// (the tags `view` registers).
//
// Nothing here names a platform. Each backend's entry module requires
// `emo/ui_corpus` and hands these three functions to `ui.run`; the only
// per-platform code is the backend package and that entry. `update`
// prints each state transition, so every backend's run has the same
// bytes on stdout whatever it does with the tree.
//
// The messages are classes, not an enum, and that is the payload
// decision's own lesson: `is()` raises on an enum member, so a loop
// that takes one field's typed text takes every message as a class
// instance. A click's message is a field-less class — `==` on instances
// is structural, so `on` dedups it to one stable tag — and a field's is
// a class the factory builds from what came, registered under a name so
// the tag is stable across renders. The draft field's factory reads the
// delivery's key: Enter on the focused field submits, exactly as the
// submit button does.

class Inc {
  def init() {
  }
}

class Dec {
  def init() {
  }
}

class Submit {
  def init() {
  }
}

class Typed {
  def init(text String) {
    self.text = text
  }

  def text() String {
    return self.text
  }
}

class Model {
  def init(count Int64, draft String) {
    self.count = count
    self.draft = draft
  }

  def count() Int64 {
    return self.count
  }

  def draft() String {
    return self.draft
  }
}

def initial() Model {
  return Model.new(count: 0, draft: "")
}

def update(msg Block, m Model) Model {
  if msg.is(Inc) {
    println("inc ${m.count() + 1}")
    return Model.new(count: m.count() + 1, draft: m.draft())
  }
  if msg.is(Dec) {
    println("dec ${m.count() - 1}")
    return Model.new(count: m.count() - 1, draft: m.draft())
  }
  if msg.is(Submit) {
    println("submit ${m.count()} draft ${m.draft()}")
    return m
  }
  if msg.is(Typed) {
    println("draft ${msg.text()}")
    return Model.new(count: m.count(), draft: msg.text())
  }
  return m
}

def view(reg ui.Registry, m Model) ui.Node {
  // The tags are taken in statements of their own: `on` is a side effect,
  // and this registration order is what fixes inc, dec, submit and the
  // draft field at tags 0, 1, 2 and 3 on every run.
  const inc = reg.on(Inc.new())
  const dec = reg.on(Dec.new())
  const submit = reg.on(Submit.new())
  const draft = reg.on_input("draft", -> (t String, k Int64) {
    if k == ui.key_enter() {
      return Submit.new()
    }
    return Typed.new(text: t)
  })
  const items = ArrayBuilder.new()
  items.push(ui.text("first", ui.style()))
  items.push(ui.text("second", ui.style()))
  items.push(ui.image("logo.png", ui.style()))
  return ui.column([
    ui.text("Emo counter", ui.style()),
    ui.row([
      ui.button("inc", inc, ui.style()),
      ui.button("dec", dec, ui.style())
    ], ui.style().with_gap(8.0)),
    ui.text_input("count = ${m.count()}", 0 - 1, ui.style()),
    ui.text_input(m.draft(), draft, ui.style()),
    ui.scroll(items.to_array(), ui.style().with_height(120.0)),
    ui.button("submit", submit, ui.style()),
    ui.spacer(ui.style().with_grow(true))
  ], ui.style().with_padding(12.0).with_gap(8.0))
}
