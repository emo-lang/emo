require "emo/ui"
require "emo/ui_tui"
require "emo/ui_corpus"

// The terminal entry of the convergence corpus (T48.12): the shared
// application, painted by `ui_tui`. The input is a script rather than a
// terminal, so the bytes are fixed — inc, inc, dec, submit, the tags
// `view` registers, in a 34x13 frame. `wasm` is not a target here: the
// terminal backend writes stdout and the runtime has no `printf`.
// The interpreter's output is `expected.txt`.

def main() {
  const backend = ui_tui.backend(width: 34, height: 13,
    input: ui_tui.script([0, 0, 1, 2]))
  ui.run(ui_corpus.view, ui_corpus.update, ui_corpus.initial(), backend)
}

main()
