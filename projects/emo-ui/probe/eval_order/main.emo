// Operand evaluation order, isolated. A side effect sitting in an
// operand position happens in whatever order the target evaluates
// operands in; the rule is left to right, everywhere:
//
//   emo run main.emo           -> 12 = 3
//   build --target ocaml       -> 12 = 3
//   build --target c / typescript / beam / wasm   -> 12 = 3
//
// `ocaml` used to print `21 = 3` for this program: `emo_codegen.ml`
// wrote a call as `func [a1; a2]`, OCaml evaluates a constructor's
// arguments right to left, and the host language's rule reached Emo's.
// The emitter now binds each operand to a local in source order, so all
// five operand positions — a call's arguments, an array literal's
// elements, a binary operator's operands, an interpolation's parts, and
// named arguments — run left to right. This probe is what caught it, and
// `check.sh` pins the interpreter and `ocaml` to the same line.

def note(trace Box[String], i Int64) Int64 {
  trace.replace(trace.read() + "${i}")
  return i
}

def two(a Int64, b Int64) Int64 {
  return a + b
}

def main() {
  const trace = Box.new("")
  const sum = two(note(trace, 1), note(trace, 2))
  println("${trace.read()} = ${sum}")
}

main()
