// Interpolating an enum uses the interpreter's bare-tag display form on
// every hosted target. The tuple carrying R.ok follows the same rule:
//
//   emo run / ocaml / c / typescript / wasm / beam -> red (ok, 12.5)
//
// This probe is the regression case for T48.3. `wasm` handles both the
// enum value and the tuple wrapper; `beam` handles the enum conversion
// instead of raising `emo_no_to_str`.

enum Color { red, green }

def slot() (R, Float64) {
  return (R.ok, 12.5)
}

def main() {
  const s = slot()
  println("${Color.red} ${s}")
}

main()
