// The lowering (module `lower`): turns the parsed tree into ordinary
// Emo — nested calls with explicit `Array[Node]` children, and an
// `ArrayBuilder` wherever a child list is not known until it is walked.
// This is the settled spelling (docs/emo-ui.md, decision 3) written by
// the translator so the author does not have to: a static block lowers
// to an array literal, a block containing an iteration or a conditional
// lowers to builder statements, and the iteration's call vanishes — its
// children land in the enclosing builder.
//
// One builder per dynamic container, numbered in emission order; the
// counters reset per def, so the output is deterministic.
//
// Component names are matched by their last path segment against the
// portable core's convergent names, whose signatures are fixed:
//
//   column/row/scroll(children Array[Node], style Style)
//   text(body String, style Style)   button(label String, event Int64, style Style)
//   text_input(value String, style Style)   image(src String, style Style)
//   spacer(style Style)
//
// A core container takes its children from the block and its style from
// an optional `style:` argument (default `ui.style()`); a core leaf
// takes its props positionally and gets a default style appended, or
// passes a `style:` through when it has no positional props. Any other
// call is a user component: children pass as a final positional
// `Array[Node]` parameter, so a component that takes children declares
// that array last.

class Lowerer {
  def init() {
    self.kids_n = Box.new(0)
    self.src_n = Box.new(0)
    self.idx_n = Box.new(0)
  }

  // ---- entry ----

  def run(model tree.FileModel) String {
    var out = self.generated_note()
    out = out + model.header()
    var i = 0
    while i < model.defs().length() {
      out = out + "\n// from line "
        + model.defs()[i].line().to_string() + "\n"
        + self.emit_def(model.defs()[i])
      i = i + 1
    }
    return out
  }

  def generated_note() String {
    return "// generated by the emo-ui translator from a .emoui source.\n"
      + "// Edit the .emoui and regenerate; this file is not hand-edited.\n"
  }

  def emit_def(v tree.ViewDef) String {
    self.kids_n.replace(0)
    self.src_n.replace(0)
    self.idx_n.replace(0)
    const out = v.header() + " {\n"
    const body = v.body()
    if body.is(tree.Container) {
      if !self.block_dyn(body.kids()) {
        return out + "  return " + self.static_expr(body) + "\n}\n"
      }
      const b = self.fresh_kids()
      return out + "  const " + b + " = ArrayBuilder.new()\n"
        + self.items_lines(b, body.kids(), 1)
        + "  return " + self.call_text(body.path(), body.args(),
          b + ".to_array()") + "\n}\n"
    }
    if body.is(tree.Iter) || body.is(tree.Cond) {
      raise Exception.new(message: self.fail_at(v.line(),
        "the root of a view def is a component call, not an iteration"
        + " or a conditional"))
    }
    return out + "  return " + self.static_expr(body) + "\n}\n"
  }

  // ---- statements: the dynamic half ----

  // Lines that push each item's node into `b`, at `ind` levels of
  // indentation.
  def items_lines(b String, items Array[tree.TreeItem],
                  ind Int64) String {
    var out = ""
    var i = 0
    while i < items.length() {
      out = out + self.item_lines(b, items[i], ind)
      i = i + 1
    }
    return out
  }

  def item_lines(b String, item tree.TreeItem, ind Int64) String {
    const pad = self.indent(ind)
    if item.is(tree.LeafCall) {
      return pad + b + ".push(" + self.static_expr(item) + ")\n"
    }
    if item.is(tree.Container) {
      if !self.block_dyn(item.kids()) {
        return pad + b + ".push(" + self.static_expr(item) + ")\n"
      }
      const k = self.fresh_kids()
      return pad + "const " + k + " = ArrayBuilder.new()\n"
        + self.items_lines(k, item.kids(), ind)
        + pad + b + ".push(" + self.call_text(item.path(), item.args(),
          k + ".to_array()") + ")\n"
    }
    if item.is(tree.Iter) {
      const src = self.fresh_src()
      const ix = self.fresh_idx()
      return pad + "const " + src + " = " + item.src() + "\n"
        + pad + "for var " + ix + " = 0; " + ix + " < " + src
        + ".length(); " + ix + " = " + ix + " + 1 {\n"
        + pad + "  const " + item.bind() + " = " + src + "[" + ix + "]\n"
        + self.items_lines(b, item.kids(), ind + 1)
        + pad + "}\n"
    }
    if item.is(tree.Cond) {
      const lines = pad + "if " + item.cond() + " {\n"
        + self.items_lines(b, item.kids(), ind + 1)
        + pad + "}"
      if item.else_kids().length() == 0 {
        return lines + "\n"
      }
      return lines + " else {\n"
        + self.items_lines(b, item.else_kids(), ind + 1)
        + pad + "}\n"
    }
    raise Exception.new(message: "emoui: internal: unknown tree item")
  }

  // ---- expressions: the static half ----

  def static_expr(item tree.TreeItem) String {
    if item.is(tree.LeafCall) {
      return self.call_text(item.path(), item.args(), "")
    }
    if item.is(tree.Container) {
      return self.call_text(item.path(), item.args(),
        "[" + self.kids_exprs(item.kids()) + "]")
    }
    raise Exception.new(message: "emoui: internal: a conditional or an"
      + " iteration has no expression form")
  }

  def kids_exprs(items Array[tree.TreeItem]) String {
    var out = ""
    var i = 0
    while i < items.length() {
      if i > 0 {
        out = out + ", "
      }
      out = out + self.static_expr(items[i])
      i = i + 1
    }
    return out
  }

  // ---- the component table ----

  // The output call: `kids` is the children expression, "" when the
  // call takes none.
  def call_text(path String, args Array[tree.Arg], kids String) String {
    const seg = self.last_seg(path)
    if self.is_core_container(seg) {
      return self.core_container_call(path, args, kids)
    }
    if self.is_core_leaf(seg) {
      return self.core_leaf_call(path, args)
    }
    return self.user_call(path, args, kids)
  }

  def core_container_call(path String, args Array[tree.Arg],
                          kids String) String {
    var style = ""
    var i = 0
    while i < args.length() {
      const a = args[i]
      if a.name() == "style" {
        style = a.expr()
      } else {
        self.refuse(path, "takes its children from the block and only a"
          + " `style:` argument")
      }
      i = i + 1
    }
    if style == "" {
      style = "ui.style()"
    }
    return path + "(" + kids + ", " + style + ")"
  }

  def core_leaf_call(path String, args Array[tree.Arg]) String {
    const seg = self.last_seg(path)
    var positional = 0
    var style = ""
    var i = 0
    while i < args.length() {
      const a = args[i]
      if a.name() == "" {
        positional = positional + 1
      } else {
        if a.name() == "style" {
          style = a.expr()
        } else {
          self.refuse(path, "takes its props positionally and only `style:`"
            + " by name")
        }
      }
      i = i + 1
    }
    if seg == "spacer" && positional > 0 {
      self.refuse(path, "takes only a style")
    }
    if positional > 0 {
      if style != "" {
        self.refuse(path, "takes its style positionally after its props;"
          + " `style:` cannot sit beside positional arguments")
      }
      return path + "(" + self.positional_args(args) + ", ui.style())"
    }
    if style != "" {
      return path + "(style: " + style + ")"
    }
    return path + "(style: ui.style())"
  }

  def user_call(path String, args Array[tree.Arg], kids String) String {
    if kids == "" {
      return path + "(" + self.source_order_args(args) + ")"
    }
    var i = 0
    while i < args.length() {
      if args[i].name() != "" {
        self.refuse(path, "passes children positionally as its last"
          + " argument, so this call cannot also name arguments")
      }
      i = i + 1
    }
    const pos = self.positional_args(args)
    if pos == "" {
      return path + "(" + kids + ")"
    }
    return path + "(" + pos + ", " + kids + ")"
  }

  def positional_args(args Array[tree.Arg]) String {
    var out = ""
    var i = 0
    while i < args.length() {
      if args[i].name() == "" {
        if out != "" {
          out = out + ", "
        }
        out = out + args[i].expr()
      }
      i = i + 1
    }
    return out
  }

  def source_order_args(args Array[tree.Arg]) String {
    var out = ""
    var i = 0
    while i < args.length() {
      if out != "" {
        out = out + ", "
      }
      if args[i].name() != "" {
        out = out + args[i].name() + ": "
      }
      out = out + args[i].expr()
      i = i + 1
    }
    return out
  }

  // ---- dynamicness ----

  def block_dyn(items Array[tree.TreeItem]) Bool {
    var i = 0
    while i < items.length() {
      if self.item_dyn(items[i]) {
        return true
      }
      i = i + 1
    }
    return false
  }

  def item_dyn(item tree.TreeItem) Bool {
    if item.is(tree.Iter) || item.is(tree.Cond) {
      return true
    }
    if item.is(tree.Container) {
      return self.block_dyn(item.kids())
    }
    return false
  }

  // ---- counters and small helpers ----

  def fresh_kids() String {
    self.kids_n.replace(self.kids_n.read() + 1)
    return "__kids_" + self.kids_n.read().to_string()
  }

  def fresh_src() String {
    self.src_n.replace(self.src_n.read() + 1)
    return "__src_" + self.src_n.read().to_string()
  }

  def fresh_idx() String {
    self.idx_n.replace(self.idx_n.read() + 1)
    return "__i_" + self.idx_n.read().to_string()
  }

  def refuse(path String, what String) {
    raise Exception.new(message: "emoui: a call of \"" + path
      + "\" " + what)
  }

  def fail_at(line Int64, what String) String {
    return "line " + line.to_string() + ": " + what
  }

  def indent(n Int64) String {
    if n <= 0 {
      return ""
    }
    return "  " + self.indent(n - 1)
  }

  // The path's last segment: `ui.column` and `column` both meet the
  // core's convergent name.
  def last_seg(path String) String {
    const b = path.to_bytes()
    return self.seg_from(b, b.length() - 1, b.length())
  }

  def seg_from(b Bytes, i Int64, end Int64) String {
    if i < 0 {
      return lex.slice(b, 0, end)
    }
    if b.get(i) == 46 {
      return lex.slice(b, i + 1, end)
    }
    return self.seg_from(b, i - 1, end)
  }

  def is_core_container(seg String) Bool {
    return seg == "column" || seg == "row" || seg == "scroll"
  }

  def is_core_leaf(seg String) Bool {
    return seg == "text" || seg == "button" || seg == "text_input"
      || seg == "image" || seg == "spacer"
  }
}

// The translator's entry: a source text in, generated Emo out.
def translate(source String) String {
  const d = source.to_bytes()
  case tree.parse(d) {
    (R.error, why) -> {
      raise Exception.new(message: "emoui: " + why)
    }
    (R.ok, model) -> {
      return Lowerer.new().run(model)
    }
  }
}
