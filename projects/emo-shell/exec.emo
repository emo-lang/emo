require "os"

// The executor and the session driver. The driver reads lines until
// the input ends or `exit` stops the shell; each line goes lex →
// parse → the item walk. A malformed line is a value, the session
// prints the reason and carries on with status 2 — the classic
// shells' syntax-error status — in an interactive session; a script
// carries on too, dying only when the line walk says so, because a
// script that stops at its first typo hides the rest of the damage.
//
// The session itself opens three ways: bare, reading fd 0 with a
// prompt when it is a terminal; with a script file, whose lines run
// and whose arguments become the positionals; and `-c LINE`, the one
// line run and its status the shell's. A script that cannot open
// leaves with 127, a broken invocation with 2.
//
// The walk itself is the classic one: run the pipeline, then let the
// connector that follows decide whether the next item runs at all —
// `;` always, `&&` on success, `||` on failure, with a skipped item's
// status carried forward untouched so `false && x || y` runs y.
//
// A pipeline of one command stays in this process when it can (a
// builtin without redirections); everything else forks — one child
// per stage, stages wired through pipes with dup2, redirections
// opened onto the child's descriptors (`2>&1` aiming a descriptor at
// another's), the child resetting the interactive dispositions before
// its exec (an ignored disposition survives the exec; a default one
// lets Ctrl-C kill the command the way it should). The words expand
// once — in the parent for the single command, in each stage's child
// for a pipeline — and a word the user typed a pattern into answers
// the directory names it matched, or refuses the command when it
// matched none. The pipeline's status is its last stage's, a signal
// death counting as 128 + signal, the classic encoding.

// The session's opening moves: sig_pipe ignored in every mode (a
// write into a dead pipe must not kill the shell), sig_int and
// sig_quit ignored in an interactive one (Ctrl-C discards the line,
// the shell survives), and the mode itself decided by the command
// line — a script file, `-c`, or fd 0's tty.
def start() shell.Shell {
  os.signal_ignore(os.sig_pipe)
  const argv = os.argv()
  var name = "emosh"
  if argv.length() > 0 {
    name = argv[0]
  }
  // The classic interactive test, bash's own: stdin and stderr both
  // on a terminal. The prompt rides stderr, so a redirected stdout
  // stays clean no matter what the session is.
  var interactive = os.isatty(0) && os.isatty(2)
  var read_fd = 0
  var args = ArrayBuilder.new().to_array()
  var one_shot = false
  var command = ""
  if argv.length() > 1 {
    const first = argv[1]
    if first == "-c" {
      if argv.length() < 3 {
        os.write(2, "emosh: -c: missing command\n")
        os._exit(2)
      }
      interactive = false
      one_shot = true
      command = argv[2]
      // an optional name after the command line stands as $0; the
      // rest are the positionals
      if argv.length() > 3 {
        name = argv[3]
      }
      const given = ArrayBuilder.new()
      for var k = 4; k < argv.length(); k = k + 1 {
        given.push(argv[k])
      }
      args = given.to_array()
    } else {
      if first == "-" {
        // the classic explicit stdin: the lines come from fd 0 as a
        // script's, the shell's name stays its own, and the words
        // after the dash are the positionals
        interactive = false
        const given = ArrayBuilder.new()
        for var k = 2; k < argv.length(); k = k + 1 {
          given.push(argv[k])
        }
        args = given.to_array()
      } else {
        if first.substring(0, 1) == "-" {
          os.write(2, "emosh: unknown option: " + first + "\n")
          os._exit(2)
        }
        // a script file: its lines are the session's input, its
        // arguments the positionals
        interactive = false
        case os.open_read(first) {
          (R.error, why) then {
            os.write(2, "emosh: " + why + "\n")
            os._exit(127)
          }
          (R.ok, fd) then {
            read_fd = fd
          }
        }
        name = first
        const given = ArrayBuilder.new()
        for var k = 2; k < argv.length(); k = k + 1 {
          given.push(argv[k])
        }
        args = given.to_array()
      }
    }
  }
  if interactive {
    os.signal_ignore(os.sig_int)
    os.signal_ignore(os.sig_quit)
  }
  return shell.Shell.new(interactive: interactive, name: name, read_fd: read_fd, args: args, one_shot: one_shot, command: command)
}

def main_entry() Int64 {
  const sh = start()
  const ed = edit.Editor.new()
  if sh.interactive || sh.assume_tty {
    sh.history_load(edit.load_history())
  }
  if sh.one_shot {
    // -c: the line came on the command line; run it and leave with
    // its status — a block left open there has no next line to ask
    // for, and refuses
    drive_line(sh, ed, sh.command)
    sh.stop()
    return sh.status()
  }
  var reading = true
  while reading {
    if sh.interactive {
      sh.notify()
    }
    case read_prompted(sh, ed, "emosh> ") {
      (R.error, _) then {
        // the editor's terminal echo: an assumed tty renders like the
        // interactive session, so the closing newline rides too
        if sh.interactive || sh.assume_tty {
          os.write(2, "\n")
        }
        reading = false
      }
      (R.ok, got) then {
        const line = got[0]
        const outcome = got[1]
        if outcome == 1 {
          // end of input: the classic newline echo rides the terminal
          if sh.interactive || sh.assume_tty {
            os.write(2, "\n")
          }
          reading = false
        } else {
          if outcome != 2 {
            // an accepted line — an empty one runs as the no-op it is
            sh.history_add(line)
            case gather(sh, ed, line) {
              (R.error, _) then { reading = false }
              (R.ok, joined) then {
                drive_line(sh, ed, joined)
                if !sh.keeps_running() {
                  reading = false
                }
              }
            }
          }
        }
      }
    }
  }
  if sh.interactive || sh.assume_tty {
    edit.save_history(sh.history_lines())
  }
  return sh.status()
}

// The session's next line: the editor's when the session edits — raw
// on around the read, the terminal handed back before anything runs
// — and the plain reader's when it does not. The outcome rides beside
// the line: 0 accepted (an empty line accepted too), 1 end of input,
// 2 abandoned. EMOSH_ASSUME_TTY skips the raw pair only — the keys
// and the rendering run the same on a pipe, which is how the editor's
// goldens drive it.
def read_prompted(sh shell.Shell, ed edit.Editor, prompt String) (R, (String, Int64)) {
  if sh.interactive || sh.assume_tty {
    ed.funcs.replace(sh.func_names())
    if sh.assume_tty {
      return ed.read_line(0, prompt, sh.history_lines())
    }
    case os.tty_raw(0) {
      (R.error, _) then {
        // a terminal that will not go raw: the plain reader carries on
        os.write(2, prompt)
        const raw = sh.read_line()
        if raw == "" {
          return (R.ok, ("", 1))
        }
        return (R.ok, (raw, 0))
      }
      (R.ok, saved) then {
        case ed.read_line(0, prompt, sh.history_lines()) {
          (R.error, why) then {
            os.tty_restore(0, saved)
            return (R.error, why)
          }
          (R.ok, got) then {
            os.tty_restore(0, saved)
            return (R.ok, got)
          }
        }
      }
    }
  }
  const raw = sh.read_line()
  if raw == "" {
    return (R.ok, ("", 1))
  }
  return (R.ok, (raw, 0))
}

// One full logical line: a bare trailing backslash pulls the next
// input line in — `> ` prompting for it interactively — until the
// line ends bare, the pieces joined at the escape. The input running
// out mid-continuation refuses, the classic unexpected end of file,
// and ends the session's input.
def gather(sh shell.Shell, ed edit.Editor, first String) (R, String) {
  var line = shell.strip_newline(first)
  var ended = false
  var dropped = false
  while lex.continues(line) && !ended {
    case read_prompted(sh, ed, "> ") {
      (R.error, _) then {
        sh.err("emosh: syntax error: unexpected end of input")
        sh.set_status(2)
        ended = true
      }
      (R.ok, got) then {
        if got[1] == 2 {
          // a ctrl-c mid-continuation discards the whole pending line
          dropped = true
          ended = true
        } else {
          if got[0] == "" || got[1] == 1 {
            sh.err("emosh: syntax error: unexpected end of input")
            sh.set_status(2)
            ended = true
          } else {
            line = line.substring(0, line.length() - 1) + shell.strip_newline(got[0])
          }
        }
      }
    }
  }
  if ended {
    if dropped {
      return (R.ok, "")
    }
    return (R.error, "")
  }
  return (R.ok, line)
}

// One logical line, lexed, parsed, and run — and when the parse comes
// back incomplete (a block still open), the next line is read and the
// whole line re-parsed, `> ` asking for it interactively. A `def`
// binds its function, a declaration binds its variable, an
// assignment rebinds one, and a leftover break or continue — the
// walker's signals nobody consumed — refuses with the classic
// complaint.
def drive_line(sh shell.Shell, ed edit.Editor, line String) Void {
  if line != "" {
    case lex.tokenize(line) {
      (R.error, why) then {
        sh.err(why)
        sh.set_status(2)
      }
      (R.ok, toks) then {
        var cur = toks
        var pending = true
        while pending {
          case parse.parse(cur) {
            (R.error, _, why) then {
              sh.err("emosh: syntax error: " + why)
              sh.set_status(2)
              pending = false
            }
            (R.ok, items, status) then {
            if status == "incomplete" {
              case read_prompted(sh, ed, "> ") {
                (R.error, _) then {
                  sh.err("emosh: syntax error: unexpected end of input")
                  sh.set_status(2)
                  pending = false
                }
                (R.ok, got) then {
                if got[1] == 2 {
                  // a ctrl-c mid-block discards the whole pending line
                  pending = false
                } else {
                if got[0] == "" || got[1] == 1 {
                  sh.err("emosh: syntax error: unexpected end of input")
                  sh.set_status(2)
                  pending = false
                } else {
                case lex.tokenize(shell.strip_newline(got[0])) {
                  (R.error, why) then {
                    sh.err(why)
                    sh.set_status(2)
                    pending = false
                  }
                  (R.ok, more_toks) then {
                    cur = tok_concat(cur, more_toks)
                  }
                }
                }
                }
                }
              }
            } else {
              run_items(sh, items, line)
              const sig = sh.read_signal()
              if sig == 1 || sig == 2 {
                sh.err("emosh: break: only in a loop")
                sh.set_status(1)
              }
              if sig == 3 {
                sh.err("emosh: return: only in a function")
                sh.set_status(1)
              }
              sh.clear_signal()
              pending = false
            }
          }
        }
      }
    }
  }
}

// Two token lists, one behind the other — the next line's tokens
// riding onto the ones the incomplete parse already read.
}

def tok_concat(first Array[lex.Tok], second Array[lex.Tok]) Array[lex.Tok] {
  const out = ArrayBuilder.new()
  for var k = 0; k < first.length(); k = k + 1 {
    out.push(first[k])
  }
  out.push(lex.Tok.new(kind: lex.op_semi(), parts: []))
  for var k = 0; k < second.length(); k = k + 1 {
    out.push(second[k])
  }
  return out.to_array()
}

// One line of input: lex, parse, walk.
// A malformed line: the reason on stderr, status 2 — the syntax
// error's classic status.
def refuse(sh shell.Shell, why String) Void {
  sh.err(why)
  sh.set_status(2)
}

// The item walk: run what the connectors allow, carry the status
// forward. A `&` item spawns instead of waiting — its status is the
// spawn's — and the walk goes on the way `;` would. A declaration
// binds, an assignment rebinds, a compound walks its own shape.
def run_items(sh shell.Shell, items Array[parse.Item], source String) Void {
  var status = sh.status()
  var run = true
  for var i = 0; i < items.length(); i = i + 1 {
    const item = items[i]
    if run {
      if item.assigns.length() > 0 {
        status = run_assign(sh, item.assigns[0])
        sh.set_status(status)
      } else {
        if item.decls.length() > 0 {
          status = bind_decl(sh, item.decls[0])
          sh.set_status(status)
        } else {
          if item.compounds.length() > 0 {
            if item.bg {
              status = run_compound_background(sh, item.compounds[0], source)
            } else {
              status = run_compound(sh, item.compounds[0], source)
            }
          } else {
            if !item.bg && item.expr_tok.length() > 0 {
              status = run_expr_item(sh, item, source)
            } else {
              if item.bg {
                status = run_background(sh, item.pipeline)
              } else {
                status = run_pipeline(sh, item.pipeline, source)
              }
            }
          }
          sh.set_status(status)
          // a walker's signal — break, continue, return — ends this
          // list where it stands; the loop or the call consumes it
          if sh.read_signal() != 0 {
            run = false
          }
        }
      }
    }
    if sh.read_signal() != 0 {
      // a walker's signal outranks the connector: the list stays
      // stopped until the loop or the call consumes the signal
      run = false
    } else {
      if item.conn == ";" {
        run = true
      } else {
        if item.conn == "&&" {
          run = status == 0
        } else {
          if item.conn == "||" {
            run = status != 0
          } else {
            // end of line — nothing further, by construction
            run = false
          }
        }
      }
    }
  }
}

// One compound in the background: a fork child walks it, the parent
// parks the job — the whole line the job's text.
def run_compound_background(sh shell.Shell, c parse.Compound, source String) Int64 {
  case os.fork() {
    (R.error, reason) then {
      sh.err("emosh: " + reason)
      return 1
    }
    (R.ok, pid) then {
      if pid == 0 {
        child_reset_signals()
        const status = run_compound(sh, c, source)
        os._exit(status)
      }
      sh.job_new(pid, [], source)
      return 0
    }
  }
}

// One compound command walked: the branch the condition picks, the
// loop the header drives, or the function binding itself in. The
// walker's signals — break, continue, return — ride the session's
// box, the loops and the call consuming what belongs to them.
def run_compound(sh shell.Shell, c parse.Compound, source String) Int64 {
  if c.kind == "if" {
    if c.cond_tok.length() > 0 {
      // the expression condition: a comparison over numbers, its
      // truth the branch
      case eval_cond(c.cond_tok, sh) {
        (R.error, why) then {
          sh.err("emosh: if: " + why)
          return 1
        }
        (R.ok, go) then {
          if go {
            run_items(sh, c.body, source)
            return sh.status()
          }
          if c.else_body.length() > 0 {
            run_items(sh, c.else_body, source)
            return sh.status()
          }
          sh.set_status(0)
          return 0
        }
      }
    }
    run_items(sh, c.cond, source)
    const st = sh.status()
    if st == 0 {
      run_items(sh, c.body, source)
      return sh.status()
    }
    if c.else_body.length() > 0 {
      run_items(sh, c.else_body, source)
      return sh.status()
    }
    // a false condition without an else answers 0, the classic
    sh.set_status(0)
    return 0
  }
  if c.kind == "while" {
    var last = 0
    while true {
      if c.cond_tok.length() > 0 {
        case eval_cond(c.cond_tok, sh) {
          (R.error, why) then {
            sh.err("emosh: while: " + why)
            return last
          }
          (R.ok, go) then {
            if !go {
              return last
            }
          }
        }
      } else {
        run_items(sh, c.cond, source)
        if sh.status() != 0 {
          return last
        }
        const pre = sh.read_signal()
        if pre == 1 || pre == 2 {
          sh.clear_signal()
          return last
        }
        if pre == 3 {
          return last
        }
      }
      run_items(sh, c.body, source)
      last = sh.status()
      const body_sig = sh.read_signal()
      if body_sig == 1 {
        sh.clear_signal()
        return last
      }
      if body_sig == 2 {
        sh.clear_signal()
      }
      if body_sig == 3 {
        return last
      }
    }
  }
  if c.kind == "for" {
    return run_for(sh, c, source)
  }
  // def: the function joins the session's table
  sh.func_define(c.fname, c.body)
  return 0
}

// The numeric for: the header's three expressions against the loop
// variable — init once, the condition every round, the step after
// each body — the variable's prior value restored when the loop
// leaves, whatever way it leaves.
def run_for(sh shell.Shell, c parse.Compound, source String) Int64 {
  if sh.var_is_const(c.var_name) {
    sh.err("emosh: for: " + c.var_name + ": is a constant")
    return 1
  }
  const had = sh.var_bound(c.var_name)
  var old_value = ""
  if had {
    case sh.var_lookup(c.var_name) {
      (R.ok, v) then { old_value = v }
      (R.error, _) then {}
    }
  }
  case eval_expr(c.init_tok, sh, 0) {
    (R.error, why) then {
      sh.err("emosh: for: " + why)
      for_restore(sh, c.var_name, had, old_value)
      return 1
    }
    (R.ok, init_v) then {
      sh.var_set(c.var_name, init_v[0].to_string())
      var last = 0
      var stop = false
      while !stop {
        case eval_cond(c.cond_tok, sh) {
          (R.error, why) then {
            sh.err("emosh: for: " + why)
            for_restore(sh, c.var_name, had, old_value)
            return 1
          }
          (R.ok, go) then {
            if !go {
              stop = true
            } else {
              run_items(sh, c.body, source)
              last = sh.status()
              const sig = sh.read_signal()
              if sig == 1 {
                sh.clear_signal()
                stop = true
              }
              if sig == 2 {
                sh.clear_signal()
              }
              if sig == 3 {
                for_restore(sh, c.var_name, had, old_value)
                return last
              }
              if !stop {
                case eval_assign(c.step_tok, sh) {
                  (R.error, why) then {
                    sh.err("emosh: for: " + why)
                    for_restore(sh, c.var_name, had, old_value)
                    return 1
                  }
                  (R.ok, stepped) then {
                    sh.var_set(stepped[0], stepped[1].to_string())
                  }
                }
              }
            }
          }
        }
      }
      for_restore(sh, c.var_name, had, old_value)
      return last
    }
  }
}

// The loop variable's prior binding goes back, whatever way the loop
// left.
def for_restore(sh shell.Shell, name String, had Bool, old_value String) Void {
  if had {
    sh.var_set(name, old_value)
  } else {
    sh.var_drop(name)
  }
}

// One declaration bound: the const flag refusing any redeclaration
// of a frozen name, the value read the shared dual way.
def bind_decl(sh shell.Shell, d parse.Decl) Int64 {
  if sh.var_is_const(d.name) {
    sh.err("emosh: " + d.name + ": is a constant")
    return 1
  }
  case decl_value(sh, d.value_tok) {
    (R.error, why) then {
      sh.err("emosh: " + d.name + ": " + why)
      return 1
    }
    (R.ok, value) then {
      if d.constant {
        sh.var_declare_const(d.name, value)
      } else {
        sh.var_set(d.name, value)
      }
      sh.set_status(0)
      return 0
    }
  }
}

// One assignment run: the name must already be declared — `var`,
// `const`, a for's variable — the declaration the only door a binding
// opens through, so an undeclared name refuses; a frozen one refuses
// its reassignment. The value reads the declaration's own dual way.
def run_assign(sh shell.Shell, a parse.Assign) Int64 {
  if !sh.var_bound(a.name) {
    sh.err("emosh: " + a.name + ": is not declared")
    return 1
  }
  if sh.var_is_const(a.name) {
    sh.err("emosh: " + a.name + ": is a constant")
    return 1
  }
  case decl_value(sh, a.value_tok) {
    (R.error, why) then {
      sh.err("emosh: " + a.name + ": " + why)
      return 1
    }
    (R.ok, value) then {
      sh.var_set(a.name, value)
      sh.set_status(0)
      return 0
    }
  }
}

// The value a declaration or an assignment binds, the dual reading:
// any quoted or literal part binds every part's expanded text joined
// as one string; an all-bare run evaluates as an integer expression,
// full consumption demanded. The error answer is the raw reason —
// the caller prefixes the name.
def decl_value(sh shell.Shell, value_tok Array[lex.Tok]) (R, String) {
  var stringy = false
  for var k = 0; k < value_tok.length(); k = k + 1 {
    const parts = value_tok[k].parts
    for var q = 0; q < parts.length(); q = q + 1 {
      if parts[q].lit || parts[q].quoted {
        stringy = true
      }
    }
  }
  if stringy {
    const parts_all = ArrayBuilder.new()
    for var k = 0; k < value_tok.length(); k = k + 1 {
      for var q = 0; q < value_tok[k].parts.length(); q = q + 1 {
        parts_all.push(value_tok[k].parts[q])
      }
    }
    return (R.ok, expand.word(parts_all.to_array(), sh.status(), sh.name, sh.current_args(), sh.pid, sh.last_bg.read(), sh.vars_list()))
  }
  case eval_expr(value_tok, sh, 0) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, got) then {
      if got[1] != value_tok.length() {
        return (R.error, "the value has trailing tokens")
      }
      return (R.ok, got[0].to_string())
    }
  }
}

// One assignment step, `name = expr`: the name a bare word, the = its
// own word, the rest the expression. The value answers with the name
// it binds.
def eval_assign(toks Array[lex.Tok], sh shell.Shell) (R, (String, Int64)) {
  if toks.length() < 3 {
    return (R.error, "the step wants `name = expr`")
  }
  case parse.word_text_of(toks, 0) {
    (R.error, _) then { return (R.error, "the step wants `name = expr`") }
    (R.ok, name) then {
      if !expand.is_name(name) || !parse.is_word(toks[1], "=") {
        return (R.error, "the step wants `name = expr`")
      }
      case eval_expr(toks, sh, 2) {
        (R.error, why) then { return (R.error, why) }
        (R.ok, got) then {
          if got[1] != toks.length() {
            return (R.error, "the step has trailing tokens")
          }
          return (R.ok, (name, got[0]))
        }
      }
    }
  }
}

// The for's condition: the header slice must compare — a bare sum is
// not a condition — and nothing may trail the comparison.
def eval_cond(toks Array[lex.Tok], sh shell.Shell) (R, Bool) {
  var has_cmp = false
  for var k = 0; k < toks.length(); k = k + 1 {
    const kind = toks[k].kind
    if kind == "<" || kind == ">" || kind == "<=" || kind == ">=" || kind == "==" || kind == "!=" {
      has_cmp = true
    }
  }
  if !has_cmp {
    return (R.error, "the condition must compare")
  }
  case eval_bool(toks, sh, 0) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, got) then {
      if got[1] != toks.length() {
        return (R.error, "the condition has trailing tokens")
      }
      return (R.ok, got[0] == 1)
    }
  }
}

// The for header's expression grammar, Emo 同款: bare variables and
// `$#`, integer literals, `+ - * / %`, the comparisons, parentheses —
// comparisons lowest, `*` `/` `%` binding tightest, everything left
// to right. The first answer is the value, the second the index just
// past it.
def eval_expr(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64)) {
  case eval_bool(toks, sh, pos) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, value) then { return (R.ok, (value[0], value[1])) }
  }
}

// The boolean level above the comparisons: `&&` and `||` left to
// right, each side a comparison — the value 1 or 0, no
// short-circuit (a division by zero on the unused side still
// refuses, the price of the eager read).
def eval_bool(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64)) {
  case eval_cmp(toks, sh, pos) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, first) then {
      var value = first[0]
      var next = first[1]
      var going = next < toks.length() && (toks[next].kind == "&&" || toks[next].kind == "||")
      while going {
        const kind = toks[next].kind
        case eval_cmp(toks, sh, next + 1) {
          (R.error, why) then { return (R.error, why) }
          (R.ok, right) then {
            if kind == "&&" {
              if value == 0 || right[0] == 0 {
                value = 0
              } else {
                value = 1
              }
            } else {
              if value != 0 || right[0] != 0 {
                value = 1
              } else {
                value = 0
              }
            }
            next = right[1]
            going = next < toks.length() && (toks[next].kind == "&&" || toks[next].kind == "||")
          }
        }
      }
      return (R.ok, (value, next))
    }
  }
}

// The comparison level, answering whether a comparison was the top —
// the for's condition must compare, a bare sum is not a condition.
def eval_cmp(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64, Bool)) {
  case eval_add(toks, sh, pos) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, left) then {
      if left[1] >= toks.length() {
        return (R.ok, (left[0], left[1], false))
      }
      const kind = toks[left[1]].kind
      const is_cmp = kind == "<" || kind == ">" || kind == "<=" || kind == ">=" || kind == "==" || kind == "!="
      if !is_cmp {
        return (R.ok, (left[0], left[1], false))
      }
      case eval_add(toks, sh, left[1] + 1) {
        (R.error, why) then { return (R.error, why) }
        (R.ok, right) then {
          var answer = 0
          if kind == "<" {
            if left[0] < right[0] {
              answer = 1
            }
          }
          if kind == ">" {
            if left[0] > right[0] {
              answer = 1
            }
          }
          if kind == "<=" {
            if left[0] <= right[0] {
              answer = 1
            }
          }
          if kind == ">=" {
            if left[0] >= right[0] {
              answer = 1
            }
          }
          if kind == "==" {
            if left[0] == right[0] {
              answer = 1
            }
          }
          if kind == "!=" {
            if left[0] != right[0] {
              answer = 1
            }
          }
          return (R.ok, (answer, right[1], true))
        }
      }
    }
  }
}

// The addition level.
def eval_add(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64)) {
  case eval_mul(toks, sh, pos) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, left) then {
      var value = left[0]
      var next = left[1]
      var going = next < toks.length()
      while going {
        case parse.word_text_of(toks, next) {
          (R.error, _) then { going = false }
          (R.ok, op) then {
            if op == "+" || op == "-" {
              case eval_mul(toks, sh, next + 1) {
                (R.error, why) then { return (R.error, why) }
                (R.ok, right) then {
                  if op == "+" {
                    value = value + right[0]
                  } else {
                    value = value - right[0]
                  }
                  next = right[1]
                }
              }
            } else {
              going = false
            }
          }
        }
      }
      return (R.ok, (value, next))
    }
  }
}

// The multiplication level, division and modulus refusing a zero.
def eval_mul(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64)) {
  case eval_factor(toks, sh, pos) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, left) then {
      var value = left[0]
      var next = left[1]
      var going = next < toks.length()
      while going {
        case parse.word_text_of(toks, next) {
          (R.error, _) then { going = false }
          (R.ok, op) then {
            if op == "*" || op == "/" || op == "%" {
              case eval_factor(toks, sh, next + 1) {
                (R.error, why) then { return (R.error, why) }
                (R.ok, right) then {
                  if op == "*" {
                    value = value * right[0]
                  } else {
                    if right[0] == 0 {
                      return (R.error, "division by zero")
                    }
                    if op == "/" {
                      value = value / right[0]
                    } else {
                      value = value % right[0]
                    }
                  }
                  next = right[1]
                }
              }
            } else {
              going = false
            }
          }
        }
      }
      return (R.ok, (value, next))
    }
  }
}

// The integer the text names: an optional minus riding ahead of the
// digits — the expression reader's own reading, wider than
// is_digits (a descriptor or a glob segment may never go negative,
// a counter can).
def signed_int(text String) (R, Int64) {
  var digits = text
  var negative = false
  if text != "" && text.substring(0, 1) == "-" {
    negative = true
    digits = text.substring(1, text.length() - 1)
  }
  if !expand.is_digits(digits) {
    return (R.error, "")
  }
  var value = digits.to_int64()
  if negative {
    value = 0 - value
  }
  return (R.ok, value)
}

// The factor: an integer (a leading minus counts), `$#`, a declared
// or environment variable whose value is a number, or a
// parenthesized expression.
def eval_factor(toks Array[lex.Tok], sh shell.Shell, pos Int64) (R, (Int64, Int64)) {
  if pos >= toks.length() {
    return (R.error, "expected a value")
  }
  const tok = toks[pos]
  case parse.word_text_of(toks, pos) {
    (R.error, _) then { return (R.error, "the header reads bare words, quoted ones stay literal") }
    (R.ok, text) then {
      case signed_int(text) {
        (R.ok, value) then { return (R.ok, (value, pos + 1)) }
        (R.error, _) then {}
      }
      if text == "$#" {
        return (R.ok, (sh.current_args().length(), pos + 1))
      }
      if text == "(" {
        case eval_expr(toks, sh, pos + 1) {
          (R.error, why) then { return (R.error, why) }
          (R.ok, inner) then {
            if inner[1] >= toks.length() || !parse.is_word(toks[inner[1]], ")") {
              return (R.error, "expected )")
            }
            return (R.ok, (inner[0], inner[1] + 1))
          }
        }
      }
      if text.substring(0, 1) == "$" {
        // a $-form read for its numeric value: $i, ${i}, $1, $#
        const value = expand.word(tok.parts, sh.status(), sh.name, sh.current_args(), sh.pid, sh.last_bg.read(), sh.vars_list())
        case signed_int(value) {
          (R.error, _) then { return (R.error, text + ": is not a number") }
          (R.ok, num) then { return (R.ok, (num, pos + 1)) }
        }
      }
      if expand.is_name(text) {
        case sh.var_lookup(text) {
          (R.error, _) then {
            case os.getenv(text) {
              (R.ok, value) then {
                case signed_int(value) {
                  (R.error, _) then { return (R.error, text + ": is not a number") }
                  (R.ok, num) then { return (R.ok, (num, pos + 1)) }
                }
              }
              (R.error, _) then {
                return (R.error, text + ": is not set")
              }
            }
          }
          (R.ok, value) then {
            case signed_int(value) {
              (R.error, _) then { return (R.error, text + ": is not a number") }
              (R.ok, num) then { return (R.ok, (num, pos + 1)) }
            }
          }
        }
      }
      return (R.error, "unexpected " + text)
    }
  }
}

// One expression statement: a command-shaped run whose every token
// reads as an expression. The session's names choose the reading — a
// builtin's or a function's name keeps its command, a declared
// binding's name, a digit opening, or an open parenthesis evaluates
// the whole run and prints the value (`s + 1` after `var s = 0`
// answers 1), and anything else runs as the command it always was.
def run_expr_item(sh shell.Shell, item parse.Item, source String) Int64 {
  const stage = item.pipeline[0]
  if stage.words.length() == 0 {
    return run_pipeline(sh, item.pipeline, source)
  }
  const head = expand.word(stage.words[0], sh.status(), sh.name, sh.current_args(), sh.pid, sh.last_bg.read(), sh.vars_list())
  var command = false
  if builtin.is_builtin(head) {
    command = true
  } else {
    case sh.func_find(head) {
      (R.ok, _) then { command = true }
      (R.error, _) then {}
    }
  }
  if command {
    return run_pipeline(sh, item.pipeline, source)
  }
  var numeric = false
  case signed_int(head) {
    (R.ok, _) then { numeric = true }
    (R.error, _) then {}
  }
  if numeric || head == "(" || (expand.is_name(head) && sh.var_bound(head)) {
    if item.expr_tok.length() == 1 {
      // a lone declared name answers the value it binds, string or
      // number alike — `c` after `const c = "foo"` prints foo; only
      // a longer run demands numbers (strings do not add)
      case sh.var_lookup(head) {
        (R.error, _) then {}
        (R.ok, value) then {
          sh.line(value)
          return 0
        }
      }
    }
    case eval_expr(item.expr_tok, sh, 0) {
      (R.error, why) then {
        sh.err("emosh: " + head + ": " + why)
        return 1
      }
      (R.ok, got) then {
        if got[1] != item.expr_tok.length() {
          sh.err("emosh: " + head + ": the expression has trailing tokens")
          return 1
        }
        sh.line(got[0].to_string())
        return 0
      }
    }
  }
  return run_pipeline(sh, item.pipeline, source)
}

// One pipeline: the fork-and-wire path when there is more than one
// stage, the single-command path otherwise.
def run_pipeline(sh shell.Shell, stages Array[parse.Cmd], source String) Int64 {
  if stages.length() == 1 {
    return run_simple(sh, stages[0], source)
  }
  case spawn_pipeline(sh, stages, false) {
    (R.error, why) then {
      sh.err("emosh: " + why)
      return 1
    }
    (R.ok, pids) then { return wait_status(pids) }
  }
}

// One background item: spawn without waiting, and the pipeline's last
// member — the representative the job's status rides on — joins the
// session's job table. The spawn's success is the item's status.
def run_background(sh shell.Shell, stages Array[parse.Cmd]) Int64 {
  case spawn_pipeline(sh, stages, true) {
    (R.error, why) then {
      sh.err("emosh: " + why)
      return 1
    }
    (R.ok, pids) then {
      const rep = pids[pids.length() - 1]
      const rest = ArrayBuilder.new()
      for var k = 0; k < pids.length() - 1; k = k + 1 {
        rest.push(pids[k])
      }
      sh.job_new(rep, rest.to_array(), item_text(stages))
      return 0
    }
  }
}

// The stages spawned and wired, foreground or background. A
// background spawn pins every member into one new process group —
// the parent's setpgid the moment each child is forked, the first
// member's pid the group — so the terminal's Ctrl-C, aimed at the
// shell's own group, can never reach a job the user asked to keep
// out of it. The foreground keeps the v0 discipline: no group of its
// own, Ctrl-C lands on the command.
def spawn_pipeline(sh shell.Shell, stages Array[parse.Cmd], bg Bool) (R, Array[Int64]) {
  const n = stages.length()
  // n - 1 pipes; read end of pipe i - 1 feeds stage i, write end of
  // pipe i carries stage i's stdout
  const reads = ArrayBuilder.new()
  const writes = ArrayBuilder.new()
  var made = true
  var why = ""
  for var p = 0; p < n - 1; p = p + 1 {
    case os.pipe() {
      (R.error, reason) then {
        made = false
        why = reason
      }
      (R.ok, ends) then {
        reads.push(ends[0])
        writes.push(ends[1])
      }
    }
  }
  if !made {
    close_all(reads.to_array(), writes.to_array())
    return (R.error, why)
  }
  const read_fds = reads.to_array()
  const write_fds = writes.to_array()
  const pids = ArrayBuilder.new()
  var forked = true
  var i = 0
  while forked && i < n {
    case os.fork() {
      (R.error, reason) then {
        forked = false
        why = reason
      }
      (R.ok, pid) then {
        if pid == 0 {
          in_child(sh, stages[i], i, n, read_fds, write_fds)
        } else {
          if bg {
            const group = pids.to_array()
            if group.length() > 0 {
              os.setpgid(pid, group[0])
            } else {
              os.setpgid(pid, pid)
            }
          }
          pids.push(pid)
          i = i + 1
        }
      }
    }
  }
  // The parent keeps no pipe end: it would never see end of stream.
  close_all(read_fds, write_fds)
  if !forked {
    // some stages may already run; wait what was spawned, then report
    reap(pids.to_array())
    return (R.error, why)
  }
  return (R.ok, pids.to_array())
}

// The job's display text: the words as the user wrote them — parts
// joined, stages by ` | `. The redirections stay out; the words are
// what the notifications name.
def item_text(stages Array[parse.Cmd]) String {
  var text = ""
  for var s = 0; s < stages.length(); s = s + 1 {
    if s > 0 {
      text = text + " | "
    }
    const words = stages[s].words
    for var k = 0; k < words.length(); k = k + 1 {
      if k > 0 {
        text = text + " "
      }
      const parts = words[k]
      for var p = 0; p < parts.length(); p = p + 1 {
        text = text + parts[p].text
      }
    }
  }
  return text
}

// The fork child of stage i: wire the pipe ends, reset the signals,
// open its redirections, run the stage, and leave through _exit —
// every path, no return.
def in_child(sh shell.Shell, cmd parse.Cmd, i Int64, n Int64, read_fds Array[Int64], write_fds Array[Int64]) Void {
  if i > 0 {
    os.dup2(read_fds[i - 1], 0)
  }
  if i < n - 1 {
    os.dup2(write_fds[i], 1)
  }
  close_all(read_fds, write_fds)
  child_reset_signals()
  const opened = apply_redirs(sh, cmd.redirs)
  if opened != 0 {
    os._exit(opened)
  }
  const status = child_run(sh, cmd)
  os._exit(status)
}

// The words of one command, expanded once: the `$` forms and the
// tilde through the expander, then the glob for a word the user
// typed a pattern into — one word may answer many names, and a
// pattern that matched none refuses the command.
def expand_words(sh shell.Shell, words Array[Array[expand.Part]]) (R, Array[String]) {
  const out = ArrayBuilder.new()
  for var k = 0; k < words.length(); k = k + 1 {
    if expand.is_dollar_at(words[k]) {
      // `$@` standing alone fans into the positionals, one word per
      // argument, vanishing entirely when there are none — and the
      // fan-out never globs, expansion results never do
      const all = sh.current_args()
      for var a = 0; a < all.length(); a = a + 1 {
        out.push(all[a])
      }
    } else {
      const text = expand.word(words[k], sh.status(), sh.name, sh.current_args(), sh.pid, sh.last_bg.read(), sh.vars_list())
      if glob.patterned(words[k]) {
        const found = glob.matches(text)
        if found.length() == 0 {
          return (R.error, "emosh: no matches: " + text)
        }
        for var m = 0; m < found.length(); m = m + 1 {
          out.push(found[m])
        }
      } else {
        out.push(text)
      }
    }
  }
  return (R.ok, out.to_array())
}

// A single command: a builtin with no redirections stays in this
// process, a declared function runs its body here (the caller's
// positionals restored after), and everything else is the one-child
// pipeline, the expanded words handed down so they expand once. The
// expression statement never reaches here — run_items probes the
// reading first; a pipeline stage's child answers a bare declared
// name through child_run_argv.
def run_simple(sh shell.Shell, cmd parse.Cmd, source String) Int64 {
  case expand_words(sh, cmd.words) {
    (R.error, why) then {
      sh.err(why)
      return 1
    }
    (R.ok, argv) then {
      if argv.length() > 0 {
        if builtin.is_builtin(argv[0]) && cmd.redirs.length() == 0 {
          return builtin.run(sh, argv)
        }
        case sh.func_find(argv[0]) {
          (R.ok, f) then {
            if cmd.redirs.length() > 0 {
              sh.err("emosh: " + argv[0] + ": a function call takes no redirections")
              return 1
            }
            return call_function(sh, f, argv, source)
          }
          (R.error, _) then {}
        }
      }
      case os.fork() {
        (R.error, reason) then {
          sh.err("emosh: " + reason)
          return 1
        }
        (R.ok, pid) then {
          if pid == 0 {
            child_reset_signals()
            const status = apply_redirs(sh, cmd.redirs)
            if status != 0 {
              os._exit(status)
            }
            os._exit(child_run_argv(sh, argv, source))
          }
          return wait_one(pid)
        }
      }
    }
  }
}

// One function call: the call's arguments become $1.. for the body —
// the caller's positionals restored on the way out — and `return`'s
// signal is consumed here.
def call_function(sh shell.Shell, f shell.FuncEntry, argv Array[String], source String) Int64 {
  const call_args = ArrayBuilder.new()
  for var k = 1; k < argv.length(); k = k + 1 {
    call_args.push(argv[k])
  }
  sh.args_push(call_args.to_array())
  run_items(sh, f.body, source)
  sh.args_pop()
  const sig = sh.read_signal()
  if sig == 3 {
    sh.clear_signal()
  }
  return sh.status()
}

// A pipeline stage's child: its own words expand here — the status
// the stage follows is the one its fork inherited — then the run.
def child_run(sh shell.Shell, cmd parse.Cmd) Int64 {
  case expand_words(sh, cmd.words) {
    (R.error, why) then {
      sh.err(why)
      return 1
    }
    (R.ok, argv) then {
      return child_run_argv(sh, argv, "")
    }
  }
}

// The child's body once the words are final: a builtin's status, a
// declared function's body, a bare declared name printing the value
// it binds (a pipeline stage can be a value's producer), or an
// execvp — which never returns on success, and answers the errno
// reason on failure, the permission denial no longer dressed up as a
// missing command.
def child_run_argv(sh shell.Shell, argv Array[String], source String) Int64 {
  if argv.length() == 0 {
    // a command of redirections alone: the files were opened already,
    // there is nothing to run
    return 0
  }
  if builtin.is_builtin(argv[0]) {
    return builtin.run(sh, argv)
  }
  case sh.func_find(argv[0]) {
    (R.ok, f) then {
      const call_args = ArrayBuilder.new()
      for var k = 1; k < argv.length(); k = k + 1 {
        call_args.push(argv[k])
      }
      sh.args_push(call_args.to_array())
      run_items(sh, f.body, source)
      sh.args_pop()
      const sig = sh.read_signal()
      if sig == 3 {
        sh.clear_signal()
      }
      return sh.status()
    }
    (R.error, _) then {}
  }
  if argv.length() == 1 {
    if sh.var_bound(argv[0]) {
      case sh.var_lookup(argv[0]) {
        (R.error, _) then {}
        (R.ok, value) then {
          sh.line(value)
          return 0
        }
      }
    }
  }
  case os.execvp(argv[0], argv) {
    (R.error, why) then {
      // the shell's own face on the exec's failure, the classics':
      // a command the PATH search never found is `command not found`
      // with 127 — the ENOENT tail the os reason carries is the
      // contract both runtimes pin byte for byte, the channel the two
      // statuses classify through; anything else is a command that
      // was found but would not run — the os reason verbatim and 126
      if why.index_of("No such file or directory") >= 0 {
        sh.err("emosh: " + argv[0] + ": command not found")
        return 127
      }
      sh.err("emosh: " + argv[0] + ": " + why)
      return 126
    }
    (R.ok, _) then { return 0 }
  }
}

// The child's redirections: each opened and dup2'd onto its
// descriptor in order — `2>&1` aiming one at another's with no file
// at all — a file that does not open reporting the reason and
// failing the command with 1.
def apply_redirs(sh shell.Shell, redirs Array[parse.Redir]) Int64 {
  var status = 0
  var i = 0
  while status == 0 && i < redirs.length() {
    const redir = redirs[i]
    if redir.dup >= 0 {
      case os.dup2(redir.dup, redir.fd) {
        (R.error, why) then {
          sh.err("emosh: " + why)
          status = 1
        }
        (R.ok, _) then { }
      }
    } else {
      // a redirection's file name never carries an unexpanded $? the
      // user did not mean; expand it like a word — and a target is
      // one name, it does not glob
      const path = expand.word(redir.word, sh.status(), sh.name, sh.current_args(), sh.pid, sh.last_bg.read(), sh.vars_list())
      if redir.op == lex.op_lt() {
        case os.open_read(path) {
          (R.error, why) then {
            sh.err("emosh: " + why)
            status = 1
          }
          (R.ok, fd) then {
            os.dup2(fd, redir.fd)
            os.close(fd)
          }
        }
      } else {
        if redir.op == lex.op_gt() {
          case os.open_write(path) {
            (R.error, why) then {
              sh.err("emosh: " + why)
              status = 1
            }
            (R.ok, fd) then {
              os.dup2(fd, redir.fd)
              os.close(fd)
            }
          }
        } else {
          case os.open_append(path) {
            (R.error, why) then {
              sh.err("emosh: " + why)
              status = 1
            }
            (R.ok, fd) then {
              os.dup2(fd, redir.fd)
              os.close(fd)
            }
          }
        }
      }
    }
    i = i + 1
  }
  return status
}

// The fork child takes the signals back: interactive ignores would
// survive the exec and make Ctrl-C toothless on the command.
def child_reset_signals() Void {
  os.signal_default(os.sig_int)
  os.signal_default(os.sig_quit)
  os.signal_default(os.sig_pipe)
}

// Closes every descriptor a pipeline made, both halves.
def close_all(reads Array[Int64], writes Array[Int64]) Void {
  for var r = 0; r < reads.length(); r = r + 1 {
    os.close(reads[r])
  }
  for var w = 0; w < writes.length(); w = w + 1 {
    os.close(writes[w])
  }
}

// Waits for every pid; the last stage's status is the pipeline's.
def wait_status(pids Array[Int64]) Int64 {
  var status = 0
  for var p = 0; p < pids.length(); p = p + 1 {
    status = wait_one(pids[p])
  }
  return status
}

// Waits for one child and decodes the kernel's raw status word —
// the shell's own decoding, shared with the job table.
def wait_one(pid Int64) Int64 {
  const w = os.waitpid(pid)
  return shell.decode_status(w[1])
}

// Waits a fork failure's partial brood down; their statuses do not
// matter, the walk already failed.
def reap(pids Array[Int64]) Void {
  for var p = 0; p < pids.length(); p = p + 1 {
    os.waitpid(pids[p])
  }
}
