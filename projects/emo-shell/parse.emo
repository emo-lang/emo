// The parser: the lexer's tokens become the structures the executor
// runs — the classic grammar, nothing borrowed:
//
//   line     := and_or ( ";" and_or )* ";"?        (a trailing `;` is fine)
//   and_or   := pipeline ( "&&" | "||" pipeline )*
//   pipeline := command ( "|" command )*
//   command  := ( word | redirection )*
//   redirection := "<" | ">" | ">>" word
//
// Every connector rides the item it terminates: an item is one
// pipeline plus the `&&` / `||` / `;` that follows it, the executor's
// walk using those to decide whether the next item runs at all.
//
// Strictness is the shape: a line may not open with an operator, a
// pipeline stage may not be empty (`| cat` and `cat |` both refuse —
// there is no continuation line to ask for), a redirection must name
// its file. One honest looseness: a command of redirections alone is
// a command — `> log` truncates the file, the way the classic shells
// do it. A malformed line answers `(R.error, reason)` — the shell has
// no catch to survive, so the session decides what dies and what
// carries on.

// One stage of a pipeline: its words (each still the unexpanded
// parts — expansion happens at execution, so `$?` answers the status
// the command actually follows) and its redirections in order.
class Cmd {
  def init(words Array[Array[expand.Part]], redirs Array[Redir]) {
    self.words = words
    self.redirs = redirs
  }
}

// One redirection: `<`, `>`, or `>>`, and the file it names.
class Redir {
  def init(op String, word Array[expand.Part]) {
    self.op = op
    self.word = word
  }
}

// One pipeline plus the connector that follows it — `;`, `&&`, `||`,
// or `""` at the end of the line.
class Item {
  def init(pipeline Array[Cmd], conn String) {
    self.pipeline = pipeline
    self.conn = conn
  }
}

// The whole line's items, or the reason the line is malformed.
def parse(tokens Array[lex.Tok]) (R, Array[Item]) {
  const items = ArrayBuilder.new()
  if tokens.length() == 0 {
    return (R.ok, items.to_array())
  }
  // a line may not open with a connector — but a redirection alone
  // opens fine (`> log` truncates, the classic looseness)
  const first = tokens[0].kind
  if first == lex.op_pipe() || first == lex.op_semi() || first == lex.op_andand() || first == lex.op_oror() {
    return (R.error, "emosh: syntax error: a line does not start with " + first)
  }
  var i = 0
  var going = true
  while going {
    case parse_pipeline(tokens, i) {
      (R.error, why) -> { return (R.error, why) }
      (R.ok, stage) -> {
        var conn = ""
        var next = stage[1]
        if next < tokens.length() {
          const kind = tokens[next].kind
          if kind == lex.op_semi() {
            conn = ";"
            next = next + 1
          } else {
            if kind == lex.op_andand() || kind == lex.op_oror() {
              conn = kind
              next = next + 1
            } else {
              return (R.error, "emosh: syntax error: unexpected " + kind)
            }
          }
        }
        items.push(Item.new(pipeline: stage[0], conn: conn))
        if next >= tokens.length() {
          going = false
        } else {
          i = next
        }
      }
    }
  }
  return (R.ok, items.to_array())
}

// One pipeline: its stages and the index just past it, or the reason
// one of the stages is malformed.
def parse_pipeline(tokens Array[lex.Tok], start Int64) (R, (Array[Cmd], Int64)) {
  const stages = ArrayBuilder.new()
  case parse_command(tokens, start) {
    (R.error, why) -> { return (R.error, why) }
    (R.ok, first) -> {
      stages.push(first[0])
      var i = first[1]
      var piping = true
      while piping && i < tokens.length() && tokens[i].kind == lex.op_pipe() {
        case parse_command(tokens, i + 1) {
          (R.error, why) -> {
            piping = false
            return (R.error, why)
          }
          (R.ok, stage) -> {
            stages.push(stage[0])
            i = stage[1]
          }
        }
      }
      return (R.ok, (stages.to_array(), i))
    }
  }
}

// One command: words and redirections in order; empty refuses.
def parse_command(tokens Array[lex.Tok], start Int64) (R, (Cmd, Int64)) {
  const words = ArrayBuilder.new()
  const redirs = ArrayBuilder.new()
  var i = start
  var in_command = true
  while in_command && i < tokens.length() {
    const tok = tokens[i]
    if tok.kind == "word" {
      words.push(tok.parts)
      i = i + 1
    } else {
      if tok.kind == lex.op_lt() || tok.kind == lex.op_gt() || tok.kind == lex.op_gtgt() {
        if i + 1 >= tokens.length() || tokens[i + 1].kind != "word" {
          return (R.error, "emosh: syntax error: " + tok.kind + " needs a file name")
        }
        redirs.push(Redir.new(op: tok.kind, word: tokens[i + 1].parts))
        i = i + 2
      } else {
        in_command = false
      }
    }
  }
  if words.length() == 0 && redirs.length() == 0 {
    if i >= tokens.length() {
      return (R.error, "emosh: syntax error: unexpected end of line")
    }
    return (R.error, "emosh: syntax error: expected a command before " + tokens[i].kind)
  }
  return (R.ok, (Cmd.new(words: words.to_array(), redirs: redirs.to_array()), i))
}
