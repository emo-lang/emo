// The parser: the lexer's tokens become the structures the executor
// runs. The grammar, Emo 同款 — brace blocks, no terminator keywords:
//
//   line     := item ( ";" item )* ";"?        (a trailing `;` is fine)
//   and_or   := item ( "&&" | "||" item )*
//   item     := pipeline | compound | declaration | assignment
//   pipeline := command ( "|" command )*
//   command  := ( word | redirection )*
//   redirection := "<" | ">" | ">>" word | "N<" | "N>" | "N>>" word
//                | "N>&M" | "N<&M" | ">&M" | "<&M"
//   compound := "if" list "{" list "}" [ "else" ( if | "{" list "}" ) ]
//             | "while" list "{" list "}"
//             | "for" "var" name "=" expr ";" expr ";" expr "{" list "}"
//             | "def" name "(" ")" "{" list "}"
//   declaration := ("const" | "var") name "=" word
//   assignment := name "=" value-tokens
//
// A `&` after an item marks it background — `a | b &` is one job,
// `while … } &` another. An `&` that is not `&&` is its own operator.
//
// The keywords are recognized where a command may start, and only on
// a word that is one bare, unquoted part — `'if'` is an argument like
// any other. `{` and `}` are reserved as standalone words (a literal
// brace quotes). A line that ends with a block still open answers
// incomplete — the driver reads the next line and re-parses the way
// the classic shells ask for `>` — distinct from a syntax error,
// which refuses.
//
// The answer every parser helper speaks: the payload, the index just
// past it, and the status — "" complete, "incomplete" when the line
// ran out inside a block (the payload a sentinel), or, with R.error,
// the reason the line refused. Strictness is the shape: a line may
// not open with an operator, a pipeline stage may not be empty, a
// redirection must name its file, `else` wants a block or an `if`, a
// declaration wants the spaces that make it read like Emo. One honest
// looseness: a command of redirections alone is a command — `> log`
// truncates the file.

// One stage of a pipeline: its words (each still the unexpanded
// parts — expansion happens at execution, so `$?` answers the status
// the command actually follows) and its redirections in order.
class Cmd {
  def init(words Array[Array[expand.Part]], redirs Array[Redir]) {
    self.words = words
    self.redirs = redirs
  }
}

// One redirection: the operator, the descriptor it lands on (`<`
// rides 0, `>` and `>>` ride 1, the `2>` family rides 2), the file it
// names — or, for the dup forms, `dup` naming the descriptor it
// follows and no file at all.
class Redir {
  def init(op String, fd Int64, dup Int64, word Array[expand.Part]) {
    self.op = op
    self.fd = fd
    self.dup = dup
    self.word = word
  }
}

// One compound command: `if`, `while`, `for`, or `def` — the kind
// names which, and each field carries what its kind reads (the rest
// stay empty): the condition items and the two branches, the loop
// variable with its three header expression slices, the function's
// name and body.
class Compound {
  def init(kind String, cond Array[Item], body Array[Item], else_body Array[Item], var_name String, init_tok Array[lex.Tok], cond_tok Array[lex.Tok], step_tok Array[lex.Tok], fname String) {
    self.kind = kind
    self.cond = cond
    self.body = body
    self.else_body = else_body
    self.var_name = var_name
    self.init_tok = init_tok
    self.cond_tok = cond_tok
    self.step_tok = step_tok
    self.fname = fname
  }
}

// One declaration: `const` or `var`, the name, and the value
// expression's token slice (a quoted word binds its expanded text,
// a bare run evaluates numerically).
class Decl {
  def init(constant Bool, name String, value_tok Array[lex.Tok]) {
    self.constant = constant
    self.name = name
    self.value_tok = value_tok
  }
}

// One assignment: `name = value` — the rebinding a loop body lives
// on, the name already declared, the value the same token slice a
// declaration's takes.
class Assign {
  def init(name String, value_tok Array[lex.Tok]) {
    self.name = name
    self.value_tok = value_tok
  }
}

// The empty assignment sentinel, parse_assign's error answer.
def empty_assign() Assign {
  return Assign.new(name: "", value_tok: [])
}

// One item of a line: a pipeline, a compound, a declaration, or an
// assignment — exactly one of the four, the other three arrays
// empty — plus the connector that follows it and whether `&` sent it
// to the background. A pipeline may carry expr_tok beside it: the
// expression reading of a command-shaped run, recorded whenever every
// token allows the question — the executor chooses between the
// readings by the session's own names.
class Item {
  def init(pipeline Array[Cmd], compounds Array[Compound], decls Array[Decl], assigns Array[Assign], expr_tok Array[lex.Tok], conn String, bg Bool) {
    self.pipeline = pipeline
    self.compounds = compounds
    self.decls = decls
    self.assigns = assigns
    self.expr_tok = expr_tok
    self.conn = conn
    self.bg = bg
  }
}

// The all-empty item: what an incomplete parse answers while the
// driver goes looking for the next line — a real item always carries
// a command, a compound, a declaration, or an assignment, so the
// emptiness is the sentinel.
def empty_item() Item {
  return Item.new(pipeline: [], compounds: [], decls: [], assigns: [], expr_tok: [], conn: "", bg: false)
}

// The empty compound, the same sentinel for the compound walkers.
def empty_compound(kind String) Compound {
  return Compound.new(kind: kind, cond: [], body: [], else_body: [], var_name: "", init_tok: [], cond_tok: [], step_tok: [], fname: "")
}

// The typed empty item list an error return answers with.
def no_items() Array[Item] {
  return []
}

// The empty declaration sentinel, parse_decl's error answer.
def empty_decl() Decl {
  return Decl.new(constant: false, name: "", value_tok: [])
}

// Whether the token is the reserved word: one bare, unquoted part
// whose text is exactly the word — `'if'` and `"while"` are
// arguments, never keywords.
def is_word(tok lex.Tok, word String) Bool {
  if tok.kind != "word" {
    return false
  }
  const parts = tok.parts
  if parts.length() != 1 {
    return false
  }
  const part = parts[0]
  return !part.lit && !part.quoted && part.text == word
}

// The reserved word a token names where a command may start, or ""
// when it names none.
def reserved_word(tok lex.Tok) String {
  if is_word(tok, "if") {
    return "if"
  }
  if is_word(tok, "while") {
    return "while"
  }
  if is_word(tok, "for") {
    return "for"
  }
  if is_word(tok, "def") {
    return "def"
  }
  if is_word(tok, "const") {
    return "const"
  }
  if is_word(tok, "var") {
    return "var"
  }
  return ""
}

// Whether the tokens up to (not including) the opening brace read as
// one numeric comparison expression: every token a bare unquoted word
// or one of the comparison and boolean connective operators, with at
// least one comparison among them. Anything else — a quoted part, a
// redirection, a pipe, a connector — says command list.
def cond_is_expr(tokens Array[lex.Tok], i Int64) Bool {
  var j = i
  var found = false
  var going = true
  while going {
    if j >= tokens.length() {
      going = false
    } else {
      const tok = tokens[j]
      if is_word(tok, "{") {
        going = false
      } else {
        const kind = tok.kind
        if kind == "<" || kind == ">" || kind == "<=" || kind == ">=" || kind == "==" || kind == "!=" {
          found = true
          j = j + 1
        } else {
          if kind == "&&" || kind == "||" {
            j = j + 1
          } else {
            if kind == "word" {
              const parts = tok.parts
              if parts.length() != 1 || parts[0].lit || parts[0].quoted {
                going = false
              } else {
                j = j + 1
              }
            } else {
              going = false
            }
          }
        }
      }
    }
  }
  return found
}

// A word token's bare unquoted text — the refusal for anything else.
def word_text_of(tokens Array[lex.Tok], i Int64) (R, String) {
  if i >= tokens.length() {
    return (R.error, "the line ended")
  }
  const tok = tokens[i]
  if tok.kind != "word" {
    return (R.error, "not a word")
  }
  const parts = tok.parts
  if parts.length() != 1 || parts[0].lit || parts[0].quoted {
    return (R.error, "not a bare word")
  }
  return (R.ok, parts[0].text)
}

// The whole line's items, and the status: "" ready to run,
// "incomplete" — a block still open, the driver reads the next line —
// or, with R.error, the reason the line refused.
def parse(tokens Array[lex.Tok]) (R, Array[Item], String) {
  if tokens.length() == 0 {
    return (R.ok, [], "")
  }
  const first = tokens[0].kind
  if first == lex.op_pipe() || first == lex.op_semi() || first == lex.op_andand() || first == lex.op_oror() || first == lex.op_amp() {
    return (R.error, no_items(), "a line does not start with " + first)
  }
  if is_word(tokens[0], "}") {
    return (R.error, no_items(), "unexpected }")
  }
  case parse_item_list(tokens, 0, "") {
    (R.error, _, _, why) then { return (R.error, no_items(), why) }
    (R.ok, items, _, status) then {
      return (R.ok, items, status)
    }
  }
}

// One item — pipeline, compound, declaration, or assignment — with
// the index just past it and the status.
def parse_item(tokens Array[lex.Tok], i Int64) (R, Item, Int64, String) {
  const kw = reserved_word(tokens[i])
  if kw == "if" || kw == "while" || kw == "for" || kw == "def" {
    case parse_compound(kw, tokens, i) {
      (R.error, _, _, why) then { return (R.error, empty_item(), -1, why) }
      (R.ok, c, next, status) then {
        if status == "incomplete" {
          return (R.ok, empty_item(), next, status)
        }
        const compounds = ArrayBuilder.new()
        compounds.push(c)
        return (R.ok, Item.new(pipeline: [], compounds: compounds.to_array(), decls: [], assigns: [], expr_tok: [], conn: "", bg: false), next, "")
      }
    }
  }
  if kw == "const" || kw == "var" {
    case parse_decl(kw, tokens, i) {
      (R.error, _, _, why) then { return (R.error, empty_item(), -1, why) }
      (R.ok, d, next, status) then {
        const decls = ArrayBuilder.new()
        decls.push(d)
        return (R.ok, Item.new(pipeline: [], compounds: [], decls: decls.to_array(), assigns: [], expr_tok: [], conn: "", bg: false), next, status)
      }
    }
  }
  if assign_starts(tokens, i) {
    case parse_assign(tokens, i) {
      (R.error, _, _, why) then { return (R.error, empty_item(), -1, why) }
      (R.ok, a, next, status) then {
        const assigns = ArrayBuilder.new()
        assigns.push(a)
        return (R.ok, Item.new(pipeline: [], compounds: [], decls: [], assigns: assigns.to_array(), expr_tok: [], conn: "", bg: false), next, status)
      }
    }
  }
  case parse_pipeline(tokens, i) {
    (R.error, why) then { return (R.error, empty_item(), -1, why) }
    (R.ok, got) then {
      return (R.ok, Item.new(pipeline: got[0], compounds: [], decls: [], assigns: [], expr_tok: expr_statement_slice(tokens, i, got[1]), conn: "", bg: false), got[1], "")
    }
  }
}

// Items with their connectors, until the closer word arrives (left
// unconsumed, the caller's to eat) or the tokens run out (incomplete
// for a closer that exists, the natural end for the top level's ""). A
// background item and a closed compound act as their own separators —
// what follows them starts a new item; a plain pipeline's word after
// word refuses.
def parse_item_list(tokens Array[lex.Tok], i Int64, closer String) (R, Array[Item], Int64, String) {
  const items = ArrayBuilder.new()
  var j = i
  var going = true
  while going {
    if j >= tokens.length() {
      // a closer that never arrived: the block is still open, the
      // caller reads the next line; the top level's "" just ends
      if closer != "" {
        return (R.ok, items.to_array(), -1, "incomplete")
      }
      going = false
    } else {
      if closer != "" && is_word(tokens[j], closer) {
        going = false
      } else {
        if tokens[j].kind == lex.op_semi() {
          // an empty statement — `;;` and the separator a joined
          // line rides in on — is silence, the classic looseness
          j = j + 1
        } else {
        case parse_item(tokens, j) {
          (R.error, _, _, why) then {
            return (R.error, no_items(), -1, why)
          }
          (R.ok, item, next, status) then {
            if next < 0 {
              // the items so far ride out with the incomplete mark —
              // the driver re-parses the whole line after the next one
              return (R.ok, items.to_array(), -1, status)
            }
            var j2 = next
            var bg = false
            if j2 < tokens.length() && tokens[j2].kind == lex.op_amp() {
              bg = true
              j2 = j2 + 1
            }
            var conn = ""
            var sane = true
            if j2 < tokens.length() {
              const kind = tokens[j2].kind
              if kind == lex.op_semi() {
                conn = ";"
                j2 = j2 + 1
              } else {
                if kind == lex.op_andand() || kind == lex.op_oror() {
                  conn = kind
                  j2 = j2 + 1
                } else {
                  if (closer != "" && is_word(tokens[j2], closer)) || is_word(tokens[j2], "{") || is_word(tokens[j2], "}") {
                    // the block's own brace ends this item quietly —
                    // the loop top's closer check takes over
                    conn = ""
                  } else {
                    if !bg && item.compounds.length() == 0 && item.decls.length() == 0 && item.assigns.length() == 0 {
                      sane = false
                    } else {
                      // the spawn of a background item and the close
                      // of a compound act as the separator themselves
                      conn = ";"
                    }
                  }
                }
              }
              if !sane {
                return (R.error, no_items(), -1, "unexpected " + tokens[j2].kind)
              }
              items.push(Item.new(pipeline: item.pipeline, compounds: item.compounds, decls: item.decls, assigns: item.assigns, expr_tok: item.expr_tok, conn: conn, bg: bg))
              j = j2
            } else {
              // a background item's spawn at the very end: still one
              // item, the line complete
              items.push(Item.new(pipeline: item.pipeline, compounds: item.compounds, decls: item.decls, assigns: item.assigns, expr_tok: item.expr_tok, conn: "", bg: bg))
              j = j2
            }
          }
        }
        }
      }
    }
  }
  return (R.ok, items.to_array(), j, "")
}

// One pipeline: its stages and the index just past it, or the reason
// one of the stages is malformed.
def parse_pipeline(tokens Array[lex.Tok], start Int64) (R, (Array[Cmd], Int64)) {
  const stages = ArrayBuilder.new()
  case parse_command(tokens, start) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, first) then {
      stages.push(first[0])
      var i = first[1]
      var piping = true
      while piping && i < tokens.length() && tokens[i].kind == lex.op_pipe() {
        case parse_command(tokens, i + 1) {
          (R.error, why) then {
            piping = false
            return (R.error, why)
          }
          (R.ok, stage) then {
            stages.push(stage[0])
            i = stage[1]
          }
        }
      }
      return (R.ok, (stages.to_array(), i))
    }
  }
}

// One command: words and redirections in order; empty refuses.
def parse_command(tokens Array[lex.Tok], start Int64) (R, (Cmd, Int64)) {
  const words = ArrayBuilder.new()
  const redirs = ArrayBuilder.new()
  var i = start
  var in_command = true
  while in_command && i < tokens.length() {
    const tok = tokens[i]
    if tok.kind == "word" {
      if is_word(tok, "{") || is_word(tok, "}") {
        // reserved: a standalone brace opens or closes a block — it
        // ends the command here, never joins its words (a literal
        // brace quotes)
        in_command = false
      } else {
        words.push(tok.parts)
        i = i + 1
      }
    } else {
      if tok.kind == "==" || tok.kind == "!=" || tok.kind == "<=" || tok.kind == ">=" {
        // the comparison operators ride in a command as ordinary
        // words — `grep == hi` runs grep, `echo a == b` prints —
        // while the expression reading picks them up as operators
        // (`s == 3` compares); the executor's head probe chooses
        const parts = ArrayBuilder.new()
        parts.push(expand.Part.new(text: tok.kind, lit: false, quoted: false))
        words.push(parts.to_array())
        i = i + 1
      } else {
        case redir_of(tok.kind) {
          (R.error, _) then { in_command = false }
          (R.ok, shape) then {
            if shape[1] == ">&" || shape[1] == "<&" {
              // the dup forms: one token, no file follows
              redirs.push(Redir.new(op: shape[1], fd: shape[0], dup: shape[2], word: []))
              i = i + 1
            } else {
              if i + 1 >= tokens.length() || tokens[i + 1].kind != "word" {
                return (R.error, "" + tok.kind + " needs a file name")
              }
              redirs.push(Redir.new(op: shape[1], fd: shape[0], dup: 0 - 1, word: tokens[i + 1].parts))
              i = i + 2
            }
          }
        }
      }
    }
  }
  if words.length() == 0 && redirs.length() == 0 {
    if i >= tokens.length() {
      return (R.error, "unexpected end of line")
    }
    return (R.error, "expected a command before " + tokens[i].kind)
  }
  return (R.ok, (Cmd.new(words: words.to_array(), redirs: redirs.to_array()), i))
}

// One redirection token's shape: the descriptor it lands on, the
// operator (`<`, `>`, `>>` opening files, `>&`, `<&` following
// another descriptor), and the descriptor a dup follows — or the
// refusal for a token that is no redirection at all. `2>&1` is just
// the family's everyday face here.
def redir_of(kind String) (R, (Int64, String, Int64)) {
  if kind == lex.op_lt() {
    return (R.ok, (0, "<", 0 - 1))
  }
  if kind == lex.op_gt() {
    return (R.ok, (1, ">", 0 - 1))
  }
  if kind == lex.op_gtgt() {
    return (R.ok, (1, ">>", 0 - 1))
  }
  const len = kind.length()
  if len >= 3 {
    const tail = kind.substring(len - 2, 2)
    if tail == ">>" && expand.is_digits(kind.substring(0, len - 2)) {
      return (R.ok, (expand.digits_value(kind.substring(0, len - 2)), ">>", 0 - 1))
    }
  }
  // the dup forms, `2>&1` their everyday face — and `>&2`, `<&0`,
  // `10>&3` beside it: the last `&` splits the operator (the `>` or
  // `<` before it) from the target descriptor digits after it, the
  // head naming the descriptor the redirection lands on
  var amp = 0 - 1
  var scan = len - 1
  var searching = scan >= 0
  while searching {
    if kind.substring(scan, 1) == "&" {
      amp = scan
      searching = false
    } else {
      scan = scan - 1
      if scan < 0 {
        searching = false
      }
    }
  }
  if amp > 0 {
    const opch = kind.substring(amp - 1, 1)
    if opch == ">" || opch == "<" {
      const target = kind.substring(amp + 1, len - amp - 1)
      if expand.is_digits(target) {
        const head = kind.substring(0, amp - 1)
        var fd = 1
        var dup_op = ">&"
        if opch == "<" {
          fd = 0
          dup_op = "<&"
        }
        if head == "" {
          return (R.ok, (fd, dup_op, expand.digits_value(target)))
        }
        if expand.is_digits(head) {
          return (R.ok, (expand.digits_value(head), dup_op, expand.digits_value(target)))
        }
        if head == ">" && opch == ">" {
          return (R.ok, (1, ">&", expand.digits_value(target)))
        }
        if head == "<" && opch == "<" {
          return (R.ok, (0, "<&", expand.digits_value(target)))
        }
      }
    }
  }
  if len >= 2 {
    const last = kind.substring(len - 1, 1)
    const head = kind.substring(0, len - 1)
    if (last == "<" || last == ">") && expand.is_digits(head) {
      return (R.ok, (expand.digits_value(head), last, 0 - 1))
    }
  }
  return (R.error, "no redirection")
}

// The compounds: `if`, `while`, and `for` share the shape of a head
// list followed by a brace body (the `else` chaining off the if), the
// `for` header carrying its three expression slices, and `def` the
// name, the required parentheses, and the body.
def parse_compound(kind String, tokens Array[lex.Tok], i Int64) (R, Compound, Int64, String) {
  if kind == "for" {
    return parse_for(tokens, i)
  }
  if kind == "def" {
    return parse_def(tokens, i)
  }
  var expr_cond = false
  if kind == "if" || kind == "while" {
    expr_cond = cond_is_expr(tokens, i + 1)
  }
  if expr_cond {
    case header_slice(tokens, i + 1, "{") {
      (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
      (R.ok, cond_tok, cond_next, status) then {
        if status == "incomplete" {
          return (R.ok, empty_compound(kind), cond_next, status)
        }
        if cond_tok.length() == 0 {
          return (R.error, empty_compound(kind), -1, "emosh: syntax error: " + kind + " wants a condition")
        }
        case parse_body(tokens, cond_next) {
          (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
          (R.ok, body, body_after, body_status) then {
            if body_status == "incomplete" {
              return (R.ok, empty_compound(kind), body_after, body_status)
            }
            var after = body_after
            var else_body = []
            if kind == "if" && after < tokens.length() && is_word(tokens[after], "else") {
              if after + 1 < tokens.length() && is_word(tokens[after + 1], "{") {
                case parse_body(tokens, after + 1) {
                  (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
                  (R.ok, else_parsed, else_after, else_status) then {
                    if else_status == "incomplete" {
                      return (R.ok, empty_compound(kind), else_after, else_status)
                    }
                    else_body = else_parsed
                    after = else_after
                  }
                }
              } else {
                return (R.error, empty_compound(kind), -1, "an expression condition's else wants {")
              }
            }
            return (R.ok, Compound.new(kind: kind, cond: [], body: body, else_body: else_body, var_name: "", init_tok: [], cond_tok: cond_tok, step_tok: [], fname: ""), after, "")
          }
        }
      }
    }
  }
  case parse_item_list(tokens, i + 1, "{") {
    (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
    (R.ok, cond, brace, status) then {
      if status == "incomplete" {
        return (R.ok, empty_compound(kind), brace, status)
      }
      if cond.length() == 0 {
        return (R.error, empty_compound(kind), -1, "" + kind + " wants a condition")
      }
      case parse_body(tokens, brace) {
        (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
        (R.ok, body, body_after, status) then {
          if status == "incomplete" {
            return (R.ok, empty_compound(kind), body_after, status)
          }
          var after = body_after
          var else_body = []
          if kind == "if" && after < tokens.length() && is_word(tokens[after], "else") {
            if after + 1 < tokens.length() && is_word(tokens[after + 1], "if") {
              case parse_compound("if", tokens, after + 1) {
                (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
                (R.ok, nested, nested_after, status) then {
                  if status == "incomplete" {
                    return (R.ok, empty_compound(kind), nested_after, status)
                  }
                  const wrapper = ArrayBuilder.new()
                  wrapper.push(Item.new(pipeline: [], compounds: [nested], decls: [], assigns: [], expr_tok: [], conn: "", bg: false))
                  else_body = wrapper.to_array()
                  after = nested_after
                }
              }
            } else {
              if after + 1 < tokens.length() && is_word(tokens[after + 1], "{") {
                case parse_body(tokens, after + 1) {
                  (R.error, _, _, why) then { return (R.error, empty_compound(kind), -1, why) }
                  (R.ok, else_parsed, else_after, status) then {
                    if status == "incomplete" {
                      return (R.ok, empty_compound(kind), else_after, status)
                    }
                    else_body = else_parsed
                    after = else_after
                  }
                }
              } else {
                return (R.error, empty_compound(kind), -1, "else wants { or if")
              }
            }
          }
          return (R.ok, Compound.new(kind: kind, cond: cond, body: body, else_body: else_body, var_name: "", init_tok: [], cond_tok: [], step_tok: [], fname: ""), after, "")
        }
      }
    }
  }
}

// The for's header: `var` NAME = init ; cond ; step — the three
// expressions kept as the token slices the evaluator reads, then the
// brace body.
def parse_for(tokens Array[lex.Tok], i Int64) (R, Compound, Int64, String) {
  const j = i + 1
  if j >= tokens.length() || !is_word(tokens[j], "var") {
    return (R.error, empty_compound("for"), -1, "for wants `for var name = expr; expr; expr {`")
  }
  case word_text_of(tokens, j + 1) {
    (R.error, why) then { return (R.error, empty_compound("for"), -1, why) }
    (R.ok, name) then {
      if !expand.is_name(name) {
        return (R.error, empty_compound("for"), -1, "for wants a variable name")
      }
      if j + 2 >= tokens.length() || !is_word(tokens[j + 2], "=") {
        return (R.error, empty_compound("for"), -1, "the for header wants =")
      }
      case header_slice(tokens, j + 3, ";") {
        (R.error, _, _, why) then { return (R.error, empty_compound("for"), -1, why) }
        (R.ok, init_tok, init_next, init_status) then {
          if init_status == "incomplete" {
            return (R.ok, empty_compound("for"), init_next, init_status)
          }
          case header_slice(tokens, init_next + 1, ";") {
            (R.error, _, _, why) then { return (R.error, empty_compound("for"), -1, why) }
            (R.ok, cond_tok, cond_next, cond_status) then {
              if cond_status == "incomplete" {
                return (R.ok, empty_compound("for"), cond_next, cond_status)
              }
              case header_slice(tokens, cond_next + 1, "{") {
                (R.error, _, _, why) then { return (R.error, empty_compound("for"), -1, why) }
                (R.ok, step_tok, step_next, step_status) then {
                  if step_status == "incomplete" {
                    return (R.ok, empty_compound("for"), step_next, step_status)
                  }
                  if init_tok.length() == 0 || cond_tok.length() == 0 || step_tok.length() == 0 {
                    return (R.error, empty_compound("for"), -1, "the for header wants three expressions")
                  }
                  case parse_body(tokens, step_next) {
                    (R.error, _, _, why) then { return (R.error, empty_compound("for"), -1, why) }
                    (R.ok, body, body_after, body_status) then {
                      if body_status == "incomplete" {
                        return (R.ok, empty_compound("for"), body_after, body_status)
                      }
                      return (R.ok, Compound.new(kind: "for", cond: [], body: body, else_body: [], var_name: name, init_tok: init_tok, cond_tok: cond_tok, step_tok: step_tok, fname: ""), body_after, "")
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}

// A def's head: the name — written `greet()` with the parentheses
// attached or `greet ()` apart — then the brace body.
def parse_def(tokens Array[lex.Tok], i Int64) (R, Compound, Int64, String) {
  case word_text_of(tokens, i + 1) {
    (R.error, why) then { return (R.error, empty_compound("def"), -1, why) }
    (R.ok, text) then {
      var name = text
      var body_i = i + 2
      if !expand.is_name(text) {
        const len = text.length()
        if len > 2 && text.substring(len - 2, 2) == "()" && expand.is_name(text.substring(0, len - 2)) {
          name = text.substring(0, len - 2)
        } else {
          return (R.error, empty_compound("def"), -1, "def wants a name")
        }
      } else {
        // a bare name: the `()` must follow as its own word
        if i + 2 >= tokens.length() || !is_word(tokens[i + 2], "()") {
          return (R.error, empty_compound("def"), -1, "def " + name + " wants ()")
        }
        body_i = i + 3
      }
      case parse_body(tokens, body_i) {
        (R.error, _, _, why) then { return (R.error, empty_compound("def"), -1, why) }
        (R.ok, body, after, status) then {
          if status == "incomplete" {
            return (R.ok, empty_compound("def"), after, status)
          }
          return (R.ok, Compound.new(kind: "def", cond: [], body: body, else_body: [], var_name: "", init_tok: [], cond_tok: [], step_tok: [], fname: name), after, "")
        }
      }
    }
  }
}

// A declaration: const or var, a valid name, then = and the one word
// the binding takes.
def parse_decl(kw String, tokens Array[lex.Tok], i Int64) (R, Decl, Int64, String) {
  case word_text_of(tokens, i + 1) {
    (R.error, why) then { return (R.error, empty_decl(), -1, why) }
    (R.ok, name) then {
      if !expand.is_name(name) {
        return (R.error, empty_decl(), -1, "" + kw + " wants a valid name")
      }
      if i + 2 >= tokens.length() || !is_word(tokens[i + 2], "=") {
        return (R.error, empty_decl(), -1, "the declaration wants spaces around =")
      }
      var vend = i + 3
      while vend < tokens.length() && decl_value_token(tokens[vend]) {
        vend = vend + 1
      }
      if vend == i + 3 {
        return (R.error, empty_decl(), -1, "" + kw + " wants a value")
      }
      const value_tok = header_slice_tokens(tokens, i + 3, vend)
      return (R.ok, Decl.new(constant: kw == "const", name: name, value_tok: value_tok), vend, "")
    }
  }
}

// Whether an assignment opens here: a bare word naming a valid
// variable, followed by the bare `=` — `n = n - 1`, the rebinding a
// loop body lives on. `==` is its own token and never trips this; a
// quoted word is an argument like any other; a command that genuinely
// wants a bare `=` argument quotes something.
def assign_starts(tokens Array[lex.Tok], i Int64) Bool {
  if i + 1 >= tokens.length() {
    return false
  }
  if !is_word(tokens[i + 1], "=") {
    return false
  }
  const tok = tokens[i]
  if tok.kind != "word" {
    return false
  }
  const parts = tok.parts
  if parts.length() != 1 || parts[0].lit || parts[0].quoted {
    return false
  }
  return expand.is_name(parts[0].text)
}

// One assignment: the name (the probe has checked its shape), then =
// and the value tokens — the same slice a declaration's value takes,
// every separator ending it. No value refuses.
def parse_assign(tokens Array[lex.Tok], i Int64) (R, Assign, Int64, String) {
  const name = tokens[i].parts[0].text
  var vend = i + 2
  while vend < tokens.length() && decl_value_token(tokens[vend]) {
    vend = vend + 1
  }
  if vend == i + 2 {
    return (R.error, empty_assign(), -1, "the assignment wants a value")
  }
  return (R.ok, Assign.new(name: name, value_tok: header_slice_tokens(tokens, i + 2, vend)), vend, "")
}

// Whether the token rides in a declaration's or assignment's value
// expression: bare words and the comparison/boolean operators do,
// every separator (semicolon, pipe, ampersand) ends it — and so does
// a reserved standalone brace, `{` opening a block the value would
// otherwise swallow and `}` closing the one the value stands in (a
// one-line `if true { var x = 1 }` was the shape the first cut broke:
// the closing brace rode into the value and the block never closed).
// A quoted brace is a word like any other and rides in.
def decl_value_token(tok lex.Tok) Bool {
  const kind = tok.kind
  if kind == "word" {
    const parts = tok.parts
    if parts.length() == 1 && !parts[0].lit && !parts[0].quoted {
      const text = parts[0].text
      if text == "{" || text == "}" {
        return false
      }
    }
    return true
  }
  if kind == "<" || kind == ">" || kind == "<=" || kind == ">=" || kind == "==" || kind == "!=" || kind == "&&" || kind == "||" {
    return true
  }
  return false
}

// Whether the token rides in an expression statement's run: a bare
// single-part word — the arithmetic operators and parentheses are
// words like any other — or one of the comparison operators. The
// boolean connectors are item boundaries here, not operators: `s + 1
// && echo ok` is the expression, then the connector, then the next
// item.
def expr_token(tok lex.Tok) Bool {
  const kind = tok.kind
  if kind == "<" || kind == ">" || kind == "<=" || kind == ">=" || kind == "==" || kind == "!=" {
    return true
  }
  if kind == "word" {
    const parts = tok.parts
    return parts.length() == 1 && !parts[0].lit && !parts[0].quoted
  }
  return false
}

// The expression reading of the command run from i up to end — the
// whole run when every token rides, [] the moment any token breaks
// the shape (a quoted part, a multi-part word, a connector, anything
// else). The parse only records that the shape allows the question;
// the executor chooses between the readings by the session's own
// names.
def expr_statement_slice(tokens Array[lex.Tok], i Int64, end Int64) Array[lex.Tok] {
  const out = ArrayBuilder.new()
  var j = i
  var all = true
  while j < end {
    if expr_token(tokens[j]) {
      out.push(tokens[j])
    } else {
      all = false
    }
    j = j + 1
  }
  if all {
    return out.to_array()
  }
  return []
}

// The tokens from i up to — not including — end: a plain slice with
// the type the declaration's value carries.
def header_slice_tokens(tokens Array[lex.Tok], i Int64, end Int64) Array[lex.Tok] {
  const out = ArrayBuilder.new()
  var j = i
  while j < end {
    out.push(tokens[j])
    j = j + 1
  }
  return out.to_array()
}

// A braced body: the `{` consumed, the items parsed, the `}`
// consumed.
def parse_body(tokens Array[lex.Tok], i Int64) (R, Array[Item], Int64, String) {
  if i >= tokens.length() || !is_word(tokens[i], "{") {
    return (R.ok, [], -1, "incomplete")
  }
  case parse_item_list(tokens, i + 1, "}") {
    (R.error, _, _, why) then { return (R.error, no_items(), -1, why) }
    (R.ok, items, close, status) then {
      if status == "incomplete" {
        return (R.ok, items, close, status)
      }
      return (R.ok, items, close + 1, "")
    }
  }
}

// The tokens from i up to — not including — the stop word or kind,
// and the index of the stop itself. Reaching the end without one
// answers incomplete.
def header_slice(tokens Array[lex.Tok], i Int64, stop String) (R, Array[lex.Tok], Int64, String) {
  const out = ArrayBuilder.new()
  var j = i
  var going = true
  while going {
    if j >= tokens.length() {
      return (R.ok, out.to_array(), j, "incomplete")
    } else {
      if is_word(tokens[j], stop) || tokens[j].kind == stop {
        going = false
      } else {
        out.push(tokens[j])
        j = j + 1
      }
    }
  }
  return (R.ok, out.to_array(), j, "")
}
