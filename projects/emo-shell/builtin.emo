require "os"

// The shell's own commands — the thirteen a forked child cannot do
// for the session: `cd` and the environment change this process,
// `exit` ends it, the job family (`jobs`/`fg`/`bg`/`wait`/`kill`)
// answers from the job table the session holds, and the rest answer
// from state every command shares. Every one of them writes
// through the shell's raw-descriptor writers, so a builtin running in
// a pipeline's fork child puts its bytes on the wired descriptor, not
// in some buffer `_exit` would discard.
//
// The error lines carry the shell's name, then the command's — the
// classic shape (`emosh: cd: no such directory`); a failure of the
// underlying os call reports that call's own reason, the text the
// `os` package writes.

def is_builtin(name String) Bool {
  return name == "cd" || name == "pwd" || name == "echo" || name == "exit"
    || name == "export" || name == "unset" || name == "true" || name == "false"
    || name == "jobs" || name == "fg" || name == "bg" || name == "wait"
    || name == "kill"
}

// One builtin, its words already expanded; the answer is the exit
// status.
def run(sh shell.Shell, words Array[String]) Int64 {
  const name = words[0]
  if name == "cd" {
    return cd(sh, words)
  }
  if name == "pwd" {
    sh.line(os.getcwd())
    return 0
  }
  if name == "echo" {
    return echo(sh, words)
  }
  if name == "exit" {
    return exit(sh, words)
  }
  if name == "export" {
    return export(sh, words)
  }
  if name == "unset" {
    return unset(sh, words)
  }
  if name == "jobs" {
    return jobs(sh, words)
  }
  if name == "fg" {
    return fg(sh, words)
  }
  if name == "bg" {
    return bg(sh, words)
  }
  if name == "wait" {
    return wait(sh, words)
  }
  if name == "kill" {
    return kill(sh, words)
  }
  if name == "true" {
    return 0
  }
  return 1
}

// cd: no argument means $HOME; one argument means there; more than
// one refuses the way the classic shells do.
def cd(sh shell.Shell, words Array[String]) Int64 {
  if words.length() > 2 {
    sh.err("emosh: cd: too many arguments")
    return 1
  }
  var target = ""
  if words.length() == 1 {
    case os.getenv("HOME") {
      (R.ok, home) then { target = home }
      (R.error, _) then {
        sh.err("emosh: cd: HOME not set")
        return 1
      }
    }
  } else {
    target = words[1]
  }
  case os.chdir(target) {
    (R.error, why) then {
      sh.err("emosh: cd: " + why)
      return 1
    }
    (R.ok, _) then { return 0 }
  }
}

// echo: the words joined with one space, one newline after — no
// flags, the text verbatim.
def echo(sh shell.Shell, words Array[String]) Int64 {
  var text = ""
  for var i = 1; i < words.length(); i = i + 1 {
    if i > 1 {
      text = text + " "
    }
    text = text + words[i]
  }
  sh.line(text)
  return 0
}

// exit: no argument means the last status; one means that number,
// folded into the kernel's low byte the way the kernel itself folds
// it; more than one refuses without leaving, and a number that is not
// a number refuses the way the classic shells name it.
def exit(sh shell.Shell, words Array[String]) Int64 {
  if words.length() > 2 {
    sh.err("emosh: exit: too many arguments")
    return 1
  }
  var code = sh.status()
  if words.length() == 2 {
    if !numeric(words[1]) {
      sh.err("emosh: exit: " + words[1] + ": numeric argument required")
      code = 2
    } else {
      code = words[1].to_int64()
    }
  }
  sh.set_status(fold(code))
  sh.stop()
  return fold(code)
}

// export: each argument a NAME=VALUE pair set into this process's
// environment, inherited by every command it forks from now on. A
// bare name (no `=`) is accepted and does nothing — there are no
// shell-only variables to mark — and a name that is not a name
// refuses.
def export(sh shell.Shell, words Array[String]) Int64 {
  var status = 0
  for var i = 1; i < words.length(); i = i + 1 {
    const arg = words[i]
    const eq = arg.index_of("=")
    if eq < 1 {
      if !is_name(arg) {
        sh.err("emosh: export: " + arg + ": not a valid name")
        status = 1
      }
    } else {
      const name = arg.substring(0, eq)
      const value = arg.substring(eq + 1, arg.length() - eq - 1)
      if !is_name(name) {
        sh.err("emosh: export: " + name + ": not a valid name")
        status = 1
      } else {
        case os.setenv(name, value) {
          (R.error, why) then {
            sh.err("emosh: export: " + why)
            status = 1
          }
          (R.ok, _) then {}
        }
      }
    }
  }
  return status
}

// unset: each argument removed from the environment; an unset name
// that was never set is silence, a name that is not a name refuses.
def unset(sh shell.Shell, words Array[String]) Int64 {
  var status = 0
  for var i = 1; i < words.length(); i = i + 1 {
    if !is_name(words[i]) {
      sh.err("emosh: unset: " + words[i] + ": not a valid name")
      status = 1
    } else {
      case os.unsetenv(words[i]) {
        (R.error, why) then {
          sh.err("emosh: unset: " + why)
          status = 1
        }
        (R.ok, _) then {}
      }
    }
  }
  return status
}

// jobs: one poll first — the finished jobs announced and dropped —
// then whatever is still running, the classic shape with the pid in
// it.
def jobs(sh shell.Shell, words Array[String]) Int64 {
  sh.notify()
  sh.list_jobs()
  return 0
}

// fg: the job named by number comes to the foreground — the shell
// parks on its whole pipeline, the job's own status the answer.
// Honest limit: without a terminal-handoff call the job keeps its
// own process group, so a Ctrl-C aimed at the shell's group cannot
// reach it; the waiting is what foreground means here.
def fg(sh shell.Shell, words Array[String]) Int64 {
  if words.length() != 2 {
    sh.err("emosh: fg: job spec required")
    return 1
  }
  const n = job_spec(words[1])
  if n < 1 {
    sh.err("emosh: fg: " + words[1] + ": no such job")
    return 1
  }
  case sh.find_job(n) {
    (R.error, _) then {
      sh.err("emosh: fg: " + words[1] + ": no such job")
      return 1
    }
    (R.ok, job) then {
      const status = job.wait_blocking()
      sh.drop_job(job.n)
      return status
    }
  }
}

// bg: nothing in this shell ever stops — a job is born running in a
// process group of its own — so the only truthful answer is the
// classic one, the job is already where it would go.
def bg(sh shell.Shell, words Array[String]) Int64 {
  if words.length() != 2 {
    sh.err("emosh: bg: job spec required")
    return 1
  }
  const n = job_spec(words[1])
  if n < 1 {
    sh.err("emosh: bg: " + words[1] + ": no such job")
    return 1
  }
  case sh.find_job(n) {
    (R.error, _) then {
      sh.err("emosh: bg: " + words[1] + ": no such job")
      return 1
    }
    (R.ok, job) then {
      sh.err("emosh: bg: job " + job.n.to_string() + " already in background")
      return 1
    }
  }
}

// wait: no argument parks on every job and empties the table; one
// job spec parks on that job alone, its status the answer. An
// unknown job is 127, the classic waited-for-nothing.
def wait(sh shell.Shell, words Array[String]) Int64 {
  if words.length() == 1 {
    return sh.wait_all()
  }
  if words.length() > 2 {
    sh.err("emosh: wait: too many arguments")
    return 1
  }
  const n = job_spec(words[1])
  if n < 1 {
    sh.err("emosh: wait: " + words[1] + ": no such job")
    return 127
  }
  case sh.find_job(n) {
    (R.error, _) then {
      sh.err("emosh: wait: " + words[1] + ": no such job")
      return 127
    }
    (R.ok, job) then {
      const status = job.wait_blocking()
      sh.drop_job(job.n)
      return status
    }
  }
}

// kill: each target — a pid, or `%n` for a whole job's process group,
// the negative pid the os package documents — takes the signal, `-N`
// naming it and 15 the default. One target failing fails the command.
def kill(sh shell.Shell, words Array[String]) Int64 {
  if words.length() < 2 {
    sh.err("emosh: kill: usage: kill [-N] target...")
    return 1
  }
  var sig = os.sig_term()
  var first = 1
  if words[1].length() > 1 && words[1].substring(0, 1) == "-" {
    const body = words[1].substring(1, words[1].length() - 1)
    if !numeric(body) {
      sh.err("emosh: kill: unknown signal: " + words[1])
      return 1
    }
    sig = body.to_int64()
    first = 2
    if words.length() == 2 {
      sh.err("emosh: kill: usage: kill [-N] target...")
      return 1
    }
  }
  var status = 0
  for var k = first; k < words.length(); k = k + 1 {
    const target = words[k]
    if target.substring(0, 1) == "%" {
      const n = job_spec(target)
      case sh.find_job(n) {
        (R.error, _) then {
          sh.err("emosh: kill: " + target + ": no such job")
          status = 1
        }
        (R.ok, job) then {
          case os.kill(0 - job.rep, sig) {
            (R.error, why) then {
              sh.err("emosh: kill: " + why)
              status = 1
            }
            (R.ok, _) then {}
          }
        }
      }
    } else {
      if !numeric(target) {
        sh.err("emosh: kill: " + target + ": arguments must be pids or job specs")
        status = 1
      } else {
        case os.kill(target.to_int64(), sig) {
          (R.error, why) then {
            sh.err("emosh: kill: " + why)
            status = 1
          }
          (R.ok, _) then {}
        }
      }
    }
  }
  return status
}

// One job spec: `%3` or a bare `3` names job number 3; anything else
// answers -1 — no job number at all.
def job_spec(text String) Int64 {
  if text.length() == 0 {
    return 0 - 1
  }
  if text.substring(0, 1) == "%" {
    const body = text.substring(1, text.length() - 1)
    if body.length() > 0 && numeric(body) {
      return body.to_int64()
    }
    return 0 - 1
  }
  if numeric(text) {
    return text.to_int64()
  }
  return 0 - 1
}

// The ASCII identifier set, the same rule the expansion's `$name`
// uses — matched through expand's own tables.
def is_name(name String) Bool {
  if name.length() == 0 {
    return false
  }
  if !expand.is_name_first(name.substring(0, 1)) {
    return false
  }
  for var i = 1; i < name.length(); i = i + 1 {
    if !expand.is_name_rest(name.substring(i, 1)) {
      return false
    }
  }
  return true
}

// Whether the text is a plain integer the exit status can take —
// an optional leading minus, then digits, nothing else.
def numeric(text String) Bool {
  if text.length() == 0 {
    return false
  }
  var i = 0
  if text.substring(0, 1) == "-" {
    i = 1
  }
  if i >= text.length() {
    return false
  }
  while i < text.length() {
    if !is_digit(text.substring(i, 1)) {
      return false
    }
    i = i + 1
  }
  return true
}

const digit_chars = "0123456789"

def is_digit(ch String) Bool {
  if ch == "" {
    return false
  }
  return digit_chars.index_of(ch) >= 0
}

// The kernel keeps the low byte of an exit status; fold it here so
// `exit 300` leaves 44 and `exit -1` leaves 255, the classic wrap.
def fold(code Int64) Int64 {
  var st = code % 256
  if st < 0 {
    st = st + 256
  }
  return st
}
