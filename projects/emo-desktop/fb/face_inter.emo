// The Inter 4.1 face's outlines (face format 1, emo-desktop A17.1): the
// quadratic outlines of the 95 printable ASCII glyphs and the face's
// own .notdef, generated from the pinned face in `fonts/` by
// `glyphs/outlines.py` — the scalable source the desktop's rasterizer
// strikes at any pixel size, where A14.2's `font.emo` could only ship
// the three pixel strikes its grid baked. A vertex word is the
// on-curve flag in its top byte and the signed deltas from the
// previous vertex in two 28-bit fields; an off-curve vertex bends the
// path through it, a run of them sharing the midpoints the generator
// resolved. The face is the SIL Open Font License 1.1's; its license
// travels beside the face it came from.

// -- the tables: written by glyphs/outlines.py from the pinned face --

// The head's numbers, in font units: the em square the
// outlines live on, and the line the ink hangs from.
def units_per_em() Int64 {
  return 2048
}
def ascent_fu() Int64 {
  return 1984
}
def descent_fu() Int64 {
  return -494
}
def line_gap_fu() Int64 {
  return 0
}
def glyphs() Int64 {
  return 96
}

// The printable ASCII characters in code order — the table's
// order, so a character's position here is its glyph index
// minus one, and index 0 is the face's own .notdef.
const alphabet = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"

// The glyph index of one character, handed as the one-byte String a
// label's walk cuts (`substring(i, 1)`): its position in the alphabet
// plus one, or the .notdef for a byte the face has no drawing of.
def glyph_of(c String) Int64 {
  const i = alphabet.index_of(c)
  if i < 0 {
    return 0
  }
  return i + 1
}

// Each glyph's first word in the outlines below, gid 0 through
// 95. The .notdef is glyph 0.
const bases = [0, 78, 81, 105, 117, 153, 234, 331, 414, 422, 448, 474, 496, 512, 520, 528, 548, 556, 592, 604, 648, 716, 736, 790, 862, 874, 958, 1030, 1066, 1090, 1102, 1114, 1126, 1190, 1310, 1333, 1389, 1443, 1473, 1489, 1503, 1558, 1574, 1582, 1608, 1629, 1639, 1680, 1712, 1764, 1796, 1854, 1889, 1963, 1975, 2009, 2028, 2067, 2103, 2124, 2154, 2166, 2174, 2186, 2198, 2206, 2214, 2297, 2352, 2398, 2453, 2503, 2537, 2610, 2638, 2662, 2694, 2711, 2719, 2768, 2796, 2848, 2903, 2958, 2985, 3041, 3073, 3101, 3120, 3161, 3193, 3226, 3242, 3288, 3296, 3341]

def outline_base(g Int64) Int64 {
  return bases[g]
}

