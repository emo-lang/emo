require "emo/ui_fb"

// The hosted surface (emo-desktop A7.1): the pixel words in one `Bytes`,
// row-major, four bytes to a pixel, `set_u32_le` the store and
// `get_u32_le` the load. It is the reference `ui_fb.Surface` — what the
// tests read as values and the goldens pin as bytes — and the hosted
// twin of the metal's carve surface, which keeps the same word
// discipline over raw memory (A7.2). Whole words, never bytes: the
// assessment's blit rule, kept here so the twin exercises the same
// stores the carve does.
//
// A package of its own, not a module of the core, because the core
// dual-runs on the metal and this file cannot: riscv64 lowers
// `Bytes.new` but none of its accessors (`emo_riscv.ml`). A package
// names the targets every module it carries compiles on, so the core
// declares `riscv64` and the canvas does not, and a hosted consumer
// takes both.

class Canvas {
  def init(width Int64, height Int64) {
    self.width = width
    self.height = height
    self.data = Bytes.new(width * height * 4)
  }

  def width() Int64 {
    return self.width
  }

  def height() Int64 {
    return self.height
  }

  // The word at a pixel; 0 for anything off the surface, the contract
  // every `Surface` keeps so a reader never has to clip.
  def at(x Int64, y Int64) Int64 {
    if x < 0 || x >= self.width || y < 0 || y >= self.height {
      return 0
    }
    return self.data.get_u32_le((y * self.width + x) * 4)
  }

  // A color stored over the rectangle, top byte cleared — a store is
  // never a blend, whatever coverage the color claims.
  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    const word = color & 0xFFFFFF
    for var row = r.y(); row < r.y() + r.h(); row = row + 1 {
      for var col = r.x(); col < r.x() + r.w(); col = col + 1 {
        self.data.set_u32_le((row * self.width + col) * 4, word)
      }
    }
  }

  // A color composited over the rectangle, pixel by pixel through
  // `ui_fb.over`: what is there is read, mixed, and written back.
  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    for var row = r.y(); row < r.y() + r.h(); row = row + 1 {
      for var col = r.x(); col < r.x() + r.w(); col = col + 1 {
        const i = (row * self.width + col) * 4
        self.data.set_u32_le(i, ui_fb.over(color, self.data.get_u32_le(i)))
      }
    }
  }

  // One glyph of a strike at the pen `(x, y)`, the line box's top-left
  // (A14.2): each pixel of its ink composited in the color's channels at
  // the glyph's own coverage, a clear pixel leaving the word alone.
  def ink(x Int64, y Int64, strike Int64, glyph Int64, color Int64) {
    const w = ui_fb.font.gw(strike, glyph)
    const n = w * ui_fb.font.gh(strike, glyph)
    const x0 = x + ui_fb.font.gleft(strike, glyph)
    const y0 = y + ui_fb.font.gtop(strike, glyph)
    for var m = 0; m < n; m = m + 1 {
      const c = ui_fb.font.pixel(strike, glyph, m)
      const px = x0 + m % w
      const py = y0 + m / w
      if c > 0 && px >= 0 && px < self.width && py >= 0 && py < self.height {
        blend_at(self.data, (py * self.width + px) * 4, ui_fb.inked(color, c))
      }
    }
  }

  // A rounded rectangle graded from `top` to `bottom` (A14.1): each row
  // walked in from both ends while its pixels are partly covered, the
  // whole pixels between them one span in the row's color.
  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    const rad = ui_fb.radius_in(radius, w, h)
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    for var row = r.y(); row < r.y() + r.h(); row = row + 1 {
      const color = ui_fb.grade(top, bottom, row - y, h)
      const base = row * self.width * 4
      var k = r.x()
      var j = r.x() + r.w() - 1
      if ((color >> 24) & 0xFF) == 0 {
        k = j + 1
      }
      while k <= j {
        const c = ui_fb.fill_cover(ui_fb.shape_sd(k, row, x, y, w, h, rad))
        if c >= 255 {
          break
        }
        blend_at(self.data, base + k * 4, ui_fb.cover(color, c))
        k = k + 1
      }
      while j >= k {
        const c = ui_fb.fill_cover(ui_fb.shape_sd(j, row, x, y, w, h, rad))
        if c >= 255 {
          break
        }
        blend_at(self.data, base + j * 4, ui_fb.cover(color, c))
        j = j - 1
      }
      span(self.data, base, k, j, color)
    }
  }

  // The ring `width` pixels deep inside a rounded rectangle's edge: each
  // row walked in from both ends until a pixel is clear with its center
  // inside — the interior the stroke never touches.
  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    const rad = ui_fb.radius_in(radius, w, h)
    const ring_w = if width > 0 { w } else { 0 }
    const r = ui_fb.clip(x, y, ring_w, h, self.width, self.height)
    for var row = r.y(); row < r.y() + r.h(); row = row + 1 {
      const base = row * self.width * 4
      var k = r.x()
      var j = r.x() + r.w() - 1
      while k <= j {
        const sd = ui_fb.shape_sd(k, row, x, y, w, h, rad)
        const c = ui_fb.stroke_cover(sd, width)
        if c == 0 && sd < 0 {
          break
        }
        blend_at(self.data, base + k * 4, ui_fb.cover(color, c))
        k = k + 1
      }
      while j >= k {
        const sd = ui_fb.shape_sd(j, row, x, y, w, h, rad)
        const c = ui_fb.stroke_cover(sd, width)
        if c == 0 && sd < 0 {
          break
        }
        blend_at(self.data, base + j * 4, ui_fb.cover(color, c))
        j = j - 1
      }
    }
  }

  // A rounded rectangle whose edge fades over `soft` pixels: the walk is
  // the fill's over the shape grown by the ramp's reach, the whole
  // pixels between one span.
  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    const rad = ui_fb.radius_in(radius, w, h)
    const pad = ui_fb.shadow_pad(soft)
    const grown_w = if w > 0 && h > 0 { w + pad * 2 } else { 0 }
    const r = ui_fb.clip(x - pad, y - pad, grown_w, h + pad * 2, self.width,
      self.height)
    for var row = r.y(); row < r.y() + r.h(); row = row + 1 {
      const base = row * self.width * 4
      var k = r.x()
      var j = r.x() + r.w() - 1
      while k <= j {
        const c = ui_fb.shadow_cover(ui_fb.shape_sd(k, row, x, y, w, h, rad),
          soft)
        if c >= 255 {
          break
        }
        blend_at(self.data, base + k * 4, ui_fb.cover(color, c))
        k = k + 1
      }
      while j >= k {
        const c = ui_fb.shadow_cover(ui_fb.shape_sd(j, row, x, y, w, h, rad),
          soft)
        if c >= 255 {
          break
        }
        blend_at(self.data, base + j * 4, ui_fb.cover(color, c))
        j = j - 1
      }
      span(self.data, base, k, j, color)
    }
  }

  // Memory has nothing to commit (A8.3): the words are the frame the
  // moment they are stored, and whoever holds the canvas reads them back
  // whenever it likes. The carve's `present` is the display's flush.
  def present() {
  }
}

// One word composited through `ui_fb.over` at byte offset `i` — nothing
// read or written when the color covers nothing.
def blend_at(data Bytes, i Int64, color Int64) {
  if ((color >> 24) & 0xFF) > 0 {
    data.set_u32_le(i, ui_fb.over(color, data.get_u32_le(i)))
  }
}

// Columns `from` to `to` of the row at byte offset `base` in one color:
// stored when it is opaque, composited when it is not.
def span(data Bytes, base Int64, from Int64, to Int64, color Int64) {
  if ((color >> 24) & 0xFF) >= 255 {
    const word = color & 0xFFFFFF
    for var col = from; col <= to; col = col + 1 {
      data.set_u32_le(base + col * 4, word)
    }
  } else {
    for var col = from; col <= to; col = col + 1 {
      blend_at(data, base + col * 4, color)
    }
  }
}

def canvas(width Int64, height Int64) ui_fb.Surface {
  return Canvas.new(width: width, height: height)
}
