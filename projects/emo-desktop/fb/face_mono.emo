def outline_word(k Int64) Int64 {
  const at = k
  if at < 448 {
    return data0[at - 0]
  }
  if at < 896 {
    return data1[at - 448]
  }
  if at < 1344 {
    return data2[at - 896]
  }
  if at < 1792 {
    return data3[at - 1344]
  }
  if at < 2240 {
    return data4[at - 1792]
  }
  if at < 2688 {
    return data5[at - 2240]
  }
  if at < 3136 {
    return data6[at - 2688]
  }
  return 0
}

