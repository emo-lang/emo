require "emo/ui"
require "emo/ui_fb"
require "emo/ui_fb_canvas"
require "emo/ui_fb_frame"

// The Elm loop's hosted twin (emo-desktop A7.2, A8.3): the counter run
// through `ui.run` on a canvas the size of the display's baseline mode
// (1024x768 XRGB8888, D5 — the mode `run.sh` gives the device and the
// pass reads back from it), with a script in the input's seat — add,
// add, sub, the three keys the metal's run feeds — and every frame's
// digest printed as the backend presents it. `expected.txt` is the
// interpreter's four lines; every hosted target prints the same, and it
// is the file `run.sh` asserts against on the metal (A7.3, A8.3): the
// first line is the first frame — the line the screen pass prints as
// its loop mounts, and the digest of the monitor's screendump — and the
// four together are the loop's frames in order, each the line the pass
// prints as it presents, the last the digest of the display at the
// session's end. One loop, two surfaces, one file.
//
//   emo run main.emo

// The canvas with the golden's eye on it: every verb is the canvas's,
// and `present` — the commit the backend makes after each paint — is
// where the digest is read and said. The metal's carve says the same
// line in its own `present`, off its own words.
class Eye {
  def init(canvas ui_fb.Surface) {
    self.canvas = canvas
  }

  def width() Int64 {
    return self.canvas.width()
  }

  def height() Int64 {
    return self.canvas.height()
  }

  def at(x Int64, y Int64) Int64 {
    return self.canvas.at(x, y)
  }

  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    self.canvas.fill(x, y, w, h, color)
  }

  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    self.canvas.blend(x, y, w, h, color)
  }

  def ink(x Int64, y Int64, f ui_fb.raster.Strike, glyph Int64, color Int64) {
    self.canvas.ink(x, y, f, glyph, color)
  }

  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    self.canvas.rounded(x, y, w, h, radius, top, bottom)
  }

  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    self.canvas.stroke(x, y, w, h, radius, width, color)
  }

  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    self.canvas.shadow(x, y, w, h, radius, soft, color)
  }

  def present() {
    println("frame ${ui_fb_frame.digest(self.canvas)}")
  }
}


  const holder = ArrayBuilder.new()
  case ui_fb.raster.strike(ui_fb.raster.inter(), 16) {
    (R.error, why) -> { println("the interface strike refused: ${why}") }
    (R.ok, s) -> { holder.push(s) }
  }
  const f = holder.get(0)

def main() {
  const screen = Eye.new(canvas: ui_fb_canvas.canvas(1920, 1080))
  ui.run(ui_fb_frame.counter.view, ui_fb_frame.counter.update,
    ui_fb_frame.counter.initial(),
    ui_fb.backend(screen, ui_fb.script([0, 0, 1]), f))
}

main()
