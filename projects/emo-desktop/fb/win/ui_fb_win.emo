require "emo/ui_fb"

// The window shell's windows (emo-desktop A9.1; the shared title bar
// A14.5, the one-button bar A16.1): what a toplevel surface looks
// like, painted once into the window's own buffer and again whenever
// its state changes — the frame the compositor carries into the carve
// at the stack's position (EmoOS T8.13). The bar is the one chrome
// every window wears: a single round button at the bar's left — the
// menu's door, the three the traffic lights wore now one (the lights
// were painted and hit-tested by no one; the button is the seat's to
// judge, the press-at's coordinates the wire — A16.2), the title in
// the interface face centered on the bar, and a hairline divider at
// its foot. Two windows are the shell's, `alpha` and `beta`, the bar
// and a body: the body in the input's paper with one line of ink, the
// count of keys the shell routed to this window because it was the
// focused one. The bar is also the drag's handle: a press on it takes
// the window along with the pointer until the release.
//
// The paint is direct — fills and glyphs through the `Surface`, no
// tree — because on the metal every node of a tree is a few KiB of
// boxed numbers left in the arena per repaint (A8.3's count), and the
// shell repaints two windows per focus change and one per key; this
// shape leaves the glyphs' share alone, a dozen per window. The hosted
// twin (`golden/`) paints the same windows through the same defs on
// the canvas and prints each frame's digest; `run.sh` asserts the
// metal's frame lines against that file and folds the display's
// screendump over each window's rectangle to the same numbers. One
// drawing, one size, one pair of names — read here by both.

def width() Int64 {
  return 384
}

def height() Int64 {
  return 128
}

def bar_height() Int64 {
  return 24
}

def title_a() String {
  return "alpha"
}

def title_b() String {
  return "beta"
}

// The bar's papers and inks: the light card when the window holds the
// focus, the dimmer one when it does not — a different byte in every
// channel, so a swapped focus shows.
def bar_paper(focused Bool) Int64 {
  if focused {
    return 0xFFF4F4F6
  }
  return 0xFFE6E6EA
}

def bar_divider(focused Bool) Int64 {
  if focused {
    return 0xFFD8D8DC
  }
  return 0xFFC8C8CC
}

def bar_ink(focused Bool) Int64 {
  if focused {
    return 0xFF282830
  }
  return 0xFF98989E
}

// The button's own rectangle (emo-desktop A16.1): the seat's hit test
// reads the same numbers the paint lays down — one place, four defs,
// the bar's left in the window's own coordinates.
def button_x() Int64 {
  return 8
}

def button_y() Int64 {
  return 6
}

def button_w() Int64 {
  return 12
}

def button_h() Int64 {
  return 12
}

// The button's color: the bar's own ink — dark when the window holds
// the focus, quiet gray when it does not, the title's own two states.
def button_color(focused Bool) Int64 {
  if focused {
    return 0xFF282830
  }
  return 0xFF98989E
}

// The shared title bar onto a surface's top strip: the paper, the one
// round button at the bar's left, the title centered on the bar's
// width in the interface face, the hairline at the foot.
def paint_bar(s ui_fb.Surface, f ui_fb.raster.Strike, title String,
              focused Bool) Void {
  s.fill(0, 0, s.width(), bar_height(), bar_paper(focused))
  s.rounded(button_x(), button_y(), button_w(), button_h(), button_w() / 2,
    button_color(focused), button_color(focused))
  ui_fb.text(f, title, (s.width() - ui_fb.text_width(f, title)) / 2,
    (bar_height() - f.line_height()) / 2, bar_ink(focused), s)
  s.fill(0, bar_height() - 1, s.width(), 1, bar_divider(focused))
}

// A window's frame onto its own surface, the whole buffer from scratch:
// the shared bar, the body's paper, and the keys line one pad in from
// the body's corner.
def paint(s ui_fb.Surface, f ui_fb.raster.Strike, title String, focused Bool,
          keys Int64) Void {
  const pad = 8
  paint_bar(s, f, title, focused)
  s.fill(0, bar_height(), s.width(), s.height() - bar_height(), 0xF8F8F0)
  ui_fb.text(f, "keys ${keys}", pad, bar_height() + pad, 0x282830, s)
}

// The chrome a content surface wears (emo-desktop A14.5): the app's
// view laid into the rectangle under the shared bar — every paint of
// the app's lands `bar_height()` lower on the real surface, the bar
// itself painted once at the mounting. The apps' sessions run their
// Elm loops through this: the loop sees a surface of the content's own
// size, the buffer carries the bar above the loop's frame. The state
// the apps' bars wear is the launch's: the machine focuses the new
// window's reader (the keys reach it before any click), and no wire
// yet tells it when the focus moves on — the dock's lit tile carries
// the same gap (A12.2).
class Chrome {
  def init(inner ui_fb.Surface, f ui_fb.raster.Strike, title String) {
    self.inner = inner
    self.title = title
    self.strike = f
    paint_bar(self.inner, f, title, true)
  }

  def width() Int64 {
    return self.inner.width()
  }

  def height() Int64 {
    return self.inner.height() - bar_height()
  }

  def at(x Int64, y Int64) Int64 {
    return self.inner.at(x, y + bar_height())
  }

  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    self.inner.fill(x, y + bar_height(), w, h, color)
  }

  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    self.inner.blend(x, y + bar_height(), w, h, color)
  }

  def ink(x Int64, y Int64, f ui_fb.raster.Strike, glyph Int64, color Int64) {
    self.inner.ink(x, y + bar_height(), f, glyph, color)
  }

  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    self.inner.rounded(x, y + bar_height(), w, h, radius, top, bottom)
  }

  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    self.inner.stroke(x, y + bar_height(), w, h, radius, width, color)
  }

  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    self.inner.shadow(x, y + bar_height(), w, h, radius, soft, color)
  }

  def present() {
    self.inner.present()
  }
}

// The constructor, as a def: a riscv64 program names no other module's
// class in value position (the emitter's type-reference rule), so a
// consumer takes the chrome from this — the window factory's own shape.
def chrome(inner ui_fb.Surface, f ui_fb.raster.Strike,
           title String) Chrome {
  return Chrome.new(inner: inner, f: f, title: title)
}
