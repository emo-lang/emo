require "syscall"
require "emo/ui_fb"

// The window buffer's metal side (emo-desktop A11.1): the package an
// application program requires to run as its own image — the raw shim
// between the fb core and a `win_new` buffer, the byte table in the
// merged stream's seat, and the few line helpers a session speaks
// through the console verb. The boot image carries its own copy of
// every def here (the shell and the desk pass predate the package);
// the apps' images are the package's consumers, and the corpus's
// digests are what keep the two from drifting — both print
// `frame <digest>` for the same paint, the number the hosted twin's
// file pins.
//
// A pixel is a 32-bit word at the identity the grant mapped — `poke32`
// the store, `peek32` the load, no verb and no copy between the core
// and the buffer's memory. The pixel loops live in the typed defs
// below the classes, not in their methods: on this target a method's
// body is the dynamic convention — every computed Int64 a boxed cell
// in the arena, and the value kinds carry no claims for the pool to
// reclaim — so a loop over a frame's pixels inside a method is the
// heap gone before the first row ends. A fully typed top-level def
// computes in raw registers and allocates nothing; the method hands it
// the words once per rectangle, which is a dozen times a frame, and
// once per glyph, which is a hundred.

// The session's scratch, in the image's own writable segment: the
// lines the helpers below build ride it through the write verb.
const buf = 0x87200000

// One byte into the scratch buffer; the cursor comes back.
def byte_at(pos Int64, b Int64) Int64 {
  poke8(buf + pos, b.to_byte())
  return pos + 1
}

// The decimal digits of n, poked at the cursor; the cursor comes back.
def num_at(n Int64, pos Int64) Int64 {
  var p = pos
  if n >= 10 {
    p = num_at(n / 10, p)
  }
  poke8(buf + p, (48 + (n % 10)).to_byte())
  return p + 1
}

// A line through the console service, from the scratch buffer. The
// one ride that cannot refuse is the mark: a '?' from this image's
// own writable segment, sent when a line the gate should have carried
// comes back refused — the loud wrongness of it is the point.
def mark() Void {
  poke8(buf, 63B)
  var r = syscall.write(buf, 1)
  case r {
    (R.error, _) -> {}
    (R.ok, _) -> {}
  }
}

def line(len Int64) Void {
  var r = syscall.write(buf, len)
  case r {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// The frame's digest line, `frame <n>`: the corpus's own line, the
// number the hosted twin prints for the same paint and the
// screendump's fold over the window's rectangle answers.
def frame_line(d Int64) Void {
  var p = byte_at(0, 102) // f
  p = byte_at(p, 114) // r
  p = byte_at(p, 97) // a
  p = byte_at(p, 109) // m
  p = byte_at(p, 101) // e
  p = byte_at(p, 32)
  p = num_at(d, p)
  p = byte_at(p, 10)
  line(p)
}

// The merged stream's event words, decoded in typed defs — a method's
// body is the dynamic convention on this target, so the class's `next`
// hands each event down whole (the shell's own discipline).
def ev_type(e Int64) Int64 {
  return (e >> 48) & 65535
}

def ev_code(e Int64) Int64 {
  return (e >> 32) & 65535
}

def ev_value(e Int64) Int64 {
  return e & 4294967295
}

// The keyboard's half in bytes (emo-desktop A11.2): the golden's hand
// is the monitor's sendkey, whose events ride the merged stream as the
// keyboard's device reports — the key's HID code, a press and a
// release — and the applications speak bytes. The stream stays raw
// (the input beat's own assertion reads a device report whole); the
// translation lives here, in the seat the apps share: the letters'
// codes are an irregular row (one literal, the pairs code-then-byte),
// the digits' a contiguous run, the enter the newline byte's own.
const key_pairs = [30, 97, 31, 115, 32, 100, 33, 102, 34, 103, 35, 104,
  36, 106, 37, 107, 38, 108, 44, 122, 45, 120, 46, 99, 47, 118, 48, 98,
  49, 110, 50, 109, 24, 111, 25, 112, 16, 113, 17, 119, 18, 101, 19,
  114, 20, 116, 21, 121, 22, 117, 23, 105]

def key_byte(code Int64) Int64 {
  var i = 0
  while i < 52 {
    if key_pairs[i] == code {
      return key_pairs[i + 1]
    }
    i = i + 2
  }
  if code >= 2 && code <= 10 {
    return 47 + code
  }
  if code == 11 {
    return 48
  }
  if code == 28 {
    return 10
  }
  return -1
}

// The byte table in the input's seat: one tag per byte, the tag its
// index in the table names — the table the app's own registration
// order keeps (`a` first, `b` second, and so on, the same tags the
// golden's script names) — and `q` the loop's end, the quit byte every
// seat's session ends on. Every other byte is dropped, never guessed
// at. The stream's device reports come too: the keyboard's press is
// the key it names (the translation above), the pointer's reports are
// not an app's and ride past.
class Keys {
  def init(bytes Array[Int64]) {
    self.bytes = bytes
  }

  def next() (R, Int64) {
    var tag = -1
    while tag < 0 {
      const ev = syscall.input_read()
      var b = -1
      if ev_type(ev) == 17741 {
        b = ev_value(ev)
      } else {
        if ev_type(ev) == 1 && ev_value(ev) == 1 {
          b = key_byte(ev_code(ev))
        }
      }
      if b == 113 {
        return (R.error, 0)
      }
      var i = 0
      while tag < 0 && b >= 0 && i < self.bytes.length() {
        if self.bytes[i] == b {
          tag = i
        }
        i = i + 1
      }
    }
    return (R.ok, tag)
  }
}

// The buffer's raw pixel lanes: the carve's own shapes over a smaller
// rectangle, the same typed loops the boot image's surface runs.
def carve_at(base Int64, width Int64, x Int64, y Int64) Int64 {
  return peek32(base + (y * width + x) * 4)
}

def carve_fill(base Int64, width Int64, x Int64, y Int64, w Int64,
               h Int64, word Int64) Void {
  var row = y
  while row < y + h {
    var col = x
    while col < x + w {
      poke32(base + (row * width + col) * 4, word)
      col = col + 1
    }
    row = row + 1
  }
}

def carve_blend(base Int64, width Int64, x Int64, y Int64, w Int64,
                h Int64, color Int64) Void {
  var row = y
  while row < y + h {
    var col = x
    while col < x + w {
      var i = base + (row * width + col) * 4
      poke32(i, ui_fb.over(color, peek32(i)))
      col = col + 1
    }
    row = row + 1
  }
}

// One glyph of a strike at the pen `(x, y)` (emo-desktop A14.2): the
// coverage walked a word at a time — `font.word` hands eight pixels,
// pixel p at bits 4p — each covered pixel inside the buffer composited
// in the color's channels, the same pixels at the same coverage the
// hosted canvas inks. The buffer's extent rides packed (`pack`).
def carve_ink(base Int64, dims Int64, x Int64, y Int64, strike Int64,
              glyph Int64, color Int64) Void {
  const width = high(dims)
  const height = low(dims)
  const w = ui_fb.font.gw(strike, glyph)
  const n = w * ui_fb.font.gh(strike, glyph)
  const x0 = x + ui_fb.font.gleft(strike, glyph)
  const y0 = y + ui_fb.font.gtop(strike, glyph)
  var m = 0
  var k = 0
  while m < n {
    const wd = ui_fb.font.word(strike, glyph, k)
    var p = 0
    while p < 8 && m < n {
      const c = ((wd >> (p * 4)) & 15) * 17
      const px = x0 + m % w
      const py = y0 + m / w
      if c > 0 && px >= 0 && px < width && py >= 0 && py < height {
        carve_blend_at(base + (py * width + px) * 4, ui_fb.inked(color, c))
      }
      m = m + 1
      p = p + 1
    }
    k = k + 1
  }
}

// The frame's digest off the buffer's own words — the fold
// `d = (d * 31 + word) mod 2^32` over every pixel in row-major order,
// in a typed loop over `peek32` rather than through the surface's
// `at`: a method call per pixel would box its answer into the arena
// hundreds of times. The hosted twin folds through the canvas; the
// screendump's Python folds the display's bytes; the three agree on
// one number or on none (run.sh).
def carve_digest(base Int64, width Int64, height Int64) Int64 {
  var d = 0
  var row = 0
  while row < height {
    var col = 0
    while col < width {
      d = (d * 31 + peek32(base + (row * width + col) * 4)) & 4294967295
      col = col + 1
    }
    row = row + 1
  }
  return d
}

// ---- the shapes on the carve (emo-desktop A14.1) ----
//
// The canvas's walks over raw words: each row walked in from both ends
// while its pixels are partly covered, the whole pixels between one
// span — the arithmetic per pixel `ui_fb`'s shapes section, so the
// carve and the hosted canvas cover every pixel alike. A shape is more
// words than a call carries (eight at most on this target), so the
// buffer's extent, the shape's corner and its extent ride two to a word
// (`pack`); the clip is the loops' own integers, never `ui_fb.clip`'s
// instance.

// Two coordinates in one word, the first above the second; a negative
// coordinate survives the trip.
def pack(a Int64, b Int64) Int64 {
  return a * 4294967296 + (b & 4294967295)
}

def high(p Int64) Int64 {
  return (p - (p & 4294967295)) / 4294967296
}

def low(p Int64) Int64 {
  const lo = p & 4294967295
  if lo >= 2147483648 {
    return lo - 4294967296
  }
  return lo
}

// The word at address `i` composited through `ui_fb.over` — nothing
// read or written when the color covers nothing.
def carve_blend_at(i Int64, color Int64) Void {
  if ((color >> 24) & 255) > 0 {
    poke32(i, ui_fb.over(color, peek32(i)))
  }
}

// Columns `from` to `to` of the row at address `line` in one color:
// stored when it is opaque, composited when it is not.
def carve_span(line Int64, from Int64, to Int64, color Int64) Void {
  var col = from
  if ((color >> 24) & 255) >= 255 {
    const word = color & 0xFFFFFF
    while col <= to {
      poke32(line + col * 4, word)
      col = col + 1
    }
  } else {
    while col <= to {
      carve_blend_at(line + col * 4, color)
      col = col + 1
    }
  }
}

// The first visible column or row of a span that starts at `at`.
def clip_from(at Int64) Int64 {
  if at < 0 {
    return 0
  }
  return at
}

// The column or row past a span's last visible one: its end, held to
// the buffer's `limit`.
def clip_to(end Int64, limit Int64) Int64 {
  if end > limit {
    return limit
  }
  return end
}

// A rounded rectangle graded from `top` to `bottom`, the canvas's
// `rounded` over the carve.
def carve_rounded(base Int64, dims Int64, xy Int64, wh Int64, radius Int64,
                  top Int64, bottom Int64) Void {
  const width = high(dims)
  const x = high(xy)
  const y = low(xy)
  const w = high(wh)
  const h = low(wh)
  const rad = ui_fb.radius_in(radius, w, h)
  const x1 = clip_to(x + w, width)
  const y1 = clip_to(y + h, low(dims))
  var row = clip_from(y)
  while row < y1 {
    const color = ui_fb.grade(top, bottom, row - y, h)
    const line = base + row * width * 4
    var k = clip_from(x)
    var j = x1 - 1
    if ((color >> 24) & 255) == 0 {
      k = j + 1
    }
    while k <= j {
      const c = ui_fb.fill_cover(ui_fb.shape_sd(k, row, x, y, w, h, rad))
      if c >= 255 {
        break
      }
      carve_blend_at(line + k * 4, ui_fb.cover(color, c))
      k = k + 1
    }
    while j >= k {
      const c = ui_fb.fill_cover(ui_fb.shape_sd(j, row, x, y, w, h, rad))
      if c >= 255 {
        break
      }
      carve_blend_at(line + j * 4, ui_fb.cover(color, c))
      j = j - 1
    }
    carve_span(line, k, j, color)
    row = row + 1
  }
}

// The ring `stroke` pixels deep inside a rounded rectangle's edge, the
// canvas's `stroke` over the carve.
def carve_stroke(base Int64, dims Int64, xy Int64, wh Int64, radius Int64,
                 stroke Int64, color Int64) Void {
  const width = high(dims)
  const x = high(xy)
  const y = low(xy)
  const w = high(wh)
  const h = low(wh)
  const rad = ui_fb.radius_in(radius, w, h)
  var x1 = clip_to(x + w, width)
  if stroke <= 0 {
    x1 = 0
  }
  const y1 = clip_to(y + h, low(dims))
  var row = clip_from(y)
  while row < y1 {
    const line = base + row * width * 4
    var k = clip_from(x)
    var j = x1 - 1
    while k <= j {
      const sd = ui_fb.shape_sd(k, row, x, y, w, h, rad)
      const c = ui_fb.stroke_cover(sd, stroke)
      if c == 0 && sd < 0 {
        break
      }
      carve_blend_at(line + k * 4, ui_fb.cover(color, c))
      k = k + 1
    }
    while j >= k {
      const sd = ui_fb.shape_sd(j, row, x, y, w, h, rad)
      const c = ui_fb.stroke_cover(sd, stroke)
      if c == 0 && sd < 0 {
        break
      }
      carve_blend_at(line + j * 4, ui_fb.cover(color, c))
      j = j - 1
    }
    row = row + 1
  }
}

// A rounded rectangle whose edge fades over `soft` pixels, the canvas's
// `shadow` over the carve.
def carve_shadow(base Int64, dims Int64, xy Int64, wh Int64, radius Int64,
                 soft Int64, color Int64) Void {
  const width = high(dims)
  const x = high(xy)
  const y = low(xy)
  const w = high(wh)
  const h = low(wh)
  const rad = ui_fb.radius_in(radius, w, h)
  const pad = ui_fb.shadow_pad(soft)
  var x1 = clip_to(x + w + pad, width)
  if w <= 0 || h <= 0 {
    x1 = 0
  }
  const y1 = clip_to(y + h + pad, low(dims))
  var row = clip_from(y - pad)
  while row < y1 {
    const line = base + row * width * 4
    var k = clip_from(x - pad)
    var j = x1 - 1
    while k <= j {
      const c = ui_fb.shadow_cover(ui_fb.shape_sd(k, row, x, y, w, h, rad),
        soft)
      if c >= 255 {
        break
      }
      carve_blend_at(line + k * 4, ui_fb.cover(color, c))
      k = k + 1
    }
    while j >= k {
      const c = ui_fb.shadow_cover(ui_fb.shape_sd(j, row, x, y, w, h, rad),
        soft)
      if c >= 255 {
        break
      }
      carve_blend_at(line + j * 4, ui_fb.cover(color, c))
      j = j - 1
    }
    carve_span(line, k, j, color)
    row = row + 1
  }
}

// A window's buffer as the fb core's `Surface`: the run `win_new`
// handed, mapped into this pass's own table at the identity of its
// physical addresses, and the grant the buffer is named by ever after.
// `present` is the window's commit: the frame's digest off the
// buffer's own words on the wire first (`frame <n>`, the corpus's
// line), then the grant's present — the gate checks the owner and the
// rect, the compositor composites the whole stack with this frame in
// it and flushes — and the compositor's own line is the answer's echo;
// the app says nothing after.
class Win {
  def init(grant Int64, base Int64, width Int64, height Int64) {
    self.grant = grant
    self.base = base
    self.width = width
    self.height = height
  }

  def width() Int64 {
    return self.width
  }

  def height() Int64 {
    return self.height
  }

  def at(x Int64, y Int64) Int64 {
    if x < 0 || x >= self.width || y < 0 || y >= self.height {
      return 0
    }
    return carve_at(self.base, self.width, x, y)
  }

  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_fill(self.base, self.width, r.x(), r.y(), r.w(), r.h(),
      color & 0xFFFFFF)
  }

  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_blend(self.base, self.width, r.x(), r.y(), r.w(), r.h(), color)
  }

  def ink(x Int64, y Int64, strike Int64, glyph Int64, color Int64) {
    carve_ink(self.base, pack(self.width, self.height), x, y, strike, glyph,
      color)
  }

  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    carve_rounded(self.base, pack(self.width, self.height), pack(x, y),
      pack(w, h), radius, top, bottom)
  }

  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    carve_stroke(self.base, pack(self.width, self.height), pack(x, y),
      pack(w, h), radius, width, color)
  }

  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    carve_shadow(self.base, pack(self.width, self.height), pack(x, y),
      pack(w, h), radius, soft, color)
  }

  def present() {
    frame_line(carve_digest(self.base, self.width, self.height))
    case syscall.present(self.grant, 0, 0, self.width, self.height) {
      (R.error, _) -> { mark() }
      (R.ok, _) -> {}
    }
  }
}

// The constructors, as defs: a riscv64 program names no other module's
// class in value position (the emitter's type-reference rule), so a
// consumer takes the surface and the seat from these two — the canvas
// factory's own shape.
def win(grant Int64, base Int64, width Int64, height Int64) Win {
  return Win.new(grant: grant, base: base, width: width, height: height)
}

def keys(bytes Array[Int64]) Keys {
  return Keys.new(bytes: bytes)
}
