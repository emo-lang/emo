  0x00000000, 0x00101000, 0x00001010, 0x20000000, // 0x3B ;
  0x00000000, 0x04081020, 0x10080400, 0x00000000, // 0x3C <
  0x00000000, 0x00007C00, 0x7C000000, 0x00000000, // 0x3D =
