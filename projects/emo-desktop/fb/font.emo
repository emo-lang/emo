  0x00001010, 0x10101010, 0x10101010, 0x10000000, // 0x7C |
  0x00003008, 0x08080608, 0x08080830, 0x00000000, // 0x7D }
  0x00000000, 0x0000324C, 0x00000000, 0x00000000, // 0x7E ~
  0x00007C44, 0x44444444, 0x4444447C, 0x00000000 // missing
]
// -- the end of the glyph table --

// The glyph every character outside the table renders as.
def missing() Int64 {
  return 95
}

// The glyph index of one character, handed as the one-byte String a
// label's walk cuts (`substring(i, 1)`): its position in the alphabet,
// or the missing glyph for a byte the font has no drawing of — a control
// character, or one byte of a multi-byte character, whose cells each show
// the hollow glyph on every target alike.
def glyph_of(c String) Int64 {
  const i = alphabet.index_of(c)
  if i < 0 {
    return missing()
  }
  return i
}

// The k-th word of a glyph, k in 0..3: rows 4k to 4k+3, the first in the
// high byte.
def word(index Int64, k Int64) Int64 {
  return rows[index * 4 + k]
}

// Rows 0 to 7 of a glyph as one word, row 0 in the top byte.
def top_rows(index Int64) Int64 {
  return (word(index, 0) << 32) | word(index, 1)
}

// Rows 8 to 15 of a glyph as one word, row 8 in the top byte.
def bottom_rows(index Int64) Int64 {
  return (word(index, 2) << 32) | word(index, 3)
}
