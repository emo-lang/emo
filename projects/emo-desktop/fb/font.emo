  0x00000000, 0x10543854, 0x10000000, 0x00000000, // 0x2A *
  0x00000000, 0x0010107C, 0x10100000, 0x00000000, // 0x2B +
  0x00000000, 0x00000000, 0x00001010, 0x20000000, // 0x2C ,
  0x00000000, 0x0000007C, 0x00000000, 0x00000000, // 0x2D -
  0x00000000, 0x00000000, 0x00001010, 0x00000000, // 0x2E .
  0x00000404, 0x08081010, 0x20204040, 0x00000000, // 0x2F /
  0x00003844, 0x444C5464, 0x44444438, 0x00000000, // 0x30 0
  0x00001030, 0x50101010, 0x1010107C, 0x00000000, // 0x31 1
  0x00003844, 0x04040810, 0x2040407C, 0x00000000, // 0x32 2
  0x00003844, 0x04043804, 0x04044438, 0x00000000, // 0x33 3
  0x00000818, 0x2848487C, 0x08080808, 0x00000000, // 0x34 4
  0x00007C40, 0x40407804, 0x04044438, 0x00000000, // 0x35 5
  0x00003844, 0x40407844, 0x44444438, 0x00000000, // 0x36 6
  0x00007C04, 0x04080810, 0x10202020, 0x00000000, // 0x37 7
  0x00003844, 0x44443844, 0x44444438, 0x00000000, // 0x38 8
  0x00003844, 0x44443C04, 0x04044438, 0x00000000, // 0x39 9
