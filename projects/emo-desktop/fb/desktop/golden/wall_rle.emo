def word(k Int64) Int64 {
  const at = k
  if at < 448 {
    return data0[at - 0]
  }
  if at < 896 {
    return data1[at - 448]
  }
  if at < 1344 {
    return data2[at - 896]
  }
  if at < 1792 {
    return data3[at - 1344]
  }
  if at < 2240 {
    return data4[at - 1792]
  }
  if at < 2688 {
    return data5[at - 2240]
  }
  if at < 3136 {
    return data6[at - 2688]
  }
  if at < 3584 {
    return data7[at - 3136]
  }
  if at < 4032 {
    return data8[at - 3584]
  }
  if at < 4480 {
    return data9[at - 4032]
  }
  return 0
}

// The display mode's art's runs whole, one array the walkers consume.
def runs() Array[Int64] {
  const holder = ArrayBuilder.new()
  var i = 0
  while i < words() {
    holder.push(word(i))
    i = i + 1
  }
  return holder.to_array()
}

def quarter_words() Int64 {
  return 751
}

