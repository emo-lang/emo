def quarter_word(k Int64) Int64 {
  const at = k
  if at < 448 {
    return quarter_data0[at - 0]
  }
  if at < 896 {
    return quarter_data1[at - 448]
  }
  return 0
}

// The quarter canvas's art's runs whole, one array the walkers consume.
def quarter_runs() Array[Int64] {
  const holder = ArrayBuilder.new()
  var i = 0
  while i < quarter_words() {
    holder.push(quarter_word(i))
    i = i + 1
  }
  return holder.to_array()
}
// The gray art (emo-desktop M31, A31.2): the failure's fixture —
// twenty-four rows of the mode's width, each one run of a plain
// gray, the channels' spread zero everywhere. The palette's walk
// refuses it, and the chrome's pins beside it wear the constants
// the failure keeps.
def gray_runs() Array[Int64] {
  const holder = ArrayBuilder.new()
  var row = 0
  while row < 24 {
    holder.push((((32 + row) * 65793) << 32) | 1920)
    row = row + 1
  }
  return holder.to_array()
}

// The formula the package retired (emo-desktop A13, A14.3): the
// gradient row by row, the three ribbons over it — the fixture's
// own copy, the anchors the package still holds (the chrome's
// material samples them until the palette feeds it), the bytes
// the volume's file renders.
def wallpaper_formula(s ui_fb.Surface, w Int64, h Int64) Void {
  const denom = h - 1
  const tr = (emo_desktop.wall_top() >> 16) & 0xFF
  const tg = (emo_desktop.wall_top() >> 8) & 0xFF
  const tb = emo_desktop.wall_top() & 0xFF
  const br = (emo_desktop.wall_bottom() >> 16) & 0xFF
  const bg = (emo_desktop.wall_bottom() >> 8) & 0xFF
  const bb = emo_desktop.wall_bottom() & 0xFF
  var y = 0
  while y < h {
    const r = (tr * (denom - y) + br * y) / denom
    const g = (tg * (denom - y) + bg * y) / denom
    const b = (tb * (denom - y) + bb * y) / denom
    s.fill(0, y, w, 1, (r << 16) | (g << 8) | b)
    y = y + 1
  }
  ribbon_f(s, h, (0 << 32) | ((5 * h) / 8), 3, 4, -((25 * w) / 128),
    (115 * w) / 256, (0x28 << 24) | 0x30B8C8)
  ribbon_f(s, h, (((5 * h) / 24) << 32) | ((15 * h) / 16), 1, 2, (15 * w) / 256,
    (25 * w) / 64, (0x20 << 24) | 0xE86890)
  ribbon_f(s, h, (((85 * h) / 192) << 32) | h, -1, 4, (225 * w) / 256,
    (135 * w) / 256, (0x18 << 24) | 0x8868E8)
}

// One translucent ribbon, the package's retired helper: the row's
// left edge a line, the width fixed, the ink a blend word.
def ribbon_f(s ui_fb.Surface, h Int64, span Int64, m Int64, d Int64,
             c Int64, width Int64, ink_color Int64) Void {
  var y = span >> 32
  if y < 0 {
    y = 0
  }
  var ye = span & 4294967295
  if ye > h {
    ye = h
  }
  while y < ye {
    const x = c + (m * y) / d
    s.blend(x, y, width, 1, ink_color)
    y = y + 1
  }
}
