require "emo/ui_fb"
require "emo/ui_fb_canvas"
require "emo/ui_fb_frame"
require "emo_desktop"
require "hash"

// The dock's hosted twin (emo-desktop A10.2, A12.1): the strip painted
// onto a canvas the dock buffer's own size (1920x40 — the metal's dock
// is a win buffer of that size, its digest the one the screendump's
// rect fold meets), the states the desktop lives in the order they
// arrive — no app focused, alpha's tile lit, beta's — then the
// residency's states the launcher adds: both tiles dark, the first
// running, both — and the press policy's probes beside: above the
// strip is no dock's business, a tile names its app. The interpreter's
// bytes are `expected.txt`, and every hosted target prints the same.
//
//   emo run main.emo


  const holder = ArrayBuilder.new()
  case ui_fb.raster.strike(ui_fb.raster.inter(), 16) {
    (R.error, why) then { println("the interface strike refused: ${why}") }
    (R.ok, s) then { holder.push(s) }
  }
  const f = holder.get(0)

def main() {
  const strip = ui_fb_canvas.canvas(1920, 40)
  // the desk era's three: no app focused, alpha's tile lit, beta's
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["a", "b"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["a", "b"], 0, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["a", "b"], 1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  // the desktop era's residency, the launcher's four tiles: the
  // launcher's own first (emo-desktop M28, A28.1 — the `s` tile the
  // panel's door, the app tiles one slot right, the residency's bits
  // shifted with them), the masks the era lives in its order — the
  // empty strip, the counter's tile, two, all three, then the quits'
  // way back down (the counter out, the browser out) and the session's
  // end, every dot out again
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 2)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 6)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 14)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 12)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 8)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, f, 1920, 40, 1040, ["s", "c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  println("tile ${emo_desktop.press(100, 200, 1920, 1080, 2)}")
  println("tile ${emo_desktop.press(24, 1060, 1920, 1080, 4)}")
  println("tile ${emo_desktop.press(64, 1060, 1920, 1080, 4)}")
  println("tile ${emo_desktop.press(110, 1060, 1920, 1080, 4)}")
  println("tile ${emo_desktop.press(150, 1060, 1920, 1080, 4)}")

  // The desktop's own canvas (emo-desktop A13): the wallpaper whole on
  // a quarter-mode canvas, twice (M31, A31.1) — the fixture's formula
  // first (the procedural art the package retired, living in the
  // golden's fixture now), then the same canvas from the volume's RLE
  // runs decoded (`wall_rle.runs()`, the tool's render walking the
  // surface run by run); the two digests one number is the tool's
  // fidelity, the bytes the metal's boot decode meets. Then the header
  // bar with two apps running and with none, the icons' four states on
  // a canvas two cells tall, a name drawn byte by byte the way the
  // shell draws the volume's, and beside them the square root's
  // probes, the layout's cell origins, and the hit test's verdicts.
  const wall = ui_fb_canvas.canvas(256, 192)
  wall_rle.wallpaper_formula(wall, 256, 192)
  println("wall ${ui_fb_frame.digest(wall)}")
  emo_desktop.wallpaper_decode(wall, 256, 192, wall_rle.runs())
  println("wall decoded ${ui_fb_frame.digest(wall)}")
  const bar = ui_fb_canvas.canvas(256, 24)
  // the clock's epochs (emo-desktop M26, A26.1): the bar reads the
  // seconds the caller hands it — 2026-03-29 09:05 UTC with two apps
  // running, 2026-07-31 23:41 with none — the digits' own pins. The
  // desks are the pager's word (emo-desktop M27, A27.2): the first two
  // bars the quiet word (desk 0 active, nothing occupied), then the
  // occupancy's ink (desk 1 live under desk 0's accent), the accent's
  // move (desk 2 active, desks 0 and 2 occupied — every cell states
  // its fact), and every desk live under desk 3's accent.
  emo_desktop.paint_header(bar, f, 256, 1920, 1080, 2, 1774775100, 0)
  println("bar ${ui_fb_frame.digest(bar)}")
  emo_desktop.paint_header(bar, f, 256, 1920, 1080, 0, 1785541260, 0)
  println("bar ${ui_fb_frame.digest(bar)}")
  emo_desktop.paint_header(bar, f, 256, 1920, 1080, 1, 1774775100, 256)
  println("bar ${ui_fb_frame.digest(bar)}")
  emo_desktop.paint_header(bar, f, 256, 1920, 1080, 1, 1774775100, 1282)
  println("bar ${ui_fb_frame.digest(bar)}")
  emo_desktop.paint_header(bar, f, 256, 1920, 1080, 2, 1785541260, 3843)
  println("bar ${ui_fb_frame.digest(bar)}")
  // the pager's own probes: the cells' origins pinned, a press in each
  // cell names its desk, the gaps and the world outside the bar name
  // none
  var pi = 0
  while pi < emo_desktop.pager_count() {
    const pc = emo_desktop.pager_cell(f, pi)
    println("pager ${pc >> 32} ${pc & 4294967295}")
    pi = pi + 1
  }
  const c0 = emo_desktop.pager_cell(f, 0)
  const c3 = emo_desktop.pager_cell(f, 3)
  const mid = emo_desktop.pager_size() / 2
  println("pager ${emo_desktop.pager_hit(f, (c0 >> 32) + mid, 11)}")
  println("pager ${emo_desktop.pager_hit(f, (c3 >> 32) + mid, 11)}")
  println("pager ${emo_desktop.pager_hit(f, (c0 >> 32) + emo_desktop.pager_size() + 3, 11)}")
  println("pager ${emo_desktop.pager_hit(f, (c0 >> 32) + mid, 30)}")
  println("pager ${emo_desktop.pager_hit(f, 40, 11)}")
  // the calendar panel's five: a Sunday-start month whose today is
  // the 29th, a 31-day month whose today is the 31st at 23:41, a
  // month opening on a Thursday with the day's clock 00:07, the leap
  // day 2028-02-29 06:30, and the year's boundary 2027-01-01 00:00 —
  // the grid's first row, the last cell, the single digits, the 29th
  // of a short month and the year's turn each pinned. A canvas a
  // state: the ground's alpha blends over whatever the canvas holds.
  const cal1 = ui_fb_canvas.canvas(emo_desktop.cal_w(), emo_desktop.cal_h())
  emo_desktop.paint_calendar(cal1, f, 1774775100)
  println("cal ${ui_fb_frame.digest(cal1)}")
  const cal2 = ui_fb_canvas.canvas(emo_desktop.cal_w(), emo_desktop.cal_h())
  emo_desktop.paint_calendar(cal2, f, 1785541260)
  println("cal ${ui_fb_frame.digest(cal2)}")
  const cal3 = ui_fb_canvas.canvas(emo_desktop.cal_w(), emo_desktop.cal_h())
  emo_desktop.paint_calendar(cal3, f, 1767226020)
  println("cal ${ui_fb_frame.digest(cal3)}")
  const cal4 = ui_fb_canvas.canvas(emo_desktop.cal_w(), emo_desktop.cal_h())
  emo_desktop.paint_calendar(cal4, f, 1835418600)
  println("cal ${ui_fb_frame.digest(cal4)}")
  const cal5 = ui_fb_canvas.canvas(emo_desktop.cal_w(), emo_desktop.cal_h())
  emo_desktop.paint_calendar(cal5, f, 1798761600)
  println("cal ${ui_fb_frame.digest(cal5)}")
  const icons = ui_fb_canvas.canvas(384, 256)
  emo_desktop.paint_icon_doc(icons, 280, 32, false)
  emo_desktop.paint_icon_folder(icons, 280, 108, false)
  emo_desktop.paint_icon_doc(icons, 184, 32, true)
  emo_desktop.paint_icon_folder(icons, 184, 108, true)
  println("icon ${ui_fb_frame.digest(icons)}")
  // the name's bytes: `boot.txt` under the first cell — the byte walk
  // the shell reads the volume's names through, each byte's pen moved
  // on by the last one's advance — then one byte the font has no
  // drawing of for the missing glyph
  const name = [98, 111, 111, 116, 46, 116, 120, 116] // boot.txt
  var k = 0
  var pen = 288
  while k < name.length() {
    pen = pen + emo_desktop.text_byte(icons, f, pen, 90, name[k], 0xF8F8F0)
    k = k + 1
  }
  emo_desktop.text_byte(icons, f, pen, 90, 7, 0xF8F8F0)
  println("icon ${ui_fb_frame.digest(icons)}")
  println("isqrt ${emo_desktop.isqrt(0)}")
  println("isqrt ${emo_desktop.isqrt(1)}")
  println("isqrt ${emo_desktop.isqrt(15)}")
  println("isqrt ${emo_desktop.isqrt(16)}")
  println("isqrt ${emo_desktop.isqrt(9801)}")
  println("cell ${emo_desktop.icon_cell(0, 1920, 1080)}")
  println("cell ${emo_desktop.icon_cell(8, 1920, 1080)}")
  println("cell ${emo_desktop.icon_cell(9, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1850, 40, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1750, 107, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1816, 108, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(100, 400, 2, 1920, 1080)}")
  // The launcher (emo-desktop M28, A28.1): the slab at its own size —
  // the catalog whole with the bare line, the narrowed face with its
  // one survivor selected, the blank face a line nothing matches — a
  // canvas a state, the ground's alpha blending over whatever the
  // canvas holds. The filter's verdicts and the hit test's beside, the
  // geometry's pins with them: the panel centered above the dock, the
  // search line no row's, a press past the survivors' count no row
  // either.
  const apps = ["counter.elf", "files.elf", "editor.elf", "spin.elf"]
  // The face's bytes composited over the wallpaper's own (emo-desktop
  // M30, A30.1): the buffer the paint's straight-alpha truth, the
  // wallpaper the ground the metal's carve holds, the compose the
  // package's source-over per pixel — the digest the display's bytes,
  // the round fold beside it (the walk's mask leaves the corners the
  // wallpaper's own). Four states: the catalog whole with the bare
  // line, the narrowed face with its one survivor selected, the blank
  // face a line nothing matches, the narrowed-again face with three
  // survivors and the third selected.
  const lw = emo_desktop.launch_w(1920)
  const lh = emo_desktop.launch_h()
  // the wallpaper's replica at the display's own size (emo-desktop
  // M30, A30.1): the formula is position-dependent on the full mode —
  // the panel's pixels sample the display's coordinates (M31, A31.1:
  // the fixture's formula now — the package's live path is the decode)
  const lwall = ui_fb_canvas.canvas(1920, 1080)
  wall_rle.wallpaper_formula(lwall, 1920, 1080)
  const l1 = ui_fb_canvas.canvas(lw, lh)
  const l2 = ui_fb_canvas.canvas(lw, lh)
  const l3 = ui_fb_canvas.canvas(lw, lh)
  const l4 = ui_fb_canvas.canvas(lw, lh)
  // the slabs' straight words stored whole (emo-desktop M30, A30.1):
  // the def's words the alpha truth, the store never touching them
  var words = emo_desktop.rounded_straight(lw, lh,
    emo_desktop.launch_ground_top(), emo_desktop.launch_ground_bottom())
  var wi = 0
  while wi < words.length() {
    l1.store(wi % lw, wi / lw, words[wi])
    l2.store(wi % lw, wi / lw, words[wi])
    l3.store(wi % lw, wi / lw, words[wi])
    l4.store(wi % lw, wi / lw, words[wi])
    wi = wi + 1
  }
  emo_desktop.paint_launcher(l1, f, "", apps, 4, -1)
  emo_desktop.paint_launcher(l2, f, "ed", ["editor.elf"], 1, 0)
  emo_desktop.paint_launcher(l3, f, "zz", apps, 0, -1)
  emo_desktop.paint_launcher(l4, f, "e", apps, 3, 2)
  const lout = ui_fb_canvas.canvas(lw, lh)
  var lstate = 0
  while lstate < 4 {
    var buf = l1
    if lstate == 1 {
      buf = l2
    }
    if lstate == 2 {
      buf = l3
    }
    if lstate == 3 {
      buf = l4
    }
    const lwallx = emo_desktop.launch_x(1920)
    const lwally = emo_desktop.launch_y(1080)
    var ly = 0
    while ly < lh {
      var lx = 0
      while lx < lw {
        lout.fill(lx, ly, 1, 1, ui_fb.over_word(buf.at(lx, ly),
          lwall.at(lwallx + lx, lwally + ly)))
        lx = lx + 1
      }
      ly = ly + 1
    }
    println("launch ${ui_fb_frame.digest(lout)}")
    println("launchr ${ui_fb_frame.round_digest(lout, 10)}")
    lstate = lstate + 1
  }
  println("lgeom ${emo_desktop.launch_x(1920)} ${emo_desktop.launch_y(1080)} ${emo_desktop.launch_h()}")
  println("app ${emo_desktop.is_app_name("counter.elf")}")
  println("app ${emo_desktop.is_app_name("boot.txt")}")
  println("app ${emo_desktop.is_app_name(".elf")}")
  println("app ${emo_desktop.is_app_name("elf")}")
  println("match ${emo_desktop.line_matches("ed", "editor.elf")}")
  println("match ${emo_desktop.line_matches("ounter", "counter.elf")}")
  println("match ${emo_desktop.line_matches("zz", "files.elf")}")
  println("match ${emo_desktop.line_matches("", "spin.elf")}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 960, 836, 4)}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 960, 908, 4)}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 960, 792, 4)}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 960, 1028, 4)}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 600, 836, 4)}")
  println("lhit ${emo_desktop.launch_hit(1920, 1080, 960, 900, 1)}")
  // The lock (emo-desktop M28, A28.2): the account file's own
  // arithmetic — the digest the file carries is the hash package's,
  // 32 raw bytes — and the compare's verdicts pinned beside: the same bytes
  // match, the differing bytes do not. The face on its own canvas: the
  // wallpaper's whole place under the heavy scrim, the wordmark
  // centered, the blind caret under it — no echo's bytes anywhere.
  const secret = hash.sha2.sha256("noctalia".to_bytes())
  println("sha ${hash.hex_encode(secret)}")
  println("sha ${secret.length()}")
  println("cmp ${hash.constant_time_compare(secret, secret)}")
  println("cmp ${hash.constant_time_compare(secret,
    hash.sha2.sha256("noctaliA".to_bytes()))}")
  const lock = ui_fb_canvas.canvas(480, 270)
  emo_desktop.paint_lock(lock, f)
  println("lock ${ui_fb_frame.digest(lock)}")
}

main()
