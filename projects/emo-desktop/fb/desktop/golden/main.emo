require "emo/ui_fb"
require "emo/ui_fb_canvas"
require "emo/ui_fb_frame"
require "emo_desktop"

// The dock's hosted twin (emo-desktop A10.2, A12.1): the strip painted
// onto a canvas the dock buffer's own size (1024x40 — the metal's dock
// is a win buffer of that size, its digest the one the screendump's
// rect fold meets), the states the desktop lives in the order they
// arrive — no app focused, alpha's tile lit, beta's — then the
// residency's states the launcher adds: both tiles dark, the first
// running, both — and the press policy's probes beside: above the
// strip is no dock's business, a tile names its app. The interpreter's
// bytes are `expected.txt`, and every hosted target prints the same.
//
//   emo run main.emo

def main() {
  const strip = ui_fb_canvas.canvas(1024, 40)
  // the desk era's three: no app focused, alpha's tile lit, beta's
  emo_desktop.paint(strip, 1024, 40, ["a", "b"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["a", "b"], 0, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["a", "b"], 1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  // the desktop era's residency, the launcher's own three tiles: the
  // masks the era lives in its order — the empty strip, the counter's
  // tile, two, all three, then the quits' way back down (the counter
  // out, the browser out) and the session's end, every dot out again
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 1)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 3)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 7)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 6)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 4)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1024, 40, ["c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  println("tile ${emo_desktop.press(100, 200, 1024, 768, 2)}")
  println("tile ${emo_desktop.press(16, 750, 1024, 768, 3)}")
  println("tile ${emo_desktop.press(64, 750, 1024, 768, 3)}")
  println("tile ${emo_desktop.press(96, 750, 1024, 768, 3)}")
}

main()
