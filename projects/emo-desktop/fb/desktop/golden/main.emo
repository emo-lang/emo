require "emo/ui_fb"
require "emo/ui_fb_canvas"
require "emo/ui_fb_frame"
require "emo_desktop"

// The dock's hosted twin (emo-desktop A10.2, A12.1): the strip painted
// onto a canvas the dock buffer's own size (1920x40 — the metal's dock
// is a win buffer of that size, its digest the one the screendump's
// rect fold meets), the states the desktop lives in the order they
// arrive — no app focused, alpha's tile lit, beta's — then the
// residency's states the launcher adds: both tiles dark, the first
// running, both — and the press policy's probes beside: above the
// strip is no dock's business, a tile names its app. The interpreter's
// bytes are `expected.txt`, and every hosted target prints the same.
//
//   emo run main.emo

def main() {
  const strip = ui_fb_canvas.canvas(1920, 40)
  // the desk era's three: no app focused, alpha's tile lit, beta's
  emo_desktop.paint(strip, 1920, 40, 1040, ["a", "b"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["a", "b"], 0, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["a", "b"], 1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  // the desktop era's residency, the launcher's own three tiles: the
  // masks the era lives in its order — the empty strip, the counter's
  // tile, two, all three, then the quits' way back down (the counter
  // out, the browser out) and the session's end, every dot out again
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 1)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 3)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 7)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 6)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 4)
  println("frame ${ui_fb_frame.digest(strip)}")
  emo_desktop.paint(strip, 1920, 40, 1040, ["c", "f", "e"], -1, 0)
  println("frame ${ui_fb_frame.digest(strip)}")
  println("tile ${emo_desktop.press(100, 200, 1920, 1080, 2)}")
  println("tile ${emo_desktop.press(24, 1060, 1920, 1080, 3)}")
  println("tile ${emo_desktop.press(64, 1060, 1920, 1080, 3)}")
  println("tile ${emo_desktop.press(110, 1060, 1920, 1080, 3)}")

  // The desktop's own canvas (emo-desktop A13): the wallpaper whole on
  // a quarter-mode canvas — the gradient's rows, the three ribbons —
  // then the header bar with two apps running and with none, the
  // icons' four states on a canvas two cells tall, a name drawn byte
  // by byte the way the shell draws the volume's, and beside them the
  // square root's probes, the layout's cell origins, and the hit
  // test's verdicts.
  const wall = ui_fb_canvas.canvas(256, 192)
  emo_desktop.wallpaper(wall, 256, 192)
  println("wall ${ui_fb_frame.digest(wall)}")
  const bar = ui_fb_canvas.canvas(256, 24)
  emo_desktop.paint_header(bar, 256, 1920, 1080, 2)
  println("bar ${ui_fb_frame.digest(bar)}")
  emo_desktop.paint_header(bar, 256, 1920, 1080, 0)
  println("bar ${ui_fb_frame.digest(bar)}")
  const icons = ui_fb_canvas.canvas(384, 256)
  emo_desktop.paint_icon_doc(icons, 280, 32, false)
  emo_desktop.paint_icon_folder(icons, 280, 108, false)
  emo_desktop.paint_icon_doc(icons, 184, 32, true)
  emo_desktop.paint_icon_folder(icons, 184, 108, true)
  println("icon ${ui_fb_frame.digest(icons)}")
  // the name's bytes: `boot.txt` under the first cell — the byte walk
  // the shell reads the volume's names through, each byte's pen moved
  // on by the last one's advance — then one byte the font has no
  // drawing of for the missing glyph
  const name = [98, 111, 111, 116, 46, 116, 120, 116] // boot.txt
  var k = 0
  var pen = 288
  while k < name.length() {
    pen = pen + emo_desktop.text_byte(icons, pen, 90, name[k], 0xF8F8F0)
    k = k + 1
  }
  emo_desktop.text_byte(icons, pen, 90, 7, 0xF8F8F0)
  println("icon ${ui_fb_frame.digest(icons)}")
  println("isqrt ${emo_desktop.isqrt(0)}")
  println("isqrt ${emo_desktop.isqrt(1)}")
  println("isqrt ${emo_desktop.isqrt(15)}")
  println("isqrt ${emo_desktop.isqrt(16)}")
  println("isqrt ${emo_desktop.isqrt(9801)}")
  println("cell ${emo_desktop.icon_cell(0, 1920, 1080)}")
  println("cell ${emo_desktop.icon_cell(8, 1920, 1080)}")
  println("cell ${emo_desktop.icon_cell(9, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1850, 40, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1750, 107, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(1816, 108, 2, 1920, 1080)}")
  println("hit ${emo_desktop.icon_hit(100, 400, 2, 1920, 1080)}")
}

main()
