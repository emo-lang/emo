require "emo/ui_fb"

// The desktop shell's dock (emo-desktop A10.2; the shelf A14.4): the
// machine's desktop chrome, painted direct — fills and glyphs through
// the `Surface`, no tree, the window package's shape and reason (the
// shell repaints the dock per focus change, and every node of a tree
// is a few KiB of boxed numbers left in the arena per repaint on the
// metal). The dock is a panel surface at the display's bottom edge —
// the walk's topmost strip, no window over it (T8.15) — a rounded
// shelf floating on the wallpaper's own formula under a scrim (D8:
// the chrome samples the wallpaper, it does not read the pixels
// behind it), one drawn icon per app the shell runs, the focused
// app's tile in the lit grade, the one visible fact a focus changes.
// A press names the tile it landed on, or none: the policy the
// shell's pointer handler asks before its window hit test, the click
// it answers with the app's own focus.
//
// The tiles sit left to right, one per app in the shell's own order;
// a tile is a rounded square graded top to bottom carrying the app's
// initial in the labels' type. The strip's ground is the wallpaper's
// formula under the dock's scrim — chrome under everything's chrome.

def strip_height() Int64 {
  return 40
}

def tile_size() Int64 {
  return 32
}

def tile_gap() Int64 {
  return 8
}

def tile_margin() Int64 {
  return 20
}

def ink() Int64 {
  return 0xF8F8F0
}

// A tile's grades: the lit steel a focused window's bar wears when
// the tile is the focused app's, a quiet slate when it is not — a
// different byte in every channel, so a swapped focus shows.
def tile_top(focused Bool) Int64 {
  if focused {
    return 0xFF7090B8
  }
  return 0xFF50586A
}

def tile_bottom(focused Bool) Int64 {
  if focused {
    return 0xFF4A6288
  }
  return 0xFF3A4150
}

// The tile index at a display position, or -1: outside the strip is
// no dock's business, and a gap between tiles names no app. `count`
// is the shell's app count, `w` and `h` the display's mode.
def press(x Int64, y Int64, w Int64, h Int64, count Int64) Int64 {
  if y < h - strip_height() {
    return -1
  }
  var i = 0
  while i < count {
    const tx = tile_margin() + (i * (tile_size() + tile_gap()))
    if x >= tx && x < tx + tile_size() {
      return i
    }
    i = i + 1
  }
  return -1
}

// A tile's left edge in the display's own coordinates — the shell's
// to map a tile back to its window, and the model's to name the rect
// a screendump folds.
def tile_x(i Int64) Int64 {
  return tile_margin() + (i * (tile_size() + tile_gap()))
}

// ---- the shelf (emo-desktop A14.4) ----
//
// The dock's rounded shelf floating on the material: the wallpaper's
// own formula under the dock's scrim fills the strip the shelf floats
// on, the shelf's shadow falls on that, the shelf — a translucent
// slab, glass over the wallpaper's own colors — over its shadow, and
// the tiles on the shelf. The shelf sits `shelf_pad` in from the
// strip's sides and top, the tiles a pad inside it.

def shelf_pad() Int64 {
  return 6
}

def shelf_top_pad() Int64 {
  return 3
}

def shelf_radius() Int64 {
  return 12
}

def shelf_soft() Int64 {
  return 8
}

def shelf_height() Int64 {
  return strip_height() - shelf_top_pad() - 3
}

def shelf_top() Int64 {
  return 0x66484C5C
}

def shelf_bottom() Int64 {
  return 0x4C34363E
}

// A tile's top edge in the strip's own coordinates: a pad inside the
// shelf, the icon's box in the strip's middle.
def tile_y() Int64 {
  return 4
}

// The chrome's scrims (D8): the wallpaper's formula sampled under
// each panel's scrim — the header's the darker slate, the dock's the
// strip's own — the alpha in the top byte, the chrome's one material.
def header_scrim() Int64 {
  return 0xB41E1E26
}

def dock_scrim() Int64 {
  return 0xB424242C
}

// One row of the chrome's material at the display row `gy`, painted
// at the surface's local `ly`: the wallpaper's gradient row, every
// ribbon whose span holds the row over it, the scrim over the whole —
// D8's formula, the wallpaper recomputed at nothing a pixel reads.
// `mw` and `mh` are the display's mode (the ribbons are fractions of
// it), `w` the surface's own width — the header's golden canvas is
// narrower than the mode and samples the same formula.
def material_row(s ui_fb.Surface, ly Int64, gy Int64, w Int64, mw Int64,
                 mh Int64, scrim Int64) Void {
  const denom = mh - 1
  const tr = (wall_top() >> 16) & 255
  const tg = (wall_top() >> 8) & 255
  const tb = wall_top() & 255
  const br = (wall_bottom() >> 16) & 255
  const bg = (wall_bottom() >> 8) & 255
  const bb = wall_bottom() & 255
  const r = (tr * (denom - gy) + br * gy) / denom
  const g = (tg * (denom - gy) + bg * gy) / denom
  const b = (tb * (denom - gy) + bb * gy) / denom
  s.fill(0, ly, w, 1, (r << 16) | (g << 8) | b)
  if gy < (5 * mh) / 8 {
    s.blend(-((25 * mw) / 128) + (3 * gy) / 4, ly, (115 * mw) / 256, 1,
      (0x28 << 24) | 0x30B8C8)
  }
  if gy >= (5 * mh) / 24 && gy < (15 * mh) / 16 {
    s.blend((15 * mw) / 256 + gy / 2, ly, (25 * mw) / 64, 1,
      (0x20 << 24) | 0xE86890)
  }
  if gy >= (85 * mh) / 192 {
    s.blend((225 * mw) / 256 - gy / 4, ly, (135 * mw) / 256, 1,
      (0x18 << 24) | 0x8868E8)
  }
  s.blend(0, ly, w, 1, scrim)
}

// The strip onto its own surface, whole from scratch: the material
// row by row, the shelf's shadow and the shelf over it, then one
// drawn icon per app — a rounded square graded top to bottom, the
// initial centered in it. `labels` are the apps' initials in tile
// order, `focused` the lit tile's index or -1 when no app holds the
// focus, and `running` the residency's bitmask — bit i set when the
// i-th app has a live process — the launcher's one visible fact
// (emo-desktop A12.1): a running app's tile wears the 4×4 ink dot at
// its foot, centered, two pixels above the tile's bottom edge, the
// mark a macOS dock keeps under a running application's icon. `h` is
// the strip's own height and `top` the display row its first row
// stands on — the material samples the wallpaper's formula at the
// display's own rows.
def paint(s ui_fb.Surface, f ui_fb.raster.Strike, w Int64, h Int64,
          top Int64, labels Array[String], focused Int64,
          running Int64) Void {
  var ly = 0
  while ly < h {
    material_row(s, ly, top + ly, w, w, top + h, dock_scrim())
    ly = ly + 1
  }
  const sx = shelf_pad()
  const sy = shelf_top_pad()
  const sw = w - shelf_pad() * 2
  const sh = shelf_height()
  s.shadow(sx, sy, sw, sh, shelf_radius(), shelf_soft(), 0x80000000)
  s.rounded(sx, sy, sw, sh, shelf_radius(), shelf_top(), shelf_bottom())
  var i = 0
  while i < labels.length() {
    const tx = tile_x(i)
    const ty = tile_y()
    s.rounded(tx, ty, tile_size(), tile_size(), 8, tile_top(i == focused),
      tile_bottom(i == focused))
    ui_fb.text(f, labels[i],
      tx + (tile_size() - ui_fb.text_width(f, labels[i])) / 2,
      ty + (tile_size() - f.line_height()) / 2, ink(), s)
    if (running >> i) & 1 == 1 {
      s.fill(tx + 14, ty + 26, 4, 4, ink())
    }
    i = i + 1
  }
}

// ---- the desktop's own canvas (emo-desktop A13) ----
//
// The macOS-like desktop's three surfaces: the wallpaper (role 4, the
// walk's undermost layer), the header bar (a panel at the top edge),
// and the icons the desktop shows for the volume's files — folders by
// the name's prefix, documents for the rest, a selection highlight the
// press moves. Painted direct like the dock, for the reason the dock
// is: a tree's boxed numbers per repaint are the arena's to carry, and
// a wallpaper repaint is the desktop's most common frame. Every number
// here is integer and fixed, so the screendump's bytes are the
// formula's and the hosted golden's digest is the metal's.

// The header bar's height — the panel strip at the display's top edge.
def header_height() Int64 {
  return 24
}

// The icon grid's metrics: cells run from the display's top-right
// corner downward and the columns leftward, the way macOS lays a
// desktop's icons; the top edge sits under the header, the bottom edge
// above the dock. A cell is the icon's box plus the name's line under
// it, padded — the press's hit area is the cell, the pen's is the box.
def icon_cell_w() Int64 {
  return 96
}

def icon_cell_h() Int64 {
  return 76
}

def icon_size() Int64 {
  return 44
}

def icon_margin() Int64 {
  return 8
}

def icon_top() Int64 {
  return 32
}

def icon_bottom() Int64 {
  return 48
}

// One integer square root, Newton's, rounded down — the ribbon
// geometry's helper and nothing else's customer today. All positive:
// the caller's shapes are radii squared.
def isqrt(n Int64) Int64 {
  if n <= 0 {
    return 0
  }
  var x = n
  var y = (x + 1) / 2
  while y < x {
    x = y
    y = (x + n / x) / 2
  }
  return x
}

// One byte's glyph at the pen (x, y) in the labels' type (A14.2): the
// index is the byte's position past space, the missing glyph for a byte
// the font has no drawing of, the same rule the String walk's
// (`font.glyph_of`). The desktop's names come from the volume as bytes
// through the fs, and a String is never built of them: the shell reads
// the scratch buffer's bytes straight into this. The advance the next
// byte's pen moves by comes back.
def text_byte(s ui_fb.Surface, f ui_fb.raster.Strike, x Int64, y Int64,
              b Int64, ink_color Int64) Int64 {
  var i = b - 31
  if i < 1 || i > 95 {
    i = 0
  }
  s.ink(x, y, f, i, ink_color)
  return f.advance(i)
}

// The wallpaper's colors: a deep navy at the top running into a dusky
// violet at the bottom, the gradient the composition sits under
// everything.
def wall_top() Int64 {
  return 0x101C3C
}

def wall_bottom() Int64 {
  return 0x40306A
}

// One translucent ribbon: a diagonal band, one blended row at a time —
// the row's left edge a line `(m·y)/d + c`, the width fixed, the ink a
// blend word, the coverage in its top byte the surface's own rule.
// `span` packs the band's rows, `y0` above `y1` — the riscv64 call
// takes eight arguments, and the ribbon's shape fits in them. `d` is
// never zero (the caller's slopes are honest fractions).
def ribbon(s ui_fb.Surface, h Int64, span Int64, m Int64, d Int64, c Int64, width Int64, ink_color Int64) Void {
  var y = span >> 32
  if y < 0 {
    y = 0
  }
  var ye = span & 4294967295
  if ye > h {
    ye = h
  }
  while y < ye {
    const x = c + (m * y) / d
    s.blend(x, y, width, 1, ink_color)
    y = y + 1
  }
}

// The wallpaper whole: the gradient row by row (each channel a
// positive-weight lerp between the two anchors, so the division is the
// positive kind every target rounds the same), then the three ribbons
// over it — teal from the upper left, rose through the middle, violet
// from the lower right, macOS's abstract poster in the surface's own
// primitives. One call per boot: the shell paints the icons over this
// before the wallpaper's first present.
def wallpaper(s ui_fb.Surface, w Int64, h Int64) Void {
  const denom = h - 1
  const tr = (wall_top() >> 16) & 0xFF
  const tg = (wall_top() >> 8) & 0xFF
  const tb = wall_top() & 0xFF
  const br = (wall_bottom() >> 16) & 0xFF
  const bg = (wall_bottom() >> 8) & 0xFF
  const bb = wall_bottom() & 0xFF
  var y = 0
  while y < h {
    const r = (tr * (denom - y) + br * y) / denom
    const g = (tg * (denom - y) + bg * y) / denom
    const b = (tb * (denom - y) + bb * y) / denom
    s.fill(0, y, w, 1, (r << 16) | (g << 8) | b)
    y = y + 1
  }
  // The ribbons' bands, offsets and widths derive from the mode (A14.3
  // — fractions of w and h whose 256ths and 128ths reproduce the 1024x768
  // drawing they were tuned at exactly); the slopes stay the art's own.
  ribbon(s, h, (0 << 32) | ((5 * h) / 8), 3, 4, -((25 * w) / 128),
    (115 * w) / 256, (0x28 << 24) | 0x30B8C8)
  ribbon(s, h, (((5 * h) / 24) << 32) | ((15 * h) / 16), 1, 2, (15 * w) / 256,
    (25 * w) / 64, (0x20 << 24) | 0xE86890)
  ribbon(s, h, (((85 * h) / 192) << 32) | h, -1, 4, (225 * w) / 256,
    (135 * w) / 256, (0x18 << 24) | 0x8868E8)
}

// The header bar's inks: the wordmark in the boot banner's cyan, the
// count in the quiet ink — the bar's ground is the wallpaper's own
// formula under the header's scrim (`material_row`, D8).
def header_ink() Int64 {
  return 0xC8C8D0
}

def header_accent() Int64 {
  return 0x40C8C8
}

// `<n> apps` ending one pad short of `right`, drawn byte by byte — the
// count is a number the shell keeps, not a String the image carries.
// The digits' advances are summed before they are drawn, so the text
// ends where it should whatever the digits are. The x the text starts
// at comes back, the caller's to center against.
def count_text(s ui_fb.Surface, f ui_fb.raster.Strike, right Int64,
               y Int64, n Int64, ink_color Int64) Int64 {
  var div = 1
  while n / div >= 10 {
    div = div * 10
  }
  var digits_w = 0
  var d = div
  while d > 0 {
    digits_w = digits_w + f.advance(17 + ((n / d) % 10))
    d = d / 10
  }
  const x = right - digits_w - ui_fb.text_width(f, " apps")
  var p = x
  while div > 0 {
    p = p + text_byte(s, f, p, y, 48 + ((n / div) % 10), ink_color)
    div = div / 10
  }
  ui_fb.text(f, " apps", p, y, ink_color, s)
  return x
}

// The header bar onto its own surface, whole from scratch: the
// wallpaper's formula under the header's scrim, row by row — the bar
// samples the display's own rows, `mw` and `mh` the mode — then the
// wordmark one pad in, the running count at the right edge — the one
// live fact the bar carries (the desktop knows its own children's
// residency; the wall clock and the foreground app's name it does not
// know, and the bar does not pretend to). The text sits centered in
// the bar's height, the line box's own.
def paint_header(s ui_fb.Surface, f ui_fb.raster.Strike, w Int64,
                 mw Int64, mh Int64, running Int64) Void {
  var y = 0
  while y < header_height() {
    material_row(s, y, y, w, mw, mh, header_scrim())
    y = y + 1
  }
  const ty = (header_height() - f.line_height()) / 2
  ui_fb.text(f, "EmoOS", 8, ty, header_accent(), s)
  count_text(s, f, w - icon_margin(), ty, running, header_ink())
}

// The selection's blend word: the tile steel at a low coverage laid
// over the wallpaper behind an icon's cell — the rounded rect a macOS
// selection wears, in the one shape the surface has.
def select_ink() Int64 {
  return 0x587088A8
}

// The icon's box at its cell's heart: the pen's offsets — the
// package's painters' and the metal's typed twins' shared arithmetic.
def icon_off_x() Int64 {
  return 26
}

def icon_off_y() Int64 {
  return 4
}

// A cell's origin in the display's own coordinates, packed x above y —
// the layout's one address, the painters and the hit test and the
// shell's press handler all reading the same arithmetic. Cells run
// down from the top-right, the columns leftward; index 0 is the
// display's top-right corner cell.
def icon_cell(i Int64, w Int64, h Int64) Int64 {
  const rows = (h - icon_top() - icon_bottom()) / icon_cell_h()
  const col = i / rows
  const row = i - col * rows
  const x = w - icon_margin() - (col + 1) * icon_cell_w()
  const y = icon_top() + row * icon_cell_h()
  return (x << 32) | y
}

// The cell a press landed in, or -1: the gap between cells is no
// icon's business, and past the last cell is the desktop's.
def icon_hit(px Int64, py Int64, count Int64, w Int64, h Int64) Int64 {
  var i = 0
  while i < count {
    const cell = icon_cell(i, w, h)
    const x = cell >> 32
    const y = cell & 4294967295
    if px >= x && px < x + icon_cell_w() && py >= y && py < y + icon_cell_h() {
      return i
    }
    i = i + 1
  }
  return -1
}

// A document icon: the page a rounded square graded top to bottom,
// its folded corner and three text lines rounded over it — the
// volume's flat files, drawn in the 44×44 box at the cell's heart
// (`cx`, `cy` the cell's origin). The selection's rounded blend goes
// down first, the icon over it.
def paint_icon_doc(s ui_fb.Surface, cx Int64, cy Int64, selected Bool) Void {
  if selected {
    s.rounded(cx + 2, cy + 1, 92, 74, 10, select_ink(), select_ink())
  }
  const ix = cx + icon_off_x()
  const iy = cy + icon_off_y()
  s.rounded(ix + 8, iy + 2, 28, 40, 4, 0xFFF2F2F8, 0xFFD8DAE4)
  s.rounded(ix + 28, iy + 2, 8, 8, 2, 0xFFC2C8D4, 0xFFC2C8D4)
  s.rounded(ix + 14, iy + 16, 16, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
  s.rounded(ix + 14, iy + 24, 16, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
  s.rounded(ix + 14, iy + 32, 10, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
}

// A folder icon: the tab and the body in the folder blue, the body
// graded from its light along the top to its shade at the foot — a
// name prefix's cell on the desktop (`a/one.txt` shows as the folder
// `a`), entered by a press, left by the `..` cell the view grows when
// entered.
def paint_icon_folder(s ui_fb.Surface, cx Int64, cy Int64, selected Bool) Void {
  if selected {
    s.rounded(cx + 2, cy + 1, 92, 74, 10, select_ink(), select_ink())
  }
  const ix = cx + icon_off_x()
  const iy = cy + icon_off_y()
  s.rounded(ix + 6, iy + 8, 16, 9, 3, 0xFF4098E0, 0xFF4098E0)
  s.rounded(ix + 4, iy + 13, 36, 25, 4, 0xFF5FA8E8, 0xFF327FC2)
}
