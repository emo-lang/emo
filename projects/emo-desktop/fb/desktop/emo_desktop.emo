require "emo/ui_fb"

// The desktop shell's dock (emo-desktop A10.2; the shelf A14.4): the
// machine's desktop chrome, painted direct — fills and glyphs through
// the `Surface`, no tree, the window package's shape and reason (the
// shell repaints the dock per focus change, and every node of a tree
// is a few KiB of boxed numbers left in the arena per repaint on the
// metal). The dock is a panel surface at the display's bottom edge —
// the walk's topmost strip, no window over it (T8.15) — a rounded
// shelf floating on the wallpaper's own formula under a scrim (D8:
// the chrome samples the wallpaper, it does not read the pixels
// behind it), one drawn icon per app the shell runs, the focused
// app's tile in the lit grade, the one visible fact a focus changes.
// A press names the tile it landed on, or none: the policy the
// shell's pointer handler asks before its window hit test, the click
// it answers with the app's own focus.
//
// The tiles sit left to right, one per app in the shell's own order;
// a tile is a rounded square graded top to bottom carrying the app's
// initial in the labels' type. The strip's ground is the wallpaper's
// formula under the dock's scrim — chrome under everything's chrome.

def strip_height() Int64 {
  return 40
}

def tile_size() Int64 {
  return 32
}

def tile_gap() Int64 {
  return 8
}

def tile_margin() Int64 {
  return 20
}

def ink() Int64 {
  return 0xF8F8F0
}

// A tile's grades: the lit steel a focused window's bar wears when
// the tile is the focused app's, a quiet slate when it is not — a
// different byte in every channel, so a swapped focus shows.
def tile_top(focused Bool) Int64 {
  if focused {
    return 0xFF7090B8
  }
  return 0xFF50586A
}

def tile_bottom(focused Bool) Int64 {
  if focused {
    return 0xFF4A6288
  }
  return 0xFF3A4150
}

// The tile index at a display position, or -1: outside the strip is
// no dock's business, and a gap between tiles names no app. `count`
// is the shell's app count, `w` and `h` the display's mode.
def press(x Int64, y Int64, w Int64, h Int64, count Int64) Int64 {
  if y < h - strip_height() {
    return -1
  }
  var i = 0
  while i < count {
    const tx = tile_margin() + (i * (tile_size() + tile_gap()))
    if x >= tx && x < tx + tile_size() {
      return i
    }
    i = i + 1
  }
  return -1
}

// A tile's left edge in the display's own coordinates — the shell's
// to map a tile back to its window, and the model's to name the rect
// a screendump folds.
def tile_x(i Int64) Int64 {
  return tile_margin() + (i * (tile_size() + tile_gap()))
}

// ---- the shelf (emo-desktop A14.4) ----
//
// The dock's rounded shelf floating on the material: the wallpaper's
// own formula under the dock's scrim fills the strip the shelf floats
// on, the shelf's shadow falls on that, the shelf — a translucent
// slab, glass over the wallpaper's own colors — over its shadow, and
// the tiles on the shelf. The shelf sits `shelf_pad` in from the
// strip's sides and top, the tiles a pad inside it.

def shelf_pad() Int64 {
  return 6
}

def shelf_top_pad() Int64 {
  return 3
}

def shelf_radius() Int64 {
  return 12
}

def shelf_soft() Int64 {
  return 8
}

def shelf_height() Int64 {
  return strip_height() - shelf_top_pad() - 3
}

def shelf_top() Int64 {
  return 0x66484C5C
}

def shelf_bottom() Int64 {
  return 0x4C34363E
}

// A tile's top edge in the strip's own coordinates: a pad inside the
// shelf, the icon's box in the strip's middle.
def tile_y() Int64 {
  return 4
}

// The chrome's scrims (D8): the wallpaper's formula sampled under
// each panel's scrim — the header's the darker slate, the dock's the
// strip's own — the alpha in the top byte, the chrome's one material.
def header_scrim() Int64 {
  return 0xB41E1E26
}

def dock_scrim() Int64 {
  return 0xB424242C
}

// One row of the chrome's material at the display row `gy`, painted
// at the surface's local `ly`: the wallpaper's gradient row, every
// ribbon whose span holds the row over it, the scrim over the whole —
// D8's formula, the wallpaper recomputed at nothing a pixel reads.
// `mw` and `mh` are the display's mode (the ribbons are fractions of
// it), `w` the surface's own width — the header's golden canvas is
// narrower than the mode and samples the same formula.
def material_row(s ui_fb.Surface, ly Int64, gy Int64, w Int64, mw Int64,
                 mh Int64, scrim Int64) Void {
  const denom = mh - 1
  const tr = (wall_top() >> 16) & 255
  const tg = (wall_top() >> 8) & 255
  const tb = wall_top() & 255
  const br = (wall_bottom() >> 16) & 255
  const bg = (wall_bottom() >> 8) & 255
  const bb = wall_bottom() & 255
  const r = (tr * (denom - gy) + br * gy) / denom
  const g = (tg * (denom - gy) + bg * gy) / denom
  const b = (tb * (denom - gy) + bb * gy) / denom
  s.fill(0, ly, w, 1, (r << 16) | (g << 8) | b)
  if gy < (5 * mh) / 8 {
    s.blend(-((25 * mw) / 128) + (3 * gy) / 4, ly, (115 * mw) / 256, 1,
      (0x28 << 24) | 0x30B8C8)
  }
  if gy >= (5 * mh) / 24 && gy < (15 * mh) / 16 {
    s.blend((15 * mw) / 256 + gy / 2, ly, (25 * mw) / 64, 1,
      (0x20 << 24) | 0xE86890)
  }
  if gy >= (85 * mh) / 192 {
    s.blend((225 * mw) / 256 - gy / 4, ly, (135 * mw) / 256, 1,
      (0x18 << 24) | 0x8868E8)
  }
  s.blend(0, ly, w, 1, scrim)
}

// The strip onto its own surface, whole from scratch: the material
// row by row, the shelf's shadow and the shelf over it, then one
// drawn icon per app — a rounded square graded top to bottom, the
// initial centered in it. `labels` are the apps' initials in tile
// order, `focused` the lit tile's index or -1 when no app holds the
// focus, and `running` the residency's bitmask — bit i set when the
// i-th app has a live process — the launcher's one visible fact
// (emo-desktop A12.1): a running app's tile wears the 4×4 ink dot at
// its foot, centered, two pixels above the tile's bottom edge, the
// mark a macOS dock keeps under a running application's icon. `h` is
// the strip's own height and `top` the display row its first row
// stands on — the material samples the wallpaper's formula at the
// display's own rows.
def paint(s ui_fb.Surface, f ui_fb.raster.Strike, w Int64, h Int64,
          top Int64, labels Array[String], focused Int64,
          running Int64) Void {
  var ly = 0
  while ly < h {
    material_row(s, ly, top + ly, w, w, top + h, dock_scrim())
    ly = ly + 1
  }
  const sx = shelf_pad()
  const sy = shelf_top_pad()
  const sw = w - shelf_pad() * 2
  const sh = shelf_height()
  s.shadow(sx, sy, sw, sh, shelf_radius(), shelf_soft(), 0x80000000)
  s.rounded(sx, sy, sw, sh, shelf_radius(), shelf_top(), shelf_bottom())
  var i = 0
  while i < labels.length() {
    const tx = tile_x(i)
    const ty = tile_y()
    s.rounded(tx, ty, tile_size(), tile_size(), 8, tile_top(i == focused),
      tile_bottom(i == focused))
    ui_fb.text(f, labels[i],
      tx + (tile_size() - ui_fb.text_width(f, labels[i])) / 2,
      ty + (tile_size() - f.line_height()) / 2, ink(), s)
    if (running >> i) & 1 == 1 {
      s.fill(tx + 14, ty + 26, 4, 4, ink())
    }
    i = i + 1
  }
}

// ---- the desktop's own canvas (emo-desktop A13) ----
//
// The macOS-like desktop's three surfaces: the wallpaper (role 4, the
// walk's undermost layer), the header bar (a panel at the top edge),
// and the icons the desktop shows for the volume's files — folders by
// the name's prefix, documents for the rest, a selection highlight the
// press moves. Painted direct like the dock, for the reason the dock
// is: a tree's boxed numbers per repaint are the arena's to carry, and
// a wallpaper repaint is the desktop's most common frame. Every number
// here is integer and fixed, so the screendump's bytes are the
// formula's and the hosted golden's digest is the metal's.

// The header bar's height — the panel strip at the display's top edge.
def header_height() Int64 {
  return 24
}

// The icon grid's metrics: cells run from the display's top-right
// corner downward and the columns leftward, the way macOS lays a
// desktop's icons; the top edge sits under the header, the bottom edge
// above the dock. A cell is the icon's box plus the name's line under
// it, padded — the press's hit area is the cell, the pen's is the box.
def icon_cell_w() Int64 {
  return 96
}

def icon_cell_h() Int64 {
  return 76
}

def icon_size() Int64 {
  return 44
}

def icon_margin() Int64 {
  return 8
}

def icon_top() Int64 {
  return 32
}

def icon_bottom() Int64 {
  return 48
}

// One integer square root, Newton's, rounded down — the ribbon
// geometry's helper and nothing else's customer today. All positive:
// the caller's shapes are radii squared.
def isqrt(n Int64) Int64 {
  if n <= 0 {
    return 0
  }
  var x = n
  var y = (x + 1) / 2
  while y < x {
    x = y
    y = (x + n / x) / 2
  }
  return x
}

// One byte's glyph at the pen (x, y) in the labels' type (A14.2): the
// index is the byte's position past space, the missing glyph for a byte
// the font has no drawing of, the same rule the String walk's
// (`font.glyph_of`). The desktop's names come from the volume as bytes
// through the fs, and a String is never built of them: the shell reads
// the scratch buffer's bytes straight into this. The advance the next
// byte's pen moves by comes back.
def text_byte(s ui_fb.Surface, f ui_fb.raster.Strike, x Int64, y Int64,
              b Int64, ink_color Int64) Int64 {
  var i = b - 31
  if i < 1 || i > 95 {
    i = 0
  }
  s.ink(x, y, f, i, ink_color)
  return f.advance(i)
}

// The wallpaper's colors: a deep navy at the top running into a dusky
// violet at the bottom, the gradient the composition sits under
// everything.
def wall_top() Int64 {
  return 0x101C3C
}

def wall_bottom() Int64 {
  return 0x40306A
}

// One translucent ribbon: a diagonal band, one blended row at a time —
// the row's left edge a line `(m·y)/d + c`, the width fixed, the ink a
// blend word, the coverage in its top byte the surface's own rule.
// `span` packs the band's rows, `y0` above `y1` — the riscv64 call
// takes eight arguments, and the ribbon's shape fits in them. `d` is
// never zero (the caller's slopes are honest fractions).
def ribbon(s ui_fb.Surface, h Int64, span Int64, m Int64, d Int64, c Int64, width Int64, ink_color Int64) Void {
  var y = span >> 32
  if y < 0 {
    y = 0
  }
  var ye = span & 4294967295
  if ye > h {
    ye = h
  }
  while y < ye {
    const x = c + (m * y) / d
    s.blend(x, y, width, 1, ink_color)
    y = y + 1
  }
}

// The wallpaper whole: the gradient row by row (each channel a
// positive-weight lerp between the two anchors, so the division is the
// positive kind every target rounds the same), then the three ribbons
// over it — teal from the upper left, rose through the middle, violet
// from the lower right, macOS's abstract poster in the surface's own
// primitives. One call per boot: the shell paints the icons over this
// before the wallpaper's first present.
def wallpaper(s ui_fb.Surface, w Int64, h Int64) Void {
  const denom = h - 1
  const tr = (wall_top() >> 16) & 0xFF
  const tg = (wall_top() >> 8) & 0xFF
  const tb = wall_top() & 0xFF
  const br = (wall_bottom() >> 16) & 0xFF
  const bg = (wall_bottom() >> 8) & 0xFF
  const bb = wall_bottom() & 0xFF
  var y = 0
  while y < h {
    const r = (tr * (denom - y) + br * y) / denom
    const g = (tg * (denom - y) + bg * y) / denom
    const b = (tb * (denom - y) + bb * y) / denom
    s.fill(0, y, w, 1, (r << 16) | (g << 8) | b)
    y = y + 1
  }
  // The ribbons' bands, offsets and widths derive from the mode (A14.3
  // — fractions of w and h whose 256ths and 128ths reproduce the 1024x768
  // drawing they were tuned at exactly); the slopes stay the art's own.
  ribbon(s, h, (0 << 32) | ((5 * h) / 8), 3, 4, -((25 * w) / 128),
    (115 * w) / 256, (0x28 << 24) | 0x30B8C8)
  ribbon(s, h, (((5 * h) / 24) << 32) | ((15 * h) / 16), 1, 2, (15 * w) / 256,
    (25 * w) / 64, (0x20 << 24) | 0xE86890)
  ribbon(s, h, (((85 * h) / 192) << 32) | h, -1, 4, (225 * w) / 256,
    (135 * w) / 256, (0x18 << 24) | 0x8868E8)
}

// The header bar's inks: the wordmark in the boot banner's cyan, the
// count in the quiet ink — the bar's ground is the wallpaper's own
// formula under the header's scrim (`material_row`, D8).
def header_ink() Int64 {
  return 0xC8C8D0
}

def header_accent() Int64 {
  return 0x40C8C8
}

// `<n> apps` ending one pad short of `right`, drawn byte by byte — the
// count is a number the shell keeps, not a String the image carries.
// The digits' advances are summed before they are drawn, so the text
// ends where it should whatever the digits are. The x the text starts
// at comes back, the caller's to center against.
def count_text(s ui_fb.Surface, f ui_fb.raster.Strike, right Int64,
               y Int64, n Int64, ink_color Int64) Int64 {
  var div = 1
  while n / div >= 10 {
    div = div * 10
  }
  var digits_w = 0
  var d = div
  while d > 0 {
    digits_w = digits_w + f.advance(17 + ((n / d) % 10))
    d = d / 10
  }
  const x = right - digits_w - ui_fb.text_width(f, " apps")
  var p = x
  while div > 0 {
    p = p + text_byte(s, f, p, y, 48 + ((n / div) % 10), ink_color)
    div = div / 10
  }
  ui_fb.text(f, " apps", p, y, ink_color, s)
  return x
}

// ---- the pager (emo-desktop M27, A27.2, D18) ----
//
// The bar's four desk cells, the workspace switch's own face: a cell
// per desk right of the bell, the active desk's cell the accent's
// rounded ground behind its number (the calendar's today-cell
// precedent), a desk with live windows the inked number on a
// translucent slate, an empty desk the dimmed number alone. The state
// is the query word the caller read — the active desk in the low byte,
// the occupancy mask above it — the bar painting what the machine
// said, never a desk of its own (D15's rule, the clock's own shape).
// A press on a cell names the desk it lands on: the hit test the
// shell's press handler asks before the panels, the answer the
// switch's word.

def pager_size() Int64 {
  return 14
}

def pager_gap() Int64 {
  return 6
}

// The first cell's left edge: past the bell (the shell's own 16×16
// cell at wordmark +12 — the 40 is the bell's span, the shell's wiring
// the pad names), one pad of air after it. The painters, the hit test
// and the metal's typed twin all read this one arithmetic.
def pager_x0(f ui_fb.raster.Strike) Int64 {
  return 8 + ui_fb.text_width(f, "EmoOS") + 40
}

def pager_y() Int64 {
  return (header_height() - pager_size()) / 2
}

// Cell `i`'s top-left corner, packed x above y — the layout's one
// address, the package painter and the hit test and the shell's twin
// sharing it.
def pager_cell(f ui_fb.raster.Strike, i Int64) Int64 {
  return ((pager_x0(f) + i * (pager_size() + pager_gap())) << 32) |
    pager_y()
}

// The desk a press landed on, or -1: past the cells, above or below
// the bar, a gap between cells — no pager's business.
def pager_hit(f ui_fb.raster.Strike, x Int64, y Int64) Int64 {
  if y < pager_y() || y >= pager_y() + pager_size() {
    return -1
  }
  var i = 0
  while i < pager_count() {
    const cell = pager_cell(f, i)
    const cx = cell >> 32
    if x >= cx && x < cx + pager_size() {
      return i
    }
    i = i + 1
  }
  return -1
}

// The vocabulary's bound: the count the ABI pins (the roles'
// precedent), the pager's cell count and the mask's width with it.
def pager_count() Int64 {
  return 4
}

// The pager's grades: the active cell's accent ground and its dark
// number (the calendar's today-cell pair), the occupied cell's
// translucent slate and the inked number, the empty desk's dimmed
// number alone.
def pager_active_ground() Int64 {
  return 0xFFE86890
}

def pager_active_ink() Int64 {
  return 0x20242C
}

def pager_occupied_ground() Int64 {
  return 0x8C3A4150
}

def pager_occupied_ink() Int64 {
  return 0xF8F8F0
}

def pager_empty_ink() Int64 {
  return 0x78B8BCC4
}

// The four cells onto the bar's surface: the caller's `desks` word
// decoded — the active desk in the low byte, the occupancy mask above —
// one rounded ground where the state names one, the number centered in
// every cell.
def paint_pager(s ui_fb.Surface, f ui_fb.raster.Strike, desks Int64) Void {
  const active = desks & 255
  const mask = (desks >> 8) & 15
  var i = 0
  while i < pager_count() {
    const cell = pager_cell(f, i)
    const x = cell >> 32
    const y = cell & 4294967295
    var ground = 0
    var ink_color = pager_empty_ink()
    if i == active {
      ground = pager_active_ground()
      ink_color = pager_active_ink()
    } else {
      if (mask >> i) & 1 == 1 {
        ground = pager_occupied_ground()
        ink_color = pager_occupied_ink()
      }
    }
    if ground != 0 {
      s.rounded(x, y, pager_size(), pager_size(), 4, ground, ground)
    }
    const ns = "${i + 1}"
    ui_fb.text(f, ns, x + (pager_size() - ui_fb.text_width(f, ns)) / 2,
      y + (pager_size() - f.line_height()) / 2, ink_color, s)
    i = i + 1
  }
}

// The header bar onto its own surface, whole from scratch: the
// wallpaper's formula under the header's scrim, row by row — the bar
// samples the display's own rows, `mw` and `mh` the mode — then the
// wordmark one pad in, the bell and the pager after it, the wall clock
// at the right edge and the running count before it. The clock is
// `now` — the seconds the caller read, never the bar's own (the bar
// has no clock of its own; the time verb and the caller's wake are its
// ground, D17) — and the count is the one fact the desktop keeps (its
// own children's residency; the foreground app's name it does not
// know, and the bar does not pretend to). The desks are the pager's
// word — the query verb's own packing, the active desk in the low byte
// and the occupancy mask above it (D18); the caller read it, the bar
// does no verb of its own. The text sits centered in the bar's height,
// the line box's own.
def paint_header(s ui_fb.Surface, f ui_fb.raster.Strike, w Int64,
                 mw Int64, mh Int64, running Int64, now Int64,
                 desks Int64) Void {
  var y = 0
  while y < header_height() {
    material_row(s, y, y, w, mw, mh, header_scrim())
    y = y + 1
  }
  const ty = (header_height() - f.line_height()) / 2
  ui_fb.text(f, "EmoOS", 8, ty, header_accent(), s)
  const cw = ui_fb.text_width(f, clock_text(0))
  ui_fb.text(f, clock_text(now), w - icon_margin() - cw, ty, header_ink(), s)
  count_text(s, f, w - icon_margin() - cw - 16, ty, running, header_ink())
  paint_pager(s, f, desks)
}

// ---- the wall clock (emo-desktop M26, D17) ----
//
// The board's RTC answers the seconds since the Unix epoch (the time
// verb, EmoOS T12.1) and the bar and the calendar read it in UTC —
// the machine knows no time zone, and the chrome does not pretend to
// (D15). The conversions are the civil calendar's integer arithmetic;
// every division sees a non-negative dividend for any date the RTC
// can report, so truncation is the floor and no correction rides
// along.

// The civil pack: `(y << 16) | (m << 8) | d` — the year above, the
// month and the day below, lifted by shift and mask. `day` the days
// since the epoch; the form is the civil calendar's own.
def civil(day Int64) Int64 {
  const z = day + 719468
  const era = z / 146097
  const doe = z - era * 146097
  const yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
  const y = yoe + era * 400
  const doy = doe - (365 * yoe + yoe / 4 - yoe / 100)
  const mp = (5 * doy + 2) / 153
  const d = doy - (153 * mp + 2) / 5 + 1
  var m = mp + 3
  if mp >= 10 {
    m = mp - 9
  }
  var yy = y
  if m <= 2 {
    yy = y + 1
  }
  return (yy << 16) | (m << 8) | d
}

// The weekday of `day`, Sunday 0 — the epoch's own day was a
// Thursday, the +4 the pack needs.
def weekday(day Int64) Int64 {
  var r = (day + 4) % 7
  if r < 0 {
    r = r + 7
  }
  return r
}

// `HH:MM`, UTC — the bar's clock, the five bytes the strike draws.
def clock_text(now Int64) String {
  const day = now / 86400
  const secs = now - day * 86400
  const hh = secs / 3600
  const mm = (secs - hh * 3600) / 60
  var hs = "${hh}"
  if hh < 10 {
    hs = "0${hh}"
  }
  var ms = "${mm}"
  if mm < 10 {
    ms = "0${mm}"
  }
  return "${hs}:${ms}"
}

// Whether y leaps — the every-four, except the hundreds, except the
// four-hundreds.
def civil_leap(y Int64) Bool {
  if y % 4 != 0 {
    return false
  }
  if y % 100 != 0 {
    return true
  }
  return y % 400 == 0
}

// The month's length.
def civil_dim(y Int64, m Int64) Int64 {
  if m == 2 {
    if civil_leap(y) {
      return 29
    }
    return 28
  }
  if m == 4 || m == 6 || m == 9 || m == 11 {
    return 30
  }
  return 31
}

// The calendar panel's metrics: a cell 36 wide and 24 high, the grid
// seven across and six down whatever the month, the title a line
// above it, the pad around the whole — the panel 276 by 220.
def cal_pad() Int64 {
  return 12
}

def cal_cell_w() Int64 {
  return 36
}

def cal_cell_h() Int64 {
  return 24
}

def cal_title_h() Int64 {
  return 28
}

def cal_w() Int64 {
  return 7 * cal_cell_w() + 2 * cal_pad()
}

def cal_h() Int64 {
  return cal_pad() + cal_title_h() + 7 * cal_cell_h() + cal_pad()
}

// The panel's seat: the display's right edge under the bar's clock,
// the top the header's height plus the toast's own gap.
def cal_x(w Int64) Int64 {
  return w - cal_w() - 8
}

def cal_y() Int64 {
  return header_height() + 8
}

// The panel's ground: the toast's own grades and radius — the panel
// floats over the desktop's icons, the alpha for what it covers.
def cal_ground_top() Int64 {
  return 0xE64A5468
}

def cal_ground_bottom() Int64 {
  return 0xE6363E4C
}

// The calendar panel whole: the title the month's `YYYY-MM`, the
// week's initials under it, the days the grid — today's cell the
// accent's rounded ground behind its number. Six rows always, the
// month's empties nothing at all.
def paint_calendar(s ui_fb.Surface, f ui_fb.raster.Strike, now Int64) Void {
  const w = cal_w()
  const h = cal_h()
  s.shadow(0, 0, w, h, 12, 8, 0x80000000)
  s.rounded(0, 0, w, h, 12, cal_ground_top(), cal_ground_bottom())
  const c = civil(now / 86400)
  const y = c >> 16
  const m = (c >> 8) & 255
  const d = c & 255
  var ms = "${m}"
  if m < 10 {
    ms = "0${m}"
  }
  const title = "${y}-${ms}"
  ui_fb.text(f, title, (w - ui_fb.text_width(f, title)) / 2, cal_pad(),
    0xF8F8F0, s)
  const initials = ["S", "M", "T", "W", "T", "F", "S"]
  var wcol = 0
  while wcol < 7 {
    const x = cal_pad() + wcol * cal_cell_w() +
      (cal_cell_w() - ui_fb.text_width(f, initials[wcol])) / 2
    ui_fb.text(f, initials[wcol], x, cal_pad() + cal_title_h() + 2, 0xB8BCC4, s)
    wcol = wcol + 1
  }
  const dim = civil_dim(y, m)
  const first = weekday(now / 86400 - (d - 1))
  var row = 0
  while row < 6 {
    var gcol = 0
    while gcol < 7 {
      const n = row * 7 + gcol - first + 1
      if n >= 1 && n <= dim {
        const x = cal_pad() + gcol * cal_cell_w()
        const ty = cal_pad() + cal_title_h() + cal_cell_h() + row * cal_cell_h()
        if n == d {
          s.rounded(x + 2, ty + 1, cal_cell_w() - 4, cal_cell_h() - 2, 6,
            0xFFE86890, 0xFFE86890)
        }
        const ns = "${n}"
        const nx = x + (cal_cell_w() - ui_fb.text_width(f, ns)) / 2
        if n == d {
          ui_fb.text(f, ns, nx, ty + 1, 0x20242C, s)
        } else {
          ui_fb.text(f, ns, nx, ty + 1, 0xF8F8F0, s)
        }
      }
      gcol = gcol + 1
    }
    row = row + 1
  }
}

// The selection's blend word: the tile steel at a low coverage laid
// over the wallpaper behind an icon's cell — the rounded rect a macOS
// selection wears, in the one shape the surface has.
def select_ink() Int64 {
  return 0x587088A8
}

// The icon's box at its cell's heart: the pen's offsets — the
// package's painters' and the metal's typed twins' shared arithmetic.
def icon_off_x() Int64 {
  return 26
}

def icon_off_y() Int64 {
  return 4
}

// A cell's origin in the display's own coordinates, packed x above y —
// the layout's one address, the painters and the hit test and the
// shell's press handler all reading the same arithmetic. Cells run
// down from the top-right, the columns leftward; index 0 is the
// display's top-right corner cell.
def icon_cell(i Int64, w Int64, h Int64) Int64 {
  const rows = (h - icon_top() - icon_bottom()) / icon_cell_h()
  const col = i / rows
  const row = i - col * rows
  const x = w - icon_margin() - (col + 1) * icon_cell_w()
  const y = icon_top() + row * icon_cell_h()
  return (x << 32) | y
}

// The cell a press landed in, or -1: the gap between cells is no
// icon's business, and past the last cell is the desktop's.
def icon_hit(px Int64, py Int64, count Int64, w Int64, h Int64) Int64 {
  var i = 0
  while i < count {
    const cell = icon_cell(i, w, h)
    const x = cell >> 32
    const y = cell & 4294967295
    if px >= x && px < x + icon_cell_w() && py >= y && py < y + icon_cell_h() {
      return i
    }
    i = i + 1
  }
  return -1
}

// A document icon: the page a rounded square graded top to bottom,
// its folded corner and three text lines rounded over it — the
// volume's flat files, drawn in the 44×44 box at the cell's heart
// (`cx`, `cy` the cell's origin). The selection's rounded blend goes
// down first, the icon over it.
def paint_icon_doc(s ui_fb.Surface, cx Int64, cy Int64, selected Bool) Void {
  if selected {
    s.rounded(cx + 2, cy + 1, 92, 74, 10, select_ink(), select_ink())
  }
  const ix = cx + icon_off_x()
  const iy = cy + icon_off_y()
  s.rounded(ix + 8, iy + 2, 28, 40, 4, 0xFFF2F2F8, 0xFFD8DAE4)
  s.rounded(ix + 28, iy + 2, 8, 8, 2, 0xFFC2C8D4, 0xFFC2C8D4)
  s.rounded(ix + 14, iy + 16, 16, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
  s.rounded(ix + 14, iy + 24, 16, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
  s.rounded(ix + 14, iy + 32, 10, 3, 1, 0xFF98A0B0, 0xFF98A0B0)
}

// A folder icon: the tab and the body in the folder blue, the body
// graded from its light along the top to its shade at the foot — a
// name prefix's cell on the desktop (`a/one.txt` shows as the folder
// `a`), entered by a press, left by the `..` cell the view grows when
// entered.
def paint_icon_folder(s ui_fb.Surface, cx Int64, cy Int64, selected Bool) Void {
  if selected {
    s.rounded(cx + 2, cy + 1, 92, 74, 10, select_ink(), select_ink())
  }
  const ix = cx + icon_off_x()
  const iy = cy + icon_off_y()
  s.rounded(ix + 6, iy + 8, 16, 9, 3, 0xFF4098E0, 0xFF4098E0)
  s.rounded(ix + 4, iy + 13, 36, 25, 4, 0xFF5FA8E8, 0xFF327FC2)
}

// ---- the launcher (emo-desktop M28, A28.1) ----
//
// The dock's first tile in the desktop era is the launcher's own —
// `s`, the search face's initial — the app tiles one slot right, the
// shell mapping tile 0 to the panel and 1.. to its apps; the desk
// era's strip keeps its own two tiles, the launcher the desktop's
// module. The catalog arithmetic and the search face's geometry are
// the package's, the panel painted direct like the dock's own slab: a
// slab centered above the dock, the search line at its top, the
// survivors under it — the volume's packages are few (the
// filesystem's own bound, 24 bytes a name), so the face's row bound
// is the face's own eight.

def launch_w(w Int64) Int64 {
  if w >= 600 {
    return 560
  }
  return w - 40
}

def launch_line_h() Int64 {
  return 40
}

def launch_row_h() Int64 {
  return 24
}

def launch_rows() Int64 {
  return 8
}

def launch_pad() Int64 {
  return 12
}

def launch_h() Int64 {
  return launch_line_h() + launch_rows() * launch_row_h() + launch_pad() * 2
}

def launch_x(w Int64) Int64 {
  return (w - launch_w(w)) / 2
}

def launch_y(h Int64) Int64 {
  return h - strip_height() - 12 - launch_h()
}

// An app name ends in `.elf` with a stem to show — `.elf` alone is
// no app's name.
def is_app_name(s String) Bool {
  const n = s.length()
  if n <= 4 {
    return false
  }
  return s.substring(n - 4, 4) == ".elf"
}

// A search line matches a name when it is one of the name's own
// substrings; the empty line matches everything — the face's opening
// state is the catalog whole.
def line_matches(line String, s String) Bool {
  const m = line.length()
  if m == 0 {
    return true
  }
  const n = s.length()
  if m > n {
    return false
  }
  var i = 0
  while i <= n - m {
    if s.substring(i, m) == line {
      return true
    }
    i = i + 1
  }
  return false
}

// The row a press names: the panel's own coordinates derived from the
// mode, the search line no row's, the rows 0-based from the line's
// band, a press past the survivors' count no row either.
def launch_hit(w Int64, h Int64, px Int64, py Int64, n Int64) Int64 {
  const x0 = launch_x(w)
  const y0 = launch_y(h)
  if px < x0 || px >= x0 + launch_w(w) || py < y0 {
    return -1
  }
  const top = y0 + launch_line_h() + launch_pad()
  if py < top {
    return -1
  }
  const row = (py - top) / launch_row_h()
  if row >= n || row >= launch_rows() {
    return -1
  }
  return row
}

// The launcher panel whole: the slab (the calendar's own shape, the
// grades the launcher's own), the search line's text with the caret
// block after it, and the survivors' rows — the selected row the
// selection's band, every row the name's text. The rows are the
// caller's survivors already; the count shown the face's bound.
def launch_ground_top() Int64 {
  return 0xE6424E62
}

def launch_ground_bottom() Int64 {
  return 0xE6323C4A
}

def paint_launcher(s ui_fb.Surface, f ui_fb.raster.Strike, line String,
                   names Array[String], n Int64, sel Int64) Void {
  const w = s.width()
  const h = s.height()
  s.shadow(0, 0, w, h, 12, 8, 0x80000000)
  s.rounded(0, 0, w, h, 12, launch_ground_top(), launch_ground_bottom())
  ui_fb.text(f, line, launch_pad(), (launch_line_h() - f.line_height()) / 2,
    0xF8F8F0, s)
  const caret = launch_pad() + ui_fb.text_width(f, line) + 4
  s.fill(caret, (launch_line_h() - 18) / 2, 2, 18, ink())
  var i = 0
  while i < n && i < launch_rows() {
    const ry = launch_line_h() + launch_pad() + i * launch_row_h()
    if i == sel {
      s.fill(launch_pad() / 2, ry + 1, w - launch_pad(), launch_row_h() - 2,
        select_ink())
    }
    ui_fb.text(f, names[i], launch_pad(),
      ry + (launch_row_h() - f.line_height()) / 2, 0xF8F8F0, s)
    i = i + 1
  }
}

// ---- the lock (emo-desktop M28, A28.2) ----
//
// The session's lock face: a full-screen toplevel the shell raises at
// the lock and closes at the check's pass, an opaque scrim over
// everything — nothing under it leaks, not the wallpaper's shape, not
// a window's corner — the wordmark centered, the blind line's caret
// under it. The typed bytes are nobody's pixels: no echo, no dots, not
// even the count — the line lives in the shell's scratch, and the
// account file's verdict is the whole answer. The file itself is the
// stdlib's own digest: 32 raw bytes of `crypto.sha2.sha256` over the
// secret, compared through `constant_time_compare` — the shell's
// calls, the face's only business the pixels.

def lock_scrim() Int64 {
  return 0xFF14141C
}

def lock_ink() Int64 {
  return 0xF8F8F0
}

def paint_lock(s ui_fb.Surface, f ui_fb.raster.Strike) Void {
  const w = s.width()
  const h = s.height()
  s.fill(0, 0, w, h, lock_scrim())
  const word = "locked"
  const lw = ui_fb.text_width(f, word)
  ui_fb.text(f, word, (w - lw) / 2, (h - f.line_height()) / 2 - 12,
    lock_ink(), s)
  s.fill(w / 2 - 1, (h - f.line_height()) / 2 + 24, 2, 18, lock_ink())
}
