// The fb core's own test: the box model's arithmetic in pixels, the
// clip and blend verbs, the font's lookup and rows, and the scripted
// input, checked as values rather than as bytes — everything the core
// can show without a surface. What needs one (the glyph verb, paint's
// layering, `ppm`, the backend's repaint) is `canvas/test.emo`'s,
// through the hosted canvas; the painted bytes are `golden/`'s.
//
//   emo run test.emo
//
// It is a module of the package, not a package of its own, so
// `emo check ui_fb.emo` checks it and `./check.sh` runs it.

def check(ok Bool, what String) {
  if ok {
    println("ok   ${what}")
  } else {
    raise Exception.new(message: "assertion failed: ${what}")
  }
}

def extent_is(e ui_fb.Extent, w Int64, h Int64, what String) {
  if e.w() == w && e.h() == h {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: measured ${e.w()}x${e.h()}, wanted ${w}x${h}")
  }
}

def rect_is(r ui_fb.Rect, x Int64, y Int64, w Int64, h Int64, what String) {
  if r.x() == x && r.y() == y && r.w() == w && r.h() == h {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: clipped to ${r.x()},${r.y()} ${r.w()}x${r.h()}, wanted ${x},${y} ${w}x${h}")
  }
}

def word_is(got Int64, want Int64, what String) {
  if got == want {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: got ${got}, wanted ${want}")
  }
}

// ---- measure: a label is its glyphs' advances, a box is its children --

def padded() ui.Node {
  return ui.column([
    ui.text("ab", ui.style()),
    ui.text("c", ui.style())
  ], ui.style().with_padding(4.0).with_gap(2.0))
}

def paired() ui.Node {
  return ui.row([
    ui.button("a", 0, ui.style()),
    ui.button("b", 1, ui.style())
  ], ui.style().with_gap(8.0))
}

// The widths named here are the interface face's advances at 16 pixels
// (`glyphs/coverage.txt`): the space 5, `[` and `]` 6, `a` 9, `b` 10,
// `c` and `x` 9; its line box is 20 tall.

def measure_checks() {
  extent_is(ui_fb.measure(padded(), -1), 27, 50,
    "a column is its widest child plus padding, its children stacked a gap apart")
  extent_is(ui_fb.measure(paired(), -1), 71, 20,
    "a row lines its bracketed buttons up, one gap apart, one line box tall")
  extent_is(ui_fb.measure(ui.text_input("n", ui.style().with_width(40.0)), -1),
    40, 20, "a fixed width overrides the intrinsic one")
  extent_is(ui_fb.measure(ui.scroll([ui.text("x", ui.style())],
    ui.style().with_height(64.0)), -1), 9, 64,
    "a scroll is as tall as its viewport, as wide as its content")
  extent_is(ui_fb.measure(ui.spacer(ui.style()), -1), 0, 0,
    "a spacer measures to nothing")
}

// ---- clip: the rectangle that lands on the surface ------------------

def clip_checks() {
  rect_is(ui_fb.clip(2, 3, 4, 5, 10, 10), 2, 3, 4, 5,
    "a rectangle inside the bounds is itself")
  rect_is(ui_fb.clip(-4, 0, 10, 2, 10, 10), 0, 0, 6, 2,
    "crossing the left edge pulls the origin in and shortens the width")
  rect_is(ui_fb.clip(8, 0, 10, 2, 10, 10), 8, 0, 2, 2,
    "crossing the right edge shortens the width")
  rect_is(ui_fb.clip(0, -1, 2, 20, 10, 10), 0, 0, 2, 10,
    "crossing both the top and the bottom leaves the full height")
  rect_is(ui_fb.clip(12, 0, 4, 4, 10, 10), 12, 0, 0, 4,
    "a rectangle wholly outside clips to a zero width")
  rect_is(ui_fb.clip(-5, -5, 30, 30, 10, 10), 0, 0, 10, 10,
    "a rectangle around the bounds clips to the bounds")
}

// ---- over: one pixel of source-over, integer-exact --------------------

def over_checks() {
  word_is(ui_fb.over(0xFF123456, 0xFFFFFF), 0x123456,
    "full coverage is the source, top byte cleared")
  word_is(ui_fb.over(0x123456, 0xABCDEF), 0xABCDEF,
    "no coverage is the destination")
  word_is(ui_fb.over(0x80FF0000, 0x00FF00), 0x807F00,
    "half red over green mixes each channel, rounded to nearest")
  word_is(ui_fb.over(0x40000000, 0xFFFFFF), 0xBFBFBF,
    "a quarter of black over white is three-quarters white")
}

// ---- the shapes' arithmetic (A14.1): distance, coverage, grade -------
//
// The shape is (0, 0, 9, 9) at radius 4 where a pixel is named: a
// pixel's center against the edge in 256ths, worked by hand.

def shape_checks() {
  word_is(ui_fb.isqrt(0), 0, "the square root of 0 is 0")
  word_is(ui_fb.isqrt(15), 3, "a root is floored")
  word_is(ui_fb.isqrt(16), 4, "an exact square's root is exact")
  word_is(ui_fb.isqrt(819200), 905, "a corner's distance is floored")
  word_is(ui_fb.isqrt(4611686018427387904), 2147483648,
    "the top bit's square root is exact")
  word_is(ui_fb.isqrt(4611686018427387903), 2147483647,
    "and one below it floors")
  word_is(ui_fb.radius_in(4, 9, 9), 4, "a radius inside the shape stands")
  word_is(ui_fb.radius_in(10, 9, 20), 4, "a radius past half the shorter side is half")
  word_is(ui_fb.radius_in(-1, 5, 5), 0, "a negative radius is none")
  word_is(ui_fb.shape_sd(4, 4, 0, 0, 9, 9, 4), -1152,
    "the middle's center lies four and a half pixels in")
  word_is(ui_fb.shape_sd(0, 4, 0, 0, 9, 9, 4), -128,
    "a straight edge's pixel lies half a pixel in")
  word_is(ui_fb.shape_sd(0, 0, 0, 0, 9, 9, 4), 243,
    "the corner pixel lies outside the arc")
  word_is(ui_fb.shape_sd(1, 1, 0, 0, 9, 9, 4), -119,
    "the next one just inside it")
  word_is(ui_fb.fill_cover(-128), 255, "a fill covers half a pixel in whole")
  word_is(ui_fb.fill_cover(0), 128, "the edge itself half")
  word_is(ui_fb.fill_cover(128), 0, "half a pixel out not at all")
  word_is(ui_fb.stroke_cover(-128, 1), 255, "a stroke covers the edge's pixel")
  word_is(ui_fb.stroke_cover(-384, 1), 0, "and not the one past its width")
  word_is(ui_fb.shadow_cover(0, 4), 128, "a shadow's edge is half its color")
  word_is(ui_fb.shadow_cover(-128, 4), 174, "eased in on the smoothstep")
  word_is(ui_fb.shadow_cover(128, 4), 81, "and out on its mirror")
  word_is(ui_fb.shadow_cover(-640, 4), 255, "whole past half its softness in")
  word_is(ui_fb.shadow_cover(640, 4), 0, "clear past half its softness out")
  word_is(ui_fb.shadow_cover(0, 0), ui_fb.shadow_cover(0, 1),
    "a softness under one pixel is one pixel")
  word_is(ui_fb.shadow_pad(4), 3, "a shadow reaches half its softness and one past its edge")
  word_is(ui_fb.cover(0xFFFFFFFF, 128), 0x80FFFFFF, "coverage scales the opacity")
  word_is(ui_fb.cover(0x80123456, 255), 0x80123456, "whole coverage keeps it")
  word_is(ui_fb.grade(0xFF000000, 0xFFFF0080, 2, 5), 0xFF800040,
    "a grade's middle row is halfway in every channel")
  word_is(ui_fb.grade(0xFF000000, 0xFFFF0080, 4, 5), 0xFFFF0080,
    "its last row is its bottom")
  word_is(ui_fb.grade(0x40112233, 0xFF000000, 0, 1), 0x40112233,
    "a grade one row tall is its top")
}

// ---- the type: a character's glyph, a glyph's metrics and ink ----------
//
// The values named here are the grid's (`glyphs/coverage.txt`): at 16
// pixels the interface face's `A` advances 11, its ink 11 by 12 from
// four rows down, row 0 `....8f8....` and row 7 `.1effffff1.`; its `j`
// hangs one pixel left of the pen; the monospace face advances 10 for
// every glyph; the three line boxes are 20, 30 and 22 tall.

def font_checks() {
  word_is(font.glyph_of(" "), 0, "the space is the first glyph")
  word_is(font.glyph_of("A"), 33, "a character's glyph is its place in the alphabet")
  word_is(font.glyph_of("~"), 94, "the tilde is the last printable one")
  word_is(font.glyph_of("\n"), font.missing(),
    "a character outside the table is the missing glyph")
  word_is(font.line_height(font.ui16()), 20, "the interface face's line box at 16")
  word_is(font.line_height(font.ui24()), 30, "and at 24")
  word_is(font.line_height(font.mono16()), 22, "the monospace face's at 16")
  word_is(font.ascent(font.ui16()), 16, "the ink hangs from a 16-pixel ascent")
  check(font.advance(font.ui16(), 0) == 5 && font.words(font.ui16(), 0) == 0,
    "the space advances and has no ink")
  const a = font.glyph_of("A")
  const s = font.ui16()
  check(font.advance(s, a) == 11 && font.gleft(s, a) == 0 && font.gtop(s, a) == 4,
    "a capital's advance and its ink's offsets")
  check(font.gw(s, a) == 11 && font.gh(s, a) == 12, "and its ink's size")
  word_is(font.pixel(s, a, 0), 0, "its row 0 starts clear")
  word_is(font.pixel(s, a, 4), 136, "its apex's shoulder is level 8")
  word_is(font.pixel(s, a, 5), 255, "its apex is whole")
  word_is(font.pixel(s, a, 79), 238, "its bar is level 14 where it begins")
  word_is(font.pixel(s, a, 131), 119, "its last pixel is level 7")
  word_is(font.gleft(s, font.glyph_of("j")), -1,
    "a descender's ink may start left of the pen")
  check(font.advance(font.mono16(), a) == 10
    && font.advance(font.mono16(), font.glyph_of("i")) == 10
    && font.advance(font.mono16(), font.glyph_of("W")) == 10,
    "the monospace face advances one cell for every glyph")
  check(font.advance(s, font.missing()) == 11 && font.gh(s, font.missing()) == 19,
    "the missing glyph is the face's own .notdef")
  extent_is(ui_fb.measure(ui.text("ab", ui.style()), -1), 19, 20,
    "a label measures to its glyphs' advances and the line box")
}

// ---- the pointer: the drawing's shape ---------------------------------

def pointer_checks() {
  word_is(pointer.width(), 12, "the arrow is twelve cells wide")
  word_is(pointer.height(), 17, "and seventeen tall")
  check(pointer.hot_x() == 0 && pointer.hot_y() == 0,
    "its hotspot is the tip, the top-left cell")
  var even = true
  for var r = 0; r < pointer.height(); r = r + 1 {
    if pointer.row(r).length() != pointer.width() {
      even = false
    }
  }
  check(even, "every row of the drawing is the width")
  check(pointer.row(0).substring(0, 1) == "#", "the tip is ink")
  check(pointer.row(2).substring(1, 1) == "o", "the body is paper")
  check(pointer.row(0).substring(1, 1) == ".", "and the rest of the first row is clear")
}

// ---- the scripted input ---------------------------------------------

def script_checks() {
  const s = ui_fb.script([4, 5])
  check(s.next() == (R.ok, 4), "the script hands back the first tag")
  check(s.next() == (R.ok, 5), "and the second")
  check(s.next() == (R.error, 0), "then says there is no more")
  check(s.next() == (R.error, 0), "and keeps saying it")
}

measure_checks()
clip_checks()
over_checks()
shape_checks()
font_checks()
pointer_checks()
script_checks()
