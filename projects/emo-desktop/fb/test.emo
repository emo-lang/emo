// The fb package's own test: the box model's arithmetic in pixels, the
// clip and blend verbs, and the hosted canvas as a `Surface`, checked
// as values rather than as bytes. Painting is what `golden/` pins byte
// for byte; here a rectangle that drifts fails with its numbers, and a
// pixel that drifts fails with its word.
//
//   emo run test.emo
//
// It is a module of the package, not a package of its own, so
// `emo check ui_fb.emo` checks it and `./check.sh` runs it.

def check(ok Bool, what String) {
  if ok {
    println("ok   ${what}")
  } else {
    raise Exception.new(message: "assertion failed: ${what}")
  }
}

def extent_is(e ui_fb.Extent, w Int64, h Int64, what String) {
  if e.w() == w && e.h() == h {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: measured ${e.w()}x${e.h()}, wanted ${w}x${h}")
  }
}

def rect_is(r ui_fb.Rect, x Int64, y Int64, w Int64, h Int64, what String) {
  if r.x() == x && r.y() == y && r.w() == w && r.h() == h {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: clipped to ${r.x()},${r.y()} ${r.w()}x${r.h()}, wanted ${x},${y} ${w}x${h}")
  }
}

def word_is(got Int64, want Int64, what String) {
  if got == want {
    check(true, what)
  } else {
    raise Exception.new(message: "${what}: got ${got}, wanted ${want}")
  }
}

// ---- measure: a label is glyph cells, a box is its children ---------

def padded() ui.Node {
  return ui.column([
    ui.text("ab", ui.style()),
    ui.text("c", ui.style())
  ], ui.style().with_padding(4.0).with_gap(2.0))
}

def paired() ui.Node {
  return ui.row([
    ui.button("a", 0, ui.style()),
    ui.button("b", 1, ui.style())
  ], ui.style().with_gap(8.0))
}

def measure_checks() {
  extent_is(ui_fb.measure(padded(), -1), 24, 42,
    "a column is its widest child plus padding, its children stacked a gap apart")
  extent_is(ui_fb.measure(paired(), -1), 88, 16,
    "a row lines its bracketed buttons up, one gap apart, one glyph row tall")
  extent_is(ui_fb.measure(ui.text_input("n", ui.style().with_width(40.0)), -1),
    40, 16, "a fixed width overrides the intrinsic one")
  extent_is(ui_fb.measure(ui.scroll([ui.text("x", ui.style())],
    ui.style().with_height(64.0)), -1), 8, 64,
    "a scroll is as tall as its viewport, as wide as its content")
  extent_is(ui_fb.measure(ui.spacer(ui.style()), -1), 0, 0,
    "a spacer measures to nothing")
}

// ---- clip: the rectangle that lands on the surface ------------------

def clip_checks() {
  rect_is(ui_fb.clip(2, 3, 4, 5, 10, 10), 2, 3, 4, 5,
    "a rectangle inside the bounds is itself")
  rect_is(ui_fb.clip(-4, 0, 10, 2, 10, 10), 0, 0, 6, 2,
    "crossing the left edge pulls the origin in and shortens the width")
  rect_is(ui_fb.clip(8, 0, 10, 2, 10, 10), 8, 0, 2, 2,
    "crossing the right edge shortens the width")
  rect_is(ui_fb.clip(0, -1, 2, 20, 10, 10), 0, 0, 2, 10,
    "crossing both the top and the bottom leaves the full height")
  rect_is(ui_fb.clip(12, 0, 4, 4, 10, 10), 12, 0, 0, 4,
    "a rectangle wholly outside clips to a zero width")
  rect_is(ui_fb.clip(-5, -5, 30, 30, 10, 10), 0, 0, 10, 10,
    "a rectangle around the bounds clips to the bounds")
}

// ---- over: one pixel of source-over, integer-exact --------------------

def over_checks() {
  word_is(ui_fb.over(0xFF123456, 0xFFFFFF), 0x123456,
    "full coverage is the source, top byte cleared")
  word_is(ui_fb.over(0x123456, 0xABCDEF), 0xABCDEF,
    "no coverage is the destination")
  word_is(ui_fb.over(0x80FF0000, 0x00FF00), 0x807F00,
    "half red over green mixes each channel, rounded to nearest")
  word_is(ui_fb.over(0x40000000, 0xFFFFFF), 0xBFBFBF,
    "a quarter of black over white is three-quarters white")
}

// ---- the canvas as a Surface ------------------------------------------

def canvas_checks() {
  const c = canvas.canvas(4, 3)
  c.fill(1, 1, 2, 1, 0x112233)
  check(c.at(1, 1) == 0x112233 && c.at(2, 1) == 0x112233,
    "fill stores the word over the rectangle")
  check(c.at(0, 1) == 0 && c.at(3, 1) == 0 && c.at(1, 0) == 0 && c.at(1, 2) == 0,
    "and nowhere around it")
  c.fill(0, 0, 1, 1, 0xFF445566)
  word_is(c.at(0, 0), 0x445566, "fill clears the coverage byte")
  c.fill(3, 2, 5, 5, 0xABCDEF)
  check(c.at(3, 2) == 0xABCDEF, "a fill past the edge lands what is inside")
  check(c.at(-1, 0) == 0 && c.at(0, -1) == 0 && c.at(4, 0) == 0 && c.at(0, 3) == 0,
    "a read off the surface answers 0")

  const b = canvas.canvas(2, 1)
  b.fill(0, 0, 2, 1, 0x00FF00)
  b.blend(0, 0, 1, 1, 0x80FF0000)
  word_is(b.at(0, 0), 0x807F00, "blend composites over what is there")
  word_is(b.at(1, 0), 0x00FF00, "and leaves the rest of the row alone")
  b.blend(1, 0, 1, 1, 0xFF123456)
  word_is(b.at(1, 0), 0x123456, "an opaque blend is a fill")
}

// ---- paint: the tree onto the surface, parents under children --------

def paint_checks() {
  const panel = canvas.canvas(24, 20)
  ui_fb.paint(ui.column([ui.text("a", ui.style())],
    ui.style().with_padding(2.0)), panel)
  check(panel.at(0, 0) == 0xD8D0C0 && panel.at(23, 19) == 0xD8D0C0,
    "a column paints its panel over the whole rectangle it was given")
  check(panel.at(2, 2) == 0x282830 && panel.at(9, 17) == 0x282830,
    "and its child's ink over the panel, inside the padding")
  check(panel.at(10, 2) == 0xD8D0C0 && panel.at(2, 18) == 0xD8D0C0,
    "the panel shows again past the child's extent")

  const centered = canvas.canvas(24, 16)
  ui_fb.paint(ui.column([ui.text("a", ui.style())],
    ui.style().with_align(ui.Align.center)), centered)
  check(centered.at(7, 0) == 0xD8D0C0 && centered.at(8, 0) == 0x282830
    && centered.at(15, 0) == 0x282830 && centered.at(16, 0) == 0xD8D0C0,
    "center places a narrower child in the middle of the column")

  const grown = canvas.canvas(8, 40)
  ui_fb.paint(ui.column([
    ui.text("a", ui.style()),
    ui.row([], ui.style().with_grow(true)),
    ui.text("b", ui.style())
  ], ui.style().with_align(ui.Align.stretch)), grown)
  check(grown.at(0, 15) == 0x282830 && grown.at(0, 16) == 0xC0C8D8
    && grown.at(0, 23) == 0xC0C8D8 && grown.at(0, 24) == 0x282830,
    "grow hands a child the column's leftover height")

  const spaced = canvas.canvas(8, 32)
  ui_fb.paint(ui.column([
    ui.text("a", ui.style()),
    ui.spacer(ui.style().with_grow(true))
  ], ui.style()), spaced)
  check(spaced.at(0, 16) == 0xD8D0C0 && spaced.at(7, 31) == 0xD8D0C0,
    "a spacer paints nothing, so the panel shows through it")

  const small = canvas.canvas(8, 8)
  ui_fb.paint(ui.text("abc", ui.style()), small)
  check(small.at(0, 0) == 0x282830 && small.at(7, 7) == 0x282830,
    "a leaf larger than the surface is clipped to it")
}

// ---- ppm: the surface as text ----------------------------------------

def ppm_checks() {
  const c = canvas.canvas(2, 1)
  c.fill(0, 0, 1, 1, 0xFF8040)
  check(ui_fb.ppm(c) == "P3\n2 1\n255\n255 128 64\n0 0 0\n",
    "ppm is the P3 header and one pixel per line")
}

// ---- the scripted input ---------------------------------------------

def script_checks() {
  const s = ui_fb.script([4, 5])
  check(s.next() == (R.ok, 4), "the script hands back the first tag")
  check(s.next() == (R.ok, 5), "and the second")
  check(s.next() == (R.error, 0), "then says there is no more")
  check(s.next() == (R.error, 0), "and keeps saying it")
}

// ---- the backend: mount paints, every event repaints ----------------
//
// The smallest loop that can show a repaint: one message, a model that
// is the width of the title, and a view whose ink doubles when it flips.
// The button carries the tag; the script presses it once.

enum Msg { widen }

def view(reg ui.Registry, wide Bool) ui.Node {
  const widen = reg.on(Msg.widen)
  const title = if wide { "ab" } else { "a" }
  return ui.column([
    ui.text(title, ui.style()),
    ui.button("w", widen, ui.style())
  ], ui.style())
}

def update(msg Msg, wide Bool) Bool {
  return true
}

def backend_checks() {
  const c = canvas.canvas(24, 32)
  ui.run(view, update, false, ui_fb.backend(c, ui_fb.script([0])))
  check(c.at(7, 0) == 0x282830 && c.at(15, 0) == 0x282830
    && c.at(16, 0) == 0xD8D0C0 && c.at(0, 16) == 0x7088A8,
    "the backend paints on mount and repaints the event's tree")
}

measure_checks()
clip_checks()
over_checks()
canvas_checks()
paint_checks()
ppm_checks()
script_checks()
backend_checks()
