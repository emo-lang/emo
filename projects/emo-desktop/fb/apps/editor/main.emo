require "syscall"
require "emo/ui"
require "emo/ui_fb"
require "emo/ui_apps"
require "emo/ui_fb_win"
require "emo/ui_fb_winbuf"

// The editor as its own program (emo-desktop A11.1): the app's image
// is a disk ELF the desktop's parent execs by name — the kernel reads
// the volume through the filesystem service, loads the image into a
// run of its own, builds this process's table off its own segments,
// and enters it here. The session is the one the boot image's pass ran
// (A10.3): a window of its own, the loop over the window buffer's
// surface, the printable keys inserting at the caret, Backspace and
// Delete erasing beside it, the arrows and Home/End moving it, Enter
// stepping the rows — `Ctrl+C`/`Ctrl+X` copy and cut the caret's row
// and `Ctrl+V` pastes through the machine's clipboard (M34), `Ctrl+S`
// saves and `Ctrl+Q` ends the loop (A33.1), the window closed behind
// it, the exit answering the parent's wait (`app editor 0`).

// The interface strike, built once at boot: the Inter face at 16
// pixels — the window's bar and the app's own labels draw in it.
def strike() (R, ui_fb.raster.Strike) {
  return ui_fb.raster.strike(ui_fb.raster.inter(), 16)
}

// The session's scratch, in this image's own writable segment (the
// window buffer package's page, its line helpers' home): the save's
// name, its words and the two rows ride here, because the gate's verbs
// take raw addresses and an app holds no other writable page.
const buf = 0x87200000

// One String into the scratch, the bytes copied and counted (the
// riscv64 String-to-bytes path, `to_bytes`, read one byte at a time).
def poke_str(s String, at Int64) Int64 {
  const b = s.to_bytes()
  var i = 0
  while i < b.length() {
    poke8(at + i, b.get(i).to_byte())
    i = i + 1
  }
  return b.length()
}

// The save (emo-desktop M25): the buffer's rows whole onto the volume
// as editor.txt, the rows' own line breaks between them, then the
// raise that tells the shell. The write is the condition (a refused
// volume raises nothing — absence visible, D15); the notification's
// title names the app and its body the save's own words.
def editor_save(rows Array[String]) Void {
  const nl = poke_str("editor.txt", buf + 4096)
  poke_str("editor", buf + 4128)
  poke_str("editor.txt saved", buf + 4160)
  var n = 0
  var i = 0
  while i < rows.length() {
    if i > 0 {
      poke8(buf + 4224 + n, 10B)
      n = n + 1
    }
    n = n + poke_str(rows[i], buf + 4224 + n)
    i = i + 1
  }
  case syscall.file_write(buf + 4096, nl, buf + 4224, n) {
    (R.error, _) then {}
    (R.ok, _) then {
      case syscall.notify(buf + 4128, 6, buf + 4160, 16) {
        (R.error, _) then {}
        (R.ok, _) then {}
      }
    }
  }
}

// The saver the corpus's update hands the buffer to (D14): the one
// consumer of the seam that speaks the gate.
class EditorSaver {
  def save(rows Array[String]) Void {
    editor_save(rows)
  }
}

def editor_saver() EditorSaver {
  return EditorSaver.new()
}

// The clipboard's metal side (emo-desktop M34): the gate's two verbs
// over this image's scratch — the copy pokes the row into the buffer
// and hands the gate its bytes; the paste asks for as many as fit and
// reads them back as a String (the notification feed's own path).
// The cap is the app's own: the corpus's row bound makes a longer
// paste a refusal anyway.
const clip_buf = buf + 8192
const clip_cap = 1024

def scratch_str(at Int64, n Int64) String {
  const b = Bytes.new(n)
  var i = 0
  while i < n {
    b.set(i, peek8(at + i).to_int64())
    i = i + 1
  }
  return b.to_string()
}

class MetalClip {
  def copy(s String) Void {
    const n = poke_str(s, clip_buf)
    case syscall.clip_set(clip_buf, n) {
      (R.error, _) then { ui_fb_winbuf.mark() }
      (R.ok, _) then {}
    }
  }

  def paste() String {
    const answer = syscall.clip_get(clip_buf, clip_cap)
    case answer {
      (R.error, _) then { ui_fb_winbuf.mark() }
      (R.ok, n) then {
        if n > 0 {
          return scratch_str(clip_buf, n)
        }
      }
    }
    return ""
  }
}

def metal_clip() MetalClip {
  return MetalClip.new()
}

def main() {
  const holder = ArrayBuilder.new()
  case strike() {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, s) then { holder.push(s) }
  }
  const fs = holder.get(0)
  var ge = 0
  var base_e = 0
  case syscall.win_new(384, 128) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, ans) then {
      ge = ans & 4294967295
      base_e = (ans >> 32) << 12
    }
  }
  case syscall.win_role(ge, 0) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, _) then {}
  }
  // the window's place derives from the mode (emo-desktop A14.3): the
  // lower-left quadrant, under the browser's
  var mw = 0
  var mh = 0
  case syscall.output_info(0) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, m) then {
    mw = m >> 32
    mh = m & 4294967295
  }
  }
  // the seat and the rise's start (emo-desktop A15.2): a quarter of
  // the window low, the rise easing it home
  var fx = (mw - 384) / 4 - 10
  var fy = (mh - 128) / 2
  case syscall.win_move(ge, fx, fy + 128 / 4) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, _) then {}
  }
  // the mount takes the focus (emo-desktop A11.2): the newest window
  // up is the one the stream's keys serve until a click names another
  case syscall.win_focus(ge) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, _) then {}
  }
  const we = ui_fb_winbuf.win(ge, base_e, 384, 128)
  const ch = ui_fb_win.chrome(we, fs, "editor")
  // the landing frame the app's own hand paints — the mount's tree,
  // the same walk, on the wire low (emo-desktop A15.2)
  const reg0 = ui.Registry.new()
  ui_fb.paint(ui_apps.editor.view(reg0, ui_apps.editor.initial()), ch, fs)
  we.present()
  we.rise(fx, fy)
  // the raw seat's keys are the editor's messages (A33.1): a printable
  // byte inserts, the arrows and the editing keys move and erase,
  // `Ctrl+S` saves, `Ctrl+Q` ends the loop — no tag table between
  ui.run_raw(ui_apps.editor.view, ui_apps.editor.update,
    ui_apps.editor.initial_with(editor_saver(), metal_clip()),
    ui_fb.backend(ch, ui_fb_winbuf.keys_raw(we, fs, fx, fy, mw, mh), fs))
  we.sink(fx, fy)
  case syscall.win_close(ge) {
    (R.error, _) then { ui_fb_winbuf.mark() }
    (R.ok, _) then {}
  }
  syscall.exit(0)
}

main()
