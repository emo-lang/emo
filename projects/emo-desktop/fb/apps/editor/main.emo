require "syscall"
require "emo/ui"
require "emo/ui_fb"
require "emo/ui_apps"
require "emo/ui_fb_win"
require "emo/ui_fb_winbuf"

// The editor as its own program (emo-desktop A11.1): the app's image
// is a disk ELF the desktop's parent execs by name — the kernel reads
// the volume through the filesystem service, loads the image into a
// run of its own, builds this process's table off its own segments,
// and enters it here. The session is the one the boot image's pass ran
// (A10.3): a window of its own, the loop over the window buffer's
// surface, the puts typing into the cursor's row and the newline
// moving it — the quit key ends the loop, the window closed behind it,
// the exit answering the parent's wait (`app editor 0`).

// The interface strike, built once at boot: the Inter face at 16
// pixels — the window's bar and the app's own labels draw in it.
def strike() (R, ui_fb.raster.Strike) {
  return ui_fb.raster.strike(ui_fb.raster.inter(), 16)
}

// The session's scratch, in this image's own writable segment (the
// window buffer package's page, its line helpers' home): the save's
// name, its words and the two rows ride here, because the gate's verbs
// take raw addresses and an app holds no other writable page.
const buf = 0x87200000

// One String into the scratch, the bytes copied and counted (the
// riscv64 String-to-bytes path, `to_bytes`, read one byte at a time).
def poke_str(s String, at Int64) Int64 {
  const b = s.to_bytes()
  var i = 0
  while i < b.length() {
    poke8(at + i, b.get(i).to_byte())
    i = i + 1
  }
  return b.length()
}

// The save (emo-desktop M25): the buffer's two rows whole onto the
// volume as editor.txt, then the raise that tells the shell. The write
// is the condition (a refused volume raises nothing — absence visible,
// D15); the notification's title names the app and its body the save's
// own words.
def editor_save(r0 String, r1 String) Void {
  const nl = poke_str("editor.txt", buf + 4096)
  poke_str("editor", buf + 4128)
  poke_str("editor.txt saved", buf + 4160)
  var n = poke_str(r0, buf + 4224)
  n = n + poke_str(r1, buf + 4224 + n)
  case syscall.file_write(buf + 4096, nl, buf + 4224, n) {
    (R.error, _) -> {}
    (R.ok, _) -> {
      case syscall.notify(buf + 4128, 6, buf + 4160, 16) {
        (R.error, _) -> {}
        (R.ok, _) -> {}
      }
    }
  }
}

// The saver the corpus's update hands the buffer to (D14): the one
// consumer of the seam that speaks the gate.
class EditorSaver {
  def save(rows Array[String]) Void {
    editor_save(rows[0], rows[1])
  }
}

def editor_saver() EditorSaver {
  return EditorSaver.new()
}

def main() {
  const holder = ArrayBuilder.new()
  case strike() {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, s) -> { holder.push(s) }
  }
  const fs = holder.get(0)
  var ge = 0
  var base_e = 0
  case syscall.win_new(384, 128) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, ans) -> {
      ge = ans & 4294967295
      base_e = (ans >> 32) << 12
    }
  }
  case syscall.win_role(ge, 0) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, _) -> {}
  }
  // the window's place derives from the mode (emo-desktop A14.3): the
  // lower-left quadrant, under the browser's
  var mw = 0
  var mh = 0
  case syscall.output_info(0) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, m) -> {
    mw = m >> 32
    mh = m & 4294967295
  }
  }
  // the seat and the rise's start (emo-desktop A15.2): a quarter of
  // the window low, the rise easing it home
  var fx = (mw - 384) / 4 - 10
  var fy = (mh - 128) / 2
  case syscall.win_move(ge, fx, fy + 128 / 4) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, _) -> {}
  }
  // the mount takes the focus (emo-desktop A11.2): the newest window
  // up is the one the stream's keys serve until a click names another
  case syscall.win_focus(ge) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, _) -> {}
  }
  const we = ui_fb_winbuf.win(ge, base_e, 384, 128)
  const ch = ui_fb_win.chrome(we, fs, "editor")
  // the landing frame the app's own hand paints — the mount's tree,
  // the same walk, on the wire low (emo-desktop A15.2)
  const reg0 = ui.Registry.new()
  ui_fb.paint(ui_apps.editor.view(reg0, ui_apps.editor.initial()), ch, fs)
  we.present()
  we.rise(fx, fy)
  ui.run(ui_apps.editor.view, ui_apps.editor.update,
    ui_apps.editor.initial_with(editor_saver()),
    ui_fb.backend(ch, ui_fb_winbuf.keys([97, 98, 10, 115], we, fs, fx, fy, mw, mh), fs))
  we.sink(fx, fy)
  case syscall.win_close(ge) {
    (R.error, _) -> { ui_fb_winbuf.mark() }
    (R.ok, _) -> {}
  }
  syscall.exit(0)
}

main()
