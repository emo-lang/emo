require "emo/ui"

// The third of the desktop's apps (emo-desktop A10.3): the editor, a
// corpus package of its own — the same discipline the counter and the
// browser carry, portable defs and nothing platform-naming. The buffer
// is the model's two rows of text, `put_a` and `put_b` type into the
// row the cursor is on, `newline` moves the cursor down and stops at
// the buffer's end, and the status names the cursor's row. `update`
// says each transition, and the tags register in the view's own order
// — put_a, put_b, newline, tags 0, 1 and 2 on every run.
//
// The app dual-runs where hosted: the hosted families through
// `apps/golden/`, the metal in a pass of its own (the `a`/`b` keys and
// the newline byte the pass maps onto the tags, `q` the loop's end).
// The tree is the panel, one text per row and the status — four nodes,
// the buffer the golden session leaves shortest — and the session
// three events, the pass's 128 KiB arena green (A8.3's per-event
// count).

enum Msg { put_a, put_b, newline }

class Model {
  def init(rows Array[String], row Int64) {
    self.rows = rows
    self.row = row
  }

  def rows() Array[String] {
    return self.rows
  }

  def row() Int64 {
    return self.row
  }
}

def initial() Model {
  return Model.new(rows: ["", ""], row: 0)
}

// The buffer with `s` typed into the row the cursor is on: a new rows
// array, the cursor's row grown, the other carried — the model's value
// discipline, the before never touched. A literal of the buffer's own
// two-row shape — the metal lowers no `ArrayBuilder` (A10.3's
// found-not-fixed), and the buffer is fixed data.
def typed(m Model, s String) Model {
  if m.row() == 0 {
    return Model.new(rows: [m.rows()[0] + s, m.rows()[1]], row: 0)
  }
  return Model.new(rows: [m.rows()[0], m.rows()[1] + s], row: 1)
}

def update(msg Msg, m Model) Model {
  if msg == Msg.put_a {
    println("put a")
    return typed(m, "a")
  }
  if msg == Msg.put_b {
    println("put b")
    return typed(m, "b")
  }
  println("newline")
  var r = m.row() + 1
  if r >= m.rows().length() {
    r = m.rows().length() - 1
  }
  return Model.new(rows: m.rows(), row: r)
}

def view(reg ui.Registry, m Model) ui.Node {
  // The tags are taken in statements of their own: `on` is a side
  // effect, and this registration order is what fixes put_a, put_b
  // and newline at tags 0, 1 and 2 on every run.
  const put_a = reg.on(Msg.put_a)
  const put_b = reg.on(Msg.put_b)
  const newline = reg.on(Msg.newline)
  return ui.column([
    ui.text(m.rows()[0], ui.style()),
    ui.text(m.rows()[1], ui.style()),
    ui.text("row ${m.row()}", ui.style())
  ], ui.style().with_padding(12.0).with_gap(8.0))
}
