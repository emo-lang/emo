require "emo/ui"

// The third of the desktop's apps (emo-desktop A10.3): the editor, a
// corpus package of its own — the same discipline the counter and the
// browser carry, portable defs and nothing platform-naming. The buffer
// is the model's rows and a cursor of (row, column): a printable key
// inserts at the cursor, Backspace and Delete remove the byte before
// the caret or under it (joining the neighbouring row at either edge),
// the arrows, Home and End move it, and Enter steps it to the next row
// and stops at the buffer's last. Every edit is a new model — the
// rows' value discipline, the before never touched — and the caret is
// the view's: `|` inked between the row's bytes, never in the buffer.
// `update` says each transition (`put a`, `back`, `del`, `left`,
// `right`, `up`, `down`, `home`, `end`, `newline`, `save`, `copy`,
// `cut`, `paste`) and hands the save's buffer to the provider.
//
// The app dual-runs where hosted: the hosted families through
// `apps/golden/`, each key the script's own number; the metal in a
// pass of its own, the seat's raw mode delivering the same numbers
// (see `emo/ui`'s key vocabulary) and `Ctrl+Q` the loop's end. The
// tree is the panel, one text per row and the status — the rows the
// buffer has, at least one, at most the two it starts with — and the
// session's keys leave the pass's arena green (A8.3's per-event
// count).
//
// The save (emo-desktop M25, D14): the corpus stays portable — the
// volume is the metal's — so the act leaves through a provider the
// consumer hands in, the way the notification center's feed does. The
// hosted golden's saver is the quiet one; the metal editor's speaks the
// gate's write and notify verbs. `update` says `save` and hands the
// buffer over; what saving means is the provider's.
//
// The clipboard (emo-desktop M34, D19): the buffer is the machine's —
// one page the gate copies through, shared by every app — so the
// acts leave through a second provider, the Clipper: copy hands it the
// row, paste asks it for the clipboard's text. Without a selection
// (A3's, still ahead) the acts are the caret's row whole: copy takes
// it, cut takes and clears it, paste inserts at the caret. The hosted
// golden's clipper is the quiet one (a `Box` behind the seam, so the
// session's copy and paste still agree); the metal's speaks the gate's
// two verbs.

// The chords, the bytes a Ctrl chord produces: the core's vocabulary
// carries the keys' meanings, and these are the app's — `Ctrl+C`,
// `Ctrl+X`, `Ctrl+V` and the save's `Ctrl+S`.
const key_copy = 3
const key_cut = 24
const key_paste = 22
const key_save = 19

// The buffer's one line bound: the window is 384 pixels wide at the
// interface face's advance, and a row that outgrows it would clip at
// the surface's edge — the bound is the frame's own arithmetic, kept
// strict so a full row refuses the next byte rather than painting past
// the glass.
def line_cap() Int64 {
  return 40
}

// Where the editor's words go on save. `rows` is the buffer as it
// stands: the rows the model holds.
interface Saver {
  def save(rows Array[String]) Void
}

// The quiet saver: the hosted golden's feeder — the act is recorded on
// the transcript alone.
class Quiet {
  def save(rows Array[String]) Void {}
}

def quiet() Quiet {
  return Quiet.new()
}

// The clipboard's two acts as the corpus sees them: copy hands the
// row over, paste asks for the text. The store is the provider's —
// a page in the kernel on the metal, a `Box` in the hosted golden —
// and the app never learns which.
interface Clipper {
  def copy(s String) Void
  def paste() String
}

// The quiet clipper: the hosted golden's feeder — the text kept in a
// `Box`, so the session's paste returns what its copy handed over.
class QuietClip {
  def init() {
    self.text = Box.new("")
  }

  def copy(s String) Void {
    self.text.replace(s)
  }

  def paste() String {
    return self.text.read()
  }
}

def quiet_clip() QuietClip {
  return QuietClip.new()
}

class Model {
  def init(rows Array[String], row Int64, col Int64, saver Saver,
           clipper Clipper) {
    self.rows = rows
    self.row = row
    self.col = col
    self.saver = saver
    self.clipper = clipper
  }

  def saver() Saver {
    return self.saver
  }

  def clipper() Clipper {
    return self.clipper
  }

  def rows() Array[String] {
    return self.rows
  }

  def row() Int64 {
    return self.row
  }

  def col() Int64 {
    return self.col
  }
}

def initial() Model {
  return initial_with(quiet(), quiet_clip())
}

// The same start with the acts' providers in hand — the metal editor's
// door (the hosted golden takes `initial`).
def initial_with(saver Saver, clipper Clipper) Model {
  return Model.new(rows: ["", ""], row: 0, col: 0, saver: saver,
    clipper: clipper)
}

// The buffer's `at`th row replaced: a builder, because the rows array
// grows and shrinks through the editing and an array's length never
// changes.
def rows_with(rows Array[String], at Int64, s String) Array[String] {
  const out = ArrayBuilder.new()
  var i = 0
  while i < rows.length() {
    if i == at {
      out.push(s)
    } else {
      out.push(rows[i])
    }
    i = i + 1
  }
  return out.to_array()
}

def rows_cut(rows Array[String], at Int64) Array[String] {
  const out = ArrayBuilder.new()
  var i = 0
  while i < rows.length() {
    if i != at {
      out.push(rows[i])
    }
    i = i + 1
  }
  return out.to_array()
}

// One printable byte as its one-character String: the byte buffer's
// reinterpretation, the same path the notification feed reads its
// strings through.
def char_of(b Int64) String {
  const one = Bytes.new(1)
  one.set(0, b)
  return one.to_string()
}

// A row with its caret: the current row's bytes either side of the
// ink, every other row as it stands. The buffer never carries the
// caret — a save writes what the user typed.
def shown_row(m Model, i Int64) String {
  const r = m.rows()[i]
  if i != m.row() {
    return r
  }
  return r.substring(0, m.col()) + "|" +
    r.substring(m.col(), r.length() - m.col())
}

// The insertion at the caret; a row already at the bound refuses it.
def inserted(m Model, s String) Model {
  const r = m.rows()[m.row()]
  if r.length() + s.length() > line_cap() {
    return m
  }
  const next = r.substring(0, m.col()) + s +
    r.substring(m.col(), r.length() - m.col())
  return Model.new(rows: rows_with(m.rows(), m.row(), next), row: m.row(),
    col: m.col() + s.length(), saver: m.saver(), clipper: m.clipper())
}

// Backspace: the byte before the caret, or — at the row's head — the
// join with the row above, the caret landing where the two met.
def backspaced(m Model) Model {
  const r = m.rows()[m.row()]
  if m.col() > 0 {
    const next = r.substring(0, m.col() - 1) +
      r.substring(m.col(), r.length() - m.col())
    return Model.new(rows: rows_with(m.rows(), m.row(), next), row: m.row(),
      col: m.col() - 1, saver: m.saver(), clipper: m.clipper())
  }
  if m.row() > 0 {
    const prev = m.rows()[m.row() - 1]
    const joined = rows_with(m.rows(), m.row() - 1, prev + r)
    return Model.new(rows: rows_cut(joined, m.row()), row: m.row() - 1,
      col: prev.length(), saver: m.saver(), clipper: m.clipper())
  }
  return m
}

// Delete: the byte under the caret, or — at the row's end — the join
// with the row below, the caret staying where it is.
def deleted(m Model) Model {
  const r = m.rows()[m.row()]
  if m.col() < r.length() {
    const next = r.substring(0, m.col()) +
      r.substring(m.col() + 1, r.length() - m.col() - 1)
    return Model.new(rows: rows_with(m.rows(), m.row(), next), row: m.row(),
      col: m.col(), saver: m.saver(), clipper: m.clipper())
  }
  if m.row() < m.rows().length() - 1 {
    const joined = rows_with(m.rows(), m.row(), r + m.rows()[m.row() + 1])
    return Model.new(rows: rows_cut(joined, m.row() + 1), row: m.row(),
      col: m.col(), saver: m.saver(), clipper: m.clipper())
  }
  return m
}

// The caret's moves: within the row, across the rows' seams for the
// horizontal pair, and clamped to the target row's length for the
// vertical pair (the caret keeps its column from row to row where it
// can, the editor convention).
def moved(m Model, row Int64, col Int64) Model {
  var c = col
  const len = m.rows()[row].length()
  if c > len {
    c = len
  }
  return Model.new(rows: m.rows(), row: row, col: c, saver: m.saver(),
    clipper: m.clipper())
}

def left(m Model) Model {
  if m.col() > 0 {
    return moved(m, m.row(), m.col() - 1)
  }
  if m.row() > 0 {
    return moved(m, m.row() - 1, m.rows()[m.row() - 1].length())
  }
  return m
}

def right(m Model) Model {
  if m.col() < m.rows()[m.row()].length() {
    return moved(m, m.row(), m.col() + 1)
  }
  if m.row() < m.rows().length() - 1 {
    return moved(m, m.row() + 1, 0)
  }
  return m
}

def up(m Model) Model {
  if m.row() > 0 {
    return moved(m, m.row() - 1, m.col())
  }
  return m
}

def down(m Model) Model {
  if m.row() < m.rows().length() - 1 {
    return moved(m, m.row() + 1, m.col())
  }
  return m
}

// The clipboard's acts, the caret's row whole until the selection
// narrows them (A3): copy hands the row over, cut hands it over and
// leaves the row empty with the caret at its head, paste inserts what
// the clipboard holds. An empty paste is the no-op the empty string
// spells — the model itself, no allocation.
def copied(m Model) Model {
  m.clipper().copy(m.rows()[m.row()])
  return m
}

def cut(m Model) Model {
  const r = m.rows()[m.row()]
  m.clipper().copy(r)
  return Model.new(rows: rows_with(m.rows(), m.row(), ""), row: m.row(),
    col: 0, saver: m.saver(), clipper: m.clipper())
}

def pasted(m Model) Model {
  const s = m.clipper().paste()
  if s.length() == 0 {
    return m
  }
  return inserted(m, s)
}

def update(key Int64, m Model) Model {
  if key == key_save {
    println("save")
    m.saver().save(m.rows())
    return m
  }
  if key == key_copy {
    println("copy")
    return copied(m)
  }
  if key == key_cut {
    println("cut")
    return cut(m)
  }
  if key == key_paste {
    println("paste")
    return pasted(m)
  }
  if key == ui.key_enter() {
    println("newline")
    return down(m)
  }
  if key == ui.key_backspace() {
    println("back")
    return backspaced(m)
  }
  if key == ui.key_delete() {
    println("del")
    return deleted(m)
  }
  if key == ui.key_left() {
    println("left")
    return left(m)
  }
  if key == ui.key_right() {
    println("right")
    return right(m)
  }
  if key == ui.key_up() {
    println("up")
    return up(m)
  }
  if key == ui.key_down() {
    println("down")
    return down(m)
  }
  if key == ui.key_home() {
    println("home")
    return moved(m, m.row(), 0)
  }
  if key == ui.key_end() {
    println("end")
    return moved(m, m.row(), m.rows()[m.row()].length())
  }
  if key >= 32 && key <= 126 {
    const s = char_of(key)
    println("put ${s}")
    return inserted(m, s)
  }
  return m
}

def view(reg ui.Registry, m Model) ui.Node {
  const kids = ArrayBuilder.new()
  var i = 0
  while i < m.rows().length() {
    kids.push(ui.text(shown_row(m, i), ui.style()))
    i = i + 1
  }
  kids.push(ui.text("row ${m.row()} col ${m.col()}", ui.style()))
  return ui.column(kids.to_array(),
    ui.style().with_padding(12.0).with_gap(8.0))
}
