require "emo/engine"
require "emo/record"
require "emo/rocksdb"
require "file"
require "os"

// emo-db's SQL corpus runner (M34): the corpus files in `../corpus/`
// are the engine's surface stated as data, and this program is the
// only code. Each invocation destroys and reopens one database, then
// executes every file named on the command line in order — the files
// share the database deliberately (ddl creates, the rest use).
//
// A corpus record is a header line, the statement's lines, and an
// optional `----` with the expectation:
//
//   statement ok        the statement succeeds; after `----`, the
//                       command tag to match (optional)
//   statement error     the statement fails; after `----`, the exact
//                       `code: message` string
//   query               the statement returns rows; after `----`, one
//                       `|`-separated row per line (NULL as NULL,
//                       booleans true/false, BYTEA 0x-hex)
//
// A blank line ends a record. Failures print and count but do not stop
// the run; the summary is one line per file and one total, and a
// nonzero failure count raises at the end.

const db_path = ".emo-build/corpus-db"

def hex(b Bytes) String {
  const digits = "0123456789abcdef"
  var out = ""
  var i = 0
  while i < b.length() {
    const v = b.get(i)
    out = out + digits.substring(v >> 4, 1) + digits.substring(v & 15, 1)
    i = i + 1
  }
  return out
}

def show(value record.Value) String {
  if value.is_null {
    return "NULL"
  }
  case value.kind {
    record.ColType.integer -> { return value.as_i64().to_string() }
    record.ColType.bigint -> { return value.as_i64().to_string() }
    record.ColType.real -> { return value.as_f64().to_string() }
    record.ColType.double -> { return value.as_f64().to_string() }
    record.ColType.text -> { return value.as_text() }
    record.ColType.varchar -> { return value.as_text() }
    record.ColType.boolean -> { return value.as_bool().to_string() }
    record.ColType.bytea -> { return "0x" + hex(value.as_bytes()) }
  }
}

def show_row(values Array[record.Value]) String {
  var out = ""
  var i = 0
  while i < values.length() {
    if i > 0 {
      out = out + "|"
    }
    out = out + show(values[i])
    i = i + 1
  }
  return out
}

def base_name(path String) String {
  const parts = path.split("/")
  return parts[parts.length() - 1]
}

def main() {
  const argv = os.argv()
  case rocksdb.destroy_db(db_path) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, _) -> {}
  }
  case engine.open(db_path) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, eng) -> {
      var total = 0
      var failed = 0
      var f = 1
      while f < argv.length() {
        case file.read(argv[f]) {
          (R.error, why) -> {
            println("FAIL " + base_name(argv[f]) + ": " + why)
            total = total + 1
            failed = failed + 1
          }
          (R.ok, text) -> {
            const counts = run_file(eng, base_name(argv[f]), text)
            println(base_name(argv[f]) + " " + counts[0].to_string() + " cases")
            total = total + counts[0]
            failed = failed + counts[1]
          }
        }
        f = f + 1
      }
      println("cases " + total.to_string() + ", failed " + failed.to_string())
      eng.close()
      if failed > 0 {
        raise Exception.new(message: "corpus: " + failed.to_string() + " cases failed")
      }
    }
  }
}

def run_file(eng engine.Engine, name String, text String) (Int64, Int64) {
  const lines = text.split("\n")
  var i = 0
  var cases = 0
  var failed = 0
  while i < lines.length() {
    const at = i + 1
    const line = lines[i].trim()
    if line == "" || line.starts_with("#") {
      i = i + 1
    } else {
      var kind = ""
      if line == "statement ok" {
        kind = "ok"
      } else {
        if line == "statement error" {
          kind = "error"
        } else {
          if line == "query" {
            kind = "query"
          }
        }
      }
      if kind == "" {
        println("FAIL " + name + ":" + at.to_string() + ": unknown directive `" + line + "`")
        cases = cases + 1
        failed = failed + 1
        i = i + 1
      } else {
        i = i + 1
        var sql_lines = []
        while i < lines.length() && lines[i].trim() != "" && lines[i].trim() != "----" {
          sql_lines = sql_lines.append(lines[i])
          i = i + 1
        }
        var expected = []
        if i < lines.length() && lines[i].trim() == "----" {
          i = i + 1
          while i < lines.length() && lines[i].trim() != "" {
            expected = expected.append(lines[i])
            i = i + 1
          }
        }
        if sql_lines.length() == 0 {
          println("FAIL " + name + ":" + at.to_string() + ": no SQL")
          cases = cases + 1
          failed = failed + 1
        } else {
          const sql = join_lines(sql_lines)
          case run_case(eng, kind, sql, expected) {
            (R.error, why) -> {
              println("FAIL " + name + ":" + at.to_string() + ": " + why)
              cases = cases + 1
              failed = failed + 1
            }
            (R.ok, _) -> { cases = cases + 1 }
          }
        }
      }
    }
  }
  return (cases, failed)
}

def join_lines(xs Array[String]) String {
  var out = ""
  var i = 0
  while i < xs.length() {
    if i > 0 {
      out = out + "\n"
    }
    out = out + xs[i]
    i = i + 1
  }
  return out
}

def run_case(eng engine.Engine, kind String, sql String, expected Array[String]) (R, Bool) {
  case eng.execute(sql) {
    (R.error, why) -> {
      if kind == "error" {
        if expected.length() == 0 {
          return (R.error, "statement error needs a `----` expectation")
        }
        if why == expected[0].trim() {
          return (R.ok, true)
        }
        return (R.error, "expected error \"" + expected[0].trim() + "\", got \"" + why + "\"")
      }
      return (R.error, "unexpected error: " + why)
    }
    (R.ok, result) -> {
      if kind == "error" {
        return (R.error, "expected an error, got " + result.tag)
      }
      if kind == "ok" {
        if expected.length() > 0 && result.tag != expected[0].trim() {
          return (R.error, "expected tag \"" + expected[0].trim() + "\", got \"" + result.tag + "\"")
        }
        return (R.ok, true)
      }
      var rows = []
      var i = 0
      while i < result.rows.length() {
        rows = rows.append(show_row(result.rows[i]))
        i = i + 1
      }
      if expected.length() != rows.length() {
        return (R.error, "expected " + expected.length().to_string() + " rows, got " + rows.length().to_string())
      }
      var k = 0
      while k < expected.length() {
        if rows[k] != expected[k] {
          return (R.error, "row " + (k + 1).to_string() + ": expected \"" + expected[k] + "\", got \"" + rows[k] + "\"")
        }
        k = k + 1
      }
      return (R.ok, true)
    }
  }
}

main()
