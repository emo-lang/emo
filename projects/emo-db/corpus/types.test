# The v0 type subset: every column kind, NULLs, integer and float
# boundaries, UTF-8 text, the VARCHAR code-point count, and the
# coercion refusals.

statement ok
CREATE TABLE typed (
  i INTEGER,
  b BIGINT,
  r REAL,
  d DOUBLE PRECISION,
  t TEXT,
  v VARCHAR(5),
  f BOOLEAN,
  y BYTEA
)
----
CREATE TABLE

