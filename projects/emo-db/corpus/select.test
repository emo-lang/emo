# SELECT: projections, aliases, WHERE's expression grammar, the
# equality index scan (same rows as a scan), three-valued NULL logic,
# and the refusals.

statement ok
CREATE TABLE people (
  id BIGINT NOT NULL PRIMARY KEY,
  name TEXT,
  age INTEGER,
  active BOOLEAN,
  score DOUBLE PRECISION
)
----
CREATE TABLE

statement ok
INSERT INTO people (id, name, age, active, score) VALUES (1, 'Ada', 36, TRUE, 99.5), (2, 'Grace', NULL, FALSE, NULL), (3, 'Linus', 54, TRUE, 88.0), (4, 'Alan', 41, NULL, NULL)
----
INSERT 0 4

query
SELECT * FROM people
----
1|Ada|36|true|99.5
2|Grace|NULL|false|NULL
3|Linus|54|true|88.0
4|Alan|41|NULL|NULL

query
SELECT name AS who, age FROM people WHERE id = 1
----
Ada|36

query
SELECT id, name FROM people WHERE age >= 40
----
3|Linus
4|Alan

query
SELECT id FROM people WHERE name = 'Ada'
----
1

query
SELECT id FROM people WHERE active = TRUE
----
1
3

query
SELECT id FROM people WHERE age IS NULL
----
2

query
SELECT id FROM people WHERE active IS NOT FALSE
----
1
3
4

query
SELECT id FROM people WHERE name LIKE 'A%'
----
1
4

query
SELECT id FROM people WHERE age IN (36, 54)
----
1
3

query
SELECT id FROM people WHERE age BETWEEN 30 AND 50
----
1
4

query
SELECT id FROM people WHERE NOT active
----
2

query
SELECT id, age + 1, age * 2, name || '!' FROM people WHERE id = 1
----
1|37|72|Ada!

query
SELECT id FROM people WHERE age IS NOT NULL AND age > 35
----
1
3
4

query
SELECT id FROM people WHERE id = 999
----

query
SELECT p.id, p.name FROM people AS p WHERE p.id = 2
----
2|Grace

query
SELECT id FROM people WHERE id = 1 OR id = 2
----
1
2

query
SELECT id FROM people WHERE (age > 40 AND active = TRUE) OR id = 2
----
2
3

query
SELECT id, CASE WHEN age >= 40 THEN 'senior' ELSE 'other' END FROM people
----
1|other
2|other
3|senior
4|senior

