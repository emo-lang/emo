require "emo/rocksdb"

// The KV half end to end (M28): open a database with two column
// families, write and read text, round-trip a value carrying an
// embedded NUL, commit a batch, scan a prefix, and watch a snapshot
// keep its view while the latest state moves. Every run starts from a
// destroyed database, so three runs must print these bytes exactly.
//
// Keys and values print as hex: the point is that the bytes are the
// bytes, NULs included.

const path = ".emo-build/kvdb"

def hex(b Bytes) String {
  const digits = "0123456789abcdef"
  var out = ""
  var i = 0
  while i < b.length() {
    const v = b.get(i)
    out = out + digits.substring(v >> 4, 1) + digits.substring(v & 15, 1)
    i = i + 1
  }
  return out
}

def starts_with(b Bytes, prefix Bytes) Bool {
  if b.length() < prefix.length() {
    return false
  }
  var i = 0
  while i < prefix.length() {
    if b.get(i) != prefix.get(i) {
      return false
    }
    i = i + 1
  }
  return true
}

def joined(xs Array[String]) String {
  var out = ""
  var i = 0
  while i < xs.length() {
    if i > 0 {
      out = out + ","
    }
    out = out + xs[i]
    i = i + 1
  }
  return out
}

// The die-on-failure helpers keep the demo's beats linear: a storage
// failure is not something this golden has a meaningful answer for.
def open_or_die(path String, cfs Array[String]) rocksdb.Db {
  case rocksdb.open(path, cfs, true) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, db) -> { return db }
  }
}

def cf_create_or_die(db rocksdb.Db, name String) rocksdb.Cf {
  case db.cf_create(name) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, cf) -> { return cf }
  }
}

def cf_or_die(db rocksdb.Db, name String) rocksdb.Cf {
  case db.cf(name) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, cf) -> { return cf }
  }
}

def put_or_die(cf rocksdb.Cf, key Bytes, value Bytes) {
  case cf.put(key, value) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, _) -> {}
  }
}

def get_or_die(cf rocksdb.Cf, key Bytes) Array[Bytes] {
  case cf.get(key) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, found) -> { return found }
  }
}

def get_at_or_die(cf rocksdb.Cf, key Bytes, snap rocksdb.Snapshot) Array[Bytes] {
  case cf.get_at(key, snap) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, found) -> { return found }
  }
}

def only(found Array[Bytes], what String) Bytes {
  if found.length() != 1 {
    raise Exception.new(message: "expected one value for " + what)
  }
  return found[0]
}

def batch_or_die(db rocksdb.Db) rocksdb.Batch {
  case db.batch() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, batch) -> { return batch }
  }
}

def snapshot_or_die(db rocksdb.Db) rocksdb.Snapshot {
  case db.snapshot() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, snap) -> { return snap }
  }
}

def iter_or_die(cf rocksdb.Cf) rocksdb.Iter {
  case cf.iter() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, it) -> { return it }
  }
}

def iter_at_or_die(cf rocksdb.Cf, snap rocksdb.Snapshot) rocksdb.Iter {
  case cf.iter_at(snap) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, it) -> { return it }
  }
}

def batch_put_or_die(batch rocksdb.Batch, cf rocksdb.Cf, key Bytes, value Bytes) {
  case batch.put(cf, key, value) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, _) -> {}
  }
}

def batch_delete_or_die(batch rocksdb.Batch, cf rocksdb.Cf, key Bytes) {
  case batch.delete(cf, key) {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, _) -> {}
  }
}

def batch_write_or_die(batch rocksdb.Batch) {
  case batch.write() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, _) -> {}
  }
}

def iter_key(it rocksdb.Iter) Bytes {
  case it.key() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, key) -> { return key }
  }
}

def iter_value(it rocksdb.Iter) Bytes {
  case it.value() {
    (R.error, why) -> { raise Exception.new(message: why) }
    (R.ok, value) -> { return value }
  }
}

// ---- a clean start -------------------------------------------------------

case rocksdb.destroy_db(path) {
  (R.error, why) -> { raise Exception.new(message: why) }
  (R.ok, _) -> {}
}

const db = open_or_die(path, ["default", "notes"])
const notes = cf_or_die(db, "notes")
println("open: notes")

// A family created after open persists; the next open must name it.
const indexes = cf_create_or_die(db, "indexes")
put_or_die(indexes, "user:1".to_bytes(), "idx".to_bytes())
println("cf_create: indexes")

// ---- writes and reads ----------------------------------------------------

put_or_die(notes, "user:1".to_bytes(), "alpha".to_bytes())
const alpha = only(get_or_die(notes, "user:1".to_bytes()), "user:1")
println("get user:1: bytes=${alpha.length()} value=${hex(alpha)}")

// A value whose middle byte is NUL — the byte view's first proof: a
// NUL-terminated String crossing would stop at byte 1.
const binary = Bytes.new(4)
binary.set(0, 0)
binary.set(1, 1)
binary.set(2, 255)
binary.set(3, 65)
put_or_die(notes, "bin:1".to_bytes(), binary)
const readback = only(get_or_die(notes, "bin:1".to_bytes()), "bin:1")
println("get bin:1: bytes=${readback.length()} value=${hex(readback)}")

// The empty value is present, not missing — the 0-or-1 array's other
// edge.
put_or_die(notes, "empty".to_bytes(), Bytes.new(0))
const empty = get_or_die(notes, "empty".to_bytes())
println("get empty: found=${empty.length()} bytes=${only(empty, "empty").length()}")

// The absent key is a value, not an error: an empty array.
const missing = get_or_die(notes, "user:404".to_bytes())
println("get user:404: found=${missing.length()}")

// ---- one atomic batch ----------------------------------------------------

put_or_die(notes, "seed".to_bytes(), "x".to_bytes())
const batch = batch_or_die(db)
batch_put_or_die(batch, notes, "user:2".to_bytes(), "two".to_bytes())
batch_put_or_die(batch, notes, "user:3".to_bytes(), "three".to_bytes())
batch_delete_or_die(batch, notes, "seed".to_bytes())
batch_write_or_die(batch)
batch.close()
const seed_after = get_or_die(notes, "seed".to_bytes())
const two = only(get_or_die(notes, "user:2".to_bytes()), "user:2")
const three = only(get_or_die(notes, "user:3".to_bytes()), "user:3")
println("batch: seed=${seed_after.length()} user:2=${hex(two)} user:3=${hex(three)}")

// ---- a prefix scan -------------------------------------------------------

put_or_die(notes, "other:1".to_bytes(), "o".to_bytes())
const prefix = "user:".to_bytes()
const scan = iter_or_die(notes)
scan.seek(prefix)
var scanned = []
while scan.valid() && starts_with(iter_key(scan), prefix) {
  scanned = scanned.append(hex(iter_key(scan)) + "=" + hex(iter_value(scan)))
  scan.next()
}
scan.close()
println("scan user: ${joined(scanned)}")

// ---- the snapshot keeps its view ----------------------------------------

const snap = snapshot_or_die(db)
put_or_die(notes, "user:1".to_bytes(), "beta".to_bytes())
const at_snap = only(get_at_or_die(notes, "user:1".to_bytes(), snap), "user:1 at the snapshot")
const at_latest = only(get_or_die(notes, "user:1".to_bytes()), "user:1 at the latest state")
println("snapshot: get=${hex(at_snap)} latest=${hex(at_latest)}")

const snap_scan = iter_at_or_die(notes, snap)
snap_scan.seek(prefix)
println("snapshot scan: first=${hex(iter_key(snap_scan))}=${hex(iter_value(snap_scan))}")
snap_scan.close()
snap.close()

// ---- close and reopen: the bytes and the families survive ----------------

db.close()
const again = open_or_die(path, ["default", "notes", "indexes"])
const persisted = only(get_or_die(cf_or_die(again, "notes"), "user:1".to_bytes()), "user:1 after reopen")
case again.cf_list() {
  (R.error, why) -> { raise Exception.new(message: why) }
  (R.ok, names) -> { println("reopen: user:1=${hex(persisted)} families=${joined(names)}") }
}
again.close()

println("done")
