// The first user program (T4.1): the kernel loads this image into the
// user window and srets into it in U-mode. U-mode owns no CSRs and the
// SBI is unreachable from it. The proofs ride the serial line in
// order: the greeting pokes the 16550A directly — the weak-isolation
// window, what U-mode reaches with no gate at all; the `gate` line is
// T4.2's write verb with two refusals printed by the same gate that
// refused them; `echo` is T4.4's read verb, blocking on the console
// service until a byte exists; `doomed` and the `user fault` report
// are T4.6's — a misbehaving child says its line through the gate,
// then loads where the hardware refuses, and the supervisor kills it
// loudly while the machine continues; `born`/`wait 7` are T4.4's
// spawn and wait — the child re-enters this top level, finds the
// token, and exits 7, and the parent's wait answers with it, riding
// after the kill report as the survival proof. The root's exit is
// the stub's verb 0, which lands in the kernel and ends the machine.
//
//   cd hello && emo build main.emo --target riscv64 \
//        --profile user -o ../hello.elf

require "syscall"

const uart = 0x10000000

// A scratch page inside this image's read-write segment — the buffer
// the successful write sends from, with the two token cells the
// spawned passes read (each poked once before the parent parks, so
// the passes see their own) — and the two addresses the refusals try:
// the text segment is load-and-run but not writable, and the kernel's
// own memory is nobody's.
const buf = 0x87200000
const child_cell = buf + 2048
const doomed_cell = buf + 2056
const greedy_cell = buf + 2064
const text_seg = 0x87100000
const kernel_mem = 0x80200000

def put(b Int64) Void {
  while (peek8(uart + 5).to_int64() & 32) == 0 {
  }
  poke8(uart, b.to_byte())
}

def put_num(n Int64) Void {
  if n >= 10 {
    put_num(n / 10)
  }
  put(48 + (n % 10))
}

// The stub's refusal message, back to the ABI's reason number
// (docs/syscalls.md) — the number the line prints.
def reason_num(why String) Int64 {
  if why == "not writable" {
    return 3
  }
  if why == "outside the caller's memory" {
    return 2
  }
  if why == "bad argument" {
    return 4
  }
  if why == "the kernel is out of a resource" {
    return 5
  }
  return 1
}

def reason_of(answer (R, Int64)) Int64 {
  case answer {
    (R.error, why) -> { return reason_num(why) }
    (R.ok, _) -> { return 0 }
  }
}

// One byte into the scratch buffer; the cursor comes back.
def byte_at(pos Int64, b Int64) Int64 {
  poke8(buf + pos, b.to_byte())
  return pos + 1
}

// The decimal digits of n, poked at the cursor; the cursor comes back.
def num_at(n Int64, pos Int64) Int64 {
  var p = pos
  if n >= 10 {
    p = num_at(n / 10, p)
  }
  poke8(buf + p, (48 + (n % 10)).to_byte())
  return p + 1
}

// A line through the console service, from the scratch buffer.
def gate_line(len Int64) Void {
  var r = syscall.write(buf, len)
  case r {
    (R.error, why) -> { put(63) } // ? — the gate refused a line
    (R.ok, _) -> {}
  }
}

// The doomed branch (T4.6): a spawned pass finds this token, claims
// it (clears it — the good child re-enters this same top level and
// must not follow), says its line through the gate, then misbehaves —
// one load where the hardware says no, the firmware's own region, the
// one range PMP keeps from lower privilege. The supervisor's report
// is the last thing this pass prints; the kill is this pass's slot
// ending done.
if peek64(doomed_cell) != 0 {
  poke64(doomed_cell, 0)
  var dp = byte_at(0, 100) // d
  dp = byte_at(dp, 111) // o
  dp = byte_at(dp, 111) // o
  dp = byte_at(dp, 109) // m
  dp = byte_at(dp, 101) // e
  dp = byte_at(dp, 100) // d
  dp = byte_at(dp, 10)
  gate_line(dp)
  var wild = peek64(0x80000000)
  put_num(wild) // unreachable — the load faults
  syscall.exit(1)
}

// The greedy branch (T5.1): a spawned pass whose allocations outrun
// its own 64 KiB arena — the carve the kernel's spawn makes from the
// kernel heap, handed across the boundary by the trap shim. Its
// allocator says so through the gate (verb 5); the supervisor's
// report is the last thing this pass prints, and the machine
// continues — the good child's round trip rides after the report.
if peek64(greedy_cell) != 0 {
  poke64(greedy_cell, 0)
  var yp = byte_at(0, 103) // g
  yp = byte_at(yp, 114) // r
  yp = byte_at(yp, 101) // e
  yp = byte_at(yp, 101) // e
  yp = byte_at(yp, 100) // d
  yp = byte_at(yp, 121) // y
  yp = byte_at(yp, 10)
  gate_line(yp)
  var k = 0
  while true {
    var b = Box.new(k)
    k = k + 1
  }
}

// The child branch (T4.4): a spawned process re-enters this top level
// sharing the image — its runtime state, its consts, this cell — so
// the token the parent pokes just before the spawn is the one
// difference between the two passes. The child says its line and ends
// as an exit the parent's wait can answer.
if peek64(child_cell) != 0 {
  var bp = byte_at(0, 98) // b
  bp = byte_at(bp, 111) // o
  bp = byte_at(bp, 114) // r
  bp = byte_at(bp, 110) // n
  bp = byte_at(bp, 10)
  gate_line(bp)
  syscall.exit(7)
}

// The proofs, in order: the U-mode greeting straight at the machine,
// the gate line, the read — then the root exits and the machine ends.
put(85) // U
put(45) // -
put(77) // M
put(79) // O
put(68) // D
put(69) // E
put(32) // space
var sum = 0
var i = 0
while i <= 1000 {
  sum = sum + i
  i = i + 1
}
put_num(sum)
put(10)

// The gate proof: one write that answers, two that refuse — the
// text segment with reason 3 (no permission), the kernel's memory
// with reason 2 (out of range) — and each refusal printed by the
// same gate that refused it. The line reads `gate 500500 r3 r2`.
var pos = byte_at(0, 103) // g
pos = byte_at(pos, 97) // a
pos = byte_at(pos, 116) // t
pos = byte_at(pos, 101) // e
pos = byte_at(pos, 32) // space
pos = num_at(sum, pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(text_seg, 4)), pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(kernel_mem, 4)), pos)
pos = byte_at(pos, 10)
gate_line(pos)

// The read proof: block on the console until a byte exists, then
// print it — `echo 88` when the feed is an X.
var c = syscall.read()
var rp = byte_at(0, 101) // e
rp = byte_at(rp, 99) // c
rp = byte_at(rp, 104) // h
rp = byte_at(rp, 111) // o
rp = byte_at(rp, 32) // space
rp = num_at(c, rp)
rp = byte_at(rp, 10)
gate_line(rp)

// The kill proof (T4.6): the misbehaving child spawns first — its
// line, then its fault, then the supervisor's loud report — and the
// parent does NOT wait on it: a killed process never exited, so its
// wait would block forever (the stated bound). The runaway proof
// (T5.1) rides the same shape: a greedy pass whose boxes outrun its
// own 64 KiB arena — its allocator announces the exhaustion (verb 5),
// the supervisor's report follows, and the machine goes on. The good
// child's `born`/`wait 7` after both reports is the survival proof.
poke64(doomed_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { put(63) } // ? — the gate refused the spawn
  (R.ok, _) -> {}
}
poke64(greedy_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { put(63) } // ? — the gate refused the spawn
  (R.ok, _) -> {}
}

// The process proof (T4.4): spawn a child — it re-enters this top
// level, finds the token, prints its line, and exits 7 — then wait
// for that exit and print the code. `wait 7` on the wire is the
// whole spawn/wait round trip: the request, the park, the service,
// and the exit that answers it.
poke64(child_cell, 1)
var spawned = syscall.spawn()
case spawned {
  (R.error, _) -> { put(63) } // ? — the gate refused the spawn
  (R.ok, pid) -> {
    var waited = syscall.wait(pid)
    case waited {
      (R.error, _) -> { put(63) } // ? — the gate refused the wait
      (R.ok, code) -> {
        var wp = byte_at(0, 119) // w
        wp = byte_at(wp, 97) // a
        wp = byte_at(wp, 105) // i
        wp = byte_at(wp, 116) // t
        wp = byte_at(wp, 32) // space
        wp = num_at(code, wp)
        wp = byte_at(wp, 10)
        gate_line(wp)
      }
    }
  }
}
syscall.exit(0)
