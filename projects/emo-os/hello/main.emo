}

// The growth contract's five increments (emo-desktop A9.3, EmoOS
// T8.15): the wire's own names for them — the negotiation's fields
// answered, the protocol's version, the roles' surfaces up and home,
// the frame callback's arrival, the pass's own exit marker (the
// callback's park moves the exit past the parent's wait, so the
// marker is the pass's to say).
def fmt_ok_line() Void {
  var p = byte_at(0, 102) // f
  p = byte_at(p, 111) // o
  p = byte_at(p, 114) // r
  p = byte_at(p, 109) // m
  p = byte_at(p, 97) // a
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) //  
  p = byte_at(p, 48) // 0
  p = byte_at(p, 32) //  
  p = byte_at(p, 111) // o
  p = byte_at(p, 107) // k
  p = byte_at(p, 10)
  gate_line(p)
}

def fmt_no_line() Void {
  var p = byte_at(0, 102) // f
  p = byte_at(p, 111) // o
  p = byte_at(p, 114) // r
  p = byte_at(p, 109) // m
  p = byte_at(p, 97) // a
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) //  
  p = byte_at(p, 49) // 1
  p = byte_at(p, 32) //  
  p = byte_at(p, 114) // r
  p = byte_at(p, 52) // 4
  p = byte_at(p, 10)
  gate_line(p)
}

