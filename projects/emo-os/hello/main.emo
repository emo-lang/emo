// One event, as the pass's line: the machine's byte event (0x454D —
// "EM") prints `byte <v>`, a device event `key <t> <c> <v>`.
def input_line(ev Int64) Void {
  if ev_type(ev) == 17741 {
    var bp = byte_at(0, 98) // b
    bp = byte_at(bp, 121) // y
    bp = byte_at(bp, 116) // t
    bp = byte_at(bp, 101) // e
    bp = byte_at(bp, 32) // space
    bp = num_at(ev_value(ev), bp)
    bp = byte_at(bp, 10)
    gate_line(bp)
  } else {
    var tp = byte_at(0, 107) // k
    tp = byte_at(tp, 101) // e
    tp = byte_at(tp, 121) // y
    tp = byte_at(tp, 32) // space
    tp = num_at(ev_type(ev), tp)
    tp = byte_at(tp, 32)
    tp = num_at(ev_code(ev), tp)
    tp = byte_at(tp, 32)
    tp = num_at(ev_value(ev), tp)
    tp = byte_at(tp, 10)
    gate_line(tp)
  }
}

// The pointer's absolute event as the pass's line (T8.11): `move <axis>
// <value>` — the axis code (0 X, 1 Y) and the device's own value.
def move_line(ev Int64) Void {
  var mp = byte_at(0, 109) // m
  mp = byte_at(mp, 111) // o
  mp = byte_at(mp, 118) // v
  mp = byte_at(mp, 101) // e
  mp = byte_at(mp, 32) // space
  mp = num_at(ev_code(ev), mp)
  mp = byte_at(mp, 32)
  mp = num_at(ev_value(ev), mp)
  mp = byte_at(mp, 10)
  gate_line(mp)
}

// The input branch (T8.3, T8.11): a pass parked on the machine's merged
// input stream — `keys?` on the wire as it waits. The run's hands (the
// monitor's sendkey) deliver the device's key event, and the serial's
// byte rides the same stream after it: one stream, the bytes first.
// The key's release and the reports' separators ride the stream too,
// unasserted — the pass reads on to the byte. Then the pointer's half
// (T8.11): the monitor's mouse_move moves the tablet, and its absolute
// report comes through the same stream after the keyboard's events —
// the X and the Y in the device's own order, each on the wire — the
// pass reading until the Y lands. Three sources, one stream. Every
// line through the gate; the pass ends and the parent's wait answers.
if peek64(key_cell) != 0 {
  poke64(key_cell, 0)
  var kp = byte_at(0, 107) // k
  kp = byte_at(kp, 101) // e
  kp = byte_at(kp, 121) // y
  kp = byte_at(kp, 115) // s
  kp = byte_at(kp, 63) // ?
  kp = byte_at(kp, 10)
  gate_line(kp)
  input_line(syscall.input_read())
  var byte_seen = false
  while !byte_seen {
    const ev = syscall.input_read()
    if ev_type(ev) == 17741 {
      input_line(ev)
      byte_seen = true
    }
  }
  var y_seen = false
  while !y_seen {
    const ev = syscall.input_read()
    if ev_type(ev) == 3 {
      move_line(ev)
      if ev_code(ev) == 1 {
        y_seen = true
      }
    }
  }
  // The grant's edge (T8.4): the pass holds no display grant — the
  // present is the permission refusal, the reason number on the wire.
  case syscall.present(0, 0, 0, 1, 1) {
    (R.error, why) then { present_refused_line(reason_num(why)) }
    (R.ok, _) then { mark() }
  }
  // The grant table's edge (T8.5): no window exists yet — the close
  // is the argument refusal, the unknown grant the table cannot name.
  case syscall.win_close(1) {
    (R.error, why) then {
      var cp = byte_at(0, 99) // c
      cp = byte_at(cp, 108) // l
      cp = byte_at(cp, 111) // o
      cp = byte_at(cp, 115) // s
      cp = byte_at(cp, 101) // e
      cp = byte_at(cp, 32) // space
      cp = byte_at(cp, 114) // r
      cp = num_at(reason_num(why), cp)
      cp = byte_at(cp, 10)
      gate_line(cp)
    }
    (R.ok, _) then { mark() }
  }
  syscall.exit(0)
}

// The window branch (T8.5, emo-desktop A9.1): a pass holding its own
// buffer — the run win_new handed, mapped into this pass's own table at
// the identity of its physical addresses. The buffer is no surface yet:
// the pass asks for the three roles the compositor does not implement
// and names each refusal (`role popup r4`, `role subsurface r4`, `role
// panel r4` — the kernel refuses by the number, the caller who chose
// the role names it), presents the role-less buffer and meets the
// surface's absence (`present r4` — the gate's checks pass, the
// compositor's stack has no entry for it), then declares the toplevel
// role, and from there the buffer is a window: the pass paints it,
// reads it back (the mapping is the proof), commits it (the compositor's
// walk carries it into the carve), moves it, commits again, focuses it
// (the stack's raise), and closes it (the run home, the grant gone) —
// the buffer's whole lifecycle, every state named on the wire.
if peek64(win_cell) != 0 {
  poke64(win_cell, 0)
  case syscall.win_new(512, 128) {
    (R.error, why) then {
      var wp = byte_at(0, 119) // w
      wp = byte_at(wp, 105) // i
      wp = byte_at(wp, 110) // n
      wp = byte_at(wp, 32) // space
      wp = byte_at(wp, 114) // r
      wp = num_at(reason_num(why), wp)
      wp = byte_at(wp, 10)
      gate_line(wp)
    }
    (R.ok, ans) then {
      var id = win_id(ans)
      win_line(id)
      case syscall.present(id, 0, 0, 512, 128) {
        (R.error, why) then { present_refused_line(reason_num(why)) }
        (R.ok, _) then { mark() }
      }
      case syscall.win_role(id, 0) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      role_refusal(id, 0)
      paint_win(win_base(ans), 128, 256, 0x57494E00)
      if win_verify(win_base(ans), 128, 256) {
        win_ok_line()
      } else {
        mark()
      }
      // The frame's sum on the wire (T8.6): the compositor's
      // composition line carries the same number — the blit's proof.
      var sp = byte_at(0, 119) // w
      sp = byte_at(sp, 105) // i
      sp = byte_at(sp, 110) // n
      sp = byte_at(sp, 32) // space
      sp = byte_at(sp, 115) // s
      sp = byte_at(sp, 117) // u
      sp = byte_at(sp, 109) // m
      sp = byte_at(sp, 32) // space
      sp = num_at(buffer_sum(win_base(ans), 128, 256) & 4294967295, sp)
      sp = byte_at(sp, 10)
      gate_line(sp)
      // The negotiation's fields (emo-desktop A9.3, EmoOS T8.15; the
      // scale's growth A16.4): the buffer's format and scale are words
      // on the row, named by the client and recorded by the gate —
      // XRGB8888 (0) the first format, scale 1 the first scale, a
      // whole number past one the walk's own multiple now, and below
      // one the argument refusal — and the protocol's version the one
      // word the gate answers itself. The two's answer is the proof
      // the values grew; the row is left at 1 again, the pass's own
      // geometry the one the walk carried before it.
      case syscall.win_format(id, 0) {
        (R.error, _) then { mark() }
        (R.ok, _) then { fmt_ok_line() }
      }
      case syscall.win_format(id, 1) {
        (R.error, _) then { fmt_no_line() }
        (R.ok, _) then { mark() }
      }
      case syscall.win_scale(id, 1) {
        (R.error, _) then { mark() }
        (R.ok, _) then { scale_ok_line() }
      }
      case syscall.win_scale(id, 2) {
        (R.error, _) then { mark() }
        (R.ok, _) then { scale_two_line() }
      }
      case syscall.win_scale(id, 0) {
        (R.error, _) then { scale_no_line() }
        (R.ok, _) then { mark() }
      }
      case syscall.win_scale(id, 1) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      // The shape's words (emo-desktop M30, A30.2; verb 33): the
      // radius and the softness the walk's mask and shadow wear — the
      // toplevel's own defaults its word names (the sums the same
      // bytes), the second call the argument refusal the format's own
      // rule. The popup below declares six and six, the corners the
      // composition's words carry.
      case syscall.win_shape(id, 10, 16) {
        (R.error, _) then { mark() }
        (R.ok, _) then { shape_ok_line() }
      }
      case syscall.win_shape(id, 0, 0) {
        (R.error, _) then { shape_no_line() }
        (R.ok, _) then { mark() }
      }
      case syscall.desktop_version() {
        (R.error, _) then { mark() }
        (R.ok, _) then { protocol_line() }
      }
      case syscall.present(id, 0, 0, 512, 128) {
        (R.error, _) then { mark() }
        (R.ok, _) then { win_shown_line() }
      }
      // The roles' substance (emo-desktop A9.3): a popup and a
      // subsurface hang from this toplevel by verb 19 — their
      // coordinates the parent's from the binding on, the walk painting
      // each immediately above it — and a panel stands alone as the
      // walk's topmost strip, refusing a parent by its role. Each is
      // painted, presented (the composition names its absolute place),
      // and closed — the runs home before the pass moves its own.
      var ppop = 0
      case syscall.win_new(128, 64) {
        (R.error, _) then { mark() }
        (R.ok, pans) then {
          ppop = win_id(pans)
          case syscall.win_role(ppop, 1) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_parent(ppop, id) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_move(ppop, 48, 32) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_shape(ppop, 6, 6) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          paint_win(win_base(pans), 64, 64, 0x504F5000)
          case syscall.present(ppop, 0, 0, 128, 64) {
            (R.error, _) then { mark() }
            (R.ok, _) then { popup_up_line() }
          }
        }
      }
      var psub = 0
      case syscall.win_new(64, 64) {
        (R.error, _) then { mark() }
        (R.ok, sans) then {
          psub = win_id(sans)
          case syscall.win_role(psub, 2) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_parent(psub, id) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_move(psub, 400, 32) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          paint_win(win_base(sans), 64, 32, 0x53554200)
          case syscall.present(psub, 0, 0, 64, 64) {
            (R.error, _) then { mark() }
            (R.ok, _) then { sub_up_line() }
          }
        }
      }
      var ppan = 0
      // the panel is the walk's topmost strip: the mode's own width at
      // the display's bottom edge (A14.3 — the shape derives, the mode
      // the device's answer)
      var pmw = 0
      var pmh = 0
      case syscall.output_info(0) {
        (R.error, _) then { mark() }
        (R.ok, m) then {
            pmw = m >> 32
            pmh = m & 4294967295
          }
      }
      case syscall.win_new(pmw, 32) {
        (R.error, _) then { mark() }
        (R.ok, qans) then {
          ppan = win_id(qans)
          case syscall.win_role(ppan, 3) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          case syscall.win_parent(ppan, id) {
            (R.error, _) then { parent_panel_line() }
            (R.ok, _) then { mark() }
          }
          case syscall.win_move(ppan, 0, pmh - 32) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          paint_win(win_base(qans), 32, pmw / 2, 0x504E4C00)
          case syscall.present(ppan, 0, 0, pmw, 32) {
            (R.error, _) then { mark() }
            (R.ok, _) then { panel_up_line() }
          }
        }
      }
      case syscall.win_parent(ppop, 99) {
        (R.error, _) then { parent_gone_line() }
        (R.ok, _) then { mark() }
      }
      case syscall.win_move(id, 16, 32) {
        (R.error, _) then { mark() }
        (R.ok, _) then { win_moved_line() }
      }
      case syscall.present(id, 0, 0, 512, 128) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      case syscall.win_focus(id) {
        (R.error, _) then { mark() }
        (R.ok, _) then { win_focused_line() }
      }
      case syscall.win_close(ppop) {
        (R.error, _) then { mark() }
        (R.ok, _) then { popup_closed_line() }
      }
      case syscall.win_close(psub) {
        (R.error, _) then { mark() }
        (R.ok, _) then { sub_closed_line() }
      }
      case syscall.win_close(ppan) {
        (R.error, _) then { mark() }
        (R.ok, _) then { panel_closed_line() }
      }
      case syscall.win_close(id) {
        (R.error, _) then { mark() }
        (R.ok, _) then { win_closed_line() }
      }
    }
  }
  // The pass's own exit marker (emo-desktop A9.3): the frame
  // callback's park below moves this pass's exit past the parent's
  // era — the wait that printed this line retired with it, the marker
  // the pass's to say. Then the park: the answer is the machine's
  // next composition (the client era's first frame carries it), and
  // the line it wakes to is the callback's proof on the wire.
  win_zero_line()
  case syscall.win_frame() {
    (R.error, _) then { mark() }
    (R.ok, _) then { cb_ok_line() }
  }
  syscall.exit(0)
}

// The client's line (emo-desktop A9.2): `client up <grant>` — the
// surface is on the stack and its frame is on the display.
def client_up_line(id Int64) Void {
  var p = byte_at(0, 99) // c
  p = byte_at(p, 108) // l
  p = byte_at(p, 105) // i
  p = byte_at(p, 101) // e
  p = byte_at(p, 110) // n
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) // space
  p = byte_at(p, 117) // u
  p = byte_at(p, 112) // p
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The client branch (emo-desktop A9.2): a pass of its own that opens a
// toplevel surface — win_new, win_role(toplevel), win_move to its
// place, the raw pattern painted into its own buffer, the present
// putting it on the stack — and says `client up <grant>`. The first
// client then stores where its table maps nothing and dies without
// closing: the fault route reaps the pass and writes the comp page's
// dead-owner cell (T8.14), and the compositor's next composition reads
// it — the run back to the allocator, the row emptied, the surface off
// the stack — the acceptance the rebirth proves. The reborn client
// takes a different place and a different pattern, closes cleanly and
// exits, so the parent's wait answers and the chain moves on with the
// machine whole.
if peek64(client_cell) != 0 {
  poke64(client_cell, 0)
  var cplace_x = 96
  var cword = 0x57494E00
  case syscall.win_new(384, 128) {
    (R.error, _) then { mark() }
    (R.ok, cans) then {
      var cid = win_id(cans)
      case syscall.win_role(cid, 0) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      case syscall.win_move(cid, cplace_x, 320) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      paint_win(win_base(cans), 128, 192, cword)
      case syscall.present(cid, 0, 0, 384, 128) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      client_up_line(cid)
      poke64(0x20000000, 0) // the kill: a store the table maps nothing —
                           //   the fault the death-side reclaim waits for
    }
  }
  syscall.exit(1) // unreachable — the store above faults first
}
if peek64(client2_cell) != 0 {
  poke64(client2_cell, 0)
  case syscall.win_new(384, 128) {
    (R.error, _) then { mark() }
    (R.ok, cans) then {
      var cid = win_id(cans)
      case syscall.win_role(cid, 0) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      case syscall.win_move(cid, 512, 320) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      paint_win(win_base(cans), 128, 192, 0x52454200)
      case syscall.present(cid, 0, 0, 384, 128) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      client_up_line(cid)
      case syscall.win_close(cid) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
    }
  }
  syscall.exit(0)
}

// The UI branch (T7.4, docs/ui.md): a spawned pass renders the
// counter's frame and answers the console's keys until the quit key
// ends it — the machine's third kind of resident, an application, and
// the closure demo's last piece: kernel, shell, and UI in one
// language. Its exit answers the parent's wait, and the REPL takes
// the console after it.
if peek64(ui_cell) != 0 {
  poke64(ui_cell, 0)
  console_ui.run()
  syscall.exit(0)
}

// The window shell (emo-desktop A9.1, EmoOS T8.13): the desktop's first
// windows — two toplevel surfaces, `alpha` and `beta`, each a buffer of
// this pass's own, declared a toplevel by its role, placed by the move
// verb, painted through `ui_fb_win` into its own words and committed by
// its present, which the compositor answers with the whole stack
// composited into the carve. Then the pass owns the merged stream and
// is the desktop's policy over it: a press inside a window focuses it
// (the focus verb, which raises it to the stack's top; the bar's steel
// says which one is focused — the window that was focused repaints
// dim, the new one repaints focused), a press on a window's bar begins
// a drag — every report of the pointer moves the window with the
// pointer through the move verb, its x kept on the blit's word
// granularity and the window kept on the display — and the release is
// the present that puts the moved window where the drag left it; a key
// byte `a` is routed to the focused window alone, which counts it on
// its body line; `q` ends the shell, the windows closed behind it. The
// pointer's reports are scaled to the display by the device's own range
// (verb 18's answer, never a constant). Every state on the wire: the
// range, the grants, each focus, each key routed, each drag's end — the
// `run.sh` beats, and the frames' digests (`frame <n>`) the hosted
// twin's file names in the same order.
if peek64(desk_cell) != 0 {
  poke64(desk_cell, 0)
  const thelder = ArrayBuilder.new()
  case desk_strike() {
    (R.error, _) then { mark() }
    (R.ok, s) then { thelder.push(s) }
  }
  const tf = thelder.get(0)
  var mode = 0
  case syscall.output_info(0) {
    (R.error, _) then { mark() }
    (R.ok, m) then { mode = m }
  }
  // The pointer's axes, packed as the display's mode is: the X's
  // maximum above the Y's.
  var range = 0
  case syscall.input_info(0) {
    (R.error, _) then { mark() }
    (R.ok, r) then { range = r }
  }
  const mw = out_w(mode)
  const mh = out_h(mode)
  // The chrome's material wants the art (emo-desktop M31, A31.2): the
  // file's one read before the strip's first paint — the load's guard
  // no-ops when the desktop's boot already ran it.
  wall_file_load(mode)
  const max_x = out_w(range)
  const max_y = out_h(range)
  desk_range_line(max_x, max_y)
  const ww = ui_fb_win.width()
  const wh = ui_fb_win.height()
  var ga = 0
  var base_a = 0
  case syscall.win_new(ww, wh) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      ga = win_id(ans)
      base_a = win_base(ans)
    }
  }
  var gb = 0
  var base_b = 0
  case syscall.win_new(ww, wh) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      gb = win_id(ans)
      base_b = win_base(ans)
    }
  }
  // The shell's dock (emo-desktop A10.2): a panel surface at the
  // display's bottom edge — the walk's topmost strip, no window over
  // it — one tile per app, the focused app's lit.
  const dw = mw
  const dh = emo_desktop.strip_height()
  var gd = 0
  var base_d = 0
  case syscall.win_new(dw, dh) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      gd = win_id(ans)
      base_d = win_base(ans)
    }
  }
  desk_win_line(97, ga) // a
  desk_win_line(98, gb) // b
  case syscall.win_role(ga, 0) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_role(gb, 0) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_role(gd, 3) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  var ax = 64
  var ay = 128
  var bx = 576
  var by = 384
  case syscall.win_move(ga, ax, ay) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_move(gb, bx, by) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_move(gd, 0, mh - dh) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  // The start's park (the counter's shape): the pass waits for the
  // run's first byte before its first frame — the beat between the
  // window pass's era on the display and this one's, which `run.sh`'s
  // screendump of the window's moved copy needs to be still. The byte
  // itself is nothing: the loop's drop rules name what counts.
  var wake = syscall.input_read()
  const wa = Win.new(grant: ga, base: base_a, width: ww, height: wh)
  var wb = Win.new(grant: gb, base: base_b, width: ww, height: wh)
  const labels = ["a", "b"]
  // The focus: none until a press names a window; the top of the
  // stack as this pass knows it — beta, declared last, until a focus
  // raises the other — is the one the hit test asks first.
  var focused = 0
  var top = gb
  var keys_a = 0
  var keys_b = 0
  // The assignment dance's phase (emo-desktop M27, EmoOS T13.2): the
  // run's hand advances it one `w` at a time.
  var wphase = 0
  ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), false, keys_a)
  wa.present()
  ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, keys_b)
  wb.present()
  desk_strip_paint(tf, base_d, gd, dw, mh, labels, -1, 0)
  var px = 0
  var py = 0
  var drag = 0
  var gdx = 0
  var gdy = 0
  var running = true
  while running {
    const ev = syscall.input_read()
    const t = ev_type(ev)
    if t == 17741 {
      const b = ev_value(ev)
      if b == 113 {
        running = false
      }
      // The close-and-reopen beat (EmoOS T9.3): beta closed and another
      // window opened in the same life — the run's blocks back to the
      // allocator and the owner's table keeping their leaves was the
      // machine's end (`sv39: an address mapped twice`); the close's
      // unmap is the other half, and the reopened window's map — over
      // the very blocks the close gave back — is the proof it happened.
      // Beta comes back where it stood, unfocused, its keys count the
      // fresh window's own.
      if b == 99 {
        case syscall.win_close(gb) {
          (R.error, _) then { mark() }
          (R.ok, _) then {}
        }
        var ngb = 0
        var nbase = 0
        case syscall.win_new(ww, wh) {
          (R.error, _) then { mark() }
          (R.ok, ans) then {
            ngb = win_id(ans)
            nbase = win_base(ans)
          }
        }
        gb = ngb
        base_b = nbase
        case syscall.win_role(gb, 0) {
          (R.error, _) then { mark() }
          (R.ok, _) then {}
        }
        case syscall.win_move(gb, bx, by) {
          (R.error, _) then { mark() }
          (R.ok, _) then {}
        }
        wb = Win.new(grant: gb, base: base_b, width: ww, height: wh)
        ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, 0)
        wb.present()
        desk_win_line(98, gb)
        focused = 0
        top = gb
        desk_strip_paint(tf, base_d, gd, dw, mh, labels, -1, 0)
      }
      if b == 97 && focused != 0 {
        if focused == ga {
          keys_a = keys_a + 1
          ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), true, keys_a)
          wa.present()
          desk_key_line(ga, keys_a)
        } else {
          keys_b = keys_b + 1
          ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), true, keys_b)
          wb.present()
          desk_key_line(gb, keys_b)
        }
      }
      // The workspace beats (emo-desktop M27, EmoOS T13.2, A27.3): the
      // run's hand walks the assignment one `w` at a time — alpha to
      // desk 1, desk 1 shown, alpha back to desk 0, desk 0 shown —
      // each phase its verb (the owner's and the panel authority's,
      // the strip's grant the panel check answers), the assign's own
      // line, and the packed word the query answers, the state the
      // screendumps read. The composition rides the verb's decode —
      // the comp line is on the wire before the answer — so the
      // phase's lines follow pixels already set.
      if b == 119 {
        if wphase == 0 {
          case syscall.win_workspace(ga, 1) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          desk_assign_line(97, 1)
        }
        if wphase == 1 {
          case syscall.desk_show(1) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
        }
        if wphase == 2 {
          case syscall.win_workspace(ga, 0) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          desk_assign_line(97, 0)
        }
        if wphase == 3 {
          case syscall.desk_show(0) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
        }
        wphase = wphase + 1
        case syscall.desk_workspace() {
          (R.error, _) then { mark() }
          (R.ok, d) then { desk_word_line(d) }
        }
      }
    }
    if t == 3 {
      if ev_code(ev) == 0 {
        px = scaled(ev_value(ev), mw, max_x)
      }
      if ev_code(ev) == 1 {
        py = scaled(ev_value(ev), mh, max_y)
      }
      if drag == ga {
        const nx = dragged(px, gdx, ww, mw, true)
        const ny = dragged(py, gdy, wh, mh, false)
        if nx != ax || ny != ay {
          case syscall.win_move(ga, nx, ny) {
            (R.error, _) then { mark() }
            (R.ok, _) then {
              ax = nx
              ay = ny
            }
          }
        }
      }
      if drag == gb {
        const nx = dragged(px, gdx, ww, mw, true)
        const ny = dragged(py, gdy, wh, mh, false)
        if nx != bx || ny != by {
          case syscall.win_move(gb, nx, ny) {
            (R.error, _) then { mark() }
            (R.ok, _) then {
              bx = nx
              by = ny
            }
          }
        }
      }
    }
    // The tablet's left button (BTN_LEFT, 272): the press is the hit
    // test — the stack's top first — and the release ends a drag with
    // the present that shows where it went.
    if t == 1 && ev_code(ev) == 272 {
      if ev_value(ev) == 1 {
        var hit = 0
        if py >= mh - dh {
          // The strip is the dock's: a press there names a tile, and
          // the tile names its app — no window beneath is consulted,
          // and no drag begins (the dock is topmost; the walk paints
          // it over everything).
          const tile = emo_desktop.press(px, py, mw, mh, 2)
          if tile == 0 {
            hit = ga
          }
          if tile == 1 {
            hit = gb
          }
        } else {
          if top == gb {
            if inside(px, py, bx, by, ww, wh) {
              hit = gb
            } else {
              if inside(px, py, ax, ay, ww, wh) {
                hit = ga
              }
            }
          } else {
            if inside(px, py, ax, ay, ww, wh) {
              hit = ga
            } else {
              if inside(px, py, bx, by, ww, wh) {
                hit = gb
              }
            }
          }
        }
        if hit != 0 && hit != focused {
          case syscall.win_focus(hit) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          if focused == ga {
            ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), false, keys_a)
            wa.present()
          }
          if focused == gb {
            ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, keys_b)
            wb.present()
          }
          focused = hit
          top = hit
          // The focus's arrival (emo-desktop M32, A32.2): the lit paper
          // sweeping in — four frames the present's reply paces, the
          // bar the sweep's whole world — then the strip's repaint the
          // corpus's frame pins.
          var sweep_s = wa
          var sweep_t = ui_fb_win.title_a()
          if hit != ga {
            sweep_s = wb
            sweep_t = ui_fb_win.title_b()
          }
          var si = 1
          while si <= 4 {
            ui_fb_win.paint_bar_sweep(sweep_s, tf, sweep_t, si, 4)
            sweep_s.present()
            si = si + 1
          }
          var lit = -1
          if hit == ga {
            lit = 0
          }
          if hit == gb {
            lit = 1
          }
          println("motion focus ${lit}")
          desk_strip_paint(tf, base_d, gd, dw, mh, labels, lit, 0)
          desk_focus_line(hit)
        }
        if hit == ga && py < mh - dh && (py - ay) < ui_fb_win.bar_height() {
          drag = ga
          gdx = px - ax
          gdy = py - ay
        }
        if hit == gb && py < mh - dh && (py - by) < ui_fb_win.bar_height() {
          drag = gb
          gdx = px - bx
          gdy = py - by
        }
      } else {
        if drag == ga {
          wa.present()
          desk_drag_line(ga, ax, ay)
        }
        if drag == gb {
          wb.present()
          desk_drag_line(gb, bx, by)
        }
        drag = 0
      }
    }
  }
  case syscall.win_close(ga) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_close(gb) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_close(gd) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  syscall.exit(0)
}

// The first apps (emo-desktop A10.3) lived here as token branches of
// this image — each a pass re-entering this top level. A11.1 moved
// them out: each app is a disk ELF of its own (`fb/apps/counter/` and
// its siblings, the sources of the images this image's kernel embeds),
// exec'd by name in the parent's own flow below. No token, no branch.

// The child branch (T4.4): a spawned process re-enters this top level
// sharing the image — its runtime state, its consts, this cell — so
// the token the parent pokes just before the spawn is the one
// difference between the two passes. The child says its line and ends
// as an exit the parent's wait can answer.
if peek64(child_cell) != 0 {
  var bp = byte_at(0, 98) // b
  bp = byte_at(bp, 111) // o
  bp = byte_at(bp, 114) // r
  bp = byte_at(bp, 110) // n
  bp = byte_at(bp, 10)
  gate_line(bp)
  syscall.exit(7)
}

// The greeting, through the gate: U-mode's world is its own pages now
// (T6.2) — the 16550A is the kernel's, and the greeting is the gate's
// first line. The sum is the register file's pin, as it always was.
var gp = byte_at(0, 85) // U
gp = byte_at(gp, 45) // -
gp = byte_at(gp, 77) // M
gp = byte_at(gp, 79) // O
gp = byte_at(gp, 68) // D
gp = byte_at(gp, 69) // E
gp = byte_at(gp, 32) // space
var sum = 0
var i = 0
while i <= 1000 {
  sum = sum + i
  i = i + 1
}
gp = num_at(sum, gp)
gp = byte_at(gp, 10)
gate_line(gp)

// The gate proof (T1.0): a write whose source is the text segment —
// readable, not writable — answers now, and answers 0 for a zero
// length: the source rule is R, not W. The kernel's memory still
// refuses with reason 2 (out of range), printed by the same gate that
// refused it. The line reads `gate 500500 w0 r2`.
var pos = byte_at(0, 103) // g
pos = byte_at(pos, 97) // a
pos = byte_at(pos, 116) // t
pos = byte_at(pos, 101) // e
pos = byte_at(pos, 32) // space
pos = num_at(sum, pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 119) // w
pos = num_at(count_of(syscall.write(text_seg, 0)), pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(kernel_mem, 4)), pos)
pos = byte_at(pos, 10)
gate_line(pos)

// The read proof: block on the console until a byte exists, then
// print it — `echo 88` when the feed is an X.
var c = syscall.read()
var rp = byte_at(0, 101) // e
rp = byte_at(rp, 99) // c
rp = byte_at(rp, 104) // h
rp = byte_at(rp, 111) // o
rp = byte_at(rp, 32) // space
rp = num_at(c, rp)
rp = byte_at(rp, 10)
gate_line(rp)

// The filesystem proof (T7.2, docs/fs.md): a 600-byte file written
// through the gate — two sectors, the second one's tail zero on the
// disk — and read back byte for byte; a second file written and
// removed; the list naming what is left: the root's boot file and
// this one. `fs rw ok` is the roundtrip, `fs ls 2` the list; a
// refusal or a wrong byte prints `fs rw ?`. The proof runs before the
// spawns, so no other pass is on the service meanwhile.
var fn = put_name(fs_name)
fill(fs_data, 600)
var fs_ok = true
case syscall.file_write(fs_name, fn, fs_data, 600) {
  (R.error, _) then { fs_ok = false }
  (R.ok, wn) then {
    if wn != 600 {
      fs_ok = false
    }
  }
}
case syscall.file_read(fs_name, fn, fs_back, 2048) {
  (R.error, _) then { fs_ok = false }
  (R.ok, rn) then {
    if rn != 600 {
      fs_ok = false
    }
  }
}
if !same(fs_data, fs_back, 600) {
  fs_ok = false
}
var tn = put_tmp(fs_tmp)
case syscall.file_write(fs_tmp, tn, fs_data, 1) {
  (R.error, _) then { fs_ok = false }
  (R.ok, _) then {}
}
case syscall.file_remove(fs_tmp, tn) {
  (R.error, _) then { fs_ok = false }
  (R.ok, _) then {}
}
var listed = 0
case syscall.file_list(fs_names, 256) {
  (R.error, _) then { fs_ok = false }
  (R.ok, ln) then { listed = ln }
}
var xp = byte_at(0, 102) // f
xp = byte_at(xp, 115) // s
xp = byte_at(xp, 32) // space
xp = byte_at(xp, 114) // r
xp = byte_at(xp, 119) // w
xp = byte_at(xp, 32) // space
if fs_ok {
  xp = byte_at(xp, 111) // o
  xp = byte_at(xp, 107) // k
} else {
  xp = byte_at(xp, 63) // ?
}
xp = byte_at(xp, 10)
gate_line(xp)
var lp = byte_at(0, 102) // f
lp = byte_at(lp, 115) // s
lp = byte_at(lp, 32) // space
lp = byte_at(lp, 108) // l
lp = byte_at(lp, 115) // s
lp = byte_at(lp, 32) // space
lp = num_at(lines(fs_names, listed), lp)
lp = byte_at(lp, 10)
gate_line(lp)

// The kill proof (T4.6): the misbehaving child spawns first — its
// line, then its fault, then the supervisor's loud report — and the
// parent does NOT wait on it: a killed process never exited, so its
// wait would block forever (the stated bound). The runaway proof
// (T5.1) rides the same shape: a greedy pass whose boxes outrun its
// own 64 KiB arena — its allocator announces the exhaustion (verb 5),
// the supervisor's report follows, and the machine goes on. The
// store-fault proof (T6.4) rides it too: a pass that stores where its
// own table maps nothing — the page-fault kill named by its address,
// stval in the report. And the isolation proof (T6.5): a pass that
// stores at a kernel address, where the mapping is there without U
// and the permission is what fails — the same kill, the kernel's own
// address named. The good child's `born`/`wait 7` after the four
// reports is the survival proof.
poke64(doomed_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}
poke64(greedy_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}
poke64(smash_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}
poke64(reach_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}

// The process proof (T4.4): spawn a child — it re-enters this top
// level, finds the token, prints its line, and exits 7 — then wait
// for that exit and print the code. `wait 7` on the wire is the
// whole spawn/wait round trip: the request, the park, the service,
// and the exit that answers it.
poke64(child_cell, 1)
var spawned = syscall.spawn()
case spawned {
  (R.error, _) then { mark() }
  (R.ok, pid) then {
    var waited = syscall.wait(pid)
    case waited {
      (R.error, _) then { mark() }
      (R.ok, code) then {
        var wp = byte_at(0, 119) // w
        wp = byte_at(wp, 97) // a
        wp = byte_at(wp, 105) // i
        wp = byte_at(wp, 116) // t
        wp = byte_at(wp, 32) // space
        // the wait's status (EmoOS T1.6): the code above the low byte,
        // the signal's number in it for a signal death — the proof
        // prints the code
        wp = num_at(code >> 8, wp)
        wp = byte_at(wp, 10)
        gate_line(wp)
      }
    }
  }
}

// The screen carve's proof (T8.2): the machine's first full-screen
// pass. The token poked, the spawn's kernel side reads it and hands
// the carve into the child's table; the child paints its pattern
// across the whole carve and exits, the process service reads the
// words back through the kernel's half — `screen 0x86c00000 ok` on the
// wire — and the parent's wait is answered after the line. The carve
// was handed once: the second screen spawn is the resource refusal
// (the reason number on the wire, `screen r5`), the pass that would
// have claimed it never runs, and the token is cleared by the hand
// that poked it.
poke64(screen_cell, 1)
var screen_spawned = syscall.spawn()
case screen_spawned {
  (R.error, _) then { mark() }
  (R.ok, spid) then {
    var screen_waited = syscall.wait(spid)
    case screen_waited {
      (R.error, _) then { mark() }
      (R.ok, _) then {}
    }
  }
}
poke64(screen_cell, 1)
var screen_again = syscall.spawn()
case screen_again {
  (R.error, why) then {
    poke64(screen_cell, 0)
    var scp = byte_at(0, 115) // s
    scp = byte_at(scp, 99) // c
    scp = byte_at(scp, 114) // r
    scp = byte_at(scp, 101) // e
    scp = byte_at(scp, 101) // e
    scp = byte_at(scp, 110) // n
    scp = byte_at(scp, 32) // space
    scp = byte_at(scp, 114) // r
    scp = num_at(reason_num(why), scp)
    scp = byte_at(scp, 10)
    gate_line(scp)
  }
  (R.ok, _) then { mark() }
}

// The input merge's proof (T8.3): the machine's keyboard beyond the
// serial. The pass above claims the token and parks on the merged
// stream — the run's hands answer it (the monitor's sendkey, then the
// serial's byte on the same stream) and its exit answers the parent's
// wait.
poke64(key_cell, 1)
var key_spawned = syscall.spawn()
case key_spawned {
  (R.error, _) then { mark() }
  (R.ok, kpid) then {
    var key_waited = syscall.wait(kpid)
    case key_waited {
      (R.error, _) then { mark() }
      (R.ok, _) then {}
    }
  }
}

// The window buffer's proof (T8.5): the pass above — the run handed,
// the mapping painted and read back, the commit recorded, the release
// home — the buffer's lifecycle whole, and its exit answering the
// parent's wait.
poke64(win_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}

// The client's kill and rebirth (emo-desktop A9.2): the entry parks on
// the console read first — the era gate, the byte itself nothing — and
// the run's hand opens it only when the previous era's display beat is
// done. Then the first client presents its surface and dies without
// closing — the death notice drops the surface and the run — and the
// entry parks again until the hand says the reclaim landed. Then the
// rebirth: a fresh pass, a fresh grant, a different place and pattern,
// closed cleanly, its exit answering the wait.
var cgate = syscall.read()
poke64(client_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, _) then {}
}
var cwalk = syscall.read()
poke64(client2_cell, 1)
case syscall.spawn() {
  (R.error, _) then { mark() }
  (R.ok, c2pid) then {
    var c2wait = syscall.wait(c2pid)
    case c2wait {
      (R.error, _) then { mark() }
      (R.ok, code) then {
        if code == 0 {
          var bp = byte_at(0, 99) // c
          bp = byte_at(bp, 108) // l
          bp = byte_at(bp, 105) // i
          bp = byte_at(bp, 101) // e
          bp = byte_at(bp, 110) // n
          bp = byte_at(bp, 116) // t
          bp = byte_at(bp, 32) // space
          bp = byte_at(bp, 98) // b
          bp = byte_at(bp, 97) // a
          bp = byte_at(bp, 99) // c
          bp = byte_at(bp, 107) // k
          bp = byte_at(bp, 10)
          gate_line(bp)
        } else {
          mark()
        }
      }
    }
  }
}

var cgate3 = syscall.read() // the third era gate: the run's hand has
                            //   parked the pointer and read the client's
                            //   display beat — only then does the desk era
                            //   begin, so its start park takes the queued
                            //   pointer event, never an early wake

// The window shell (emo-desktop A9.1): the pass above — two toplevel
// windows up, the run's hands focusing, dragging and keying them until
// the quit byte — and its exit answering the parent's wait (`desk 0`).
poke64(desk_cell, 1)
var desk_spawned = syscall.spawn()
case desk_spawned {
  (R.error, _) then { mark() }
  (R.ok, dpid) then {
    var desk_waited = syscall.wait(dpid)
    case desk_waited {
      (R.error, _) then { mark() }
      (R.ok, code) then {
        var dp = desk_at()
        dp = num_at(code, dp)
        dp = byte_at(dp, 10)
        gate_line(dp)
      }
    }
  }
}

// The shell's foreground (T7.3, docs/shell.md): the desk pass has
// handed the display over and its exit answered, and the top level
// takes the machine's foreground as the REPL — the prompt the boot's
// end. The desktop is the line's own door (the `desktop` word,
// shell_mode below): when the line names it the era paints — the
// wallpaper, the header, the dock and the icons (emo-desktop A12.1,
// EmoOS T8.19) — and the top level's loop becomes the desktop's for
// its life: the launcher's dock its panel and the merged stream its
// ear, no wait verb anywhere, the exits riding the stream to their
// parent now, a launch and a death the same loop's ordinary events. A
// press on the strip names a tile and the tile launches its app (the
// exec verb, the disk ELF); a byte names the REPL line and the line
// names its command (the shell's own assembly, `feed` — the serial's
// bytes ride the stream as 0x454D events, and the focus is the gate
// they pass: the desktop hears them when the dock holds the focus, an
// application when its window does, the missing echo the tell). The
// dock knows residency, not focus — no wire tells the shell a focus
// moved, so no tile wears the focused steel; the running dot is the
// launcher's one visible fact. The machine ends as the proof's exit
// did: the poweroff command is the boot pass's exit verb.

// The exits' type, the stream's own marker family: 0x4558 ("EX"),
// beside the serial bytes' 0x454D ("EM") — the small types the
// keyboards and tablets carry can never name it. The code field is
// the child's pid, the value the exit code.
const ev_exit = 0x4558

// The shortcut's type (emo-desktop M36, EmoOS T16.1): 0x5343 ("SC"),
// the family's third member — the input service's chord layer hands
// the shell the value whatever window holds the focus; the code field
// is zero, the value the chord's id (0..3 the desks).
const ev_shortcut = 0x5343

// The launcher's scratch (emo-desktop A12.1): the three app slots
// above the shell's texts, buf-offsets — the file names the exec verb
// loads poked once at the era's start (twelve bytes a row), one pid
// word a slot beside them. A slot's pid is the live process's, zero
// the not-resident's; the dot, the refusal and the exit line all read
// it.
const desk_names = 9216
const desk_pids = 9264

def desk_flen(slot Int64) Int64 {
  if slot == 1 {
    return 9
  }
  if slot == 2 {
    return 10
  }
  return 11
}

// The bare name the lines print: the file's own with the `.elf` off.
def desk_nlen(slot Int64) Int64 {
  return desk_flen(slot) - 4
}

// `desktop <name>` at the scratch's head, the cursor back — the three
// desktop lines' shared prefix, the name the slot's row holds (the
// bare name) or the line's own bytes (the exec command's argument).
def desk_line_name(name Int64, nlen Int64) Int64 {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 32)
  var i = 0
  while i < nlen {
    p = byte_at(p, peek8(name + i).to_int64())
    i = i + 1
  }
  return p
}

def desk_up_line(name Int64, nlen Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 117) // u
  p = byte_at(p, 112) // p
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_running_line(name Int64, nlen Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 114) // r
  p = byte_at(p, 117) // u
  p = byte_at(p, 110) // n
  p = byte_at(p, 110) // n
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 103) // g
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_exit_line(name Int64, nlen Int64, code Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 101) // e
  p = byte_at(p, 120) // x
  p = byte_at(p, 105) // i
  p = byte_at(p, 116) // t
  p = byte_at(p, 32)
  p = num_at(code, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The line's `desktop` word once the era is up: the shell's door is
// already open — `desktop: already up`, the strict answer a second
// press gets.
def desk_note() Void {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 58) // :
  p = byte_at(p, 32)
  p = byte_at(p, 97) // a
  p = byte_at(p, 108) // l
  p = byte_at(p, 114) // r
  p = byte_at(p, 101) // e
  p = byte_at(p, 97) // a
  p = byte_at(p, 100) // d
  p = byte_at(p, 121) // y
  p = byte_at(p, 32)
  p = byte_at(p, 117) // u
  p = byte_at(p, 112) // p
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_running_mask() Int64 {
  var m = 0
  if peek64(buf + desk_pids) != 0 {
    m = m | 1
  }
  if peek64(buf + desk_pids + 8) != 0 {
    m = m | 2
  }
  if peek64(buf + desk_pids + 16) != 0 {
    m = m | 4
  }
  return m
}

// The typed name against the slots' file rows — the exec command's
// argument naming a slot the tile's press names too.
def desk_slot_of(name Int64, nlen Int64) Int64 {
  var slot = 0
  while slot < 3 {
    if nlen == desk_flen(slot) {
      var row = buf + desk_names + (slot * 12)
      var same = true
      var i = 0
      while i < nlen {
        if peek8(name + i).to_int64() != peek8(row + i).to_int64() {
          same = false
        }
        i = i + 1
      }
      if same {
        return slot
      }
    }
    slot = slot + 1
  }
  return -1
}

const desk_wall_grant = 16064 // the wallpaper's grant and base — the
const desk_wall_base = 16072 // surfaces rebuilt from these at a repaint
const desk_bar_grant = 16080 // the header panel's grant and base
const desk_bar_base = 16088
const desk_mode_cell = 16096 // the display's mode packed, w above h
const desk_dock_grant = 16104 // the dock panel's grant and base
const desk_dock_base = 16112
const desk_painted_minute = 16120 // the minute the bar's clock painted
const cal_grant = 16128 // the calendar panel's grant and base —
const cal_base = 16136 // 0 the panel shut, a toplevel while it shows
const desk_hover = 16744 // the dock tile the pointer hovers, -1 none
                         // (emo-desktop M32, A32.2; the walk parked — see the loop)

// The wallpaper's file (emo-desktop M31, A31.1): the volume's RLE art
// read once at boot into the shell's scratch — the bytes at 131072,
// a 64 KiB cap over the whole cell map's head (the notify reply, the
// launcher's and the lock's cells all live below 17 KiB; the read's
// first staging at 16384 wiped them and the desktop's own boot proved
// the collision) — the size it answered, the ok cell the decode's one
// green light (a file missing or a header that names another mode
// leaves it zero, the flat ground's), and the name's own bytes beside.
const wall_file = 131072 // the file's bytes, 64 KiB at the 128 KiB line
const wall_file_len = 196608 // the bytes the answer wrote
const wall_file_ok = 196616 // the header's verdict, 0 or 1
const wall_name = 196624 // "wallpaper.rle", 13 bytes

// The launcher's and the lock's cells (emo-desktop M28), in the same
// scratch page: the search face's grant and base, the line's bytes and
// length, the lock face's two, the blind line's, the account file's
// read-back and its name, the catalog's sixteen rows and their count,
// and the digest's 32 bytes at the passwd's write.
const launch_grant = 16800 // the search face's grant and base —
const launch_base = 16808  // 0 the panel shut, a toplevel while it shows
const launch_line = 16816  // the search line's bytes, 24 the name bound
const launch_len = 16840   // the line's length
const lock_grant = 16848   // the lock face's grant and base
const lock_base = 16856
const lock_line = 16864    // the blind line's bytes, 64 the secret bound
const lock_len = 16928
const lock_file = 16992    // the account file's bytes read back
const lock_name = 17024    // the file's name, nine bytes
const apps_cat = 17056     // the catalog: sixteen rows, 32 bytes each —
const apps_count = 17568   // the name's bytes then its length
const lock_dgst = 17600    // the digest's 32 bytes at the passwd's write

// The notification center's cells (emo-desktop M25, A25.2), in the
// same scratch page: the take's reply (the packed head and the two
// lengths, 280 bytes at the service's bounds), the two surfaces' grant
// and base — 0 the seat empty, a toplevel and no surface the moment
// they show — and the id the card was last painted for, the repaint's
// change detector.
const notify_reply = 16384
const notify_head = 24
const notify_take_max = 280
const notify_toast_grant = 16704
const notify_toast_base = 16712
const notify_panel_grant = 16720
const notify_panel_base = 16728
const notify_painted = 16736

// The launcher's dock, repainted whole: the tiles with their dots.
def desk_dock(f ui_fb.raster.Strike, labels Array[String]) Void {
  // the lock's session: the strip's presents pause with the rest
  if peek64(buf + lock_grant) == 0 {
    desk_dock_live(f, labels)
  }
}

def desk_dock_live(f ui_fb.raster.Strike, labels Array[String]) Void {
  const mode = peek64(buf + desk_mode_cell)
  desk_strip_paint(f, peek64(buf + desk_dock_base),
    peek64(buf + desk_dock_grant),
    mode >> 32, mode & 4294967295, labels, -1, desk_running_mask() << 1)
}

// The launcher's one launch (emo-desktop A12.1; the live tile's open
// A16.3): the slot's exec by its own row — the pid lands in the slot,
// the dock repaints with the tile's dot lit, `desktop <name> up` on
// the wire. A live slot's tile is the app's own open now: the window
// raised to the top and named the focused one, the minimized one
// unhidden — the desktop's verb, the panel its authority. A pid whose
// window is not on the stack yet (the exec still loading) is the
// running line the tiles have always answered (`desktop <name>
// running` — the tiles name apps, not instances), and an exec the
// machine refuses speaks the stub's message, `desktop: <the reason>`.
def desk_launch(f ui_fb.raster.Strike, slot Int64, labels Array[String]) Void {
  var name = buf + desk_names + (slot * 12)
  if peek64(buf + desk_pids + (slot * 8)) != 0 {
    case syscall.win_desk_open(peek64(buf + desk_pids + (slot * 8))) {
      (R.error, _) then { desk_running_line(name, desk_nlen(slot)) }
      (R.ok, _) then {}
    }
  } else {
    var envp = buf + 18080
    var envn = put_base_env(envp)
    case syscall.exec_args_env(name, desk_flen(slot), 0, 0, envp, envn) {
      (R.error, why) then { shell.desk_err(why) }
      (R.ok, child) then {
        poke64(buf + desk_pids + (slot * 8), child)
        desk_up_line(name, desk_nlen(slot))
        desk_dock(f, labels)
        desk_chrome(f)
      }
    }
  }
}

// The exec command's half (emo-desktop A12.1, T1.4a): the line's
// name, then its arguments — the rest of the line, verbatim, the
// child's argv[1..] — the launcher's bookkeeping when it names one of
// the slots' own, and the volume's own when it does not.
def desk_exec_cmd(f ui_fb.raster.Strike, e Int64, n Int64, labels Array[String]) Void {
  var ns = shell.skip_spaces(e, n)
  var ne = shell.word_end(ns, n)
  if ns == n {
    shell.exec_badarg()
  } else {
    var name = shell.line_ptr() + ns
    var nlen = ne - ns
    var as = shell.skip_spaces(ne, n)
    var alen = n - as
    var args = shell.line_ptr() + as
    var slot = desk_slot_of(name, nlen)
    if slot >= 0 && peek64(buf + desk_pids + (slot * 8)) != 0 {
      desk_running_line(buf + desk_names + (slot * 12), desk_nlen(slot))
    } else {
      var envp = buf + 18080
      var envn = put_base_env(envp)
      case syscall.exec_args_env(name, nlen, args, alen, envp, envn) {
        (R.error, why) then { shell.desk_err(why) }
        (R.ok, child) then {
          if slot >= 0 {
            poke64(buf + desk_pids + (slot * 8), child)
            desk_up_line(buf + desk_names + (slot * 12), desk_nlen(slot))
            desk_dock(f, labels)
            desk_chrome(f)
          }
        }
      }
    }
  }
}

// ---- the desktop's icons (emo-desktop A13) ----
//
// The volume's own files as the desktop shows them: a flat file a
// document, a name's `/` prefix the folder that prefix names, the
// `.elf` apps never on the desktop — the dock's tiles name apps, the
// desktop's icons name the volume's papers and folders, the way macOS
// keeps them apart. The listing is the fs's answer; the view is its
// parse; the selection and the current folder are the two words of
// state a press moves. All of it scratch cells and typed loops — the
// view is rebuilt whole on every change (a boot, a command that
// touches the volume, a folder entered or left), and a rebuild is a
// few hundred bytes of pokes, not a tree.
//
//   entry: the name's bytes [0..24), its length at +24, its kind at +32
//     — 0 a document, 1 a folder, 2 the `..` way up. 40 bytes, and the
//     fs's own 64-entry table the bound the view never outgrows.
const desk_list = 9344 // the app catalog's bytes, the fs's newline form
const desk_list_len = 11392 // the bytes the answer wrote
const desk_list_fold = 11400 // the typed view's fold, the change detector
const desk_view = 11408 // the view's entries
const desk_view_count = 13968
const desk_tmp_len = 13960 // the typed listing's bytes (the view)

const desk_folder = 13976 // the current folder's prefix bytes
const desk_folder_len = 14000
const desk_sel = 14008 // the selected entry, -1 none
const desk_tmp = 14016 // the typed listing's buffer, the view's input
// Whether a name is an app's: the `.elf` the dock's slots carry, off
// the desktop.
def desk_is_elf(namep Int64, nlen Int64) Bool {
  if nlen < 4 {
    return false
  }
  return peek8(namep + nlen - 4) == 46B && peek8(namep + nlen - 3) == 101B && peek8(namep + nlen - 2) == 108B && peek8(namep + nlen - 1) == 102B
}

// Whether a name is the wallpaper's own file (emo-desktop M31, A31.1):
// the machine's picture is not a document — the view skips it the way
// it skips the apps' images, the volume's full truth still the `ls`
// and the `cat`'s.
def desk_is_wall(namep Int64, nlen Int64) Bool {
  if nlen != 13 {
    return false
  }
  return peek8(namep) == 119B && peek8(namep + 1) == 97B && peek8(namep + 2) == 108B && peek8(namep + 3) == 108B && peek8(namep + 4) == 112B && peek8(namep + 5) == 97B && peek8(namep + 6) == 112B && peek8(namep + 7) == 101B && peek8(namep + 8) == 114B && peek8(namep + 9) == 46B && peek8(namep + 10) == 114B && peek8(namep + 11) == 108B && peek8(namep + 12) == 101B
}

// One view entry written from a name's bytes; the next index back.
def desk_view_put(idx Int64, namep Int64, nlen Int64, kind Int64) Int64 {
  const e = buf + desk_view + (idx * 40)
  var i = 0
  while i < nlen {
    poke8(e + i, peek8(namep + i))
    i = i + 1
  }
  poke64(e + 24, nlen)
  poke64(e + 32, kind)
  return idx + 1
}

// Whether the view grown so far already shows that folder: two folders
// of one prefix are one icon, the dedupe the parse's own.
def desk_view_has(count Int64, namep Int64, nlen Int64) Bool {
  var i = 0
  while i < count {
    const e = buf + desk_view + (i * 40)
    if peek64(e + 24) == nlen && peek64(e + 32) == 1 {
      var same = true
      var k = 0
      while k < nlen {
        if peek8(e + k) != peek8(namep + k) {
          same = false
          k = nlen
        } else {
          k = k + 1
        }
      }
      if same {
        return true
      }
    }
    i = i + 1
  }
  return false
}

// The listing through the view's grammar, whole from scratch. At the
// root: a flat name a document, a prefixed name its folder once, the
// `.elf` rows and the wallpaper's own file skipped (emo-desktop M31,
// A31.1 — the machine's picture is not a document, the apps' images
// are not icons). Inside a folder F: the `..` way up first, then
// each name under F — the rest after `F/` a document of its own, or
// the subfolder its own prefix names, deduped the same way. A folder
// and a flat file of one spelling are both shown: they are two
// entries of the volume, and the view hides nothing else.
def desk_view_build() Void {
  var count = 0
  const folder_len = peek64(buf + desk_folder_len)
  if folder_len > 0 {
    const e = buf + desk_view
    poke8(e, 46B)
    poke8(e + 1, 46B)
    poke64(e + 24, 2)
    poke64(e + 32, 2)
    count = 1
  }
  // The typed listing (T1.2d): each record a kind byte, a length byte
  // and the name, already the current folder's immediate children —
  // the service did the grouping the view used to guess.
  const flen = peek64(buf + desk_tmp_len)
  var pos = 0
  while pos + 2 <= flen {
    const kind = peek8(buf + desk_tmp + pos).to_int64()
    const nlen = peek8(buf + desk_tmp + pos + 1).to_int64()
    const namep = buf + desk_tmp + pos + 2
    if nlen > 0 {
      if !desk_is_elf(namep, nlen) && !desk_is_wall(namep, nlen) {
        count = desk_view_put(count, namep, nlen, kind)
      }
    }
    pos = pos + 2 + nlen
  }
  poke64(buf + desk_view_count, count)
  // a selection past the view is no selection
  if peek64(buf + desk_sel) >= count {
    poke64(buf + desk_sel, -1)
  }
}

// The listing taken and its fold kept — the boot's one load, the
// refresh's comparison the command loop's.
def desk_list_load() Void {
  // The launcher's catalog reads the flat list (every name; the .elf
  // rows are its apps), the view the typed listing of the current
  // folder (T1.2d) — the service does the grouping now.
  case syscall.file_list(buf + desk_list, 2048) {
    (R.error, _) then { mark() }
    (R.ok, n) then { poke64(buf + desk_list_len, n) }
  }
  const flen = peek64(buf + desk_folder_len)
  case syscall.list_dir(buf + desk_folder, flen, buf + desk_tmp, 2048) {
    (R.error, _) then { mark() }
    (R.ok, n) then {
      poke64(buf + desk_tmp_len, n)
      var d = 0
      var i = 0
      while i < n {
        d = (d * 31 + peek8(buf + desk_tmp + i).to_int64()) & 4294967295
        i = i + 1
      }
      poke64(buf + desk_list_fold, d)
    }
  }
}

// ---- the metal's own painting (emo-desktop A13) ----
//
// The wallpaper and its icons are painted straight onto the buffer's
// bytes through the typed stores — the carve's own rule, and the
// round's find: the `Surface`'s methods are class bodies, and a class
// body boxes every word it computes into the arena for good (the pool
// reclaims the identities, the boxing never comes back — "left in the
// arena per repaint" is the dock's own comment). The first icon press
// died the second repaint: one surface-path repaint weighed as much as
// the boot had left. These defs are typed top-level ones, so a repaint
// costs no arena at all and the desktop repaints for a living. The
// shapes are the package's words (`emo_desktop.wall_top` and kin — the
// hosted canvas paints the same formula), so the golden's digest and
// the screendump's bytes are one design.

// The wallpaper's art, whole (emo-desktop M31, A31.1): the volume's
// RLE file decoded run by run onto the buffer — one fill a run,
// row-aligned, the walk the package's `wallpaper_decode` keeps on the
// hosted canvas, mirrored here because the call that paints must be
// the call that stays typed. The file the boot read (`wall_file_load`)
// is the art's only source; the procedural formula this replaces is
// the golden fixture's now. A boot whose volume carried no file (or
// one whose header names another mode) leaves the ok cell zero and
// the walk paints the flat ground — the gradient's deep end, the wall
// the desktop still stands on while the volume heals.
def desk_wallpaper_decode(base Int64, mw Int64, mh Int64) Void {
  if peek64(buf + wall_file_ok) == 0 {
    carve_fill(base, mw, 0, 0, mw, mh, emo_desktop.wall_top())
  } else {
    var x = 0
    var y = 0
    var at = buf + wall_file + 16
    const end = buf + wall_file + peek64(buf + wall_file_len)
    while at < end {
      const run = peek64(at)
      const count = run & 4294967295
      const color = run >> 32
      carve_fill(base, mw, x, y, count, 1, color)
      x = x + count
      if x == mw {
        x = 0
        y = y + 1
      }
      at = at + 8
    }
  }
}

// The wallpaper file's boot read (emo-desktop M31, A31.1): the
// volume's whole RLE into the shell's scratch, the header checked
// before the ok cell turns — the magic's word, the caller's own mode
// packed above the size's floor. The len cell is the attempt's mark
// (zero never tried, negative tried and refused, positive the size
// the answer wrote), so every chrome era's first paint can want the
// art and only the first gets the read — the desk pass's strip paints
// before the desktop's own boot ever ran (A31.2's find: the era's
// strip wore the flat ground and its digest said so). A read refused,
// a size past the scratch, a foreign magic, a foreign mode: all one
// verdict, the flat ground's.
def put_wall_name(a Int64) Int64 {
  poke8(a, 119B)      // w
  poke8(a + 1, 97B)   // a
  poke8(a + 2, 108B)  // l
  poke8(a + 3, 108B)  // l
  poke8(a + 4, 112B)  // p
  poke8(a + 5, 97B)   // a
  poke8(a + 6, 112B)  // p
  poke8(a + 7, 101B)  // e
  poke8(a + 8, 114B)  // r
  poke8(a + 9, 46B)   // .
  poke8(a + 10, 114B) // r
  poke8(a + 11, 108B) // l
  poke8(a + 12, 101B) // e
  return 13
}

def wall_file_load(mode Int64) Void {
  if peek64(buf + wall_file_len) == 0 {
    poke64(buf + wall_file_ok, 0)
    poke64(buf + wall_file_len, -1)
    const n = put_wall_name(buf + wall_name)
    const mw = mode >> 32
    const mh = mode & 4294967295
    case syscall.file_read(buf + wall_name, n, buf + wall_file, 65536) {
      (R.error, _) then {}
      (R.ok, size) then {
        if size >= 16 && size <= 65536 {
          if peek64(buf + wall_file) == 0x314C4C41574F4D45 {
            const wh = peek64(buf + wall_file + 8)
            if (wh & 4294967295) == mw && (wh >> 32) == mh {
              poke64(buf + wall_file_len, size)
              poke64(buf + wall_file_ok, 1)
            }
          }
        }
      }
    }
  }
}

// One row of the chrome's material at the display row `gy`, painted at
// the buffer's local `ly`: the scratch's own runs replayed — the file
// the boot read is the art's truth, the row's colors walked and filled
// whole, the scrim over the row — the package's `material_row`
// mirrored (D8's sample now the art's own, A31.2), the call that
// paints the call that stays typed. A boot whose volume carried no
// art paints the flat ground's row under the scrim.
def desk_chrome_row(base Int64, mw Int64, ly Int64, gy Int64, scrim Int64) Void {
  if peek64(buf + wall_file_ok) == 0 {
    carve_fill(base, mw, 0, ly, mw, 1, emo_desktop.wall_top())
  } else {
    var x = 0
    var y = 0
    var at = buf + wall_file + 16
    const end = buf + wall_file + peek64(buf + wall_file_len)
    while at < end && y <= gy {
      const run = peek64(at)
      const count = run & 4294967295
      const color = run >> 32
      if y == gy {
        carve_fill(base, mw, x, ly, count, 1, color)
      }
      x = x + count
      if x == mw {
        x = 0
        y = y + 1
      }
      at = at + 8
    }
  }
  carve_blend(base, mw, 0, ly, mw, 1, scrim)
}

// The palette's accent, the shell's own read (emo-desktop M31, A31.2):
// the scratch's runs walked — the most chromatic color at the ink
// energy the scaling answers, the package's `palette_accent` mirrored,
// the same floor and the same 232 the channels climb to. No file, no
// chroma past the floor: -1, the constants the wear falls back to.
def desk_palette_accent() Int64 {
  var best = -1
  var best_hi = 0
  var best_sat = 47
  if peek64(buf + wall_file_ok) != 0 {
    var at = buf + wall_file + 16
    const end = buf + wall_file + peek64(buf + wall_file_len)
    while at < end {
      const color = peek64(at) >> 32
      const r = (color >> 16) & 255
      const g = (color >> 8) & 255
      const b = color & 255
      var hi = r
      var lo = r
      if g > hi {
        hi = g
      }
      if g < lo {
        lo = g
      }
      if b > hi {
        hi = b
      }
      if b < lo {
        lo = b
      }
      if hi - lo > best_sat {
        best_sat = hi - lo
        best_hi = hi
        best = color
      }
      at = at + 8
    }
  }
  if best < 0 {
    return -1
  }
  const r = (best >> 16) & 255
  const g = (best >> 8) & 255
  const b = best & 255
  return (((r * 232) / best_hi) << 16) | (((g * 232) / best_hi) << 8) |
    ((b * 232) / best_hi)
}

// A label's glyphs along one line from `(x, y)`, the line box's
// top-left — the package's `text` walk through the carve's typed ink,
// one call a glyph, no interface between.
def desk_text(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, label String, x Int64, y Int64, ink_color Int64) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  var pen = x
  var i = 0
  while i < label.length() {
    const g = f.glyph_of(label.substring(i, 1))
    ui_fb_winbuf.carve_ink(base, dims, pen, y, f, g, ink_color)
    pen = pen + f.advance(g)
    i = i + 1
  }
}

// `<n> apps` ending one pad short of `right` — the package's
// `count_text` mirrored, the digits' advances summed before they are
// drawn.
def desk_count_text(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, right Int64, y Int64, n Int64, ink_color Int64) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  var div = 1
  while n / div >= 10 {
    div = div * 10
  }
  var digits_w = 0
  var d = div
  while d > 0 {
    digits_w = digits_w + f.advance(17 + ((n / d) % 10))
    d = d / 10
  }
  var p = right - digits_w - ui_fb.text_width(f, " apps")
  while div > 0 {
    ui_fb_winbuf.carve_ink(base, dims, p, y, f, 17 + ((n / div) % 10), ink_color)
    p = p + f.advance(17 + ((n / div) % 10))
    div = div / 10
  }
  desk_text(f, base, mw, mh, " apps", p, y, ink_color)
}

// The header bar whole: the material's rows, the wordmark one pad in,
// the pager's four cells after the bell, the wall clock at the right
// edge and the running count before it — the package's `paint_header`
// mirrored, every call the carve's own. The clock is `now`, the
// seconds the caller read (the time verb); the desks are the pager's
// word, the query verb's packing (emo-desktop M27, A27.2) — the active
// desk's cell the accent's ground, a live desk's the inked number, an
// empty desk's the dim one.
def desk_bar_paint(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, running Int64, now Int64, desks Int64) Void {
  var y = 0
  while y < emo_desktop.header_height() {
    desk_chrome_row(base, mw, y, y, emo_desktop.header_scrim())
    y = y + 1
  }
  const ty = (emo_desktop.header_height() - f.line_height()) / 2
  const extracted = desk_palette_accent()
  var acc = extracted
  if acc < 0 {
    acc = emo_desktop.header_accent()
  }
  desk_text(f, base, mw, emo_desktop.header_height(), "EmoOS", 8, ty, acc)
  const cw = ui_fb.text_width(f, emo_desktop.clock_text(0))
  desk_text(f, base, mw, emo_desktop.header_height(), emo_desktop.clock_text(now), mw - emo_desktop.icon_margin() - cw, ty, emo_desktop.header_ink())
  desk_count_text(f, base, mw, emo_desktop.header_height(), mw - emo_desktop.icon_margin() - cw - 16, ty, running, emo_desktop.header_ink())
  // The walk's annotation (emo-desktop M32, A32.3, D13): the free half
  // of the desks word the slide's caller annotates — the from cell,
  // the frame and the steps, four bits each from the twelfth up; the
  // mask the walk starts from the word's own occupancy field. The
  // typed twin of the package's walk branch: the cells in the state
  // the walk starts from, the accent on the eased x between the cells
  // (the vocabulary's own decay), the destination's number its own.
  if desks >> 12 != 0 {
    const wfrom = (desks >> 12) & 15
    const wt = (desks >> 16) & 15
    const wsteps = (desks >> 20) & 15
    const wmask = (desks >> 8) & 15
    const wto = desks & 255
    const dims = ui_fb_winbuf.pack(mw, emo_desktop.header_height())
    var wi = 0
    while wi < emo_desktop.pager_count() {
      const pc = emo_desktop.pager_cell(f, wi)
      const px = pc >> 32
      const py = pc & 4294967295
      var ground = 0
      var ink_color = emo_desktop.pager_empty_ink()
      if (wmask >> wi) & 1 == 1 {
        ground = emo_desktop.pager_occupied_ground()
        ink_color = emo_desktop.pager_occupied_ink()
      }
      if ground != 0 {
        ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(px, py),
          ui_fb_winbuf.pack(emo_desktop.pager_size(), emo_desktop.pager_size()),
          4, ground, ground)
      }
      const ns = "${wi + 1}"
      desk_text(f, base, mw, emo_desktop.header_height(), ns,
        px + (emo_desktop.pager_size() - ui_fb.text_width(f, ns)) / 2,
        py + (emo_desktop.pager_size() - f.line_height()) / 2, ink_color)
      wi = wi + 1
    }
    const c0 = emo_desktop.pager_cell(f, wfrom)
    const c1 = emo_desktop.pager_cell(f, wto)
    const wx = (c0 >> 32) + emo_desktop.ease_out((c1 >> 32) - (c0 >> 32), wt,
      wsteps)
    var wground = emo_desktop.pager_active_ground()
    if extracted >= 0 {
      wground = 0xFF000000 | extracted
    }
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(wx, c0 & 4294967295),
      ui_fb_winbuf.pack(emo_desktop.pager_size(), emo_desktop.pager_size()),
      4, wground, wground)
    const wns = "${wto + 1}"
    desk_text(f, base, mw, emo_desktop.header_height(), wns,
      wx + (emo_desktop.pager_size() - ui_fb.text_width(f, wns)) / 2,
      (c0 & 4294967295) + (emo_desktop.pager_size() - f.line_height()) / 2,
      emo_desktop.pager_active_ink())
  } else {
    const active = desks & 255
    const mask = (desks >> 8) & 15
    var i = 0
    while i < emo_desktop.pager_count() {
      const pc = emo_desktop.pager_cell(f, i)
      const px = pc >> 32
      const py = pc & 4294967295
      var ground = 0
      var ink_color = emo_desktop.pager_empty_ink()
      if i == active {
        ground = emo_desktop.pager_active_ground()
        if extracted >= 0 {
          ground = 0xFF000000 | extracted
        }
        ink_color = emo_desktop.pager_active_ink()
      } else {
        if (mask >> i) & 1 == 1 {
          ground = emo_desktop.pager_occupied_ground()
          ink_color = emo_desktop.pager_occupied_ink()
        }
      }
      const dims = ui_fb_winbuf.pack(mw, emo_desktop.header_height())
      if ground != 0 {
        ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(px, py),
          ui_fb_winbuf.pack(emo_desktop.pager_size(), emo_desktop.pager_size()),
          4, ground, ground)
      }
      const ns = "${i + 1}"
      desk_text(f, base, mw, emo_desktop.header_height(), ns,
        px + (emo_desktop.pager_size() - ui_fb.text_width(f, ns)) / 2,
        py + (emo_desktop.pager_size() - f.line_height()) / 2, ink_color)
      i = i + 1
    }
  }
}

// The icon family's typed twins (emo-desktop M31, A31.3): the shapes
// file's marks on the carve and on the launcher's slab — the same
// geometry the package's `paint_icon` walks, the carve's roundeds the
// dock's tiles wear, the slab's stores the straight-alpha truth the
// launcher keeps (the fill's RGB write the trap A30.1 recorded), the
// call that paints the call that stays typed.
def desk_icon_paint(base Int64, w Int64, idx Int64, x Int64,
                    y Int64, size Int64, fg Int64, back Int64) Void {
  const dims = ui_fb_winbuf.pack(w, emo_desktop.strip_height())
  if idx == 0 {
    // the fills the canvas fill's own contract: the RGB the word
    // keeps, the alpha byte stripped (the tiles are opaque — the
    // icons' ink lands verbatim either way — the digests read the
    // fourth byte)
    ui_fb_winbuf.carve_fill(base, w, x, y + 2 * (size / 5), size, size / 5,
      fg & 16777215)
    ui_fb_winbuf.carve_fill(base, w, x + 2 * (size / 5), y, size / 5, size,
      fg & 16777215)
  } else {
    if idx == 1 {
      ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(x, y),
        ui_fb_winbuf.pack(size * 3 / 5, size / 3), 2, fg, fg)
      ui_fb_winbuf.carve_rounded(base, dims,
        ui_fb_winbuf.pack(x, y + size / 4),
        ui_fb_winbuf.pack(size, size * 3 / 4), 3, fg, fg)
    } else {
      if idx == 2 || idx < 0 {
        ui_fb_winbuf.carve_rounded(base, dims,
          ui_fb_winbuf.pack(x + size / 8, y),
          ui_fb_winbuf.pack(size * 3 / 4, size), 2, fg, fg)
        ui_fb_winbuf.carve_rounded(base, dims,
          ui_fb_winbuf.pack(x + size * 7 / 8 - size / 4, y),
          ui_fb_winbuf.pack(size / 4, size / 4), 2, back, back)
      } else {
        ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(x, y),
          ui_fb_winbuf.pack(size, size), size / 2, fg, fg)
        ui_fb_winbuf.carve_rounded(base, dims,
          ui_fb_winbuf.pack(x + size / 4, y + size / 4),
          ui_fb_winbuf.pack(size / 2, size / 2), size / 4, back, back)
      }
    }
  }
}

def desk_slab_fill(c Carve, x Int64, y Int64, w Int64, h Int64,
                   color Int64) Void {
  var py = y
  while py < y + h {
    var px = x
    while px < x + w {
      c.store(px, py, color)
      px = px + 1
    }
    py = py + 1
  }
}

def desk_slab_rounded(c Carve, x Int64, y Int64, w Int64, h Int64,
                      rad Int64, color Int64) Void {
  var py = y
  while py < y + h {
    var px = x
    while px < x + w {
      const cov = ui_fb.fill_cover(ui_fb.shape_sd(px, py, x, y, w, h,
        ui_fb.radius_in(rad, w, h)))
      if cov > 0 {
        // the word the cover's own arithmetic writes (emo-desktop M31,
        // A31.3): the color's alpha byte under the coverage, the shift
        // form's rounding, the ground's 0xE6 the fold's notch and the
        // ring's hole keep
        const t = ((color >> 24) & 255) * cov + 128
        c.store(px, py, ((t + (t >> 8)) >> 8) << 24 | (color & 0xFFFFFF))
      }
      px = px + 1
    }
    py = py + 1
  }
}

def desk_icon_slab(c Carve, idx Int64, x Int64, y Int64, size Int64,
                   fg Int64, back Int64) Void {
  if idx == 0 {
    desk_slab_fill(c, x, y + 2 * (size / 5), size, size / 5, fg)
    desk_slab_fill(c, x + 2 * (size / 5), y, size / 5, size, fg)
  } else {
    if idx == 1 {
      desk_slab_rounded(c, x, y, size * 3 / 5, size / 3, 2, fg)
      desk_slab_rounded(c, x, y + size / 4, size, size * 3 / 4, 3, fg)
    } else {
      if idx == 2 || idx < 0 {
        desk_slab_rounded(c, x + size / 8, y, size * 3 / 4, size, 2, fg)
        desk_slab_rounded(c, x + size * 7 / 8 - size / 4, y, size / 4,
          size / 4, 2, back)
      } else {
        desk_slab_rounded(c, x, y, size, size, size / 2, fg)
        desk_slab_rounded(c, x + size / 4, y + size / 4, size / 2, size / 2,
          size / 4, back)
      }
    }
  }
}

// The dock's strip whole: the material's rows, the shelf's shadow and
// the shelf over it, then one drawn icon per app — the rounded square
// graded, the app's mark centered in it (A31.3, the shapes file's
// strike), the running dot at its foot — the package's `paint`
// mirrored. `top` is the display row the strip's first row stands on;
// the material the art's own rows replayed.
def desk_dock_paint(f ui_fb.raster.Strike, base Int64, mw Int64, top Int64, labels Array[String], focused Int64, running Int64) Void {
  const sh = emo_desktop.strip_height()
  const dims = ui_fb_winbuf.pack(mw, sh)
  var ly = 0
  while ly < sh {
    desk_chrome_row(base, mw, ly, top + ly, emo_desktop.dock_scrim())
    ly = ly + 1
  }
  const sx = emo_desktop.shelf_pad()
  const sy = emo_desktop.shelf_top_pad()
  const sw = mw - emo_desktop.shelf_pad() * 2
  const shh = emo_desktop.shelf_height()
  ui_fb_winbuf.carve_shadow(base, dims, ui_fb_winbuf.pack(sx, sy),
    ui_fb_winbuf.pack(sw, shh), emo_desktop.shelf_radius(),
    emo_desktop.shelf_soft(), 0x80000000)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(sx, sy),
    ui_fb_winbuf.pack(sw, shh), emo_desktop.shelf_radius(),
    emo_desktop.shelf_top(), emo_desktop.shelf_bottom())
  var i = 0
  while i < labels.length() {
    const tx = emo_desktop.tile_x(i)
    const ty = emo_desktop.tile_y()
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(tx, ty),
      ui_fb_winbuf.pack(emo_desktop.tile_size(), emo_desktop.tile_size()), 8,
      emo_desktop.tile_top(i == focused), emo_desktop.tile_bottom(i == focused))
    desk_icon_paint(base, mw, emo_desktop.icon_of(labels[i]),
      tx + (emo_desktop.tile_size() - emo_desktop.icon_size(emo_desktop.tile_size())) / 2,
      ty + (emo_desktop.tile_size() - emo_desktop.icon_size(emo_desktop.tile_size())) / 2,
      emo_desktop.icon_size(emo_desktop.tile_size()), emo_desktop.icon_ink(),
      ui_fb.grade(emo_desktop.tile_top(i == focused),
        emo_desktop.tile_bottom(i == focused),
        emo_desktop.tile_size() / 2, emo_desktop.tile_size()))
    if (running >> i) & 1 == 1 {
      ui_fb_winbuf.carve_fill(base, mw, tx + 14, ty + 26, 4, 4, emo_desktop.ink())
    }
    i = i + 1
  }
  var pp = byte_at(0, 68) // D
  pp = byte_at(pp, 79) // O
  pp = byte_at(pp, 84) // T
  pp = byte_at(pp, 32)
  var dx = emo_desktop.tile_x(1) + 13
  while dx < emo_desktop.tile_x(1) + 20 {
    pp = num_at(peek8(base + (30 * mw + dx) * 4 + 2).to_int64(), pp)
    pp = byte_at(pp, 44) // ,
    pp = num_at(peek8(base + (30 * mw + dx) * 4 + 1).to_int64(), pp)
    pp = byte_at(pp, 44)
    pp = num_at(peek8(base + (30 * mw + dx) * 4).to_int64(), pp)
    pp = byte_at(pp, 32)
    dx = dx + 1
  }
  pp = byte_at(pp, 10)
  gate_line(pp)
  var qp = byte_at(0, 71) // G
  qp = byte_at(qp, 51) // 3
  qp = byte_at(qp, 48) // 0
  qp = byte_at(qp, 32)
  var qx = emo_desktop.tile_x(1) + 7
  while qx < emo_desktop.tile_x(1) + 17 {
    qp = num_at(peek8(base + (30 * mw + qx) * 4 + 2).to_int64(), qp)
    qp = byte_at(qp, 44)
    qp = num_at(peek8(base + (30 * mw + qx) * 4 + 1).to_int64(), qp)
    qp = byte_at(qp, 44)
    qp = num_at(peek8(base + (30 * mw + qx) * 4).to_int64(), qp)
    qp = byte_at(qp, 44)
    qp = num_at(peek8(base + (30 * mw + qx) * 4 + 3).to_int64(), qp)
    qp = byte_at(qp, 32)
    qx = qx + 1
  }
  qp = byte_at(qp, 10)
  gate_line(qp)
}

// A dock strip repainted whole — the paint, the frame's digest line,
// the present — the shape the launcher's dock repaints through and the
// desk pass's with it; the buffer's own grant and base the caller
// names.
def desk_strip_paint(f ui_fb.raster.Strike, base Int64, grant Int64, mw Int64, mh Int64, labels Array[String], focused Int64, running Int64) Void {
  desk_dock_paint(f, base, mw, mh - emo_desktop.strip_height(), labels, focused, running)
  frame_line(carve_digest(base, mw, emo_desktop.strip_height()))
  case syscall.present(grant, 0, 0, mw, emo_desktop.strip_height()) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// One tile's place repainted and the strip presented (emo-desktop M32,
// A32.2): the package's painter through the carve's typed walk — the
// shelf's own repaint clearing the tile's travel, the tile at its
// lifted seat — then the strip's whole commit. The walk's states the
// corpus pins; the tile-sized rect the present could name waits on the
// compositor's answer to a partial one.
def desk_tile_walk(i Int64, labels Array[String], running Bool, lift Int64,
                   focused Bool, hovered Bool) Void {
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const base = peek64(buf + desk_dock_base)
  emo_desktop.paint_tile(Carve.new(base: base, width: mw,
    height: emo_desktop.strip_height()), i,
    emo_desktop.icon_of(labels[i]), running, lift, focused, hovered, mw)
  frame_line(carve_digest(base, mw, emo_desktop.strip_height()))
  case syscall.present(peek64(buf + desk_dock_grant), 0, 0, mw,
    emo_desktop.strip_height()) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// The name's byte under the box: the type's glyph of that byte's own
// arithmetic, the missing glyph past the printable span — the package's
// `text_byte` rule, through the carve's typed walk — and the advance the
// next byte's pen moves by.
def desk_name_byte(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, x Int64, y Int64, b Int64) Int64 {
  var i = b - 31
  if i < 1 || i > 95 {
    i = 0
  }
  ui_fb_winbuf.carve_ink(base, ui_fb_winbuf.pack(mw, mh), x, y, f, i, 0xF8F8F0)
  return f.advance(i)
}

// A document icon at its cell: the selection's rounded blend first,
// then the page a graded rounded square with its folded corner and
// three text lines over it — the package's `paint_icon_doc` shapes,
// at the cell origin the package's `icon_cell` packed.
def desk_icon_doc(base Int64, mw Int64, mh Int64, cx Int64, cy Int64, selected Bool) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  if selected {
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(cx + 2, cy + 1),
      ui_fb_winbuf.pack(92, 74), 10, emo_desktop.select_ink(),
      emo_desktop.select_ink())
  }
  const ix = cx + emo_desktop.icon_off_x()
  const iy = cy + emo_desktop.icon_off_y()
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 8, iy + 2),
    ui_fb_winbuf.pack(28, 40), 4, 0xFFF2F2F8, 0xFFD8DAE4)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 28, iy + 2),
    ui_fb_winbuf.pack(8, 8), 2, 0xFFC2C8D4, 0xFFC2C8D4)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 16),
    ui_fb_winbuf.pack(16, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 24),
    ui_fb_winbuf.pack(16, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 32),
    ui_fb_winbuf.pack(10, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
}

// A folder icon at its cell: the tab and the body in the folder blue,
// the body graded from its light along the top to its shade at the
// foot — the package's `paint_icon_folder` shapes.
def desk_icon_folder(base Int64, mw Int64, mh Int64, cx Int64, cy Int64, selected Bool) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  if selected {
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(cx + 2, cy + 1),
      ui_fb_winbuf.pack(92, 74), 10, emo_desktop.select_ink(),
      emo_desktop.select_ink())
  }
  const ix = cx + emo_desktop.icon_off_x()
  const iy = cy + emo_desktop.icon_off_y()
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 6, iy + 8),
    ui_fb_winbuf.pack(16, 9), 3, 0xFF4098E0, 0xFF4098E0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 4, iy + 13),
    ui_fb_winbuf.pack(36, 25), 4, 0xFF5FA8E8, 0xFF327FC2)
}

// The view's icons over the wallpaper: a document or a folder per
// entry, the selection's blend behind the one selected, the name's
// bytes under the box — ten cells of it shown (a display name's cut;
// the volume's own spelling is what the commands read).
def desk_icons_paint(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64) Void {
  const count = peek64(buf + desk_view_count)
  const sel = peek64(buf + desk_sel)
  var i = 0
  while i < count {
    const cell = emo_desktop.icon_cell(i, mw, mh)
    const cx = cell >> 32
    const cy = cell & 4294967295
    const e = buf + desk_view + (i * 40)
    const kind = peek64(e + 32)
    if kind == 0 {
      desk_icon_doc(base, mw, mh, cx, cy, i == sel)
    } else {
      desk_icon_folder(base, mw, mh, cx, cy, i == sel)
    }
    var shown = peek64(e + 24)
    if shown > 10 {
      shown = 10
    }
    var k = 0
    var pen = cx + 8
    while k < shown {
      pen = pen + desk_name_byte(f, base, mw, mh, pen, cy + 56, peek8(e + k).to_int64())
      k = k + 1
    }
    i = i + 1
  }
}

// The wallpaper whole, repainted: the art, the icons, the digest's
// frame line, the present — the surface nothing but its grant and its
// bytes, no class, no interface, no arena spent.
def desk_wall_repaint(f ui_fb.raster.Strike) Void {
  const base = peek64(buf + desk_wall_base)
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const mh = mode & 4294967295
  desk_wallpaper_decode(base, mw, mh)
  desk_icons_paint(f, base, mw, mh)
  frame_line(carve_digest(base, mw, mh))
  case syscall.present(peek64(buf + desk_wall_grant), 0, 0, mw, mh) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// The header bar repainted: the running count and the wall clock are
// the two live facts it carries — a launch or a death the one news,
// the minute's turn the other. Every paint says the seconds it drew
// from (`clock <epoch>`, the golden's own provenance) and the minute
// cell keeps, so a wake compares and the next minute's first wake
// repaints.
def desk_chrome(f ui_fb.raster.Strike) Void {
  // the lock's session (emo-desktop M28): the face holds the display,
  // the chrome's presents pause — the bar's clock lags the minutes it
  // spends under the face, the next wake after the lift catches up
  if peek64(buf + lock_grant) == 0 {
    desk_chrome_live(f)
  }
}

def desk_chrome_live(f ui_fb.raster.Strike) Void {
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const mh = mode & 4294967295
  const m = desk_running_mask()
  var running = 0
  if (m & 1) == 1 {
    running = running + 1
  }
  if (m & 2) == 2 {
    running = running + 1
  }
  if (m & 4) == 4 {
    running = running + 1
  }
  var now = 0
  case syscall.time() {
    (R.error, _) then { mark() }
    (R.ok, t) then { now = t }
  }
  // The desks are the bar's third live fact (emo-desktop M27, A27.2):
  // the query read per paint, the clock's own habit — the word the
  // compositor packed, the active desk and the occupancy, and every
  // paint says the state it drew from.
  var desks = 0
  case syscall.desk_workspace() {
    (R.error, _) then { mark() }
    (R.ok, d) then { desks = d }
  }
  desk_line(desks)
  clock_line(now)
  poke64(buf + desk_painted_minute, now / 60)
  const base = peek64(buf + desk_bar_base)
  desk_bar_paint(f, base, mw, mh, running, now, desks)
  notify_bell_paint(f, base, mw)
  frame_line(carve_digest(base, mw, emo_desktop.header_height()))
  case syscall.present(peek64(buf + desk_bar_grant), 0, 0, mw, emo_desktop.header_height()) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// The workspace's slide frame (emo-desktop M32, A32.3, D13): the bar
// painted whole at the walk's annotated word — the cells in the state
// the walk starts from, the accent on its eased way — the bell and the
// digest's frame line and the bar's present after. The cut itself
// stays the compositor's one recomposition; the chrome the user sees
// move is these frames, the present's reply pacing each (D12).
def desk_bar_slide_paint(f ui_fb.raster.Strike, od Int64, pd Int64, t Int64,
                         steps Int64) Void {
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const mh = mode & 4294967295
  const m = desk_running_mask()
  var running = 0
  if (m & 1) == 1 {
    running = running + 1
  }
  if (m & 2) == 2 {
    running = running + 1
  }
  if (m & 4) == 4 {
    running = running + 1
  }
  var now = 0
  case syscall.time() {
    (R.error, _) then { mark() }
    (R.ok, tm) then { now = tm }
  }
  const desks = pd | (od & 0xF00) | ((od & 255) << 12) | (t << 16) |
    (steps << 20)
  const base = peek64(buf + desk_bar_base)
  desk_bar_paint(f, base, mw, mh, running, now, desks)
  notify_bell_paint(f, base, mw)
  frame_line(carve_digest(base, mw, emo_desktop.header_height()))
  case syscall.present(peek64(buf + desk_bar_grant), 0, 0, mw,
    emo_desktop.header_height()) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// A press on the desktop's own ground: an icon's cell, or the bare
// wallpaper. A document the selection moves (and the repaint only when
// it moved); a folder the door into its prefix; the `..` the way up —
// the prefix's last part struck. A bare press clears the selection,
// the way a click on bare desktop does; nothing to clear, nothing to
// repaint.
def desk_icon_press(f ui_fb.raster.Strike, hit Int64) Void {
  if hit < 0 {
    if peek64(buf + desk_sel) != -1 {
      poke64(buf + desk_sel, -1)
      desk_wall_repaint(f)
    }
  } else {
    const e = buf + desk_view + (hit * 40)
    const kind = peek64(e + 32)
    if kind == 0 {
      if peek64(buf + desk_sel) != hit {
        poke64(buf + desk_sel, hit)
        desk_wall_repaint(f)
      }
    } else {
      // the folder's door, both ways
      const nlen = peek64(e + 24)
      const flen = peek64(buf + desk_folder_len)
      if kind == 1 {
        // in: the view's name appended to the current prefix, `/`
        // between — the separator's slot only when a prefix is there
        // to separate (the root's child starts at the buffer's head)
        var at = flen
        if flen > 0 {
          poke8(buf + desk_folder + flen, 47B)
          at = flen + 1
        }
        var i = 0
        while i < nlen {
          poke8(buf + desk_folder + at + i, peek8(e + i))
          i = i + 1
        }
        poke64(buf + desk_folder_len, at + nlen)
      } else {
        // up: the prefix's last part struck, the root when none is left
        if flen > 0 {
          var last = -1
          var k = 0
          while k < flen {
            if peek8(buf + desk_folder + k) == 47B {
              last = k
            }
            k = k + 1
          }
          if last < 0 {
            poke64(buf + desk_folder_len, 0)
          } else {
            poke64(buf + desk_folder_len, last)
          }
        }
      }
      poke64(buf + desk_sel, -1)
      desk_list_load()
      desk_view_build()
      desk_wall_repaint(f)
    }
  }
}

// The volume may have changed under a command (`write`, `rm`): the
// re-list's fold is the change detector, the copy, the rebuild and the
// repaint the answer. An unchanged fold is the common case, and it
// costs one list and one fold — no present, no frame.
def desk_icons_refresh(f ui_fb.raster.Strike) Void {
  const flen = peek64(buf + desk_folder_len)
  case syscall.list_dir(buf + desk_folder, flen, buf + desk_tmp, 2048) {
    (R.error, _) then { mark() }
    (R.ok, n) then {
      var d = 0
      var i = 0
      while i < n {
        d = (d * 31 + peek8(buf + desk_tmp + i).to_int64()) & 4294967295
        i = i + 1
      }
      if d != peek64(buf + desk_list_fold) {
        poke64(buf + desk_tmp_len, n)
        poke64(buf + desk_list_fold, d)
        desk_view_build()
        // the launcher's catalog: the flat list, reloaded when the
        // view moved (the apps are the .elf rows)
        case syscall.file_list(buf + desk_list, 2048) {
          (R.error, _) then { mark() }
          (R.ok, m) then {
            poke64(buf + desk_list_len, m)
            desk_apps_build()
          }
        }
        desk_wall_repaint(f)
      }
    }
  }
}

// `desktop icons <n>` — the wallpaper's first present's annotation,
// the count the view grew.
def desk_icons_line() Void {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 32) // space
  p = byte_at(p, 105) // i
  p = byte_at(p, 99) // c
  p = byte_at(p, 111) // o
  p = byte_at(p, 110) // n
  p = byte_at(p, 115) // s
  p = byte_at(p, 32) // space
  p = num_at(peek64(buf + desk_view_count), p)
  p = byte_at(p, 10)
  gate_line(p)
}


// The interface strike, built on demand: the Inter face at 16 pixels —
// the boot copies its words into the desk's scratch, and the surface
// passes that hold one carry it to the verb.
def desk_strike() (R, ui_fb.raster.Strike) {
  return ui_fb.raster.strike(ui_fb.raster.inter(), 16)
}

// ---- the notification center's face (emo-desktop M25, A25.2) ----
//
// The shell is the notification center by construction (D16): the
// metal provider polls the gate's take verb once per wake — the desk
// loop's own turn is the shell's tick, the heartbeat EmoOS's stream
// does not yet carry — and the center's state is the package's. The
// two surfaces are the shell's own toplevels: the card (the toast) and
// the panel (the history), made when they first show and closed when
// they go. The compositor's walk masks a toplevel's corners and lays
// its shadow ring for free, so a surface paints the card's ground and
// words alone.
//
// The stack holds eight surfaces (EmoOS's comp_entries): the shell's
// three, three apps' windows, and these two fill it — a fourth app's
// window is the compositor's resource refusal, the milestone's own
// bound, not this face's.

// One take (D14): the packed head's id and lengths, the title's and
// the body's bytes copied into Strings. The empty answer is `empty`,
// the canonical quiet reply — absence visible, never fabricated (D15).
def notify_take_once() (R, emo_notify.Notif) {
  case syscall.notify_take(buf + notify_reply, notify_take_max) {
    (R.error, why) then { return (R.error, why) }
    (R.ok, n) then {
      if n == 0 {
        return (R.error, "empty")
      }
      const id = peek64(buf + notify_reply)
      const tlen = peek64(buf + notify_reply + 8)
      const blen = peek64(buf + notify_reply + 16)
      const title = notify_str(buf + notify_reply + notify_head, tlen)
      const body = notify_str(buf + notify_reply + notify_head + tlen, blen)
      return (R.ok, emo_notify.notif(id, title, body))
    }
  }
}

// The packed bytes as a String: a Bytes of the length, the bytes read
// off the scratch one at a time, the reinterpretation back.
def notify_str(a Int64, n Int64) String {
  const b = Bytes.new(n)
  var i = 0
  while i < n {
    b.set(i, peek8(a + i).to_int64())
    i = i + 1
  }
  return b.to_string()
}

class MetalFeed {
  def take() (R, emo_notify.Notif) {
    return notify_take_once()
  }
}

def metal_feed() MetalFeed {
  return MetalFeed.new()
}

// The card's ground and words, its window whole (emo-desktop A25.3):
// the package's own drawing through the carve — the same words the
// hosted twin paints, so the surface's digest is the corpus's number.
// The window's memory is the allocator's, not a fresh canvas: the
// card's alpha grades composite over the ground, so the buffer is
// zeroed first.
def notify_card_paint(f ui_fb.raster.Strike, base Int64, w Int64, h Int64,
                      n emo_notify.Notif) Void {
  ui_fb_winbuf.carve_fill(base, w, 0, 0, w, h, 0)
  emo_notify.paint_card(Carve.new(base: base, width: w, height: h), f, 0, 0, n)
}

// The panel's ground and rows, its window whole: the package's
// `paint_center` in the window's own coordinates — the header line,
// the do-not-disturb row with its state word, then the history newest
// first, one row per entry the height holds.
def notify_panel_paint(f ui_fb.raster.Strike, base Int64, w Int64, h Int64,
                       c emo_notify.Center) Void {
  ui_fb_winbuf.carve_fill(base, w, 0, 0, w, h, 0)
  emo_notify.paint_panel(Carve.new(base: base, width: w, height: h), f, 0, 0,
    w, h, c)
}

// A shell surface made and placed: a toplevel at (x, y), its grant and
// base into the cells. False is the compositor's refusal (the stack
// full), and nothing is left behind — the ask is the caller's.
def notify_open(grant_cell Int64, base_cell Int64, w Int64, h Int64,
                x Int64, y Int64) Bool {
  return notify_open_role(grant_cell, base_cell, w, h, x, y, 0)
}

// The role-taking variant (emo-desktop M30, A30.1): the launcher's
// search face declares itself a panel — the panel pass paints it
// without the walk's mask and shadow, the buffer's own alpha bytes
// the shape (the straight write's edges the AA).
def notify_open_role(grant_cell Int64, base_cell Int64, w Int64, h Int64,
                     x Int64, y Int64, role Int64) Bool {
  var g = 0
  var b = 0
  case syscall.win_new(w, h) {
    (R.error, _) then { return false }
    (R.ok, ans) then {
      g = win_id(ans)
      b = win_base(ans)
    }
  }
  case syscall.win_role(g, role) {
    (R.error, _) then {
      case syscall.win_close(g) {
        (R.error, _) then {}
        (R.ok, _) then {}
      }
      return false
    }
    (R.ok, _) then {}
  }
  case syscall.win_move(g, x, y) {
    (R.error, _) then {
      case syscall.win_close(g) {
        (R.error, _) then {}
        (R.ok, _) then {}
      }
      return false
    }
    (R.ok, _) then {}
  }
  poke64(grant_cell, g)
  poke64(base_cell, b)
  return true
}

def notify_close(grant_cell Int64, base_cell Int64) Void {
  case syscall.win_close(peek64(grant_cell)) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  poke64(grant_cell, 0)
  poke64(base_cell, 0)
}

// The shell's own commit: the frame's digest on the wire, then the
// grant's present — the shape every surface of the desk keeps.
def notify_present(grant Int64, base Int64, w Int64, h Int64) Void {
  frame_line(ui_fb_winbuf.round_digest(base, w, h))
  case syscall.present(grant, 0, 0, w, h) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
}

// The bell (A25.2's wiring): a 16x16 cell after the wordmark, the
// panel's toggle — outlined while the panel is shut, the accent's
// ground while it is open. The press test and the paint read the one
// arithmetic.
def notify_bell_xy(f ui_fb.raster.Strike) Int64 {
  return ui_fb_winbuf.pack(8 + ui_fb.text_width(f, "EmoOS") + 12,
    (emo_desktop.header_height() - 16) / 2)
}

def notify_bell_paint(f ui_fb.raster.Strike, base Int64, mw Int64) Void {
  const xy = notify_bell_xy(f)
  const x = xy >> 32
  const y = xy & 4294967295
  const dims = ui_fb_winbuf.pack(mw, emo_desktop.header_height())
  var ink_color = emo_notify.ink_dim() | 0xFF000000
  if peek64(buf + notify_panel_grant) != 0 {
    ink_color = emo_notify.accent()
  }
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(x, y),
    ui_fb_winbuf.pack(16, 16), 4, ink_color, ink_color)
}

def notify_bell_hit(f ui_fb.raster.Strike, x Int64, y Int64) Bool {
  const xy = notify_bell_xy(f)
  const bx = xy >> 32
  const by = xy & 4294967295
  return x >= bx && x < bx + 16 && y >= by && y < by + 16
}

// The card's window, when the center has a live notification: made on
// the first show, repainted when the id moves, closed when the seat is
// empty again.
def notify_card_sync(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64) Void {
  if c.live_id() == 0 {
    if peek64(buf + notify_toast_grant) != 0 {
      notify_close(buf + notify_toast_grant, buf + notify_toast_base)
      poke64(buf + notify_painted, 0)
    }
  } else {
    if peek64(buf + notify_toast_grant) == 0 {
      notify_card_make(f, c, mw)
    } else {
      if peek64(buf + notify_painted) != c.live_id() {
        notify_card_paint(f, peek64(buf + notify_toast_base),
          emo_notify.toast_w(), emo_notify.toast_h(), c.live_notif())
        notify_present(peek64(buf + notify_toast_grant),
          peek64(buf + notify_toast_base), emo_notify.toast_w(),
          emo_notify.toast_h())
        poke64(buf + notify_painted, c.live_id())
      }
    }
  }
}

// The card's first show: the surface made at its seat, the words and
// the present — one frame the composition carries whole.
def notify_card_make(f ui_fb.raster.Strike, c emo_notify.Center,
                     mw Int64) Void {
  const tw = emo_notify.toast_w()
  const th = emo_notify.toast_h()
  var seat_x = mw - tw - emo_notify.toast_pad()
  seat_x = seat_x - seat_x % 2
  if notify_open(buf + notify_toast_grant, buf + notify_toast_base, tw, th,
    seat_x,
    emo_desktop.header_height() + 8) {
    notify_card_paint(f, peek64(buf + notify_toast_base), tw, th,
      c.live_notif())
    notify_present(peek64(buf + notify_toast_grant),
      peek64(buf + notify_toast_base), tw, th)
    poke64(buf + notify_painted, c.live_id())
  }
}

// The panel's window, painted whole: made on the open, its ground and
// rows the center's state — the history newest first and the DND
// row's word are its news.
def notify_panel_sync(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64,
                      mh Int64) Void {
  const pw = emo_notify.panel_w()
  const top = emo_desktop.header_height()
  const bottom = mh - emo_desktop.strip_height()
  if peek64(buf + notify_panel_grant) == 0 {
    if notify_open(buf + notify_panel_grant, buf + notify_panel_base, pw,
      bottom - top, emo_notify.panel_x(mw), top) {
      notify_panel_paint(f, peek64(buf + notify_panel_base), pw,
        bottom - top, c)
      notify_present(peek64(buf + notify_panel_grant),
        peek64(buf + notify_panel_base), pw, bottom - top)
    }
  } else {
    notify_panel_paint(f, peek64(buf + notify_panel_base), pw, bottom - top, c)
    notify_present(peek64(buf + notify_panel_grant),
      peek64(buf + notify_panel_base), pw, bottom - top)
  }
}

// The bell's press: the door's turn — open makes the panel's window,
// shut closes it, the header's bell repainted to say which.
def notify_panel_toggle(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64,
                        mh Int64) Void {
  c.toggle_open()
  if c.panel_open() {
    // the card goes with the door: the panel covers its place
    if peek64(buf + notify_toast_grant) != 0 {
      notify_close(buf + notify_toast_grant, buf + notify_toast_base)
      poke64(buf + notify_painted, 0)
    }
    notify_panel_sync(f, c, mw, mh)
  } else {
    notify_close(buf + notify_panel_grant, buf + notify_panel_base)
  }
  desk_chrome(f)
}

// The clock's cell (emo-desktop M26, A26.2): the bar's right edge —
// the text `00:00` wide, the calendar's toggle as the bell is the
// panel's. The hit wears the bell's pad, four either way.
def clock_hit(f ui_fb.raster.Strike, mw Int64, x Int64, y Int64) Bool {
  const cw = ui_fb.text_width(f, emo_desktop.clock_text(0))
  const bx = mw - emo_desktop.icon_margin() - cw
  return x >= bx - 4 && x <= mw - emo_desktop.icon_margin() + 4 &&
    y >= 0 && y < emo_desktop.header_height()
}

// The calendar panel painted: the package's own paint on the carve
// surface, the way the notify panel's twin calls `paint_panel`.
def desk_cal_paint(f ui_fb.raster.Strike, base Int64, now Int64) Void {
  const w = emo_desktop.cal_w()
  const h = emo_desktop.cal_h()
  emo_desktop.paint_calendar(Carve.new(base: base, width: w, height: h), f,
    now)
}

// The clock's press: the calendar's door turns — open makes the
// panel's window at its seat under the clock, shut closes it — and
// the bar repainted either way, its paint's own time the digits.
def cal_toggle(f ui_fb.raster.Strike, mw Int64, mh Int64) Void {
  if peek64(buf + cal_grant) != 0 {
    notify_close(buf + cal_grant, buf + cal_base)
  } else {
    var now = 0
    case syscall.time() {
      (R.error, _) then { mark() }
      (R.ok, t) then { now = t }
    }
    if notify_open(buf + cal_grant, buf + cal_base, emo_desktop.cal_w(),
      emo_desktop.cal_h(), emo_desktop.cal_x(mw), emo_desktop.cal_y()) {
      desk_cal_paint(f, peek64(buf + cal_base), now)
      notify_present(peek64(buf + cal_grant), peek64(buf + cal_base),
        emo_desktop.cal_w(), emo_desktop.cal_h())
    }
  }
  desk_chrome(f)
}

// Whether the press lands on the open calendar's own ground — the
// panel's rect, the press it consumes.
def cal_hit(mw Int64, x Int64, y Int64) Bool {
  if peek64(buf + cal_grant) == 0 {
    return false
  }
  const cx = emo_desktop.cal_x(mw)
  const cy = emo_desktop.cal_y()
  return x >= cx && x < cx + emo_desktop.cal_w() && y >= cy &&
    y < cy + emo_desktop.cal_h()
}

// ---- the launcher and the lock (emo-desktop M28, A28.3) ----
//
// The catalog: the volume's .elf names, walked off the listing the
// icons' own refresh reads, the suffix the view's own verdict. The
// search face: the panel above the dock — the bell's and the clock's
// sibling, a toplevel raised at the launcher tile's press, closed at
// Esc, a launch, or a press outside it — the open panel consuming the
// stream's bytes into the line, the popover's rule grown its keyboard
// half. The lock (D19): the account file the passwd command writes —
// 32 raw bytes of the hash package's digest, the secret never on the
// volume — and the session the lock command takes behind the
// full-screen face, the typed bytes nobody's pixels, the file's
// verdict the whole answer.

// The catalog's own line: `desktop apps <n>`, the enumeration said on
// the wire, the icons line's twin.
def desk_apps_line() Void {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 32)
  p = byte_at(p, 97) // a
  p = byte_at(p, 112) // p
  p = byte_at(p, 112) // p
  p = byte_at(p, 115) // s
  p = byte_at(p, 32)
  p = num_at(peek64(buf + apps_count), p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The catalog built off the listing's bytes: every name the suffix
// names an app, the row the name's bytes then its length.
def desk_apps_build() Void {
  var count = 0
  const flen = peek64(buf + desk_list_len)
  var pos = 0
  while pos < flen && count < 16 {
    var n = pos
    while n < flen && peek8(buf + desk_list + n) != 10B {
      n = n + 1
    }
    const nlen = n - pos
    const namep = buf + desk_list + pos
    if nlen > 0 && desk_is_elf(namep, nlen) {
      const e = buf + apps_cat + (count * 32)
      var i = 0
      while i < nlen {
        poke8(e + i, peek8(namep + i))
        i = i + 1
      }
      poke64(e + 24, nlen)
      count = count + 1
    }
    pos = n + 1
  }
  poke64(buf + apps_count, count)
}

// A name matches the search line when the line's bytes are one of the
// name's own substrings; the empty line matches everything — the
// face's opening state is the catalog whole.
def launch_matches(namep Int64, nlen Int64) Bool {
  const m = peek64(buf + launch_len)
  if m == 0 {
    return true
  }
  if m > nlen {
    return false
  }
  var i = 0
  while i <= nlen - m {
    var j = 0
    var same = true
    while j < m {
      if peek8(namep + i + j) != peek8(buf + launch_line + j) {
        same = false
        j = m
      } else {
        j = j + 1
      }
    }
    if same {
      return true
    }
    i = i + 1
  }
  return false
}

// The survivors' count, the hit test's bound and the paint's.
def launch_survivors() Int64 {
  var n = 0
  var i = 0
  while i < peek64(buf + apps_count) && n < 8 {
    const e = buf + apps_cat + (i * 32)
    if launch_matches(e, peek64(e + 24)) {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// The row's own entry: the survivor-th match's catalog row, -1 none.
def launch_row_entry(row Int64) Int64 {
  var n = 0
  var i = 0
  while i < peek64(buf + apps_count) {
    const e = buf + apps_cat + (i * 32)
    if launch_matches(e, peek64(e + 24)) {
      if n == row {
        return e
      }
      n = n + 1
    }
    i = i + 1
  }
  return -1
}

// The panel painted direct (the dock's own reason): the slab's
// shapes through the carve, the line's bytes and the survivors' the
// icons' own byte walk — no String crosses this def, the boxed
// element's assignment one wall the package's paint leaves behind on
// the machine. The buffer zeroed first: the slab's alpha grades
// composite over the ground, the corners the walk masks ride the
// fresh zeros, the hosted canvas's own.
def launch_paint(f ui_fb.raster.Strike, mw Int64) Void {
  const w = emo_desktop.launch_w(mw)
  const h = emo_desktop.launch_h()
  const base = peek64(buf + launch_base)
  ui_fb_winbuf.carve_fill(base, w, 0, 0, w, h, 0)
  const c = Carve.new(base: base, width: w, height: h)
  // the shadow rides the walk's own (the toplevel's since T9.2) — the
  // buffer's own would double it under the blend
  // the slab the straight write (emo-desktop M30, A30.1): the grade's
  // own color with the grade's own alpha, the buffer the truth the
  // walk's blend composes with
  var sy = 0
  while sy < h {
    const color = ui_fb.grade(emo_desktop.launch_ground_top(),
      emo_desktop.launch_ground_bottom(), sy, h)
    var sx = 0
    while sx < w {
      const cov = ui_fb.fill_cover(ui_fb.shape_sd(sx, sy, 0, 0, w, h, 12))
      if cov > 0 {
        c.store(sx, sy, ((cov * ((color >> 24) & 255) + 127) / 255) << 24 |
          (color & 0xFFFFFF))
      }
      sx = sx + 1
    }
    sy = sy + 1
  }
  const ty = (emo_desktop.launch_line_h() - f.line_height()) / 2
  var pen = emo_desktop.launch_pad()
  var i = 0
  const llen = peek64(buf + launch_len)
  while i < llen {
    pen = pen + desk_name_byte(f, base, w, h, pen, ty,
      peek8(buf + launch_line + i).to_int64())
    i = i + 1
  }
  // the caret the whole-word store (emo-desktop M30, A30.1): an opaque
  // word is the straight-alpha truth, the fill's RGB-only write would
  // leave the alpha byte zero and the blend would skip it
  var cy = (emo_desktop.launch_line_h() - 18) / 2
  while cy < (emo_desktop.launch_line_h() - 18) / 2 + 18 {
    var cx = pen + 4
    while cx < pen + 6 {
      c.store(cx, cy, 0xFFF8F8F0)
      cx = cx + 1
    }
    cy = cy + 1
  }
  var n = 0
  var k = 0
  while k < peek64(buf + apps_count) && n < emo_desktop.launch_rows() {
    const e = buf + apps_cat + (k * 32)
    const nlen = peek64(e + 24)
    if launch_matches(e, nlen) {
      const ry = emo_desktop.launch_line_h() + emo_desktop.launch_pad() +
        n * emo_desktop.launch_row_h()
      // the first survivor the entry Enter takes — the line's own
      // selection, the band on its row while the line names anything —
      // the band the whole words it always meant (emo-desktop M31,
      // A31.3: A30.1's dormant find, the fill's RGB write left the
      // translucent ink alpha-zero on the slab; the store carries the
      // ink's own alpha at last)
      if n == 0 && llen > 0 {
        var by = ry + 1
        while by < ry + emo_desktop.launch_row_h() - 1 {
          var bx = emo_desktop.launch_pad() / 2
          while bx < w - emo_desktop.launch_pad() / 2 {
            c.store(bx, by, emo_desktop.select_ink())
            bx = bx + 1
          }
          by = by + 1
        }
      }
      // the row wears its app's mark (emo-desktop M31, A31.3), the
      // name one mark and one pad to the right of it
      const isz = emo_desktop.icon_size(emo_desktop.launch_row_h())
      desk_icon_slab(c, emo_desktop.icon_of_byte(peek8(e).to_int64()),
        emo_desktop.launch_pad() / 2 + 1,
        ry + (emo_desktop.launch_row_h() - isz) / 2, isz,
        emo_desktop.icon_ink(),
        ui_fb.grade(emo_desktop.launch_ground_top(),
          emo_desktop.launch_ground_bottom(),
          ry + emo_desktop.launch_row_h() / 2, h))
      const ty2 = ry + (emo_desktop.launch_row_h() - f.line_height()) / 2
      var p2 = emo_desktop.launch_pad() + isz + 6
      var j = 0
      while j < nlen {
        p2 = p2 + desk_name_byte(f, base, w, h, p2, ty2,
          peek8(e + j).to_int64())
        j = j + 1
      }
      n = n + 1
    }
    k = k + 1
  }
  notify_present(peek64(buf + launch_grant), base, w, h)
}

// The panel shut: the toplevel closed, the walk's comp the pixels'
// repair.
def launch_close() Void {
  notify_close(buf + launch_grant, buf + launch_base)
}

// The panel opened: the line empty, the catalog whole, the toplevel
// raised at the panel's place.
// The panel opened: the line empty, the catalog whole, the toplevel
// raised an eighth of itself low and sprung home (emo-desktop M32,
// A32.2) — the vocabulary's own curve, the approach the seat's touch
// and the dip past it the overshoot carries, eight frames the
// present's reply paces, the paint at the low seat the first frame's
// own. The amplitude an eighth of the face — the walk's seats all
// inside the mode (a toplevel parked past it hangs the compositor's
// walk, found on the way).
def launch_open(f ui_fb.raster.Strike, mw Int64, mh Int64) Void {
  poke64(buf + launch_len, 0)
  const r = emo_desktop.launch_h() / 8
  if notify_open_role(buf + launch_grant, buf + launch_base,
    emo_desktop.launch_w(mw), emo_desktop.launch_h(),
    emo_desktop.launch_x(mw), emo_desktop.launch_y(mh) + r, 3) {
    // the face's own bytes carry their alpha (emo-desktop M30,
    // A30.1): the slab's grades declared ARGB8888 and the face itself
    // declared a panel — the walk's blend the wallpaper's own colors
    // answering through the slab, no walk mask, no walk shadow
    case syscall.win_format(peek64(buf + launch_grant), 1) {
      (R.error, _) then { mark() }
      (R.ok, _) then {}
    }
    launch_paint(f, mw)
    var i = 1
    while i < 8 {
      case syscall.win_move(peek64(buf + launch_grant),
        emo_desktop.launch_x(mw),
        emo_desktop.launch_y(mh) + emo_desktop.spring(r, i, 8)) {
        (R.error, _) then { mark() }
        (R.ok, _) then {}
      }
      notify_present(peek64(buf + launch_grant), peek64(buf + launch_base),
        emo_desktop.launch_w(mw), emo_desktop.launch_h())
      println("motion spring ${i}")
      i = i + 1
    }
    case syscall.win_move(peek64(buf + launch_grant),
      emo_desktop.launch_x(mw), emo_desktop.launch_y(mh)) {
      (R.error, _) then { mark() }
      (R.ok, _) then {}
    }
    notify_present(peek64(buf + launch_grant), peek64(buf + launch_base),
      emo_desktop.launch_w(mw), emo_desktop.launch_h())
    println("motion spring 8")
  }
}

// A name launched off the face: the slots' own path when the name is
// one of the tiles' (the dot, the exit line — residency is the
// tiles'), a foreign name a plain exec whose death is the drain's
// silent drop.
def launch_name(f ui_fb.raster.Strike, namep Int64, nlen Int64,
                labels Array[String]) Void {
  const slot = desk_slot_of(namep, nlen)
  if slot >= 0 {
    desk_launch(f, slot, labels)
  } else {
    case syscall.exec(namep, nlen) {
      (R.error, why) then { shell.desk_err(why) }
      (R.ok, _) then {}
    }
  }
}

// The open panel's byte: Esc closes, Enter launches the first
// survivor (the line's own answer), backspace trims, a printable
// joins — every other byte nothing. Any byte the panel keeps, the
// shell never sees.
def launch_byte(f ui_fb.raster.Strike, b Int64, mw Int64, mh Int64,
                labels Array[String]) Void {
  if b == 27 {
    launch_close()
  } else {
    if b == 10 {
      const e = launch_row_entry(0)
      launch_close()
      if e >= 0 {
        launch_name(f, e, peek64(e + 24), labels)
      } else {
        poke64(buf + launch_len, 0)
      }
    } else {
      if b == 8 || b == 127 {
        if peek64(buf + launch_len) > 0 {
          poke64(buf + launch_len, peek64(buf + launch_len) - 1)
        }
        launch_paint(f, mw)
      } else {
        if b >= 32 && b <= 126 && peek64(buf + launch_len) < 24 {
          poke8(buf + launch_line + peek64(buf + launch_len), b.to_byte())
          poke64(buf + launch_len, peek64(buf + launch_len) + 1)
        }
        launch_paint(f, mw)
      }
    }
  }
}

// The account file's name, nine bytes, poked once at the write.
def lock_fill_name() Void {
  poke8(buf + lock_name, 108B) // l
  poke8(buf + lock_name + 1, 111B) // o
  poke8(buf + lock_name + 2, 99B) // c
  poke8(buf + lock_name + 3, 107B) // k
  poke8(buf + lock_name + 4, 46B) // .
  poke8(buf + lock_name + 5, 104B) // h
  poke8(buf + lock_name + 6, 97B) // a
  poke8(buf + lock_name + 7, 115B) // s
  poke8(buf + lock_name + 8, 104B) // h
}

// `passwd <secret>`: the line's rest the secret's bytes, 1 to 64 of
// them, the digest — 32 raw bytes, the hash package's own — the file's
// whole content. The secret itself goes nowhere: not the volume, not
// the wire's file. An empty or oversized secret refused, the
// strictness.
def desk_passwd_cmd(e Int64, n Int64) Void {
  var s = shell.skip_spaces(e, n)
  var slen = n - s
  if slen <= 0 || slen > 64 {
    lock_plain_line("passwd: a secret of 1 to 64 bytes", 33)
  } else {
    const dg = hash.sha2.sha256(notify_str(shell.line_ptr() + s, slen).to_bytes())
    lock_fill_name()
    var i = 0
    while i < 32 {
      poke8(buf + lock_dgst + i, dg.get(i).to_byte())
      i = i + 1
    }
    case syscall.file_write(buf + lock_name, 9, buf + lock_dgst, 32) {
      (R.error, _) then { lock_plain_line("passwd: the file refused", 24) }
      (R.ok, _) then { lock_plain_line("passwd ok", 9) }
    }
  }
}

// A bare line the lock's own words ride on, the length the caller's.
def lock_plain_line(text String, nlen Int64) Void {
  const tb = text.to_bytes()
  var p = byte_at(0, tb.get(0))
  var i = 1
  while i < nlen {
    p = byte_at(p, tb.get(i))
    i = i + 1
  }
  p = byte_at(p, 10)
  gate_line(p)
}

// `lock`: the account file read, the session taken behind the
// full-screen face when the file is a digest, the refusal naming
// itself when it is not — no account, no lock, the strictness.
def desk_lock_cmd(f ui_fb.raster.Strike, mw Int64, mh Int64) Void {
  lock_fill_name()
  case syscall.file_read(buf + lock_name, 9, buf + lock_file, 32) {
    (R.error, _) then { lock_plain_line("lock: no account", 16) }
    (R.ok, rn) then {
      if rn != 32 {
        lock_plain_line("lock: the file is not a digest", 30)
      } else {
        poke64(buf + lock_len, 0)
        // the face declared a panel outright (emo-desktop M28): the
        // role binds at the declaration and never changes, and a panel
        // paints over every window and over the header and the dock —
        // the walk's own chrome layer, the face the session's whole
        // ground
        var lg = 0
        var lb = 0
        case syscall.win_new(mw, mh) {
          (R.error, _) then {}
          (R.ok, ans) then {
            lg = win_id(ans)
            lb = win_base(ans)
          }
        }
        var took = false
        if lg != 0 {
          case syscall.win_role(lg, 3) {
            (R.error, _) then {}
            (R.ok, _) then { took = true }
          }
        }
        if took {
          case syscall.win_move(lg, 0, 0) {
            (R.error, _) then { mark() }
            (R.ok, _) then {}
          }
          poke64(buf + lock_grant, lg)
          poke64(buf + lock_base, lb)
          const ground = Carve.new(base: lb, width: mw, height: mh)
          emo_desktop.paint_lock(ground, f)
          notify_present(lg, lb, mw, mh)
          lock_plain_line("lock on", 7)
        } else {
          if lg != 0 {
            case syscall.win_close(lg) {
              (R.error, _) then {}
              (R.ok, _) then {}
            }
          }
          lock_plain_line("lock: the face refused", 20)
        }
      }
    }
  }
}

// The locked session's byte: the line grows blind (no echo, no dots —
// not even the count is the screen's business), Enter the file's
// check — a match lifts the face, a miss clears the line and stays.
// There is no cancel: locked is locked.
def lock_byte(f ui_fb.raster.Strike, b Int64) Void {
  if b == 10 {
    const dg = hash.sha2.sha256(notify_str(buf + lock_line,
      peek64(buf + lock_len)).to_bytes())
    if hash.constant_time_compare(dg,
        notify_str(buf + lock_file, 32).to_bytes()) {
      notify_close(buf + lock_grant, buf + lock_base)
      // the display's repair (emo-desktop M28): the close releases the
      // face and marks its rect, and the next composition is the one
      // that repaints — the wallpaper's whole present is that walk,
      // the chrome and the strip the walk's own panels again
      desk_wall_repaint(f)
      lock_plain_line("lock ok", 7)
    } else {
      poke64(buf + lock_len, 0)
      lock_plain_line("lock miss", 9)
    }
  } else {
    if b == 8 || b == 127 {
      if peek64(buf + lock_len) > 0 {
        poke64(buf + lock_len, peek64(buf + lock_len) - 1)
      }
    } else {
      if b >= 32 && b <= 126 && peek64(buf + lock_len) < 64 {
        poke8(buf + lock_line + peek64(buf + lock_len), b.to_byte())
        poke64(buf + lock_len, peek64(buf + lock_len) + 1)
      }
    }
  }
}

// The shell takes the foreground (T7.3, docs/shell.md): the proof
// chain is done and the terminal is the REPL's console at the prompt.
// The desktop is a command now, not the boot's own act: the line's
// `desktop` word opens it (the era's surfaces, its launcher and its
// loop), and until then the machine is the shell.
//
// Since T3.2, when the volume carries the C shell's image (`emosh.elf`
// — the EMO_SHELL build installs it), the root hands it the foreground
// with the same exec door; the Emo shell remains the golden's fallback
// when the image is absent.
//
// Since T4.2 the core utilities ride the same stage: when
// `uutils.elf` is on the volume (the EMO_UTILS build installs it),
// the root execs it with `selftest` as argv[1] — the file, text and
// process corpus over the T1 gate's fd surface.
if uutils_present() {
  const un = put_uutils_name(buf + 18000)
  const an = put_selftest_args(buf + 18064)
  case syscall.execve(buf + 18000, un, buf + 18064, an, 0, 0) {
    (R.error, why) then {
      println("uutils: ${why}")
      shell.desk_err(why)
    }
    (R.ok, _) then {}
  }
}
// Since T4.1 the first real POSIX program rides the same stage: when
// `dash.elf` is on the volume (the EMO_DASH build installs it), the
// root execs it with the acceptance script as argv[1] — the shell's
// own features over the T1 gate's fd surface.
if dash_present() {
  const dn = put_dash_name(buf + 18000)
  const an = put_script_name(buf + 18064)
  case syscall.execve(buf + 18000, dn, buf + 18064, an, 0, 0) {
    (R.error, why) then {
      println("dash: ${why}")
      shell.desk_err(why)
    }
    (R.ok, _) then {}
  }
}
if emosh_present() {
  const en = put_emosh_name(buf + 18000)
  case syscall.execve(buf + 18000, en, 0, 0, 0, 0) {
    (R.error, why) then {
      println("emosh: ${why}")
      shell.desk_err(why)
    }
    (R.ok, _) then {}
  }
}
// The self-hosted compiler (T4.5): the image carries TCC and its link
// inputs, and the desktop's exec command drives it; the marker says the
// compiler is on the volume, before the shell takes the terminal.
if tcc_present() {
  println("tcc ready")
}
shell_mode()

// The C shell's name, written into the scratch page; the proof chain's
// buffers are done with it by now.
def put_emosh_name(a Int64) Int64 {
  poke8(a, 101B)     // e
  poke8(a + 1, 109B) // m
  poke8(a + 2, 111B) // o
  poke8(a + 3, 115B) // s
  poke8(a + 4, 104B) // h
  poke8(a + 5, 46B)  // .
  poke8(a + 6, 101B) // e
  poke8(a + 7, 108B) // l
  poke8(a + 8, 102B) // f
  return 9
}

def put_dash_name(a Int64) Int64 {
  poke8(a, 100B)     // d
  poke8(a + 1, 97B)  // a
  poke8(a + 2, 115B) // s
  poke8(a + 3, 104B) // h
  poke8(a + 4, 46B)  // .
  poke8(a + 5, 101B) // e
  poke8(a + 6, 108B) // l
  poke8(a + 7, 102B) // f
  return 8
}

def put_tcc_name(a Int64) Int64 {
  poke8(a, 116B)     // t
  poke8(a + 1, 99B)  // c
  poke8(a + 2, 99B)  // c
  poke8(a + 3, 46B)  // .
  poke8(a + 4, 101B) // e
  poke8(a + 5, 108B) // l
  poke8(a + 6, 102B) // f
  return 7
}

def put_uutils_name(a Int64) Int64 {
  poke8(a, 117B)      // u
  poke8(a + 1, 117B)  // u
  poke8(a + 2, 116B)  // t
  poke8(a + 3, 105B)  // i
  poke8(a + 4, 108B)  // l
  poke8(a + 5, 115B)  // s
  poke8(a + 6, 46B)   // .
  poke8(a + 7, 101B)  // e
  poke8(a + 8, 108B)  // l
  poke8(a + 9, 102B)  // f
  return 10
}

def put_selftest_args(a Int64) Int64 {
  poke8(a, 115B)      // s
  poke8(a + 1, 101B)  // e
  poke8(a + 2, 108B)  // l
  poke8(a + 3, 102B)  // f
  poke8(a + 4, 116B)  // t
  poke8(a + 5, 101B)  // e
  poke8(a + 6, 115B)  // s
  poke8(a + 7, 116B)  // t
  return 8
}

def put_script_name(a Int64) Int64 {
  poke8(a, 100B)      // d
  poke8(a + 1, 97B)   // a
  poke8(a + 2, 115B)  // s
  poke8(a + 3, 104B)  // h
  poke8(a + 4, 45B)   // -
  poke8(a + 5, 116B)  // t
  poke8(a + 6, 101B)  // e
  poke8(a + 7, 115B)  // s
  poke8(a + 8, 116B)  // t
  poke8(a + 9, 46B)   // .
  poke8(a + 10, 115B) // s
  poke8(a + 11, 104B) // h
  return 12
}

// The child's base environment (T3.4): the launcher and the desktop's
// exec both hand it to the spawn door, and the shell's own children
// carry the same one through the execve staging.
def put_base_env(a Int64) Int64 {
  poke8(a, 80B)     // P
  poke8(a + 1, 87B) // W
  poke8(a + 2, 68B) // D
  poke8(a + 3, 61B) // =
  poke8(a + 4, 47B) // /
  return 5
}


// Whether the volume carries the core utilities (T4.2): the same
// zero-capacity probe the shells use.
def uutils_present() Bool {
  const un = put_uutils_name(buf + 18000)
  case syscall.file_read(buf + 18000, un, buf + 18032, 0) {
    (R.ok, size) then {
      if size > 0 {
        return true
      }
    }
    (R.error, _) then {}
  }
  return false
}

// Whether the volume carries the first real POSIX program (T4.1): the
// same zero-capacity probe the C shell's test uses.
def dash_present() Bool {
  const dn = put_dash_name(buf + 18000)
  case syscall.file_read(buf + 18000, dn, buf + 18032, 0) {
    (R.ok, size) then {
      if size > 0 {
        return true
      }
    }
    (R.error, _) then {}
  }
  return false
}

// Whether the volume carries the self-hosted compiler (T4.5).
def tcc_present() Bool {
  const tn = put_tcc_name(buf + 18000)
  case syscall.file_read(buf + 18000, tn, buf + 18032, 0) {
    (R.ok, size) then {
      if size > 0 {
        return true
      }
    }
    (R.error, _) then {}
  }
  return false
}

// Whether the volume carries the C shell: the file's size through the
// read verb's zero-capacity probe, the desktop's own file test shape.
def emosh_present() Bool {
  const en = put_emosh_name(buf + 18000)
  case syscall.file_read(buf + 18000, en, buf + 18032, 0) {
    (R.ok, size) then {
      if size > 0 {
        return true
      }
    }
    (R.error, _) then {}
  }
  return false
}

// The shell's own loop: the banner and the first prompt, then the
// merged stream's bytes fed to the line; a line that names `desktop`
// opens the desktop (main.emo's era — the shell module names the word,
// the era is this module's), every other line the shell's commands.
// The desktop, once opened, never returns: poweroff ends the machine.
def shell_mode() Void {
  shell.sh_init()
  shell.banner()
  shell.prompt()
  while true {
    const ev = syscall.input_read()
    if ev_type(ev) == 17741 {
      const n = shell.feed(ev_value(ev))
      if n >= 0 {
        const s = shell.skip_spaces(0, n)
        const e = shell.word_end(s, n)
        if shell.desktop_p(s, e - s) {
          if shell.extra_args(e, n) {
            shell.desk_err("bad argument")
            shell.prompt()
          } else {
            desktop()
          }
        } else {
          shell.execute(n)
          shell.prompt()
        }
      }
    }
  }
}

// The desktop's own body (emo-desktop A12.1): the wallpaper, the
// header and the dock up, the slots' names poked — then the loop that
// never returns. The shell is already in the foreground when the line
// names `desktop` (shell_mode above): its texts are poked and its
// banner and prompt are on the console, so this body paints the era
// and takes the stream.
def desktop() Void {
  const fholder = ArrayBuilder.new()
  case desk_strike() {
    (R.error, _) then { mark() }
    (R.ok, s) then { fholder.push(s) }
  }
  const f = fholder.get(0)
  var nb = byte_at(desk_names, 99) // counter.elf
  nb = byte_at(nb, 111)
  nb = byte_at(nb, 117)
  nb = byte_at(nb, 110)
  nb = byte_at(nb, 116)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 114)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  nb = byte_at(desk_names + 12, 102) // files.elf
  nb = byte_at(nb, 105)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 115)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  nb = byte_at(desk_names + 24, 101) // editor.elf
  nb = byte_at(nb, 100)
  nb = byte_at(nb, 105)
  nb = byte_at(nb, 116)
  nb = byte_at(nb, 111)
  nb = byte_at(nb, 114)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  poke64(buf + desk_pids, 0)
  poke64(buf + desk_pids + 8, 0)
  poke64(buf + desk_pids + 16, 0)
  var mode = 0
  case syscall.output_info(0) {
    (R.error, _) then { mark() }
    (R.ok, m) then { mode = m }
  }
  const mw = out_w(mode)
  const mh = out_h(mode)
  // The wall clock (emo-desktop M26, EmoOS T12.1): the bar's first
  // live datum, said on the wire for the golden's own eye.
  case syscall.time() {
    (R.error, _) then { mark() }
    (R.ok, now) then { clock_line(now) }
  }
  const dw = mw
  const dh = emo_desktop.strip_height()
  poke64(buf + desk_mode_cell, (mw << 32) | mh)
  // The desktop's own canvas (emo-desktop A13): the volume's listing
  // taken, the view grown from it — the icons the wallpaper carries —
  // then the wallpaper itself (role 4, the walk's undermost layer) and
  // the header bar (a panel at the top edge) before the dock, so the
  // first composition of every surface already has the desktop whole.
  poke64(buf + desk_folder_len, 0)
  poke64(buf + desk_sel, -1)
  desk_list_load()
  desk_view_build()
  var gw = 0
  var base_w = 0
  case syscall.win_new(mw, mh) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      gw = win_id(ans)
      base_w = win_base(ans)
    }
  }
  case syscall.win_role(gw, 4) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_move(gw, 0, 0) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  poke64(buf + desk_wall_grant, gw)
  poke64(buf + desk_wall_base, base_w)
  // The art's boot read (emo-desktop M31, A31.1): the mode's own
  // verdict before the first paint — the wallpaper the volume's file
  // decodes, or the flat ground when the volume carries none. (The
  // desk pass wanted the file first; the guard kept the one read.)
  wall_file_load(mode)
  desk_wall_repaint(f)
  desk_icons_line()
  // The launcher's catalog (emo-desktop M28): the volume's apps walked
  // off the listing the view was built from, the count said on the
  // wire — the icons line's twin.
  desk_apps_build()
  desk_apps_line()
  var gh = 0
  var base_h = 0
  case syscall.win_new(mw, emo_desktop.header_height()) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      gh = win_id(ans)
      base_h = win_base(ans)
    }
  }
  case syscall.win_role(gh, 3) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_move(gh, 0, 0) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  poke64(buf + desk_bar_grant, gh)
  poke64(buf + desk_bar_base, base_h)
  desk_chrome(f)
  var gd = 0
  var base_d = 0
  case syscall.win_new(dw, dh) {
    (R.error, _) then { mark() }
    (R.ok, ans) then {
      gd = win_id(ans)
      base_d = win_base(ans)
    }
  }
  case syscall.win_role(gd, 3) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  case syscall.win_move(gd, 0, mh - dh) {
    (R.error, _) then { mark() }
    (R.ok, _) then {}
  }
  poke64(buf + desk_dock_grant, gd)
  poke64(buf + desk_dock_base, base_d)
  const labels = ["s", "c", "f", "e"]
  desk_dock(f, labels)
  // The notification center's state (emo-desktop M25): the metal
  // provider's feed and the center, both surfaces' seats empty — the
  // first take claims the center, the service's own first-taker rule.
  const feed = metal_feed()
  const nc = emo_notify.center(feed)
  poke64(buf + notify_toast_grant, 0)
  poke64(buf + notify_panel_grant, 0)
  poke64(buf + notify_painted, 0)
  // The pointer's axes, packed as the display's mode is: the X's
  // maximum above the Y's — the press's position the shell scales
  // itself, the tile the strip's own policy names.
  var range = 0
  case syscall.input_info(0) {
    (R.error, _) then { mark() }
    (R.ok, r) then { range = r }
  }
  const max_x = out_w(range)
  const max_y = out_h(range)
  var px = 0
  var py = 0
  while true {
    // The notification poll (emo-desktop M25, A25.2): the residence
    // ages, one take per wake — the desk loop's turn is the shell's
    // tick until the stream carries one — and the card's window
    // follows; the open panel follows the history the take grew.
    nc.beat()
    const had = nc.entries().length()
    nc.take()
    if nc.panel_open() == false {
      notify_card_sync(f, nc, mw)
    } else {
      // the open panel is the center whole: the card's place is the
      // panel's, and a delivery repaints the rows
      if peek64(buf + notify_toast_grant) != 0 {
        notify_close(buf + notify_toast_grant, buf + notify_toast_base)
        poke64(buf + notify_painted, 0)
      }
      if nc.entries().length() != had {
        notify_panel_sync(f, nc, mw, mh)
      }
    }
    // The clock's beat (emo-desktop M26, A26.2): the take has no
    // heartbeat to ride and neither has the minute — a wake reads the
    // time and the changed minute is the bar's repaint, the digits
    // one wake late the honest bound (the toast's own).
    case syscall.time() {
      (R.error, _) then {}
      (R.ok, now) then {
        if now / 60 != peek64(buf + desk_painted_minute) {
          desk_chrome(f)
        }
      }
    }
    const ev = syscall.input_read()
    const t = ev_type(ev)
    // The death's word (emo-desktop A12.1): type 0x4558, the child's
    // pid in the code, its exit code in the value. A slot's pid ends
    // and the slot empties — the dot goes out, the dock repaints,
    // `desktop <name> exit <code>` on the wire. The proof chain's own
    // deaths ride the same ring to the same parent and name no slot:
    // the silent drops are the drain.
    if t == ev_exit {
      const child = ev_code(ev)
      const code = ev_value(ev)
      var slot = -1
      if child == peek64(buf + desk_pids) {
        slot = 0
      }
      if child == peek64(buf + desk_pids + 8) {
        slot = 1
      }
      if child == peek64(buf + desk_pids + 16) {
        slot = 2
      }
      if slot == 0 {
        poke64(buf + desk_pids, 0)
        desk_exit_line(buf + desk_names, desk_nlen(0), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
      if slot == 1 {
        poke64(buf + desk_pids + 8, 0)
        desk_exit_line(buf + desk_names + 12, desk_nlen(1), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
      if slot == 2 {
        poke64(buf + desk_pids + 16, 0)
        desk_exit_line(buf + desk_names + 24, desk_nlen(2), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
    }
    // The serial's byte: the line's feed, the command when the line
    // ends — `exec` the launcher's own dispatch, the rest the shell's.
    if t == 17741 {
      // The open panel's byte first (emo-desktop M28): the search face
      // consumes the stream while it stands, the popover's rule grown
      // its keyboard half; the locked session's byte next, the line
      // growing blind; the shell's line only when neither holds the
      // machine's ear.
      if peek64(buf + launch_grant) != 0 {
        launch_byte(f, ev_value(ev), mw, mh, labels)
      } else {
        if peek64(buf + lock_grant) != 0 {
          lock_byte(f, ev_value(ev))
        } else {
          const n = shell.feed(ev_value(ev))
          if n >= 0 {
            const s = shell.skip_spaces(0, n)
            const e = shell.word_end(s, n)
            if shell.exec_p(s, e - s) {
              desk_exec_cmd(f, e, n, labels)
            } else {
              if shell.passwd_p(s, e - s) {
                desk_passwd_cmd(e, n)
                // the volume changed under the command: the account
                // file is the listing's new doc, the view's own news
                desk_icons_refresh(f)
              } else {
                if shell.lock_p(s, e - s) {
                  desk_lock_cmd(f, mw, mh)
                } else {
                  if shell.desktop_p(s, e - s) {
                    desk_note()
                  } else {
                    shell.execute(n)
                    // the volume may have changed under the command (the
                    // write, the rm): the fold's comparison is the
                    // refresh's whole cost when it did not (emo-desktop
                    // A13)
                    desk_icons_refresh(f)
                  }
                }
              }
            }
            shell.prompt()
          }
        }
      }
    }
    // The global shortcut (emo-desktop M36, EmoOS T16.1): the input
    // service's chord layer — Alt+1..4, the value the desk — hands the
    // shell the switch whatever window holds the focus; the show verb
    // is the shell's (the panel authority), and the chrome's repaint is
    // the new active cell's news. The lock is the session's: a chord
    // under the face is nobody's.
    if t == ev_shortcut {
      if peek64(buf + lock_grant) == 0 {
        const desk = ev_value(ev)
        shortcut_line(desk)
        case syscall.desk_show(desk) {
          (R.error, _) then { mark() }
          (R.ok, _) then {}
        }
        desk_chrome(f)
      }
    }
    if t == 3 {
      if ev_code(ev) == 0 {
        px = scaled(ev_value(ev), mw, max_x)
      }
      if ev_code(ev) == 1 {
        py = scaled(ev_value(ev), mh, max_y)
      }
    }
    // The tablet's left button (BTN_LEFT, 272): a press on the strip
    // names a tile, and the tile names its app — the launcher's whole
    // answer; a press above the strip is the desktop's own ground or
    // the windows' world, the press-raise the compositor's own. The
    // bar's press is no one's here: the compositor gave the focus to
    // the desktop already (T8.27). An icon's cell the hit test names —
    // the selection moved, the folder's door, the way up; the bare
    // wallpaper the selection's clear (emo-desktop A13).
    if t == 1 && ev_code(ev) == 272 {
      if ev_value(ev) == 1 {
        // The launcher's panel and the lock's face first (emo-desktop
        // M28): a toplevel over the windows owns every press — the
        // open panel a row's launch or the close (the popover's rule),
        // the locked session the raise's own, the face keeping itself.
        const tile = emo_desktop.press(px, py, mw, mh, 4)
        if peek64(buf + launch_grant) != 0 {
          const row = emo_desktop.launch_hit(mw, mh, px, py,
            launch_survivors())
          if row >= 0 {
            const e = launch_row_entry(row)
            launch_close()
            if e >= 0 {
              launch_name(f, e, peek64(e + 24), labels)
            }
          } else {
            launch_close()
          }
        } else {
          if peek64(buf + lock_grant) != 0 {
            // consumed: the face is the raise's own, the topmost
            // toplevel keeping itself there
          } else {
        // The header's bell first (emo-desktop M25, A25.2): the
        // panel's door, and an open panel owns every press inside its
        // rect — the DND row's verdict or the panel's own, never the
        // desktop's icons underneath.
        if notify_bell_hit(f, px, py) {
          notify_panel_toggle(f, nc, mw, mh)
        } else {
          if peek64(buf + notify_panel_grant) != 0 &&
             emo_notify.center_hit(px, py, mw, emo_desktop.header_height(),
               mh - emo_desktop.strip_height()) {
            if emo_notify.dnd_hit(px, py, mw, emo_desktop.header_height()) {
              nc.toggle_dnd()
            }
            notify_panel_sync(f, nc, mw, mh)
          } else {
            // The clock's press (emo-desktop M26, A26.2): the
            // calendar's door, and the open panel's own ground the
            // press it consumes — a press on the bare desktop closes
            // it first, the popover's way.
            if clock_hit(f, mw, px, py) {
              cal_toggle(f, mw, mh)
            } else {
              if cal_hit(mw, px, py) {
                // the panel's own ground: consumed
              } else {
                if peek64(buf + cal_grant) != 0 {
                  notify_close(buf + cal_grant, buf + cal_base)
                }
                if tile == 0 {
                  launch_open(f, mw, mh)
                }
                if tile == 1 {
                  desk_launch(f, 0, labels)
                }
                if tile == 2 {
                  desk_launch(f, 1, labels)
                }
                if tile == 3 {
                  desk_launch(f, 2, labels)
                }
                if tile == -1 && py >= emo_desktop.header_height() {
                  desk_icon_press(f, emo_desktop.icon_hit(px, py, peek64(buf + desk_view_count), mw, mh))
                }
                // The pager's press (emo-desktop M27, A27.2): the cell
                // names its desk, the switch the show verb's word —
                // the bar repainted either way, its paint the new
                // active cell's news on the wire. The cells overlap no
                // panel and no clock, so the chain's tail is the same
                // verdict the head would give.
                const pd = emo_desktop.pager_hit(f, px, py)
                if pd >= 0 {
                  // The slide (emo-desktop M32, A32.3, D13): the word
                  // the walk starts from read before the show, the
                  // cut the compositor's own recomposition, then the
                  // chrome's frames — the accent easing the old cell
                  // to the new one's across the bar, seven the
                  // vocabulary's steps, the settle the desk_chrome's
                  // own paint.
                  var od = 0
                  case syscall.desk_workspace() {
                    (R.error, _) then { mark() }
                    (R.ok, d) then { od = d }
                  }
                  case syscall.desk_show(pd) {
                    (R.error, _) then { mark() }
                    (R.ok, _) then {}
                  }
                  var st = 1
                  while st < 8 {
                    desk_bar_slide_paint(f, od, pd, st, 8)
                    println("motion desk ${st}")
                    st = st + 1
                  }
                  desk_chrome(f)
                }
              }
            }
          }
        }
      }
        }
      }
    }
  }
}
