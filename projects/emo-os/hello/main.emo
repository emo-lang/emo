// The first user program (T4.1): the kernel loads this image into the
// user window and srets into it in U-mode. U-mode owns no CSRs and the
// SBI is unreachable from it. Two proofs ride the serial line: the
// greeting pokes the 16550A directly — the weak-isolation window, what
// U-mode can reach with no gate at all — and the `gate` line goes
// through the ecall gate (T4.2) by way of the `syscall` stubs (T4.3):
// one successful write of this line's own bytes, then two refusals,
// each printed through the same gate that refused it. The exit is the
// stub's verb 0, which lands in the kernel and never returns.
//
//   cd hello && emo build main.emo --target riscv64 \
//        --profile user -o ../hello.elf

require "syscall"

const uart = 0x10000000

// A scratch page inside this image's read-write segment — the buffer
// the successful write sends from — and the two addresses the refusals
// try: the text segment is load-and-run but not writable, and the
// kernel's own memory is nobody's.
const buf = 0x87200000
const text_seg = 0x87100000
const kernel_mem = 0x80200000

def put(b Int64) Void {
  while (peek8(uart + 5).to_int64() & 32) == 0 {
  }
  poke8(uart, b.to_byte())
}

def put_num(n Int64) Void {
  if n >= 10 {
    put_num(n / 10)
  }
  put(48 + (n % 10))
}

// The stub's refusal message, back to the ABI's reason number
// (docs/syscalls.md) — the number the line prints.
def reason_num(why String) Int64 {
  if why == "not writable" {
    return 3
  }
  if why == "outside the caller's memory" {
    return 2
  }
  if why == "bad argument" {
    return 4
  }
  return 1
}

def reason_of(answer (R, Int64)) Int64 {
  case answer {
    (R.error, why) -> { return reason_num(why) }
    (R.ok, _) -> { return 0 }
  }
}

// One byte into the scratch buffer; the cursor comes back.
def byte_at(pos Int64, b Int64) Int64 {
  poke8(buf + pos, b.to_byte())
  return pos + 1
}

// The decimal digits of n, poked at the cursor; the cursor comes back.
def num_at(n Int64, pos Int64) Int64 {
  var p = pos
  if n >= 10 {
    p = num_at(n / 10, p)
  }
  poke8(buf + p, (48 + (n % 10)).to_byte())
  return p + 1
}

// The U-mode proof, straight at the machine: U-MODE 500500
put(85) // U
put(45) // -
put(77) // M
put(79) // O
put(68) // D
put(69) // E
put(32) // space
var sum = 0
var i = 0
while i <= 1000 {
  sum = sum + i
  i = i + 1
}
put_num(sum)
put(10)

// The gate proof, through the kernel by way of the stubs: one write
// that answers, two that refuse — the text segment with reason 3 (no
// permission), the kernel's memory with reason 2 (out of range) — and
// each refusal printed by the same gate that refused it. The line
// reads `gate 500500 r3 r2`.
var pos = byte_at(0, 103) // g
pos = byte_at(pos, 97) // a
pos = byte_at(pos, 116) // t
pos = byte_at(pos, 101) // e
pos = byte_at(pos, 32) // space
pos = num_at(sum, pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(text_seg, 4)), pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(kernel_mem, 4)), pos)
pos = byte_at(pos, 10)
var wrote = syscall.write(buf, pos)
