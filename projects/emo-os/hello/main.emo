// The first user program (T4.1): the kernel loads this image into the
// user window and srets into it in U-mode. U-mode owns no CSRs and the
// SBI is unreachable from it. Since T6.2 the program runs on its own
// page table — its code RX, its data RW, its own stack and arena, the
// kernel's memory mapped without U — so every byte out rides the gate:
// the greeting, the lines, the marks, all through the console service.
// The proofs ride the serial line in order: the greeting (`U-MODE
// 500500`, the computed sum the register file's pin), the `gate` line
// (T4.2's write verb with two refusals printed by the same gate that
// refused them), `echo` (T4.4's read verb, blocking on the console
// service until a byte exists), `doomed` and the `user fault` report
// (T4.6's kill — a misbehaving child says its line through the gate,
// then loads where its own table maps nothing, and the supervisor
// kills it loudly while the machine continues), `smash` and its
// report (T6.4's page-fault kill — a store where the table maps
// nothing, the report naming the address the hardware refused),
// `reach` and its report (T6.5's isolation kill — a store at a kernel
// address, mapped without U, the permission the walk refuses),
// `born`/`wait 7` (the
// spawn and wait round trip — the child re-enters this top level,
// finds the token, and exits 7), the screen carve's proof (T8.2 — the
// machine's first full-screen pass paints the carve its spawn was
// granted, the service reads the pattern back, and the second screen
// spawn is the resource refusal — and, since emo-desktop A7.2, the
// pass's first act is the desktop's first frame: the tree the fb core
// lays out and paints into the carve, its digest on the wire, the
// grant's present putting it on the display), and then the shell (T7.3,
// shell.emo, its
// design in docs/shell.md) takes the machine's foreground: the top
// level enters the REPL instead of exiting, and the machine ends the
// way the proof's exit did — the poweroff command's verb 0, the boot
// pass's exit landing in the kernel. The counter pass (T7.4, console_ui.emo,
// its design in docs/ui.md) is the machine's program: the shell's
// `counter` command (T7.5) pokes ui_cell, spawns it, and waits for
// its exit — a user program begun from the prompt, the closure
// demo's last beat. The window shell (emo-desktop A9.1, desk_cell)
// puts two toplevel surfaces up after the proof chain: windows of its
// own, focus and drag through the compositor's verbs, keys routed to
// the focused window, the merged stream in its seat.
//
// The image requires the desktop's packages beside the syscall stub —
// EmoUI's core, the fb backend's core, the first frame, the
// window shell's windows and the first apps — staged
// into a registry from their trees, the way start.sh does before it
// builds:
//
//   cd hello && EMO_REGISTRY=<the staged registry> emo build main.emo \
//        --target riscv64 --profile user -o ../hello.elf

require "syscall"
require "emo/ui"
require "emo/ui_fb"
require "emo/ui_fb_frame"
require "emo/ui_fb_win"
require "emo/ui_fb_winbuf"
require "emo_desktop"

// A scratch page inside this image's read-write segment — the buffer
// every line is built in and sent from, with the two token cells the
// spawned passes read (each poked once before the parent parks, so
// the passes see their own) — and the two addresses the refusals try:
// the text segment is load-and-run but not writable, and the kernel's
// own memory is nobody's.
const buf = 0x87200000
const child_cell = buf + 2048
const doomed_cell = buf + 2056
const greedy_cell = buf + 2064
const smash_cell = buf + 2072
const reach_cell = buf + 2080
const ui_cell = buf + 2088
// The input pass's token (T8.3): the cells the spawned passes read,
// each poked once before the parent parks.
const key_cell = buf + 2096
// The window pass's token (T8.5), beside them.
const win_cell = buf + 2104
// The window shell's token (emo-desktop A9.1), beside it.
const desk_cell = buf + 2112
// The client's token and the rebirth's (emo-desktop A9.2): the pass
// that opens a toplevel, presents, and dies without closing — the
// stack's reclaim proof — and the one reborn after it.
const client_cell = buf + 2120
const client2_cell = buf + 2128
// The screen grant's channel and the carve itself (T8.2): the token on
// the user cells page — the one crossing every table maps, so the
// kernel's spawn-side read sees the poke — and the carve's base by its
// physical address, the identity this pass paints when the token is
// its own (the table the kernel's build made carries the carve, RW
// with U; a pass without the grant maps none of it).
const screen_cell = 0x87fff040
const screen_base = 0x86800000
const screen_size = 0x800000
const text_seg = 0x87100000
const kernel_mem = 0x80200000
// The filesystem proof's buffers (T7.2), further up the same scratch
// page: the two names, the 600 bytes written, the read-back (the
// read's capacity is 2048, so the buffer is that long), and the list.
const fs_name = buf + 2304
const fs_data = buf + 2560
const fs_back = buf + 3328
const fs_tmp = buf + 5376
const fs_names = buf + 5632
// The kernel's own image by its high-half address: the physical load
// base plus the upper half's offset. A pass's table maps the kernel's
// whole half without U, so the mapping is there and the walk succeeds
// — it is the permission that fails (T6.5's golden: the pre-SV39
// window let this store through to the kernel's RAM; the table
// refuses it now).
const kernel_hi = 0x80200000 - 0x4000000000

// The stub's refusal message, back to the ABI's reason number
// (docs/syscalls.md) — the number the line prints.
def reason_num(why String) Int64 {
  if why == "not writable" {
    return 3
  }
  if why == "outside the caller's memory" {
    return 2
  }
  if why == "bad argument" {
    return 4
  }
  if why == "the kernel is out of a resource" {
    return 5
  }
  return 1
}

def reason_of(answer (R, Int64)) Int64 {
  case answer {
    (R.error, why) -> { return reason_num(why) }
    (R.ok, _) -> { return 0 }
  }
}

// One byte into the scratch buffer; the cursor comes back.
def byte_at(pos Int64, b Int64) Int64 {
  poke8(buf + pos, b.to_byte())
  return pos + 1
}

// The decimal digits of n, poked at the cursor; the cursor comes back.
def num_at(n Int64, pos Int64) Int64 {
  var p = pos
  if n >= 10 {
    p = num_at(n / 10, p)
  }
  poke8(buf + p, (48 + (n % 10)).to_byte())
  return p + 1
}

// A line through the console service, from the scratch buffer. The
// one ride that cannot refuse is the mark: a '?' from this image's
// own writable segment, sent when a line the gate should have carried
// comes back refused — the loud wrongness of it is the point.
def mark() Void {
  poke8(buf, 63B)
  var r = syscall.write(buf, 1)
  case r {
    (R.error, _) -> {}
    (R.ok, _) -> {}
  }
}

def gate_line(len Int64) Void {
  var r = syscall.write(buf, len)
  case r {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// The filesystem proof's helpers (T7.2): the names poked into the
// scratch page, a byte pattern long enough to span two sectors, the
// byte-for-byte compare, and the count of names in a list.
def put_name(a Int64) Int64 {
  poke8(a, 104B)     // h
  poke8(a + 1, 101B) // e
  poke8(a + 2, 108B) // l
  poke8(a + 3, 108B) // l
  poke8(a + 4, 111B) // o
  poke8(a + 5, 46B)  // .
  poke8(a + 6, 116B) // t
  poke8(a + 7, 120B) // x
  poke8(a + 8, 116B) // t
  return 9
}

def put_tmp(a Int64) Int64 {
  poke8(a, 116B)     // t
  poke8(a + 1, 109B) // m
  poke8(a + 2, 112B) // p
  poke8(a + 3, 46B)  // .
  poke8(a + 4, 116B) // t
  poke8(a + 5, 120B) // x
  poke8(a + 6, 116B) // t
  return 7
}

def fill(a Int64, n Int64) Void {
  var i = 0
  while i < n {
    poke8(a + i, ((i * 7 + 3) % 251).to_byte())
    i = i + 1
  }
}

def same(a Int64, b Int64, n Int64) Bool {
  var i = 0
  while i < n {
    if peek8(a + i) != peek8(b + i) {
      return false
    }
    i = i + 1
  }
  return true
}

def lines(a Int64, n Int64) Int64 {
  var count = 0
  var i = 0
  while i < n {
    if peek8(a + i) == 10B {
      count = count + 1
    }
    i = i + 1
  }
  return count
}

// The doomed branch (T4.6): a spawned pass finds this token, claims
// it (clears it — the good child re-enters this same top level and
// must not follow), says its line through the gate, then misbehaves —
// one load where its own table maps nothing. Pre-T6.2 the same load
// reached the firmware's PMP-locked region and died as an access
// fault (cause 5); on its own address space the address is simply
// unmapped, and the walk fails — the load page fault, cause 13. The
// supervisor's report is the last thing this pass prints; the kill is
// this pass's slot ending done.
if peek64(doomed_cell) != 0 {
  poke64(doomed_cell, 0)
  var dp = byte_at(0, 100) // d
  dp = byte_at(dp, 111) // o
  dp = byte_at(dp, 111) // o
  dp = byte_at(dp, 109) // m
  dp = byte_at(dp, 101) // e
  dp = byte_at(dp, 100) // d
  dp = byte_at(dp, 10)
  gate_line(dp)
  var wild = peek64(0x80000000)
  var dp2 = byte_at(0, 48 + (wild % 10)) // unreachable — the load faults
  dp2 = byte_at(dp2, 10)
  gate_line(dp2)
  syscall.exit(1)
}

// The greedy branch (T5.1): a spawned pass whose allocations outrun
// its own 64 KiB arena — the block the kernel's spawn took from its
// frame allocator (T5.3), handed across the boundary by the trap shim,
// and mapped RW with U by the pass's own table (T6.2). Its allocator
// says so through the gate (verb 5); the supervisor's report is the
// last thing this pass prints, and the machine continues — the good
// child's round trip rides after the report.
if peek64(greedy_cell) != 0 {
  poke64(greedy_cell, 0)
  var yp = byte_at(0, 103) // g
  yp = byte_at(yp, 114) // r
  yp = byte_at(yp, 101) // e
  yp = byte_at(yp, 101) // e
  yp = byte_at(yp, 100) // d
  yp = byte_at(yp, 121) // y
  yp = byte_at(yp, 10)
  gate_line(yp)
  var k = 0
  while true {
    var b = Box.new(k)
    k = k + 1
  }
}

// The smash branch (T6.4): a spawned pass stores where its own table
// maps nothing — the store page fault, cause 15 — and the
// supervisor's report names the address the hardware refused (stval).
// The parent does not wait on it, as with the doomed pass: a killed
// process never exited.
if peek64(smash_cell) != 0 {
  poke64(smash_cell, 0)
  var mp = byte_at(0, 115) // s
  mp = byte_at(mp, 109) // m
  mp = byte_at(mp, 97) // a
  mp = byte_at(mp, 115) // s
  mp = byte_at(mp, 104) // h
  mp = byte_at(mp, 10)
  gate_line(mp)
  poke64(0x40000000, 1)
  var mp2 = byte_at(0, 63) // '?' — unreachable, the store faults
  mp2 = byte_at(mp2, 10)
  gate_line(mp2)
  syscall.exit(1)
}

// The reach branch (T6.5): a spawned pass stores at a kernel address.
// Unlike the smash branch's unmapped store, the mapping IS in this
// pass's table — the kernel's half, without U — so the walk reaches
// the leaf and the permission fails: the store page fault, cause 15,
// the kernel address named in the report. The parent does not wait on
// it, as with the other killed passes.
if peek64(reach_cell) != 0 {
  poke64(reach_cell, 0)
  var rp = byte_at(0, 114) // r
  rp = byte_at(rp, 101) // e
  rp = byte_at(rp, 97) // a
  rp = byte_at(rp, 99) // c
  rp = byte_at(rp, 104) // h
  rp = byte_at(rp, 10)
  gate_line(rp)
  poke64(kernel_hi, 1)
  var rp2 = byte_at(0, 63) // '?' — unreachable, the store faults
  rp2 = byte_at(rp2, 10)
  gate_line(rp2)
  syscall.exit(1)
}

// The screen branch (T8.2, emo-desktop A7.2, A8.3): the machine's first
// full-screen pass, and its first event-driven program. The cells-page
// token is the grant's channel — the kernel's spawn-side read handed
// the carve into this pass's table at the spawn (the identity of the
// carve's physical addresses, RW with U, frames.emo's one hand). The
// pass claims the token and runs the desktop's counter through EmoUI's
// Elm loop, unchanged from the hosted backends': the mode is the
// device's own answer (T8.4's output_info), the carve at that mode is
// the fb core's surface, the sprite goes into the carve's sprite memory
// first (A8.2), and `ui.run` takes the counter's defs as values — the
// loop's `mount` paints the first frame through the core into the
// carve's own words and the carve's `present` says its digest on the
// wire before the grant's present puts the frame on the display (the
// gate checks the carve's holder, the display service judges the rect,
// and the pixels reach the display before the line does); then every
// byte the merged stream delivers (`Keys`) is an event, the tree is
// rebuilt, repainted and presented — the frame before it going back to
// the arena through the pool — until the quit key ends the loop. Then
// T8.2's proof: one pattern word per 64 KiB across the whole 4 MiB,
// poked over the last frame after its present — the exit is when the
// process service reads them back through the kernel's half, and the
// display already holds what the presents transferred (every later
// whole-screen flush shows the words again, over the frame). A pass
// whose spawn carried no grant maps none of the carve: its first store
// here is the page fault that kills it.
if peek64(screen_cell) != 0 {
  poke64(screen_cell, 0)
  case syscall.output_info(0) {
    (R.error, _) -> { mark() }
    (R.ok, mode) -> {
      output_line(mode)
      const screen = Carve.new(base: screen_base, width: out_w(mode),
        height: out_h(mode))
      sprite_upload()
      const sholder = ArrayBuilder.new()
      case desk_strike() {
        (R.error, _) -> { mark() }
        (R.ok, s2) -> { sholder.push(s2) }
      }
      const b = ui_fb.backend(screen, Keys.new(), sholder.get(0))
      ui.run(ui_fb_frame.counter.view, ui_fb_frame.counter.update,
        ui_fb_frame.counter.initial(), b)
    }
  }
  var k = 0
  while k < 64 {
    poke64(screen_base + (k * 65536), 0x7363726E + k)
    k = k + 1
  }
  syscall.exit(0)
}

// The merged event stream as the loop's input (emo-desktop A8.3): the
// fb backend pulls one tag per `next`, and this is where the machine's
// bytes become the counter's events, by the application's own rule —
// the console renderer's (docs/ui.md): `a` is the add, `b` the sub, `q`
// ends the loop (the input's end, `(R.error, _)`, is how a backend's run
// ends), and every other event is dropped, never guessed at — the
// device's key reports and the pointer's moves ride the same stream
// (T8.3, T8.11) and are not this program's. Each byte the loop consumes
// is said on the wire (`byte <n>`), the record of what drove the
// session. A method's body is the dynamic convention on this target,
// so the event decodes through the typed defs below.
class Keys {
  def next() (R, Int64) {
    var tag = -1
    while tag < 0 {
      const ev = syscall.input_read()
      if ev_type(ev) == 17741 {
        input_line(ev)
        const b = ev_value(ev)
        if b == 113 {
          return (R.error, 0)
        }
        if b == 97 {
          tag = 0
        }
        if b == 98 {
          tag = 1
        }
      }
    }
    return (R.ok, tag)
  }
}

// The first apps' keys (emo-desktop A10.3): the byte table in the
// input's seat, one tag per byte — the tag its index in the table
// names, and the table the app's own registration order keeps (`a`
// first, `b` second, and so on, the same tags the golden's script
// names) — and `q` the loop's end, the quit byte every seat's session
// ends on. Every other byte is dropped, never guessed at; the pointer's
// reports ride the same stream and are not an app's.
class AppKeys {
  def init(bytes Array[Int64]) {
    self.bytes = bytes
  }

  def next() (R, Int64) {
    var tag = -1
    while tag < 0 {
      const ev = syscall.input_read()
      if ev_type(ev) == 17741 {
        const b = ev_value(ev)
        if b == 113 {
          return (R.error, 0)
        }
        var i = 0
        while tag < 0 && i < self.bytes.length() {
          if self.bytes[i] == b {
            tag = i
          }
          i = i + 1
        }
      }
    }
    return (R.ok, tag)
  }
}

// The carve as the fb core's `Surface` (emo-desktop A7.2): the raw shim
// the assessment keeps on the metal's side alone. A pixel is a 32-bit
// word at the identity the grant mapped — `poke32` the store, `peek32`
// the load, no verb and no copy between the core and the display's
// memory — and the width and height are the display's answer, never a
// constant. The hosted twin is `emo/ui_fb_canvas`, the same words in a
// `Bytes`; the core cannot tell them apart.
//
// The pixel loops live in the typed defs below the class, not in its
// methods: on this target a method's body is the dynamic convention —
// every computed Int64 a boxed cell in the arena, and the value kinds
// carry no claims for the pool to reclaim — so a loop over 786,432
// pixels inside a method is the heap gone before the first row ends.
// A fully typed top-level def computes in raw registers and allocates
// nothing; the method hands it the words once per rectangle, which is
// a dozen times a frame, and once per glyph (A8.1's cell, A14.2's
// type), which is a hundred.
class Carve {
  def init(base Int64, width Int64, height Int64) {
    self.base = base
    self.width = width
    self.height = height
  }

  def width() Int64 {
    return self.width
  }

  def height() Int64 {
    return self.height
  }

  def at(x Int64, y Int64) Int64 {
    if x < 0 || x >= self.width || y < 0 || y >= self.height {
      return 0
    }
    return carve_at(self.base, self.width, x, y)
  }

  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_fill(self.base, self.width, r.x(), r.y(), r.w(), r.h(),
      color & 0xFFFFFF)
  }

  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_blend(self.base, self.width, r.x(), r.y(), r.w(), r.h(), color)
  }

  // One glyph of a strike (emo-desktop A14.2, A8.1's cell before it):
  // handed down whole — the glyph is the unit the core calls in, once
  // per character, because every Int64 an interface call carries is a
  // boxed cell on this target — and inked by the window buffer
  // package's typed walk, the one copy every metal surface shares.
  def ink(x Int64, y Int64, f ui_fb.raster.Strike, glyph Int64,
          color Int64) {
    ui_fb_winbuf.carve_ink(self.base,
      ui_fb_winbuf.pack(self.width, self.height), x, y, f, glyph, color)
  }

  // The shapes (emo-desktop A14.1): the window buffer package's typed
  // walks, one copy for every metal surface — the carve's shape is
  // theirs, the words packed two to one for the call.
  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    ui_fb_winbuf.carve_rounded(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, top, bottom)
  }

  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    ui_fb_winbuf.carve_stroke(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, width, color)
  }

  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    ui_fb_winbuf.carve_shadow(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, soft, color)
  }

  // The commit (emo-desktop A8.3): the backend calls it after every
  // paint. The frame's digest off the carve's own words goes on the
  // wire first (`frame <n>`, the number the hosted twin prints and the
  // screendump digests to), then the grant's present puts the frame on
  // the display — the gate checks the carve's holder, the display
  // service judges the rect, the transfer and the flush complete — and
  // `present ok` says so after.
  def present() {
    frame_line(carve_digest(self.base, self.width, self.height))
    case syscall.present(0, 0, 0, self.width, self.height) {
      (R.error, _) -> { mark() }
      (R.ok, _) -> { present_ok() }
    }
  }
}

def carve_at(base Int64, width Int64, x Int64, y Int64) Int64 {
  return peek32(base + (y * width + x) * 4)
}

def carve_fill(base Int64, width Int64, x Int64, y Int64, w Int64,
               h Int64, word Int64) Void {
  var row = y
  while row < y + h {
    var col = x
    while col < x + w {
      poke32(base + (row * width + col) * 4, word)
      col = col + 1
    }
    row = row + 1
  }
}

def carve_blend(base Int64, width Int64, x Int64, y Int64, w Int64,
                h Int64, color Int64) Void {
  var row = y
  while row < y + h {
    var col = x
    while col < x + w {
      var i = base + (row * width + col) * 4
      poke32(i, ui_fb.over(color, peek32(i)))
      col = col + 1
    }
    row = row + 1
  }
}

// The pointer sprite into the carve's sprite memory (emo-desktop A8.2,
// EmoOS T8.11): the desktop's drawing — `ui_fb.pointer`'s rows, read
// cell by cell — as ARGB words, the outline's ink and the body's paper
// opaque (the top byte 0xFF) and the clear cells 0, then the header
// last — the width, the height, the hotspot — so the compositor's
// cursor plane, which reads the header at each composition, sees no
// sprite until the pixels are whole. The memory is the carve's last
// 64 KiB, which this pass has mapped with the rest of the carve; the
// sprite starts past the block's first line, where T8.2's proof pattern
// below lands its word (docs/desktop-abi.md).
def sprite_upload() Void {
  const header = screen_base + screen_size - 65536 + 64
  const w = ui_fb.pointer.width()
  const h = ui_fb.pointer.height()
  var r = 0
  while r < h {
    const line = ui_fb.pointer.row(r)
    var c = 0
    while c < w {
      const cell = line.substring(c, 1)
      var word = 0
      // the coverage the drawing's cell carries: `#` and `o` whole, the
      // digits and letters the outline's partial ink (the pointer's own
      // decode), the clear cells 0
      if cell == "#" {
        word = 0xFF000000
      }
      if cell == "o" {
        word = 0xFFFFFFFF
      }
      if cell == "1" {
        word = 285212672
      }
      if cell == "2" {
        word = 570425344
      }
      if cell == "3" {
        word = 855638016
      }
      if cell == "4" {
        word = 1140850688
      }
      if cell == "5" {
        word = 1426063360
      }
      if cell == "6" {
        word = 1711276032
      }
      if cell == "7" {
        word = 1996488704
      }
      if cell == "8" {
        word = 2281701376
      }
      if cell == "9" {
        word = 2566914048
      }
      if cell == "a" {
        word = 2852126720
      }
      if cell == "b" {
        word = 3127339392
      }
      poke32(header + 16 + ((r * w) + c) * 4, word)
      c = c + 1
    }
    r = r + 1
  }
  poke32(header + 8, ui_fb.pointer.hot_x())
  poke32(header + 12, ui_fb.pointer.hot_y())
  poke32(header + 4, h)
  poke32(header, w)
}

// The frame's digest off the carve's own words — `ui_fb_frame.digest`'s
// fold, `d = (d * 31 + word) mod 2^32` over every pixel in row-major
// order, in a typed loop over `peek32` rather than through the
// surface's `at`: a method call per pixel would box its answer into the
// arena 786,432 times. The hosted twin folds through the canvas; the
// screendump's Python folds the display's bytes; the three agree on one
// number or on none (run.sh).
def carve_digest(base Int64, width Int64, height Int64) Int64 {
  var d = 0
  var row = 0
  while row < height {
    var col = 0
    while col < width {
      d = (d * 31 + peek32(base + (row * width + col) * 4)) & 4294967295
      col = col + 1
    }
    row = row + 1
  }
  return d
}

// A window's buffer as the fb core's `Surface` (emo-desktop A9.1): the
// run win_new handed, mapped into this pass's own table at the identity
// of its physical addresses — the carve's shape over a smaller
// rectangle, the same typed pixel loops behind the verbs, and the
// grant the buffer is named by ever after. `present` is the window's
// commit: the frame's digest off the buffer's own words on the wire
// first (`frame <n>`, the number the hosted twin prints for the same
// paint and the screendump's fold over the window's rectangle answers),
// then the grant's present — the gate checks the owner and the rect,
// the compositor composites the whole stack with this frame in it and
// flushes — and the compositor's own line is the answer's echo; the
// pass says nothing after, so the carve's four `present ok` stay the
// loop's count.
class Win {
  def init(grant Int64, base Int64, width Int64, height Int64) {
    self.grant = grant
    self.base = base
    self.width = width
    self.height = height
  }

  def width() Int64 {
    return self.width
  }

  def height() Int64 {
    return self.height
  }

  def at(x Int64, y Int64) Int64 {
    if x < 0 || x >= self.width || y < 0 || y >= self.height {
      return 0
    }
    return carve_at(self.base, self.width, x, y)
  }

  def fill(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_fill(self.base, self.width, r.x(), r.y(), r.w(), r.h(),
      color & 0xFFFFFF)
  }

  def blend(x Int64, y Int64, w Int64, h Int64, color Int64) {
    const r = ui_fb.clip(x, y, w, h, self.width, self.height)
    carve_blend(self.base, self.width, r.x(), r.y(), r.w(), r.h(), color)
  }

  def ink(x Int64, y Int64, f ui_fb.raster.Strike, glyph Int64,
          color Int64) {
    ui_fb_winbuf.carve_ink(self.base,
      ui_fb_winbuf.pack(self.width, self.height), x, y, f, glyph, color)
  }

  def rounded(x Int64, y Int64, w Int64, h Int64, radius Int64, top Int64,
              bottom Int64) {
    ui_fb_winbuf.carve_rounded(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, top, bottom)
  }

  def stroke(x Int64, y Int64, w Int64, h Int64, radius Int64, width Int64,
             color Int64) {
    ui_fb_winbuf.carve_stroke(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, width, color)
  }

  def shadow(x Int64, y Int64, w Int64, h Int64, radius Int64, soft Int64,
             color Int64) {
    ui_fb_winbuf.carve_shadow(self.base,
      ui_fb_winbuf.pack(self.width, self.height), ui_fb_winbuf.pack(x, y),
      ui_fb_winbuf.pack(w, h), radius, soft, color)
  }

  def present() {
    frame_line(ui_fb_winbuf.round_digest(self.base, self.width, self.height))
    case syscall.present(self.grant, 0, 0, self.width, self.height) {
      (R.error, _) -> { mark() }
      (R.ok, _) -> {}
    }
  }
}

// The pointer's report scaled to the display (emo-desktop A9.1): the
// device's value over its axis's range, the compositor's own arithmetic
// for its cursor — the range is the device's answer through input_info,
// never a constant of this pass's.
def scaled(v Int64, mode Int64, max Int64) Int64 {
  return (v * mode) / (max + 1)
}

// The drag's next coordinate: the pointer less the grab offset, kept
// on the display, and — for x — on the blit's word granularity the
// move verb insists on.
def dragged(p Int64, grab Int64, extent Int64, mode Int64, even Bool) Int64 {
  var n = p - grab
  if n < 0 {
    n = 0
  }
  if n + extent > mode {
    n = mode - extent
  }
  if even {
    n = n - (n % 2)
  }
  return n
}

def inside(px Int64, py Int64, x Int64, y Int64, w Int64, h Int64) Bool {
  return px >= x && px < x + w && py >= y && py < y + h
}

// The role refusals' lines (emo-desktop A9.1): `role <name> r<n>` — the
// caller chose the role, so the caller names it; the kernel refuses by
// the number alone (the protocol carries no text, the seventh seam).
def role_name_at(role Int64, pos Int64) Int64 {
  var p = pos
  if role == 0 {
    p = byte_at(p, 116) // t
    p = byte_at(p, 111) // o
    p = byte_at(p, 112) // p
    p = byte_at(p, 108) // l
    p = byte_at(p, 101) // e
    p = byte_at(p, 118) // v
    p = byte_at(p, 101) // e
    p = byte_at(p, 108) // l
  }
  if role == 1 {
    p = byte_at(p, 112) // p
    p = byte_at(p, 111) // o
    p = byte_at(p, 112) // p
    p = byte_at(p, 117) // u
    p = byte_at(p, 112) // p
  }
  if role == 2 {
    p = byte_at(p, 115) // s
    p = byte_at(p, 117) // u
    p = byte_at(p, 98) // b
    p = byte_at(p, 115) // s
    p = byte_at(p, 117) // u
    p = byte_at(p, 114) // r
    p = byte_at(p, 102) // f
    p = byte_at(p, 97) // a
    p = byte_at(p, 99) // c
    p = byte_at(p, 101) // e
  }
  if role == 3 {
    p = byte_at(p, 112) // p
    p = byte_at(p, 97) // a
    p = byte_at(p, 110) // n
    p = byte_at(p, 101) // e
    p = byte_at(p, 108) // l
  }
  return p
}

def role_refused_line(role Int64, reason Int64) Void {
  var p = byte_at(0, 114) // r
  p = byte_at(p, 111) // o
  p = byte_at(p, 108) // l
  p = byte_at(p, 101) // e
  p = byte_at(p, 32) // space
  p = role_name_at(role, p)
  p = byte_at(p, 32) // space
  p = byte_at(p, 114) // r
  p = num_at(reason, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// A role the compositor refuses, asked for and named: the pass asks
// for it knowing the answer, the way the input pass asks for a present
// it has no grant for — the refusal is the proof.
def role_refusal(grant Int64, role Int64) Void {
  case syscall.win_role(grant, role) {
    (R.error, why) -> { role_refused_line(role, reason_num(why)) }
    (R.ok, _) -> { mark() }
  }
}

// The present's refusal line: `present r<n>` — the input pass's
// permission refusal (T8.4) and the window pass's surface-less one
// (A9.1) share it.
def present_refused_line(reason Int64) Void {
  var gp = byte_at(0, 112) // p
  gp = byte_at(gp, 114) // r
  gp = byte_at(gp, 101) // e
  gp = byte_at(gp, 115) // s
  gp = byte_at(gp, 101) // e
  gp = byte_at(gp, 110) // n
  gp = byte_at(gp, 116) // t
  gp = byte_at(gp, 32) // space
  gp = byte_at(gp, 114) // r
  gp = num_at(reason, gp)
  gp = byte_at(gp, 10)
  gate_line(gp)
}

// The window shell's lines (emo-desktop A9.1), each `desk ` and a fact:
// the pointer's range (verb 18's answer), a window's grant by its
// letter, the focus, a key routed, a drag's end.
def desk_at() Int64 {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 32) // space
  return p
}

def desk_range_line(mx Int64, my Int64) Void {
  var p = desk_at()
  p = byte_at(p, 114) // r
  p = byte_at(p, 97) // a
  p = byte_at(p, 110) // n
  p = byte_at(p, 103) // g
  p = byte_at(p, 101) // e
  p = byte_at(p, 32) // space
  p = num_at(mx, p)
  p = byte_at(p, 32)
  p = num_at(my, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_win_line(letter Int64, id Int64) Void {
  var p = desk_at()
  p = byte_at(p, letter)
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_focus_line(id Int64) Void {
  var p = desk_at()
  p = byte_at(p, 102) // f
  p = byte_at(p, 111) // o
  p = byte_at(p, 99) // c
  p = byte_at(p, 117) // u
  p = byte_at(p, 115) // s
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_key_line(id Int64, n Int64) Void {
  var p = desk_at()
  p = byte_at(p, 107) // k
  p = byte_at(p, 101) // e
  p = byte_at(p, 121) // y
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 32)
  p = num_at(n, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_drag_line(id Int64, x Int64, y Int64) Void {
  var p = desk_at()
  p = byte_at(p, 100) // d
  p = byte_at(p, 114) // r
  p = byte_at(p, 97) // a
  p = byte_at(p, 103) // g
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 32)
  p = num_at(x, p)
  p = byte_at(p, 32)
  p = num_at(y, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The frame's digest, as the pass's line: `frame <digest>` — the number
// the hosted twin prints and the screendump digests to (run.sh).
def frame_line(d Int64) Void {
  var p = byte_at(0, 102) // f
  p = byte_at(p, 114) // r
  p = byte_at(p, 97) // a
  p = byte_at(p, 109) // m
  p = byte_at(p, 101) // e
  p = byte_at(p, 32) // space
  p = num_at(d, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The merged event's halves (T8.3): the type in bits 48..63, the code
// above the low word, the value in it — the decode in typed defs (the
// riscv64 emitter refuses the operators on a dynamic value).
def ev_type(e Int64) Int64 {
  return e >> 48
}

def ev_code(e Int64) Int64 {
  return (e >> 32) & 65535
}

def ev_value(e Int64) Int64 {
  return e & 4294967295
}

// The display's answer's halves (T8.4): the width above, the height
// below — the decode in typed defs, as every mailbox word's.
def out_w(m Int64) Int64 {
  return m >> 32
}

def out_h(m Int64) Int64 {
  return m & 4294967295
}

// The enumeration's answer, as the pass's line: `output <w>x<h>` —
// the mode the device itself reports (the verb's index 0; the one
// display is the first answer, not the only shape).
def output_line(m Int64) Void {
  var p = byte_at(0, 111) // o
  p = byte_at(p, 117) // u
  p = byte_at(p, 116) // t
  p = byte_at(p, 112) // p
  p = byte_at(p, 117) // u
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) // space
  p = num_at(out_w(m), p)
  p = byte_at(p, 120) // x
  p = num_at(out_h(m), p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The commit's answer, as the pass's line: `present ok` — the device's
// transfer and flush both complete before the answer lands.
def present_ok() Void {
  var p = byte_at(0, 112) // p
  p = byte_at(p, 114) // r
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 101) // e
  p = byte_at(p, 110) // n
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) // space
  p = byte_at(p, 111) // o
  p = byte_at(p, 107) // k
  p = byte_at(p, 10)
  gate_line(p)
}

// The window answer's halves (T8.5): the buffer's frame number above
// (the byte address shifted left by 12 — the frame number keeps the
// word's sign bit true), the grant id below.
def win_id(ans Int64) Int64 {
  return ans & 4294967295
}

def win_base(ans Int64) Int64 {
  return (ans >> 32) << 12
}

// The buffer's paint: one pattern word per 8 bytes, the row's number
// in the word's low three bytes over the caller's base — the
// deterministic pattern the readback verifies and the display model
// recomputes.
def paint_win(base Int64, rows Int64, row_words Int64, word_base Int64) Void {
  var r = 0
  while r < rows {
    var word = word_base + r
    var pair = word | (word << 32)
    var i = 0
    while i < row_words {
      poke64(base + (r * row_words + i) * 8, pair)
      i = i + 1
    }
    r = r + 1
  }
}

// The frame's sum (T8.6): every word the buffer holds — the number
// the compositor's composition line carries, the blit's proof.
def buffer_sum(base Int64, rows Int64, row_words Int64) Int64 {
  var sum = 0
  var r = 0
  while r < rows {
    var i = 0
    while i < row_words {
      sum = sum + peek64(base + (r * row_words + i) * 8)
      i = i + 1
    }
    r = r + 1
  }
  return sum
}

// The readback: every word the paint wrote, compared.
def win_verify(base Int64, rows Int64, row_words Int64) Bool {
  var r = 0
  var ok = true
  while r < rows {
    var word = 0x57494E00 + r
    var pair = word | (word << 32)
    var i = 0
    while i < row_words {
      if peek64(base + (r * row_words + i) * 8) != pair {
        ok = false
      }
      i = i + 1
    }
    r = r + 1
  }
  return ok
}

// The lifecycle's lines (T8.5): the grant, the verified paint, the
// commit, the release.
def win_line(id Int64) Void {
  var p = byte_at(0, 119) // w
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def win_ok_line() Void {
  var p = byte_at(0, 119) // w
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 32) // space
  p = byte_at(p, 111) // o
  p = byte_at(p, 107) // k
  p = byte_at(p, 10)
  gate_line(p)
}

def win_shown_line() Void {
  var p = byte_at(0, 119) // w
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 32) // space
  p = byte_at(p, 115) // s
  p = byte_at(p, 104) // h
  p = byte_at(p, 111) // o
  p = byte_at(p, 119) // w
  p = byte_at(p, 110) // n
  p = byte_at(p, 10)
  gate_line(p)
}

