def parent_panel_line() Void {
  var p = byte_at(0, 112) // p
  p = byte_at(p, 97) // a
  p = byte_at(p, 114) // r
  p = byte_at(p, 101) // e
  p = byte_at(p, 110) // n
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) //  
