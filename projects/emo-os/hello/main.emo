def win_focused_line() Void {
  var p = byte_at(0, 119) // w
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 32) // space
  p = byte_at(p, 102) // f
  p = byte_at(p, 111) // o
  p = byte_at(p, 99) // c
  p = byte_at(p, 117) // u
  p = byte_at(p, 115) // s
  p = byte_at(p, 101) // e
  p = byte_at(p, 100) // d
