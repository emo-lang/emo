// One event, as the pass's line: the machine's byte event (0x454D —
// "EM") prints `byte <v>`, a device event `key <t> <c> <v>`.
def input_line(ev Int64) Void {
  if ev_type(ev) == 17741 {
    var bp = byte_at(0, 98) // b
    bp = byte_at(bp, 121) // y
    bp = byte_at(bp, 116) // t
    bp = byte_at(bp, 101) // e
    bp = byte_at(bp, 32) // space
    bp = num_at(ev_value(ev), bp)
    bp = byte_at(bp, 10)
    gate_line(bp)
  } else {
    var tp = byte_at(0, 107) // k
    tp = byte_at(tp, 101) // e
    tp = byte_at(tp, 121) // y
    tp = byte_at(tp, 32) // space
    tp = num_at(ev_type(ev), tp)
    tp = byte_at(tp, 32)
    tp = num_at(ev_code(ev), tp)
    tp = byte_at(tp, 32)
    tp = num_at(ev_value(ev), tp)
    tp = byte_at(tp, 10)
    gate_line(tp)
  }
}

// The pointer's absolute event as the pass's line (T8.11): `move <axis>
// <value>` — the axis code (0 X, 1 Y) and the device's own value.
def move_line(ev Int64) Void {
  var mp = byte_at(0, 109) // m
  mp = byte_at(mp, 111) // o
  mp = byte_at(mp, 118) // v
  mp = byte_at(mp, 101) // e
  mp = byte_at(mp, 32) // space
  mp = num_at(ev_code(ev), mp)
  mp = byte_at(mp, 32)
  mp = num_at(ev_value(ev), mp)
  mp = byte_at(mp, 10)
  gate_line(mp)
}

// The input branch (T8.3, T8.11): a pass parked on the machine's merged
// input stream — `keys?` on the wire as it waits. The run's hands (the
// monitor's sendkey) deliver the device's key event, and the serial's
// byte rides the same stream after it: one stream, the bytes first.
// The key's release and the reports' separators ride the stream too,
// unasserted — the pass reads on to the byte. Then the pointer's half
// (T8.11): the monitor's mouse_move moves the tablet, and its absolute
// report comes through the same stream after the keyboard's events —
// the X and the Y in the device's own order, each on the wire — the
// pass reading until the Y lands. Three sources, one stream. Every
// line through the gate; the pass ends and the parent's wait answers.
if peek64(key_cell) != 0 {
  poke64(key_cell, 0)
  var kp = byte_at(0, 107) // k
  kp = byte_at(kp, 101) // e
  kp = byte_at(kp, 121) // y
  kp = byte_at(kp, 115) // s
  kp = byte_at(kp, 63) // ?
  kp = byte_at(kp, 10)
  gate_line(kp)
  input_line(syscall.input_read())
  var byte_seen = false
  while !byte_seen {
    const ev = syscall.input_read()
    if ev_type(ev) == 17741 {
      input_line(ev)
      byte_seen = true
    }
  }
  var y_seen = false
  while !y_seen {
    const ev = syscall.input_read()
    if ev_type(ev) == 3 {
      move_line(ev)
      if ev_code(ev) == 1 {
        y_seen = true
      }
    }
  }
  // The grant's edge (T8.4): the pass holds no display grant — the
  // present is the permission refusal, the reason number on the wire.
  case syscall.present(0, 0, 0, 1, 1) {
    (R.error, why) -> { present_refused_line(reason_num(why)) }
    (R.ok, _) -> { mark() }
  }
  // The grant table's edge (T8.5): no window exists yet — the close
  // is the argument refusal, the unknown grant the table cannot name.
  case syscall.win_close(1) {
    (R.error, why) -> {
      var cp = byte_at(0, 99) // c
      cp = byte_at(cp, 108) // l
      cp = byte_at(cp, 111) // o
      cp = byte_at(cp, 115) // s
      cp = byte_at(cp, 101) // e
      cp = byte_at(cp, 32) // space
      cp = byte_at(cp, 114) // r
      cp = num_at(reason_num(why), cp)
      cp = byte_at(cp, 10)
      gate_line(cp)
    }
    (R.ok, _) -> { mark() }
  }
  syscall.exit(0)
}

// The window branch (T8.5, emo-desktop A9.1): a pass holding its own
// buffer — the run win_new handed, mapped into this pass's own table at
// the identity of its physical addresses. The buffer is no surface yet:
// the pass asks for the three roles the compositor does not implement
// and names each refusal (`role popup r4`, `role subsurface r4`, `role
// panel r4` — the kernel refuses by the number, the caller who chose
// the role names it), presents the role-less buffer and meets the
// surface's absence (`present r4` — the gate's checks pass, the
// compositor's stack has no entry for it), then declares the toplevel
// role, and from there the buffer is a window: the pass paints it,
// reads it back (the mapping is the proof), commits it (the compositor's
