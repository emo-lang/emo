  p = byte_at(p, 97) // a
  p = byte_at(p, 110) // n
  p = byte_at(p, 101) // e
  p = byte_at(p, 108) // l
  p = byte_at(p, 32) //  
  p = byte_at(p, 114) // r
  p = byte_at(p, 52) // 4
  p = byte_at(p, 10)
  gate_line(p)
}

