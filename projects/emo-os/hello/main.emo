    (R.error, _) -> { mark() }
    (R.ok, r) -> { range = r }
  }
  const mw = out_w(mode)
  const mh = out_h(mode)
  const max_x = out_w(range)
  const max_y = out_h(range)
  desk_range_line(max_x, max_y)
  const ww = ui_fb_win.width()
  const wh = ui_fb_win.height()
  var ga = 0
  var base_a = 0
  case syscall.win_new(ww, wh) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      ga = win_id(ans)
      base_a = win_base(ans)
    }
  }
  var gb = 0
  var base_b = 0
  case syscall.win_new(ww, wh) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      gb = win_id(ans)
      base_b = win_base(ans)
    }
  }
  // The shell's dock (emo-desktop A10.2): a panel surface at the
  // display's bottom edge — the walk's topmost strip, no window over
  // it — one tile per app, the focused app's lit.
  const dw = mw
  const dh = emo_desktop.strip_height()
  var gd = 0
  var base_d = 0
  case syscall.win_new(dw, dh) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      gd = win_id(ans)
      base_d = win_base(ans)
    }
  }
  desk_win_line(97, ga) // a
  desk_win_line(98, gb) // b
  case syscall.win_role(ga, 0) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_role(gb, 0) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_role(gd, 3) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  var ax = 64
  var ay = 128
  var bx = 576
  var by = 384
  case syscall.win_move(ga, ax, ay) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_move(gb, bx, by) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_move(gd, 0, mh - dh) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  // The start's park (the counter's shape): the pass waits for the
  // run's first byte before its first frame — the beat between the
  // window pass's era on the display and this one's, which `run.sh`'s
  // screendump of the window's moved copy needs to be still. The byte
  // itself is nothing: the loop's drop rules name what counts.
  var wake = syscall.input_read()
  const wa = Win.new(grant: ga, base: base_a, width: ww, height: wh)
  var wb = Win.new(grant: gb, base: base_b, width: ww, height: wh)
  const labels = ["a", "b"]
  // The focus: none until a press names a window; the top of the
  // stack as this pass knows it — beta, declared last, until a focus
  // raises the other — is the one the hit test asks first.
  var focused = 0
  var top = gb
  var keys_a = 0
  var keys_b = 0
  ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), false, keys_a)
  wa.present()
  ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, keys_b)
  wb.present()
  desk_strip_paint(tf, base_d, gd, dw, mh, labels, -1, 0)
  var px = 0
  var py = 0
  var drag = 0
  var gdx = 0
  var gdy = 0
  var running = true
  while running {
    const ev = syscall.input_read()
    const t = ev_type(ev)
    if t == 17741 {
      const b = ev_value(ev)
      if b == 113 {
        running = false
      }
      // The close-and-reopen beat (EmoOS T9.3): beta closed and another
      // window opened in the same life — the run's blocks back to the
      // allocator and the owner's table keeping their leaves was the
      // machine's end (`sv39: an address mapped twice`); the close's
      // unmap is the other half, and the reopened window's map — over
      // the very blocks the close gave back — is the proof it happened.
      // Beta comes back where it stood, unfocused, its keys count the
      // fresh window's own.
      if b == 99 {
        case syscall.win_close(gb) {
          (R.error, _) -> { mark() }
          (R.ok, _) -> {}
        }
        var ngb = 0
        var nbase = 0
        case syscall.win_new(ww, wh) {
          (R.error, _) -> { mark() }
          (R.ok, ans) -> {
            ngb = win_id(ans)
            nbase = win_base(ans)
          }
        }
        gb = ngb
        base_b = nbase
        case syscall.win_role(gb, 0) {
          (R.error, _) -> { mark() }
          (R.ok, _) -> {}
        }
        case syscall.win_move(gb, bx, by) {
          (R.error, _) -> { mark() }
          (R.ok, _) -> {}
        }
        wb = Win.new(grant: gb, base: base_b, width: ww, height: wh)
        ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, 0)
        wb.present()
        desk_win_line(98, gb)
        focused = 0
        top = gb
        desk_strip_paint(tf, base_d, gd, dw, mh, labels, -1, 0)
      }
      if b == 97 && focused != 0 {
        if focused == ga {
          keys_a = keys_a + 1
          ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), true, keys_a)
          wa.present()
          desk_key_line(ga, keys_a)
        } else {
          keys_b = keys_b + 1
          ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), true, keys_b)
          wb.present()
          desk_key_line(gb, keys_b)
        }
      }
    }
    if t == 3 {
      if ev_code(ev) == 0 {
        px = scaled(ev_value(ev), mw, max_x)
      }
      if ev_code(ev) == 1 {
        py = scaled(ev_value(ev), mh, max_y)
      }
      if drag == ga {
        const nx = dragged(px, gdx, ww, mw, true)
        const ny = dragged(py, gdy, wh, mh, false)
        if nx != ax || ny != ay {
          case syscall.win_move(ga, nx, ny) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {
              ax = nx
              ay = ny
            }
          }
        }
      }
      if drag == gb {
        const nx = dragged(px, gdx, ww, mw, true)
        const ny = dragged(py, gdy, wh, mh, false)
        if nx != bx || ny != by {
          case syscall.win_move(gb, nx, ny) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {
              bx = nx
              by = ny
            }
          }
        }
      }
    }
    // The tablet's left button (BTN_LEFT, 272): the press is the hit
    // test — the stack's top first — and the release ends a drag with
    // the present that shows where it went.
    if t == 1 && ev_code(ev) == 272 {
      if ev_value(ev) == 1 {
        var hit = 0
        if py >= mh - dh {
          // The strip is the dock's: a press there names a tile, and
          // the tile names its app — no window beneath is consulted,
          // and no drag begins (the dock is topmost; the walk paints
          // it over everything).
          const tile = emo_desktop.press(px, py, mw, mh, 2)
          if tile == 0 {
            hit = ga
          }
          if tile == 1 {
            hit = gb
          }
        } else {
          if top == gb {
            if inside(px, py, bx, by, ww, wh) {
              hit = gb
            } else {
              if inside(px, py, ax, ay, ww, wh) {
                hit = ga
              }
            }
          } else {
            if inside(px, py, ax, ay, ww, wh) {
              hit = ga
            } else {
              if inside(px, py, bx, by, ww, wh) {
                hit = gb
              }
            }
          }
        }
        if hit != 0 && hit != focused {
          case syscall.win_focus(hit) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          if focused == ga {
            ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), false, keys_a)
            wa.present()
          }
          if focused == gb {
            ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), false, keys_b)
            wb.present()
          }
          focused = hit
          top = hit
          if hit == ga {
            ui_fb_win.paint(wa, tf, ui_fb_win.title_a(), true, keys_a)
            wa.present()
          } else {
            ui_fb_win.paint(wb, tf, ui_fb_win.title_b(), true, keys_b)
            wb.present()
          }
          var lit = -1
          if hit == ga {
            lit = 0
          }
          if hit == gb {
            lit = 1
          }
          desk_strip_paint(tf, base_d, gd, dw, mh, labels, lit, 0)
          desk_focus_line(hit)
        }
        if hit == ga && py < mh - dh && (py - ay) < ui_fb_win.bar_height() {
          drag = ga
          gdx = px - ax
          gdy = py - ay
        }
        if hit == gb && py < mh - dh && (py - by) < ui_fb_win.bar_height() {
          drag = gb
          gdx = px - bx
          gdy = py - by
        }
      } else {
        if drag == ga {
          wa.present()
          desk_drag_line(ga, ax, ay)
        }
        if drag == gb {
          wb.present()
          desk_drag_line(gb, bx, by)
        }
        drag = 0
      }
    }
  }
  case syscall.win_close(ga) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_close(gb) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_close(gd) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  syscall.exit(0)
}

// The first apps (emo-desktop A10.3) lived here as token branches of
// this image — each a pass re-entering this top level. A11.1 moved
// them out: each app is a disk ELF of its own (`fb/apps/counter/` and
// its siblings, the sources of the images this image's kernel embeds),
// exec'd by name in the parent's own flow below. No token, no branch.

// The child branch (T4.4): a spawned process re-enters this top level
// sharing the image — its runtime state, its consts, this cell — so
// the token the parent pokes just before the spawn is the one
// difference between the two passes. The child says its line and ends
// as an exit the parent's wait can answer.
if peek64(child_cell) != 0 {
  var bp = byte_at(0, 98) // b
  bp = byte_at(bp, 111) // o
  bp = byte_at(bp, 114) // r
  bp = byte_at(bp, 110) // n
  bp = byte_at(bp, 10)
  gate_line(bp)
  syscall.exit(7)
}

// The greeting, through the gate: U-mode's world is its own pages now
// (T6.2) — the 16550A is the kernel's, and the greeting is the gate's
// first line. The sum is the register file's pin, as it always was.
var gp = byte_at(0, 85) // U
gp = byte_at(gp, 45) // -
gp = byte_at(gp, 77) // M
gp = byte_at(gp, 79) // O
gp = byte_at(gp, 68) // D
gp = byte_at(gp, 69) // E
gp = byte_at(gp, 32) // space
var sum = 0
var i = 0
while i <= 1000 {
  sum = sum + i
  i = i + 1
}
gp = num_at(sum, gp)
gp = byte_at(gp, 10)
gate_line(gp)

// The gate proof: one write that answers, two that refuse — the text
// segment with reason 3 (no permission), the kernel's memory with
// reason 2 (out of range) — and each refusal printed by the same gate
// that refused it. The line reads `gate 500500 r3 r2`.
var pos = byte_at(0, 103) // g
pos = byte_at(pos, 97) // a
pos = byte_at(pos, 116) // t
pos = byte_at(pos, 101) // e
pos = byte_at(pos, 32) // space
pos = num_at(sum, pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(text_seg, 4)), pos)
pos = byte_at(pos, 32)
pos = byte_at(pos, 114) // r
pos = num_at(reason_of(syscall.write(kernel_mem, 4)), pos)
pos = byte_at(pos, 10)
gate_line(pos)

// The read proof: block on the console until a byte exists, then
// print it — `echo 88` when the feed is an X.
var c = syscall.read()
var rp = byte_at(0, 101) // e
rp = byte_at(rp, 99) // c
rp = byte_at(rp, 104) // h
rp = byte_at(rp, 111) // o
rp = byte_at(rp, 32) // space
rp = num_at(c, rp)
rp = byte_at(rp, 10)
gate_line(rp)

// The filesystem proof (T7.2, docs/fs.md): a 600-byte file written
// through the gate — two sectors, the second one's tail zero on the
// disk — and read back byte for byte; a second file written and
// removed; the list naming what is left: the root's boot file and
// this one. `fs rw ok` is the roundtrip, `fs ls 2` the list; a
// refusal or a wrong byte prints `fs rw ?`. The proof runs before the
// spawns, so no other pass is on the service meanwhile.
var fn = put_name(fs_name)
fill(fs_data, 600)
var fs_ok = true
case syscall.file_write(fs_name, fn, fs_data, 600) {
  (R.error, _) -> { fs_ok = false }
  (R.ok, wn) -> {
    if wn != 600 {
      fs_ok = false
    }
  }
}
case syscall.file_read(fs_name, fn, fs_back, 2048) {
  (R.error, _) -> { fs_ok = false }
  (R.ok, rn) -> {
    if rn != 600 {
      fs_ok = false
    }
  }
}
if !same(fs_data, fs_back, 600) {
  fs_ok = false
}
var tn = put_tmp(fs_tmp)
case syscall.file_write(fs_tmp, tn, fs_data, 1) {
  (R.error, _) -> { fs_ok = false }
  (R.ok, _) -> {}
}
case syscall.file_remove(fs_tmp, tn) {
  (R.error, _) -> { fs_ok = false }
  (R.ok, _) -> {}
}
var listed = 0
case syscall.file_list(fs_names, 256) {
  (R.error, _) -> { fs_ok = false }
  (R.ok, ln) -> { listed = ln }
}
var xp = byte_at(0, 102) // f
xp = byte_at(xp, 115) // s
xp = byte_at(xp, 32) // space
xp = byte_at(xp, 114) // r
xp = byte_at(xp, 119) // w
xp = byte_at(xp, 32) // space
if fs_ok {
  xp = byte_at(xp, 111) // o
  xp = byte_at(xp, 107) // k
} else {
  xp = byte_at(xp, 63) // ?
}
xp = byte_at(xp, 10)
gate_line(xp)
var lp = byte_at(0, 102) // f
lp = byte_at(lp, 115) // s
lp = byte_at(lp, 32) // space
lp = byte_at(lp, 108) // l
lp = byte_at(lp, 115) // s
lp = byte_at(lp, 32) // space
lp = num_at(lines(fs_names, listed), lp)
lp = byte_at(lp, 10)
gate_line(lp)

// The kill proof (T4.6): the misbehaving child spawns first — its
// line, then its fault, then the supervisor's loud report — and the
// parent does NOT wait on it: a killed process never exited, so its
// wait would block forever (the stated bound). The runaway proof
// (T5.1) rides the same shape: a greedy pass whose boxes outrun its
// own 64 KiB arena — its allocator announces the exhaustion (verb 5),
// the supervisor's report follows, and the machine goes on. The
// store-fault proof (T6.4) rides it too: a pass that stores where its
// own table maps nothing — the page-fault kill named by its address,
// stval in the report. And the isolation proof (T6.5): a pass that
// stores at a kernel address, where the mapping is there without U
// and the permission is what fails — the same kill, the kernel's own
// address named. The good child's `born`/`wait 7` after the four
// reports is the survival proof.
poke64(doomed_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}
poke64(greedy_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}
poke64(smash_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}
poke64(reach_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}

// The process proof (T4.4): spawn a child — it re-enters this top
// level, finds the token, prints its line, and exits 7 — then wait
// for that exit and print the code. `wait 7` on the wire is the
// whole spawn/wait round trip: the request, the park, the service,
// and the exit that answers it.
poke64(child_cell, 1)
var spawned = syscall.spawn()
case spawned {
  (R.error, _) -> { mark() }
  (R.ok, pid) -> {
    var waited = syscall.wait(pid)
    case waited {
      (R.error, _) -> { mark() }
      (R.ok, code) -> {
        var wp = byte_at(0, 119) // w
        wp = byte_at(wp, 97) // a
        wp = byte_at(wp, 105) // i
        wp = byte_at(wp, 116) // t
        wp = byte_at(wp, 32) // space
        wp = num_at(code, wp)
        wp = byte_at(wp, 10)
        gate_line(wp)
      }
    }
  }
}

// The screen carve's proof (T8.2): the machine's first full-screen
// pass. The token poked, the spawn's kernel side reads it and hands
// the carve into the child's table; the child paints its pattern
// across the whole carve and exits, the process service reads the
// words back through the kernel's half — `screen 0x86c00000 ok` on the
// wire — and the parent's wait is answered after the line. The carve
// was handed once: the second screen spawn is the resource refusal
// (the reason number on the wire, `screen r5`), the pass that would
// have claimed it never runs, and the token is cleared by the hand
// that poked it.
poke64(screen_cell, 1)
var screen_spawned = syscall.spawn()
case screen_spawned {
  (R.error, _) -> { mark() }
  (R.ok, spid) -> {
    var screen_waited = syscall.wait(spid)
    case screen_waited {
      (R.error, _) -> { mark() }
      (R.ok, _) -> {}
    }
  }
}
poke64(screen_cell, 1)
var screen_again = syscall.spawn()
case screen_again {
  (R.error, why) -> {
    poke64(screen_cell, 0)
    var scp = byte_at(0, 115) // s
    scp = byte_at(scp, 99) // c
    scp = byte_at(scp, 114) // r
    scp = byte_at(scp, 101) // e
    scp = byte_at(scp, 101) // e
    scp = byte_at(scp, 110) // n
    scp = byte_at(scp, 32) // space
    scp = byte_at(scp, 114) // r
    scp = num_at(reason_num(why), scp)
    scp = byte_at(scp, 10)
    gate_line(scp)
  }
  (R.ok, _) -> { mark() }
}

// The input merge's proof (T8.3): the machine's keyboard beyond the
// serial. The pass above claims the token and parks on the merged
// stream — the run's hands answer it (the monitor's sendkey, then the
// serial's byte on the same stream) and its exit answers the parent's
// wait.
poke64(key_cell, 1)
var key_spawned = syscall.spawn()
case key_spawned {
  (R.error, _) -> { mark() }
  (R.ok, kpid) -> {
    var key_waited = syscall.wait(kpid)
    case key_waited {
      (R.error, _) -> { mark() }
      (R.ok, _) -> {}
    }
  }
}

// The window buffer's proof (T8.5): the pass above — the run handed,
// the mapping painted and read back, the commit recorded, the release
// home — the buffer's lifecycle whole, and its exit answering the
// parent's wait.
poke64(win_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}

// The client's kill and rebirth (emo-desktop A9.2): the entry parks on
// the console read first — the era gate, the byte itself nothing — and
// the run's hand opens it only when the previous era's display beat is
// done. Then the first client presents its surface and dies without
// closing — the death notice drops the surface and the run — and the
// entry parks again until the hand says the reclaim landed. Then the
// rebirth: a fresh pass, a fresh grant, a different place and pattern,
// closed cleanly, its exit answering the wait.
var cgate = syscall.read()
poke64(client_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, _) -> {}
}
var cwalk = syscall.read()
poke64(client2_cell, 1)
case syscall.spawn() {
  (R.error, _) -> { mark() }
  (R.ok, c2pid) -> {
    var c2wait = syscall.wait(c2pid)
    case c2wait {
      (R.error, _) -> { mark() }
      (R.ok, code) -> {
        if code == 0 {
          var bp = byte_at(0, 99) // c
          bp = byte_at(bp, 108) // l
          bp = byte_at(bp, 105) // i
          bp = byte_at(bp, 101) // e
          bp = byte_at(bp, 110) // n
          bp = byte_at(bp, 116) // t
          bp = byte_at(bp, 32) // space
          bp = byte_at(bp, 98) // b
          bp = byte_at(bp, 97) // a
          bp = byte_at(bp, 99) // c
          bp = byte_at(bp, 107) // k
          bp = byte_at(bp, 10)
          gate_line(bp)
        } else {
          mark()
        }
      }
    }
  }
}

var cgate3 = syscall.read() // the third era gate: the run's hand has
                            //   parked the pointer and read the client's
                            //   display beat — only then does the desk era
                            //   begin, so its start park takes the queued
                            //   pointer event, never an early wake

// The window shell (emo-desktop A9.1): the pass above — two toplevel
// windows up, the run's hands focusing, dragging and keying them until
// the quit byte — and its exit answering the parent's wait (`desk 0`).
poke64(desk_cell, 1)
var desk_spawned = syscall.spawn()
case desk_spawned {
  (R.error, _) -> { mark() }
  (R.ok, dpid) -> {
    var desk_waited = syscall.wait(dpid)
    case desk_waited {
      (R.error, _) -> { mark() }
      (R.ok, code) -> {
        var dp = desk_at()
        dp = num_at(code, dp)
        dp = byte_at(dp, 10)
        gate_line(dp)
      }
    }
  }
}

// The desktop (emo-desktop A12.1, EmoOS T8.19): the shell becomes the
// machine's desktop. The desk pass has handed the display over and
// its exit answered: the top level takes the foreground for its life,
// the launcher's dock its panel and the merged stream its ear — no
// wait verb anywhere, the exits riding the stream to their parent
// now, a launch and a death the same loop's ordinary events. A press
// on the strip names a tile and the tile launches its app (the exec
// verb, the disk ELF); a byte names the REPL line and the line names
// its command (the shell's own assembly, `feed` — the serial's bytes
// ride the stream as 0x454D events, and the focus is the gate they
// pass: the desktop hears them when the dock holds the focus, an
// application when its window does, the missing echo the tell). The
// dock knows residency, not focus — no wire tells the shell a focus
// moved, so no tile wears the focused steel; the running dot is the
// launcher's one visible fact. The machine ends as the proof's exit
// did: the poweroff command is the boot pass's exit verb.

// The exits' type, the stream's own marker family: 0x4558 ("EX"),
// beside the serial bytes' 0x454D ("EM") — the small types the
// keyboards and tablets carry can never name it. The code field is
// the child's pid, the value the exit code.
const ev_exit = 0x4558

// The launcher's scratch (emo-desktop A12.1): the three app slots
// above the shell's texts, buf-offsets — the file names the exec verb
// loads poked once at the era's start (twelve bytes a row), one pid
// word a slot beside them. A slot's pid is the live process's, zero
// the not-resident's; the dot, the refusal and the exit line all read
// it.
const desk_names = 9216
const desk_pids = 9264

def desk_flen(slot Int64) Int64 {
  if slot == 1 {
    return 9
  }
  if slot == 2 {
    return 10
  }
  return 11
}

// The bare name the lines print: the file's own with the `.elf` off.
def desk_nlen(slot Int64) Int64 {
  return desk_flen(slot) - 4
}

// `desktop <name>` at the scratch's head, the cursor back — the three
// desktop lines' shared prefix, the name the slot's row holds (the
// bare name) or the line's own bytes (the exec command's argument).
def desk_line_name(name Int64, nlen Int64) Int64 {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 32)
  var i = 0
  while i < nlen {
    p = byte_at(p, peek8(name + i).to_int64())
    i = i + 1
  }
  return p
}

def desk_up_line(name Int64, nlen Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 117) // u
  p = byte_at(p, 112) // p
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_running_line(name Int64, nlen Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 114) // r
  p = byte_at(p, 117) // u
  p = byte_at(p, 110) // n
  p = byte_at(p, 110) // n
  p = byte_at(p, 105) // i
  p = byte_at(p, 110) // n
  p = byte_at(p, 103) // g
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_exit_line(name Int64, nlen Int64, code Int64) Void {
  var p = desk_line_name(name, nlen)
  p = byte_at(p, 32)
  p = byte_at(p, 101) // e
  p = byte_at(p, 120) // x
  p = byte_at(p, 105) // i
  p = byte_at(p, 116) // t
  p = byte_at(p, 32)
  p = num_at(code, p)
  p = byte_at(p, 10)
  gate_line(p)
}

def desk_running_mask() Int64 {
  var m = 0
  if peek64(buf + desk_pids) != 0 {
    m = m | 1
  }
  if peek64(buf + desk_pids + 8) != 0 {
    m = m | 2
  }
  if peek64(buf + desk_pids + 16) != 0 {
    m = m | 4
  }
  return m
}

// The typed name against the slots' file rows — the exec command's
// argument naming a slot the tile's press names too.
def desk_slot_of(name Int64, nlen Int64) Int64 {
  var slot = 0
  while slot < 3 {
    if nlen == desk_flen(slot) {
      var row = buf + desk_names + (slot * 12)
      var same = true
      var i = 0
      while i < nlen {
        if peek8(name + i).to_int64() != peek8(row + i).to_int64() {
          same = false
        }
        i = i + 1
      }
      if same {
        return slot
      }
    }
    slot = slot + 1
  }
  return -1
}

const desk_wall_grant = 16064 // the wallpaper's grant and base — the
const desk_wall_base = 16072 // surfaces rebuilt from these at a repaint
const desk_bar_grant = 16080 // the header panel's grant and base
const desk_bar_base = 16088
const desk_mode_cell = 16096 // the display's mode packed, w above h
const desk_dock_grant = 16104 // the dock panel's grant and base
const desk_dock_base = 16112

// The notification center's cells (emo-desktop M25, A25.2), in the
// same scratch page: the take's reply (the packed head and the two
// lengths, 280 bytes at the service's bounds), the two surfaces' grant
// and base — 0 the seat empty, a toplevel and no surface the moment
// they show — and the id the card was last painted for, the repaint's
// change detector.
const notify_reply = 16384
const notify_head = 24
const notify_take_max = 280
const notify_toast_grant = 16704
const notify_toast_base = 16712
const notify_panel_grant = 16720
const notify_panel_base = 16728
const notify_painted = 16736

// The launcher's dock, repainted whole: the tiles with their dots.
def desk_dock(f ui_fb.raster.Strike, labels Array[String]) Void {
  const mode = peek64(buf + desk_mode_cell)
  desk_strip_paint(f, peek64(buf + desk_dock_base),
    peek64(buf + desk_dock_grant),
    mode >> 32, mode & 4294967295, labels, -1, desk_running_mask())
}

// The launcher's one launch (emo-desktop A12.1; the live tile's open
// A16.3): the slot's exec by its own row — the pid lands in the slot,
// the dock repaints with the tile's dot lit, `desktop <name> up` on
// the wire. A live slot's tile is the app's own open now: the window
// raised to the top and named the focused one, the minimized one
// unhidden — the desktop's verb, the panel its authority. A pid whose
// window is not on the stack yet (the exec still loading) is the
// running line the tiles have always answered (`desktop <name>
// running` — the tiles name apps, not instances), and an exec the
// machine refuses speaks the stub's message, `desktop: <the reason>`.
def desk_launch(f ui_fb.raster.Strike, slot Int64, labels Array[String]) Void {
  var name = buf + desk_names + (slot * 12)
  if peek64(buf + desk_pids + (slot * 8)) != 0 {
    case syscall.win_desk_open(peek64(buf + desk_pids + (slot * 8))) {
      (R.error, _) -> { desk_running_line(name, desk_nlen(slot)) }
      (R.ok, _) -> {}
    }
  } else {
    case syscall.exec(name, desk_flen(slot)) {
      (R.error, why) -> { shell.desk_err(why) }
      (R.ok, child) -> {
        poke64(buf + desk_pids + (slot * 8), child)
        desk_up_line(name, desk_nlen(slot))
        desk_dock(f, labels)
        desk_chrome(f)
      }
    }
  }
}

// The exec command's half (emo-desktop A12.1): the line's name, the
// launcher's bookkeeping when it names one of the slots' own — the
// same dot a tile press lights — and the volume's own when it does
// not (the exec answers; a foreign image's success is silent, the
// Unix convention the file commands keep).
def desk_exec_cmd(f ui_fb.raster.Strike, e Int64, n Int64, labels Array[String]) Void {
  var ns = shell.skip_spaces(e, n)
  var ne = shell.word_end(ns, n)
  if ns == n || shell.skip_spaces(ne, n) < n {
    shell.exec_badarg()
  } else {
    var name = shell.line_ptr() + ns
    var nlen = ne - ns
    var slot = desk_slot_of(name, nlen)
    if slot >= 0 && peek64(buf + desk_pids + (slot * 8)) != 0 {
      desk_running_line(buf + desk_names + (slot * 12), desk_nlen(slot))
    } else {
      case syscall.exec(name, nlen) {
        (R.error, why) -> { shell.desk_err(why) }
        (R.ok, child) -> {
          if slot >= 0 {
            poke64(buf + desk_pids + (slot * 8), child)
            desk_up_line(buf + desk_names + (slot * 12), desk_nlen(slot))
            desk_dock(f, labels)
            desk_chrome(f)
          }
        }
      }
    }
  }
}

// ---- the desktop's icons (emo-desktop A13) ----
//
// The volume's own files as the desktop shows them: a flat file a
// document, a name's `/` prefix the folder that prefix names, the
// `.elf` apps never on the desktop — the dock's tiles name apps, the
// desktop's icons name the volume's papers and folders, the way macOS
// keeps them apart. The listing is the fs's answer; the view is its
// parse; the selection and the current folder are the two words of
// state a press moves. All of it scratch cells and typed loops — the
// view is rebuilt whole on every change (a boot, a command that
// touches the volume, a folder entered or left), and a rebuild is a
// few hundred bytes of pokes, not a tree.
//
//   entry: the name's bytes [0..24), its length at +24, its kind at +32
//     — 0 a document, 1 a folder, 2 the `..` way up. 40 bytes, and the
//     fs's own 64-entry table the bound the view never outgrows.
const desk_list = 9344 // the listing's bytes, the fs's newline form
const desk_list_len = 11392 // the bytes the answer wrote
const desk_list_fold = 11400 // the listing's fold, the change detector
const desk_view = 11408 // the view's entries
const desk_view_count = 13968
const desk_folder = 13976 // the current folder's prefix bytes
const desk_folder_len = 14000
const desk_sel = 14008 // the selected entry, -1 none
const desk_tmp = 14016 // the re-list's scratch, the fold's input
// Whether a name is an app's: the `.elf` the dock's slots carry, off
// the desktop.
def desk_is_elf(namep Int64, nlen Int64) Bool {
  if nlen < 4 {
    return false
  }
  return peek8(namep + nlen - 4) == 46B && peek8(namep + nlen - 3) == 101B && peek8(namep + nlen - 2) == 108B && peek8(namep + nlen - 1) == 102B
}

// One view entry written from a name's bytes; the next index back.
def desk_view_put(idx Int64, namep Int64, nlen Int64, kind Int64) Int64 {
  const e = buf + desk_view + (idx * 40)
  var i = 0
  while i < nlen {
    poke8(e + i, peek8(namep + i))
    i = i + 1
  }
  poke64(e + 24, nlen)
  poke64(e + 32, kind)
  return idx + 1
}

// Whether the view grown so far already shows that folder: two folders
// of one prefix are one icon, the dedupe the parse's own.
def desk_view_has(count Int64, namep Int64, nlen Int64) Bool {
  var i = 0
  while i < count {
    const e = buf + desk_view + (i * 40)
    if peek64(e + 24) == nlen && peek64(e + 32) == 1 {
      var same = true
      var k = 0
      while k < nlen {
        if peek8(e + k) != peek8(namep + k) {
          same = false
          k = nlen
        } else {
          k = k + 1
        }
      }
      if same {
        return true
      }
    }
    i = i + 1
  }
  return false
}

// The listing through the view's grammar, whole from scratch. At the
// root: a flat name a document, a prefixed name its folder once, the
// `.elf` rows skipped. Inside a folder F: the `..` way up first, then
// each name under F — the rest after `F/` a document of its own, or
// the subfolder its own prefix names, deduped the same way. A folder
// and a flat file of one spelling are both shown: they are two
// entries of the volume, and the view hides nothing.
def desk_view_build() Void {
  var count = 0
  const flen = peek64(buf + desk_list_len)
  const folder_len = peek64(buf + desk_folder_len)
  if folder_len > 0 {
    const e = buf + desk_view
    poke8(e, 46B)
    poke8(e + 1, 46B)
    poke64(e + 24, 2)
    poke64(e + 32, 2)
    count = 1
  }
  var pos = 0
  while pos < flen {
    var n = pos
    while n < flen && peek8(buf + desk_list + n) != 10B {
      n = n + 1
    }
    const nlen = n - pos
    const namep = buf + desk_list + pos
    if !desk_is_elf(namep, nlen) {
      // the first slash, or -1: the name's folder membership
      var slash = -1
      var k = 0
      while k < nlen {
        if peek8(namep + k) == 47B {
          slash = k
          k = nlen
        } else {
          k = k + 1
        }
      }
      if folder_len == 0 {
        if slash < 0 {
          count = desk_view_put(count, namep, nlen, 0)
        } else {
          if !desk_view_has(count, namep, slash) {
            count = desk_view_put(count, namep, slash, 1)
          }
        }
      } else {
        // under F: the name is F's own bytes, the slash, the child
        var under = true
        var k2 = 0
        while k2 < folder_len {
          if peek8(namep + k2) != peek8(buf + desk_folder + k2) {
            under = false
            k2 = folder_len
          } else {
            k2 = k2 + 1
          }
        }
        if under && slash == folder_len && nlen > folder_len + 1 {
          const restp = namep + folder_len + 1
          const rest = nlen - folder_len - 1
          var sub = -1
          var k3 = 0
          while k3 < rest {
            if peek8(restp + k3) == 47B {
              sub = k3
              k3 = rest
            } else {
              k3 = k3 + 1
            }
          }
          if sub < 0 {
            count = desk_view_put(count, restp, rest, 0)
          } else {
            if !desk_view_has(count, restp, sub) {
              count = desk_view_put(count, restp, sub, 1)
            }
          }
        }
      }
    }
    pos = n + 1
  }
  poke64(buf + desk_view_count, count)
  // a selection past the view is no selection
  if peek64(buf + desk_sel) >= count {
    poke64(buf + desk_sel, -1)
  }
}

// The listing taken and its fold kept — the boot's one load, the
// refresh's comparison the command loop's.
def desk_list_load() Void {
  case syscall.file_list(buf + desk_list, 2048) {
    (R.error, _) -> { mark() }
    (R.ok, n) -> {
      poke64(buf + desk_list_len, n)
      var d = 0
      var i = 0
      while i < n {
        d = (d * 31 + peek8(buf + desk_list + i).to_int64()) & 4294967295
        i = i + 1
      }
      poke64(buf + desk_list_fold, d)
    }
  }
}

// ---- the metal's own painting (emo-desktop A13) ----
//
// The wallpaper and its icons are painted straight onto the buffer's
// bytes through the typed stores — the carve's own rule, and the
// round's find: the `Surface`'s methods are class bodies, and a class
// body boxes every word it computes into the arena for good (the pool
// reclaims the identities, the boxing never comes back — "left in the
// arena per repaint" is the dock's own comment). The first icon press
// died the second repaint: one surface-path repaint weighed as much as
// the boot had left. These defs are typed top-level ones, so a repaint
// costs no arena at all and the desktop repaints for a living. The
// shapes are the package's words (`emo_desktop.wall_top` and kin — the
// hosted canvas paints the same formula), so the golden's digest and
// the screendump's bytes are one design.

// One clipped span packed x above w — the ribbon row's store span, the
// clip the package's `blend` gets from `ui_fb.clip` and the raw stores
// must do themselves (a negative x would walk the store off the row).
def desk_span_clip(x Int64, w Int64, mw Int64) Int64 {
  var x0 = x
  var w0 = w
  if x0 < 0 {
    w0 = w0 + x0
    x0 = 0
  }
  if x0 + w0 > mw {
    w0 = mw - x0
  }
  if w0 < 0 {
    w0 = 0
  }
  return (x0 << 32) | w0
}

// One ribbon row blended: the span the clip packed, one pixel tall.
def desk_ribbon_row(base Int64, mw Int64, y Int64, x Int64, w Int64, ink_color Int64) Void {
  const span = desk_span_clip(x, w, mw)
  const x0 = span >> 32
  const w0 = span & 4294967295
  if w0 > 0 {
    carve_blend(base, mw, x0, y, w0, 1, ink_color)
  }
}

// The wallpaper's art, whole: the gradient row by row (each channel a
// positive-weight lerp between the package's two anchors), then the
// three ribbons over it — the same slopes and inks the package's
// `wallpaper` lays on the hosted canvas, mirrored here because the
// call that paints must be the call that stays typed.
def desk_wallpaper_paint(base Int64, mw Int64, mh Int64) Void {
  const denom = mh - 1
  const tr = (emo_desktop.wall_top() >> 16) & 255
  const tg = (emo_desktop.wall_top() >> 8) & 255
  const tb = emo_desktop.wall_top() & 255
  const br = (emo_desktop.wall_bottom() >> 16) & 255
  const bg = (emo_desktop.wall_bottom() >> 8) & 255
  const bb = emo_desktop.wall_bottom() & 255
  var y = 0
  while y < mh {
    const r = (tr * (denom - y) + br * y) / denom
    const g = (tg * (denom - y) + bg * y) / denom
    const b = (tb * (denom - y) + bb * y) / denom
    carve_fill(base, mw, 0, y, mw, 1, (r << 16) | (g << 8) | b)
    y = y + 1
  }
  var t = 0
  while t < (5 * mh) / 8 {
    desk_ribbon_row(base, mw, t, -((25 * mw) / 128) + (3 * t) / 4,
      (115 * mw) / 256, 0x2830B8C8)
    t = t + 1
  }
  var u = (5 * mh) / 24
  while u < (15 * mh) / 16 {
    desk_ribbon_row(base, mw, u, (15 * mw) / 256 + u / 2, (25 * mw) / 64,
      0x20E86890)
    u = u + 1
  }
  var v = (85 * mh) / 192
  while v < mh {
    desk_ribbon_row(base, mw, v, (225 * mw) / 256 - v / 4, (135 * mw) / 256,
      0x188868E8)
    v = v + 1
  }
}

// One row of the chrome's material at the display row `gy`, painted at
// the buffer's local `ly`: the wallpaper's gradient row, every ribbon
// whose span holds the row over it, the scrim over the whole — the
// package's `material_row` mirrored (D8: the chrome samples the
// wallpaper's formula, it never reads the pixels behind it), the call
// that paints the call that stays typed.
def desk_chrome_row(base Int64, mw Int64, ly Int64, gy Int64, mh Int64, scrim Int64) Void {
  const denom = mh - 1
  const tr = (emo_desktop.wall_top() >> 16) & 255
  const tg = (emo_desktop.wall_top() >> 8) & 255
  const tb = emo_desktop.wall_top() & 255
  const br = (emo_desktop.wall_bottom() >> 16) & 255
  const bg = (emo_desktop.wall_bottom() >> 8) & 255
  const bb = emo_desktop.wall_bottom() & 255
  const r = (tr * (denom - gy) + br * gy) / denom
  const g = (tg * (denom - gy) + bg * gy) / denom
  const b = (tb * (denom - gy) + bb * gy) / denom
  carve_fill(base, mw, 0, ly, mw, 1, (r << 16) | (g << 8) | b)
  if gy < (5 * mh) / 8 {
    desk_ribbon_row(base, mw, ly, -((25 * mw) / 128) + (3 * gy) / 4,
      (115 * mw) / 256, 0x2830B8C8)
  }
  if gy >= (5 * mh) / 24 && gy < (15 * mh) / 16 {
    desk_ribbon_row(base, mw, ly, (15 * mw) / 256 + gy / 2, (25 * mw) / 64,
      0x20E86890)
  }
  if gy >= (85 * mh) / 192 {
    desk_ribbon_row(base, mw, ly, (225 * mw) / 256 - gy / 4, (135 * mw) / 256,
      0x188868E8)
  }
  carve_blend(base, mw, 0, ly, mw, 1, scrim)
}

// A label's glyphs along one line from `(x, y)`, the line box's
// top-left — the package's `text` walk through the carve's typed ink,
// one call a glyph, no interface between.
def desk_text(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, label String, x Int64, y Int64, ink_color Int64) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  var pen = x
  var i = 0
  while i < label.length() {
    const g = f.glyph_of(label.substring(i, 1))
    ui_fb_winbuf.carve_ink(base, dims, pen, y, f, g, ink_color)
    pen = pen + f.advance(g)
    i = i + 1
  }
}

// `<n> apps` ending one pad short of `right` — the package's
// `count_text` mirrored, the digits' advances summed before they are
// drawn.
def desk_count_text(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, right Int64, y Int64, n Int64, ink_color Int64) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  var div = 1
  while n / div >= 10 {
    div = div * 10
  }
  var digits_w = 0
  var d = div
  while d > 0 {
    digits_w = digits_w + f.advance(17 + ((n / d) % 10))
    d = d / 10
  }
  var p = right - digits_w - ui_fb.text_width(f, " apps")
  while div > 0 {
    ui_fb_winbuf.carve_ink(base, dims, p, y, f, 17 + ((n / div) % 10), ink_color)
    p = p + f.advance(17 + ((n / div) % 10))
    div = div / 10
  }
  desk_text(f, base, mw, mh, " apps", p, y, ink_color)
}

// The header bar whole: the material's rows, the wordmark one pad in,
// the running count at the right edge — the package's `paint_header`
// mirrored, every call the carve's own.
def desk_bar_paint(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, running Int64) Void {
  var y = 0
  while y < emo_desktop.header_height() {
    desk_chrome_row(base, mw, y, y, mh, emo_desktop.header_scrim())
    y = y + 1
  }
  const ty = (emo_desktop.header_height() - f.line_height()) / 2
  desk_text(f, base, mw, emo_desktop.header_height(), "EmoOS", 8, ty, emo_desktop.header_accent())
  desk_count_text(f, base, mw, emo_desktop.header_height(), mw - emo_desktop.icon_margin(), ty, running, emo_desktop.header_ink())
}

// The dock's strip whole: the material's rows, the shelf's shadow and
// the shelf over it, then one drawn icon per app — the rounded square
// graded, the initial centered in it, the running dot at its foot —
// the package's `paint` mirrored. `top` is the display row the strip's
// first row stands on; the material samples the formula there.
def desk_dock_paint(f ui_fb.raster.Strike, base Int64, mw Int64, top Int64, labels Array[String], focused Int64, running Int64) Void {
  const sh = emo_desktop.strip_height()
  const dims = ui_fb_winbuf.pack(mw, sh)
  var ly = 0
  while ly < sh {
    desk_chrome_row(base, mw, ly, top + ly, top + sh, emo_desktop.dock_scrim())
    ly = ly + 1
  }
  const sx = emo_desktop.shelf_pad()
  const sy = emo_desktop.shelf_top_pad()
  const sw = mw - emo_desktop.shelf_pad() * 2
  const shh = emo_desktop.shelf_height()
  ui_fb_winbuf.carve_shadow(base, dims, ui_fb_winbuf.pack(sx, sy),
    ui_fb_winbuf.pack(sw, shh), emo_desktop.shelf_radius(),
    emo_desktop.shelf_soft(), 0x80000000)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(sx, sy),
    ui_fb_winbuf.pack(sw, shh), emo_desktop.shelf_radius(),
    emo_desktop.shelf_top(), emo_desktop.shelf_bottom())
  var i = 0
  while i < labels.length() {
    const tx = emo_desktop.tile_x(i)
    const ty = emo_desktop.tile_y()
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(tx, ty),
      ui_fb_winbuf.pack(emo_desktop.tile_size(), emo_desktop.tile_size()), 8,
      emo_desktop.tile_top(i == focused), emo_desktop.tile_bottom(i == focused))
    const g = f.glyph_of(labels[i].substring(0, 1))
    ui_fb_winbuf.carve_ink(base, dims, tx + (emo_desktop.tile_size() - ui_fb.text_width(f, labels[i])) / 2,
      ty + (emo_desktop.tile_size() - f.line_height()) / 2, f, g,
      emo_desktop.ink())
    if (running >> i) & 1 == 1 {
      ui_fb_winbuf.carve_fill(base, mw, tx + 14, ty + 26, 4, 4, emo_desktop.ink())
    }
    i = i + 1
  }
}

// A dock strip repainted whole — the paint, the frame's digest line,
// the present — the shape the launcher's dock repaints through and the
// desk pass's with it; the buffer's own grant and base the caller
// names.
def desk_strip_paint(f ui_fb.raster.Strike, base Int64, grant Int64, mw Int64, mh Int64, labels Array[String], focused Int64, running Int64) Void {
  desk_dock_paint(f, base, mw, mh - emo_desktop.strip_height(), labels, focused, running)
  frame_line(carve_digest(base, mw, emo_desktop.strip_height()))
  case syscall.present(grant, 0, 0, mw, emo_desktop.strip_height()) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// The name's byte under the box: the type's glyph of that byte's own
// arithmetic, the missing glyph past the printable span — the package's
// `text_byte` rule, through the carve's typed walk — and the advance the
// next byte's pen moves by.
def desk_name_byte(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64, x Int64, y Int64, b Int64) Int64 {
  var i = b - 31
  if i < 1 || i > 95 {
    i = 0
  }
  ui_fb_winbuf.carve_ink(base, ui_fb_winbuf.pack(mw, mh), x, y, f, i, 0xF8F8F0)
  return f.advance(i)
}

// A document icon at its cell: the selection's rounded blend first,
// then the page a graded rounded square with its folded corner and
// three text lines over it — the package's `paint_icon_doc` shapes,
// at the cell origin the package's `icon_cell` packed.
def desk_icon_doc(base Int64, mw Int64, mh Int64, cx Int64, cy Int64, selected Bool) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  if selected {
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(cx + 2, cy + 1),
      ui_fb_winbuf.pack(92, 74), 10, emo_desktop.select_ink(),
      emo_desktop.select_ink())
  }
  const ix = cx + emo_desktop.icon_off_x()
  const iy = cy + emo_desktop.icon_off_y()
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 8, iy + 2),
    ui_fb_winbuf.pack(28, 40), 4, 0xFFF2F2F8, 0xFFD8DAE4)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 28, iy + 2),
    ui_fb_winbuf.pack(8, 8), 2, 0xFFC2C8D4, 0xFFC2C8D4)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 16),
    ui_fb_winbuf.pack(16, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 24),
    ui_fb_winbuf.pack(16, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 14, iy + 32),
    ui_fb_winbuf.pack(10, 3), 1, 0xFF98A0B0, 0xFF98A0B0)
}

// A folder icon at its cell: the tab and the body in the folder blue,
// the body graded from its light along the top to its shade at the
// foot — the package's `paint_icon_folder` shapes.
def desk_icon_folder(base Int64, mw Int64, mh Int64, cx Int64, cy Int64, selected Bool) Void {
  const dims = ui_fb_winbuf.pack(mw, mh)
  if selected {
    ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(cx + 2, cy + 1),
      ui_fb_winbuf.pack(92, 74), 10, emo_desktop.select_ink(),
      emo_desktop.select_ink())
  }
  const ix = cx + emo_desktop.icon_off_x()
  const iy = cy + emo_desktop.icon_off_y()
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 6, iy + 8),
    ui_fb_winbuf.pack(16, 9), 3, 0xFF4098E0, 0xFF4098E0)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(ix + 4, iy + 13),
    ui_fb_winbuf.pack(36, 25), 4, 0xFF5FA8E8, 0xFF327FC2)
}

// The view's icons over the wallpaper: a document or a folder per
// entry, the selection's blend behind the one selected, the name's
// bytes under the box — ten cells of it shown (a display name's cut;
// the volume's own spelling is what the commands read).
def desk_icons_paint(f ui_fb.raster.Strike, base Int64, mw Int64, mh Int64) Void {
  const count = peek64(buf + desk_view_count)
  const sel = peek64(buf + desk_sel)
  var i = 0
  while i < count {
    const cell = emo_desktop.icon_cell(i, mw, mh)
    const cx = cell >> 32
    const cy = cell & 4294967295
    const e = buf + desk_view + (i * 40)
    const kind = peek64(e + 32)
    if kind == 0 {
      desk_icon_doc(base, mw, mh, cx, cy, i == sel)
    } else {
      desk_icon_folder(base, mw, mh, cx, cy, i == sel)
    }
    var shown = peek64(e + 24)
    if shown > 10 {
      shown = 10
    }
    var k = 0
    var pen = cx + 8
    while k < shown {
      pen = pen + desk_name_byte(f, base, mw, mh, pen, cy + 56, peek8(e + k).to_int64())
      k = k + 1
    }
    i = i + 1
  }
}

// The wallpaper whole, repainted: the art, the icons, the digest's
// frame line, the present — the surface nothing but its grant and its
// bytes, no class, no interface, no arena spent.
def desk_wall_repaint(f ui_fb.raster.Strike) Void {
  const base = peek64(buf + desk_wall_base)
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const mh = mode & 4294967295
  desk_wallpaper_paint(base, mw, mh)
  desk_icons_paint(f, base, mw, mh)
  frame_line(carve_digest(base, mw, mh))
  case syscall.present(peek64(buf + desk_wall_grant), 0, 0, mw, mh) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// The header bar repainted: the running count is its one live fact,
// and a launch or a death is the news it carries.
def desk_chrome(f ui_fb.raster.Strike) Void {
  const mode = peek64(buf + desk_mode_cell)
  const mw = mode >> 32
  const mh = mode & 4294967295
  const m = desk_running_mask()
  var running = 0
  if (m & 1) == 1 {
    running = running + 1
  }
  if (m & 2) == 2 {
    running = running + 1
  }
  if (m & 4) == 4 {
    running = running + 1
  }
  const base = peek64(buf + desk_bar_base)
  desk_bar_paint(f, base, mw, mh, running)
  notify_bell_paint(f, base, mw)
  frame_line(carve_digest(base, mw, emo_desktop.header_height()))
  case syscall.present(peek64(buf + desk_bar_grant), 0, 0, mw, emo_desktop.header_height()) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// A press on the desktop's own ground: an icon's cell, or the bare
// wallpaper. A document the selection moves (and the repaint only when
// it moved); a folder the door into its prefix; the `..` the way up —
// the prefix's last part struck. A bare press clears the selection,
// the way a click on bare desktop does; nothing to clear, nothing to
// repaint.
def desk_icon_press(f ui_fb.raster.Strike, hit Int64) Void {
  if hit < 0 {
    if peek64(buf + desk_sel) != -1 {
      poke64(buf + desk_sel, -1)
      desk_wall_repaint(f)
    }
  } else {
    const e = buf + desk_view + (hit * 40)
    const kind = peek64(e + 32)
    if kind == 0 {
      if peek64(buf + desk_sel) != hit {
        poke64(buf + desk_sel, hit)
        desk_wall_repaint(f)
      }
    } else {
      // the folder's door, both ways
      const nlen = peek64(e + 24)
      const flen = peek64(buf + desk_folder_len)
      if kind == 1 {
        // in: the view's name appended to the current prefix, `/`
        // between — the separator's slot only when a prefix is there
        // to separate (the root's child starts at the buffer's head)
        var at = flen
        if flen > 0 {
          poke8(buf + desk_folder + flen, 47B)
          at = flen + 1
        }
        var i = 0
        while i < nlen {
          poke8(buf + desk_folder + at + i, peek8(e + i))
          i = i + 1
        }
        poke64(buf + desk_folder_len, at + nlen)
      } else {
        // up: the prefix's last part struck, the root when none is left
        if flen > 0 {
          var last = -1
          var k = 0
          while k < flen {
            if peek8(buf + desk_folder + k) == 47B {
              last = k
            }
            k = k + 1
          }
          if last < 0 {
            poke64(buf + desk_folder_len, 0)
          } else {
            poke64(buf + desk_folder_len, last)
          }
        }
      }
      poke64(buf + desk_sel, -1)
      desk_view_build()
      desk_wall_repaint(f)
    }
  }
}

// The volume may have changed under a command (`write`, `rm`): the
// re-list's fold is the change detector, the copy, the rebuild and the
// repaint the answer. An unchanged fold is the common case, and it
// costs one list and one fold — no present, no frame.
def desk_icons_refresh(f ui_fb.raster.Strike) Void {
  case syscall.file_list(buf + desk_tmp, 2048) {
    (R.error, _) -> { mark() }
    (R.ok, n) -> {
      var d = 0
      var i = 0
      while i < n {
        d = (d * 31 + peek8(buf + desk_tmp + i).to_int64()) & 4294967295
        i = i + 1
      }
      if d != peek64(buf + desk_list_fold) {
        var j = 0
        while j < n {
          poke8(buf + desk_list + j, peek8(buf + desk_tmp + j))
          j = j + 1
        }
        poke64(buf + desk_list_len, n)
        poke64(buf + desk_list_fold, d)
        desk_view_build()
        desk_wall_repaint(f)
      }
    }
  }
}

// `desktop icons <n>` — the wallpaper's first present's annotation,
// the count the view grew.
def desk_icons_line() Void {
  var p = byte_at(0, 100) // d
  p = byte_at(p, 101) // e
  p = byte_at(p, 115) // s
  p = byte_at(p, 107) // k
  p = byte_at(p, 116) // t
  p = byte_at(p, 111) // o
  p = byte_at(p, 112) // p
  p = byte_at(p, 32) // space
  p = byte_at(p, 105) // i
  p = byte_at(p, 99) // c
  p = byte_at(p, 111) // o
  p = byte_at(p, 110) // n
  p = byte_at(p, 115) // s
  p = byte_at(p, 32) // space
  p = num_at(peek64(buf + desk_view_count), p)
  p = byte_at(p, 10)
  gate_line(p)
}


// The interface strike, built on demand: the Inter face at 16 pixels —
// the boot copies its words into the desk's scratch, and the surface
// passes that hold one carry it to the verb.
def desk_strike() (R, ui_fb.raster.Strike) {
  return ui_fb.raster.strike(ui_fb.raster.inter(), 16)
}

// ---- the notification center's face (emo-desktop M25, A25.2) ----
//
// The shell is the notification center by construction (D16): the
// metal provider polls the gate's take verb once per wake — the desk
// loop's own turn is the shell's tick, the heartbeat EmoOS's stream
// does not yet carry — and the center's state is the package's. The
// two surfaces are the shell's own toplevels: the card (the toast) and
// the panel (the history), made when they first show and closed when
// they go. The compositor's walk masks a toplevel's corners and lays
// its shadow ring for free, so a surface paints the card's ground and
// words alone.
//
// The stack holds eight surfaces (EmoOS's comp_entries): the shell's
// three, three apps' windows, and these two fill it — a fourth app's
// window is the compositor's resource refusal, the milestone's own
// bound, not this face's.

// One take (D14): the packed head's id and lengths, the title's and
// the body's bytes copied into Strings. The empty answer is `empty`,
// the canonical quiet reply — absence visible, never fabricated (D15).
def notify_take_once() (R, emo_notify.Notif) {
  case syscall.notify_take(buf + notify_reply, notify_take_max) {
    (R.error, why) -> { return (R.error, why) }
    (R.ok, n) -> {
      if n == 0 {
        return (R.error, "empty")
      }
      const id = peek64(buf + notify_reply)
      const tlen = peek64(buf + notify_reply + 8)
      const blen = peek64(buf + notify_reply + 16)
      const title = notify_str(buf + notify_reply + notify_head, tlen)
      const body = notify_str(buf + notify_reply + notify_head + tlen, blen)
      return (R.ok, emo_notify.notif(id, title, body))
    }
  }
}

// The packed bytes as a String: a Bytes of the length, the bytes read
// off the scratch one at a time, the reinterpretation back.
def notify_str(a Int64, n Int64) String {
  const b = Bytes.new(n)
  var i = 0
  while i < n {
    b.set(i, peek8(a + i).to_int64())
    i = i + 1
  }
  return b.to_string()
}

class MetalFeed {
  def take() (R, emo_notify.Notif) {
    return notify_take_once()
  }
}

def metal_feed() MetalFeed {
  return MetalFeed.new()
}

// The card's ground and words, its window whole: the package's card
// (the shelf's recipe) with the alpha the metal's blit cannot use — a
// word copy, so the card is opaque here — the accent bar, the title
// and the body.
def notify_card_paint(f ui_fb.raster.Strike, base Int64, w Int64, h Int64,
                      n emo_notify.Notif) Void {
  const dims = ui_fb_winbuf.pack(w, h)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(0, 0),
    ui_fb_winbuf.pack(w, h), emo_notify.toast_radius(),
    emo_notify.card_top() | 0xFF000000,
    emo_notify.card_bottom() | 0xFF000000)
  ui_fb_winbuf.carve_fill(base, w, 8, 8, 3, h - 16, emo_notify.accent())
  desk_text(f, base, w, h, n.title(), 20, 12, emo_notify.ink())
  desk_text(f, base, w, h, n.body(), 20, 40, emo_notify.ink_dim())
}

// The panel's ground and rows, its window whole: the package's
// `paint_center` in the window's own coordinates — the header line,
// the do-not-disturb row with its state word, then the history newest
// first, one row per entry the height holds.
def notify_panel_paint(f ui_fb.raster.Strike, base Int64, w Int64, h Int64,
                       c emo_notify.Center) Void {
  const dims = ui_fb_winbuf.pack(w, h)
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(0, 0),
    ui_fb_winbuf.pack(w, h), emo_notify.panel_radius(),
    emo_notify.card_top() | 0xFF000000,
    emo_notify.card_bottom() | 0xFF000000)
  desk_text(f, base, w, h, "Notifications", 16, 12, emo_notify.ink())
  ui_fb_winbuf.carve_fill(base, w, 8, emo_notify.dnd_row_y(0) + 4, w - 16,
    emo_notify.dnd_row_h() - 8, 0x2A2E38)
  desk_text(f, base, w, h, "Do not disturb", 16,
    emo_notify.dnd_row_y(0) + 8, emo_notify.ink_dim())
  var st = "off"
  if c.dnd_on() {
    st = "on"
  }
  desk_text(f, base, w, h, st, w - 48, emo_notify.dnd_row_y(0) + 8,
    emo_notify.ink())
  const items = c.entries()
  var i = 0
  var yy = emo_notify.first_entry_y(0)
  while i < items.length() && yy + emo_notify.row_h() <= h {
    const n = items[i]
    desk_text(f, base, w, h, n.title(), 16, yy + 6, emo_notify.ink())
    desk_text(f, base, w, h, n.body(), 16, yy + 30, emo_notify.ink_dim())
    ui_fb_winbuf.carve_fill(base, w, 12, yy + emo_notify.row_h() - 6,
      w - 24, 1, emo_notify.row_line())
    yy = yy + emo_notify.row_h()
    i = i + 1
  }
}

// A shell surface made and placed: a toplevel at (x, y), its grant and
// base into the cells. False is the compositor's refusal (the stack
// full), and nothing is left behind — the ask is the caller's.
def notify_open(grant_cell Int64, base_cell Int64, w Int64, h Int64,
                x Int64, y Int64) Bool {
  var g = 0
  var b = 0
  case syscall.win_new(w, h) {
    (R.error, _) -> { return false }
    (R.ok, ans) -> {
      g = win_id(ans)
      b = win_base(ans)
    }
  }
  case syscall.win_role(g, 0) {
    (R.error, _) -> {
      case syscall.win_close(g) {
        (R.error, _) -> {}
        (R.ok, _) -> {}
      }
      return false
    }
    (R.ok, _) -> {}
  }
  case syscall.win_move(g, x, y) {
    (R.error, _) -> {
      case syscall.win_close(g) {
        (R.error, _) -> {}
        (R.ok, _) -> {}
      }
      return false
    }
    (R.ok, _) -> {}
  }
  poke64(grant_cell, g)
  poke64(base_cell, b)
  return true
}

def notify_close(grant_cell Int64, base_cell Int64) Void {
  case syscall.win_close(peek64(grant_cell)) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  poke64(grant_cell, 0)
  poke64(base_cell, 0)
}

// The shell's own commit: the frame's digest on the wire, then the
// grant's present — the shape every surface of the desk keeps.
def notify_present(grant Int64, base Int64, w Int64, h Int64) Void {
  frame_line(carve_digest(base, w, h))
  case syscall.present(grant, 0, 0, w, h) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
}

// The bell (A25.2's wiring): a 16x16 cell after the wordmark, the
// panel's toggle — outlined while the panel is shut, the accent's
// ground while it is open. The press test and the paint read the one
// arithmetic.
def notify_bell_xy(f ui_fb.raster.Strike) Int64 {
  return ui_fb_winbuf.pack(8 + ui_fb.text_width(f, "EmoOS") + 12,
    (emo_desktop.header_height() - 16) / 2)
}

def notify_bell_paint(f ui_fb.raster.Strike, base Int64, mw Int64) Void {
  const xy = notify_bell_xy(f)
  const x = xy >> 32
  const y = xy & 4294967295
  const dims = ui_fb_winbuf.pack(mw, emo_desktop.header_height())
  var ink_color = emo_notify.ink_dim() | 0xFF000000
  if peek64(buf + notify_panel_grant) != 0 {
    ink_color = emo_notify.accent()
  }
  ui_fb_winbuf.carve_rounded(base, dims, ui_fb_winbuf.pack(x, y),
    ui_fb_winbuf.pack(16, 16), 4, ink_color, ink_color)
}

def notify_bell_hit(f ui_fb.raster.Strike, x Int64, y Int64) Bool {
  const xy = notify_bell_xy(f)
  const bx = xy >> 32
  const by = xy & 4294967295
  return x >= bx && x < bx + 16 && y >= by && y < by + 16
}

// The card's window, when the center has a live notification: made on
// the first show, repainted when the id moves, closed when the seat is
// empty again.
def notify_card_sync(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64) Void {
  if c.live_id() == 0 {
    if peek64(buf + notify_toast_grant) != 0 {
      notify_close(buf + notify_toast_grant, buf + notify_toast_base)
      poke64(buf + notify_painted, 0)
    }
  } else {
    if peek64(buf + notify_toast_grant) == 0 {
      notify_card_make(f, c, mw)
    } else {
      if peek64(buf + notify_painted) != c.live_id() {
        notify_card_paint(f, peek64(buf + notify_toast_base),
          emo_notify.toast_w(), emo_notify.toast_h(), c.live_notif())
        notify_present(peek64(buf + notify_toast_grant),
          peek64(buf + notify_toast_base), emo_notify.toast_w(),
          emo_notify.toast_h())
        poke64(buf + notify_painted, c.live_id())
      }
    }
  }
}

// The card's first show: the surface made at its seat, the words and
// the present — one frame the composition carries whole.
def notify_card_make(f ui_fb.raster.Strike, c emo_notify.Center,
                     mw Int64) Void {
  const tw = emo_notify.toast_w()
  const th = emo_notify.toast_h()
  if notify_open(buf + notify_toast_grant, buf + notify_toast_base, tw, th,
    mw - tw - emo_notify.toast_pad(),
    emo_desktop.header_height() + 8) {
    notify_card_paint(f, peek64(buf + notify_toast_base), tw, th,
      c.live_notif())
    notify_present(peek64(buf + notify_toast_grant),
      peek64(buf + notify_toast_base), tw, th)
    poke64(buf + notify_painted, c.live_id())
  }
}

// The panel's window, painted whole: made on the open, its ground and
// rows the center's state — the history newest first and the DND
// row's word are its news.
def notify_panel_sync(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64,
                      mh Int64) Void {
  const pw = emo_notify.panel_w()
  const top = emo_desktop.header_height()
  const bottom = mh - emo_desktop.strip_height()
  if peek64(buf + notify_panel_grant) == 0 {
    if notify_open(buf + notify_panel_grant, buf + notify_panel_base, pw,
      bottom - top, emo_notify.panel_x(mw), top) {
      notify_panel_paint(f, peek64(buf + notify_panel_base), pw,
        bottom - top, c)
      notify_present(peek64(buf + notify_panel_grant),
        peek64(buf + notify_panel_base), pw, bottom - top)
    }
  } else {
    notify_panel_paint(f, peek64(buf + notify_panel_base), pw, bottom - top, c)
    notify_present(peek64(buf + notify_panel_grant),
      peek64(buf + notify_panel_base), pw, bottom - top)
  }
}

// The bell's press: the door's turn — open makes the panel's window,
// shut closes it, the header's bell repainted to say which.
def notify_panel_toggle(f ui_fb.raster.Strike, c emo_notify.Center, mw Int64,
                        mh Int64) Void {
  c.toggle_open()
  if c.panel_open() {
    notify_panel_sync(f, c, mw, mh)
  } else {
    notify_close(buf + notify_panel_grant, buf + notify_panel_base)
  }
  desk_chrome(f)
}

// The desktop's own body (emo-desktop A12.1): the dock's panel up,
// the slots' names poked, the banner and the prompt — then the loop
// that never returns.
def desktop() Void {
  const fholder = ArrayBuilder.new()
  case desk_strike() {
    (R.error, _) -> { mark() }
    (R.ok, s) -> { fholder.push(s) }
  }
  const f = fholder.get(0)
  shell.sh_init()
  var nb = byte_at(desk_names, 99) // counter.elf
  nb = byte_at(nb, 111)
  nb = byte_at(nb, 117)
  nb = byte_at(nb, 110)
  nb = byte_at(nb, 116)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 114)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  nb = byte_at(desk_names + 12, 102) // files.elf
  nb = byte_at(nb, 105)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 115)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  nb = byte_at(desk_names + 24, 101) // editor.elf
  nb = byte_at(nb, 100)
  nb = byte_at(nb, 105)
  nb = byte_at(nb, 116)
  nb = byte_at(nb, 111)
  nb = byte_at(nb, 114)
  nb = byte_at(nb, 46)
  nb = byte_at(nb, 101)
  nb = byte_at(nb, 108)
  nb = byte_at(nb, 102)
  poke64(buf + desk_pids, 0)
  poke64(buf + desk_pids + 8, 0)
  poke64(buf + desk_pids + 16, 0)
  var mode = 0
  case syscall.output_info(0) {
    (R.error, _) -> { mark() }
    (R.ok, m) -> { mode = m }
  }
  const mw = out_w(mode)
  const mh = out_h(mode)
  const dw = mw
  const dh = emo_desktop.strip_height()
  poke64(buf + desk_mode_cell, (mw << 32) | mh)
  // The desktop's own canvas (emo-desktop A13): the volume's listing
  // taken, the view grown from it — the icons the wallpaper carries —
  // then the wallpaper itself (role 4, the walk's undermost layer) and
  // the header bar (a panel at the top edge) before the dock, so the
  // first composition of every surface already has the desktop whole.
  poke64(buf + desk_folder_len, 0)
  poke64(buf + desk_sel, -1)
  desk_list_load()
  desk_view_build()
  var gw = 0
  var base_w = 0
  case syscall.win_new(mw, mh) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      gw = win_id(ans)
      base_w = win_base(ans)
    }
  }
  case syscall.win_role(gw, 4) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_move(gw, 0, 0) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  poke64(buf + desk_wall_grant, gw)
  poke64(buf + desk_wall_base, base_w)
  desk_wall_repaint(f)
  desk_icons_line()
  var gh = 0
  var base_h = 0
  case syscall.win_new(mw, emo_desktop.header_height()) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      gh = win_id(ans)
      base_h = win_base(ans)
    }
  }
  case syscall.win_role(gh, 3) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_move(gh, 0, 0) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  poke64(buf + desk_bar_grant, gh)
  poke64(buf + desk_bar_base, base_h)
  desk_chrome(f)
  var gd = 0
  var base_d = 0
  case syscall.win_new(dw, dh) {
    (R.error, _) -> { mark() }
    (R.ok, ans) -> {
      gd = win_id(ans)
      base_d = win_base(ans)
    }
  }
  case syscall.win_role(gd, 3) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  case syscall.win_move(gd, 0, mh - dh) {
    (R.error, _) -> { mark() }
    (R.ok, _) -> {}
  }
  poke64(buf + desk_dock_grant, gd)
  poke64(buf + desk_dock_base, base_d)
  const labels = ["c", "f", "e"]
  desk_dock(f, labels)
  shell.banner()
  shell.prompt()
  // The notification center's state (emo-desktop M25): the metal
  // provider's feed and the center, both surfaces' seats empty — the
  // first take claims the center, the service's own first-taker rule.
  const feed = metal_feed()
  const nc = emo_notify.center(feed)
  poke64(buf + notify_toast_grant, 0)
  poke64(buf + notify_panel_grant, 0)
  poke64(buf + notify_painted, 0)
  // The pointer's axes, packed as the display's mode is: the X's
  // maximum above the Y's — the press's position the shell scales
  // itself, the tile the strip's own policy names.
  var range = 0
  case syscall.input_info(0) {
    (R.error, _) -> { mark() }
    (R.ok, r) -> { range = r }
  }
  const max_x = out_w(range)
  const max_y = out_h(range)
  var px = 0
  var py = 0
  while true {
    // The notification poll (emo-desktop M25, A25.2): the residence
    // ages, one take per wake — the desk loop's turn is the shell's
    // tick until the stream carries one — and the card's window
    // follows; the open panel follows the history the take grew.
    nc.beat()
    const had = nc.entries().length()
    nc.take()
    notify_card_sync(f, nc, mw)
    if nc.panel_open() && nc.entries().length() != had {
      notify_panel_sync(f, nc, mw, mh)
    }
    const ev = syscall.input_read()
    const t = ev_type(ev)
    // The death's word (emo-desktop A12.1): type 0x4558, the child's
    // pid in the code, its exit code in the value. A slot's pid ends
    // and the slot empties — the dot goes out, the dock repaints,
    // `desktop <name> exit <code>` on the wire. The proof chain's own
    // deaths ride the same ring to the same parent and name no slot:
    // the silent drops are the drain.
    if t == ev_exit {
      const child = ev_code(ev)
      const code = ev_value(ev)
      var slot = -1
      if child == peek64(buf + desk_pids) {
        slot = 0
      }
      if child == peek64(buf + desk_pids + 8) {
        slot = 1
      }
      if child == peek64(buf + desk_pids + 16) {
        slot = 2
      }
      if slot == 0 {
        poke64(buf + desk_pids, 0)
        desk_exit_line(buf + desk_names, desk_nlen(0), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
      if slot == 1 {
        poke64(buf + desk_pids + 8, 0)
        desk_exit_line(buf + desk_names + 12, desk_nlen(1), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
      if slot == 2 {
        poke64(buf + desk_pids + 16, 0)
        desk_exit_line(buf + desk_names + 24, desk_nlen(2), code)
        desk_dock(f, labels)
        desk_chrome(f)
      }
    }
    // The serial's byte: the line's feed, the command when the line
    // ends — `exec` the launcher's own dispatch, the rest the shell's.
    if t == 17741 {
      const n = shell.feed(ev_value(ev))
      if n >= 0 {
        const s = shell.skip_spaces(0, n)
        const e = shell.word_end(s, n)
        if shell.exec_p(s, e - s) {
          desk_exec_cmd(f, e, n, labels)
        } else {
          shell.execute(n)
          // the volume may have changed under the command (the write,
          // the rm): the fold's comparison is the refresh's whole cost
          // when it did not (emo-desktop A13)
          desk_icons_refresh(f)
        }
        shell.prompt()
      }
    }
    if t == 3 {
      if ev_code(ev) == 0 {
        px = scaled(ev_value(ev), mw, max_x)
      }
      if ev_code(ev) == 1 {
        py = scaled(ev_value(ev), mh, max_y)
      }
    }
    // The tablet's left button (BTN_LEFT, 272): a press on the strip
    // names a tile, and the tile names its app — the launcher's whole
    // answer; a press above the strip is the desktop's own ground or
    // the windows' world, the press-raise the compositor's own. The
    // bar's press is no one's here: the compositor gave the focus to
    // the desktop already (T8.27). An icon's cell the hit test names —
    // the selection moved, the folder's door, the way up; the bare
    // wallpaper the selection's clear (emo-desktop A13).
    if t == 1 && ev_code(ev) == 272 {
      if ev_value(ev) == 1 {
        const tile = emo_desktop.press(px, py, mw, mh, 3)
        // The header's bell first (emo-desktop M25, A25.2): the
        // panel's door, and an open panel owns every press inside its
        // rect — the DND row's verdict or the panel's own, never the
        // desktop's icons underneath.
        if notify_bell_hit(f, px, py) {
          notify_panel_toggle(f, nc, mw, mh)
        } else {
          if peek64(buf + notify_panel_grant) != 0 &&
             emo_notify.center_hit(px, py, mw, emo_desktop.header_height(),
               mh - emo_desktop.strip_height()) {
            if emo_notify.dnd_hit(px, py, mw, emo_desktop.header_height()) {
              nc.toggle_dnd()
            }
            notify_panel_sync(f, nc, mw, mh)
          } else {
            if tile == 0 {
              desk_launch(f, 0, labels)
            }
            if tile == 1 {
              desk_launch(f, 1, labels)
            }
            if tile == 2 {
              desk_launch(f, 2, labels)
            }
            if tile == -1 && py >= emo_desktop.header_height() {
              desk_icon_press(f, emo_desktop.icon_hit(px, py, peek64(buf + desk_view_count), mw, mh))
            }
          }
        }
      }
    }
  }
}

// The desktop takes the foreground (emo-desktop A12.1): the loop
// never returns — the poweroff command's exit verb is what ends the
// machine now, and the launcher's tiles are how a program begins.
desktop()
