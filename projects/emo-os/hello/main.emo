        (R.error, _) -> { mark() }
        (R.ok, _) -> { fmt_ok_line() }
      }
      case syscall.win_format(id, 1) {
        (R.error, _) -> { fmt_no_line() }
        (R.ok, _) -> { mark() }
      }
      case syscall.win_scale(id, 1) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { scale_ok_line() }
      }
      case syscall.win_scale(id, 2) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { scale_two_line() }
      }
      case syscall.win_scale(id, 0) {
        (R.error, _) -> { scale_no_line() }
        (R.ok, _) -> { mark() }
      }
      case syscall.win_scale(id, 1) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      case syscall.desktop_version() {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { protocol_line() }
      }
      case syscall.present(id, 0, 0, 512, 128) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { win_shown_line() }
      }
      // The roles' substance (emo-desktop A9.3): a popup and a
      // subsurface hang from this toplevel by verb 19 — their
      // coordinates the parent's from the binding on, the walk painting
      // each immediately above it — and a panel stands alone as the
      // walk's topmost strip, refusing a parent by its role. Each is
      // painted, presented (the composition names its absolute place),
      // and closed — the runs home before the pass moves its own.
      var ppop = 0
      case syscall.win_new(128, 64) {
        (R.error, _) -> { mark() }
        (R.ok, pans) -> {
          ppop = win_id(pans)
          case syscall.win_role(ppop, 1) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          case syscall.win_parent(ppop, id) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          case syscall.win_move(ppop, 48, 32) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          paint_win(win_base(pans), 64, 64, 0x504F5000)
          case syscall.present(ppop, 0, 0, 128, 64) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> { popup_up_line() }
          }
        }
      }
      var psub = 0
      case syscall.win_new(64, 64) {
        (R.error, _) -> { mark() }
        (R.ok, sans) -> {
          psub = win_id(sans)
          case syscall.win_role(psub, 2) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          case syscall.win_parent(psub, id) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          case syscall.win_move(psub, 400, 32) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          paint_win(win_base(sans), 64, 32, 0x53554200)
          case syscall.present(psub, 0, 0, 64, 64) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> { sub_up_line() }
          }
        }
      }
      var ppan = 0
      // the panel is the walk's topmost strip: the mode's own width at
      // the display's bottom edge (A14.3 — the shape derives, the mode
      // the device's answer)
      var pmw = 0
      var pmh = 0
      case syscall.output_info(0) {
        (R.error, _) -> { mark() }
        (R.ok, m) -> {
            pmw = m >> 32
            pmh = m & 4294967295
          }
      }
      case syscall.win_new(pmw, 32) {
        (R.error, _) -> { mark() }
        (R.ok, qans) -> {
          ppan = win_id(qans)
          case syscall.win_role(ppan, 3) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          case syscall.win_parent(ppan, id) {
            (R.error, _) -> { parent_panel_line() }
            (R.ok, _) -> { mark() }
          }
          case syscall.win_move(ppan, 0, pmh - 32) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> {}
          }
          paint_win(win_base(qans), 32, pmw / 2, 0x504E4C00)
          case syscall.present(ppan, 0, 0, pmw, 32) {
            (R.error, _) -> { mark() }
            (R.ok, _) -> { panel_up_line() }
          }
        }
      }
      case syscall.win_parent(ppop, 99) {
        (R.error, _) -> { parent_gone_line() }
        (R.ok, _) -> { mark() }
      }
      case syscall.win_move(id, 16, 32) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { win_moved_line() }
      }
      case syscall.present(id, 0, 0, 512, 128) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      case syscall.win_focus(id) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { win_focused_line() }
      }
      case syscall.win_close(ppop) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { popup_closed_line() }
      }
      case syscall.win_close(psub) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { sub_closed_line() }
      }
      case syscall.win_close(ppan) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { panel_closed_line() }
      }
      case syscall.win_close(id) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> { win_closed_line() }
      }
    }
  }
  // The pass's own exit marker (emo-desktop A9.3): the frame
  // callback's park below moves this pass's exit past the parent's
  // era — the wait that printed this line retired with it, the marker
  // the pass's to say. Then the park: the answer is the machine's
  // next composition (the client era's first frame carries it), and
  // the line it wakes to is the callback's proof on the wire.
  win_zero_line()
  case syscall.win_frame() {
    (R.error, _) -> { mark() }
    (R.ok, _) -> { cb_ok_line() }
  }
  syscall.exit(0)
}

// The client's line (emo-desktop A9.2): `client up <grant>` — the
// surface is on the stack and its frame is on the display.
def client_up_line(id Int64) Void {
  var p = byte_at(0, 99) // c
  p = byte_at(p, 108) // l
  p = byte_at(p, 105) // i
  p = byte_at(p, 101) // e
  p = byte_at(p, 110) // n
  p = byte_at(p, 116) // t
  p = byte_at(p, 32) // space
  p = byte_at(p, 117) // u
  p = byte_at(p, 112) // p
  p = byte_at(p, 32) // space
  p = num_at(id, p)
  p = byte_at(p, 10)
  gate_line(p)
}

// The client branch (emo-desktop A9.2): a pass of its own that opens a
// toplevel surface — win_new, win_role(toplevel), win_move to its
// place, the raw pattern painted into its own buffer, the present
// putting it on the stack — and says `client up <grant>`. The first
// client then stores where its table maps nothing and dies without
// closing: the fault route reaps the pass and writes the comp page's
// dead-owner cell (T8.14), and the compositor's next composition reads
// it — the run back to the allocator, the row emptied, the surface off
// the stack — the acceptance the rebirth proves. The reborn client
// takes a different place and a different pattern, closes cleanly and
// exits, so the parent's wait answers and the chain moves on with the
// machine whole.
if peek64(client_cell) != 0 {
  poke64(client_cell, 0)
  var cplace_x = 96
  var cword = 0x57494E00
  case syscall.win_new(384, 128) {
    (R.error, _) -> { mark() }
    (R.ok, cans) -> {
      var cid = win_id(cans)
      case syscall.win_role(cid, 0) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      case syscall.win_move(cid, cplace_x, 320) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      paint_win(win_base(cans), 128, 192, cword)
      case syscall.present(cid, 0, 0, 384, 128) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      client_up_line(cid)
      poke64(0x20000000, 0) // the kill: a store the table maps nothing —
                           //   the fault the death-side reclaim waits for
    }
  }
  syscall.exit(1) // unreachable — the store above faults first
}
if peek64(client2_cell) != 0 {
  poke64(client2_cell, 0)
  case syscall.win_new(384, 128) {
    (R.error, _) -> { mark() }
    (R.ok, cans) -> {
      var cid = win_id(cans)
      case syscall.win_role(cid, 0) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      case syscall.win_move(cid, 512, 320) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      paint_win(win_base(cans), 128, 192, 0x52454200)
      case syscall.present(cid, 0, 0, 384, 128) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
      client_up_line(cid)
      case syscall.win_close(cid) {
        (R.error, _) -> { mark() }
        (R.ok, _) -> {}
      }
    }
  }
  syscall.exit(0)
}

// The UI branch (T7.4, docs/ui.md): a spawned pass renders the
// counter's frame and answers the console's keys until the quit key
// ends it — the machine's third kind of resident, an application, and
// the closure demo's last piece: kernel, shell, and UI in one
// language. Its exit answers the parent's wait, and the REPL takes
// the console after it.
if peek64(ui_cell) != 0 {
  poke64(ui_cell, 0)
  console_ui.run()
  syscall.exit(0)
}

// The window shell (emo-desktop A9.1, EmoOS T8.13): the desktop's first
// windows — two toplevel surfaces, `alpha` and `beta`, each a buffer of
// this pass's own, declared a toplevel by its role, placed by the move
// verb, painted through `ui_fb_win` into its own words and committed by
// its present, which the compositor answers with the whole stack
// composited into the carve. Then the pass owns the merged stream and
// is the desktop's policy over it: a press inside a window focuses it
// (the focus verb, which raises it to the stack's top; the bar's steel
// says which one is focused — the window that was focused repaints
// dim, the new one repaints focused), a press on a window's bar begins
// a drag — every report of the pointer moves the window with the
// pointer through the move verb, its x kept on the blit's word
// granularity and the window kept on the display — and the release is
// the present that puts the moved window where the drag left it; a key
// byte `a` is routed to the focused window alone, which counts it on
// its body line; `q` ends the shell, the windows closed behind it. The
// pointer's reports are scaled to the display by the device's own range
// (verb 18's answer, never a constant). Every state on the wire: the
// range, the grants, each focus, each key routed, each drag's end — the
// `run.sh` beats, and the frames' digests (`frame <n>`) the hosted
// twin's file names in the same order.
if peek64(desk_cell) != 0 {
