    if r0 < 0 || r0 > 15 {
      return -reason_argument
    }
    var pme5 = peek64(handoff_caller)
    if pme5 >= pipe.pipe_pid_bound {
      return -reason_resource
    }
    pipe.pipe_stage(pme5, pipe.pipe_op_close, r0, 0, 0, 0, 0)
