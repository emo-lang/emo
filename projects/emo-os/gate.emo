    poke64(execargs_nlen, r1)
    if r3 > 0 {
      copy_to(execargs_args, r2, r3)
    }
    poke64(execargs_alen, r3)
    if r5 > 0 {
      copy_to(execargs_env, r4, r5)
    }
    poke64(execargs_elen, r5)
    poke64(execargs_use, 2)
    poke64(exec_busy, 1)
