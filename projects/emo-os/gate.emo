    if r3 < 0 || r3 > execargs_cap {
      return -reason_argument
    }
    if r5 < 0 || r5 > execargs_env_cap {
      return -reason_argument
    }
    var vn3 = check_read(r0, r1)
    if vn3 != 0 {
