    if peek64(handoff_caller) >= img_bound {
      return -reason_resource
    }
    if peek64(exec_busy) != 0 {
      return -reason_resource
    }
    copy_to(execargs_name, r0, r1)
    poke64(execargs_nlen, r1)
    if r3 > 0 {
      copy_to(execargs_args, r2, r3)
