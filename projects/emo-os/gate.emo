    if r0 < 0 || r0 > 15 || r1 < 0 || r1 > 15 {
      return -reason_argument
    }
    var pme4 = peek64(handoff_caller)
    if pme4 >= pipe.pipe_pid_bound {
      return -reason_resource
    }
    pipe.pipe_stage(pme4, pipe.pipe_op_dup, r0, r1, 0, 0, 0)
    return route_pipe_dup
  }
  if n == 60 {
