// Sv39 (T6.1): the kernel's page tables, built in Emo over raw memory
// — the README's untyped-memory discipline, Int64 addresses and
// peek/poke and bit masks, no value of the language pointing into a
// table. A table is a 4 KiB frame of 512 eight-byte entries; a leaf
// entry carries a physical page number and the permission bits, a
// non-leaf the next table's; the walk takes nine bits of the virtual
// address per level, three levels down from the root. The frames come
// from the allocator (frames.emo), one per table.
//
// The layout is the kernel's high half: every kernel address is the
// physical one plus koff, the base of Sv39's upper half, so the image,
// the free RAM, the fixed pages, and the devices all sit where the
// kernel's own loads, stores, and fetches reach them, and a user address
// — the lower half — is told from a kernel one by its sign. The kernel's
// own table, built at boot, maps the image by its permission boundaries
// (text RX, rodata R, data and bss RW), the rest of the RAM RW to the
// board's top, the two devices the kernel drives, and — until the
// per-process tables (T6.2) — the pre-SV39 window as two gigapages the
// user can reach at the physical addresses it runs on. Nothing here
// touches satp: the write and the fence are the shim's (sv39.S), called
// with the physical root this module answers.

const koff = -274877906944 // 0xFFFFFFC000000000: the high half's base
const page = 4096
const mega = 2097152
const giga = 1073741824

// This module's fixed page: the root's kernel address, for the
// program's check against the live satp; the stub writes the satp
// beside it.
const root_cell = koff + 0x87004000

// The entry's bits: valid, the three permissions, user, accessed,
// dirty. Every leaf is written accessed and dirty — the kernel keeps
// no use counts, and a hardware that traps on a clear bit must not.
const pte_v = 1
const pte_r = 2
const pte_w = 4
const pte_x = 8
const pte_u = 16
const pte_a = 64
const pte_d = 128
const leaf_bits = pte_r | pte_w | pte_x
const rx = pte_r | pte_x
const r = pte_r
const rw = pte_r | pte_w
const rwu = pte_r | pte_w | pte_u
const rwxu = pte_r | pte_w | pte_x | pte_u

// The machine: the image's load address (where OpenSBI enters, where
// the kernel's text begins), the top of the board's 128 MiB, the two
// devices the kernel drives.
const image = koff + 0x80200000
const ram_top = koff + 0x88000000
const uart = 0x10000000
const plic = 0x0c000000

// The two aliases of one byte: the kernel's address and the physical
// one. The leaf entries carry the physical; the kernel reads and writes
// through the kernel's; a user pass pre-T6.2 runs on the physical.
def pa_of(va Int64) Int64 {
  return va - koff
}

def va_of(pa Int64) Int64 {
  return pa + koff
}

def pte_of(pa Int64, flags Int64) Int64 {
  return ((pa >> 12) << 10) | flags
}

def pte_pa(e Int64) Int64 {
  return (e >> 10) << 12
}

// The nine bits of `va` the table at `level` indexes by: level 2 is the
// root's. A kernel address is negative; the mask keeps the shift's sign
// out of the index.
def vpn(va Int64, level Int64) Int64 {
  return (va >> (12 + (9 * level))) & 511
}

def clear(table Int64) Void {
  var i = 0
  while i < 512 {
    poke64(table + (i * 8), 0)
    i = i + 1
  }
}

// The entry's address for `va` at `level`, the tables on the way
// created as needed — a fresh frame, cleared, its entry in the parent
// valid and nothing else. A leaf met on the way is a kernel bug: a
// larger page already covers this address.
def slot_of(root Int64, va Int64, level Int64) Int64 {
  var table = root
  var l = 2
  while l > level {
    var at = table + (vpn(va, l) * 8)
    var e = peek64(at)
    if (e & pte_v) == 0 {
      var f = frames.frame_take()
      if f == 0 {
        die("sv39: no frame left for a table")
      }
      clear(f)
      poke64(at, pte_of(pa_of(f), pte_v))
      table = f
    } else {
      if (e & leaf_bits) != 0 {
        die("sv39: a leaf blocks the walk")
      }
      table = va_of(pte_pa(e))
    }
    l = l - 1
  }
  return table + (vpn(va, level) * 8)
}

// One leaf: a 4 KiB page at level 0, a 2 MiB megapage at 1, a 1 GiB
// gigapage at 2. The entry must be free — mapping an address twice is
// a kernel bug — and both addresses aligned to the page the level
// means.
def map(root Int64, va Int64, pa Int64, flags Int64, level Int64) Void {
  var size = page << (9 * level)
  if va % size != 0 || pa % size != 0 {
    die("sv39: a leaf off its page boundary")
  }
  var at = slot_of(root, va, level)
  if (peek64(at) & pte_v) != 0 {
    die("sv39: an address mapped twice")
  }
  poke64(at, pte_of(pa, flags | pte_v | pte_a | pte_d))
}

// A range, page-aligned at both ends and in length: megapages wherever
// both addresses sit on a 2 MiB boundary with 2 MiB to go, 4 KiB pages
// elsewhere — so an image whose permission boundaries fall mid-megapage
// costs one small table, and the hundred megabytes behind it a few
// dozen entries.
def map_range(root Int64, va Int64, pa Int64, len Int64, flags Int64) Void {
  if va % page != 0 || pa % page != 0 || len % page != 0 {
    die("sv39: a range off its page boundaries")
  }
  var v = va
  var p = pa
  var left = len
  while left > 0 {
    if v % mega == 0 && p % mega == 0 && left >= mega {
      map(root, v, p, flags, 1)
      v = v + mega
      p = p + mega
      left = left - mega
    } else {
      map(root, v, p, flags, 0)
      v = v + page
      p = p + page
      left = left - page
    }
  }
}

// The translation a table gives `va`: the physical address, or -1 when
// nothing maps it — the software walk, what the hardware does on a
// miss. The boot's check reads it against the addresses the kernel is
// about to run on.
def lookup(root Int64, va Int64) Int64 {
  var table = root
  var l = 2
  while l >= 0 {
    var e = peek64(table + (vpn(va, l) * 8))
    if (e & pte_v) == 0 {
      return -1
    }
    if (e & leaf_bits) != 0 {
      var size = page << (9 * l)
      return pte_pa(e) + (va & (size - 1))
    }
    table = va_of(pte_pa(e))
    l = l - 1
  }
  return -1
}

def check(root Int64, va Int64, pa Int64) Void {
  if lookup(root, va) != pa {
    die("sv39: the table does not translate the kernel's own addresses")
  }
}

// The kernel's own table, built before the program runs: the stub
// passes the two permission boundaries the linker script draws, and
// the answer is the root's physical address — what the shim writes
// into satp. The image: text RX from the load address, rodata R, then
// everything to the board's top RW — data and bss, the frame region,
// the fixed pages, the user window (the kernel's view of it, no U).
// The devices: the UART's page and the PLIC's 4 MiB. The window
// (T4.5): RAM at identity, RWX with U — the user image executes there
// — and the first gigabyte of MMIO at identity, RW with U — the first
// user program's greeting pokes the UART directly; both exactly the
// reach the window had, now a mapping, and T6.2 replaces them with
// per-process tables. The firmware's region is in the window's
// gigapage, not the kernel's map: the kernel never touches it, and a
// user load there still meets PMP's refusal. Before the answer, the
// table is walked for the addresses the next instructions depend on.
def boot(text_end Int64, rodata_end Int64) Int64 {
  var root = frames.frame_take()
  if root == 0 {
    die("sv39: no frame left for the root")
  }
  clear(root)
  map_range(root, image, pa_of(image), text_end - image, rx)
  map_range(root, text_end, pa_of(text_end), rodata_end - text_end, r)
  map_range(root, rodata_end, pa_of(rodata_end), ram_top - rodata_end, rw)
  map_range(root, va_of(uart), uart, page, rw)
  map_range(root, va_of(plic), plic, 2 * mega, rw)
  map(root, 0, 0, rwu, 2)
  map(root, 0x80000000, 0x80000000, rwxu, 2)
  check(root, image, pa_of(image))
  check(root, rodata_end, pa_of(rodata_end))
  check(root, root, pa_of(root))
  check(root, root_cell, pa_of(root_cell))
  check(root, va_of(uart), uart)
  check(root, 0x87100000, 0x87100000)
  poke64(root_cell, root)
  return pa_of(root)
}

// The loud end of a kernel bug in the tables: the line says which, the
// SBI takes the machine down. Boot-time only — nothing here runs inside
// a trap.
def die(what String) Void {
  println(what)
  halt()
}
