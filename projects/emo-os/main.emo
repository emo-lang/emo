// The EmoOS kernel (T3.7 console, T4.4 services): the interrupt-driven
// console — the UART's receive line rides the PLIC into the trap shim,
// which fills the input ring at its fixed address and wakes the console
// service; the kernel's own printing stays the polled 16550A path
// through the runtime's console hook; SBI keeps poweroff. T4.4 adds
// the two processes the gate routes to while a user program runs: the
// console service (read/write) and the process service
// (spawn/exit/wait). T5.3 puts every spawned pass's stack and arena on
// the frame allocator (frames.emo) — the free RAM above this image in
// 64 KiB blocks, taken at the spawn, given back at the death. T6.1
// moves the kernel into Sv39's high half: every address the kernel
// reaches is the physical one plus koff, and the program's first lines
// check the live satp against the table sv39.emo built. T6.2 gives
// every user pass its own table (space.emo, built at the spawn): its
// image's segments with U, its own stack and arena, the cells page —
// and the kernel's whole high half mapped without U — so a pass's
// world is its own pages and the gate's copy-in (the write verb's
// staging buffer) is what crosses; the services on the kernel's own
// table read nothing of the caller's memory. T7.1 adds the block
// driver, a process that owns the virtio-blk queue; T7.2 the
// filesystem service above it (fs.emo, the design in docs/fs.md) and
// the supervisor that owns the service's life — the cache block, the
// spawn, the restart on the death notice the runtime's death hook
// posts, the parked clients refused at the restart. T8.2 cuts the
// screen carve from the allocator's region's top (frames.emo) and
// hands it once, at the spawn: the cells-page token is the grant's
// channel, the process service takes the hand and pokes the pending
// cell, space.emo's build maps the carve into the child's table, and
// the child's exit is the pattern's readback — the first full-screen
// pass's proof. T8.1 adds the display's driver, a process on the
// blk_service's shape: the virtio-gpu's control queue on one allocator
// block, the 2D path the whole need — create, attach the carve as the
// backing, scanout, transfer, flush — the mode read from the device
// and never a constant, and the root's flush smoke riding the mailbox.
//
//   emo build main.emo --target riscv64

const koff = -274877906944 // 0xFFFFFFC000000000: the high half's base

// The registers the polled transmit path touches, byte-wide: the
// transmit holding register at 0, the interrupt-enable register at 1,
// the FIFO control at 2, the line control at 3, the line-status
// register at 5 — bit 5 says the transmitter is empty (safe to
// write), bit 0 says a received byte is waiting.
const uart = koff + 0x10000000

// The input ring (T3.7): the trap shim fills it from the UART's FIFO —
// the producer cursor, the consumer cursor, then 128 one-byte entries,
// at the fixed addresses the kernel's linker script gives the section.
// The trap shim is the only producer; the console service is the only
// consumer; a full ring leaves the bytes in the FIFO and the line
// re-raises.
const in_prod = koff + 0x87001000
const in_cons = koff + 0x87001008
const in_ring = koff + 0x87001010

// The tick ring (T3.6): the trap shim counts every timer interrupt
// into it — the producer cursor, the consumer cursor, the dropped
// count, then 64 entries.
const tick_ring = koff + 0x87000000

// The handoff cells the services read and the boot flow fills (T4.4):
// the services' raw pids (the gate posts by number), the request cells
// the gate fills — one pair per service, since a console transaction
// and a process transaction can sit parked at the same time — and the
// process service's exit table. A spawned pass's stack is a block of
// the frame allocator (frames.emo, T5.3), taken by the process service
// and given back by the runtime's reaper at the death. The user
// program cell is the user image's own, at the top of its window: a
// user address, read through the identity alias.
const console_svc_cell = koff + 0x870020f0
const process_svc_cell = koff + 0x870020f8
const handoff_arga = koff + 0x870020e0
const handoff_argb = koff + 0x870020e8
const proc_arga = koff + 0x870021b0
const proc_argb = koff + 0x870021b8
const user_program_cell = 0x87fff000
const exit_count = koff + 0x87002118
const exit_pids = koff + 0x87002120
const exit_codes = koff + 0x87002160
const pending_flag = koff + 0x870021a0
const pending_target = koff + 0x870021a8

// The block device (T7.1): the virtio-mmio transports — eight slots
// on this board, a 4 KiB register page each; the driver scans them for
// the block device (QEMU's `-device virtio-blk-device` lands on an
// mmio bus; the slot depends on the bus enumeration, so the scan is
// the driver's own discipline, the FDT walk's shape). IRQ 1..8 stay
// unwired: the completion wait is polled (the console's
// pre-interrupt discipline); the interrupt-driven wait is a later
// piece — nothing in the filesystem's work (T7.2) demanded it. The
// input device (T8.3) is the first whose line is wired: its events
// arrive without a request to poll for, and the wake is the whole ISR.
const virtio_base = koff + 0x10001000
const pending_waiter = koff + 0x870021c0
const block = 65536

// The PLIC's registers the input service's init writes (T8.3): the
// per-IRQ priority, and S-mode context 1's enable word for IRQs
// 0..31 — the UART's bit 10 already set by the shim's init (T3.7), so
// the enable is a read-modify-write.
const plic = koff + 0x0c000000
const plic_enable = koff + 0x0c002080
// The compositor's page (T8.6, the link.ld section .emo_comp at
// 0x87008000): the state that outlives the instances — the generation
// the restart increments, the display's mode (the init's query), and
// the window stack (eight entries of grant, x, y — the position the
// blit places a window at, the policy the compositor holds). The
// routing cells ride the handoff page's tail beside the grant table.
const comp_page = koff + 0x87008000
const comp_gen_cell = comp_page
const comp_top_cell = comp_page + 8
const comp_focus_cell = comp_page + 16
const comp_mode_w = comp_page + 24
const comp_mode_h = comp_page + 32
const comp_stack = comp_page + 64
const comp_svc_cell = koff + 0x87002e00
const comp_sup_cell = koff + 0x87002e08
const comp_args = koff + 0x87002e10


// The filesystem's pages (T7.2, docs/fs.md): the service's pid cell
// the gate routes by — cleared by the death notice the moment the
// service dies, parked again by the supervisor when the next instance
// has announced — and the supervisor's own pid cell the death notice
// posts to.
const fs_pid_cell = koff + 0x87005000
const supervisor_cell = koff + 0x87005008
const notice_op = 256


// The screen carve's grant channel (T8.2): the token cell on the user
// cells page — the one crossing every table maps, so any spawner (the
// proof chain today, the shell's desktop command tomorrow) pokes it
// and the claimed pass reads it — and the pending cell on the handoff
// page the spawn-side half rides in: the process service reads the
// token at the spawn, takes the carve's hand (frames.screen_take,
// once — a second claimant is the refusal), and pokes the carve's
// kernel address into the pending cell for space.emo's build to map
// into the child's table before the child's first store. The pending
// cell sits on the handoff page past the write's staging area
// (gate.emo's stage_buf owns the free tail's first 2048 bytes — the
// first boot caught the collision).
const screen_cell = 0x87fff040
const screen_pending_cell = koff + 0x870029e0


// The input service's cells (T8.3): the pid cell the gate routes the
// read verb and the input_read verb by, and the IRQ cell the service's
// driver parks its virtio-input transport's PLIC number in — the trap
// shim's external branch reads it (0 = not wired, the loud end it
// always was). Both live on the handoff page past the staging area and
// the screen's pending cell.
const input_svc_cell = koff + 0x870029e8
const input_irq_cell = koff + 0x870029f0

// The desktop segment's cells (T8.4, T8.5): the display service's pid
// cell the gate routes the desktop verbs by; the authorization table's
// first entry — the screen carve's grant, the pid the process service
// parked the moment it handed the carve out (a dead pid never matches:
// the slots are never reused, and the grant is the machine's desktop
// for its life); the five argument cells the gate fills for the
// desktop verbs (the grant id, the damage rect, win_new's w and h);
// the caller's space word the shim stages at every ecall and the
// gate's dispatch copies into the arguments (win_new's mapping
// target); the grant id the next win_new answers; and the
// window grants' rows — twelve words each, eight of them, zero = a
// free row. All past the staging area's tail.
const gpu_svc_cell = koff + 0x870029f8
const screen_grant_cell = koff + 0x87002a00
const gpu_args = koff + 0x87002a08
const caller_space_cell = koff + 0x87002a40
const grant_next_cell = koff + 0x87002a38
const grant_table = koff + 0x87002b00


// The display (T8.1): the virtio-gpu device rides the same eight mmio
// transports the block driver scans — DeviceID 16 — and the screen
// carve's physical address is the backing the 2D resource attaches:
// the device reads the framebuffer the pass paints straight out of the
// carve (frames.emo owns the region's exclusion, T8.2). The format is
// XRGB8888 — B8G8R8X8 in the device's naming — the decided baseline's
// own; the mode itself is the device's to say (GET_DISPLAY_INFO's
// answer, never a constant — the protocol's second seam).
const screen_base = 0x86c00000 // physical: frames.emo's carve, the device's DMA view
const screen_size = 0x400000
const gpu_format_bgrx = 2 // VIRTIO_GPU_FORMAT_B8G8R8X8_UNORM — XRGB8888

// The arena's run (T8.9): the blocks one child's arena takes — a
// contiguous run claimed in one take at the spawn (frames.emo's
// arena_run, the stub parks it in the runtime's emo_arena_run_len).
const arena_run = 2

// The Sv39 page (T6.1): the root table's kernel address, written by
// sv39.emo's boot, and the satp the stub read back from the switch.
const sv39_root = koff + 0x87004000
const sv39_satp = koff + 0x87004008

// The gate's verbs, as the services see them: the request word rides
// op << 32 with the caller's pid number beside it — a magnitude no pid
// word reaches, so the console service tells the gate's requests from
// the boot demo's readers by size alone. The decode lives in a typed
// def: the mailbox word arrives untyped, and comparisons on it are the
// dynamic operator the target refuses. The low half is the reply's
// addressee: gate_reply takes it beside the answer.

def op_of(w Int64) Int64 {
  return w >> 32
}

def caller_of(w Int64) Int64 {
  return w & 4294967295
}

def console_put_byte(b Int64) Void {
  while (peek8(uart + 5).to_int64() & 32) == 0 {
  }
  poke8(uart, b.to_byte())
}

// The supervisor's fault report (T4.6): a user fault kills the
// offender, and the shim announces it — who, why, where, and (T6.4)
// the address the hardware refused — through this def on the kernel's
// trap stack (the gate's precedent: typed Emo inside the trap, zero
// allocation, the polled console). The pid and the cause print
// decimal, the epc and stval hex.
def fault_digit(n Int64) Void {
  if n < 10 {
    console_put_byte(48 + n)
  } else {
    console_put_byte(87 + n)
  }
}

// Hex from the top down, leading zeros skipped, the 64-bit pattern
// unsigned-faithful (T6.5): a kernel address is negative as an Int64
// and its hex is the pattern the hardware put in stval or satp, not
// its sign — the arithmetic shift keeps the low nibble true at every
// depth, and the sign bits are the top digits.
def fault_hex_walk(n Int64, shift Int64, started Int64) Void {
  if shift >= 0 {
    var d = (n >> shift) & 15
    var st = started
    if d != 0 || st != 0 || shift == 0 {
      fault_digit(d)
      st = 1
    }
    fault_hex_walk(n, shift - 4, st)
  }
}

def fault_hex(n Int64) Void {
  fault_hex_walk(n, 60, 0)
}

def fault_dec(n Int64) Void {
  if n >= 10 {
    fault_dec(n / 10)
  }
  console_put_byte(48 + (n % 10))
}

def fault_report(pid Int64, cause Int64, epc Int64, addr Int64) Void {
  console_put_byte(117) // u
  console_put_byte(115) // s
  console_put_byte(101) // e
  console_put_byte(114) // r
  console_put_byte(32)  // space
  console_put_byte(102) // f
  console_put_byte(97)  // a
  console_put_byte(117) // u
  console_put_byte(108) // l
  console_put_byte(116) // t
  console_put_byte(32)  // space
  fault_dec(pid)
  console_put_byte(32)  // space
  console_put_byte(99)  // c
  console_put_byte(97)  // a
  console_put_byte(117) // u
  console_put_byte(115) // s
  console_put_byte(101) // e
  console_put_byte(32)  // space
  fault_dec(cause)
  console_put_byte(32)  // space
  console_put_byte(97)  // a
  console_put_byte(116) // t
  console_put_byte(32)  // space
  console_put_byte(48)  // 0
  console_put_byte(120) // x
  fault_hex(epc)
  // stval (T6.4): the address the hardware refused — for a page fault
  // the page the walk never reached; for the other exceptions whatever
  // the hardware recorded (an illegal instruction's bits, or zero).
  // The kill is the whole handling: nothing inspects the address to
  // fill a mapping — demand paging is out of scope by decision.
  console_put_byte(32)  // space
  console_put_byte(97)  // a
  console_put_byte(100) // d
  console_put_byte(100) // d
  console_put_byte(114) // r
  console_put_byte(32)  // space
  console_put_byte(48)  // 0
  console_put_byte(120) // x
  fault_hex(addr)
  // TEMPORARY (T8.5 debug): the live satp at the fault, staged by the
  // shim — the hardware's own root beside the software's.
  console_put_byte(32)  // space
  console_put_byte(115) // s
  console_put_byte(97)  // a
  console_put_byte(116) // t
  console_put_byte(112) // p
  console_put_byte(32)  // space
  fault_hex(peek64(koff + 0x87002a48))
  console_put_byte(10)
}

// The heap's death report (T5.1): a user pass whose own arena ran dry
// — announced by the user image's allocator through the gate (verb 5),
// printed by the supervisor on the offender's own stack, zero
// allocation. The shim ends the pass after this returns; the machine
// continues.
def heap_report(pid Int64) Void {
  console_put_byte(117) // u
  console_put_byte(115) // s
  console_put_byte(101) // e
  console_put_byte(114) // r
  console_put_byte(32)  // space
  console_put_byte(104) // h
  console_put_byte(101) // e
  console_put_byte(97)  // a
  console_put_byte(112) // p
  console_put_byte(32)  // space
  fault_dec(pid)
  console_put_byte(32)  // space
  console_put_byte(103) // g
  console_put_byte(111) // o
  console_put_byte(110) // n
  console_put_byte(101) // e
  console_put_byte(10)
}

def uart_init() Void {
  poke8(uart + 3, 128B)
  poke8(uart + 0, 3B)
  poke8(uart + 1, 0B)
  poke8(uart + 3, 3B)
  poke8(uart + 2, 7B)
  poke8(uart + 1, 1B)
}

// The live table (T6.1): the satp the stub read back from the switch
// must say Sv39 (mode 8) and name the root sv39.emo built, or the
// kernel is running on some other table and ends here. The line is the
// proof on the serial that the kernel runs paged on its own table; the
// root prints physical, as satp holds it.
def sv39_report() Void {
  var live = peek64(sv39_satp)
  var mode = (live >> 60) & 15
  var root = (live & 0xFFFFFFFFFFF) << 12
  if mode != 8 || root != sv39.pa_of(peek64(sv39_root)) {
    println("sv39: the live table is not the kernel's")
    halt()
  }
  console_put_byte(115) // s
  console_put_byte(118) // v
  console_put_byte(51)  // 3
  console_put_byte(57)  // 9
  console_put_byte(32)  // space
  fault_dec(mode)
  console_put_byte(32)  // space
  console_put_byte(48)  // 0
  console_put_byte(120) // x
  fault_hex(root)
  console_put_byte(10)
}

// The DMA proof (T6.5): the machine's last act beside its account —
// after everything this boot took, split, and gave back, the allocator
// still answers one whole 64 KiB block, block-aligned, and the range
// is one piece of writable RAM: a distinct word lands in each of the
// block's sixteen frames and every one reads back. That range is what
// a DMA consumer (M6's virtio-blk) needs and what the allocator's
// block unit promises — a device's buffer comes from `take`, never
// from sixteen `frame_take`s: the frames the page tables split never
// rejoin a block (T6.1). The check runs in the exit route's trap (the
// fault report's discipline): typed Emo, raw words, zero allocation —
// `take` and `give` are the allocator's own account, and the check's
// pair rides the ledger the account prints right after.
def dma_report() Void {
  var b = frames.take()
  if b == 0 || (b & 65535) != 0 {
    println("dma: no block for the check")
    halt()
  }
  var i = 0
  while i < 16 {
    poke64(b + i * 4096, 0x646D6100 + i)
    i = i + 1
  }
  i = 0
  while i < 16 {
    if peek64(b + i * 4096) != 0x646D6100 + i {
      println("dma: the block is not one range of RAM")
      halt()
    }
    i = i + 1
  }
  frames.give(b)
  console_put_byte(100) // d
  console_put_byte(109) // m
  console_put_byte(97)  // a
  console_put_byte(32)  // space
  console_put_byte(48)  // 0
  console_put_byte(120) // x
  fault_hex(b)
  console_put_byte(32)  // space
  console_put_byte(111) // o
  console_put_byte(107) // k
  console_put_byte(10)
}

// The screen carve's proof (T8.2): the machine's first full-screen pass
// painted its pattern through its own table into the carve — one word
// per 64 KiB across the whole 4 MiB — and exited; the process service
// reads the same words back through the kernel's high alias. One RAM,
// two tables: the words are the hand's proof, and the line names the
// base the pass painted — the physical address, the identity its table
// mapped and the number the display's device will scan out (T8.1). A
// wrong word is a kernel bug, the loud end.
def screen_check(base Int64) Void {
  var i = 0
  while i < 64 {
    if peek64(base + (i * 65536)) != 0x7363726E + i {
      println("screen: the pattern did not land")
      halt()
    }
    i = i + 1
  }
  console_put_byte(115) // s
  console_put_byte(99)  // c
  console_put_byte(114) // r
  console_put_byte(101) // e
  console_put_byte(101) // e
  console_put_byte(110) // n
  console_put_byte(32)  // space
  console_put_byte(48)  // 0
  console_put_byte(120) // x
  fault_hex(sv39.pa_of(base))
  console_put_byte(32)  // space
  console_put_byte(111) // o
  console_put_byte(107) // k
  console_put_byte(10)
}

// The console service (T3.7/T4.4), the machine's output since T8.3:
// the gate's write verb prints its buffer through the polled driver
// and answers the count. The read verb and the boot demo's readers
// moved to the input service (T8.3) — the machine's input is one
// service, the console the machine's output — so any message that is
// not a write is a kernel bug, the loud end.
def console_service(boss Pid) Void {
  boss <- self_pid()
  while true {
    receive {
      w -> {
        var op = op_of(w)
        if op == 1 {
          var buf = peek64(handoff_arga)
          var len = peek64(handoff_argb)
          var i = 0
          while i < len {
            console_put_byte(peek8(buf + i).to_int64())
            i = i + 1
          }
          gate_reply(caller_of(w), len)
        } else {
          println("console: the message is nobody's")
          halt()
        }
      }
    }
  }
}

// The process service (T4.4): spawn takes a block from the frame
// allocator for the child's stack (T5.3) and starts a new process at
// the image's program — the runtime takes the arena block itself, so a
// pass costs two blocks, and a spawn the allocator cannot back is
// refused (−5) before anything is taken; the pass runs on the identity
// alias of its block (T6.1), so the top it receives is the physical
// one; wait answers from the exit table or parks the loop holding the
// request; exit records itself and answers a waiting parent. One gate
// transaction runs at a time, so the one pending-wait pair of cells is
// the whole of the waiting bookkeeping; the request's arguments live in
// this service's own cells (proc_arga/proc_argb), not the console's.
//
// The screen carve's grant rides the spawn (T8.2): the cells-page
// token poked by the spawner is read here, at the spawn — the carve's
// mapping must exist before the child's first store, and the build
// (space.emo) runs inside user_spawn, so the grant crosses in the
// pending cell. The hand is taken at the token: a second claimant's
// spawn is the resource refusal (−5) before anything is staged, the
// stack untouched. The granted child's pid and the carve's base stay
// in the service's own words across the transactions, and the exit
// that answers them is the proof's moment: the pattern read back
// through the kernel's half before the waiting parent is answered.
def process_service(boss Pid) Void {
  boss <- self_pid()
  var screen_pid = 0
  var screen_base = 0
  while true {
    receive {
      w -> {
        var op = op_of(w)
        if op == 3 {
          // A spawn is backed before it is served: the stack block plus
          // the arena's run (arena_run) — a spawn the allocator cannot
          // back is the refusal the caller sees, never the runtime's
          // loud end.
          if frames.spare() < 1 + arena_run {
            gate_reply(caller_of(w), -5)
          } else {
            var screen = 0
            var ok = true
            if peek64(screen_cell) != 0 {
              screen = frames.screen_take()
              ok = screen != 0
            }
            if !ok {
              gate_reply(caller_of(w), -5)
            } else {
              var stack = frames.take()
              if screen != 0 {
                poke64(screen_pending_cell, screen)
              }
              var child = user_spawn(peek64(user_program_cell), sv39.pa_of(stack) + block)
              if screen != 0 {
                screen_pid = child
                screen_base = screen
                // The authorization table's first entry (T8.4): the
                // carve's grant names its holder — the gate's present
                // check reads it. The slots are never reused, so a
                // dead holder's pid can never match a new caller.
                poke64(screen_grant_cell, child)
              }
              gate_reply(caller_of(w), child)
            }
          }
        } else {
          if op == 4 {
            var n0 = peek64(exit_count)
            var i0 = 0
            var hit = -1
            while i0 < n0 {
              if peek64(exit_pids + (i0 * 8)) == peek64(proc_arga) {
                hit = i0
              }
              i0 = i0 + 1
            }
            if hit >= 0 {
              gate_reply(caller_of(w), peek64(exit_codes + (hit * 8)))
            } else {
              poke64(pending_waiter, caller_of(w))
              poke64(pending_target, peek64(proc_arga))
              poke64(pending_flag, 1)
            }
          } else {
            var pid = peek64(proc_argb)
            var code = peek64(proc_arga)
            var n = peek64(exit_count)
            if n < 8 {
              poke64(exit_pids + (n * 8), pid)
              poke64(exit_codes + (n * 8), code)
              poke64(exit_count, n + 1)
            }
            if screen_pid != 0 {
              if pid == screen_pid {
                screen_pid = 0
                screen_check(screen_base)
              }
            }
            if peek64(pending_flag) == 1 {
              if peek64(pending_target) == pid {
                poke64(pending_flag, 0)
                gate_reply(peek64(pending_waiter), code)
              }
            }
          }
        }
      }
    }
  }
}

// A 32-bit MMIO write (T7.1): `poke32` — the byte lane cannot compose
// one (each byte offset is its own register access, and unmapped
// offsets fault the device, the trace proved it), and a 64-bit poke
// would touch the neighbor register. The address pairs
// (Desc/Avail/Used Low then High) are the exception: both halves are
// plain address registers, one 64-bit poke each, ascending.
def mmio32(a Int64, v Int64) Void {
  poke32(a, v)
}

def mmio32r(a Int64) Int64 {
  return peek32(a)
}

// A little-endian 16-bit read of queue memory, two bytes — the rings'
// indices are u16.
def peek16r(a Int64) Int64 {
  return peek8(a).to_int64() + (peek8(a + 1).to_int64() << 8)
}

def blk_zero(a Int64, words Int64) Void {
  var i = 0
  while i < words {
    poke64(a + i * 8, 0)
    i = i + 1
  }
}

// One request through the queue (T7.1): the header (type, sector), the
// three chained descriptors — header device-read, data (WRITE for a
// read: the device fills it), status device-written — the avail ring's
// index, the doorbell after a fence, and the polled completion. The
// header and the status ride the queue block; the data descriptor
// names the client's buffer (T7.2) — `buf` is its kernel address, one
// contiguous range the client answers for (the filesystem's cache
// block, the DMA discipline T6.5 pinned) and the device sees its
// physical address. One request at a time — the serial service's
// discipline, descriptors 0..2 reused. Op 3 writes the sector from
// the buffer, op 4 reads it into the buffer; the answer is the sector
// number, the echo the client checks.
def blk_submit(dev Int64, q Int64, op Int64, sector Int64, buf Int64) Int64 {
  var hdr = q + 0x3000
  var stat = q + 0x3400
  var ty = 0
  if op == 3 {
    ty = 1
  }
  poke64(hdr, ty)
  poke64(hdr + 8, sector)
  poke8(stat, 255B)
  var dflags = 1
  if ty == 0 {
    dflags = 3
  }
  poke64(q, sv39.pa_of(hdr))
  poke64(q + 8, 16 | (1 << 32) | (1 << 48))
  poke64(q + 16, sv39.pa_of(buf))
  poke64(q + 24, 512 | (dflags << 32) | (2 << 48))
  poke64(q + 32, sv39.pa_of(stat))
  poke64(q + 40, 1 | (2 << 32))
  var avail = q + 0x1000
  var nidx = peek16r(avail + 2) + 1
  poke64(avail, nidx << 16)
  fence()
  mmio32(dev + 0x050, 0)
  var used = q + 0x2000
  var spins = 0
  var seen = peek16r(used + 2)
  while seen != nidx {
    spins = spins + 1
    if spins > 10000000 {
      println("blk: the device never answered")
      halt()
    }
    seen = peek16r(used + 2)
  }
  if peek8(stat).to_int64() != 0 {
    println("blk: the device refused the request")
    halt()
  }
  return sector
}

// The block device's driver (T7.1), a process like the services: it
// owns the queue — one 64 KiB block from the frame allocator, held for
// the service's life like the services' arenas — and answers requests
// from its mailbox. A request is a tuple (T7.2): the word packs
// op << 32 | sector (3 write a sector from a buffer, 4 read a sector
// into a buffer, 5 the capacity), the requester's Pid rides beside it
// — the reply goes to the requester, whoever it is — and the third
// element is the buffer's kernel address. T7.1's word-in-a-sector
// self-test is retired: the filesystem's mount is the sector proof
// now, and a self-test that wrote into the name table's sectors would
// be the corruption it was meant to rule out. The completion wait is
// the console's pre-interrupt poll (T3.5's shape): the
// interrupt-driven wait needs a park that checks a condition cell
// inside the scheduler's masked region, a runtime piece a later
// consumer earns; the poll is bounded, and the loud end answers a
// silent device.
def blk_service(boss Pid) Void {
  // The slot scan: a transport answers with the magic and the version
  // whether or not a device rides it; a block device is DeviceID 2.
  var dev = 0
  var slot = 0
  while slot < 8 {
    var cand = virtio_base + slot * 0x1000
    if peek64(cand) == 0x274726976 {
      if (peek64(cand + 8) & 0xFFFFFFFF) == 2 {
        dev = cand
      }
    }
    slot = slot + 1
  }
  if dev == 0 {
    println("blk: no block device on the virtio buses")
    halt()
  }
  var q = frames.take()
  if q == 0 {
    println("blk: no block for the queue")
    halt()
  }
  blk_zero(q, 16)
  blk_zero(q + 0x1000, 3)
  blk_zero(q + 0x2000, 9)
  mmio32(dev + 0x070, 0)
  mmio32(dev + 0x070, 1)
  mmio32(dev + 0x070, 3)
  poke64(dev + 0x020, 1 << 32)
  poke64(dev + 0x020, (1 << 32) | 1)
  mmio32(dev + 0x070, 11)
  if (mmio32r(dev + 0x070) & 8) == 0 {
    println("blk: the device refused our features")
    halt()
  }
  mmio32(dev + 0x030, 0)
  if mmio32r(dev + 0x034) < 8 {
    println("blk: the queue is too small")
    halt()
  }
  mmio32(dev + 0x038, 8)
  poke64(dev + 0x080, sv39.pa_of(q))
  poke64(dev + 0x090, sv39.pa_of(q + 0x1000))
  poke64(dev + 0x0a0, sv39.pa_of(q + 0x2000))
  mmio32(dev + 0x044, 1)
  mmio32(dev + 0x070, 15)
  var cap = peek64(dev + 0x100)
  println("blk ${cap} ready")
  boss <- self_pid()
  var from = boss
  while true {
    var w = 0
    var d = 0
    receive {
      (x, f, y) -> {
        w = x
        from = f
        d = y
      }
    }
    var op = w >> 32
    var sector = w & 0xFFFFFFFF
    if op == 5 {
      from <- cap
    } else {
      from <- blk_submit(dev, q, op, sector, d)
    }
  }
}

// The display's driver (T8.1), a process like the block driver: it owns
// the virtio-gpu's control queue — one 64 KiB block from the frame
// allocator, held for the service's life — and speaks the 2D path, the
// whole need at M7: create the resource, attach the screen carve as its
// backing, point scanout 0 at it, and (on request) transfer the painted
// pixels to the host and flush them to the display. The queue is the
// blk_service's shape: descriptors 0..1 reused, one command in flight,
// the doorbell after a fence, the completion polled and bounded — the
// interrupt-driven wait is the later piece the console's T3.7 note
// names, and the GPU's IRQ stays unwired. The mode is never a constant:
// GET_DISPLAY_INFO's answer is the real one (the protocol's second
// seam), and the resource, the scanout, and the flush all take its
// rectangle. The mailbox: op 0 flushes (the whole rect, transfer then
// flush, the request word echoed back), op 1 answers the mode packed —
// the output_info verb's kernel side will ride it (T8.4) — and an op
// the driver does not serve comes back negated; any OK the device
// refuses is the loud end.
def gpu_hdr(a Int64, ty Int64) Void {
  poke32(a, ty)
  poke32(a + 4, 0)
  poke64(a + 8, 0)
  poke64(a + 16, 0)
}

def gpu_rect(a Int64, x Int64, y Int64, w Int64, h Int64) Void {
  poke32(a, x)
  poke32(a + 4, y)
  poke32(a + 8, w)
  poke32(a + 12, h)
}

// One command through the control queue: the request at +0x3000 is one
// descriptor (device-read), the 512-byte response buffer at +0x3400 the
// second (device-written — the display info's response is 408 bytes,
// the largest the protocol answers, and every command may offer the
// whole of it); the avail index, the doorbell, the bounded poll of the
// used index, and the response's type word back. The type is the
// caller's to judge — OK_NODATA (0x1100) for the setup and flush
// commands, OK_DISPLAY_INFO (0x1101) for the display info.
def gpu_submit(dev Int64, q Int64, req_len Int64) Int64 {
  poke64(q, sv39.pa_of(q + 0x3000))
  poke64(q + 8, req_len | (1 << 32) | (1 << 48))
  poke64(q + 16, sv39.pa_of(q + 0x3400))
  poke64(q + 24, 512 | (2 << 32))
  var avail = q + 0x1000
  var nidx = peek16r(avail + 2) + 1
  poke64(avail, nidx << 16)
  fence()
  mmio32(dev + 0x050, 0)
  var used = q + 0x2000
  var spins = 0
  var seen = peek16r(used + 2)
  while seen != nidx {
    spins = spins + 1
    if spins > 10000000 {
      println("gpu: the device never answered")
      halt()
    }
    seen = peek16r(used + 2)
  }
  return peek32(q + 0x3400)
}

// The flush smoke's paint (T8.1): the framebuffer's rows, a
// deterministic gradient — one color per row, both pixels of every
// 8-byte pair the same — written through the kernel's high alias of
// the carve. A fully typed native body over raw words: zero
// allocation, the frame's scale priced at word stores (the
// assessment's blit rule — a bytewise copy cannot survive TCG).
def gpu_paint(base Int64, rows Int64, row_words Int64) Void {
  var r = 0
  while r < rows {
    var c = 0xFF000000 | (((r * 5) & 255) << 16) | (((r * 3) & 255) << 8) | 64
    var word = c | (c << 32)
    var w = 0
    while w < row_words {
      poke64(base + (r * row_words + w) * 8, word)
      w = w + 1
    }
    r = r + 1
  }
}

// The mode answer's halves (T8.1): the width rides the op half, the
// height the caller half — one packed word, decoded by typed defs like
// every mailbox word (the riscv64 emitter refuses the operators on a
// dynamic value, T7.2's discipline).
def gpu_width(w Int64) Int64 {
  return w >> 32
}

def gpu_height(w Int64) Int64 {
  return w & 4294967295
}

// The atomic commit (T8.4): the damage rect's transfer to the host
// resource, then the flush to the display — the two device commands
// complete before the answer, so a frame lands whole or the machine
// ends loudly; the scanout shows the old frame until the flush's own
// completion. The rect is the mode's to judge: outside it, or empty,
// is the argument refusal the caller's stub names.
def gpu_present(dev Int64, q Int64, gw Int64, gh Int64, x Int64, y Int64, w Int64, h Int64) Int64 {
  if x < 0 || y < 0 || w < 1 || h < 1 {
    return -4
  }
  if (x + w) > gw || (y + h) > gh {
    return -4
  }
  gpu_hdr(q + 0x3000, 0x0105)
  gpu_rect(q + 0x3018, x, y, w, h)
  poke64(q + 0x3028, 0)
  poke32(q + 0x3030, 1)
  if gpu_submit(dev, q, 56) != 0x1100 {
    println("gpu: the transfer refused")
    halt()
  }
  gpu_hdr(q + 0x3000, 0x0104)
  gpu_rect(q + 0x3018, x, y, w, h)
  poke32(q + 0x3028, 1)
  if gpu_submit(dev, q, 48) != 0x1100 {
    println("gpu: the flush refused")
    halt()
  }
  return 0
}

// The grant table's first free row, or 0 (T8.5) — the id word's zero
// is a free row's mark.
def grant_row_pick() Int64 {
  var i = 0
  while i < 8 {
    var row = grant_table + (i * 96)
    if peek64(row) == 0 {
      return row
    }
    i = i + 1
  }
  return 0
}

// The grant table's row for that id, or 0 (T8.5) — the window
// present's ready record and the close's release both find it here.
def grant_row_of(id Int64) Int64 {
  var i = 0
  while i < 8 {
    var row = grant_table + (i * 96)
    if peek64(row) == id {
      return row
    }
    i = i + 1
  }
  return 0
}

def gpu_service(boss Pid) Void {
  // The slot scan: a transport answers with the magic and the version
  // whether or not a device rides it; the display device is DeviceID 16.
  var dev = 0
  var slot = 0
  while slot < 8 {
    var cand = virtio_base + slot * 0x1000
    if peek64(cand) == 0x274726976 {
      if (peek64(cand + 8) & 0xFFFFFFFF) == 16 {
        dev = cand
      }
    }
    slot = slot + 1
  }
  if dev == 0 {
    println("gpu: no display device on the virtio buses")
    halt()
  }
  var q = frames.take()
  if q == 0 {
    println("gpu: no block for the queue")
    halt()
  }
  blk_zero(q, 16)
  blk_zero(q + 0x1000, 3)
  blk_zero(q + 0x2000, 9)
  blk_zero(q + 0x3000, 16)
  blk_zero(q + 0x3400, 64)
  mmio32(dev + 0x070, 0)
  mmio32(dev + 0x070, 1)
  mmio32(dev + 0x070, 3)
  // The features: VIRTIO_F_VERSION_1 alone, offered through the sel
  // register the 64-bit poke rides (T7.1's byte-composition note) —
  // no VIRGL, no EDID: the 2D path needs neither.
  poke64(dev + 0x020, 1 << 32)
  poke64(dev + 0x020, (1 << 32) | 1)
  mmio32(dev + 0x070, 11)
  if (mmio32r(dev + 0x070) & 8) == 0 {
    println("gpu: the device refused our features")
    halt()
  }
  mmio32(dev + 0x030, 0)
  if mmio32r(dev + 0x034) < 8 {
    println("gpu: the queue is too small")
    halt()
  }
  mmio32(dev + 0x038, 8)
  poke64(dev + 0x080, sv39.pa_of(q))
  poke64(dev + 0x090, sv39.pa_of(q + 0x1000))
  poke64(dev + 0x0a0, sv39.pa_of(q + 0x2000))
  mmio32(dev + 0x044, 1)
  mmio32(dev + 0x070, 15)
  // The mode is the device's answer, not a constant (the protocol's
  // second seam): the display info's response is the header plus one
  // pmode per scanout — rect first, the enabled flag after — and
  // scanout 0's rectangle is what the resource, the scanout, and every
  // flush take.
  gpu_hdr(q + 0x3000, 0x0100)
  if gpu_submit(dev, q, 24) != 0x1101 {
    println("gpu: the display info refused")
    halt()
  }
  var pmode = peek32(q + 0x3400 + 40)
  if pmode != 1 {
    println("gpu: no enabled display")
    halt()
  }
  var gw = peek32(q + 0x3400 + 32)
  var gh = peek32(q + 0x3400 + 36)
  // RESOURCE_CREATE_2D (40 bytes): the resource is the baseline's
  // format at the display's size. Every payload starts at +0x18, the
  // header's 24 bytes behind it.
  gpu_hdr(q + 0x3000, 0x0101)
  poke32(q + 0x3018, 1)
  poke32(q + 0x301c, gpu_format_bgrx)
  poke32(q + 0x3020, gw)
  poke32(q + 0x3024, gh)
  if gpu_submit(dev, q, 40) != 0x1100 {
    println("gpu: the resource refused")
    halt()
  }
  // RESOURCE_ATTACH_BACKING (32 bytes plus one 16-byte entry): the
  // screen carve, physical, the whole 4 MiB the transfers read from
  // (T6.5's DMA discipline: one contiguous range the allocator's
  // exclusion keeps so).
  gpu_hdr(q + 0x3000, 0x0106)
  poke32(q + 0x3018, 1)
  poke32(q + 0x301c, 1)
  poke64(q + 0x3020, screen_base)
  poke64(q + 0x3028, screen_size)
  if gpu_submit(dev, q, 48) != 0x1100 {
    println("gpu: the backing refused")
    halt()
  }
  // SET_SCANOUT (48 bytes): scanout 0 shows the resource at the
  // display's rect — the rect comes first, the two ids after it.
  gpu_hdr(q + 0x3000, 0x0103)
  gpu_rect(q + 0x3018, 0, 0, gw, gh)
  poke32(q + 0x3028, 0)
  poke32(q + 0x302c, 1)
  if gpu_submit(dev, q, 48) != 0x1100 {
    println("gpu: the scanout refused")
    halt()
  }
  println("gpu ${gw}x${gh} ready")
  // The grant table's reset (T8.5): the rows and the id counter start
  // empty — the service's own init, before any client can ask.
  blk_zero(grant_table, 96)
  poke64(grant_next_cell, 0)
  boss <- self_pid()
  while true {
    receive {
      (a, b, c) -> {
        // The kernel's own mailbox (the boot smoke's protocol): op 0
        // the whole-screen flush, op 1 the mode packed. The bindings
        // are tagged words — the stores into these typed locals are
        // the conversion (T7.2's lesson), which lets the typed op_of
        // see the raw payload instead of a pointer; the sender rides
        // a Pid local the same way.
        var aw = 0
        var from = boss
        aw = a
        from = b
        var op = op_of(aw)
        if op == 0 {
          var v = gpu_present(dev, q, gw, gh, 0, 0, gw, gh)
          if v == 0 {
            from <- aw
          } else {
            from <- v
          }
        } else {
          if op == 1 {
            from <- (gw << 32) | gh
          } else {
            from <- 0 - aw
          }
        }
      }
      w -> {
        // The gate's posts (T8.4, T8.5): verb 10 present — the
        // fullscreen commit is the device's (the rect the mode's to
        // judge), a window's commit is the ready flag and the damage
        // rect the compositor finds on its tick (T8.6); verb 11
        // output_info, the mode packed; verb 13 win_new, the run and
        // the row and the mapping; verb 14 win_close, the release.
        // The gate has checked every grant's owner; the table here is
        // the record those checks read.
        var op = op_of(w)
        if op == 10 {
          var grant = peek64(gpu_args)
          if grant == 0 {
            var v = gpu_present(dev, q, gw, gh, peek64(gpu_args + 8), peek64(gpu_args + 16), peek64(gpu_args + 24), peek64(gpu_args + 32))
            gate_reply(caller_of(w), v)
          } else {
            var row = grant_row_of(grant)
            if row == 0 {
              gate_reply(caller_of(w), -4)
            } else {
              poke64(row + 56, 1)
              poke64(row + 64, peek64(gpu_args + 8))
              poke64(row + 72, peek64(gpu_args + 16))
              poke64(row + 80, peek64(gpu_args + 24))
              poke64(row + 88, peek64(gpu_args + 32))
              gate_reply(caller_of(w), 0)
            }
          }
        } else {
          if op == 11 {
            gate_reply(caller_of(w), (gw << 32) | gh)
          } else {
            if op == 13 {
              // win_new (T8.5): the run the allocator hands, the row
              // the table gains, the mapping into the caller's own
              // table — the space word the shim staged. The answer
              // packs the buffer's base (the physical, the identity
              // the client paints) above the grant id.
              var ww = peek64(gpu_args)
              var hh = peek64(gpu_args + 8)
              var n = ((ww * hh * 4) + block - 1) / block
              var base = frames.take_run(n)
              if base == 0 {
                gate_reply(caller_of(w), -5)
              } else {
                var row = grant_row_pick()
                if row == 0 {
                  var i = 0
                  while i < n {
                    frames.give(base + (i * block))
                    i = i + 1
                  }
                  gate_reply(caller_of(w), -5)
                } else {
                  space.map_run(peek64(gpu_args + 40), sv39.pa_of(base), n * block)
                  var id = peek64(grant_next_cell) + 1
                  poke64(grant_next_cell, id)
                  poke64(row, id)
                  poke64(row + 8, caller_of(w))
                  poke64(row + 16, base)
                  poke64(row + 24, n)
                  poke64(row + 32, ww)
                  poke64(row + 40, hh)
                  poke64(row + 56, 0)
                  // The answer's packing keeps the sign bit true: the
                  // base rides as its frame number (the byte address
                  // shifted left by 12 at the client) — a base above
                  // 0x7fffffff would sign-extend the word otherwise,
                  // and the stub would read the grant as a refusal.
                  gate_reply(caller_of(w), ((sv39.pa_of(base) >> 12) << 32) | id)
                }
              }
            } else {
              if op == 14 {
                // win_close (T8.5): the run back to the allocator
                // block by block, the row to the table — the owner is
                // the gate's check.
                var row = grant_row_of(peek64(gpu_args))
                if row == 0 {
                  gate_reply(caller_of(w), -4)
                } else {
                  var base = peek64(row + 16)
                  var n = peek64(row + 24)
                  var i = 0
                  while i < n {
                    frames.give(base + (i * block))
                    i = i + 1
                  }
                  blk_zero(row, 12)
                  gate_reply(caller_of(w), 0)
                }
              } else {
                println("gpu: the verb is nobody's")
                halt()
              }
            }
          }
        }
      }
    }
  }
}

// The input service (T8.3): the machine's input, one process — the
// virtio-input device's event stream (DeviceID 18) merged with the
// serial console's bytes. The UART's input ring (T3.7) is this
// service's to drain now: the read verb (gate verb 2) and the boot
// demo's bare-pid readers take the next byte from it, the device-wait
// park moving here with the ownership — the shim's wake (the runtime's
// emo_sched_wake_console, the name it booted with) wakes the first
// state-4 slot, and this service is the machine's one device-waiter.
// The input_read verb (verb 12) takes the next event of the merged
// stream: the bytes first, then the device's — the one order the two
// sources can name without a clock, and the rule docs/syscalls.md
// states. A byte event rides type 0x454D ("EM"), code 0, the byte in
// the value; a device event its own type, code, and value — the packed
// word (type << 48 | code << 32 | value) the ABI fixed. The device
// half: the eventq (queue 0) with sixteen 8-byte buffers pre-posted on
// one allocator block, the completion wired — the transport's PLIC IRQ
// parked in the shim's cell, the PLIC's priority and enable set — so
// the device's events wake the machine the serial's bytes do; the ISR's
// whole duty on that line is the wake (the eventq holds the events),
// and the drain recycles each buffer through the avail ring. The
// statusq (queue 1) is untouched — the pointer sprite's M8 piece.
def input_byte() Int64 {
  var got = 0
  var done = false
  while !done {
    if peek64(in_cons) != peek64(in_prod) {
      var cons = peek64(in_cons)
      got = peek8(in_ring + (cons % 128)).to_int64()
      poke64(in_cons, cons + 1)
      done = true
    } else {
      device_wait()
    }
  }
  return got
}

// One event from the device's used ring, or 0 when none is pending.
// The buffer's id names the descriptor the device filled; the event is
// read, the buffer recycled through the avail ring (the entry, then
// the index behind it, the fence and the doorbell after), and the
// packed word answered. The drain's cursors ride the queue block —
// the used index this service has consumed, the avail index the next
// recycled buffer takes — raw words, the untyped-memory discipline.
def eventq_take(dev Int64, q Int64) Int64 {
  var used = q + 0x2000
  var uidx = peek16r(used + 2)
  var handled = peek64(q + 0x3f00)
  if uidx == handled {
    return 0
  }
  var entry = used + 4 + ((handled % 16) * 8)
  var id = peek32(entry)
  var buf = q + 0x3000 + (id * 8)
  var ty = peek16r(buf)
  var code = peek16r(buf + 2)
  var value = peek32(buf + 4)
  var avail = q + 0x1000
  var nxt = peek64(q + 0x3f08)
  var at = avail + 4 + ((nxt % 16) * 2)
  poke8(at, (id & 255).to_byte())
  poke8(at + 1, ((id >> 8) & 255).to_byte())
  var after = nxt + 1
  poke8(avail + 2, (after & 255).to_byte())
  poke8(avail + 3, ((after >> 8) & 255).to_byte())
  poke64(q + 0x3f08, after)
  poke64(q + 0x3f00, handled + 1)
  fence()
  mmio32(dev + 0x050, 0)
  return (ty << 48) | (code << 32) | value
}

// The merged stream's next event: the serial's byte if the ring holds
// one (the byte event), else the device's next event, else the
// device-wait park — the wake is the UART's ISR or the input line's,
// either one lands.
def input_event(dev Int64, q Int64) Int64 {
  var got = 0
  var done = false
  while !done {
    if peek64(in_cons) != peek64(in_prod) {
      var cons = peek64(in_cons)
      var b = peek8(in_ring + (cons % 128)).to_int64()
      poke64(in_cons, cons + 1)
      got = (0x454D << 48) | b
      done = true
    } else {
      var e = eventq_take(dev, q)
      if e != 0 {
        got = e
        done = true
      } else {
        device_wait()
      }
    }
  }
  return got
}

def input_service(boss Pid) Void {
  // The slot scan: the input device is DeviceID 18.
  var dev = 0
  var dev_slot = 0
  var slot = 0
  while slot < 8 {
    var cand = virtio_base + slot * 0x1000
    if peek64(cand) == 0x274726976 {
      if (peek64(cand + 8) & 0xFFFFFFFF) == 18 {
        dev = cand
        dev_slot = slot
      }
    }
    slot = slot + 1
  }
  if dev == 0 {
    println("input: no input device on the virtio buses")
    halt()
  }
  var q = frames.take()
  if q == 0 {
    println("input: no block for the queue")
    halt()
  }
  blk_zero(q, 32)
  blk_zero(q + 0x1000, 5)
  blk_zero(q + 0x2000, 17)
  mmio32(dev + 0x070, 0)
  mmio32(dev + 0x070, 1)
  mmio32(dev + 0x070, 3)
  poke64(dev + 0x020, 1 << 32)
  poke64(dev + 0x020, (1 << 32) | 1)
  mmio32(dev + 0x070, 11)
  if (mmio32r(dev + 0x070) & 8) == 0 {
    println("input: the device refused our features")
    halt()
  }
  mmio32(dev + 0x030, 0)
  if mmio32r(dev + 0x034) < 16 {
    println("input: the queue is too small")
    halt()
  }
  mmio32(dev + 0x038, 16)
  poke64(dev + 0x080, sv39.pa_of(q))
  poke64(dev + 0x090, sv39.pa_of(q + 0x1000))
  poke64(dev + 0x0a0, sv39.pa_of(q + 0x2000))
  mmio32(dev + 0x044, 1)
  mmio32(dev + 0x070, 15)
  // Sixteen 8-byte event buffers, one descriptor each (device-written,
  // no next), pre-posted on the avail ring after DRIVER_OK: the
  // entries, the fence, the index behind them, the doorbell. When
  // every buffer is out and the device has another event, the event
  // is the drop — the drain keeps the ring fed.
  var i = 0
  while i < 16 {
    poke64(q + (i * 16), sv39.pa_of(q + 0x3000 + (i * 8)))
    poke64(q + (i * 16) + 8, 8 | (2 << 32))
    i = i + 1
  }
  i = 0
  while i < 4 {
    poke64(q + 0x1004 + (i * 8), (i * 4) | ((i * 4 + 1) << 16) | ((i * 4 + 2) << 32) | ((i * 4 + 3) << 48))
    i = i + 1
  }
  fence()
  poke8(q + 0x1002, 16B)
  poke8(q + 0x1003, 0B)
  fence()
  mmio32(dev + 0x050, 0)
  // The drain's cursors: the used index this service has consumed, the
  // avail index the next recycled buffer takes.
  poke64(q + 0x3f00, 0)
  poke64(q + 0x3f08, 16)
  // The device's line: the transport's PLIC IRQ into the shim's cell
  // first (0 = not wired, the loud end it always was), then the PLIC's
  // priority and the enable bit — the enable a read-modify-write, the
  // UART's bit already set.
  var irq = dev_slot + 1
  poke64(input_irq_cell, irq)
  poke32(plic + (irq * 4), 1)
  poke32(plic_enable, peek32(plic_enable) | (1 << irq))
  println("input ready")
  boss <- self_pid()
  while true {
    receive {
      w -> {
        var op = op_of(w)
        if op == 2 {
          gate_reply(caller_of(w), input_byte())
        } else {
          if op == 12 {
            gate_reply(caller_of(w), input_event(dev, q))
          } else {
            w <- input_byte()
          }
        }
      }
    }
  }
}

// The supervisor (T7.2, docs/fs.md): the filesystem service's owner.
// It takes the service's cache block from the frame allocator once —
// the block outlives the instances, each one overwrites it from the
// disk and trusts nothing it held — spawns the service into it, parks
// the instance's pid in the cell the gate routes by, and forwards the
// Pid to the boss. The runtime's death hook tells it when an instance
// died (the notice's op is 256, a height no gate verb reaches, the
// dead pid beside it); the notice named the current instance, it
// refuses every client the dead one left parked (fs.abandon), spawns
// the next, and forwards the new Pid. The pid cell is zero between
// the death and the parking — the death notice cleared it inside the
// death's own masked region — and the gate sets aside what arrives in
// the gap, into the stash the next instance serves first.
// The compositor (T8.6): the window stack's owner and the machine's
// compositor — the fs.emo lineage, a service process whose state
// outlives its instances (the pages the restart reads back), whose
// verbs are the stack's (win_focus, win_move) and whose composition
// is the blit: a window's frame carried into the carve at the stack's
// position, word stores, and the display service's flush putting it
// on the display. The window present's composition request rides the
// route the gate's verb-10 window path answers; the answer follows
// the flush, the frame landing whole (the protocol's sixth seam).

// The stack's entry for that grant, or 0 — the position the blit
// places the window at, created at the first present.
def comp_stack_find(grant Int64) Int64 {
  var i = 0
  while i < 8 {
    var entry = comp_stack + (i * 24)
    if peek64(entry) == grant {
      return entry
    }
    i = i + 1
  }
  return 0
}

def comp_stack_add(grant Int64) Int64 {
  var top = peek64(comp_top_cell)
  if top >= 8 {
    println("comp: the stack is full")
    halt()
  }
  var entry = comp_stack + (top * 24)
  poke64(entry, grant)
  poke64(entry + 8, 0)
  poke64(entry + 16, 0)
  poke64(comp_top_cell, top + 1)
  return entry
}

// The blit (T8.6): the window's rows into the carve at the stack's
// position — word stores, the frame's scale priced at them (the
// assessment's blit rule); the sum of the carried words answered, the
// number the client's own sum line names — the blit's proof.
def comp_blit(base Int64, w Int64, h Int64, x Int64, y Int64) Int64 {
  var sum = 0
  var r = 0
  var half = w / 2
  var stride = peek64(comp_mode_w) / 2
  while r < h {
    var i = 0
    while i < half {
      var v = peek64(base + (r * half + i) * 8)
      poke64(koff + screen_base + ((y + r) * stride + (x / 2) + i) * 8, v)
      sum = sum + v
      i = i + 1
    }
    r = r + 1
  }
  return sum
}

// The composition's stash (T8.6): the requests that arrive while the
// display service's flush is in flight, served after it — the fs's
// stash discipline; four deep, more is a kernel bug (nobody's era
// holds four window presents inside one flush).
const comp_stash_count = comp_page + 320
const comp_stash_cells = comp_page + 328

def comp_stash_push(w Int64) Void {
  var n = peek64(comp_stash_count)
  if n >= 4 {
    println("comp: the stash is full")
    halt()
  }
  poke64(comp_stash_cells + (n * 8), w)
  poke64(comp_stash_count, n + 1)
}

def comp_stash_pop() Int64 {
  var n = peek64(comp_stash_count)
  if n == 0 {
    return 0
  }
  var w = peek64(comp_stash_cells + ((n - 1) * 8))
  poke64(comp_stash_count, n - 1)
  return w
}

// The dead owner's windows (T8.5's stated bound's payoff): the runs
// back to the allocator, the rows to the table — the death notice's
// other half, the supervisor's to do.
def comp_reclaim(pid Int64) Void {
  var i = 0
  while i < 8 {
    var row = grant_table + (i * 96)
    if peek64(row + 8) == pid {
      var base = peek64(row + 16)
      var n = peek64(row + 24)
      var j = 0
      while j < n {
        frames.give(base + (j * block))
        j = j + 1
      }
      blk_zero(row, 12)
    }
    i = i + 1
  }
}

// The compositor's word handling (T8.6): the stack's verbs (15 focus,
// 16 move) and the composition requests (op 17, the route the window
// present answers). The composition: the stack's position, the blit,
// the display service's flush — the gate's words that arrive while it
// is in flight stashed and served after (the stop's tuples do not
// race the flush: the loud end names one) — the row's ready flag and
// damage rect recorded, and the answer after the flush: the frame
// lands whole (the protocol's sixth seam).
def comp_word(w Int64, gpu Pid, me Pid) Void {
  var op = op_of(w)
  if op == 15 {
    poke64(comp_focus_cell, peek64(comp_args))
    gate_reply(caller_of(w), 0)
  } else {
    if op == 16 {
      var grant = peek64(comp_args)
      var entry = comp_stack_find(grant)
      if entry == 0 {
        entry = comp_stack_add(grant)
      }
      var x = peek64(comp_args + 8)
      var y = peek64(comp_args + 16)
      var row = grant_row_of(grant)
      var ww = peek64(row + 32)
      var hh = peek64(row + 40)
      if (x % 2) != 0 || (x + ww) > peek64(comp_mode_w) || (y + hh) > peek64(comp_mode_h) {
        gate_reply(caller_of(w), -4)
      } else {
        poke64(entry + 8, x)
        poke64(entry + 16, y)
        gate_reply(caller_of(w), 0)
      }
    } else {
      if op == 17 {
        var grant = peek64(comp_args)
        var entry = comp_stack_find(grant)
        if entry == 0 {
          entry = comp_stack_add(grant)
        }
        var row = grant_row_of(grant)
        var base = peek64(row + 16)
        var ww = peek64(row + 32)
        var hh = peek64(row + 40)
        var x = peek64(entry + 8)
        var y = peek64(entry + 16)
        var sum = comp_blit(base, ww, hh, x, y)
        gpu <- (0, me, 0)
        var flushed = false
        while !flushed {
          receive {
            r -> {
              if r == 0 {
                flushed = true
              } else {
                if op_of(r) >= 0 {
                  comp_stash_push(r)
                } else {
                  println("comp: the stop does not race the flush")
                  halt()
                }
              }
            }
          }
        }
        poke64(row + 56, 1)
        poke64(row + 64, peek64(comp_args + 8))
        poke64(row + 72, peek64(comp_args + 16))
        poke64(row + 80, peek64(comp_args + 24))
        poke64(row + 88, peek64(comp_args + 32))
        println("comp ${x} ${y} ${sum & 4294967295}")
        gate_reply(caller_of(w), 0)
      } else {
        println("comp: the verb is nobody's")
        halt()
      }
    }
  }
}

// The compositor's service (T8.6): the gen line (the pages outlive
// the instances — the restart reads back what the last one left and
// increments it), the display's mode queried once (never a constant —
// the protocol's second seam; the blit's stride and the move's bounds
// ride it), then the loop: the stash first (the flush's stragglers),
// the receive's dynamic binding decoding the kernel client's tuples
// (the stop) and handing the raw words to the word handling.
def comp_service(boss Pid, gpu Pid) Void {
  var me2 = self_pid()
  var gen = peek64(comp_gen_cell) + 1
  poke64(comp_gen_cell, gen)
  gpu <- (1 << 32, me2, 0)
  receive {
    m -> {
      var mw = 0
      mw = m
      poke64(comp_mode_w, op_of(mw))
      poke64(comp_mode_h, caller_of(mw))
    }
  }
  println("comp gen ${gen}")
  boss <- self_pid()
  var running = true
  while running {
    var w = comp_stash_pop()
    if w != 0 {
      comp_word(w, gpu, me2)
    } else {
      receive {
        x -> {
          if op_of(x) >= 0 {
            comp_word(x, gpu, me2)
          } else {
            var kop = 0
            case x {
              (a, b, c, d, e, f) -> { kop = a }
            }
            if kop == 0 {
              running = false
            } else {
              println("comp: the message is nobody's")
              halt()
            }
          }
        }
      }
    }
  }
}

def comp_run(boss Pid, gpu Pid) Void {
  comp_service(boss, gpu)
}

// The compositor's supervisor (T8.6): the filesystem supervisor's
// shape — the pages outlive the instances, the spawn, the death
// notice the shim's hook posts, the restart. Any other death's notice
// is the reclaim: the dead owner's windows go home.
def comp_supervisor(boss Pid, gpu Pid) Void {
  var me3 = self_pid()
  poke64(comp_sup_cell, pid_num(me3))
  do comp_run(me3, gpu)
  var inst = wait_pid()
  poke64(comp_svc_cell, pid_num(inst))
  boss <- inst
  while true {
    receive {
      w -> {
        if op_of(w) == notice_op {
          if caller_of(w) == pid_num(inst) {
            do comp_run(me3, gpu)
            inst = wait_pid()
            poke64(comp_svc_cell, pid_num(inst))
            boss <- inst
          }
        }
      }
    }
  }
}

def fs_run(boss Pid, blk Pid, cache Int64) Void {
  fs.service(boss, blk, cache)
}

// One Pid from the mailbox, raw words set aside: the supervisor's
// mailbox holds its instances' announces (a Pid, negative as every
// pointer is) and the death notices (a positive raw word); the loop
// runs until a Pid exists.
def wait_pid() Pid {
  var got = self_pid()
  var done = false
  while !done {
    receive {
      x -> {
        if op_of(x) < 0 {
          got = x
          done = true
        }
      }
    }
  }
  return got
}

def supervisor(boss Pid, blk Pid) Void {
  var me = self_pid()
  poke64(supervisor_cell, pid_num(me))
  var cache = frames.take()
  if cache == 0 {
    println("fs: no block for the cache")
    halt()
  }
  var fs_boss = me
  do fs_run(fs_boss, blk, cache)
  var inst = wait_pid()
  poke64(fs_pid_cell, pid_num(inst))
  boss <- inst
  while true {
    receive {
      w -> {
        if op_of(w) == notice_op {
          if caller_of(w) == pid_num(inst) {
            poke64(fs_pid_cell, 0)
            fs.abandon()
            do fs_run(fs_boss, blk, cache)
            inst = wait_pid()
            poke64(fs_pid_cell, pid_num(inst))
            boss <- inst
          }
        }
      }
    }
  }
}

// The kernel side of the filesystem (T7.2): a six-tuple per request —
// (op, from, name, name_len, buf, len) — the addresses kernel ones,
// the answer a message to `from`. The root uses it once at boot, to
// drive the restart the chain pins: a file written through the first
// instance, the stop (op 0, a death the supervisor restarts), the
// file read back through the instance the supervisor produced. The
// root's words and names live in a block of their own, given back
// when the proof is done.

def put_boot_name(a Int64) Void {
  poke8(a, 98B)      // b
  poke8(a + 1, 111B) // o
  poke8(a + 2, 111B) // o
  poke8(a + 3, 116B) // t
  poke8(a + 4, 46B)  // .
  poke8(a + 5, 116B) // t
  poke8(a + 6, 120B) // x
  poke8(a + 7, 116B) // t
}

def put_boot_text(a Int64) Int64 {
  poke8(a, 69B)      // E
  poke8(a + 1, 109B) // m
  poke8(a + 2, 111B) // o
  poke8(a + 3, 79B)  // O
  poke8(a + 4, 83B)  // S
  poke8(a + 5, 32B)  // space
  poke8(a + 6, 98B)  // b
  poke8(a + 7, 111B) // o
  poke8(a + 8, 111B) // o
  poke8(a + 9, 116B) // t
  poke8(a + 10, 115B) // s
  poke8(a + 11, 32B) // space
  poke8(a + 12, 102B) // f
  poke8(a + 13, 114B) // r
  poke8(a + 14, 111B) // o
  poke8(a + 15, 109B) // m
  poke8(a + 16, 32B) // space
  poke8(a + 17, 100B) // d
  poke8(a + 18, 105B) // i
  poke8(a + 19, 115B) // s
  poke8(a + 20, 107B) // k
  return 21
}

def same_bytes(a Int64, b Int64, n Int64) Bool {
  var i = 0
  while i < n {
    if peek8(a + i) != peek8(b + i) {
      return false
    }
    i = i + 1
  }
  return true
}

// A reader's byte: ask, then block on the answer. The request is a
// send, the wait an ordinary receive — the mailbox is the wait queue,
// and a byte delivered before the park is found by the scan.
def read_byte(console Pid) Int64 {

  console <- self_pid()
  var b = 0
  receive {
    got -> { b = got }
  }
  return b
}

def reader(console Pid, boss Pid, id Int64) Void {
  var b = read_byte(console)
  println("${id}:${b}")
  boss <- 1
}

// Ticks so far: everything the shim counted, captured or dropped.
def ticks() Int64 {
  return peek64(tick_ring) + peek64(tick_ring + 16)
}

// The tick's proof under load: a long raw computation — its checksum
// is the register-file pin, because the timer fires mid-loop over and
// over and any mis-restored register bends the sum.
def sweep(n Int64) Int64 {
  var sum = 0
  var i = 0
  while i < n {
    sum = sum + i
    i = i + 1
  }
  return sum
}

def tick_proof() Void {
  var t0 = ticks()
  println(sweep(100000000))
  println(ticks() > t0)
}

// The services come up first (T4.4): they answer the gate while a
// user program runs. Each announces its pid to the boss; the root
// consumes the announces before any console request goes out — a
// request answered by mailbox and a stray announce are the same shape
// to a receive — and parks the raw numbers into the handoff cells the
// shim posts by. The filesystem (T7.2) comes up through its
// supervisor, which forwards the service's Pid: the mount lines are
// on the wire before the root's first console request.
var me = self_pid()
var console_svc = me
var blk_svc = me
var gpu_svc = me
var input_svc = me
var comp_svc = me
var fs_svc = me
do console_service(me)
do process_service(me)
do blk_service(me)
do gpu_service(me)
do input_service(me)
uart_init()
println("Hello, EmoOS!")
sv39_report()
tick_proof()
receive { c1 -> {
  poke64(console_svc_cell, pid_num(c1))
  console_svc = c1
} }
receive { c2 -> { poke64(process_svc_cell, pid_num(c2)) } }
receive { c3 -> { blk_svc = c3 } }
receive { g1 -> {
  poke64(gpu_svc_cell, pid_num(g1))
  gpu_svc = g1
} }
receive { i1 -> {
  poke64(input_svc_cell, pid_num(i1))
  input_svc = i1
} }

// The display's flush smoke (T8.1): the root asks the driver for the
// mode (the answer that verb 11 will one day route), paints the
// framebuffer a deterministic row gradient through the kernel's high
// alias of the carve at the mode the device itself reported, then asks
// for the whole-rect transfer + flush — the device's two OK replies
// are the proof that the pipeline end to end took the paint: the
// device read the carve's physical bytes (attach_backing named it),
// copied them to the host resource, and put them on the display.
gpu_svc <- (1 << 32, me, 0)
var mode = 0
receive {
  m -> { mode = m }
}
gpu_paint(koff + screen_base, gpu_height(mode), gpu_width(mode) / 2)
gpu_svc <- (0, me, 0)
receive {
  g2 -> {
    if g2 != 0 {
      println("gpu: the flush answered ${g2}")
      halt()
    }
  }
}
println("gpu flush ok")

// The compositor comes up through its supervisor (T8.6): the fs
// lineage's shape — the spawn, the pages' generation, the death
// notice the restart answers.
do comp_supervisor(me, gpu_svc)
receive { n1 -> {
  poke64(comp_svc_cell, pid_num(n1))
  comp_svc = n1
} }

do supervisor(me, blk_svc)
receive { f1 -> { fs_svc = f1 } }
do reader(input_svc, me, 1)
do reader(input_svc, me, 2)
do reader(input_svc, me, 3)
do reader(input_svc, me, 4)
var root_b = read_byte(input_svc)
println("0:${root_b}")
receive { done1 -> {} }
receive { done2 -> {} }
receive { done3 -> {} }
receive { done4 -> {} }

// The restart proof (T7.2, docs/fs.md): a file written through the
// first instance of the filesystem service, the stop — a death the
// supervisor is told of by the runtime's death hook and answers with
// the next instance, whose mount line counts the file — and the file
// read back through that instance, byte for byte: the mount table
// found on the disk, the cache rebuilt from it. The root's words live
// in a block of their own, given back when the proof is done.
var scratch = frames.take()
if scratch == 0 {
  println("fs: no block for the proof")
  halt()
}
put_boot_name(scratch)
var boot_len = put_boot_text(scratch + 64)
fs_svc <- (6, me, scratch, 8, scratch + 64, boot_len)
receive {
  wrote -> {
    if wrote != boot_len {
      println("fs: the write answered ${wrote}, not ${boot_len}")
      halt()
    }
  }
}
fs_svc <- (0, me, 0, 0, 0, 0)
receive { f2 -> { fs_svc = f2 } }
fs_svc <- (7, me, scratch, 8, scratch + 1024, 2048)
receive {
  got -> {
    if got != boot_len {
      println("fs: the read answered ${got}, not ${boot_len}")
      halt()
    }
  }
}
if !same_bytes(scratch + 64, scratch + 1024, boot_len) {
  println("fs: the file came back wrong")
  halt()
}
frames.give(scratch)
println("fs restart ok")

// The compositor's restart proof (T8.6): the stop — a death the shim's
// hook tells the supervisor of, answered with the next instance and
// the pages' generation one higher — the state the restart reads
// back, the fs's cache-rebuild analog.
comp_svc <- (0, me, 0, 0, 0, 0)
receive { n2 -> {
  poke64(comp_svc_cell, pid_num(n2))
  comp_svc = n2
} }

// The kernel's program is done: stage the user image (T4.1). The boot
// stub reads the staged entry once this returns, srets into U-mode,
// and the user program runs — its own greeting is the proof on the
// serial line. A refusal already said why; the entry word stays zero
// and the stub powers the machine off. The screen token's cell (T8.2)
// and the carve grant's entry (T8.4) are established before the image
// runs: the machine starts with the token unpoked and the grant held
// by nobody.
poke64(screen_cell, 0)
poke64(screen_grant_cell, 0)
var staged = user.stage()
if staged > 0 {
  println("user: staged ${staged}")
}
