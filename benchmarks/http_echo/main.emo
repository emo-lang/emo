// HTTP echo server: a process per connection over the compiled net
// stack — the load-test target. Writes its port to argv file? Emo has
// no argv; the harness reads the first stdout line.
require "httpd"
require "net"

const (R.ok, listener) = net.listen("127.0.0.1", 0)
println(listener.port())

const server = httpd.serve(listener) -> (req httpd.Request) {
  return httpd.response(200, [], "ok")
}

receive {
  _ then { return 0 }
}
