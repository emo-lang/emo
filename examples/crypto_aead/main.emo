require "crypto"

// ChaCha20-Poly1305 (RFC 8439): the keystream, the stream cipher, the
// Poly1305 MAC, and the AEAD pair — each line pinned against the
// value the RFC's own test vectors and the Python reference answer.
// The forgeries — a flipped ciphertext byte, a wrong AAD, a
// truncated box — all meet the same answer.

def seq(n Int64, start Int64) Bytes {
  const b = Bytes.new(n)
  var i = 0
  while i < n {
    b.set(i, (start + i) & 0xFF)
    i = i + 1
  }
  return b
}

def zeros(n Int64) Bytes {
  return Bytes.new(n)
}

def from_hex(text String) Bytes {
  case crypto.hex_decode(text) {
    (R.ok, v) -> { return v }
    (R.error, why) -> { println(why) }
  }
  return Bytes.new(0)
}

def set_byte(b Bytes, i Int64, v Int64) Void {
  b.set(i, v)
}

def get_byte(b Bytes, i Int64) Int64 {
  return b.get(i)
}

def sub(src Bytes, at Int64, count Int64) Bytes {
  const out = Bytes.new(count)
  var i = 0
  while i < count {
    out.set(i, src.get(at + i))
    i = i + 1
  }
  return out
}

const key = seq(32, 0)
const nonce09 = from_hex("000000090000004a00000000")
const nonce4a = from_hex("000000000000004a00000000")
const msg = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.".to_bytes()

// ---- the keystream block (§2.3.2's counter-1 block, via the XOR of
// zeros) and the stream cipher over the §2.4.2 plaintext.
println("block: " + crypto.hex_encode(crypto.cipher.chacha20(key, nonce09, 1, zeros(64))))
println("stream 2.4.2: " + crypto.hex_encode(crypto.cipher.chacha20(key, nonce4a, 1, msg)))

// ---- the one-shot MAC (§2.5.2)
println("poly 2.5.2: " + crypto.hex_encode(crypto.cipher.poly1305(from_hex("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b"), "Cryptographic Forum Research Group".to_bytes())))

// ---- the AEAD pair (§2.8.2): the seal, the open, and the forgeries.
const k3 = seq(32, 0x80)
const n3 = from_hex("070000004041424344454647")
const aad3 = from_hex("50515253c0c1c2c3c4c5c6c7")
const sealed = crypto.cipher.chacha20_poly1305_seal(k3, n3, msg, aad3)
println("seal 2.8.2: " + crypto.hex_encode(sealed))
case crypto.cipher.chacha20_poly1305_open(k3, n3, sealed, aad3) {
  (R.ok, pt) -> { println("open 2.8.2: " + pt.to_string()) }
  (R.error, why) -> { println(why) }
}
const tampered = seq(sealed.length(), 0)
var ti = 0
while ti < sealed.length() {
  set_byte(tampered, ti, get_byte(sealed, ti))
  ti = ti + 1
}
set_byte(tampered, 0, get_byte(sealed, 0) ^ 1)
case crypto.cipher.chacha20_poly1305_open(k3, n3, tampered, aad3) {
  (R.ok, _) -> { println("tamper: UNEXPECTED OK") }
  (R.error, why) -> { println("tamper: " + why) }
}
case crypto.cipher.chacha20_poly1305_open(k3, n3, sealed, from_hex("50515253c0c1c2c3c4c5c6c8")) {
  (R.ok, _) -> { println("wrong aad: UNEXPECTED OK") }
  (R.error, why) -> { println("wrong aad: " + why) }
}
case crypto.cipher.chacha20_poly1305_open(k3, n3, sub(sealed, 0, 15), aad3) {
  (R.ok, _) -> { println("truncated: UNEXPECTED OK") }
  (R.error, why) -> { println("truncated: " + why) }
}

// ---- the sizes around the block and pad16 boundaries, each sealed
// and opened back (the Go-companion panel rides the same labels).
const sizes = [0, 1, 15, 16, 17, 63, 64, 65, 128]
const aad_sizes = [0, 15, 16, 17]
for var s = 0; s < 9; s = s + 1 {
  const aad_at = s % 4
  const pt = seq(sizes[s], 0x40)
  const aad = seq(aad_sizes[aad_at], 0xa0)
  const box = crypto.cipher.chacha20_poly1305_seal(k3, n3, pt, aad)
  println("seal " + sizes[s].to_string() + "/" + aad_sizes[aad_at].to_string() + ": " + crypto.hex_encode(box))
  case crypto.cipher.chacha20_poly1305_open(k3, n3, box, aad) {
    (R.ok, back) -> {
      if crypto.constant_time_compare(back, pt) {
        println("open " + sizes[s].to_string() + "/" + aad_sizes[aad_at].to_string() + ": ok")
      } else {
        println("open " + sizes[s].to_string() + "/" + aad_sizes[aad_at].to_string() + ": MISMATCH")
      }
    }
    (R.error, why) -> { println(why) }
  }
}

// ---- the empty box's tag, an input of its own
println("empty: " + crypto.hex_encode(crypto.cipher.chacha20_poly1305_seal(k3, n3, Bytes.new(0), Bytes.new(0))))
