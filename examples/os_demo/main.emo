require "os"

// The os package end to end: raw unbuffered file IO through fds, a
// directory listing with create/list/rename/remove, and a fork child
// passing bytes through a pipe before exiting with a status the parent
// decodes. Paths carry the process id so repeated and concurrent runs
// never collide; every path the demo creates is removed before exit.

// ---- raw file IO ----
const path = "os-demo-" + os.getpid().to_string() + ".tmp"
const (R.ok, fd) = os.open_write(path)
os.write(fd, "hello fd")
os.close(fd)
const (R.ok, rfd) = os.open_read(path)
const (R.ok, head) = os.read(rfd, 4)
println(head)
const (R.ok, rest) = os.read(rfd, 64)
println(rest)
const (R.ok, tail) = os.read(rfd, 64)
println(tail.length().to_string())
os.close(rfd)
os.unlink(path)

// ---- directory create, list, rename, remove ----
const dir = "os-demo-" + os.getpid().to_string() + ".d"
os.mkdir(dir)
const (R.ok, b) = os.open_write(dir + "/b.txt")
os.close(b)
const (R.ok, a) = os.open_write(dir + "/a.txt")
os.close(a)
const (R.ok, names) = os.list_dir(dir)
println(names.length().to_string())
println(names[0])
println(names[1])
os.unlink(dir + "/b.txt")
os.rename(dir + "/a.txt", dir + "/r.txt")
const (R.ok, left) = os.list_dir(dir)
println(left[0])
os.unlink(dir + "/r.txt")
os.rmdir(dir)

// ---- fork, pipe, wait ----
const (R.ok, p) = os.pipe()
const (R.ok, pid) = os.fork()
if pid == 0 {
  os.close(p[0])
  os.write(p[1], "greetings from the fork child")
  os.close(p[1])
  os._exit(7)
}
os.close(p[1])
const (R.ok, message) = os.read(p[0], 64)
println(message)
os.close(p[0])
const w = os.waitpid(pid)
println(os.wait_exited(w[1]))
println(os.wait_exit_code(w[1]).to_string())

// ---- process groups: a child of its own, ended by one kill ----
const (R.ok, (pg_read, pg_write)) = os.pipe()
const (R.ok, (park_read, park_write)) = os.pipe()
const (R.ok, group_pid) = os.fork()
if group_pid == 0 {
  os.close(pg_read)
  os.close(park_write)
  const g = os.setpgid(0, 0)
  os.write(pg_write, "grouped=" + (g[0] == R.ok).to_string())
  os.close(pg_write)
  // Park on a read nobody answers: the kill is what ends this child.
  os.read(park_read, 1)
  os._exit(0)
}
os.close(pg_write)
os.close(park_read)
const (R.ok, note) = os.read(pg_read, 64)
println(note)
os.close(pg_read)
os.kill(-group_pid, os.sig_kill)
const killed = os.waitpid(group_pid)[1]
os.close(park_write)
println(os.wait_signaled(killed))
println(os.wait_signal(killed).to_string())
case os.kill(os.getpid(), 99) {
  (R.error, why) then { println(why) }
  (R.ok, _)     then { println("unexpected ok") }
}
const (R.ok, gone) = os.fork()
if gone == 0 { os._exit(0) }
os.waitpid(gone)
case os.kill(gone, os.sig_term) {
  (R.error, why) then { println(why) }
  (R.ok, _)     then { println("unexpected ok") }
}
case os.setpgid(gone, gone) {
  (R.error, why) then { println(why) }
  (R.ok, _)     then { println("unexpected ok") }
}

// ---- process identity ----
println(os.getpid() != os.getppid())
println(os.getcwd().length() > 0)

// ---- the misses answer as values ----
case os.open_read("os-demo-missing.tmp") {
  (R.error, why) then { println(why) }
  (R.ok, fd)     then {
    os.close(fd)
    println("unexpected ok")
  }
}
case os.list_dir("os-demo-missing.d") {
  (R.error, why) then { println(why) }
  (R.ok, _)      then { println("unexpected ok") }
}
