require "os"

// The os package end to end: raw unbuffered file IO through fds, a
// directory listing with create/list/rename/remove, and a fork child
// passing bytes through a pipe before exiting with a status the parent
// decodes. Paths carry the process id so repeated and concurrent runs
// never collide; every path the demo creates is removed before exit.

// ---- raw file IO ----
const path = "os-demo-" + os.getpid().to_string() + ".tmp"
const (R.ok, fd) = os.open_write(path)
os.write(fd, "hello fd")
os.close(fd)
const (R.ok, rfd) = os.open_read(path)
const (R.ok, head) = os.read(rfd, 4)
println(head)
const (R.ok, rest) = os.read(rfd, 64)
println(rest)
const (R.ok, tail) = os.read(rfd, 64)
println(tail.length().to_string())
os.close(rfd)
os.unlink(path)

// ---- directory create, list, rename, remove ----
const dir = "os-demo-" + os.getpid().to_string() + ".d"
os.mkdir(dir)
const (R.ok, b) = os.open_write(dir + "/b.txt")
os.close(b)
const (R.ok, a) = os.open_write(dir + "/a.txt")
os.close(a)
const (R.ok, names) = os.list_dir(dir)
println(names.length().to_string())
println(names[0])
println(names[1])
os.unlink(dir + "/b.txt")
os.rename(dir + "/a.txt", dir + "/r.txt")
const (R.ok, left) = os.list_dir(dir)
println(left[0])
os.unlink(dir + "/r.txt")
os.rmdir(dir)

// ---- fork, pipe, wait ----
const (R.ok, p) = os.pipe()
const (R.ok, pid) = os.fork()
if pid == 0 {
  os.close(p[0])
  os.write(p[1], "greetings from the fork child")
  os.close(p[1])
  os._exit(7)
}
os.close(p[1])
const (R.ok, message) = os.read(p[0], 64)
println(message)
os.close(p[0])
const w = os.waitpid(pid)
println(os.wait_exited(w[1]))
println(os.wait_exit_code(w[1]).to_string())

// ---- process identity ----
println(os.getpid() != os.getppid())
println(os.getcwd().length() > 0)
