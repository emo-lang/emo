require "dom"

// The dom package end to end: strict-parse a small page, query it
// with CSS selectors, walk and filter the results, and encode it
// back. Every door answers a value — a bad parse or a bad selector
// prints its reason and the tour goes on.

const page = "<!doctype html>\n<html>\n<head>\n  <title>Field notes</title>\n</head>\n<body>\n  <header>\n    <h1 id=\"title\" class=\"banner\">Field notes</h1>\n  </header>\n  <main>\n    <section class=\"entry featured\">\n      <h2>Sieving HTML</h2>\n      <p class=\"lead\">Strictness <b>sieves</b> mistakes early.</p>\n      <a href=\"https://emo.example/sieve\">read on</a>\n    </section>\n    <section class=\"entry\">\n      <h2>Reading selectors</h2>\n      <p>Right to left, one compound at a time.</p>\n    </section>\n    <ul id=\"toc\">\n      <li>parse</li>\n      <li class=\"mid\">query</li>\n      <li>walk</li>\n    </ul>\n  </main>\n  <img src=\"cover.png\" alt=\"cover\">\n  <footer>dom 0.1.0</footer>\n</body>\n</html>\n"

// The tag of a selection's first element, for the tour's printing.
def tag_of(sel dom.Selection) String {
  case sel.at(0) {
    (R.ok, n) -> {
      if n.is_element?() {
        return n.as_element().tag()
      }
      return "-"
    }
    (R.error, _) -> { return "-" }
  }
}

case dom.parse(page) {
  (R.error, why) -> { println("parse: " + why) }
  (R.ok, doc)    -> {
    println("roots=" + doc.roots().length().to_string())

    // ---- find: id, class, type, and the structural combinators ----
    case doc.find("#title") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("title=" + sel.text())
        println("title-outer=" + sel.outer_html())
      }
    }
    case doc.find("section.entry > h2") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("h2-count=" + sel.length().to_string())
        println("h2-first=" + sel.first().text())
        println("h2-last=" + sel.last().text())
      }
    }
    case doc.find("h1 + main") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("h1+main=" + sel.length().to_string()) }
    }
    case doc.find("ul li, footer") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("group=" + sel.length().to_string() + " text=" + sel.text()) }
    }

    // ---- slicing a selection ----
    case doc.find("li") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("li=" + sel.length().to_string())
        println("eq1=" + sel.eq(1).text())
        println("eq-2=" + sel.eq(-2).text())
        println("slice(1,3)=" + sel.slice(1, 3).text())
        case sel.at(1) {
          (R.ok, n)    -> {
            println("at1-kind=" + n.kind().to_string() + " elem=" + (if n.is_element?() { n.as_element().tag() } else { "-" }))
          }
          (R.error, w) -> { println("at: " + w) }
        }
      }
    }

    // ---- attributes: the strict door and the forgiving one ----
    case doc.find("a") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("href=" + sel.attr_or("href", "none"))
        case sel.attr("href") {
          (R.ok, v)    -> { println("href-strict=" + v) }
          (R.error, w) -> { println("href: " + w) }
        }
        println("alt=" + sel.attr_or("alt", "absent"))
      }
    }
    case doc.find("img") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("img-outer=" + sel.outer_html())
        println("img-html=" + sel.html())
      }
    }

    // ---- pseudo-classes ----
    case doc.find("li:nth-child(2n+1)") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("nth-odd=" + sel.text()) }
    }
    case doc.find("li:not(.mid)") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("not-mid=" + sel.text()) }
    }
    case doc.find("section") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        case sel.has("a") {
          (R.ok, h)    -> { println("sections-with-a=" + h.length().to_string()) }
          (R.error, w) -> { println("has: " + w) }
        }
      }
    }
    case doc.find("p:contains(sieves)") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("contains=" + sel.length().to_string())
        println("p-html=" + sel.html())
      }
    }
    case doc.find(":root") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("root=" + tag_of(sel.first())) }
    }

    // ---- traversal ----
    case doc.find("#toc") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("toc-children=" + sel.children().length().to_string())
        println("toc-parent=" + tag_of(sel.parent().first()))
        println("toc-parents=" + sel.parents().length().to_string())
        case sel.closest("main") {
          (R.ok, c)    -> { println("toc-closest-main=" + tag_of(c.first())) }
          (R.error, w) -> { println("closest: " + w) }
        }
      }
    }
    case doc.find("footer") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("footer-prev=" + tag_of(sel.prev().first()))
        println("footer-prev-all=" + sel.prev_all().length().to_string())
        case sel.parents_filtered("body") {
          (R.ok, p)    -> { println("footer-in-body=" + p.length().to_string()) }
          (R.error, w) -> { println("parents: " + w) }
        }
      }
    }

    // ---- filtering ----
    case doc.find("section") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        case sel.filter(".featured") {
          (R.ok, f)    -> {
            case f.first().find("h2") {
              (R.ok, h)    -> { println("featured=" + h.first().text()) }
              (R.error, w) -> { println("featured: " + w) }
            }
          }
          (R.error, w) -> { println("filter: " + w) }
        }
        case sel.is?(".featured") {
          (R.ok, v)    -> { println("is-featured=" + (if v { "yes" } else { "no" })) }
          (R.error, w) -> { println("is: " + w) }
        }
      }
    }

    // ---- each: the trailing block walks the selection ----
    case doc.find("li") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> {
        println("each:")
        sel.each() -> (i Int64, one dom.Selection) {
          println("  " + i.to_string() + " " + one.text())
        }
        const complete = sel.each_with_break() -> (i Int64, one dom.Selection) {
          return i < 2
        }
        println("walked-all=" + (if complete { "yes" } else { "no" }))
      }
    }

    // ---- the node face and the round trip ----
    println("all-nodes=" + doc.all().length().to_string())
    case doc.find("*") {
      (R.error, why) -> { println("find: " + why) }
      (R.ok, sel)    -> { println("all-elements=" + sel.length().to_string()) }
    }
    const canonical = doc.encode()
    println("encode-lines=" + canonical.split("\n").length().to_string())
    case dom.parse(canonical) {
      (R.error, why) -> { println("reparse: " + why) }
      (R.ok, again)  -> {
        println("reparse-roots=" + again.roots().length().to_string())
        case again.find("#title") {
          (R.ok, t)    -> { println("reparse-title=" + t.text()) }
          (R.error, w) -> { println("reparse: " + w) }
        }
      }
    }
  }
}
