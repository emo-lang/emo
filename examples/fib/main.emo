def fib(n Int) Int {
  if n < 2 {
    return n
  }
  return fib(n - 1) + fib(n - 2)
}

const greeting = -> (name String) {
  return "hello, ${name}"
}

println(fib(20))
println(greeting("emo"))

def count_down(n Int) Int {
  if n == 0 {
    return 0
  }
  return count_down(n - 1)
}
println(count_down(1000000))
