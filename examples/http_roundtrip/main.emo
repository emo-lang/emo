// The step 13 acceptance: an HTTP server and client round-trip on
// localhost, in one program, entirely direct style — the scheduler
// switches processes underneath while the code reads like blocking calls.
require "httpd"
require "http"
require "net"

const (R.ok, listener) = net.listen("127.0.0.1", 0)

// One process per connection, inside httpd's serve helper.
const server = httpd.serve(listener) -> (req httpd.Request) {
  return httpd.response(200, [], "hello from emo")
}

case http.get("http://127.0.0.1:" + listener.port().to_string() + "/hello") {
  (R.error, why) then { println("request failed: ${why}") }
  (R.ok, resp)   then {
    println(resp.body)
    println(resp.status)
  }
}

// A request that can never leave: the host does not resolve, and the
// failure comes back as a value.
case http.get("http://256.256.256.256:1/hello") {
  (R.error, why) then { println("request failed: ${why}") }
  (R.ok, resp)   then { println("unexpected ok") }
}
