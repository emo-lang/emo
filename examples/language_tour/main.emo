// The language tour — one program, read top to bottom, where every
// section prints what it just demonstrated.
//
//   emo run main.emo
//
// Emo's design rule is that everything is visibly what it is: a call
// has parentheses, a return is written out, and mutability is always
// spelled. No section below needs more than a few lines to make its
// point.

// ---- 1 · Bindings and strings ----
const who = "世界"
var visits = 6
visits = visits * 7
println("hello, ${who} — six sevens are ${visits}")

// Interpolation holds any expression, and Chinese text is ordinary
// string data — print it, interpolate it, pass it around.
const item = "伞"
println("one ${item} costs ${19 + 9} yuan")

// ---- 2 · Classes: immutable value types ----
class User {
  def init(name String, age Int64) {
    self.name = name
    self.age = age
  }

  def describe() String {
    return "${self.name}, age ${self.age}"
  }

  def adult?() Bool {
    return self.age >= 18
  }
}

const ming = User.new(name: "王晓明", age: 28)
println(ming.describe())
const adult = ming.adult?()
println("adult? ${adult}")
// Fields freeze after init, and equality compares content:
println(ming == User.new(name: "王晓明", age: 28))

// ---- 3 · Interfaces: contracts by shape ----
// No `implements` anywhere: a class satisfies an interface when its
// shape matches. The consumer declares the contract it needs.
interface Greeter {
  def greet() String
}

class Machine {
  def greet() String {
    return "[beep] 你好"
  }
}

class Friend {
  def greet() String {
    return "很高兴见到你"
  }
}

def welcome(g Greeter) String {
  if g.is(Machine) {
    return "a machine says: ${g.greet()}"
  }
  return "a friend says: ${g.greet()}"
}

println(welcome(Machine.new()))
println(welcome(Friend.new()))

// ---- 4 · Enums and the tag idiom ----
// An enum is a closed set of named values — no data on members. When
// a value carries data, the tag rides in a tuple and `case` takes it
// apart by position.
enum Outcome { ok, err }

def classify(age Int64) (Outcome, String) {
  if age >= 18 {
    return (Outcome.ok, "adult")
  }
  return (Outcome.err, "minor")
}

case classify(28) {
  (Outcome.ok, label) -> { println("28 -> ${label}") }
  (Outcome.err, label) -> { println("28 -> ${label}") }
}

case classify(12) {
  (Outcome.ok, label) -> { println("12 -> ${label}") }
  (Outcome.err, label) -> { println("12 -> ${label}") }
}

// A branch may carry a guard:
case (Outcome.ok, 42) {
  (Outcome.ok, v) when v > 40 -> { println("a big answer: ${v}") }
  (Outcome.ok, v) -> { println("a small answer: ${v}") }
  (Outcome.err, label) -> { println("no answer: ${label}") }
}

// ---- 5 · Arrays: fixed, transformed, never mutated ----
const nums = [3, 1, 2]
println(nums[0] + nums.length())
// Transforming returns a new array; the original is untouched:
const more = nums.append(9)
println(more.length())
println(nums.length())
println([1, 2] == [1, 2])

// ---- 6 · Mutability, layer by layer ----
// `var` is explicit and block-scoped; a Box is the one long-lived
// mutable cell a process owns — read and replace, deliberately
// nothing else.
var tally = 0
tally = tally + 1
tally = tally + 10
println(tally)

const total = Box.new(0)
total.replace(total.read() + 5)
total.replace(total.read() + 6)
println(total.read())

// ---- 7 · Blocks: the one function notation ----
// An arrow block is an anonymous function; a call may take a trailing
// block, which is how callbacks and iteration stay single-noted.
const twice = -> (n Int64) { return n * 2 }
println(twice(21))

def walk(xs Array[Int64], i Int64, f Block) Int64 {
  if i == xs.length() {
    return 0
  }
  f(xs[i])
  return walk(xs, i + 1, f)
}

walk([10, 20, 30], 0) -> (v Int64) {
  println(v)
  return v
}
