// The step 51 acceptance: an HTTPS request end to end on the default
// target — a TLS server and an https:// client in one program, the
// way http_roundtrip pairs plain TCP. The listener takes the checked-in
// test certificate (signed by fixtures/tls-ca.pem, SAN: localhost and
// 127.0.0.1); the client connects by the DNS name so verification has a
// name to check, and trusts the CA through the default verify paths,
// which SSL_CERT_FILE points at.
//
//   SSL_CERT_FILE=fixtures/tls-ca.pem \
//   EMO_REGISTRY=<repo>/stdlib/registry emo run main.emo
//
// On the interpreter the server is ocaml-ssl; on the c target it is
// the runtime's own OpenSSL/LibreSSL fence — one source, both ends of
// the wire, byte-identical output.
//
// A plain-HTTP client knocks on the TLS port first: its handshake
// fails inside the server's accept, and the server keeps serving —
// the https request after it is the proof, bounded so a server that
// stopped accepting fails the run instead of hanging it.

require "httpd"
require "http"
require "net"

const (R.ok, listener) = net_listen_tls("127.0.0.1", 0, "fixtures/tls-server-cert.pem", "fixtures/tls-server-key.pem")

const server = httpd.serve(listener) -> (req httpd.Request) {
  return httpd.response(200, [], "hello over tls")
}

const (R.ok, plain_conn) = net.connect("127.0.0.1", listener.port(), 5.0)
const plain = plain_conn.set_timeout(5.0)
plain.write("GET /hello HTTP/1.1\r\nHost: localhost\r\n\r\n")
plain.read_all()
plain.close()
println("a plain-HTTP client was turned away")

case http.request("GET", "https://localhost:" + listener.port().to_string() + "/hello", [], "", 5.0) {
  (R.error, why) then { println("request failed: ${why}") }
  (R.ok, resp)   then {
    println(resp.body)
    println(resp.status)
  }
}
