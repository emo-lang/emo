require "yaml"

// The yaml package's edges: quoted scalars and their escapes, the
// number formats, block scalars with chomping, flow collections,
// duplicate keys, empty containers, and decode/encode round-trips.

// ---- quoted scalars and escapes ----
const (R.ok, quoted) = yaml.decode("q1: \"tab\\tnl\\nq\\\"bs\\\\\\u00e9\\u4e16\"\nq2: 'it''s'\nq3: \"\\u4e16\\ud83d\\ude00\"\n")
println(quoted.get("q1").as_string().to_bytes().length().to_string())
println(quoted.get("q1").encode())
println(quoted.get("q2").as_string())
println(quoted.get("q3").as_string().to_bytes().length().to_string())

// ---- numbers at their boundaries ----
const (R.ok, d1) = yaml.decode("n0: 0")
println(d1.get("n0").as_int().to_string())
const (R.ok, d2) = yaml.decode("n1: -15")
println(d2.get("n1").as_int().to_string())
const (R.ok, d3) = yaml.decode("n2: 9223372036854775807")
println(d3.get("n2").as_int().to_string())
const (R.ok, d4) = yaml.decode("n3: -9223372036854775808")
println(d4.get("n3").as_int().to_string())
const (R.ok, d5) = yaml.decode("n4: 0x1f")
println(d5.get("n4").as_int().to_string())
const (R.ok, d6) = yaml.decode("n5: 0o17")
println(d6.get("n5").as_int().to_string())
const (R.ok, d7) = yaml.decode("f1: 0.5")
println(d7.get("f1").encode())
const (R.ok, d8) = yaml.decode("f2: -2.5e2")
println(d8.get("f2").encode())
const (R.ok, d9) = yaml.decode("f3: 1.0e16")
println(d9.get("f3").encode())
// ---- block scalars with chomping ----
const (R.ok, d10) = yaml.decode("a: |\n  x\n  y\n")
println(d10.get("a").as_string().to_bytes().length().to_string())
const (R.ok, d11) = yaml.decode("b: |-\n  x\n  y\n")
println(d11.get("b").as_string().to_bytes().length().to_string())
const (R.ok, d12) = yaml.decode("c: |+\n  x\n\n")
println(d12.get("c").as_string().to_bytes().length().to_string())
const (R.ok, d13) = yaml.decode("d: >\n  fold\n  me\n")
println(d13.get("d").as_string())
// ---- duplicate keys: entries keep both, `get` takes the last ----
const (R.ok, dup) = yaml.decode("k: 1\nk: 2\nk: 3\n")
if dup.is(YamlObject) {
  println(dup.get("k").as_int().to_string())
  println(dup.entries().length().to_string())
}

// ---- empty containers and the round trip ----
const (R.ok, d15) = yaml.decode("e1: {}\ne2: []\n")
println(yaml.encode(d15))
const (R.ok, doc) = yaml.decode("srv:\n  hosts:\n    - a.example\n    - b.example\n  port: 8443\n")
const (R.ok, back) = yaml.decode(yaml.encode(doc))
if back.is(YamlObject) {
  const srv = back.get("srv")
  if srv.is(YamlObject) {
    println(srv.get("hosts").encode())
    println(srv.get("port").as_int().to_string())
  }
}
