// The README's expected-failure shape: the call returns (R.ok, body)
// or (R.error, reason), and the pair is matched, not caught — the
// built-in R needs no import. The reader here stands in for
// `file.read`, whose own tuple migration is the stdlib step. Run it:
//
//   emo run matching.emo

def read_line(path String) (R, String) {
  if path == "config.emo" {
    return (R.ok, "payload line")
  }
  return (R.error, path + ": no such file")
}

case read_line("config.emo") {
  (R.ok, body)   -> { println(body) }
  (R.error, why) -> { println("read failed: ${why}") }
}
