// The reporter process: prints each forwarded line through the
// catalog group, counts, and reports back to the boss.
def run(count Int64, boss Pid) Int64 {
  receive {
    (id, total) -> {
      println("shipped " + Catalog.line(id, total))
      return run(count + 1, boss)
    }
    "done" -> {
      boss <- (self_pid(), count)
      return halt()
    }
  }
}
