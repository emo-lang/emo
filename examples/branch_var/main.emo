// A `var` rebound inside an `if`, a `case`, or a loop body keeps its
// new value after the branch: the binding is threaded out, not scoped
// to the arm. Every target answers identically — this also covers the
// ocaml target's specialized emitter, which lowers `var` and `case`
// natively.
//
//   emo run main.emo

def sign(x Int64) Int64 {
  var y = 0
  if x > 0 {
    y = 1
  } else {
    if x < 0 {
      y = 0 - 1
    }
  }
  return y
}

def bucket(x Int64) Int64 {
  var y = 0
  case x {
    0 then { y = 10 }
    1 then { y = 20 }
    _ then { y = 30 }
  }
  return y
}

def even_sum(n Int64) Int64 {
  var acc = 0
  for var i = 0; i < n; i = i + 1 {
    if i % 2 == 0 {
      acc = acc + i
    }
  }
  return acc
}

// The other direction: a name an arm declares is that arm's alone, so
// the sibling arm's own loop never reaches for it — the beam target
// once threaded the first arm's `step` into the second arm's loop,
// where nothing bound it.
def arm_loops(n Int64, wide Bool) {
  if wide {
    const step = n * 2
    for var i = 0; i < 2; i = i + 1 {
      println(i * step)
    }
  } else {
    for var i = 0; i < 2; i = i + 1 {
      println(i + n)
    }
  }
}

println(sign(5))
println(sign(0 - 5))
println(sign(0))
println(bucket(0))
println(bucket(1))
println(bucket(9))
println(even_sum(6))
arm_loops(5, true)
arm_loops(5, false)
