// The ELEFUNT-derived battery: Cody & Waite's identity tests across the
// math package's scalar surface — sin against its triple angle, exp
// against the shifted product, log against the sum form, and so on down
// the elementary functions through the error function and the gamma
// pair. The arguments come from a small linear congruential generator
// carried right here, so the sequence is byte-identical on every target
// and a rerun draws the same sample. Each function prints its maximum
// and root-mean-square loss in bits against its identity, and this
// example's expected.txt is the accuracy record: a regression is a
// diff.
//
// The identities are self-consistency checks, not oracles, so each row
// sits where its identity's own roundings put it: the power-of-two rows
// measure arithmetic that is exact and answer zero, most transcendental
// rows lose a bit or two to the composition, and the two quadrature
// rows — erf against Simpson's rule over its defining integral, erfc
// against the tail integral — carry Simpson's own truncation floor,
// tens of bits below the float's ceiling. A broken function moves its
// row by orders of magnitude; that is the regression the record
// catches.
//
//   emo run main.emo

require "math"

const n_samples = 512

// ---- the sample stream ----

// Knuth's MMIX multiplier and increment, wrapped at 64 bits — Int64
// arithmetic wraps in two's complement on every target, so the stream
// is the same everywhere. Only the top fifty-three bits feed the unit
// interval, and the seed is fixed at forty-two.
const lcg_a = 6364136223846793005
const lcg_c = 1442695040888963407
const seed0 = 42

def lcg(s Int64) Int64 {
  return s * lcg_a + lcg_c
}

def unit(s Int64) Float64 {
  return ((s >> 11) & 9007199254740991).to_float64() / 9007199254740992.0
}

def span(s Int64, lo Float64, hi Float64) Float64 {
  return lo + unit(s) * (hi - lo)
}

// ---- the loss ledger ----

// Relative error to lost bits: fifty-three is the mantissa's width, so
// a half-ulp answer loses nothing, and a total cancellation loses all
// of it. An exact answer loses zero.
def eps_loss(eps Float64) Float64 {
  if eps <= 0.0 {
    return 0.0
  }
  var loss = 53.0 + math.log(eps) * 1.4426950408889634
  if loss < 0.0 {
    loss = 0.0
  }
  if loss > 53.0 {
    loss = 53.0
  }
  return loss
}

def pair_loss(computed Float64, expected Float64) Float64 {
  if computed == expected {
    return 0.0
  }
  return eps_loss(math.abs(computed - expected) / math.abs(expected))
}

def row(name String, worst Float64, sum_sq Float64) {
  println("${name} max ${worst} rms ${(sum_sq / n_samples.to_float64()).sqrt()}")
}

// The integrand both quadrature rows share: e^(−t²), the error
// function's own curve, by composite Simpson over an even panel count.
def simpson_e(a Float64, b Float64, n Int64) Float64 {
  const h = (b - a) / n.to_float64()
  var sum = 0.0
  var i = 1
  while i < n {
    const t = a + i.to_float64() * h
    var w = 4.0
    if i % 2 == 0 {
      w = 2.0
    }
    sum = sum + w * math.exp(0.0 - t * t)
    i = i + 1
  }
  return (h / 3.0) * (math.exp(0.0 - a * a) + math.exp(0.0 - b * b) + sum)
}

// ---- the rows ----

// 2^(a+b) against 2^a·2^b: the exponents leave the range of neither.
def bat_pow2(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const a = (unit(s) * 1000.0 - 500.0).floor().to_int64()
    s = lcg(s)
    const b = (unit(s) * 1000.0 - 500.0).floor().to_int64()
    const loss = pair_loss(math.pow2(a + b), math.pow2(a) * math.pow2(b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("pow2", worst, sum_sq)
  return s
}

// √x·√x against x, over the mantissa's span.
def bat_sqrt(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.25, 4.0)
    const loss = pair_loss(math.sqrt(x) * math.sqrt(x), x)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("sqrt", worst, sum_sq)
  return s
}

// A power-of-two rescale moves through hypot untouched, so the scaled
// pair answers exactly twice the unscaled one.
def bat_hypot(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const a = span(s, 0.5, 4.0)
    s = lcg(s)
    const b = span(s, 0.5, 4.0)
    const loss = pair_loss(math.hypot(2.0 * a, 2.0 * b), 2.0 * math.hypot(a, b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("hypot", worst, sum_sq)
  return s
}

// The shifted-argument identity: exp(a+b) against exp(a)·exp(b).
def bat_exp(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const a = span(s, 0.5, 3.0)
    s = lcg(s)
    const b = span(s, 0.5, 3.0)
    const loss = pair_loss(math.exp(a + b), math.exp(a) * math.exp(b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("exp", worst, sum_sq)
  return s
}

// The half-argument identity: exp2(x) against exp2(x/2)².
def bat_exp2(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.0 - 60.0, 60.0)
    const half = math.exp2(x / 2.0)
    const loss = pair_loss(math.exp2(x), half * half)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("exp2", worst, sum_sq)
  return s
}

// The product form: log(a·b) against log(a)+log(b).
def bat_log(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const a = span(s, 1.01, 2.0)
    s = lcg(s)
    const b = span(s, 1.01, 2.0)
    const loss = pair_loss(math.log(a * b), math.log(a) + math.log(b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("log", worst, sum_sq)
  return s
}

// log2 against log through the base conversion, two different
// decompositions of the same question.
def bat_log2(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 1.01, 1000.0)
    const loss = pair_loss(math.log2(x), math.log(x) * 1.4426950408889634)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("log2", worst, sum_sq)
  return s
}

// log10 against log2 through the base conversion — the exponent
// decomposition answering what the product form would, two different
// decompositions of the same question.
def bat_log10(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 1.01, 1000.0)
    const loss = pair_loss(math.log10(x), math.log2(x) * 0.3010299956639812)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("log10", worst, sum_sq)
  return s
}

// pow(x, a+b) against pow(x,a)·pow(x,b), the exponent law.
def bat_pow(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 1.01, 2.0)
    s = lcg(s)
    const a = span(s, 0.05, 0.95)
    s = lcg(s)
    const b = span(s, 0.05, 0.95)
    const loss = pair_loss(math.pow(x, a + b), math.pow(x, a) * math.pow(x, b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("pow", worst, sum_sq)
  return s
}

// The triple angle: sin(x) against 3 sin(x/3) − 4 sin³(x/3).
def bat_sin(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.1, 6.0)
    const t = math.sin(x / 3.0)
    const loss = pair_loss(3.0 * t - 4.0 * t * t * t, math.sin(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("sin", worst, sum_sq)
  return s
}

// cos against sin one quarter turn behind it.
def bat_cos(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 1.5)
    const loss = pair_loss(math.cos(x), math.sin(math.pi / 2.0 - x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("cos", worst, sum_sq)
  return s
}

// The half angle: tan(x) against 2t/(1 − t²), t = tan(x/2), with both
// x and 2x held inside the first quadrant.
def bat_tan(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 0.7)
    const t = math.tan(x / 2.0)
    const loss = pair_loss(2.0 * t / (1.0 - t * t), math.tan(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("tan", worst, sum_sq)
  return s
}

// The addition formula: atan(a)+atan(b) against atan((a+b)/(1−ab)),
// with the product held below one so no quadrant fold is needed.
def bat_atan(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const a = span(s, 0.05, 0.45)
    s = lcg(s)
    const b = span(s, 0.05, 0.45)
    const loss = pair_loss(math.atan((a + b) / (1.0 - a * b)), math.atan(a) + math.atan(b))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("atan", worst, sum_sq)
  return s
}

// atan2's first quadrant against atan of the slope.
def bat_atan2(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.1, 5.0)
    s = lcg(s)
    const y = span(s, 0.1, 5.0)
    const loss = pair_loss(math.atan2(y, x), math.atan(y / x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("atan2", worst, sum_sq)
  return s
}

// The half angle: asin(x) against 2 asin(√((1−√(1−x²))/2)), the
// cosine's half-angle formula read backward through the complement.
def bat_asin(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 0.95)
    const loss = pair_loss(math.asin(x), 2.0 * math.asin(math.sqrt((1.0 - math.sqrt(1.0 - x * x)) / 2.0)))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("asin", worst, sum_sq)
  return s
}

// The half angle: acos(x) against 2 acos(√((1+x)/2)).
def bat_acos(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 0.95)
    const loss = pair_loss(math.acos(x), 2.0 * math.acos(math.sqrt((1.0 + x) / 2.0)))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("acos", worst, sum_sq)
  return s
}

// The double argument: sinh(2x) against 2 sinh(x)·cosh(x).
def bat_sinh(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 2.0)
    const loss = pair_loss(math.sinh(2.0 * x), 2.0 * math.sinh(x) * math.cosh(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("sinh", worst, sum_sq)
  return s
}

// The fundamental identity: cosh² − sinh² against one.
def bat_cosh(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 3.0)
    const loss = pair_loss(math.cosh(x) * math.cosh(x) - math.sinh(x) * math.sinh(x), 1.0)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("cosh", worst, sum_sq)
  return s
}

// The double argument: tanh(2x) against 2t/(1 + t²), t = tanh(x).
def bat_tanh(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 3.0)
    const t = math.tanh(x)
    const loss = pair_loss(2.0 * t / (1.0 + t * t), math.tanh(2.0 * x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("tanh", worst, sum_sq)
  return s
}

// erf against Simpson's rule over its defining integral
// (2/√π)∫₀ˣ e^(−t²) dt — the record here carries Simpson's truncation
// floor, not erf's own error.
def bat_erf(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.05, 1.2)
    const quad = simpson_e(0.0, x, 256) * 1.1283791670955126
    const loss = pair_loss(quad, math.erf(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("erf", worst, sum_sq)
  return s
}

// erfc against the tail integral (2/√π)∫ₓ^(x+4) e^(−t²) dt, the part
// past the window sitting tens of exponents below the answer, so the
// truncation is invisible and the floor is Simpson's.
def bat_erfc(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.5, 4.0)
    const quad = simpson_e(x, x + 4.0, 512) * 1.1283791670955126
    const loss = pair_loss(quad, math.erfc(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("erfc", worst, sum_sq)
  return s
}

// The recurrence: Γ(x+1) against x·Γ(x), the gamma pair's own
// functional equation, run up the half of the line where Γ fits.
def bat_tgamma(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 0.5, 40.0)
    const loss = pair_loss(math.tgamma(x + 1.0), x * math.tgamma(x))
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("tgamma", worst, sum_sq)
  return s
}

// The recurrence in log space: lgamma(x+1) against lgamma(x)+log(x),
// measured against the answer's own magnitude, which is what a log
// function's error is naturally measured in.
def bat_lgamma(seed Int64) Int64 {
  var s = seed
  var worst = 0.0
  var sum_sq = 0.0
  var i = 0
  while i < n_samples {
    s = lcg(s)
    const x = span(s, 1.01, 100.0)
    const big = math.lgamma(x + 1.0)
    const eps = math.abs(big - math.lgamma(x) - math.log(x)) / math.max(1.0, math.abs(big))
    const loss = eps_loss(eps)
    if loss > worst {
      worst = loss
    }
    sum_sq = sum_sq + loss * loss
    i = i + 1
  }
  row("lgamma", worst, sum_sq)
  return s
}

// The battery, in row order: one stream, twenty-three rows, each
// picking up the stream where the last left off. The chain runs as
// plain statements in one body — a row's seed is a local, so no target
// re-derives an earlier row to answer a later one.
def battery() {
  var s = seed0
  s = bat_pow2(s)
  s = bat_sqrt(s)
  s = bat_hypot(s)
  s = bat_exp(s)
  s = bat_exp2(s)
  s = bat_log(s)
  s = bat_log2(s)
  s = bat_log10(s)
  s = bat_pow(s)
  s = bat_sin(s)
  s = bat_cos(s)
  s = bat_tan(s)
  s = bat_atan(s)
  s = bat_atan2(s)
  s = bat_asin(s)
  s = bat_acos(s)
  s = bat_sinh(s)
  s = bat_cosh(s)
  s = bat_tanh(s)
  s = bat_erf(s)
  s = bat_erfc(s)
  s = bat_tgamma(s)
  bat_lgamma(s)
}

battery()
