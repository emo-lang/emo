// The plot package: one declarative figure per mark, rendered to SVG.
//
//   emo run main.emo

require "plot"

const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun"]
const sales = [12.0, 18.0, 15.0, 24.0, 21.0, 30.0]

const bar_ax = plot.axes().with_x_label("Month").with_y_label("Sales").with_marks([plot.mark.bar(months, sales)])
println(plot.svg(plot.figure().with_title("Monthly sales").with_axes([bar_ax])))

const line_ax = plot.axes().with_x_label("Year").with_y_label("Revenue").with_marks([
  plot.mark.line([2020.0, 2021.0, 2022.0, 2023.0, 2024.0], [42.0, 51.0, 47.0, 62.0, 71.0]).with_style(
    plot.mark.line_style().with_marker(plot.mark.Marker.circle))
])
println(plot.svg(plot.figure().with_title("Revenue by year").with_axes([line_ax])))

const scatter_ax = plot.axes().with_x_label("Temperature").with_y_label("Ice cream").with_marks([
  plot.mark.scatter([14.0, 16.0, 18.0, 21.0, 24.0, 27.0, 30.0], [8.0, 12.0, 14.0, 19.0, 26.0, 31.0, 38.0])
])
println(plot.svg(plot.figure().with_title("Ice cream vs temperature").with_axes([scatter_ax])))

const area_ax = plot.axes().with_x_label("Hour").with_y_label("Requests").with_marks([
  plot.mark.area([0.0, 3.0, 6.0, 9.0, 12.0, 15.0, 18.0, 21.0], [120.0, 80.0, 60.0, 210.0, 480.0, 350.0, 190.0, 90.0])
])
println(plot.svg(plot.figure().with_title("Requests through the day").with_axes([area_ax])))

const scores = [62.0, 70.0, 75.0, 81.0, 88.0, 94.0, 58.0, 66.0, 73.0, 79.0, 85.0, 91.0, 55.0, 68.0, 77.0, 83.0, 90.0, 97.0, 61.0, 72.0]
const hist_ax = plot.axes().with_x_label("Score").with_y_label("Students").with_marks([plot.mark.hist(scores, 5)])
println(plot.svg(plot.figure().with_title("Exam score distribution").with_axes([hist_ax])))
