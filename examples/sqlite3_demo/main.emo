require "sqlite3"

// The sqlite3 package end to end: an in-memory database, DDL through
// exec, writes through a prepared statement with bound parameters, and
// a stepped read loop with typed column access. c-target only — the
// package's calls are foreign defs, which the interpreter refuses.

const db = sqlite3.open(":memory:")

db.exec("CREATE TABLE notes (id INTEGER PRIMARY KEY, title TEXT NOT NULL, score REAL, tag TEXT)")

// ---- writes through a prepared statement ----
const insert = db.prepare("INSERT INTO notes (title, score, tag) VALUES (?1, ?2, ?3)")

insert.bind_text(1, "first")
insert.bind_float(2, 1.5)
insert.bind_null(3)
insert.step()
println("insert: rowid " + db.last_insert_rowid().to_string() + ", changes " + db.changes().to_string())

insert.reset()
insert.bind_text(1, "second")
insert.bind_float(2, 2.5)
insert.bind_text(3, "pinned")
insert.step()
println("insert: rowid " + db.last_insert_rowid().to_string() + ", changes " + db.changes().to_string())

insert.finalize()

// ---- a stepped read with typed columns ----
const query = db.prepare("SELECT id, title, score, tag FROM notes ORDER BY id")
println("columns: " + query.column_count().to_string())
println("names: " + query.column_name(0) + ", " + query.column_name(1) + ", " + query.column_name(2) + ", " + query.column_name(3))
while query.step() {
  var tag = query.column_text(3)
  if query.column_is_null(3) {
    tag = "<null>"
  }
  println("row " + query.column_int(0).to_string() + ": " + query.column_text(1) + " score=" + query.column_float(2).to_string() + " tag=" + tag)
}
query.finalize()

// ---- exec reports its changes through the connection ----
db.exec("UPDATE notes SET score = 9.5 WHERE id = 1")
println("update changes: " + db.changes().to_string())

db.close()
println("done")
