// A class with a `to_string` method and one without: the rendering rule
// rides the module boundary, and neither answer changes a rendered value.
class Remote {
  def init(n Int64) {
    self.n = n
  }
}

class Pretty {
  def init(n Int64) {
    self.n = n
  }

  def to_string() String {
    return "Remote(${self.n})"
  }
}
