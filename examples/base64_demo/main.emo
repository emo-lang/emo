require "base64"

// The RFC 4648 section 10 test vectors, encoded and decoded back —
// every padding remainder (0, 1, 2 bytes) rides through.
println(base64.encode(""))
println(base64.encode("f"))
println(base64.encode("fo"))
println(base64.encode("foo"))
println(base64.encode("foob"))
println(base64.encode("fooba"))
case base64.decode("Zg==") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}
case base64.decode("Zm8=") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}
case base64.decode("Zm9v") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}
case base64.decode("Zm9vYg==") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}
case base64.decode("Zm9vYmE=") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}
case base64.decode("Zm9vYmFy") {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, text)   -> { println(text) }
}

// The decoder's rejections are values too: a stray character, a short
// final quantum, padding bits that would carry data.
case base64.decode("Zg=!") {
  (R.error, why) -> { println(why) }
  (R.ok, _)      -> { println("unexpected ok") }
}
case base64.decode("Zm9vYg") {
  (R.error, why) -> { println(why) }
  (R.ok, _)      -> { println("unexpected ok") }
}
case base64.decode("Zh==") {
  (R.error, why) -> { println(why) }
  (R.ok, _)      -> { println("unexpected ok") }
}

// Bytes are the payload: multi-byte UTF-8 round-trips untouched.
const text = "emo — plain text,中文 mixed"
println(base64.encode(text))
case base64.decode(base64.encode(text)) {
  (R.error, why) -> { println("decode failed: ${why}") }
  (R.ok, back)   -> { println(back) }
}
