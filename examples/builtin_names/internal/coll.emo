// A class whose methods carry names the builtins also use — `length`,
// `get`, `set`, `push`, `to_string`. An instance answers its own
// method on every target, whatever the name, whether the receiver's
// class is known statically or only at run time.
class Chain {
  def init(n Int64) {
    self.n = n
  }

  def length() Int64 {
    return self.n
  }

  def get(i Int64) Int64 {
    return i + self.n
  }

  def set(i Int64, v Int64) Int64 {
    return v
  }

  def push(v Int64) Int64 {
    return v
  }

  def to_string() String {
    return "Chain(${self.n})"
  }

  def normal() Int64 {
    return self.n * 2
  }
}

def make(n Int64) Chain {
  return Chain.new(n)
}

// A chunk crosses the gradual List element type through a typed
// signature: the encoding def is the contract the checker holds.
def chunk_bytes(chunk String) Bytes {
  return chunk.to_bytes()
}

// The deque's second pass crosses values already encoded.
def as_bytes(b Bytes) Bytes {
  return b
}

// The drain: `to_bytes` empties the buffer it answers. A chained or
// delegated builtin must read the one temporary the sender produced —
// a second evaluation of the sender would answer the empty buffer.
class Buffer {
  def init() {
    self.chunks = List.new([])
  }

  def put(s String) Buffer {
    self.chunks.push_back(s)
    return self
  }

  def to_bytes() Bytes {
    const n = self.chunks.length()
    var total = 0
    var parts = List.new([])
    for var i = 0; i < n; i = i + 1 {
      const chunk = self.chunks.pop_front()
      total = total + chunk.length()
      parts.push_back(chunk_bytes(chunk))
    }
    const out = Bytes.new(total)
    var at = 0
    for var i = 0; i < n; i = i + 1 {
      const data = as_bytes(parts.pop_front())
      for var j = 0; j < data.length(); j = j + 1 {
        out.set(at, data.get(j))
        at = at + 1
      }
    }
    return out
  }

  def to_string() String {
    return self.to_bytes().to_string()
  }
}

def make_drain() Buffer {
  return Buffer.new()
}
