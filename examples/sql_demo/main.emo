require "sql"

// The sql package end to end: parse statements, read the AST through
// the interfaces, and render every tree back to canonical SQL. Every
// target must print this file's expected.txt byte for byte — the
// package is pure Emo over the shared runtimes.

// ---- the shape the package is named for ----
const (R.ok, q1) = sql.parse("SELECT * FROM users")
println(q1.to_string())

// ---- a full SELECT through every clause ----
const text = "SELECT DISTINCT u.name AS username, count(*) AS n, max(o.total) FROM main.users u LEFT JOIN orders o ON o.user_id = u.id WHERE u.active = TRUE AND o.total >= 100 GROUP BY u.name HAVING count(*) > 1 ORDER BY n DESC, username ASC LIMIT 20 OFFSET 40"
const (R.ok, q2) = sql.parse(text)
println(q2.to_string())

// ---- reading the tree ----
if q2.is(sql.Select) {
  println(q2.columns.length())
  println(q2.from_t.length())
  println(q2.where_e.length())
  println(q2.group_by.length())
  println(q2.order_by.length())
  println(q2.limit_e.length())
  println(q2.offset_e.length())
  const first = q2.columns[0]
  if first.is(sql.SelExpr) {
    println(first.alias_e[0])
  }
  const src = q2.from_t[0]
  if src.is(sql.TblJoin) {
    println(src.jtype == sql.JoinKind.left)
    println(src.on_e.length())
  }
}

// ---- expressions ----
const (R.ok, e1) = sql.parse("SELECT 1 + 2 * 3, (1 + 2) * 3, -x, NOT flag, a || ' ' || b FROM t")
println(e1.to_string())

const (R.ok, e2) = sql.parse("SELECT CASE WHEN score >= 90 THEN 'A' WHEN score >= 60 THEN 'B' ELSE 'F' END, CASE kind WHEN 1 THEN 'one' ELSE 'other' END FROM grades")
println(e2.to_string())

const (R.ok, e3) = sql.parse("SELECT CAST(price AS VARCHAR(255)), CAST(n AS NUMERIC(10, 2)) FROM products")
println(e3.to_string())

const (R.ok, e4) = sql.parse("SELECT * FROM t WHERE x IN (1, 2, 3) AND y NOT IN (SELECT y FROM excluded) AND z BETWEEN 10 AND 20 AND name LIKE 'a%' AND code NOT LIKE 'x_' AND deleted IS NULL AND flagged IS NOT FALSE")
println(e4.to_string())

const (R.ok, e5) = sql.parse("SELECT ? , ?1, ?42 FROM t WHERE id = ? AND qty > ?2")
println(e5.to_string())

const (R.ok, e6) = sql.parse("SELECT EXISTS (SELECT 1 FROM t WHERE t.id = s.id), (SELECT max(v) FROM t) FROM s")
println(e6.to_string())

const (R.ok, e7) = sql.parse("SELECT 2.5, .5, 12., 1e3, 1.5e-3, 9223372036854775807, -9223372036854775808 FROM nums")
println(e7.to_string())

// ---- strings: the '' escape rides through ----
const (R.ok, e8) = sql.parse("SELECT 'it''s' FROM t")
println(e8.to_string())

// ---- quoted identifiers ----
const (R.ok, e9) = sql.parse("SELECT \"weird name\", t.\"odd col\" FROM \"my table\" t")
println(e9.to_string())

// ---- subquery in the FROM list, comments ride through ----
const (R.ok, e10) = sql.parse("SELECT a.city, a.n FROM (SELECT city, count(*) AS n FROM users GROUP BY city) a -- the per-city counts\nWHERE a.n > 5 /* trailing */")
println(e10.to_string())

// ---- CROSS and NATURAL joins ----
const (R.ok, e11) = sql.parse("SELECT * FROM a CROSS JOIN b, c NATURAL JOIN d")
println(e11.to_string())

// ---- CREATE TABLE: the v0 types, NOT NULL, PRIMARY KEY ----
const ddl = "CREATE TABLE users (id BIGINT NOT NULL PRIMARY KEY, name TEXT NOT NULL, score DOUBLE PRECISION, rating REAL, active BOOLEAN, note TEXT, payload BYTEA, rank INTEGER, handle VARCHAR(12))"
const (R.ok, c1) = sql.parse(ddl)
println(c1.to_string())
if c1.is(sql.CreateTable) {
  println(c1.columns.length())
  println(c1.columns[0].not_null)
  println(c1.columns[0].primary)
  println(c1.columns[2].type_text())
  println(c1.columns[8].type_text())
}

// The canonical rendering normalizes keyword case and constraint order.
const (R.ok, c2) = sql.parse("create table t (id integer primary key not null, v varchar(3))")
println(c2.to_string())

// ---- INSERT: the optional column list, multi-row, and no list ----
const (R.ok, i1) = sql.parse("INSERT INTO users (id, name) VALUES (1, 'Ada'), (2, 'Grace')")
println(i1.to_string())
if i1.is(sql.Insert) {
  println(i1.columns.length())
  println(i1.rows.length())
  println(i1.rows[1][1].to_string())
}
const (R.ok, i2) = sql.parse("INSERT INTO users VALUES (3, 'Linus', 88.0, NULL, TRUE, NULL, NULL, NULL, NULL)")
println(i2.to_string())
println(i2.is(sql.Insert))

// ---- UPDATE and DELETE ----
const (R.ok, u1) = sql.parse("UPDATE users SET name = 'Ada', active = TRUE WHERE id = 1")
println(u1.to_string())
if u1.is(sql.Update) {
  println(u1.sets.length())
  println(u1.sets[0].column)
  println(u1.where_e.length())
}
const (R.ok, d1) = sql.parse("DELETE FROM users WHERE id = 1")
println(d1.to_string())
if d1.is(sql.Delete) {
  println(d1.where_e.length())
}
const (R.ok, d2) = sql.parse("DELETE FROM users")
println(d2.to_string())
if d2.is(sql.Delete) {
  println(d2.where_e.length())
}

// ---- transaction control ----
const (R.ok, t1) = sql.parse("BEGIN")
println(t1.to_string())
const (R.ok, t2) = sql.parse("COMMIT")
println(t2.to_string())
const (R.ok, t3) = sql.parse("ROLLBACK")
println(t3.to_string())

// ---- splitting a multi-statement string ----
const (R.ok, pieces) = sql.split("-- a ; in a comment\nSELECT 1; SELECT ';' AS semi;  ;; ")
println(pieces.length().to_string())
var p = 0
while p < pieces.length() {
  println(pieces[p])
  p = p + 1
}
const (R.ok, none) = sql.split("  ;;  ")
println(none.length().to_string())

// ---- the storage tail ----
const (R.ok, cold) = sql.parse("CREATE TABLE cold (id BIGINT) STORE = COLUMN")
println(cold.to_string())
if cold.is(sql.CreateTable) {
  println(cold.store == sql.StoreKind.column)
}
const (R.ok, plain) = sql.parse("CREATE TABLE plain (id BIGINT) STORE = ROW")
println(plain.to_string())
const (R.ok, silent) = sql.parse("CREATE TABLE plain (id BIGINT)")
println(silent.to_string())

// ---- a malformed statement is a value, not a crash ----
case sql.parse("SELECT FROM") {
  (R.error, why) then { println(why) }
  (R.ok, _)      then { println("unexpected") }
}
case sql.parse("SELECT * FROM t WHERE a = ") {
  (R.error, why) then { println(why) }
  (R.ok, _)      then { println("unexpected") }
}
