  }
  case v.ttl("greeting") {
    (R.error, why) then { println("ttl failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.persist("greeting") {
    (R.error, why) then { println("persist failed: ${why}") }
    (R.ok, kept)   then { println(kept) }
  }
  case v.ttl("greeting") {
    (R.error, why) then { println("ttl failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.ttl("missing") {
    (R.error, why) then { println("ttl failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.set("user:1", "u1") {
    (R.error, why) then { println("set failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.set("user:2", "u2") {
    (R.error, why) then { println("set failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.keys("user:*") {
    (R.error, why) then { println("keys failed: ${why}") }
    (R.ok, names)  then { print_strings(names) }
