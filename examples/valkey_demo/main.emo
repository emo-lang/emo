  case v.get("who") {
    (R.error, why) then { println("get failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.select(0) {
    (R.error, why) then { println("select failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.auth("secret") {
    (R.error, why) then { println("auth failed: ${why}") }
