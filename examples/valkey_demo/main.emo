  }
  case v.close() {
    (R.error, why) then { println("close failed: ${why}") }
    (R.ok, _)      then { println("closed") }
  }
  return 0
}

def print_reply(name String, reply valkey.Reply) Int64 {
  if reply.is_null?() {
    println(name + "=null")
    return 0
  }
  println(name + "=" + reply.as_string())
  return 0
}

def print_strings(items Array[String]) Int64 {
  return print_strings_from(items, 0)
}

def print_strings_from(items Array[String], i Int64) Int64 {
  if i >= items.length() {
    return 0
  }
  println(items[i])
  return print_strings_from(items, i + 1)
}

def print_pairs(pairs Array[(String, String)]) Int64 {
  return print_pairs_from(pairs, 0)
}

def print_pairs_from(pairs Array[(String, String)], i Int64) Int64 {
  if i >= pairs.length() {
    return 0
  }
  const pair = pairs[i]
  println(pair[0] + "=" + pair[1])
  return print_pairs_from(pairs, i + 1)
}

// ---- the server half ----

// The demo's own state: four key spaces, one per Valkey type, plus
// the expiry markers TTL answers from.
class Db {
  def init(strings Map[String, String], lists Map[String, Array[String]], sets Map[String, Array[String]], hashes Map[String, Map[String, String]], expiry Map[String, Int64]) {
    self.strings = strings
    self.lists = lists
    self.sets = sets
    self.hashes = hashes
    self.expiry = expiry
  }

  def type_of(key String) String {
    if self.strings.has(key) {
      return "string"
    }
    if self.lists.has(key) {
      return "list"
    }
    if self.sets.has(key) {
      return "set"
    }
    if self.hashes.has(key) {
      return "hash"
    }
    return "none"
  }

  // Removes the key from every key space; true when something was there.
  def clear(key String) Bool {
    var gone = false
    if self.strings.has(key) {
      self.strings.remove(key)
      gone = true
    }
    if self.lists.has(key) {
      self.lists.remove(key)
      gone = true
    }
    if self.sets.has(key) {
      self.sets.remove(key)
      gone = true
    }
    if self.hashes.has(key) {
      self.hashes.remove(key)
      gone = true
    }
    if self.expiry.has(key) {
      self.expiry.remove(key)
    }
    return gone
  }

  // The KEYS answer for a trailing-* pattern: every key space's keys
  // with the prefix, in the spaces' order, insertion order inside each.
  def keys_like(prefix String) Array[String] {
    var out = []
    out = collect_names(self.strings.keys(), prefix, 0, out)
    out = collect_names(self.lists.keys(), prefix, 0, out)
    out = collect_names(self.sets.keys(), prefix, 0, out)
    out = collect_names(self.hashes.keys(), prefix, 0, out)
    return out
  }
}

def collect_names(names Array[String], prefix String, i Int64, acc Array[String]) Array[String] {
  if i >= names.length() {
    return acc
  }
  const name = names[i]
  if name.starts_with(prefix) {
    return collect_names(names, prefix, i + 1, acc.append(name))
  }
  return collect_names(names, prefix, i + 1, acc)
}

def serve(listener TcpListener, db Db) Int64 {
  case listener.accept() {
    (R.error, why) then { return 0 }
    (R.ok, conn)   then { return connection(conn, db) }
  }
}

def connection(conn TcpConn, db Db) Int64 {
  var live = true
  while live {
    case read_request(conn) {
      (R.error, why) then { live = false }
      (R.ok, args)   then { dispatch(args, conn, db) }
    }
  }
  conn.close()
  return 0
}

// One RESP2 request: the array count line, then one bulk argument per
// element. The client this server serves is the package's own encoder,
// always well-formed.
def read_request(conn TcpConn) (R, Array[String]) {
  case conn.read_line() {
    (R.error, why) then { return (R.error, why) }
    (R.ok, line)   then {
      if line == "" {
        return (R.error, "the client closed the connection")
      }
      if line.substring(0, 1) == "*" {
        return read_args(conn, line.substring(1, line.length() - 1).to_int64(), [])
      }
      return (R.error, "not an array request")
    }
  }
}

def read_args(conn TcpConn, n Int64, acc Array[String]) (R, Array[String]) {
  if n == 0 {
    return (R.ok, acc)
  }
  case conn.read_line() {
    (R.error, why) then { return (R.error, why) }
    (R.ok, head)   then {
      if head.substring(0, 1) == "$" {
        const length = head.substring(1, head.length() - 1).to_int64()
        case conn.read_exactly(length) {
          (R.error, why) then { return (R.error, why) }
          (R.ok, arg)    then {
            conn.read_line()
            return read_args(conn, n - 1, acc.append(arg))
          }
        }
      }
      return (R.error, "not a bulk argument")
    }
  }
}

def wrong_type() String {
  return "WRONGTYPE Operation against a key holding the wrong kind of value"
}

def dispatch(args Array[String], conn TcpConn, db Db) Int64 {
  const op = args[0]
  case op {
    "PING" then {
      if args.length() == 1 {
        write_simple(conn, "PONG")
      } else {
        write_bulk(conn, args[1])
      }
    }
    "ECHO" then {
      write_bulk(conn, args[1])
    }
    "SELECT" then {
      write_simple(conn, "OK")
    }
    "AUTH" then {
      write_simple(conn, "OK")
    }
    "DBSIZE" then {
      write_int(conn, db.strings.length() + db.lists.length() + db.sets.length() + db.hashes.length())
    }
    "TYPE" then {
      write_bulk(conn, db.type_of(args[1]))
    }
    "EXISTS" then {
      write_int(conn, count_present(args, db, 1, 0))
    }
    "DEL" then {
      write_int(conn, remove_keys(args, db, 1, 0))
    }
    "RENAME" then {
      move_key(args[1], args[2], conn, db)
    }
    "KEYS" then {
      const pattern = args[1]
      const mark = pattern.substring(pattern.length() - 1, 1)
      if mark == "*" {
        write_array(conn, db.keys_like(pattern.substring(0, pattern.length() - 1)))
      } else {
        write_error(conn, "ERR unsupported pattern in the demo server")
      }
    }
    "SET" then {
      db.clear(args[1])
      db.strings.set(args[1], args[2])
      write_simple(conn, "OK")
    }
    "SETNX" then {
      if db.type_of(args[1]) != "none" {
        write_int(conn, 0)
      } else {
        db.strings.set(args[1], args[2])
        write_int(conn, 1)
      }
    }
    "GET" then {
      const t = db.type_of(args[1])
      if t == "string" {
        write_bulk(conn, db.strings.get(args[1]))
      } else {
        if t == "none" {
          write_null(conn)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "APPEND" then {
      const t = db.type_of(args[1])
      if t == "string" {
        const grown = db.strings.get(args[1]) + args[2]
        db.strings.set(args[1], grown)
        write_int(conn, grown.to_bytes().length())
      } else {
        if t == "none" {
          db.strings.set(args[1], args[2])
          write_int(conn, args[2].to_bytes().length())
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "STRLEN" then {
      const t = db.type_of(args[1])
      if t == "string" {
        write_int(conn, db.strings.get(args[1]).to_bytes().length())
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "GETRANGE" then {
      const t = db.type_of(args[1])
      if t == "string" {
        write_bulk(conn, text_slice(db.strings.get(args[1]), args[2].to_int64(), args[3].to_int64()))
      } else {
        if t == "none" {
          write_bulk(conn, "")
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "INCR" then {
      bump(conn, db, args[1], 1)
    }
    "DECR" then {
      bump(conn, db, args[1], 0 - 1)
    }
    "INCRBY" then {
      bump(conn, db, args[1], args[2].to_int64())
    }
    "DECRBY" then {
      bump(conn, db, args[1], 0 - args[2].to_int64())
    }
    "MSET" then {
      var i = 1
      while i < args.length() {
        db.clear(args[i])
        db.strings.set(args[i], args[i + 1])
        i = i + 2
      }
      write_simple(conn, "OK")
    }
    "MGET" then {
      write_mget(conn, db, args)
    }
    "EXPIRE" then {
      if db.type_of(args[1]) != "none" {
        db.expiry.set(args[1], args[2].to_int64())
        write_int(conn, 1)
      } else {
        write_int(conn, 0)
      }
    }
    "PERSIST" then {
      if db.expiry.has(args[1]) {
        db.expiry.remove(args[1])
        write_int(conn, 1)
      } else {
        write_int(conn, 0)
      }
    }
    "TTL" then {
      if db.expiry.has(args[1]) {
        write_int(conn, db.expiry.get(args[1]))
      } else {
        if db.type_of(args[1]) != "none" {
          write_int(conn, -1)
        } else {
          write_int(conn, -2)
        }
      }
    }
    "LPUSH" then {
      push(conn, db, args[1], args, "head")
    }
    "RPUSH" then {
      push(conn, db, args[1], args, "tail")
    }
    "LPOP" then {
      pop(conn, db, args[1], "head")
    }
    "RPOP" then {
      pop(conn, db, args[1], "tail")
    }
    "LLEN" then {
      const t = db.type_of(args[1])
      if t == "list" {
        write_int(conn, db.lists.get(args[1]).length())
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "LRANGE" then {
      const t = db.type_of(args[1])
      if t == "list" {
        write_array(conn, lrange_slice(db.lists.get(args[1]), args[2].to_int64(), args[3].to_int64()))
      } else {
        if t == "none" {
          write_array(conn, [])
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "LINDEX" then {
      const t = db.type_of(args[1])
      if t == "list" {
        const list = db.lists.get(args[1])
        var idx = args[2].to_int64()
        if idx < 0 {
          idx = list.length() + idx
        }
        if idx >= 0 && idx < list.length() {
          write_bulk(conn, list[idx])
        } else {
          write_null(conn)
        }
      } else {
        if t == "none" {
          write_null(conn)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "LSET" then {
      const t = db.type_of(args[1])
      if t == "list" {
        const list = db.lists.get(args[1])
        var idx = args[2].to_int64()
        if idx < 0 {
          idx = list.length() + idx
        }
        if idx >= 0 && idx < list.length() {
          db.lists.set(args[1], replace_at(list, idx, args[3], 0, []))
          write_simple(conn, "OK")
        } else {
          write_error(conn, "ERR index out of range")
        }
      } else {
        if t == "none" {
          write_error(conn, "ERR no such key")
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "SADD" then {
      const t = db.type_of(args[1])
      if t == "set" || t == "none" {
        var members = []
        if t == "set" {
          members = db.sets.get(args[1])
        }
        const grown = add_members(members, args, 2)
        db.sets.set(args[1], grown[0])
        write_int(conn, grown[1])
      } else {
        write_error(conn, wrong_type())
      }
    }
    "SREM" then {
      const t = db.type_of(args[1])
      if t == "set" {
        const members = db.sets.get(args[1])
        const fewer = drop_members(members, args, 2)
        if fewer[1] > 0 {
          if fewer[0].length() == 0 {
            db.clear(args[1])
          } else {
            db.sets.set(args[1], fewer[0])
          }
        }
        write_int(conn, fewer[1])
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "SMEMBERS" then {
      const t = db.type_of(args[1])
      if t == "set" {
        write_array(conn, db.sets.get(args[1]))
      } else {
        if t == "none" {
          write_array(conn, [])
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "SISMEMBER" then {
      const t = db.type_of(args[1])
      if t == "set" {
        if has_member(db.sets.get(args[1]), args[2], 0) {
          write_int(conn, 1)
        } else {
          write_int(conn, 0)
        }
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "SCARD" then {
      const t = db.type_of(args[1])
      if t == "set" {
        write_int(conn, db.sets.get(args[1]).length())
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HSET" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        const fields = db.hashes.get(args[1])
        if fields.has(args[2]) {
          fields.set(args[2], args[3])
          write_int(conn, 0)
        } else {
          fields.set(args[2], args[3])
          write_int(conn, 1)
        }
      } else {
        if t == "none" {
          db.hashes.set(args[1], Map.new())
          db.hashes.get(args[1]).set(args[2], args[3])
          write_int(conn, 1)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HGET" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        const fields = db.hashes.get(args[1])
        if fields.has(args[2]) {
          write_bulk(conn, fields.get(args[2]))
        } else {
          write_null(conn)
        }
      } else {
        if t == "none" {
          write_null(conn)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HDEL" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        const fields = db.hashes.get(args[1])
        var removed = 0
        var i = 2
        while i < args.length() {
          if fields.has(args[i]) {
            fields.remove(args[i])
            removed = removed + 1
          }
          i = i + 1
        }
        if fields.length() == 0 {
          db.clear(args[1])
        }
        write_int(conn, removed)
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HEXISTS" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        if db.hashes.get(args[1]).has(args[2]) {
          write_int(conn, 1)
        } else {
          write_int(conn, 0)
        }
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HLEN" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        write_int(conn, db.hashes.get(args[1]).length())
      } else {
        if t == "none" {
          write_int(conn, 0)
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HKEYS" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        write_array(conn, db.hashes.get(args[1]).keys())
      } else {
        if t == "none" {
          write_array(conn, [])
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HVALS" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        write_array(conn, hash_values(db.hashes.get(args[1])))
      } else {
        if t == "none" {
          write_array(conn, [])
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    "HGETALL" then {
      const t = db.type_of(args[1])
      if t == "hash" {
        write_hgetall(conn, db.hashes.get(args[1]))
      } else {
        if t == "none" {
          write_array(conn, [])
        } else {
          write_error(conn, wrong_type())
        }
      }
    }
    _ then {
      write_error(conn, "ERR unknown command '" + op + "'")
    }
  }
  return 0
}

// ---- the server half's writers ----

def write_simple(conn TcpConn, text String) Int64 {
  conn.write("+" + text + "\r\n")
  return 0
}

def write_error(conn TcpConn, text String) Int64 {
  conn.write("-" + text + "\r\n")
  return 0
}

def write_int(conn TcpConn, n Int64) Int64 {
  conn.write(":" + n.to_string() + "\r\n")
  return 0
}

def write_null(conn TcpConn) Int64 {
  conn.write("$-1\r\n")
  return 0
}

def write_bulk(conn TcpConn, data String) Int64 {
  conn.write("$" + data.to_bytes().length().to_string() + "\r\n" + data + "\r\n")
  return 0
}

def write_array(conn TcpConn, items Array[String]) Int64 {
  conn.write("*" + items.length().to_string() + "\r\n" + bulks(items, 0, ""))
  return 0
}

def bulks(items Array[String], i Int64, acc String) String {
  if i >= items.length() {
    return acc
  }
  const item = items[i]
  return bulks(items, i + 1, acc + "$" + item.to_bytes().length().to_string() + "\r\n" + item + "\r\n")
}

// MGET's reply: one bulk or null per key, any type refusal answered
// before the first element.
def write_mget(conn TcpConn, db Db, args Array[String]) Int64 {
  var out = "*" + (args.length() - 1).to_string() + "\r\n"
  var i = 1
  while i < args.length() {
    const t = db.type_of(args[i])
    if t == "string" {
      const v = db.strings.get(args[i])
      out = out + "$" + v.to_bytes().length().to_string() + "\r\n" + v + "\r\n"
    } else {
      out = out + "$-1\r\n"
    }
    i = i + 1
  }
  conn.write(out)
  return 0
}

def write_hgetall(conn TcpConn, fields Map[String, String]) Int64 {
  const ks = fields.keys()
  var out = "*" + (ks.length() * 2).to_string() + "\r\n"
  var i = 0
  while i < ks.length() {
    const f = ks[i]
    const v = fields.get(f)
    out = out + "$" + f.to_bytes().length().to_string() + "\r\n" + f + "\r\n"
    out = out + "$" + v.to_bytes().length().to_string() + "\r\n" + v + "\r\n"
    i = i + 1
  }
  conn.write(out)
  return 0
}

// ---- the server half's helpers ----

def count_present(args Array[String], db Db, i Int64, acc Int64) Int64 {
  if i >= args.length() {
    return acc
  }
  if db.type_of(args[i]) != "none" {
    return count_present(args, db, i + 1, acc + 1)
  }
  return count_present(args, db, i + 1, acc)
}

def remove_keys(args Array[String], db Db, i Int64, acc Int64) Int64 {
  if i >= args.length() {
    return acc
  }
  if db.clear(args[i]) {
    return remove_keys(args, db, i + 1, acc + 1)
  }
  return remove_keys(args, db, i + 1, acc)
}

def move_key(from_key String, to_key String, conn TcpConn, db Db) Int64 {
  const t = db.type_of(from_key)
  if t == "none" {
    write_error(conn, "ERR no such key")
    return 0
  }
  if t == "string" {
    const v = db.strings.get(from_key)
    db.clear(from_key)
    db.clear(to_key)
    db.strings.set(to_key, v)
  }
  if t == "list" {
    const v = db.lists.get(from_key)
    db.clear(from_key)
    db.clear(to_key)
    db.lists.set(to_key, v)
  }
  if t == "set" {
    const v = db.sets.get(from_key)
    db.clear(from_key)
    db.clear(to_key)
    db.sets.set(to_key, v)
  }
  if t == "hash" {
    const v = db.hashes.get(from_key)
    db.clear(from_key)
    db.clear(to_key)
    db.hashes.set(to_key, v)
  }
  if db.expiry.has(from_key) {
    const seconds = db.expiry.get(from_key)
    db.expiry.remove(from_key)
    db.expiry.set(to_key, seconds)
  }
  write_simple(conn, "OK")
  return 0
}

// The counter family: the value must be integer text (or absent —
// absent counts from zero), the demo server's own digit guard before
// to_int64, which raises on anything else.
def bump(conn TcpConn, db Db, key String, delta Int64) Int64 {
  const t = db.type_of(key)
  if t == "none" {
    db.strings.set(key, delta.to_string())
    write_int(conn, delta)
    return 0
  }
  if t == "string" {
    const current = db.strings.get(key)
    if int_text(current.to_bytes(), 0) {
      const grown = current.to_int64() + delta
      db.strings.set(key, grown.to_string())
      write_int(conn, grown)
      return 0
    }
    write_error(conn, "ERR value is not an integer or out of range")
    return 0
  }
  write_error(conn, wrong_type())
  return 0
}

// Digits with an optional leading sign.
def int_text(data Bytes, i Int64) Bool {
  const n = data.length()
  if n == 0 {
    return false
  }
  var at = i
  if data.get(0) == 45 {
    at = 1
  }
  if at == n {
    return false
  }
  return digits_from(data, at, n)
}

def digits_from(data Bytes, i Int64, stop Int64) Bool {
  if i >= stop {
    return true
  }
  const b = data.get(i)
  if b >= 48 && b <= 57 {
    return digits_from(data, i + 1, stop)
  }
  return false
}

def push(conn TcpConn, db Db, key String, args Array[String], side String) Int64 {
  const t = db.type_of(key)
  if t == "list" || t == "none" {
    var list = []
    if t == "list" {
      list = db.lists.get(key)
    }
    var i = 2
    while i < args.length() {
      if side == "head" {
        list = prepend(args[i], list)
      } else {
        list = list.append(args[i])
      }
      i = i + 1
    }
    db.lists.set(key, list)
    write_int(conn, list.length())
    return 0
  }
  write_error(conn, wrong_type())
  return 0
}

def prepend(item String, list Array[String]) Array[String] {
  const out = [item]
  return append_rest(out, list, 0)
}

def append_rest(base Array[String], extra Array[String], i Int64) Array[String] {
  if i >= extra.length() {
    return base
  }
  return append_rest(base.append(extra[i]), extra, i + 1)
}

def pop(conn TcpConn, db Db, key String, side String) Int64 {
  const t = db.type_of(key)
  if t == "list" {
    const list = db.lists.get(key)
    const last = list.length() - 1
    var item = list[0]
    var rest = []
    if side == "head" {
      item = list[0]
      rest = slice_range(list, 1, last)
    } else {
      item = list[last]
      rest = slice_range(list, 0, last - 1)
    }
    if rest.length() == 0 {
      db.clear(key)
    } else {
      db.lists.set(key, rest)
    }
    write_bulk(conn, item)
    return 0
  }
  if t == "none" {
    write_null(conn)
    return 0
  }
  write_error(conn, wrong_type())
  return 0
}

// The inclusive, negative-aware slice the LRANGE and GETRANGE
// semantics share.
def lrange_slice(items Array[String], start Int64, stop Int64) Array[String] {
  const n = items.length()
  var s = start
  if s < 0 {
    s = n + s
  }
  if s < 0 {
    s = 0
  }
  var e = stop
  if e < 0 {
    e = n + e
  }
  if e >= n {
    e = n - 1
  }
  return slice_range(items, s, e)
}

def slice_range(items Array[String], s Int64, e Int64) Array[String] {
  if s > e || s < 0 {
    return []
  }
  return slice_into(items, s, e, s, [])
}

def slice_into(items Array[String], s Int64, e Int64, i Int64, acc Array[String]) Array[String] {
  if i > e {
    return acc
  }
  return slice_into(items, s, e, i + 1, acc.append(items[i]))
}

def text_slice(text String, start Int64, stop Int64) String {
  const n = text.length()
  var s = start
  if s < 0 {
    s = n + s
  }
  if s < 0 {
    s = 0
  }
  var e = stop
  if e < 0 {
    e = n + e
  }
  if e >= n {
    e = n - 1
  }
  if s > e {
    return ""
  }
  return text.substring(s, e - s + 1)
}

def replace_at(items Array[String], idx Int64, value String, i Int64, acc Array[String]) Array[String] {
  if i >= items.length() {
    return acc
  }
  if i == idx {
    return replace_at(items, idx, value, i + 1, acc.append(value))
  }
  return replace_at(items, idx, value, i + 1, acc.append(items[i]))
}

def hash_values(fields Map[String, String]) Array[String] {
  const ks = fields.keys()
  var out = []
  var i = 0
  while i < ks.length() {
    out = out.append(fields.get(ks[i]))
    i = i + 1
  }
  return out
}

def add_members(members Array[String], args Array[String], i Int64) (Array[String], Int64) {
  if i >= args.length() {
    return (members, 0)
  }
  const member = args[i]
  if has_member(members, member, 0) {
    return add_members(members, args, i + 1)
  }
  const grown = add_members(members.append(member), args, i + 1)
  return (grown[0], grown[1] + 1)
}

def drop_members(members Array[String], args Array[String], i Int64) (Array[String], Int64) {
  if i >= args.length() {
    return (members, 0)
  }
  const member = args[i]
  if has_member(members, member, 0) {
    const fewer = drop_members(without(members, member, 0, []), args, i + 1)
    return (fewer[0], fewer[1] + 1)
  }
  return drop_members(members, args, i + 1)
}

def has_member(members Array[String], member String, i Int64) Bool {
  if i >= members.length() {
    return false
  }
  if members[i] == member {
    return true
  }
  return has_member(members, member, i + 1)
}

def without(members Array[String], member String, i Int64, acc Array[String]) Array[String] {
  if i >= members.length() {
    return acc
  }
  if members[i] == member {
    return append_rest(acc, slice_range(members, i + 1, members.length() - 1), 0)
  }
  return without(members, member, i + 1, acc.append(members[i]))
}

// ---- the run ----

const (R.ok, listener) = net.listen("127.0.0.1", 0)
const db = Db.new(strings: Map.new(), lists: Map.new(), sets: Map.new(), hashes: Map.new(), expiry: Map.new())
do serve(listener, db)

case valkey.connect("127.0.0.1", listener.port(), 5.0) {
  (R.error, why) then { println("connect failed") }
  (R.ok, v)      then { run_client(v) }
}
