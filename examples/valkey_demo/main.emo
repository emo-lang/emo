  }
  case v.hset("person:1", "name", "wang") {
    (R.error, why) then { println("hset failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.hset("person:1", "city", "shanghai") {
    (R.error, why) then { println("hset failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.hget("person:1", "name") {
    (R.error, why) then { println("hget failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.hget("person:1", "missing") {
    (R.error, why) then { println("hget failed: ${why}") }
    (R.ok, reply)  then { println(reply.is_null?()) }
  }
  case v.hgetall("person:1") {
    (R.error, why) then { println("hgetall failed: ${why}") }
    (R.ok, pairs)  then { print_pairs(pairs) }
  }
  case v.hlen("person:1") {
    (R.error, why) then { println("hlen failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.hexists("person:1", "city") {
    (R.error, why) then { println("hexists failed: ${why}") }
    (R.ok, there)  then { println(there) }
  }
  case v.hkeys("person:1") {
    (R.error, why) then { println("hkeys failed: ${why}") }
    (R.ok, names)  then { print_strings(names) }
  }
  case v.hvals("person:1") {
    (R.error, why) then { println("hvals failed: ${why}") }
    (R.ok, values) then { print_strings(values) }
  }
  case v.hdel("person:1", ["city"]) {
    (R.error, why) then { println("hdel failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.hlen("person:1") {
    (R.error, why) then { println("hlen failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.rpush("queue", ["a", "b"]) {
    (R.error, why) then { println("rpush failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.lpush("queue", ["c"]) {
    (R.error, why) then { println("lpush failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.lrange("queue", 0, -1) {
    (R.error, why) then { println("lrange failed: ${why}") }
    (R.ok, items)  then { print_strings(items) }
  }
  case v.llen("queue") {
    (R.error, why) then { println("llen failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.lindex("queue", 1) {
    (R.error, why) then { println("lindex failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.lset("queue", 1, "A") {
    (R.error, why) then { println("lset failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.lrange("queue", 0, -1) {
    (R.error, why) then { println("lrange failed: ${why}") }
    (R.ok, items)  then { print_strings(items) }
  }
  case v.lpop("queue") {
    (R.error, why) then { println("lpop failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.rpop("queue") {
    (R.error, why) then { println("rpop failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.llen("queue") {
    (R.error, why) then { println("llen failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.lpop("queue") {
    (R.error, why) then { println("lpop failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.lpop("queue") {
    (R.error, why) then { println("lpop failed: ${why}") }
    (R.ok, reply)  then { println(reply.is_null?()) }
  }
  case v.sadd("tags", ["em", "lex"]) {
    (R.error, why) then { println("sadd failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.sadd("tags", ["em", "ico"]) {
    (R.error, why) then { println("sadd failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.scard("tags") {
    (R.error, why) then { println("scard failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.sismember("tags", "em") {
