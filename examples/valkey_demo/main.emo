// The valkey package end to end on loopback: this program carries its
// own miniature RESP2 server, and the client half of the wire talks
// to this file's server half — every reply is an answer this file
// computed. The golden pins the whole round trip byte for byte. The
// server stands in for a real Valkey: its TTL answers the seconds
// EXPIRE was told (the language has no clock), SMEMBERS walks its
// insertion order, and everything else follows the commands the real
// server answers. The client exercises the typed doors, the null
// replies, a WRONGTYPE error value, the generic door, and
// multi-byte payloads.

require "net"
require "valkey"

// ---- the client half ----

def run_client(v valkey.Valkey) Int64 {
  case v.ping() {
    (R.error, why) then { println("ping failed: ${why}") }
    (R.ok, pong)   then { println(pong) }
  }
  case v.echo("hello valkey") {
    (R.error, why) then { println("echo failed: ${why}") }
    (R.ok, back)   then { println(back) }
  }
  case v.set("greeting", "hola") {
    (R.error, why) then { println("set failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.get("greeting") {
    (R.error, why) then { println("get failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.get("missing") {
    (R.error, why) then { println("get failed: ${why}") }
    (R.ok, reply)  then { println(reply.is_null?()) }
  }
  case v.append("greeting", " !") {
    (R.error, why) then { println("append failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.strlen("greeting") {
    (R.error, why) then { println("strlen failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.getrange("greeting", 0, 1) {
    (R.error, why) then { println("getrange failed: ${why}") }
    (R.ok, text)   then { println(text) }
  }
  case v.set_ex("session", "u1", 300) {
    (R.error, why) then { println("set_ex failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.get("session") {
    (R.error, why) then { println("get failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string()) }
  }
  case v.setnx("greeting", "nope") {
    (R.error, why) then { println("setnx failed: ${why}") }
    (R.ok, took)   then { println(took) }
  }
  case v.setnx("fresh", "yes") {
    (R.error, why) then { println("setnx failed: ${why}") }
    (R.ok, took)   then { println(took) }
  }
  case v.mset([("k1", "v1"), ("k2", "v2")]) {
    (R.error, why) then { println("mset failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.mget(["k1", "greeting", "k2", "nope"]) {
    (R.error, why) then { println("mget failed: ${why}") }
    (R.ok, replies) then {
      print_reply("k1", replies[0])
      print_reply("greeting", replies[1])
      print_reply("k2", replies[2])
      print_reply("nope", replies[3])
    }
  }
  case v.incr("hits") {
    (R.error, why) then { println("incr failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.incr("hits") {
    (R.error, why) then { println("incr failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.incr_by("hits", 10) {
    (R.error, why) then { println("incr_by failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.decr("hits") {
    (R.error, why) then { println("decr failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.exists(["greeting", "k1", "nope"]) {
    (R.error, why) then { println("exists failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.del(["k1", "nope"]) {
    (R.error, why) then { println("del failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.exists(["k1"]) {
    (R.error, why) then { println("exists failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.type("greeting") {
    (R.error, why) then { println("type failed: ${why}") }
    (R.ok, name)   then { println(name) }
  }
  case v.expire("greeting", 60) {
    (R.error, why) then { println("expire failed: ${why}") }
