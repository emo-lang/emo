  }
  case v.smembers("tags") {
    (R.error, why) then { println("smembers failed: ${why}") }
    (R.ok, names)  then { print_strings(names) }
  }
  case v.srem("tags", ["em"]) {
    (R.error, why) then { println("srem failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.scard("tags") {
    (R.error, why) then { println("scard failed: ${why}") }
    (R.ok, n)      then { println(n) }
  }
  case v.set("bin", "line1\r\nline2") {
    (R.error, why) then { println("set failed: ${why}") }
    (R.ok, ok)     then { println(ok) }
  }
  case v.get("bin") {
    (R.error, why) then { println("get failed: ${why}") }
    (R.ok, reply)  then { println(reply.as_string().to_bytes().length()) }
  }
  case v.set("who", "王") {
    (R.error, why) then { println("set failed: ${why}") }
