// The function group — `emo` declares a named, stateless set of
// functions and constants. No instances, no init, no fields: the
// group's members are called directly, `Math.abs(-7)`.
//
//   emo run main.emo

emo Math {
  const tau = 6

  def abs(x Int64) Int64 {
    if x < 0 {
      return 0 - x
    }
    return x
  }

  def clamp(x Int64, lo Int64, hi Int64) Int64 {
    if x < lo {
      return lo
    }
    if x > hi {
      return hi
    }
    return x
  }
}

emo Format {
  const separator = " · "

  def money(cents Int64) String {
    return "${cents / 100} yuan"
  }

  def tagged(label String, value Int64) String {
    return "${label}${separator}${value}"
  }
}

println(Math.abs(0 - 7))
println(Math.tau)
println(Math.clamp(15, 0, 10))
println(Format.money(1250))
println(Format.tagged("order", Math.clamp(99, 0, 50)))
