// Int64 and Byte: the first two fixed-width integers.
//
// Both wrap in two's complement — Int64 at 64 bits, the unsigned Byte
// at 256 — and neither mixes with Int or Float: conversions are
// explicit named methods.
//
//   emo run main.emo

const max = 9223372036854775807L
const bytes8 = Bytes.new(8)

println(max)
println(max + 1L)
println(-max - 1L)
println(2L * 4611686018427387904L)

println(-8L / 3L)
println(-8L % 3L)
println(~0L)
println(-8L >> 1L)
println(1L << 62L)

println(255B)
println(255B + 1B)
println(0B - 1B)
println(200B * 2B)
println(~0B)
println(255B >> 4B)
println(1B << 7B)
println(7B / 2B)

println(10L > 9L)
println(0B < 255B)
println(1L == 1L)
println(2B != 3B)

println(Int64.from_int(42) + 1L)
println(Int64.from_int(-1).to_byte())
println(255B.to_int())
println(Byte.from_int(200))

println(65535.0.to_bits())
println(Float.from_bits(4614256656552045848L))

// The Bytes u64 accessors carry an Int64 through eight little-endian
// bytes — the pair that needs Int64 to exist.
println(bytes8.set_u64_le(0, 1234605616436508552L))
println(bytes8.get(0))
println(bytes8.get(7))
println(bytes8.get_u64_le(0))
println(bytes8.set_u64_le(0, -1L))
println(bytes8.get(0))
println(bytes8.get_u64_le(0))

// The width rides along through parameters and returns.
def double(x Int64) Int64 {
  return x + x
}

def step(b Byte) Byte {
  return b + 1B
}

println(double(max))
println(step(255B))

// ... and through case patterns.
case step(9B) {
  10B -> { println("byte ten") }
  _ -> { println("other") }
}
