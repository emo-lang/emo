// Int64 and Byte: the first two fixed-width integers.
//
// Both wrap in two's complement — Int64 at 64 bits, the unsigned Byte
// at 256 — and neither mixes with Int64 or Float64: conversions are
// explicit named methods.
//
//   emo run main.emo

const max = 9223372036854775807
const bytes8 = Bytes.new(8)

println(max)
println(max + 1)
println(-max - 1)
println(2 * 4611686018427387904)

println(-8 / 3)
println(-8 % 3)
println(~0)
println(-8 >> 1)
println(1 << 62)

println(255B)
println(255B + 1B)
println(0B - 1B)
println(200B * 2B)
println(~0B)
println(255B >> 4B)
println(1B << 7B)
println(7B / 2B)

println(10 > 9)
println(0B < 255B)
println(1 == 1)
println(2B != 3B)

println(42 + 1)
const neg_one = -1
println(neg_one.to_byte())
println(255B.to_int64())
println(Byte.from_int64(200))

println(65535.0.to_bits())
println(Float64.from_bits(4614256656552045848))

// The Bytes u64 accessors carry an Int64 through eight little-endian
// bytes — the pair that needs Int64 to exist.
println(bytes8.set_u64_le(0, 1234605616436508552))
println(bytes8.get(0))
println(bytes8.get(7))
println(bytes8.get_u64_le(0))
println(bytes8.set_u64_le(0, -1))
println(bytes8.get(0))
println(bytes8.get_u64_le(0))

// The width rides along through parameters and returns.
def double(x Int64) Int64 {
  return x + x
}

def step(b Byte) Byte {
  return b + 1B
}

println(double(max))
println(step(255B))

// ... and through case patterns.
case step(9B) {
  10B -> { println("byte ten") }
  _ -> { println("other") }
}
