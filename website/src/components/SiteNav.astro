---
import ThemeToggle from "./ThemeToggle.astro";

const base = import.meta.env.BASE_URL;
---

<header class="site-nav">
  <div class="nav-inner">
    <a class="brand" href={`${base}/`}>
      <img src={`${base}/logo.png`} alt="Emo logo" width="22" height="22" />
      <span>Emo</span>
    </a>
    <div class="nav-actions">
      <a class="nav-link" href={`${base}/docs/`}>Docs</a>
      <ThemeToggle />
    </div>
  </div>
</header>
